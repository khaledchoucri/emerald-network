+// POC-13: the overworld follows you into battle.
+//  - Weather: Emerald starts a battle with the map's weather (ABILITYEFFECT_SWITCH_IN_WEATHER, battle_util.c:2490-2530):
+//    rain / thunderstorm / downpour -> permanent rain, sandstorm -> sandstorm, drought -> sun. Permanent = no turn
+//    count (weatherTurns 0), as Gen 3's overworld weather never runs out.
+//  - Terrain (our design, TUNE): a battle in grass starts with 2 grass panels on each side, a cave or mountain battle
+//    with 1 cracked panel on each side. They don't fade.
+void Field_StartConditions(void)
+{
+    s32 side, n;
+    switch (GetCurrentWeather())
+    {
+    case WEATHER_RAIN:
+    case WEATHER_RAIN_THUNDERSTORM:
+    case WEATHER_DOWNPOUR:
+        sB.weather = B_WEATHER_RAIN_TEMPORARY | B_WEATHER_RAIN_PERMANENT;
+        SetMsg("IT IS RAINING.", 70);                 // sText_ItIsRaining
+        break;
+    case WEATHER_SANDSTORM:
+        sB.weather = B_WEATHER_SANDSTORM;
+        SetMsg("A SANDSTORM IS RAGING.", 70);         // sText_SandstormIsRaging
+        break;
+    case WEATHER_DROUGHT:
+        sB.weather = B_WEATHER_SUN;
+        SetMsg("THE SUNLIGHT IS STRONG.", 70);        // sText_SunlightStrong
+        break;
+    }
+    if (sB.weather)
+        PKBN_LOG("overworld weather %u -> battle weather %x (permanent)", GetCurrentWeather(), sB.weather);
+    for (side = 0; side < 2; side++)
+    {
+        u8 type = PANEL_NORMAL;
+        n = 0;
+        if (gBattleEnvironment == BATTLE_ENVIRONMENT_GRASS || gBattleEnvironment == BATTLE_ENVIRONMENT_LONG_GRASS)
+            type = PANEL_GRASS, n = 2;
+        else if (gBattleEnvironment == BATTLE_ENVIRONMENT_CAVE || gBattleEnvironment == BATTLE_ENVIRONMENT_MOUNTAIN)
+            type = PANEL_CRACKED, n = 1;
+        while (n > 0)
+        {
+            s8 x = (side == SIDE_PLAYER ? 0 : PLAYER_COLS) + Random() % PLAYER_COLS, y = Random() % GRID_ROWS;
+            if (sB.panel[y][x] != PANEL_NORMAL || (y == 1 && (x == 1 || x == 4)))
+                continue;   // not where the fighters start
+            sB.panel[y][x] = type;   // no timer: terrain stays
+            n--;
+        }
+    }
+}
