@@ -0,0 +1,18 @@
+#ifndef GUARD_PKBN_REPLAY_H
+#define GUARD_PKBN_REPLAY_H
+
+// Battle replay (POC-14): every grid battle records its starting state (the battle state after setup, the RNG, both
+// parties) and the keys of each frame; replaying restores the state and feeds the same keys, so the same battle plays
+// out again (the grid is deterministic given those). The last battle is kept in pkbn_replay.bin.
+
+extern bool8 gPkbnReplayActive;   // the battle starting now is a replay
+
+bool8 PkbnReplay_Available(void);
+bool8 PkbnReplay_Prepare(void);          // before the battle starts: reads the file, puts the recorded foes in gEnemyParty
+void PkbnReplay_StartRecording(void);    // end of the grid's setup (not in a replay)
+void PkbnReplay_ApplyStart(void);        // end of the grid's setup in a replay: the recorded state replaces it
+void PkbnReplay_Frame(void);             // each grid frame: record gMain's keys, or (replay) set them from the file
+bool8 PkbnReplay_Finished(void);         // replay: the recorded frames are used up
+void PkbnReplay_End(void);               // battle over: save the recording, or (replay) put the real party back
+
+#endif // GUARD_PKBN_REPLAY_H
