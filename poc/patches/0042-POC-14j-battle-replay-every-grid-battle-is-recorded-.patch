diff --git a/src/pkbn/replay.c b/src/pkbn/replay.c
new file mode 100644
index 0000000..bc83645
--- /dev/null
+++ b/src/pkbn/replay.c
@@ -0,0 +1,171 @@
+// Battle replay (POC-14, include/pkbn/replay.h). Our own feature: neither game records battles.
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "main.h"
+#include "pokemon.h"
+#include "random.h"
+#include "battle.h"
+#include "battle_setup.h"
+#include "pkbn/grid_internal.h"
+#include "pkbn/replay.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+#define REPLAY_PATH       "pkbn_replay.bin"
+#define REPLAY_VERSION    1
+#define REPLAY_MAX_FRAMES (60 * 60 * 15)   // 15 minutes of battle
+
+struct ReplayHeader
+{
+    char magic[8];
+    u32 version;
+    u32 stateSize;        // sizeof(struct GridBattle): a replay only plays on the build that made it
+    u32 frames;
+    u32 rng;
+    u32 battleTypeFlags;
+    u16 opponentA, opponentB;
+    u8 environment;
+};
+
+struct ReplayKeys { u16 newKeys, heldKeys; };
+
+bool8 gPkbnReplayActive;
+
+static struct
+{
+    struct ReplayHeader h;
+    struct GridBattle state;
+    struct Pokemon player[PARTY_SIZE], enemy[PARTY_SIZE];
+    struct ReplayKeys keys[REPLAY_MAX_FRAMES];
+    u32 at;
+    bool8 recording;
+    struct Pokemon realParty[PARTY_SIZE];
+} sR;
+
+static bool8 ReadFile(void)
+{
+    FILE *f = fopen(REPLAY_PATH, "rb");
+    bool8 ok = FALSE;
+    if (f == NULL)
+        return FALSE;
+    if (fread(&sR.h, sizeof(sR.h), 1, f) == 1 && memcmp(sR.h.magic, "PKBNRPLY", 8) == 0 && sR.h.version == REPLAY_VERSION
+     && sR.h.stateSize == sizeof(struct GridBattle) && sR.h.frames <= REPLAY_MAX_FRAMES
+     && fread(&sR.state, sizeof(sR.state), 1, f) == 1 && fread(sR.player, sizeof(sR.player), 1, f) == 1
+     && fread(sR.enemy, sizeof(sR.enemy), 1, f) == 1 && fread(sR.keys, sizeof(struct ReplayKeys), sR.h.frames, f) == sR.h.frames)
+        ok = TRUE;
+    fclose(f);
+    return ok;
+}
+
+bool8 PkbnReplay_Available(void)
+{
+    FILE *f = fopen(REPLAY_PATH, "rb");
+    struct ReplayHeader h;
+    bool8 ok = FALSE;
+    if (f == NULL)
+        return FALSE;
+    if (fread(&h, sizeof(h), 1, f) == 1 && memcmp(h.magic, "PKBNRPLY", 8) == 0 && h.version == REPLAY_VERSION
+     && h.stateSize == sizeof(struct GridBattle))
+        ok = TRUE;
+    fclose(f);
+    return ok;
+}
+
+bool8 PkbnReplay_Prepare(void)
+{
+    if (!ReadFile())
+        return FALSE;
+    memcpy(gEnemyParty, sR.enemy, sizeof(sR.enemy));
+    return TRUE;
+}
+
+void PkbnReplay_StartRecording(void)
+{
+    memset(&sR.h, 0, sizeof(sR.h));
+    memcpy(sR.h.magic, "PKBNRPLY", 8);
+    sR.h.version = REPLAY_VERSION;
+    sR.h.stateSize = sizeof(struct GridBattle);
+    sR.h.rng = gRngValue;
+    sR.h.battleTypeFlags = gBattleTypeFlags;
+    sR.h.opponentA = gTrainerBattleOpponent_A;
+    sR.h.opponentB = gTrainerBattleOpponent_B;
+    sR.h.environment = gBattleEnvironment;
+    sR.state = sB;
+    memcpy(sR.player, gPlayerParty, sizeof(sR.player));
+    memcpy(sR.enemy, gEnemyParty, sizeof(sR.enemy));
+    sR.at = 0;
+    sR.recording = TRUE;
+}
+
+void PkbnReplay_ApplyStart(void)
+{
+    memcpy(sR.realParty, gPlayerParty, sizeof(sR.realParty));
+    memcpy(gPlayerParty, sR.player, sizeof(sR.player));
+    memcpy(gEnemyParty, sR.enemy, sizeof(sR.enemy));
+    gBattleTypeFlags = sR.h.battleTypeFlags;
+    gTrainerBattleOpponent_A = sR.h.opponentA;
+    gTrainerBattleOpponent_B = sR.h.opponentB;
+    gBattleEnvironment = sR.h.environment;
+    sB = sR.state;
+    gRngValue = sR.h.rng;
+    sR.at = 0;
+    sR.recording = FALSE;
+    printf("[pkbn] replay: %u frames\n", (unsigned)sR.h.frames);
+}
+
+void PkbnReplay_Frame(void)
+{
+    if (gPkbnReplayActive)
+    {
+        if (sR.at < sR.h.frames)
+        {
+            gMain.newKeys = sR.keys[sR.at].newKeys;
+            gMain.heldKeys = sR.keys[sR.at].heldKeys;
+            sR.at++;
+        }
+        else
+            gMain.newKeys = gMain.heldKeys = 0;
+        return;
+    }
+    if (sR.recording && sR.at < REPLAY_MAX_FRAMES)
+    {
+        sR.keys[sR.at].newKeys = gMain.newKeys;
+        sR.keys[sR.at].heldKeys = gMain.heldKeys;
+        sR.at++;
+    }
+}
+
+bool8 PkbnReplay_Finished(void)
+{
+    return gPkbnReplayActive && sR.at >= sR.h.frames;
+}
+
+void PkbnReplay_End(void)
+{
+    if (gPkbnReplayActive)
+    {
+        memcpy(gPlayerParty, sR.realParty, sizeof(sR.realParty));   // a replay changes nothing
+        gBattleTypeFlags = 0;
+        gPkbnReplayActive = FALSE;
+        return;
+    }
+    if (sR.recording)
+    {
+        FILE *f = fopen(REPLAY_PATH, "wb");
+        sR.recording = FALSE;
+        sR.h.frames = sR.at;
+        if (f == NULL)
+            return;
+        fwrite(&sR.h, sizeof(sR.h), 1, f);
+        fwrite(&sR.state, sizeof(sR.state), 1, f);
+        fwrite(sR.player, sizeof(sR.player), 1, f);
+        fwrite(sR.enemy, sizeof(sR.enemy), 1, f);
+        fwrite(sR.keys, sizeof(struct ReplayKeys), sR.at, f);
+        fclose(f);
+        printf("[pkbn] replay saved: %u frames\n", (unsigned)sR.at);
+    }
+}
+
+#endif // PORTABLE
