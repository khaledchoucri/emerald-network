+// ---- POC-17c low-HP alarm --------------------------------------------------------------------------------------------
+// Emerald's HandleLowHpMusicChange (battle_gfx_sfx_util.c:1090): the active Pokémon's HP bar is red -> SE_LOW_HEALTH,
+// otherwise m4aSongNumStop(SE_LOW_HEALTH). Emerald starts it once; here a move's sound can take its player
+// (MUSIC_PLAYER_SE3, sound/song_table.inc:99), so it starts again once that player is free (our rule).
+static bool8 LowHpWanted(void)
+{
+    const struct BattlePokemon *bm = &sB.f[SIDE_PLAYER].bm;
+    if (getenv("PKBN_NO_LOW_HP") != NULL || gPkbnGallery || sB.state == ST_END || bm->hp == 0 || bm->maxHP == 0)
+        return FALSE;
+    return GetHPBarLevel(bm->hp, bm->maxHP) == HP_BAR_RED;
+}
+
+static void LowHpFrame(void)
+{
+    const struct Song *song = &gSongTable[SE_LOW_HEALTH];
+    struct MusicPlayerInfo *mi = gMPlayTable[song->ms].info;
+    bool8 busy = (mi->status & MUSICPLAYER_STATUS_TRACK) && !(mi->status & MUSICPLAYER_STATUS_PAUSE);
+    if (!LowHpWanted())
+    {
+        if (sB.lowHp)
+            m4aSongNumStop(SE_LOW_HEALTH);
+        sB.lowHp = FALSE;
+        return;
+    }
+    if (!sB.lowHp || !busy)
+        PlaySE(SE_LOW_HEALTH);
+    sB.lowHp = TRUE;
+}
+
 void CB2_PkbnGridBattle(void)
 {
     if (!sActive)
@@ -2706,6 +2745,8 @@ void CB2_PkbnGridBattle(void)
             Finish();
         break;
     }
+    if (sActive)
+        LowHpFrame();
 }
 
