+// POC-17c: each NET CHALLENGE plays one of Emerald's own battle themes (the picks Khaled approved; TUNE):
+// the legendaries their own, MASTER NET the Champion's, the ladders the Elite Four's, the rest the trainer theme.
+u16 PkbnChallenge_BGM(u8 idx)
+{
+    const struct PkbnChallenge *c;
+    if (idx >= PKBN_CHALLENGE_COUNT)
+        return MUS_VS_TRAINER;
+    c = &gPkbnChallenges[idx];
+    if (c->rules & CHR_BOSS)
+        return c->mons[0].species == SPECIES_RAYQUAZA ? MUS_VS_RAYQUAZA : MUS_VS_KYOGRE_GROUDON;
+    if (strcmp(c->name, "MASTER NET") == 0)
+        return MUS_VS_CHAMPION;
+    if (strstr(c->name, "LADDER") != NULL)
+        return MUS_VS_ELITE_FOUR;
+    return MUS_VS_TRAINER;
+}
