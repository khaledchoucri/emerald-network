From: Khaled <khaledchoucri@gmail.com>
Date: Wed, 7 Oct 2026 15:06:11 +0300
Subject: [PATCH 84/85] POC-20d: GHOSTS page - the team's levels on one line
 under the ghost icons

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FbWSqvcg6G5Gpw6ynvR5tJ
---
 src/pkbn/challenge_ui.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/pkbn/challenge_ui.c b/src/pkbn/challenge_ui.c
index 58a0552..eff22a4 100644
--- a/src/pkbn/challenge_ui.c
+++ b/src/pkbn/challenge_ui.c
@@ -305,10 +305,11 @@ static void DrawGhosts(u16 *fb)
         u8 bust;
         const struct PkbnGhost *g = &sC.ghosts[sC.gCursor - 1];
         s32 y = LIST_Y + 2 + 2 * 26;
-        for (i = 0; i < g->count; i++)
         {
-            snprintf(line, sizeof(line), "Lv%u", g->mon[i].level);
-            Text(fb, PANEL_X + 4 + (i % 3) * 34, LIST_Y + 14 + (i / 3) * 26, line, RGB(20, 22, 28));
+            s32 n = snprintf(line, sizeof(line), "Lv");
+            for (i = 0; i < g->count && n < (s32)sizeof(line) - 5; i++)
+                n += snprintf(line + n, sizeof(line) - n, "%s%u", i ? " " : "", g->mon[i].level);
+            Text(fb, PANEL_X + 4, y - 8, line, RGB(20, 22, 28));
         }
         if (PkbnGhost_Best(g->hash, &frames, &bust))
         {
