+
+static u32 ShelfPrice(u16 move)
+{
+    return 60 * Chip_MB(move);
+}
+
+static void BuildShelf(void)
+{
+    const struct ShelfStock *st = &sShelves[0];   // anywhere else: Oldale's stock
+    s32 i;
+    for (i = 0; i < (s32)ARRAY_COUNT(sShelves); i++)
+        if (sShelves[i].mapsec == gMapHeader.regionMapSectionId)
+            st = &sShelves[i];
+    sF.shelfCount = 0;
+    for (i = 0; i < 8; i++)
+    {
+        u16 mv = st->moves[i];
+        const struct PkbnMoveInfo *info = &gPkbnMoveInfo[mv];
+        if (!PkbnFolder_MoveIsChip(mv) || info->laneCount == 0)
+            continue;
+        sF.shelf[sF.shelfCount].move = mv;
+        sF.shelf[sF.shelfCount].letter = info->lanes[(i & 1) && info->laneCount > 1 ? 1 : 0];
+        sF.shelfCount++;
+    }
+}
+
+static void BuyShelf(void)
+{
+    struct CandyRow *r;
+    u32 price;
+    if (sF.shelfCount == 0)
+        return;
+    r = &sF.shelf[sF.cursor[PAGE_SHELF]];
+    price = ShelfPrice(r->move);
+    if (!IsEnoughMoney(&gSaveBlock1Ptr->money, price))
+    {
+        Note("YOU DON'T HAVE ENOUGH MONEY");
+        PlaySE(SE_FAILURE);
+        return;
+    }
+    RemoveMoney(&gSaveBlock1Ptr->money, price);
+    PkbnPack_Add(r->move, r->letter, 1);
+    BuildPack();
+    PlaySE(SE_SHOP);
+    {
+        char nm[MOVE_NAME_LENGTH + 1], line[64];
+        MoveName(nm, sizeof(nm), r->move);
+        snprintf(line, sizeof(line), "BOUGHT %s %c FOR %u", nm, PkbnFolder_LetterChar(r->letter), (unsigned)price);
+        Note(line);
+    }
+}
