+// The code picker (Ultra / Master Ball): LEFT/RIGHT through the move's codes (and * when it allows it), A takes it.
+static u8 PickLanes(u16 move, u8 *out)
+{
+    const struct PkbnMoveInfo *info = &gPkbnMoveInfo[move];
+    u8 i, n = 0;
+    for (i = 0; i < info->laneCount; i++)
+        out[n++] = info->lanes[i];
+    return n;
+}
+
+static void StepCodePick(void)
+{
+    u8 lanes[8], n;
+    u16 move;
+    char nm[MOVE_NAME_LENGTH + 1], row[64];
+    s32 i, x;
+    if (sPB.pickIdx >= gCapturePick.count)
+    {
+        gCapturePick.count = 0;
+        sPB.bigGrade[0] = '\0';
+        sPB.step = PB_NICK_ASK;
+        return;
+    }
+    move = gCapturePick.move[sPB.pickIdx];
+    n = PickLanes(move, lanes);
+    if (n == 0)
+    {
+        sPB.pickIdx++;
+        return;
+    }
+    if (gMain.newKeys & DPAD_LEFT)
+        sPB.pickLane = (sPB.pickLane + n - 1) % n, PlaySE(SE_SELECT);
+    if (gMain.newKeys & DPAD_RIGHT)
+        sPB.pickLane = (sPB.pickLane + 1) % n, PlaySE(SE_SELECT);
+    if (sPB.pickLane >= n)
+        sPB.pickLane = 0;
+    Pkbn_GameStringToAscii(nm, gMoveNames[move], sizeof(nm));
+    snprintf(sPB.lines[0], sizeof(sPB.lines[0]), "PICK A CODE FOR %s:", nm);
+    for (i = 0, x = 0; i < n && x < (s32)sizeof(row) - 6; i++)
+        x += snprintf(row + x, sizeof(row) - x, i == sPB.pickLane ? "[%c] " : " %c  ", PkbnFolder_LetterChar(lanes[i]));
+    snprintf(sPB.lines[1], sizeof(sPB.lines[1]), "%s", row);
+    snprintf(sPB.lines[2], sizeof(sPB.lines[2]), "LEFT/RIGHT: CODE   A: TAKE IT");
+    sPB.lineCount = 3;
+    sPB.prompt = FALSE;
+    if (sPB.autopilot)   // self-tests: PKBN_TEST_CODE_PICK=n takes the n-th code
+        sPB.pickLane = (u8)(atoi(getenv("PKBN_TEST_CODE_PICK") ? getenv("PKBN_TEST_CODE_PICK") : "0") % n);
+    if ((gMain.newKeys & A_BUTTON) || sPB.autopilot)
+    {
+        PkbnPack_Add(move, lanes[sPB.pickLane], gCapturePick.copies[sPB.pickIdx]);
+        PKBN_LOG("code picked: move %u code %c", move, PkbnFolder_LetterChar(lanes[sPB.pickLane]));
+        PlaySE(SE_SELECT);
+        sPB.pickIdx++;
+        sPB.pickLane = 0;
+    }
+}
