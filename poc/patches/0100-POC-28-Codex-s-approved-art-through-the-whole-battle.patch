+
+bool8 Fx_HasHi(u8 id)
+{
+    return HiFxIndex(id) >= 0;
+}
+
+bool8 Fx_IsGrey(u8 id)
+{
+#if HAVE_HIBIT && defined(PKBN_HIBIT_RAMPS)
+    s32 i = HiFxIndex(id);
+    return i >= 0 && sHiFx[i].grey;
+#else
+    (void)id;
+    return FALSE;
+#endif
+}
+
+const u16 *Gfx_HiRamp(u8 type)
+{
+#if HAVE_HIBIT && defined(PKBN_HIBIT_RAMPS)
+    if (gPkbnHiBit && type < ARRAY_COUNT(sHiRamp))
+        return sHiRamp[type];
+#endif
+    (void)type;
+    return NULL;
+}
+
+const struct PkbnImage *Gfx_HiStill(u8 id)
+{
+#if HAVE_HIBIT && defined(PKBN_HIBIT_STILLS)
+    if (gPkbnHiBit && id < HI_STILL_COUNT)
+        return &sHiStill[id];
+#endif
+    (void)id;
+    return NULL;
+}
+
+void Gfx_GreyTint(u16 color, u16 out[6])
+{
+    out[0] = 0;
+    out[1] = Gfx_Blend(color, 0x0000, 11);
+    out[2] = Gfx_Blend(color, 0x0000, 6);
+    out[3] = color;
+    out[4] = Gfx_Blend(color, 0x7FFF, 6);
+    out[5] = Gfx_Blend(color, 0x7FFF, 11);
+}
+
+void Gfx_DrawSlice9(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, s32 w, s32 h, s32 cw, s32 ch, const u16 *pal)
+{
+    // buffer pixels: an image pixel is S/2 buffer pixels (hi-bit) or S (old art)
+    const s32 S = gPkbnScale, k = img->hi ? 1 : 2;   // one image pixel = S * k / 2 buffer pixels
+    s32 bw = w * S, bh = h * S, bx = x * S, by = y * S, i, j;
+    s32 iw = img->w, ih = img->h, ccw = cw * S * k / 2, cch = ch * S * k / 2;
+    if (pal == NULL)
+        pal = img->pal;
+    for (j = 0; j < bh; j++)
+    {
+        s32 sy;
+        if (j < cch)
+            sy = j * 2 / (S * k);
+        else if (j >= bh - cch)
+            sy = ih - 1 - (bh - 1 - j) * 2 / (S * k);
+        else
+            sy = ch + ((j - cch) * 2 / (S * k)) % (ih - 2 * ch > 0 ? ih - 2 * ch : 1);
+        for (i = 0; i < bw; i++)
+        {
+            s32 sx;
+            u8 idx;
+            if (i < ccw)
+                sx = i * 2 / (S * k);
+            else if (i >= bw - ccw)
+                sx = iw - 1 - (bw - 1 - i) * 2 / (S * k);
+            else
+                sx = cw + ((i - ccw) * 2 / (S * k)) % (iw - 2 * cw > 0 ? iw - 2 * cw : 1);
+            if (sx < 0 || sy < 0 || sx >= iw || sy >= ih)
+                continue;
+            idx = img->px[sy * iw + sx];
+            if (idx)
+                PlotPhys(fb, bx + i, by + j, pal[idx], 0, 0, 0);
+        }
+    }
+}
+
+static void FxFrames(u8 id, const struct PkbnFxFrame **frames, u32 *count, bool8 *loop)
+{
+#if HAVE_HIBIT
+    s32 i = HiFxIndex(id);
+    if (i >= 0)
+    {
+        *frames = &sHiFxFrames[sHiFx[i].first];
+        *count = sHiFx[i].count;
+        *loop = sHiFx[i].loop;
+        return;
+    }
 #endif
+    if (id == FX_HI_STAB)
+        id = FX_SPIKE;   // POC-28: without our art, the BN6 picture these replaced
+    else if (id == FX_HI_JAWS)
+        id = FX_FANG;
     *frames = &sBn6Frames[sBn6Anims[id].first];
     *count = sBn6Anims[id].count;
     *loop = sBn6Anims[id].loop;
