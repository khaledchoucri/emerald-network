+
+static bool8 HiTag(u16 *fb, s32 x, s32 y, s32 w, u16 col)
+{
+    u16 pal[6];
+    if (Gfx_HiStill(HI_H2_TAG) == NULL)
+        return FALSE;
+    Gfx_GreyTint(col, pal);
+    Gfx_DrawSlice9(fb, Gfx_HiStill(HI_H2_TAG), x, y, w, 9, 6, 0, pal);
+    return TRUE;
+}
