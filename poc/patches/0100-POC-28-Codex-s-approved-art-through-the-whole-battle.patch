+// POC-28: ASSET-007's plates and tags, 9-sliced to the box (8 x 8 corners; a tag's caps 6 wide). FALSE without the art.
+static bool8 HiPlate(u16 *fb, u8 still, s32 x, s32 y, s32 w, s32 h)
+{
+    const struct PkbnImage *img = Gfx_HiStill(still);
+    if (img == NULL)
+        return FALSE;
+    Gfx_DrawSlice9(fb, img, x, y, w, h, 8, 8, NULL);
+    return TRUE;
