+// ---- POC-28: Codex's art for the rest of the battle (ASSET-005..010; tools/pack_hibit.py) -------------------------
+// Effects only our art has (no BN6 counterpart): STAB and JAWS. Without the hi-bit pack they fall back to BN6's
+// SPIKE and FANG.
+#define FX_HI_STAB (FX_COUNT + 0)
+#define FX_HI_JAWS (FX_COUNT + 1)
+bool8 Fx_HasHi(u8 id);                     // our hi-bit art is in and on for this effect
+bool8 Fx_IsGrey(u8 id);                    // drawn in the five greys: the type ramp colours it (Gfx_HiRamp)
+const u16 *Gfx_HiRamp(u8 type);            // a 6-entry palette (0 clear, 1..5 dark to light) for TYPE_*, or NULL
+// Still pictures: the backdrop, the HUD (ASSET-007) and the Custom screen (ASSET-009). NULL without the art.
+enum
+{
+    HI_BACKDROP,
+    HI_H1_PLAYER, HI_H1_FOE, HI_H1_SYNC1, HI_H1_SYNC2, HI_H2_TAG, HI_H3_TROUGH, HI_H3_FILL,
+    HI_H4_FRAME, HI_H4_FILL, HI_H4_FULL1, HI_H4_FULL2, HI_H4_FULL3, HI_H4_FULL4, HI_H5_LINE,
+    HI_C1_WINDOW, HI_C2_ART, HI_C3_SLOT, HI_C5_OK1, HI_C5_OK2,
+    HI_C4_TL1, HI_C4_TR1, HI_C4_BL1, HI_C4_BR1, HI_C4_TL2, HI_C4_TR2, HI_C4_BL2, HI_C4_BR2,
+    HI_C6_TAB, HI_C7_PA1, HI_C7_PA2,
+    HI_MOTE_0_0, HI_MOTE_0_1, HI_MOTE_0_2, HI_MOTE_0_3,   // ASSET-005 B: 2x2, 4x4, 6x6 motes, 4 twinkle frames each
+    HI_MOTE_1_0, HI_MOTE_1_1, HI_MOTE_1_2, HI_MOTE_1_3,
+    HI_MOTE_2_0, HI_MOTE_2_1, HI_MOTE_2_2, HI_MOTE_2_3,
+    HI_STREAM_0, HI_STREAM_1, HI_STREAM_2, HI_STREAM_3,    // ASSET-005 C: data streams
+    // ASSET-008, the Program Advance moment: the card turning (front, 3/4, edge, back), its trail (grey), the emblem
+    // arriving (6) and settled, the burst (grey), the name banner (9-slice), its shine, the 17 type symbols (grey,
+    // Normal .. Dark without ???)
+    HI_PA_CARD_0, HI_PA_CARD_1, HI_PA_CARD_2, HI_PA_CARD_3,
+    HI_PA_TRAIL_0, HI_PA_TRAIL_1, HI_PA_TRAIL_2, HI_PA_TRAIL_3,
+    HI_PA_EMBLEM_0, HI_PA_EMBLEM_1, HI_PA_EMBLEM_2, HI_PA_EMBLEM_3, HI_PA_EMBLEM_4, HI_PA_EMBLEM_5, HI_PA_EMBLEM_6,
+    HI_PA_BURST_0, HI_PA_BURST_1, HI_PA_BURST_2, HI_PA_BURST_3, HI_PA_BURST_4, HI_PA_BURST_5,
+    HI_PA_BANNER,
+    HI_PA_SHINE_0, HI_PA_SHINE_1, HI_PA_SHINE_2, HI_PA_SHINE_3,
+    HI_PA_SYM_0, HI_PA_SYM_1, HI_PA_SYM_2, HI_PA_SYM_3, HI_PA_SYM_4, HI_PA_SYM_5, HI_PA_SYM_6, HI_PA_SYM_7, HI_PA_SYM_8,
+    HI_PA_SYM_9, HI_PA_SYM_10, HI_PA_SYM_11, HI_PA_SYM_12, HI_PA_SYM_13, HI_PA_SYM_14, HI_PA_SYM_15, HI_PA_SYM_16,
+    HI_STILL_COUNT
