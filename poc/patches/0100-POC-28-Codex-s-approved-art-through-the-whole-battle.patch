+// POC-28: Codex's Net backdrop (ASSET-005 A), its data streams drifting up the sky and its motes twinkling (B, C);
+// weather lays a wash of its colour over the sky. TUNE: positions, speeds, wash strengths.
+static bool8 DrawHiBackdrop(u16 *fb, u32 t)
+{
+    static const s16 sStreamX[4] = { 18, 77, 166, 233 };
+    const struct PkbnImage *bd = Gfx_HiStill(HI_BACKDROP);
+    s32 k;
+    if (bd == NULL)
+        return FALSE;
+    Gfx_Draw(fb, bd, 0, 0, 0, 0, 0);
+    Gfx_ClipRect(0, 0, CW, 74);   // streams and motes stay above the horizon
+    for (k = 0; k < 4; k++)
+    {
+        const struct PkbnImage *s = Gfx_HiStill(HI_STREAM_0 + k);
+        s32 span = 74 + s->h / 2, y = 74 - (s32)((t / (3 + k) + k * 41) % span);
+        Gfx_Draw(fb, s, sStreamX[k], y, 0, 0, 0);
+    }
+    for (k = 0; k < 12; k++)
+    {
+        u8 size = (u8)(k % 3), frame = (u8)((t / 8 + k * 3) % 4);
+        s32 x = (k * 97 + 13 + (s32)(t / (40 + k * 7))) % CW, y = 5 + (k * 53) % 64;
+        Gfx_Draw(fb, Gfx_HiStill(HI_MOTE_0_0 + size * 4 + frame), x, y, 0, 0, 0);
+    }
+    Gfx_ClipNone();
+    if (sB.weather & B_WEATHER_RAIN)      Gfx_FillBlend(fb, 0, 0, CW, 76, RGB(1, 2, 6), 5);
+    if (sB.weather & B_WEATHER_SUN)       Gfx_FillBlend(fb, 0, 0, CW, 76, RGB(31, 14, 4), 4);
+    if (sB.weather & B_WEATHER_SANDSTORM) Gfx_FillBlend(fb, 0, 0, CW, 76, RGB(22, 16, 7), 5);
+    if (sB.weather & B_WEATHER_HAIL)      Gfx_FillBlend(fb, 0, 0, CW, 76, RGB(20, 26, 31), 4);
+    return TRUE;
+}
