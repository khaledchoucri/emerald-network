diff --git a/src/pkbn/owtest.c b/src/pkbn/owtest.c
new file mode 100644
index 0000000..a95ab62
--- /dev/null
+++ b/src/pkbn/owtest.c
@@ -0,0 +1,249 @@
+// Overworld self-tests (POC-11, item 7): start straight in a map with a party and a key script, dump frames, quit.
+// Lets us check menus and field hooks (START -> FOLDER, party menu -> NAVICUST, Poké Mart CHIPS, wild battles in
+// grass, story flags) without a save file or a person at the keyboard.
+//
+//   PKBN_OWTEST="group:num:x:y"        map (MAP_GROUP/MAP_NUM from include/constants/map_groups.h) and position
+//   PKBN_OWTEST_PARTY="sp:lv[:m/m/m/m]|..."   numeric species / moves (tools: /tmp/ids.py style)
+//   PKBN_OWTEST_FLAGS="flag,flag,..."  extra flags to set (numbers)
+//   PKBN_OWTEST_ITEMS="item:n,..."     bag items;  PKBN_OWTEST_MONEY=n
+//   PKBN_OWKEYS="W60,S,D,A,P,B,Q"      the script: Wn waits n frames; U D L R A B S(tart) E(select) < > press a key
+//                                      (held 4 frames, then 6 frames released); Hn+key holds it n frames (H40R
+//                                      walks right); Mn taps A for n frames; P dumps a frame now; Q quits.
+//                                      Titem runs "additem item, 1" as a script.
+//                                      Gsp:lv starts a wild battle (species / level numbers) as if met in grass.
+//   PKBN_OW_AUTOBATTLE=1               grid battles started from the field are fought by the self-test autopilot
+//   PKBN_DUMP_DIR=dir                  P writes dir/ow_NNNNN.ppm (264x176, what the window shows)
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "global.h"
+#include "main.h"
+#include "event_data.h"
+#include "item.h"
+#include "money.h"
+#include "new_game.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "constants/flags.h"
+#include "constants/moves.h"
+#include "pkbn/render.h"
+#include "battle_setup.h"
+#include "script.h"
+#include "script_pokemon_util.h"
+#include "constants/items.h"
+
+#ifdef PORTABLE
+
+static const char *sScript;
+static u32 sWait, sHold, sFrame, sMash;
+static u16 sKey;
+static bool8 sActive, sDumpNext;
+
+bool8 PkbnOwTest_Active(void)
+{
+    return sActive;
+}
+
+static u16 KeyOf(char c)
+{
+    switch (c)
+    {
+    case 'U': return DPAD_UP;
+    case 'D': return DPAD_DOWN;
+    case 'L': return DPAD_LEFT;
+    case 'R': return DPAD_RIGHT;
+    case 'A': return A_BUTTON;
+    case 'B': return B_BUTTON;
+    case 'S': return START_BUTTON;
+    case 'E': return SELECT_BUTTON;
+    case '<': return L_BUTTON;
+    case '>': return R_BUTTON;
+    }
+    return 0;
+}
+
+// Called by Platform_GetKeyInput every frame: the scripted keys.
+u16 PkbnOwTest_Keys(void)
+{
+    sFrame++;
+    if (sMash)
+    {
+        sMash--;
+        return (sMash % 8) < 3 ? A_BUTTON : 0;
+    }
+    if (sHold)
+    {
+        sHold--;
+        return sKey;
+    }
+    if (sWait)
+    {
+        sWait--;
+        return 0;
+    }
+    while (sScript && *sScript)
+    {
+        char c = *sScript++;
+        if (c == ',' || c == ' ')
+            continue;
+        if (c == 'W')
+        {
+            sWait = strtoul(sScript, (char **)&sScript, 10);
+            return 0;
+        }
+        if (c == 'H')
+        {
+            sHold = strtoul(sScript, (char **)&sScript, 10);
+            sKey = KeyOf(*sScript++);
+            return sKey;
+        }
+        if (c == 'G')   // Gsp:lv - start a wild battle against species sp at level lv, as if met in grass
+        {
+            u16 sp = (u16)strtoul(sScript, (char **)&sScript, 10);
+            u8 lv = 5;
+            if (*sScript == ':')
+                lv = (u8)strtoul(sScript + 1, (char **)&sScript, 10);
+            CreateScriptedWildMon(sp, lv, ITEM_NONE);
+            BattleSetup_StartWildBattle();
+            printf("[pkbn-owtest] wild battle: species %u lv %u\n", sp, lv);
+            continue;
+        }
+        if (c == 'T')   // Titem: run "additem item, 1" through the script engine (tests the scripts' item hook)
+        {
+            static u8 sScr[8];
+            u16 item = (u16)strtoul(sScript, (char **)&sScript, 10);
+            sScr[0] = 0x44;                       // SCR_OP_ADDITEM (data/script_cmd_table.inc)
+            sScr[1] = item & 0xFF, sScr[2] = item >> 8;
+            sScr[3] = 1, sScr[4] = 0;
+            sScr[5] = 0x02;                       // SCR_OP_END
+            ScriptContext_SetupScript(sScr);
+            printf("[pkbn-owtest] script additem %u\n", item);
+            continue;
+        }
+        if (c == 'M')   // Mn: tap A every 8 frames for n frames (text boxes, post-battle)
+        {
+            sMash = strtoul(sScript, (char **)&sScript, 10);
+            return 0;
+        }
+        if (c == 'P')
+        {
+            sDumpNext = TRUE;
+            continue;
+        }
+        if (c == 'Q')
+        {
+            printf("[pkbn-owtest] done at frame %u\n", (unsigned)sFrame);
+            fflush(stdout);
+            exit(0);
+        }
+        sKey = KeyOf(c);
+        sHold = 3;
+        sWait = 6;
+        return sKey;
+    }
+    return 0;
+}
+
+// Called by VDraw with the finished 264x176 canvas.
+void PkbnOwTest_Frame(const u16 *canvas)
+{
+    static u32 sCount;
+    const char *dir = getenv("PKBN_DUMP_DIR");
+    char path[512];
+    FILE *f;
+    s32 i;
+    if (!sDumpNext)
+        return;
+    sDumpNext = FALSE;
+    if (dir == NULL)
+        return;
+    snprintf(path, sizeof(path), "%s/ow_%05u.ppm", dir, (unsigned)sCount++);
+    f = fopen(path, "wb");
+    if (f == NULL)
+        return;
+    fprintf(f, "P6\n%d %d\n255\n", PKBN_CANVAS_W, PKBN_CANVAS_H);
+    for (i = 0; i < PKBN_CANVAS_W * PKBN_CANVAS_H; i++)
+    {
+        u16 c = canvas[i];
+        u8 rgb[3] = { (u8)((c & 31) << 3), (u8)(((c >> 5) & 31) << 3), (u8)(((c >> 10) & 31) << 3) };
+        fwrite(rgb, 1, 3, f);
+    }
+    fclose(f);
+    printf("[pkbn-owtest] frame %u dumped (%s)\n", (unsigned)sFrame, path);
+}
+
+static void GiveParty(const char *spec)
+{
+    s32 slot = 0;
+    while (spec && *spec && slot < PARTY_SIZE)
+    {
+        u16 sp = (u16)strtol(spec, (char **)&spec, 10);
+        u8 lv = 5;
+        if (*spec == ':')
+            lv = (u8)strtol(spec + 1, (char **)&spec, 10);
+        CreateMon(&gPlayerParty[slot], sp, lv, 32, FALSE, 0, OT_ID_PLAYER_ID, 0);
+        if (*spec == ':')
+        {
+            s32 m = 0;
+            spec++;
+            while (*spec && *spec != '|' && m < MAX_MON_MOVES)
+            {
+                u16 mv = (u16)strtol(spec, (char **)&spec, 10);
+                SetMonMoveSlot(&gPlayerParty[slot], mv, m++);
+                if (*spec == '/')
+                    spec++;
+            }
+            for (; m < MAX_MON_MOVES; m++)
+                SetMonMoveSlot(&gPlayerParty[slot], MOVE_NONE, m);
+        }
+        slot++;
+        if (*spec == '|')
+            spec++;
+    }
+    CalculatePlayerPartyCount();
+}
+
+static void CB2_OwTestStart(void)
+{
+    const char *t;
+    s32 group = 0, num = 0, x = -1, y = -1;
+    sscanf(getenv("PKBN_OWTEST"), "%d:%d:%d:%d", &group, &num, &x, &y);
+    NewGameInitData();
+    FlagSet(FLAG_SYS_POKEMON_GET);
+    FlagSet(FLAG_SYS_POKEDEX_GET);
+    FlagSet(FLAG_SYS_B_DASH);
+    if ((t = getenv("PKBN_OWTEST_FLAGS")) != NULL)
+        while (*t)
+        {
+            FlagSet((u16)strtol(t, (char **)&t, 10));
+            while (*t == ',')
+                t++;
+        }
+    ZeroPlayerPartyMons();
+    GiveParty(getenv("PKBN_OWTEST_PARTY"));
+    if ((t = getenv("PKBN_OWTEST_ITEMS")) != NULL)
+        while (*t)
+        {
+            u16 item = (u16)strtol(t, (char **)&t, 10);
+            u16 n = (*t == ':') ? (u16)strtol(t + 1, (char **)&t, 10) : 1;
+            AddBagItem(item, n);
+            while (*t == ',')
+                t++;
+        }
+    if (getenv("PKBN_OWTEST_MONEY"))
+        SetMoney(&gSaveBlock1Ptr->money, (u32)atoi(getenv("PKBN_OWTEST_MONEY")));
+    SetWarpDestination(group, num, -1, x, y);
+    WarpIntoMap();
+    printf("[pkbn-owtest] start: map %d:%d at %d,%d\n", (int)group, (int)num, (int)x, (int)y);
+    fflush(stdout);
+    SetMainCallback2(CB2_LoadMap);
+}
+
+void PkbnOwTest_Start(void)
+{
+    sActive = TRUE;
+    sScript = getenv("PKBN_OWKEYS");
+    SetMainCallback2(CB2_OwTestStart);
+}
+
+#endif // PORTABLE
