+static struct PoseSlot sPoses[8];
+static u32 sPoseUse;
+
+static struct PoseSlot *PoseFor(const struct PkbnMonPic *pic, u8 frame, u32 t)
+{
+    static u8 sPose[MONSPRITE_W * MONSPRITE_H];
+    struct PoseSlot *slot = NULL;
+    u32 key = t * 2 + (frame & 1) + 1, i;
+    s32 x0, y0, x1, y1, y;
