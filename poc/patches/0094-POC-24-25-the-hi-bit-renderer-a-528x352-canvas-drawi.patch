+        slot = &sPoses[0];
+        for (i = 1; i < ARRAY_COUNT(sPoses); i++)
+            if (sPoses[i].used < slot->used)
+                slot = &sPoses[i];
+        slot->pic = pic;
+        slot->nat = pic->b2nat;
+        slot->key = 0;
