diff --git a/include/pkbn/monsprite.h b/include/pkbn/monsprite.h
new file mode 100644
index 0000000..4f00f1e
--- /dev/null
+++ b/include/pkbn/monsprite.h
@@ -0,0 +1,25 @@
+#ifndef GUARD_PKBN_MONSPRITE_H
+#define GUARD_PKBN_MONSPRITE_H
+// POC-25: animated Pokémon from the player's own Black 2 / White 2, imported at build time by
+// tools/import_b2_sprites.py into pkbn_b2_sprites.bin (never committed). Each sprite is a cut-out puppet: parts
+// (upscaled 2x, 16 colours), cells of parts, cell animations (rotate / scale / move), poses of cells and a pose
+// sequence. Without the file, or with PKBN_HIBIT=0 / PKBN_B2=0, Emerald's own pictures are drawn as before.
+#include "global.h"
+
+// The pose buffer: 2x pixels, the Pokémon's feet (the sprite's origin) at (MONSPRITE_OX, MONSPRITE_OY).
+#define MONSPRITE_W  384
+#define MONSPRITE_H  320
+#define MONSPRITE_OX 176
+#define MONSPRITE_OY 248
+
+bool8 MonSprite_Load(void);                            // once at start; FALSE when there is no file
+const u8 *MonSprite_Find(u16 nationalDex);             // the species' record, or NULL
+const u16 *MonSprite_Palette(const u8 *rec, bool8 shiny);
+// Renders the pose at tick t (60 per second) into out (MONSPRITE_W x MONSPRITE_H palette indices, 0 = clear).
+// pose 0 plays the species' own sequence; pose 1 holds its action pose. Returns the bounding box of what was drawn
+// (x0, y0 inclusive; x1, y1 exclusive), x1 <= x0 when nothing was.
+void MonSprite_Render(const u8 *rec, u8 pose, u32 t, u8 *out, s32 *x0, s32 *y0, s32 *x1, s32 *y1);
+// Pixel counts per palette index over the parts (for the Unison palette fusion).
+void MonSprite_ColourCounts(const u8 *rec, u32 counts[16]);
+
+#endif // GUARD_PKBN_MONSPRITE_H
