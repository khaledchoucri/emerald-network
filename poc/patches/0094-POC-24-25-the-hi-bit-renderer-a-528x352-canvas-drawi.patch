diff --git a/src/pkbn/monsprite.c b/src/pkbn/monsprite.c
new file mode 100644
index 0000000..3cf7662
--- /dev/null
+++ b/src/pkbn/monsprite.c
@@ -0,0 +1,322 @@
+// POC-25: animated Pokémon sprites from the player's own Black 2 / White 2 (see include/pkbn/monsprite.h).
+// The record layout is written by tools/import_b2_sprites.py:
+//   u16 pal[16], shiny[16]
+//   u16 nCells; per cell: u16 nParts; per part: s16 x, y, u16 w, h (2x pixels, around the cell's origin), w*h/2 bytes 4bpp
+//   u16 nAnims; per anim: u16 nFrames, loopStart; per frame: u16 duration, cell, rotation (65536 = a turn),
+//                                                       s16 scaleX, scaleY (8.8), x, y (1x pixels)
+//   u16 nPoses; per pose: u16 nNodes; per node (back to front): u16 anim, s16 x, y (1x)
+//   u16 nSeq, seqLoop; per step: u16 duration, pose, s16 x, y (1x)
+#include <stdio.h>     // first: the C library before global.h's macros (as src/pkbn/replay.c)
+#include <stdlib.h>
+#include <string.h>
+#include "global.h"
+#include "pkbn/monsprite.h"
+
+#ifdef PORTABLE
+
+extern const char *Platform_DataPath(const char *file);
+
+#define MAGIC "PKBNB2S1"
+static u8 *sBlob;
+static u32 sBlobSize, sCount;
+static bool8 sTried;
+
+static u16 U16(const u8 *p) { return (u16)(p[0] | (p[1] << 8)); }
+static s16 S16(const u8 *p) { return (s16)U16(p); }
+static u32 U32(const u8 *p) { return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24); }
+
+static bool8 TryLoad(const char *path)
+{
+    FILE *f;
+    long size;
+    if (path == NULL || (f = fopen(path, "rb")) == NULL)
+        return FALSE;
+    fseek(f, 0, SEEK_END);
+    size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    sBlob = malloc(size > 16 ? size : 16);
+    if (sBlob == NULL || fread(sBlob, 1, size, f) != (size_t)size || size < 16 || memcmp(sBlob, MAGIC, 8) != 0)
+    {
+        fclose(f);
+        free(sBlob);
+        sBlob = NULL;
+        return FALSE;
+    }
+    fclose(f);
+    sBlobSize = (u32)size;
+    sCount = U32(sBlob + 12);
+    printf("[pkbn] Black 2 sprites: %u species from %s\n", (unsigned)(sCount ? sCount - 1 : 0), path);
+    return TRUE;
+}
+
+bool8 MonSprite_Load(void)
+{
+    if (sTried)
+        return sBlob != NULL;
+    sTried = TRUE;
+    if (getenv("PKBN_B2") != NULL && atoi(getenv("PKBN_B2")) == 0)
+        return FALSE;
+    return TryLoad(getenv("PKBN_SPRITES")) || TryLoad(Platform_DataPath("pkbn_b2_sprites.bin"))
+        || TryLoad("pkbn_b2_sprites.bin") || TryLoad("/data/pkbn_b2_sprites.bin");   // (the browser build's copy)
+}
+
+const u8 *MonSprite_Find(u16 national)
+{
+    u32 off;
+    if (!MonSprite_Load() || national == 0 || national >= sCount)
+        return NULL;
+    off = U32(sBlob + 16 + national * 4);
+    return (off && off < sBlobSize) ? sBlob + off : NULL;
+}
+
+const u16 *MonSprite_Palette(const u8 *rec, bool8 shiny)
+{
+    static u16 sPal[2][16];
+    s32 i;
+    for (i = 0; i < 16; i++)
+        sPal[shiny & 1][i] = U16(rec + (shiny ? 32 : 0) + i * 2) | 0x8000;
+    return sPal[shiny & 1];
+}
+
+// ---- an index of one record (where each cell, part, anim and pose starts), cached for the few on screen ----------
+struct Part { s16 x, y; u16 w, h; const u8 *px; };
+struct Index
+{
+    const u8 *rec;
+    u16 nCells, nAnims, nPoses, nSeq, seqLoop;
+    u16 *cellFirst, *cellCount;  // into parts
+    struct Part *parts;
+    const u8 **anim;             // -> u16 nFrames, loopStart, frames
+    const u8 **pose;             // -> u16 nNodes, nodes
+    const u8 *seq;               // -> steps
+};
+
+static struct Index sCache[6];
+static u32 sCacheNext;
+
+static const struct Index *IndexOf(const u8 *rec)
+{
+    struct Index *x;
+    const u8 *p;
+    u32 i, k, nParts = 0;
+    for (i = 0; i < ARRAY_COUNT(sCache); i++)
+        if (sCache[i].rec == rec)
+            return &sCache[i];
+    x = &sCache[sCacheNext++ % ARRAY_COUNT(sCache)];
+    free(x->cellFirst); free(x->cellCount); free(x->parts); free(x->anim); free(x->pose);
+    memset(x, 0, sizeof(*x));
+    x->rec = rec;
+    // count the parts first
+    p = rec + 64;
+    x->nCells = U16(p); p += 2;
+    for (i = 0; i < x->nCells; i++)
+    {
+        u16 n = U16(p);
+        p += 2;
+        for (k = 0; k < n; k++)
+        {
+            p += 8 + U16(p + 4) * U16(p + 6) / 2;
+            nParts++;
+        }
+    }
+    x->cellFirst = malloc(sizeof(u16) * (x->nCells + 1));
+    x->cellCount = malloc(sizeof(u16) * (x->nCells + 1));
+    x->parts = malloc(sizeof(struct Part) * (nParts + 1));
+    p = rec + 66;
+    nParts = 0;
+    for (i = 0; i < x->nCells; i++)
+    {
+        u16 n = U16(p);
+        p += 2;
+        x->cellFirst[i] = (u16)nParts;
+        x->cellCount[i] = n;
+        for (k = 0; k < n; k++)
+        {
+            struct Part *pt = &x->parts[nParts++];
+            pt->x = S16(p); pt->y = S16(p + 2); pt->w = U16(p + 4); pt->h = U16(p + 6);
+            pt->px = p + 8;
+            p += 8 + pt->w * pt->h / 2;
+        }
+    }
+    x->nAnims = U16(p); p += 2;
+    x->anim = malloc(sizeof(u8 *) * (x->nAnims + 1));
+    for (i = 0; i < x->nAnims; i++)
+    {
+        x->anim[i] = p;
+        p += 4 + U16(p) * 14;
+    }
+    x->nPoses = U16(p); p += 2;
+    x->pose = malloc(sizeof(u8 *) * (x->nPoses + 1));
+    for (i = 0; i < x->nPoses; i++)
+    {
+        x->pose[i] = p;
+        p += 2 + U16(p) * 6;
+    }
+    x->nSeq = U16(p); x->seqLoop = U16(p + 2);
+    x->seq = p + 4;
+    return x;
+}
+
+// The frame of an animation (stride bytes per frame, the duration first) at tick t, looping from loopStart.
+static const u8 *FrameAt(const u8 *frames, u16 n, u16 loopStart, u32 stride, u32 t)
+{
+    u32 total = 0, pre = 0, i;
+    if (n == 0)
+        return NULL;
+    for (i = 0; i < n; i++)
+    {
+        if (i < loopStart)
+            pre += U16(frames + i * stride);
+        total += U16(frames + i * stride);
+    }
+    if (total == 0)
+        return frames;
+    if (t >= total)
+        t = (total > pre) ? pre + (t - pre) % (total - pre) : total - 1;
+    for (i = 0; i < n; i++)
+    {
+        u32 d = U16(frames + i * stride);
+        if (t < d)
+            return frames + i * stride;
+        t -= d;
+    }
+    return frames + (n - 1) * stride;
+}
+
+// (no libm in the Linux link: a small sine, and floor)
+static double Sine(double x)
+{
+    const double pi = 3.14159265358979323846;
+    double x2;
+    while (x > pi) x -= 2 * pi;
+    while (x < -pi) x += 2 * pi;
+    if (x > pi / 2) x = pi - x;          // sin(pi - x) = sin x: keeps the series where it is exact
+    if (x < -pi / 2) x = -pi - x;
+    x2 = x * x;
+    return x * (1 - x2 / 6 * (1 - x2 / 20 * (1 - x2 / 42 * (1 - x2 / 72 * (1 - x2 / 110)))));
+}
+
+static s32 Floor(double v)
+{
+    s32 i = (s32)v;
+    return (v < 0 && v != i) ? i - 1 : i;
+}
+
+static void Bound(s32 *x0, s32 *y0, s32 *x1, s32 *y1, s32 x, s32 y)
+{
+    if (x < *x0) *x0 = x;
+    if (y < *y0) *y0 = y;
+    if (x + 1 > *x1) *x1 = x + 1;
+    if (y + 1 > *y1) *y1 = y + 1;
+}
+
+// One part of a cell, the cell's origin at (cx, cy) in the buffer, turned by rot and scaled (8.8). Like the DS's
+// affine sprites: each buffer pixel looks up its source pixel through the inverse transform.
+static void DrawPart(u8 *out, const struct Part *pt, double cx, double cy, u16 rot, s32 sx256, s32 sy256,
+                     s32 *x0, s32 *y0, s32 *x1, s32 *y1)
+{
+    s32 X, Y;
+    if (rot == 0 && sx256 == 256 && sy256 == 256)
+    {
+        s32 bx = Floor(cx) + pt->x, by = Floor(cy) + pt->y, i, j;
+        for (j = 0; j < pt->h; j++)
+            for (i = 0; i < pt->w; i++)
+            {
+                s32 k = j * pt->w + i;
+                u8 c = (pt->px[k >> 1] >> ((k & 1) * 4)) & 15;
+                s32 dx = bx + i, dy = by + j;
+                if (c && dx >= 0 && dy >= 0 && dx < MONSPRITE_W && dy < MONSPRITE_H)
+                {
+                    out[dy * MONSPRITE_W + dx] = c;
+                    Bound(x0, y0, x1, y1, dx, dy);
+                }
+            }
+        return;
+    }
+    {
+        double a = -(double)rot / 65536.0 * 2.0 * 3.14159265358979323846, ca = Sine(a + 1.57079632679489661923), sa = Sine(a);
+        double kx = sx256 ? sx256 / 256.0 : 1.0, ky = sy256 ? sy256 / 256.0 : 1.0;
+        double ax = kx < 0 ? -kx : kx, ay = ky < 0 ? -ky : ky;
+        double r = (double)((pt->x < 0 ? -pt->x : pt->x) + pt->w + (pt->y < 0 ? -pt->y : pt->y) + pt->h) * (ax > ay ? ax : ay) + 1;
+        s32 bx0 = (s32)(cx - r), bx1 = (s32)(cx + r), by0 = (s32)(cy - r), by1 = (s32)(cy + r);
+        if (bx0 < 0) bx0 = 0;
+        if (by0 < 0) by0 = 0;
+        if (bx1 > MONSPRITE_W) bx1 = MONSPRITE_W;
+        if (by1 > MONSPRITE_H) by1 = MONSPRITE_H;
+        for (Y = by0; Y < by1; Y++)
+            for (X = bx0; X < bx1; X++)
+            {
+                double dx = X + 0.5 - cx, dy = Y + 0.5 - cy;
+                s32 ux = Floor((ca * dx + sa * dy) / kx) - pt->x, uy = Floor((-sa * dx + ca * dy) / ky) - pt->y;
+                if (ux >= 0 && uy >= 0 && ux < pt->w && uy < pt->h)
+                {
+                    s32 k = uy * pt->w + ux;
+                    u8 c = (pt->px[k >> 1] >> ((k & 1) * 4)) & 15;
+                    if (c)
+                    {
+                        out[Y * MONSPRITE_W + X] = c;
+                        Bound(x0, y0, x1, y1, X, Y);
+                    }
+                }
+            }
+    }
+}
+
+void MonSprite_Render(const u8 *rec, u8 pose, u32 t, u8 *out, s32 *x0, s32 *y0, s32 *x1, s32 *y1)
+{
+    const struct Index *x = IndexOf(rec);
+    const u8 *step, *nodes;
+    u16 poseIdx, n, i;
+    s32 mx, my;
+    memset(out, 0, MONSPRITE_W * MONSPRITE_H);
+    *x0 = MONSPRITE_W; *y0 = MONSPRITE_H; *x1 = 0; *y1 = 0;
+    step = FrameAt(x->seq, x->nSeq, x->seqLoop, 8, t);
+    if (step == NULL || x->nPoses == 0)
+        return;
+    poseIdx = U16(step + 2);
+    mx = S16(step + 4); my = S16(step + 6);
+    if (pose == 1 && x->nPoses > 1)
+        poseIdx = 1, mx = 0, my = 0;   // the action pose (Black 2's second pose), held for an attack
+    if (poseIdx >= x->nPoses)
+        poseIdx = 0;
+    nodes = x->pose[poseIdx];
+    n = U16(nodes);
+    for (i = 0; i < n; i++)
+    {
+        const u8 *node = nodes + 2 + i * 6, *an, *e;
+        u16 ai = U16(node), cell, k;
+        if (ai >= x->nAnims)
+            continue;
+        an = x->anim[ai];
+        e = FrameAt(an + 4, U16(an), U16(an + 2), 14, t);
+        if (e == NULL)
+            continue;
+        cell = U16(e + 2);
+        if (cell >= x->nCells)
+            continue;
+        {
+            double cx = MONSPRITE_OX + (S16(node + 2) + mx + S16(e + 10)) * 2.0;
+            double cy = MONSPRITE_OY + (S16(node + 4) + my + S16(e + 12)) * 2.0;
+            // the cell's parts, the first one on top
+            for (k = x->cellCount[cell]; k > 0; k--)
+                DrawPart(out, &x->parts[x->cellFirst[cell] + k - 1], cx, cy, U16(e + 4), S16(e + 6), S16(e + 8), x0, y0, x1, y1);
+        }
+    }
+}
+
+void MonSprite_ColourCounts(const u8 *rec, u32 counts[16])
+{
+    const struct Index *x = IndexOf(rec);
+    u32 i, k, nParts = 0;
+    memset(counts, 0, sizeof(u32) * 16);
+    for (i = 0; i < x->nCells; i++)
+        nParts += x->cellCount[i];
+    for (i = 0; i < nParts; i++)
+        for (k = 0; k < (u32)x->parts[i].w * x->parts[i].h; k++)
+            counts[(x->parts[i].px[k >> 1] >> ((k & 1) * 4)) & 15]++;
+}
+
+#else
+bool8 MonSprite_Load(void) { return FALSE; }
+const u8 *MonSprite_Find(u16 national) { return NULL; }
+#endif // PORTABLE
