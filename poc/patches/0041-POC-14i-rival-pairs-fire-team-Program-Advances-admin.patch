+// ---- An in-game partner (POC-14, our design - TUNE) ------------------------------------------------------------------
+// Steven at the Space Center: his Pokémon don't stand on the grid; every few seconds the next one comes in from the
+// side for one attack - its strongest move (power, x1.5 for STAB) - like a Leader chip.
+static bool8 BusyOrDisabled(u8 side);
+
+#define PARTNER_FIRST_FRAMES 300
+#define PARTNER_FRAMES       600
+
+static void PartnerFrame(void)
+{
+    struct Pokemon *mon;
+    struct BattlePokemon bm;
+    u16 mv = MOVE_NONE, species;
+    s32 m, best = 0, tries;
+    char nm[POKEMON_NAME_LENGTH + 1], who[12], line[48];
+    if (!sB.partner || --sB.partnerTimer)
+        return;
+    sB.partnerTimer = PARTNER_FRAMES;
+    if (BusyOrDisabled(SIDE_PLAYER) || Foe_LiveCount() == 0)
+    {
+        sB.partnerTimer = 30;
+        return;
+    }
+    for (tries = 0; tries < MULTI_PARTY_SIZE; tries++)
+    {
+        mon = &gPlayerParty[MULTI_PARTY_SIZE + sB.partnerNext];
+        sB.partnerNext = (sB.partnerNext + 1) % MULTI_PARTY_SIZE;
+        if (GetMonData(mon, MON_DATA_SPECIES) != SPECIES_NONE)
+            break;
+    }
+    if (tries == MULTI_PARTY_SIZE)
+        return;
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    MonToBattleMon(mon, &bm);
+    for (m = 0; m < MAX_MON_MOVES; m++)
+    {
+        u16 x = bm.moves[m];
+        s32 score = gBattleMoves[x].power;
+        if (score == 0)
+            continue;
+        if (gBattleMoves[x].type == bm.types[0] || gBattleMoves[x].type == bm.types[1])
+            score = score * 3 / 2;
+        if (score > best)
+            best = score, mv = x;
+    }
+    if (mv == MOVE_NONE)
+        return;
+    Pkbn_GameStringToAscii(nm, gSpeciesNames[species], sizeof(nm));
+    Pkbn_GameStringToAscii(who, gTrainers[TRAINER_STEVEN].trainerName, sizeof(who));
+    snprintf(line, sizeof(line), "%s: GO, %s!", who, nm);
+    Flash(line, 70);
+    PlaySE(SE_SUCCESS);
+    PKBN_LOG("partner: %s's %s uses move %u", who, nm, mv);
+    Moves_Use(SIDE_PLAYER, mv, 0, &bm, nm, sB.active);
+}
+
 // ---- Legendaries as BN boss battles (POC-14, our design - TUNE) -------------------------------------------------------
 // A BN boss reshapes the field on a rhythm and saves a big attack for when it's hurt. Each legendary here keeps its
 // Gen 3 stats and moves; on top it has a field phase every few seconds (announced first, so you can move) and a
@@ -790,7 +846,11 @@ static void Begin(void)
     else if (gMapHeader.mapLayout != NULL && getenv("PKBN_SELFTEST") == NULL)
         Field_StartConditions();   // self-tests have no map: their battles start as before
 
-    for (i = 0; i < PARTY_SIZE; i++)
+    // POC-14: with an in-game partner (Steven) the player's half of gPlayerParty is the first 3 (FillPartnerParty puts
+    // the partner's Pokémon in slots 3-5, battle_tower.c:2977); those assist from the side instead.
+    sB.partner = (gBattleTypeFlags & BATTLE_TYPE_INGAME_PARTNER) != 0;
+    sB.partnerTimer = PARTNER_FIRST_FRAMES;
+    for (i = 0; i < (sB.partner ? MULTI_PARTY_SIZE : PARTY_SIZE); i++)
     {
         if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) == SPECIES_NONE)
             break;
@@ -1802,6 +1862,80 @@ static void BossFrame(void)
     sB.bossPending = BOSS_WARN_FRAMES;
 }
 
+// A pair of rival foes on the grid at once (Tate & Liza, Maxie & Tabitha, two admins or leaders who spot you together)
+// fights as a team (POC-14, our design - TUNE): once either is below half its HP (tier 5: again below a quarter),
+// they fire a team Program Advance - a PA whose recipe the two know between them (2 of 3 moves), or else the PA of
+// a type they share, or else of the first one's type. Both line up for it.
+static s8 TeamPA(const struct Fighter *a, const struct Fighter *b)
+{
+    struct Fighter both = *a;
+    s32 k, m, best = -1, bestPow = 0;
+    u8 n = 0;
+    for (m = 0; m < MAX_MON_MOVES; m++)   // the union of their moves (first 4 distinct)
+        both.bm.moves[m] = MOVE_NONE;
+    for (k = 0; k < 2; k++)
+        for (m = 0; m < MAX_MON_MOVES && n < MAX_MON_MOVES; m++)
+        {
+            u16 mv = (k ? b : a)->bm.moves[m];
+            if (mv && (k == 0 || (mv != a->bm.moves[0] && mv != a->bm.moves[1] && mv != a->bm.moves[2] && mv != a->bm.moves[3])))
+                both.bm.moves[n++] = mv;
+        }
+    {
+        s8 pa = RivalPA(&both);
+        if (pa >= 0)
+            return pa;
+    }
+    for (k = 0; k < PKBN_PA_COUNT; k++)
+    {
+        u8 t = gPkbnProgramAdvances[k].type;
+        if ((a->bm.types[0] == t || a->bm.types[1] == t) && (b->bm.types[0] == t || b->bm.types[1] == t)
+         && gPkbnProgramAdvances[k].power > bestPow)
+            best = k, bestPow = gPkbnProgramAdvances[k].power;
+    }
+    for (k = 0; k < PKBN_PA_COUNT && best < 0; k++)   // no type in common: the PA of the leader's lead type
+        if (gPkbnProgramAdvances[k].type == a->bm.types[0])
+            best = k;
+    return best;
+}
+
+static bool8 TeamSpecial(struct Fighter *e)
+{
+    const struct Fighter *a, *b;
+    u32 hp, maxHP;
+    u8 allowed = sB.rivalTier >= 5 ? 2 : 1;
+    s8 pa;
+    char names[24], line[56];
+    if (sB.foeCount != 2 || Foe_LiveCount() != 2 || sB.teamPAs >= allowed)
+        return FALSE;
+    a = Foe_Get(0), b = Foe_Get(1);
+    // the one more hurt decides: below half, then (tier 5) below a quarter
+    if (a->bm.hp * b->bm.maxHP <= b->bm.hp * a->bm.maxHP)
+        hp = a->bm.hp, maxHP = a->bm.maxHP;
+    else
+        hp = b->bm.hp, maxHP = b->bm.maxHP;
+    if (hp > (sB.teamPAs == 0 ? maxHP / 2 : maxHP / 4) || (pa = TeamPA(a, b)) < 0)
+        return FALSE;
+    if (gBattleTypeFlags & BATTLE_TYPE_TWO_OPPONENTS)
+    {
+        char x[12], y[12];
+        Pkbn_GameStringToAscii(x, gTrainers[gTrainerBattleOpponent_A].trainerName, sizeof(x));
+        Pkbn_GameStringToAscii(y, gTrainers[gTrainerBattleOpponent_B].trainerName, sizeof(y));
+        snprintf(names, sizeof(names), "%s & %s", x, y);
+    }
+    else
+        Pkbn_GameStringToAscii(names, gTrainers[gTrainerBattleOpponent_A].trainerName, sizeof(names));
+    snprintf(line, sizeof(line), "%s: TEAM %s!", names, gPkbnProgramAdvances[pa].name);
+    Flash(line, 100);
+    PlaySE(SE_SUCCESS);
+    PKBN_LOG("team program advance: %s (%s + %s)", line, a->name, b->name);
+    sB.teamPAs++;
+    e->chainSlot = 0;
+    sB.foeAi[sB.cur ^ 1][1] += 60;   // the partner lines up too: its next attack waits
+    EnemyLineUp(gPkbnProgramAdvances[pa].kind);
+    Moves_UsePA(SIDE_ENEMY, pa, &e->bm, e->name, 0);
+    return TRUE;
+}
+
 static bool8 RivalSpecial(struct Fighter *e)
 {
     s8 pa;
@@ -1861,6 +1995,8 @@ static void UpdateOneEnemy(void)
             SetMsg(line, 50);
             return;
         }
+        if (sB.rivalTier >= 3 && TeamSpecial(e))
+            return;
         if (sB.rivalTier && RivalSpecial(e))
             return;
         if (e->chainSlot && e->bm.pp[e->chainSlot - 1])
@@ -2272,6 +2408,7 @@ static void UpdateFight(void)
     if (sB.state != ST_FIGHT)
         return;
     BossFrame();
+    PartnerFrame();
     Moves_Update();
     CheckFaints();
 }
