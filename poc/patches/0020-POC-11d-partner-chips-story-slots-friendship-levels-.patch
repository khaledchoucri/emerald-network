+// ---- Partner chips (POC-11) ------------------------------------------------------------------------------------
+// Story points that give a slot (TUNE): the first rival battle (Route 103), then badges 3, 5 and 7.
+u8 PkbnPartner_Unlocked(void)
+{
+    u8 n = 0;
+    if (FlagGet(FLAG_DEFEATED_RIVAL_ROUTE103))
+        n++;
+    if (FlagGet(FLAG_BADGE03_GET))
+        n++;
+    if (FlagGet(FLAG_BADGE05_GET))
+        n++;
+    if (FlagGet(FLAG_BADGE07_GET))
+        n++;
+    if (getenv("PKBN_TEST_PARTNER_SLOTS") != NULL)
+        n = (u8)atoi(getenv("PKBN_TEST_PARTNER_SLOTS"));
+    return n > PKBN_PARTNER_SLOTS ? PKBN_PARTNER_SLOTS : n;
+}
+
+u8 PkbnPartner_Level(struct Pokemon *mon)
+{
+    u8 f = GetMonData(mon, MON_DATA_FRIENDSHIP);   // BN6 Navi chips V1-V3; ours by friendship (TUNE)
+    return f >= 220 ? 3 : f >= 150 ? 2 : 1;
+}
+
+u16 PkbnPartner_PowerPct(u8 level)
+{
+    return level >= 3 ? 160 : level == 2 ? 130 : 100;
+}
+
+s32 PkbnPartner_PartySlot(u16 naviId)
+{
+    s32 i;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+         && GetMonData(&gPlayerParty[i], MON_DATA_ENCRYPT_SEPARATOR) == naviId)
+            return i;
+    return -1;
+}
+
 u8 Chip_FolderSize(u8 partyCount)
 {
     u8 n = partyCount ? partyCount : 1;
@@ -212,6 +254,19 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
     }
 
 shuffle:
+    // Partner chips (POC-11): one per assigned slot whose Pokémon is in the party, on top of the folder size.
+    for (i = 0; i < PkbnPartner_Unlocked() && folder->count < FOLDER_MAX; i++)
+    {
+        struct PkbnPartnerSlot *ps = PkbnPartner_Slot(i);
+        s32 slot = ps->naviId ? PkbnPartner_PartySlot(ps->naviId) : -1;
+        if (slot < 0 || slot >= partyCount || party[slot].species == SPECIES_NONE || !PkbnFolder_MoveIsChip(ps->move))
+            continue;
+        folder->chips[folder->count].move = ps->move;
+        folder->chips[folder->count].letter = LETTER_WILD;
+        folder->chips[folder->count].owner = slot;
+        folder->chips[folder->count].slot = PkbnPartner_Level(&gPlayerParty[slot]);
+        folder->count++;
+    }
     for (p = 0; p < folder->count; p++)
         folder->pile[p] = p;
     folder->pileCount = folder->count;
