+// ---- partner chips (POC-11) -------------------------------------------------------------------------------------
+
+static const char *const sPartnerUnlock[PKBN_PARTNER_SLOTS] = {
+    "BEAT YOUR RIVAL ON ROUTE 103", "THE 3RD BADGE", "THE 5TH BADGE", "THE 7TH BADGE" };
+
+static u16 PartnerMove(u8 i)
+{
+    struct PkbnPartnerSlot *ps = PkbnPartner_Slot(i);
+    return (i < PkbnPartner_Unlocked() && ps->naviId && PkbnPartner_PartySlot(ps->naviId) >= 0) ? ps->move : MOVE_NONE;
+}
+
+// A: the next party Pokémon for this slot (then none). Its first chip move goes with it.
+static void PartnerCyclePokemon(u8 i)
+{
+    struct PkbnPartnerSlot *ps = PkbnPartner_Slot(i);
+    s32 cur = ps->naviId ? PkbnPartner_PartySlot(ps->naviId) : -1, next, m;
+    if (i >= PkbnPartner_Unlocked())
+    {
+        Note(sPartnerUnlock[i]);
+        PlaySE(SE_FAILURE);
+        return;
+    }
+    for (next = cur + 1; next < PARTY_SIZE; next++)
+        if (GetMonData(&gPlayerParty[next], MON_DATA_SPECIES) && !GetMonData(&gPlayerParty[next], MON_DATA_IS_EGG))
+            break;
+    if (next >= PARTY_SIZE)
+    {
+        ps->naviId = 0, ps->move = MOVE_NONE;
+    }
+    else
+    {
+        struct PkbnNavi *nv = Navi_ForMon(&gPlayerParty[next], TRUE);   // gives it a Navi ID if it has none
+        ps->naviId = nv ? nv->id : 0;
+        ps->move = MOVE_NONE;
+        for (m = 0; m < MAX_MON_MOVES; m++)
+            if (PkbnFolder_MoveIsChip(GetMonData(&gPlayerParty[next], MON_DATA_MOVE1 + m)))
+            {
+                ps->move = GetMonData(&gPlayerParty[next], MON_DATA_MOVE1 + m);
+                break;
+            }
+    }
+    PlaySE(SE_SELECT);
+}
+
+// SELECT: the slot's next move among the Pokémon's own moves.
+static void PartnerCycleMove(u8 i)
+{
+    struct PkbnPartnerSlot *ps = PkbnPartner_Slot(i);
+    s32 slot = ps->naviId ? PkbnPartner_PartySlot(ps->naviId) : -1, m, k;
+    if (slot < 0)
+        return;
+    for (m = 0; m < MAX_MON_MOVES; m++)
+        if (GetMonData(&gPlayerParty[slot], MON_DATA_MOVE1 + m) == ps->move)
+            break;
+    for (k = 1; k <= MAX_MON_MOVES; k++)
+    {
+        u16 mv = GetMonData(&gPlayerParty[slot], MON_DATA_MOVE1 + (m + k) % MAX_MON_MOVES);
+        if (PkbnFolder_MoveIsChip(mv))
+        {
+            ps->move = mv;
+            break;
+        }
+    }
+    PlaySE(SE_SELECT);
+}
+
+static void DrawPartnerList(u16 *fb)
+{
+    s32 i;
+    Text(fb, LIST_X + 4, LIST_Y - 14, "PARTNER CHIPS: SWITCH IN + MOVE", RGB(12, 14, 20));
+    for (i = 0; i < PKBN_PARTNER_SLOTS; i++)
+    {
+        struct PkbnPartnerSlot *ps = PkbnPartner_Slot(i);
+        s32 y = LIST_Y + i * 24, slot = ps->naviId ? PkbnPartner_PartySlot(ps->naviId) : -1;
+        char line[48];
+        if (i == sF.cursor[PAGE_PARTNER])
+            Pkbn_FillRect(fb, LIST_X - 1, y - 1, PANEL_X - LIST_X - 4, 22, RGB(8, 14, 28));
+        if (i >= PkbnPartner_Unlocked())
+        {
+            snprintf(line, sizeof(line), "%d  LOCKED", (int)i + 1);
+            Text(fb, LIST_X + 2, y - 2, line, RGB(14, 14, 16));
+            Text(fb, LIST_X + 14, y + 8, sPartnerUnlock[i], RGB(12, 12, 14));
+            continue;
+        }
+        if (slot < 0)
+        {
+            snprintf(line, sizeof(line), "%d  EMPTY (A: CHOOSE)", (int)i + 1);
+            Text(fb, LIST_X + 2, y + 3, line, RGB(22, 24, 28));
+            continue;
+        }
+        {
+            char sp[16], mv[MOVE_NAME_LENGTH + 1];
+            Pkbn_BlitIcon(fb, sF.partyIcon[slot], LIST_X - 4, y - 8, FALSE, 0);
+            Pkbn_GameStringToAscii(sp, gSpeciesNames[GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES)], sizeof(sp));
+            MoveName(mv, sizeof(mv), ps->move);
+            snprintf(line, sizeof(line), "%s", sp);
+            Text(fb, LIST_X + 28, y - 2, line, RGB(31, 31, 31));
+            snprintf(line, sizeof(line), "%s  V%u  *", mv, PkbnPartner_Level(&gPlayerParty[slot]));
+            Text(fb, LIST_X + 28, y + 8, line, RGB(31, 26, 6));
+        }
+    }
+}
