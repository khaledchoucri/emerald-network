+// ---- POC-27: places with their own grid (Khaled's picks C3a-d; our design, all numbers TUNE) ---------------------
+#define TIDE_PERIOD    420   // calm between tides (7 s)
+#define TIDE_WARN       60   // the back columns shimmer first
+#define TIDE_WASH       72   // the wash: their panels carry whoever stands there forward
+#define ROCK_FIRST     240
+#define ROCK_PERIOD    360   // between rocks
+#define ROCK_MAX         2   // fallen rocks on the grid at once
+#define SNARE_HOLD      50
+#define SNARE_SHOW      90
+
+void Place_Start(u8 place)
+{
+    s32 side, r, c;
+    sB.place |= place;
+    sB.tideT = TIDE_PERIOD / 2;
+    sB.tideStage = 0;
+    sB.rockX = -1;
+    sB.rockT = ROCK_FIRST;
+    if (place & PLACE_PUDDLES)
+        Scatter(PANEL_PUDDLE, 2);
+    if (place & PLACE_SNARES)
+        for (side = 0; side < 2; side++)
+        {
+            // two hidden snares a side, on grass panels when there are any
+            s32 n = 2, tries = 200;
+            bool8 grass = FALSE;
+            for (r = 0; r < GRID_ROWS; r++)
+                for (c = side ? PLAYER_COLS : 0; c < (side ? GRID_COLS : PLAYER_COLS); c++)
+                    grass |= sB.panel[r][c] == PANEL_GRASS;
+            while (n > 0 && tries-- > 0)
+            {
+                s8 x = (side ? PLAYER_COLS : 0) + Random() % PLAYER_COLS, y = Random() % GRID_ROWS;
+                if (sB.snare[y][x] || (y == 1 && (x == 1 || x == 4)) || (grass && sB.panel[y][x] != PANEL_GRASS)
+                 || sB.panel[y][x] == PANEL_BROKEN)
+                    continue;
+                sB.snare[y][x] = 1;
+                n--;
+            }
+        }
+    PKBN_LOG("place: %s%s%s%s", (place & PLACE_TIDE) ? "tide " : "", (place & PLACE_ROCKS) ? "rocks " : "",
+             (place & PLACE_SNARES) ? "snares " : "", (place & PLACE_PUDDLES) ? "puddles" : "");
+}
+
+static u8 RockCount(void)
+{
+    s32 r, c, n = 0;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            n += sB.rockHp[r][c] != 0;
+    return n;
+}
+
+// Whoever stands on (x, y): the player, and every foe of a pack. Calls fn(side) with that foe selected.
+static void ForEachOn(s8 x, s8 y, void (*fn)(u8 side))
+{
+    s32 k;
+    u8 cur = sB.cur;
+    if (sB.f[SIDE_PLAYER].x == x && sB.f[SIDE_PLAYER].y == y && sB.f[SIDE_PLAYER].bm.hp && !sB.f[SIDE_PLAYER].invuln)
+        fn(SIDE_PLAYER);
+    for (k = 0; k < sB.foeCount; k++)
+    {
+        const struct Fighter *f = Foe_Get(k);
+        if (f->x == x && f->y == y && f->bm.hp && !f->invuln)
+        {
+            Foe_Select(k);
+            fn(SIDE_ENEMY);
+        }
+    }
+    Foe_Select(cur);
+}
+
+static bool8 sRockHitSomeone;
+static void RockHits(u8 side)
+{
+    struct Fighter *f = &sB.f[side];
+    s32 dmg = f->bm.maxHP / 8 ? f->bm.maxHP / 8 : 1;
+    Moves_DamageFighter(side, dmg, "IS HIT BY A FALLING ROCK!");
+    if (f->stun < 20)
+        f->stun = 20;
+    sRockHitSomeone = TRUE;
+}
+
+static void Tide(void)
+{
+    s32 r, k;
+    if (sB.tideT && --sB.tideT)
+        return;
+    switch (sB.tideStage)
+    {
+    case 0:
+        sB.tideStage = 1;   // the shimmer
+        sB.tideT = TIDE_WARN;
+        break;
+    case 1:
+        sB.tideStage = 2;   // the wash: both back columns carry forward
+        sB.tideT = TIDE_WASH;
+        for (r = 0; r < GRID_ROWS; r++)
+            for (k = 0; k < 2; k++)
+            {
+                s8 c = k ? GRID_COLS - 1 : 0;
+                if (sB.panel[r][c] == PANEL_NORMAL)
+                    sB.panel[r][c] = k ? PANEL_ROAD_LEFT : PANEL_ROAD_RIGHT;
+            }
+        PlaySE(SE_M_SURF);
+        PKBN_LOG("tide: the back columns wash over");
+        break;
+    default:
+        sB.tideStage = 0;
+        sB.tideT = TIDE_PERIOD;
+        for (r = 0; r < GRID_ROWS; r++)
+        {
+            if (sB.panel[r][0] == PANEL_ROAD_RIGHT)
+                sB.panel[r][0] = PANEL_NORMAL;
+            if (sB.panel[r][GRID_COLS - 1] == PANEL_ROAD_LEFT)
+                sB.panel[r][GRID_COLS - 1] = PANEL_NORMAL;
+        }
+        break;
+    }
+}
+
+static void Rocks(void)
+{
+    if (sB.rockT && --sB.rockT)
+        return;
+    if (sB.rockX < 0)
+    {
+        // a shadow appears: on the player's panel 6 times in 10, else anywhere free
+        s32 tries = 30;
+        if (RockCount() >= ROCK_MAX)
+        {
+            sB.rockT = ROCK_PERIOD / 2;
+            return;
+        }
+        if (Random() % 10 < 6)
+            sB.rockX = sB.f[SIDE_PLAYER].x, sB.rockY = sB.f[SIDE_PLAYER].y;
+        else
+            while (tries--)
+            {
+                s8 x = Random() % GRID_COLS, y = Random() % GRID_ROWS;
+                if (sB.panel[y][x] != PANEL_BROKEN && !sB.rockHp[y][x])
+                {
+                    sB.rockX = x, sB.rockY = y;
+                    break;
+                }
+            }
+        sB.rockT = sB.rockX >= 0 ? ROCK_SHADOW : ROCK_PERIOD;
+        return;
+    }
+    // it lands: whoever is there is hurt and the rock shatters; on an empty panel it stays as an obstacle
+    sRockHitSomeone = FALSE;
+    ForEachOn(sB.rockX, sB.rockY, RockHits);
+    if (!sRockHitSomeone && sB.panel[sB.rockY][sB.rockX] != PANEL_BROKEN)
+        sB.rockHp[sB.rockY][sB.rockX] = ROCK_HP;
+    PlaySE(SE_M_ROCK_THROW);
+    Vis_Shake(1, 10);
+    PKBN_LOG("rock lands on (%d,%d)%s", sB.rockX, sB.rockY, sRockHitSomeone ? ": a hit" : "");
+    sB.rockX = -1;
+    sB.rockT = ROCK_PERIOD;
+}
+
+void Place_Update(void)
+{
+    s32 r, c;
+    if (sB.place & PLACE_TIDE)
+        Tide();
+    if (sB.place & PLACE_ROCKS)
+        Rocks();
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (sB.snare[r][c] > 1 && --sB.snare[r][c] == 1)
+                sB.snare[r][c] = 0;   // a sprung snare shows a moment, then it's gone
+}
+
+bool8 Place_HitRock(s8 x, s8 y, bool8 move)
+{
+    if (!InGrid(x, y) || sB.rockHp[y][x] == 0)
+        return FALSE;
+    sB.rockHp[y][x] = move ? 0 : sB.rockHp[y][x] - 1;
+    if (sB.rockHp[y][x] == 0)
+    {
+        PlaySE(SE_BREAKABLE_DOOR);
+        PKBN_LOG("rock at (%d,%d) broken", x, y);
+    }
+    return TRUE;
+}
+
+// A snare springs on whoever steps in (not Grass or Bug types, not floating): held a moment, and it shows.
+static void Snare(u8 side, s8 x, s8 y)
+{
+    struct Fighter *f = &sB.f[side];
+    if (sB.snare[y][x] != 1 || Field_Floats(f) || HasType(f, TYPE_GRASS) || HasType(f, TYPE_BUG))
+        return;
+    sB.snare[y][x] = SNARE_SHOW;
+    if (f->hold < SNARE_HOLD)
+        f->hold = SNARE_HOLD;
+    PlaySE(SE_M_BIND);
+    PKBN_LOG("%s is snared at (%d,%d)", f->name, x, y);
+}
+
+static u16 sConductDmg;
+static void Shock(u8 side)
+{
+    const struct Fighter *f = &sB.f[side];
+    if (HasType(f, TYPE_ELECTRIC) || HasType(f, TYPE_GROUND) || Field_Floats(f))
+        return;   // Electric types shrug it off, Ground types are immune (Gen 3), a floating one isn't in the water
+    Moves_DamageFighter(side, sConductDmg, "IS SHOCKED THROUGH THE WATER!");
+}
+
+void Place_Conduct(u8 hitSide, u16 move, s32 dmg)
+{
+    u8 pool[GRID_ROWS][GRID_COLS], stack[GRID_ROWS * GRID_COLS][2];
+    s32 n = 0, r, c;
+    const struct Fighter *hit = &sB.f[hitSide];
+    if (dmg <= 0 || gBattleMoves[move].type != TYPE_ELECTRIC || sB.panel[hit->y][hit->x] != PANEL_PUDDLE)
+        return;
+    memset(pool, 0, sizeof(pool));
+    pool[hit->y][hit->x] = 1;
+    stack[n][0] = hit->x, stack[n][1] = hit->y, n++;
+    while (n > 0)
+    {
+        s32 k, x, y;
+        n--;
+        x = stack[n][0], y = stack[n][1];
+        for (k = 0; k < 4; k++)
+        {
+            s32 nx = x + (k == 0) - (k == 1), ny = y + (k == 2) - (k == 3);
+            if (InGrid(nx, ny) && !pool[ny][nx] && sB.panel[ny][nx] == PANEL_PUDDLE)
+            {
+                pool[ny][nx] = 1;
+                stack[n][0] = nx, stack[n][1] = ny, n++;
+            }
+        }
+    }
+    pool[hit->y][hit->x] = 0;   // the one hit already took it
+    sConductDmg = dmg / 2 ? dmg / 2 : 1;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (pool[r][c])
+                ForEachOn(c, r, Shock);
+}
+
