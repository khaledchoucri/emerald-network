+// POC-27: what a place puts on a panel (code-drawn until there's art for it: TUNE)
+static void DrawPlace(u16 *fb, s32 c, s32 r, s32 x, s32 y, u32 t)
+{
+    s32 cx = x + PANEL_W / 2, cy = y + PANEL_H / 2;
+    if (sB.panel[r][c] == PANEL_PUDDLE)
+    {
+        Gfx_Ellipse(fb, cx, cy + 1, 15, 6, RGB(4, 12, 26), 11);
+        Gfx_Ellipse(fb, cx - 3, cy - 1, 7, 2, RGB(22, 28, 31), (t & 32) ? 9 : 6);   // the light on the water
+    }
+    if ((sB.place & PLACE_TIDE) && (c == 0 || c == GRID_COLS - 1) && sB.tideStage)
+    {
+        if (sB.tideStage == 1)
+            Gfx_FillBlend(fb, x + 2, y + 2, PANEL_W - 4, PANEL_H - 4, RGB(14, 26, 31), (t & 8) ? 7 : 3);   // it's coming
+        else
+        {
+            s32 k;
+            Gfx_FillBlend(fb, x + 2, y + 2, PANEL_W - 4, PANEL_H - 4, RGB(10, 22, 31), 8);
+            for (k = 0; k < 3; k++)   // foam lines running toward the middle
+            {
+                s32 fx = (s32)((t * 2 + k * 15) % (PANEL_W - 10));
+                if (c != 0)
+                    fx = PANEL_W - 10 - fx;
+                Pkbn_FillRect(fb, x + 4 + fx, y + 5 + k * 7, 6, 1, RGB(28, 31, 31));
+            }
+        }
+    }
+    if (sB.snare[r][c] > 1)
+    {
+        // a sprung snare: a knot of vines
+        s32 k;
+        for (k = -4; k <= 4; k++)
+            Pkbn_FillRect(fb, cx + k * 4, cy - 4 + ((k & 1) ? 3 : 0), 2, 8, (k & 1) ? RGB(6, 18, 4) : RGB(12, 26, 6));
+        Pkbn_FillRect(fb, cx - 17, cy + 2, 34, 2, RGB(10, 24, 6));
+    }
+    if (sB.rockX == c && sB.rockY == r && (sB.place & PLACE_ROCKS))
+    {
+        // the falling rock's shadow grows; the rock drops in over the last 16 frames
+        s32 k = ROCK_SHADOW - sB.rockT, rx = 3 + k * 11 / ROCK_SHADOW;
+        Gfx_Ellipse(fb, cx, cy + 3, rx, rx / 3 + 1, RGB(0, 0, 0), 10);
+        if (sB.rockT < 16)
+            Gfx_Draw(fb, Fx_Frame(FX_BOULDER, 0), cx, cy + 4 - sB.rockT * 8, 0, 0, 0);
+    }
+    if (sB.rockHp[r][c])
+        Gfx_Draw(fb, Fx_Frame(FX_BOULDER, 0), cx, cy + 4, 0, 0, 0);
+}
