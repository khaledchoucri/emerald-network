+++ b/src/pkbn/selftest.c
@@ -20,6 +20,7 @@
 #include "battle_setup.h"
 #include "pkbn/grid_battle.h"
 #include "pkbn/render.h"
+#include "pokedex.h"
 #include "pkbn/navicust.h"
 #include "pkbn/chip_pack.h"
 #include "party_menu.h"
@@ -406,6 +407,35 @@ void Pkbn_SelfTestMaybeStart(void)
             CreateTestMon(&gPlayerParty[i], members[i], SPECIES_TORCHIC, 7);
         CreateTestMon(&gEnemyParty[0], enemyPart, SPECIES_ZIGZAGOON, 4);
     }
+    // PKBN_TEST_SHINY=1: the enemy is shiny (same species, level and moves; a personality whose shiny value is 0
+    // against the player's ID, as IsMonShiny / IsShinyOtIdPersonality compute it)
+    if (getenv("PKBN_TEST_SHINY") != NULL)
+    {
+        struct Pokemon *e = &gEnemyParty[0];
+        u16 sp = GetMonData(e, MON_DATA_SPECIES), mv[MAX_MON_MOVES];
+        u8 lv = GetMonData(e, MON_DATA_LEVEL);
+        u32 otId = gSaveBlock2Ptr->playerTrainerId[0] | (gSaveBlock2Ptr->playerTrainerId[1] << 8)
