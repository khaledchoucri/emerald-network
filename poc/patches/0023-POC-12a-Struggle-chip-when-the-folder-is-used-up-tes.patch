@@ -33,13 +36,17 @@
 #include "script.h"
 #include "script_pokemon_util.h"
 #include "constants/items.h"
+#include "text.h"
+#include "pokemon_storage_system.h"
+#include "daycare.h"
 
 #ifdef PORTABLE
 
 static const char *sScript;
 static u32 sWait, sHold, sFrame, sMash;
 static u16 sKey;
-static bool8 sActive, sDumpNext;
+static bool8 sActive, sDumpNext, sUntilIdle;
+static u32 sIdle, sHoldBudget;
 
 bool8 PkbnOwTest_Active(void)
 {
@@ -83,6 +90,14 @@ u16 PkbnOwTest_Keys(void)
         sWait--;
         return 0;
     }
+    if (sUntilIdle)
+    {
+        // Y: wait until the message window (text printer 0) has finished printing for 20 frames (max 600)
+        sIdle = IsTextPrinterActive(0) ? 0 : sIdle + 1;
+        if (sIdle < 20 && ++sHoldBudget < 600)
+            return 0;
+        sUntilIdle = FALSE;
+    }
     while (sScript && *sScript)
     {
         char c = *sScript++;
@@ -133,6 +148,13 @@ u16 PkbnOwTest_Keys(void)
             sMash = strtoul(sScript, (char **)&sScript, 10);
             return 0;
         }
+        if (c == 'Y')
+        {
+            sUntilIdle = TRUE;
+            sIdle = 0;
+            sHoldBudget = 0;
+            return 0;
+        }
         if (c == 'P')
         {
             sDumpNext = TRUE;
@@ -185,11 +207,25 @@ static void GiveParty(const char *spec)
     s32 slot = 0;
     while (spec && *spec && slot < PARTY_SIZE)
     {
-        u16 sp = (u16)strtol(spec, (char **)&spec, 10);
+        bool8 egg = (*spec == 'e');
+        u16 sp;
         u8 lv = 5;
+        if (egg)
+            spec++;
+        sp = (u16)strtol(spec, (char **)&spec, 10);
         if (*spec == ':')
             lv = (u8)strtol(spec + 1, (char **)&spec, 10);
-        CreateMon(&gPlayerParty[slot], sp, lv, 32, FALSE, 0, OT_ID_PLAYER_ID, 0);
+        if (egg)
+        {
+            // "e<species>:lv[:moves]": an egg about to hatch (0 egg cycles, the step counter one step short of
+            // TryProduceOrHatchEgg's 255, src/daycare.c:898)
+            u8 zero = 0;
+            CreateEgg(&gPlayerParty[slot], sp, FALSE);
+            SetMonData(&gPlayerParty[slot], MON_DATA_FRIENDSHIP, &zero);
+            gSaveBlock1Ptr->daycare.stepCounter = 254;
+        }
+        else
+            CreateMon(&gPlayerParty[slot], sp, lv, 32, FALSE, 0, OT_ID_PLAYER_ID, 0);
         if (*spec == ':')
         {
             s32 m = 0;
@@ -217,6 +253,12 @@ static void CB2_OwTestStart(void)
     s32 group = 0, num = 0, x = -1, y = -1;
     sscanf(getenv("PKBN_OWTEST"), "%d:%d:%d:%d", &group, &num, &x, &y);
     NewGameInitData();
+    {
+        // a player name ("ASH" in the game charset: A=0xBB, S=0xCD, H=0xC2, EOS=0xFF) so "<player> booted up the PC"
+        // and other name texts print
+        static const u8 sName[] = { 0xBB, 0xCD, 0xC2, 0xFF };
+        memcpy(gSaveBlock2Ptr->playerName, sName, sizeof(sName));
+    }
     FlagSet(FLAG_SYS_POKEMON_GET);
     FlagSet(FLAG_SYS_POKEDEX_GET);
     FlagSet(FLAG_SYS_B_DASH);
@@ -229,6 +271,21 @@ static void CB2_OwTestStart(void)
         }
     ZeroPlayerPartyMons();
     GiveParty(getenv("PKBN_OWTEST_PARTY"));
+    if ((t = getenv("PKBN_OWTEST_BOX")) != NULL)
+    {
+        // PKBN_OWTEST_BOX="sp:lv,sp:lv": Pokémon in box 1 from slot 0 (release tests)
+        s32 pos = 0;
+        while (*t && pos < IN_BOX_COUNT)
+        {
+            struct Pokemon mon;
+            u16 sp = (u16)strtol(t, (char **)&t, 10);
+            u8 lv = (*t == ':') ? (u8)strtol(t + 1, (char **)&t, 10) : 5;
+            CreateMon(&mon, sp, lv, 32, FALSE, 0, OT_ID_PLAYER_ID, 0);
+            SetBoxMonAt(0, pos++, &mon.box);
+            while (*t == ',')
+                t++;
+        }
+    }
     if ((t = getenv("PKBN_OWTEST_ITEMS")) != NULL)
         while (*t)
         {
diff --git a/src/pkbn/selftest.c b/src/pkbn/selftest.c
