From 438ef9c981c7e6b47b730b6dfa1dfa9328459893 Mon Sep 17 00:00:00 2001
From: Khaled <khaledchoucri@gmail.com>
Date: Mon, 5 Oct 2026 21:39:49 +0300
Subject: [PATCH 23/24] POC-12a: Struggle chip when the folder is used up;
 tests for release candy, egg moves, milestones, shiny

Gen 3 Struggle (battle_util.c:99-105) as an unlimited * chip when the draw pile is
empty and nothing in hand works. Owtests: player name, box Pokemon, eggs that hatch
next step, Y (wait for text). Selftests: PKBN_TEST_SHINY, PKBN_TEST_DEX_CAUGHT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FbWSqvcg6G5Gpw6ynvR5tJ
---
 include/pkbn/folder.h        |  5 ++-
 include/pkbn/grid_internal.h |  1 +
 src/pkbn/folder.c            |  4 +++
 src/pkbn/grid_battle.c       | 25 ++++++++++++++
 src/pkbn/grid_draw.c         |  2 ++
 src/pkbn/owtest.c            | 65 +++++++++++++++++++++++++++++++++---
 src/pkbn/selftest.c          | 30 +++++++++++++++++
 7 files changed, 127 insertions(+), 5 deletions(-)

diff --git a/include/pkbn/folder.h b/include/pkbn/folder.h
index 98737ba..33442da 100644
--- a/include/pkbn/folder.h
+++ b/include/pkbn/folder.h
@@ -27,6 +27,9 @@
 #define HAND_MAX 8    // with Custom programs (BN6 caps the Custom level at 8)
 #define PKBN_PARTY_MAX 6
 #define LETTER_WILD 26
+// POC-12: when the folder is used up and nothing in the hand works, the hand gets Struggle - Gen 3's move for a
+// Pokémon with no PP left (battle_util.c:99-105, noValidMoves -> MOVE_STRUGGLE). It sits outside the folder count.
+#define FOLDER_STRUGGLE FOLDER_MAX
 
 struct FolderChip
 {
@@ -38,7 +41,7 @@ struct FolderChip
 
 struct Folder
 {
-    struct FolderChip chips[FOLDER_MAX];
+    struct FolderChip chips[FOLDER_MAX + 1];   // + FOLDER_STRUGGLE
     u8 count;
     u8 pile[FOLDER_MAX];
     u8 pileCount;
diff --git a/include/pkbn/grid_internal.h b/include/pkbn/grid_internal.h
index 380cd7d..42975a0 100644
--- a/include/pkbn/grid_internal.h
+++ b/include/pkbn/grid_internal.h
@@ -192,6 +192,7 @@ struct GridBattle
     u8 partyCount;
     u8 active;
     bool8 folderEmptyLogged;
+    bool8 struggleLogged;
     struct PkbnBustStats bust;
     u32 counterReady;           // next frame a counter hit can count  // Busting Level / Capture Grade counters (POC-10b)
     struct Folder folder;
diff --git a/src/pkbn/folder.c b/src/pkbn/folder.c
index 4839132..a36dbc8 100644
--- a/src/pkbn/folder.c
+++ b/src/pkbn/folder.c
@@ -60,6 +60,8 @@ bool8 Chip_CanUse(const struct BattlePokemon *bm, u16 move)
     s32 i;
     if (bm->species == SPECIES_NONE)
         return FALSE;
+    if (move == MOVE_STRUGGLE)
+        return TRUE;   // any Pokémon can Struggle
     for (i = 0; i < MAX_MON_MOVES; i++)
         if (bm->moves[i] == move)
             return TRUE;
@@ -340,6 +342,8 @@ void PkbnFolder_OrderPile(struct Folder *folder)
 
 void PkbnFolder_Discard(struct Folder *folder, u8 idx)
 {
+    if (idx == FOLDER_STRUGGLE)
+        return;   // never runs out (Gen 3 Struggle spends no PP: HITMARKER_NO_PPDEDUCT)
     if (folder->discardCount < FOLDER_MAX)
         folder->discard[folder->discardCount++] = idx;
 }
diff --git a/src/pkbn/grid_battle.c b/src/pkbn/grid_battle.c
index 7e0c066..39a963b 100644
--- a/src/pkbn/grid_battle.c
+++ b/src/pkbn/grid_battle.c
@@ -508,6 +508,31 @@ static void RefillHand(void)
         }
         sB.hand[sB.handCount++] = idx;
     }
+    // POC-12: the folder is used up and nothing left in the hand works for whoever is in -> Struggle.
+    if (sB.folder.pileCount == 0 && !(sB.folder.discardCount && sB.folder.count < FOLDER_RESHUFFLE_BELOW)
+     && sB.handCount < HAND_MAX)
+    {
+        bool8 usable = FALSE;
+        SyncActiveToParty();
+        for (i = 0; i < sB.handCount; i++)
+        {
+            const struct FolderChip *c = &sB.folder.chips[sB.hand[i]];
+            if (c->owner != CHIP_SHARED ? PartyAlive(c->owner) : Chip_CanUse(&sB.f[SIDE_PLAYER].bm, c->move))
+                usable = TRUE;
+        }
+        if (!usable)
+        {
+            struct FolderChip *st = &sB.folder.chips[FOLDER_STRUGGLE];
+            st->move = MOVE_STRUGGLE;
+            st->letter = LETTER_WILD;
+            st->owner = CHIP_SHARED;
+            st->slot = 0;
+            sB.hand[sB.handCount++] = FOLDER_STRUGGLE;
+            if (!sB.struggleLogged)
+                PKBN_LOG("folder used up: STRUGGLE chip");
+            sB.struggleLogged = TRUE;
+        }
+    }
     for (i = 0; i < HAND_MAX; i++)
         sB.picked[i] = FALSE;
     sB.wildPicked = FALSE;
diff --git a/src/pkbn/grid_draw.c b/src/pkbn/grid_draw.c
index 122c0bf..cf5b4e7 100644
--- a/src/pkbn/grid_draw.c
+++ b/src/pkbn/grid_draw.c
@@ -932,6 +932,8 @@ static void DrawChipInfo(u16 *fb)
         }
         if (ch->owner != CHIP_SHARED)
             snprintf(line, sizeof(line), "PARTNER V%u", ch->slot);
+        else if (sB.hand[cur] == FOLDER_STRUGGLE)
+            snprintf(line, sizeof(line), "FOLDER USED UP - NO LIMIT");
         else
             snprintf(line, sizeof(line), "%s  x%u LEFT", gPkbnKindNames[gPkbnMoveInfo[ch->move].kind], CopiesLeft(ch->move));
         Text(fb, ART_X, y + 13, line, RGB(22, 26, 31));
diff --git a/src/pkbn/owtest.c b/src/pkbn/owtest.c
index d4b41ae..5d463fa 100644
--- a/src/pkbn/owtest.c
+++ b/src/pkbn/owtest.c
@@ -3,13 +3,16 @@
 // grass, story flags) without a save file or a person at the keyboard.
 //
 //   PKBN_OWTEST="group:num:x:y"        map (MAP_GROUP/MAP_NUM from include/constants/map_groups.h) and position
-//   PKBN_OWTEST_PARTY="sp:lv[:m/m/m/m]|..."   numeric species / moves (tools: /tmp/ids.py style)
+//   PKBN_OWTEST_PARTY="sp:lv[:m/m/m/m]|..."   numeric species / moves (tools: /tmp/ids.py style); "e283:1:..." = an
