+    bool8 darkUsed;            // POC-20c: a Dark Chip was used - no Full Synchro, Cross or Unison for the rest of it
     bool8 crossOpen;           // POC-19i: the Cross window is open on the Custom screen
     bool8 crossUsed;           // POC-19i: once per battle
