     for (p = 0; p < folder->count; p++)
         folder->pile[p] = p;
     folder->pileCount = folder->count;
@@ -547,8 +562,8 @@ bool8 PkbnFolder_CanAppend(const struct Folder *folder, const u8 *queue, u8 queu
         // POC-10: the Pokémon in battle must be able to use it (shared chips don't switch anyone in)
         if (c->owner != CHIP_SHARED)
             return alive[c->owner];
-        if (c->slot & LEADER_CHIP)
-            return alive[active];   // a Leader chip calls its own Pokémon: anyone can use it
+        if (c->slot & (LEADER_CHIP | DARK_CHIP))
+            return alive[active];   // a Leader chip calls its own Pokémon, a Dark Chip works for anyone
         return alive[active] && Chip_CanUse(&party[active], c->move);
     }
 }
