diff --git a/src/pkbn/dark.c b/src/pkbn/dark.c
new file mode 100644
index 0000000..298e45c
--- /dev/null
+++ b/src/pkbn/dark.c
@@ -0,0 +1,45 @@
+// POC-20c: Dark Chips (Khaled's pick). include/pkbn/dark.h.
+// Each fires like a Program Advance (Moves_UsePA, index PA_DARK0 + giver). Power: about 2.5x the strongest move of its
+// type, every one a full-field or full-row attack (Khaled's pick; TUNE). Names and shapes are ours.
+#include "global.h"
+#include "constants/moves.h"
+#include "constants/opponents.h"
+#include "constants/battle.h"
+#include "pkbn/move_table.h"
+#include "pkbn/dark.h"
+
+#ifdef PORTABLE
+
+const struct PkbnDarkChip gPkbnDarkChips[DARK_GIVERS] = {
+    { "TABITHA", MOVE_FLAMETHROWER, { "DARK BLAZE",    {0}, GK_FIELD,     TYPE_FIRE,   300, 1, 1, PAF_NOFAINT, 0, 0 } },
+    { "MATT",    MOVE_SURF,         { "DARK TIDE",     {0}, GK_WAVE,      TYPE_WATER,  300, 3, 1, 0,           0, 0 } },
+    { "SHELLY",  MOVE_ICE_BEAM,     { "DARK FREEZE",   {0}, GK_WAVE,      TYPE_ICE,    300, 3, 1, 0,           0, 0 } },
+    { "MAXIE",   MOVE_EARTHQUAKE,   { "PRIMAL QUAKE",  {0}, GK_SHOCKWAVE, TYPE_GROUND, 375, 3, 1, 0,           0, 0 } },   // Groudon's power
+    { "ARCHIE",  MOVE_HYDRO_PUMP,   { "PRIMAL SURGE",  {0}, GK_FIELD,     TYPE_WATER,  375, 1, 1, PAF_NOFAINT, 0, 0 } },   // Kyogre's power
+};
+
+const struct PkbnProgramAdvance *Pkbn_DarkPA(u8 i)
+{
+    return &gPkbnDarkChips[i < DARK_GIVERS ? i : 0].pa;
+}
+
+// Every battle with that admin or leader counts; the offer comes after the first win (pkbn.sav darkOffered).
+s8 PkbnDark_GiverOf(u16 trainerId)
+{
+    switch (trainerId)
+    {
+    case TRAINER_TABITHA_MT_CHIMNEY: case TRAINER_TABITHA_MAGMA_HIDEOUT: case TRAINER_TABITHA_MOSSDEEP:
+        return 0;
+    case TRAINER_MATT:
+        return 1;
+    case TRAINER_SHELLY_WEATHER_INSTITUTE: case TRAINER_SHELLY_SEAFLOOR_CAVERN:
+        return 2;
+    case TRAINER_MAXIE_MT_CHIMNEY: case TRAINER_MAXIE_MAGMA_HIDEOUT: case TRAINER_MAXIE_MOSSDEEP:
+        return 3;
+    case TRAINER_ARCHIE:
+        return 4;
+    }
+    return -1;
+}
+
+#endif // PORTABLE
