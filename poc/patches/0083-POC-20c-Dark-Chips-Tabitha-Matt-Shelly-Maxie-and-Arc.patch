diff --git a/include/pkbn/dark.h b/include/pkbn/dark.h
new file mode 100644
index 0000000..3ee5f45
--- /dev/null
+++ b/include/pkbn/dark.h
@@ -0,0 +1,27 @@
+#ifndef GUARD_PKBN_DARK_H
+#define GUARD_PKBN_DARK_H
+// POC-20c: Dark Chips (src/pkbn/dark.c). BN6's own text: DarkChips are "against the law", and "You can use only 1 of
+// the same DarkChip" (bn6f data/textscript/compressed/CompText87E9578.s, CompText86CEE84.s). The rest is ours: Team
+// Magma's and Team Aqua's admins and leaders offer one after you beat them; using one costs the Pokémon friendship and
+// Bonds, shuts Full Synchro, Cross and Unison for the battle, and leaves a dark aura while its friendship is low.
+#include "global.h"
+#include "pkbn/move_table.h"
+
+#define DARK_CHIP     0x40          // FolderChip.slot: DARK_CHIP | giver (owner CHIP_SHARED)
+#define DARK_GIVERS   5             // Tabitha, Matt, Shelly, Maxie, Archie (Emerald's admins and leaders)
+#define PA_DARK0      (PA_UNISON + 1)
+#define DARK_FRIENDSHIP_COST 20     // TUNE
+#define DARK_BOND_COST       10     // TUNE
+#define DARK_AURA_BELOW      100    // TUNE: friendship under this shows the aura on a Pokémon that used one
+
+struct PkbnDarkChip
+{
+    const char *giver;              // as the game spells it
+    u16 faceMove;                   // the move whose art the chip shows
+    struct PkbnProgramAdvance pa;   // what it fires (Moves_UsePA)
+};
+extern const struct PkbnDarkChip gPkbnDarkChips[DARK_GIVERS];
+
+s8 PkbnDark_GiverOf(u16 trainerId);                 // -1: not a giver
+
+#endif // GUARD_PKBN_DARK_H
