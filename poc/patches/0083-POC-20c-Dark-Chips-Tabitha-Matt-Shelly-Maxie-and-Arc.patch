+            return TRUE;
+    return FALSE;
+}
+
+void PkbnDark_Mark(u32 pid)
+{
+    s32 i;
+    if (PkbnDark_Marked(pid))
+        return;
+    for (i = 0; i < 16; i++)
+        if (sSave.darkPids[i] == 0)
+            break;
+    if (i == 16)
+    {
+        memmove(sSave.darkPids, sSave.darkPids + 1, sizeof(u32) * 15);   // full: the oldest mark fades
+        i = 15;
+    }
+    sSave.darkPids[i] = pid;
