+// POC-17d (our rules, TUNE): the weather works on the panels at the end of each turn - sun melts ice, rain cools
+// lava, hail now and then freezes a bare panel nobody stands on.
+static void WeatherPanels(void)
+{
+    s32 r, c;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+        {
+            if (((sB.weather & B_WEATHER_SUN) && sB.panel[r][c] == PANEL_ICE)
+             || ((sB.weather & B_WEATHER_RAIN) && sB.panel[r][c] == PANEL_LAVA))
+            {
+                Field_SetPanel(c, r, PANEL_NORMAL);
+                sB.fx[r][c] = 10;
+            }
+        }
+    if ((sB.weather & B_WEATHER_HAIL) && Random() % 2 == 0)
+    {
+        s8 x = Random() % GRID_COLS, y = Random() % GRID_ROWS;
+        if (sB.panel[y][x] == PANEL_NORMAL && !(sB.f[SIDE_PLAYER].x == x && sB.f[SIDE_PLAYER].y == y)
+         && !(sB.f[SIDE_ENEMY].x == x && sB.f[SIDE_ENEMY].y == y))
+        {
+            Field_SetPanel(x, y, PANEL_ICE);
+            sB.fx[y][x] = 10;
+        }
+    }
+}
