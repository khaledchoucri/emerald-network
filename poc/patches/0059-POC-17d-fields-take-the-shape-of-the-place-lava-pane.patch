+// Put `n` terrain panels of `type` on one side, never where the fighters start (no timer: terrain stays).
+static void ScatterSide(u8 side, u8 type, s32 n)
+{
+    s32 tries = 200;
+    while (n > 0 && tries-- > 0)
+    {
+        s8 x = (side == SIDE_PLAYER ? 0 : PLAYER_COLS) + Random() % PLAYER_COLS, y = Random() % GRID_ROWS;
+        if (sB.panel[y][x] != PANEL_NORMAL || (y == 1 && (x == 1 || x == 4)) || (side == SIDE_ENEMY && x == 5))
+            continue;   // not where the fighters start (the pack's back corners included)
+        sB.panel[y][x] = type;
+        n--;
+    }
+}
+
+static void Scatter(u8 type, s32 perSide)
+{
+    ScatterSide(SIDE_PLAYER, type, perSide);
+    ScatterSide(SIDE_ENEMY, type, perSide);
+}
+
+// POC-17d: the field takes the shape of where the battle is (the picks Khaled approved; panel counts are TUNE).
+// Gyms and the Elite Four by map (include/constants/map_groups.h), the rest by Emerald's map section
+// (gMapHeader.regionMapSectionId, include/constants/region_map_sections.h). TRUE if this place has its own field.
+static bool8 PlaceField(void)
+{
+    u16 map = gSaveBlock1Ptr->location.mapNum | (gSaveBlock1Ptr->location.mapGroup << 8);
+    u8 sec = gMapHeader.regionMapSectionId;
+    switch (map)
+    {
+    case MAP_RUSTBORO_CITY_GYM:            Scatter(PANEL_CRACKED, 2); break;                    // Roxanne, Rock
+    case MAP_LAVARIDGE_TOWN_GYM_1F:
+    case MAP_LAVARIDGE_TOWN_GYM_B1F:       Scatter(PANEL_LAVA, 2); break;                       // Flannery, Fire
+    case MAP_FORTREE_CITY_GYM:                                                                  // Winona, Flying: wind
+    case MAP_EVER_GRANDE_CITY_CHAMPIONS_ROOM: Field_ChallengeConditions(CH_WEATHER_NONE, CH_PANELS_CURRENT); break;  // Wallace
+    case MAP_MOSSDEEP_CITY_GYM:            Scatter(PANEL_HOLY, 1); break;                       // Tate & Liza, Psychic
+    case MAP_SOOTOPOLIS_CITY_GYM_1F:
+    case MAP_SOOTOPOLIS_CITY_GYM_B1F:      Scatter(PANEL_ICE, 2); Scatter(PANEL_CRACKED, 1); break;   // Juan: its ice floor
+    case MAP_EVER_GRANDE_CITY_SIDNEYS_ROOM: Scatter(PANEL_POISON, 2); break;                    // Sidney, Dark
+    case MAP_EVER_GRANDE_CITY_PHOEBES_ROOM: Scatter(PANEL_HOLY, 2); break;                      // Phoebe, Ghost
+    case MAP_EVER_GRANDE_CITY_GLACIAS_ROOM: Scatter(PANEL_ICE, 3); break;                       // Glacia, Ice
+    case MAP_EVER_GRANDE_CITY_DRAKES_ROOM:  Scatter(PANEL_CRACKED, 2); break;                   // Drake, Dragon
+    default:
+        switch (sec)
+        {
+        case MAPSEC_PETALBURG_WOODS: case MAPSEC_ROUTE_119: case MAPSEC_ROUTE_120: case MAPSEC_SAFARI_ZONE:
+            Scatter(PANEL_GRASS, 5); break;
+        case MAPSEC_METEOR_FALLS: case MAPSEC_METEOR_FALLS2: case MAPSEC_JAGGED_PASS: case MAPSEC_JAGGED_PASS2:
+        case MAPSEC_GRANITE_CAVE: case MAPSEC_DESERT_RUINS: case MAPSEC_SEAFLOOR_CAVERN:
+            Scatter(PANEL_CRACKED, 2); break;
+        case MAPSEC_SHOAL_CAVE:
+            Scatter(PANEL_ICE, 3); break;
+        case MAPSEC_MT_PYRE:
+            Scatter(PANEL_HOLY, 2); break;
+        case MAPSEC_FIERY_PATH: case MAPSEC_FIERY_PATH2: case MAPSEC_MT_CHIMNEY: case MAPSEC_MAGMA_HIDEOUT:
+        case MAPSEC_LAVARIDGE_TOWN:
+            Scatter(PANEL_LAVA, 2); break;
+        default:
+            return FALSE;
+        }
+    }
+    PKBN_LOG("place field: map %04x, section %u", map, sec);
+    return TRUE;
+}
