+// POC-17d (our rules, TUNE): a Fire attack burns away grass and melts ice; a Water attack cools lava.
+static void PanelsReact(const struct Attack *a, const u8 cells[GRID_ROWS][GRID_COLS])
+{
+    s32 r, c;
+    u8 type = a->typeOverride ? a->typeOverride - 1 : gBattleMoves[a->move].type;
+    if (type != TYPE_FIRE && type != TYPE_WATER)
+        return;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+        {
+            u8 p = sB.panel[r][c];
+            if (!cells[r][c])
+                continue;
+            if ((type == TYPE_FIRE && (p == PANEL_GRASS || p == PANEL_ICE)) || (type == TYPE_WATER && p == PANEL_LAVA))
+            {
+                Field_SetPanel(c, r, PANEL_NORMAL);
+                FlashPanel(c, r, 12);
+                PKBN_LOG("panel react: type %u turns panel %u at (%d,%d) normal", type, p, (int)c, (int)r);
+            }
+        }
+}
