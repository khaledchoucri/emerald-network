+// POC-15e: Emerald's status and general animations' sounds (status inflicted and its turn damage, weather going on,
+// Leech Seed, Ingrain, Leftovers, Wish...) and the stat change sound. These don't replace a move's sounds; ones posted
+// together play one after another, as Emerald plays its end-of-turn animations in turn.
+
+// Emerald plays these after the move's animation: start them once the sounds already queued (within SOUND_SPAN) are out
+static u32 AfterQueuedSounds(void)
+{
+    s32 k;
+    u32 due = sTick > sAnimSoundFree ? sTick : sAnimSoundFree;
+    for (k = 0; k < MAX_PENDING_SOUNDS; k++)
+        if (sPendingSound[k].se && sPendingSound[k].due + 6 > due && sPendingSound[k].due <= sTick + SOUND_SPAN)
+            due = sPendingSound[k].due + 6;
+    return due;
+}
+
+static void ScheduleTableSounds(const struct PkbnMoveSound *list, u8 side, bool8 self)
+{
+    s32 i, k, last = 0;
+    u32 base = AfterQueuedSounds();
+    s8 sidePan = side == SIDE_PLAYER ? SOUND_PAN_ATTACKER * 3 / 4 : SOUND_PAN_TARGET * 3 / 4;   // TUNE
+    for (i = 0; i < PKBN_MOVE_SOUNDS && list[i].se; i++)
+        if (list[i].frame > last)
+            last = list[i].frame;
+    for (i = 0; i < PKBN_MOVE_SOUNDS && list[i].se; i++)
+        for (k = 0; k < MAX_PENDING_SOUNDS; k++)
+            if (sPendingSound[k].se == 0)
+            {
+                sPendingSound[k].due = base + (last > SOUND_SPAN ? list[i].frame * SOUND_SPAN / last : list[i].frame);
+                sPendingSound[k].se = list[i].se;
+                sPendingSound[k].pan = self ? (list[i].pan ? sidePan : 0)
+                                     : side == SIDE_PLAYER ? list[i].pan : (s8)-list[i].pan;
+                sPendingSound[k].species = sB.f[side].bm.species;
+                sPendingSound[k].side = ANIM_SOUND_SIDE;
+                break;
+            }
+    sAnimSoundFree = base + (last > SOUND_SPAN ? SOUND_SPAN : last) + 8;   // TUNE: a short gap between them
+}
+
+static void OnAnimEvent(const struct VisEvent *e)
+{
+    u8 table = e->kind ? 1 : 0, anim = (u8)e->arg;
+    if (getenv("PKBN_NO_MOVE_SOUNDS") != NULL)
+        return;
+    if (anim >= (table ? PKBN_GENERAL_ANIMS : PKBN_STATUS_ANIMS))
+        return;
+    // pressing A while asleep or frozen asks every time: one animation per 40 frames (TUNE)
+    if (sAnimSoundLast[e->side][table][anim] && sTick - sAnimSoundLast[e->side][table][anim] < 40)
+        return;
+    sAnimSoundLast[e->side][table][anim] = sTick;
+    ScheduleTableSounds(table ? gPkbnGeneralSounds[anim] : gPkbnStatusSounds[anim], e->side, e->x != 0);
+}
+
+// Emerald's stat change animation plays SE_M_STAT_INCREASE / SE_M_STAT_DECREASE panned to the Pokemon
+// (AnimTask_StatsChange, src/battle_anim_utility_funcs.c:562-564). It plays after the move's animation there, so here
+// after the sounds already queued.
+static void OnStatSound(const struct VisEvent *e)
+{
+    s32 k;
+    u32 due;
+    if (getenv("PKBN_NO_MOVE_SOUNDS") != NULL)
+        return;
+    due = AfterQueuedSounds();
+    for (k = 0; k < MAX_PENDING_SOUNDS; k++)
+        if (sPendingSound[k].se == 0)
+        {
+            sPendingSound[k].due = due;
+            sPendingSound[k].se = e->arg > 0 ? SE_M_STAT_INCREASE : SE_M_STAT_DECREASE;
+            sPendingSound[k].pan = e->side == SIDE_PLAYER ? SOUND_PAN_ATTACKER * 3 / 4 : SOUND_PAN_TARGET * 3 / 4;
+            sPendingSound[k].side = ANIM_SOUND_SIDE;
+            break;
+        }
+}
+
 static void PlayDueSounds(void)
 {
     s32 k;
@@ -1553,6 +1633,10 @@ void Draw_Overlay(u16 *fb)
                 break;
             case VEV_STAT:
                 Vfx_OnStat(e);
+                OnStatSound(e);
+                break;
+            case VEV_ANIM:
+                OnAnimEvent(e);
                 break;
             }
         }
