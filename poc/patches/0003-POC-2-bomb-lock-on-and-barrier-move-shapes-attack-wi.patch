+static void BlastCells(s8 cx, s8 cy, u8 cells[GRID_ROWS][GRID_COLS])
+{
+    s8 dx, dy;
+    for (dy = -1; dy <= 1; dy++)
+        for (dx = -1; dx <= 1; dx++)
+            if (InGrid(cx + dx, cy + dy))
+                cells[cy + dy][cx + dx] = 1;
+}
