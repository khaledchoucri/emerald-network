diff --git a/src/pkbn/move_shapes.c b/src/pkbn/move_shapes.c
new file mode 100644
index 0000000..3695ccf
--- /dev/null
+++ b/src/pkbn/move_shapes.c
@@ -0,0 +1,63 @@
+// Emerald move -> grid shape rules. Every rule reads a field of gBattleMoves
+// (src/data/battle_moves.h) except the curated "thrown" list, which is our design choice.
+#include "global.h"
+#include "battle.h"
+#include "pokemon.h"
+#include "constants/battle_move_effects.h"
+#include "constants/moves.h"
+#include "pkbn/move_shapes.h"
+
+// Moves that read as something thrown/lobbed -> Grenade. Curated by us (Gen 3 has no
+// "ball/bomb" flag); extend freely.
+static const u16 sThrownMoves[] =
+{
+    MOVE_ROCK_THROW, MOVE_EGG_BOMB, MOVE_BARRAGE, MOVE_SLUDGE_BOMB, MOVE_OCTAZOOKA,
+    MOVE_SHADOW_BALL, MOVE_WEATHER_BALL, MOVE_ROCK_TOMB,
+};
+
+static bool8 IsThrown(u16 move)
+{
+    u32 i;
+    for (i = 0; i < ARRAY_COUNT(sThrownMoves); i++)
+        if (sThrownMoves[i] == move)
+            return TRUE;
+    return FALSE;
+}
+
+u8 Pkbn_ShapeForMove(u16 move)
+{
+    const struct BattleMove *m = &gBattleMoves[move];
+
+    if (move == MOVE_NONE)
+        return SHAPE_NONE;
+    // Protect / Detect (EFFECT_PROTECT) -> Barrier
+    if (m->effect == EFFECT_PROTECT)
+        return SHAPE_BARRIER;
+    if (m->power == 0)
+        return SHAPE_NONE;
+    // "Never misses" moves (EFFECT_ALWAYS_HIT: Swift, Faint Attack, Shadow Punch, Aerial Ace,
+    // Magical Leaf, Shock Wave) -> Lock-on. Takes priority over contact.
+    if (m->effect == EFFECT_ALWAYS_HIT)
+        return SHAPE_LOCKON;
+    if (IsThrown(move))
+        return SHAPE_GRENADE;
+    if (m->flags & FLAG_MAKES_CONTACT)
+        return SHAPE_LONGSWORD;
+    if (m->target & (MOVE_TARGET_BOTH | MOVE_TARGET_FOES_AND_ALLY))
+        return SHAPE_SPREADER;
+    return SHAPE_CANNON;
+}
+
+const char *Pkbn_ShapeLabel(u8 shape)
+{
+    switch (shape)
+    {
+    case SHAPE_CANNON:    return "CANNON";
+    case SHAPE_LONGSWORD: return "SWORD";
+    case SHAPE_SPREADER:  return "SPREAD";
+    case SHAPE_GRENADE:   return "BOMB";
+    case SHAPE_LOCKON:    return "LOCK-ON";
+    case SHAPE_BARRIER:   return "BARRIER";
+    }
+    return "";
+}
