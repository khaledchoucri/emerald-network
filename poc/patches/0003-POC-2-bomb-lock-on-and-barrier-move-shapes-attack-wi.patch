+#ifndef GUARD_PKBN_MOVE_SHAPES_H
+#define GUARD_PKBN_MOVE_SHAPES_H
+
+// How an Emerald move behaves on the grid. Modelled on BN6 chip families (research/03).
+enum
+{
+    SHAPE_NONE,      // not usable on the grid yet (most status moves)
+    SHAPE_CANNON,    // BN6 family 0x14: hits the first target down the row
+    SHAPE_LONGSWORD, // BN6 family 0x13 sub 2: hits up to 2 panels ahead
+    SHAPE_SPREADER,  // BN6 family 0x25: Cannon + 3x3 splash around the target
+    SHAPE_GRENADE,   // BN6 family 0x12 (MiniBomb): thrown 3 panels ahead, 3x3 blast on landing
+    SHAPE_LOCKON,    // BN6 MachGun family 0x29 idea: lock onto the target, then a hit it can't dodge
+    SHAPE_BARRIER,   // BN6 Barrier (family 0x15 sub 4, param 1): absorbs the next hit
+    SHAPE_COUNT
+};
+
+u8 Pkbn_ShapeForMove(u16 move);
+const char *Pkbn_ShapeLabel(u8 shape);
+
+#endif // GUARD_PKBN_MOVE_SHAPES_H
