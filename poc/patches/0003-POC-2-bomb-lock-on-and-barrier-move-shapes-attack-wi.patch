+// ---- Attack pipeline ------------------------------------------------------------------
+
+static struct Attack *NewAttack(void)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+        if (!sB.attacks[i].active)
+        {
+            memset(&sB.attacks[i], 0, sizeof(sB.attacks[i]));
+            sB.attacks[i].active = TRUE;
+            return &sB.attacks[i];
+        }
+    return NULL;
+}
+
+static bool8 SideHasPendingAttack(u8 side)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+        if (sB.attacks[i].active && sB.attacks[i].side == side)
+            return TRUE;
+    return FALSE;
+}
+
+static void ImpactAttack(struct Attack *a)
+{
+    struct Fighter *opp = &sB.f[a->side ^ 1];
+    struct Fighter *me = &sB.f[a->side];
+
+    switch (a->chip.shape)
+    {
+    case SHAPE_CANNON:
+    case SHAPE_LONGSWORD:
+    case SHAPE_SPREADER:
+        // Telegraphed direct shapes strike the panels shown in the telegraph.
+        memset(a->cells, 0, sizeof(a->cells));
+        DirectShapeCells(a->side, a->chip.shape, me->x, me->y, a->cells);
+        if (a->cells[opp->y][opp->x])
+            ApplyHit(a->side, a->chip.move, 0);
+        FlashCells(a->cells, 10);
+        break;
+    case SHAPE_GRENADE:
+        if (a->cells[opp->y][opp->x])
+            ApplyHit(a->side, a->chip.move, 0);
+        FlashCells(a->cells, 12);
+        PKBN_LOG("%s's bomb landed on (%d,%d)", me->name, a->tx, a->ty);
+        break;
+    case SHAPE_LOCKON:
+        // Can't be dodged: hits wherever the target is now (barrier / i-frames still apply).
+        memset(a->cells, 0, sizeof(a->cells));
+        a->cells[opp->y][opp->x] = 1;
+        ApplyHit(a->side, a->chip.move, 0);
+        FlashCells(a->cells, 10);
+        break;
+    }
+    a->active = FALSE;
+}
+
+static void StartAttack(u8 side, const struct Chip *chip)
+{
+    struct Fighter *me = &sB.f[side];
+    struct Fighter *opp = &sB.f[side ^ 1];
+    struct Attack *a;
 
     if (me->bm.pp[chip->slot] > 0)
         me->bm.pp[chip->slot]--;
+
+    if (chip->shape == SHAPE_BARRIER)
+    {
+        // Gen 3 Protect rule (Cmd_setprotectlike, battle_script_commands.c:6523-6555): the counter
+        // resets unless the previous move was also Protect-like; each consecutive use halves the
+        // success chance (sProtectSuccessRates, :719). Clamped to the table size.
+        static const u16 sSuccess[] = { USHRT_MAX, USHRT_MAX / 2, USHRT_MAX / 4, USHRT_MAX / 8 };
+        if (me->lastShape != SHAPE_BARRIER)
+            me->protectUses = 0;
+        me->lastShape = SHAPE_BARRIER;
+        me->lockout = CHIP_LOCKOUT;
+        if (sSuccess[min(me->protectUses, 3)] >= Random())
+        {
+            me->barrier = TRUE;
+            me->protectUses++;
+            PlaySE(SE_SELECT);
+            PKBN_LOG("%s raised a barrier (consecutive %u)", me->name, me->protectUses);
+        }
+        else
+        {
+            me->protectUses = 0;
+            SetMsg("BARRIER FAILED!", 50);
+            PlaySE(SE_FAILURE);
+            PKBN_LOG("%s's barrier failed", me->name);
+        }
+        return;
+    }
+    me->lastShape = chip->shape;
+
+    a = NewAttack();
+    if (a == NULL)
+        return;
+    a->side = side;
+    a->chip = *chip;
+    a->ox = me->x;
+    a->oy = me->y;
     me->lockout = CHIP_LOCKOUT;
+
+    switch (chip->shape)
+    {
+    case SHAPE_CANNON:
+    case SHAPE_LONGSWORD:
+    case SHAPE_SPREADER:
+        DirectShapeCells(side, chip->shape, me->x, me->y, a->cells);
+        a->timer = (side == SIDE_ENEMY) ? ENEMY_TELEGRAPH : 0;
+        break;
+    case SHAPE_GRENADE:
+        a->tx = me->x + Facing(side) * GRENADE_RANGE;
+        a->ty = me->y;
+        BlastCells(a->tx, a->ty, a->cells);
+        a->timer = GRENADE_FLIGHT;
+        me->lockout = THROW_LOCKOUT;
+        break;
+    case SHAPE_LOCKON:
+        a->tx = opp->x;
+        a->ty = opp->y;
+        a->timer = LOCKON_FRAMES;
+        break;
+    }
+    a->duration = a->timer;
+    if (a->timer == 0)
+        ImpactAttack(a);
+}
+
+static void UpdateAttacks(void)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+    {
+        struct Attack *a = &sB.attacks[i];
+        if (!a->active)
+            continue;
+        if (a->chip.shape == SHAPE_LOCKON)
+        {
+            // crosshair tracks the target until it fires
+            a->tx = sB.f[a->side ^ 1].x;
+            a->ty = sB.f[a->side ^ 1].y;
+        }
+        if (a->timer > 0 && --a->timer == 0)
+            ImpactAttack(a);
+    }
 }
 
