+        def->hurtFlash = 6;
+        SetMsg("BARRIER BLOCKED IT!", 50);
+        PlaySE(SE_BOO);
+        PKBN_LOG("%s's barrier absorbed %s", def->name, move ? "a move" : "a buster shot");
+        return;
+    }
+
