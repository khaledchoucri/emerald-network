+#define PKBN_SAVE_VERSION 4   // v2 (POC-10): chip pack, grants, candy, folder; v3 (POC-11): partner chips;
+                              // v4 (POC-13): folders 2 and 3 and which one is equipped. Append-only.
 
 struct PkbnSaveFile
 {
@@ -40,14 +41,24 @@ struct PkbnSaveFile
     u8 pad2[3];
     // ---- v3 (POC-11): partner chips ----
     struct PkbnPartnerSlot partners[PKBN_PARTNER_SLOTS];
+    // ---- v4 (POC-13): BN6 has Folder 1, Folder 2 and an extra folder; folder 1 is the v2 folder above ----
+    u16 extraMove[PKBN_FOLDERS - 1][PKBN_FOLDER_SLOTS];
+    u8 extraLetter[PKBN_FOLDERS - 1][PKBN_FOLDER_SLOTS];
+    u8 extraCount[PKBN_FOLDERS - 1];
+    u8 activeFolder;          // 0 = folder 1
 };
 
+#define V3_SIZE offsetof(struct PkbnSaveFile, extraMove)
 #define V2_SIZE offsetof(struct PkbnSaveFile, partners)
 
 #define V1_SIZE offsetof(struct PkbnSaveFile, pack)
 
 static struct PkbnSaveFile sSave;
 
+// Self-tests of the v3 -> v4 migration: where v3 files end, and how long a v4 file is.
+u32 PkbnSave_V3Size(void) { return V3_SIZE; }
+u32 PkbnSave_Size(void) { return sizeof(struct PkbnSaveFile); }
+
 void PkbnSave_Reset(void)
 {
     s32 i;
@@ -79,7 +90,9 @@ void PkbnSave_Read(void)
     if (tmp.version == 1)
         memset((u8 *)&tmp + V1_SIZE, 0, sizeof(tmp) - V1_SIZE); // v1 -> v3: an empty pack (filled by SyncLearned)
     else if (tmp.version == 2)
-        memset((u8 *)&tmp + V2_SIZE, 0, sizeof(tmp) - V2_SIZE); // v2 -> v3: no partner chips yet
+        memset((u8 *)&tmp + V2_SIZE, 0, sizeof(tmp) - V2_SIZE); // v2 -> v4: no partner chips yet
+    else if (tmp.version == 3)
+        memset((u8 *)&tmp + V3_SIZE, 0, sizeof(tmp) - V3_SIZE); // v3 -> v4: folders 2 and 3 empty, folder 1 equipped
     tmp.version = PKBN_SAVE_VERSION;
     sSave = tmp;
     for (i = sSave.ncpCount; i < NCP_COUNT; i++) // programs added since this file was written
@@ -231,23 +244,53 @@ void PkbnPack_SyncLearned(void)
 }
 
 // The FOLDER screen's folder (0 chips = auto-build)
+// The equipped folder's storage (POC-13: folder 1 = the v2 fields, folders 2-3 = v4).
+static void FolderStore(u8 n, u16 **moves, u8 **letters, u8 **count)
+{
+    if (n == 0 || n >= PKBN_FOLDERS)
+    {
+        *moves = sSave.folderMove, *letters = sSave.folderLetter, *count = &sSave.folderCount;
+        return;
+    }
+    *moves = sSave.extraMove[n - 1], *letters = sSave.extraLetter[n - 1], *count = &sSave.extraCount[n - 1];
+}
+
+u8 PkbnFolder_Equipped(void)
+{
+    return sSave.activeFolder < PKBN_FOLDERS ? sSave.activeFolder : 0;
+}
+
+void PkbnFolder_Equip(u8 n)
+{
+    sSave.activeFolder = n < PKBN_FOLDERS ? n : 0;
+}
+
 u8 PkbnFolderEdit_Get(u16 *moves, u8 *letters)
 {
-    u8 n = sSave.folderCount > PKBN_FOLDER_SLOTS ? PKBN_FOLDER_SLOTS : sSave.folderCount;
-    memcpy(moves, sSave.folderMove, n * sizeof(u16));
-    memcpy(letters, sSave.folderLetter, n);
+    u16 *m;
+    u8 *l, *c, n;
+    FolderStore(PkbnFolder_Equipped(), &m, &l, &c);
+    n = *c > PKBN_FOLDER_SLOTS ? PKBN_FOLDER_SLOTS : *c;
+    memcpy(moves, m, n * sizeof(u16));
+    memcpy(letters, l, n);
     return n;
 }
 
 void PkbnFolderEdit_Set(const u16 *moves, const u8 *letters, u8 count)
 {
+    u16 *m;
+    u8 *l, *c;
+    FolderStore(PkbnFolder_Equipped(), &m, &l, &c);
     if (count > PKBN_FOLDER_SLOTS)
         count = PKBN_FOLDER_SLOTS;
-    memset(sSave.folderMove, 0, sizeof(sSave.folderMove));
-    memset(sSave.folderLetter, 0, sizeof(sSave.folderLetter));
-    memcpy(sSave.folderMove, moves, count * sizeof(u16));
-    memcpy(sSave.folderLetter, letters, count);
-    sSave.folderCount = count;
+    memset(m, 0, PKBN_FOLDER_SLOTS * sizeof(u16));
+    memset(l, 0, PKBN_FOLDER_SLOTS);
+    if (count)
+    {
+        memcpy(m, moves, count * sizeof(u16));
+        memcpy(l, letters, count);
+    }
+    *c = count;
 }
 
