+            PKBN_LOG("pa dex milestone %u: * %s chip", done, mvName);
+            PaDexNote("%s PROGRAM ADVANCES FOUND! GOT 1 %s * CHIP.", count, mvName);
+            break;
+        }
+    }
+    PkbnPaDex_SetMilestones(done);
+}
