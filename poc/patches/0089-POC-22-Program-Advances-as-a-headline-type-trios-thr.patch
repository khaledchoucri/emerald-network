+// ---- POC-22c: the PA Dex page (Khaled's picks) ------------------------------------------------------------------------
+// Found Program Advances show their name and recipe. Unfound ones are silhouettes: the chips of the recipe you own show,
+// and owning two of the three reveals the third. Type trios show their type: any three chips of it, in rising power.
+static void BuildPaDex(void)
+{
+    s32 e;
+    sF.dexCount = 0;
+    for (e = 0; e < PKBN_PADEX_ENTRIES; e++)
+        if (e != PKBN_PA_COUNT + TYPE_MYSTERY)
+            sF.dex[sF.dexCount++] = (u8)e;
+}
+
+static bool8 PaDexIsTrio(u8 e) { return e >= PKBN_PA_COUNT; }
+
+static u8 PaDexOwned(u8 e, bool8 *own)
+{
+    s32 k;
+    u8 n = 0;
+    for (k = 0; k < 3; k++)
+    {
+        own[k] = !PaDexIsTrio(e) && PkbnPack_Total(gPkbnProgramAdvances[e].recipe[k]) > 0;
+        n += own[k];
+    }
+    return n;
+}
+
+static void PaDexName(u8 e, char *out, u32 size)
+{
+    static const char *const sTypeWords[NUMBER_OF_MON_TYPES] = {
+        "NORMAL", "FIGHTING", "FLYING", "POISON", "GROUND", "ROCK", "BUG", "GHOST", "STEEL", "???",
+        "FIRE", "WATER", "GRASS", "ELECTRIC", "PSYCHIC", "ICE", "DRAGON", "DARK",
+    };
+    if (PaDexIsTrio(e))
+        snprintf(out, size, "%s TRIO", sTypeWords[e - PKBN_PA_COUNT]);
+    else if (PkbnPaDex_Found(e))
+        snprintf(out, size, "%s", gPkbnProgramAdvances[e].name);
+    else
+        snprintf(out, size, "?????");
+}
+
+static void DrawPaDexList(u16 *fb, u16 cur, u16 top)
+{
+    s32 i;
+    char line[32];
+    snprintf(line, sizeof(line), "FOUND %u/%u", PkbnPaDex_Count(), sF.dexCount);
+    Text(fb, LIST_X + 2, LIST_Y - 14, line, RGB(31, 26, 6));
+    for (i = top; i < sF.dexCount && i < top + LIST_ROWS; i++)
+    {
+        u8 e = sF.dex[i];
+        s32 y = LIST_Y + (i - top) * ROW_H;
+        bool8 found = PkbnPaDex_Found(e), own[3];
+        u8 type = PaDexIsTrio(e) ? e - PKBN_PA_COUNT : gPkbnProgramAdvances[e].type;
+        if (i == cur)
+            Pkbn_FillRect(fb, LIST_X - 1, y - 1, PANEL_X - LIST_X - 4, ROW_H, RGB(8, 14, 28));
+        Pkbn_FillRect(fb, LIST_X, y + 1, 4, ROW_H - 4, found ? Vfx_TypeColor(type) : RGB(6, 7, 10));
+        PaDexName(e, line, sizeof(line));
+        Text(fb, LIST_X + 8, y - 2, line, found ? RGB(31, 31, 31) : PaDexIsTrio(e) || PaDexOwned(e, own) >= 2
+                                                                    ? RGB(16, 18, 24) : RGB(10, 11, 14));
+    }
+    if (top > 0)
+        Text(fb, PANEL_X - 14, LIST_Y - 12, "^", RGB(31, 26, 6));
+    if (top + LIST_ROWS < sF.dexCount)
+        Text(fb, PANEL_X - 14, LIST_Y + LIST_ROWS * ROW_H - 4, "~", RGB(31, 26, 6));
+}
+
+static void DrawPaDexPanel(u16 *fb, u8 e)
+{
+    s32 x = PANEL_X, y = 24, k;
+    bool8 found = PkbnPaDex_Found(e), own[3];
+    u8 owned = PaDexOwned(e, own);
+    char line[40];
+    PaDexName(e, line, sizeof(line));
+    Pkbn_DrawEmText(fb, x + 2, y, line, PKBN_FONT_NORMAL, found ? RGB(31, 26, 6) : RGB(16, 18, 24), RGB(2, 2, 5));
+    if (PaDexIsTrio(e))
+    {
+        // three chips of the type, each at least as strong as the one before
+        struct PkbnImage icon = Gfx_TypeIcon(e - PKBN_PA_COUNT);
+        for (k = 0; k < 3; k++)
+        {
+            Gfx_Draw(fb, &icon, x + 4, y + 20 + k * 16, 0, 0, 0);
+            Pkbn_FillRect(fb, x + 40, y + 30 + k * 16 - k * 3, 4 + k * 8, 3 + k * 3, RGB(31, 26, 6));
+        }
+        return;
+    }
+    {
+        const struct PkbnProgramAdvance *pa = &gPkbnProgramAdvances[e];
+        for (k = 0; k < 3; k++)
+        {
+            bool8 show = found || own[k] || owned >= 2;
+            s32 ry = y + 18 + k * 18;
+            Pkbn_FillRect(fb, x + 2, ry, 24, 16, RGB(1, 2, 5));
+            if (show)
+            {
+                char nm[MOVE_NAME_LENGTH + 1];
+                PkbnDraw_ChipIcon(fb, x + 3, ry, pa->recipe[k], !own[k]);
+                MoveName(nm, sizeof(nm), pa->recipe[k]);
+                Text(fb, x + 30, ry + 1, nm, own[k] ? RGB(31, 31, 31) : RGB(16, 18, 24));
+            }
+            else
+                Text(fb, x + 30, ry + 1, "???", RGB(10, 11, 14));
+        }
+        if (found)
+        {
+            struct PkbnImage icon = Gfx_TypeIcon(pa->type);
+            Gfx_Draw(fb, &icon, x + 4, y + 76, 0, 0, 0);
+            snprintf(line, sizeof(line), "POW %u%s", pa->power, pa->hits > 1 ? " x" : "");
+            if (pa->hits > 1)
+                snprintf(line + strlen(line), sizeof(line) - strlen(line), "%u", pa->hits);
+            Text(fb, x + 40, y + 74, line, RGB(22, 26, 31));
+        }
+    }
+    {
+        u8 next = (u8)((PkbnPaDex_Count() / 5 + 1) * 5);
+        snprintf(line, sizeof(line), "NEXT REWARD AT %u", next);
+        Text(fb, x + 2, y + 112, line, RGB(12, 14, 20));
+    }
+}
+
