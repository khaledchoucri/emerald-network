+    "NORMAL", "FIGHTING", "FLYING", "POISON", "GROUND", "ROCK", "BUG", "GHOST", "STEEL", "???",
+    "FIRE", "WATER", "GRASS", "ELECTRIC", "PSYCHIC", "ICE", "DRAGON", "DARK",
+};
+
+static bool8 TrioAt(const u8 *q, u8 i, u8 slot)
+{
+    u16 mv[3];
+    u8 type;
+    s32 k, sum = 0;
+    struct PkbnProgramAdvance *t = &gPkbnTrioPA[slot % PA_TRIO_SLOTS];
+    for (k = 0; k < 3; k++)
+    {
+        if (q[i + k] >= QUEUE_PA_BASE || q[i + k] == FOLDER_QUEUE_WILD)
+            return FALSE;
+        mv[k] = sB.folder.chips[q[i + k]].move;
+        if (mv[k] == MOVE_NONE || gBattleMoves[mv[k]].power <= 1)
+            return FALSE;
+    }
+    type = gBattleMoves[mv[0]].type;
+    if (type == TYPE_MYSTERY || mv[0] == mv[1] || mv[1] == mv[2] || mv[0] == mv[2])
+        return FALSE;
+    for (k = 0; k < 3; k++)
+    {
+        if (gBattleMoves[mv[k]].type != type)
+            return FALSE;
+        if (k > 0 && gBattleMoves[mv[k]].power < gBattleMoves[mv[k - 1]].power)
+            return FALSE;
+        sum += gBattleMoves[mv[k]].power;
+    }
+    memset(t, 0, sizeof(*t));
+    snprintf(sTrioName[slot % PA_TRIO_SLOTS], sizeof(sTrioName[0]), "%s TRIO", sTypeWords[type]);
+    t->name = sTrioName[slot % PA_TRIO_SLOTS];
+    t->recipe[0] = mv[0], t->recipe[1] = mv[1], t->recipe[2] = mv[2];
+    t->kind = gPkbnMoveInfo[mv[2]].kind;
+    t->type = type;
+    t->power = sum * TRIO_POWER_PCT / 100;
+    t->rows = gPkbnMoveInfo[mv[2]].rows ? gPkbnMoveInfo[mv[2]].rows : 1;
+    t->hits = 1;
