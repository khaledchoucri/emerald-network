+static void GiveWinRewards(u8 participants)
+{
+    u16 enemySpecies = GetMonData(&gEnemyParty[0], MON_DATA_SPECIES);
+    u8 enemyLevel = GetMonData(&gEnemyParty[0], MON_DATA_LEVEL);
+    u32 gained, share, count = 0;
+    s32 i;
+
+    if (participants == 0)
+    {
+        s32 lead = GetLeadMonIndex();
+        if (lead < 0)
+            return;
+        participants = 1 << lead;
+    }
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (participants & (1 << i))
+            count++;
+    gained = gSpeciesInfo[enemySpecies].expYield * enemyLevel / 7;
+    share = gained / count;
+    if (share == 0)
+        share = 1;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (participants & (1 << i))
+            GiveExpTo(i, share, enemySpecies);
+}
