diff --git a/src/pkbn/folder.c b/src/pkbn/folder.c
new file mode 100644
index 0000000..771ea2c
--- /dev/null
+++ b/src/pkbn/folder.c
@@ -0,0 +1,223 @@
+// Chip folder: build, draw, selection rule. See include/pkbn/folder.h.
+#include "global.h"
+#include "battle.h"
+#include "pokemon.h"
+#include "random.h"
+#include "constants/pokemon.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+#include "pkbn/folder.h"
+
+static u8 CopiesForPP(u8 maxPP)
+{
+    if (maxPP >= 30) return 3; // TUNE (agreed rule)
+    if (maxPP >= 15) return 2;
+    return 1;
+}
+
+static bool8 MoveGoesInFolder(u16 move)
+{
+    u8 shape = Pkbn_ShapeForMove(move);
+    return shape != SHAPE_NONE; // unsupported status moves stay out until they work on the grid
+}
+
+static u32 MoveTypesOf(const struct BattlePokemon *mon)
+{
+    u32 m = 0;
+    s32 i;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        if (mon->moves[i] != MOVE_NONE && MoveGoesInFolder(mon->moves[i]))
+            m |= 1u << gBattleMoves[mon->moves[i]].type;
+    return m;
+}
+
+static u32 CountBits(u32 v)
+{
+    u32 n = 0;
+    while (v) { n += v & 1; v >>= 1; }
+    return n;
+}
+
+static void Shuffle(u8 *arr, u8 n)
+{
+    s32 i;
+    for (i = n - 1; i > 0; i--)
+    {
+        s32 j = Random() % (i + 1);
+        u8 t = arr[i]; arr[i] = arr[j]; arr[j] = t;
+    }
+}
+
+void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party, u8 partyCount)
+{
+    u8 copies[PKBN_PARTY_MAX][MAX_MON_MOVES];
+    u32 typeCount[NUMBER_OF_MON_TYPES];
+    s32 p, m, members = 0, total = 0, utility;
+
+    memset(folder, 0, sizeof(*folder));
+    memset(copies, 0, sizeof(copies));
+    memset(typeCount, 0, sizeof(typeCount));
+
+    for (p = 0; p < partyCount; p++)
+    {
+        if (party[p].species == SPECIES_NONE)
+            continue;
+        members++;
+        for (m = 0; m < MAX_MON_MOVES; m++)
+        {
+            u16 move = party[p].moves[m];
+            if (move == MOVE_NONE || !MoveGoesInFolder(move))
+                continue;
+            copies[p][m] = CopiesForPP(gBattleMoves[move].pp);
+            total += copies[p][m];
+            typeCount[gBattleMoves[move].type] += copies[p][m];
+        }
+    }
+
+    // Switching chips only make sense with 2+ Pokémon: one per member + one wildcard.
+    utility = (members >= 2) ? members + 1 : 0;
+
+    // Trim move copies (largest stacks first) until everything fits in 30.
+    while (total + utility > FOLDER_MAX)
+    {
+        s32 bp = -1, bm = -1;
+        for (p = 0; p < partyCount; p++)
+            for (m = 0; m < MAX_MON_MOVES; m++)
+                if (copies[p][m] > 1 && (bp < 0 || copies[p][m] > copies[bp][bm]))
+                    bp = p, bm = m;
+        if (bp < 0)
+            break; // every move down to 1 copy; accept
+        copies[bp][bm]--;
+        total--;
+    }
+
+    for (p = 0; p < partyCount; p++)
+        for (m = 0; m < MAX_MON_MOVES; m++)
+        {
+            u8 c;
+            for (c = 0; c < copies[p][m] && folder->count < FOLDER_MAX; c++)
+            {
+                struct FolderChip *ch = &folder->chips[folder->count++];
+                ch->kind = FCHIP_MOVE;
+                ch->owner = p;
+                ch->slot = m;
+                ch->move = party[p].moves[m];
+                ch->shape = Pkbn_ShapeForMove(ch->move);
+                ch->codes = 1u << gBattleMoves[ch->move].type;
+            }
+        }
+
+    if (utility)
+    {
+        for (p = 0; p < partyCount && folder->count < FOLDER_MAX; p++)
+        {
+            struct FolderChip *ch;
+            u32 codes;
+            if (party[p].species == SPECIES_NONE)
+                continue;
+            // Switch -> p carries the types of p's own moves; top up to 2 codes with the most
+            // common other type in the folder so it can always link to something.
+            codes = MoveTypesOf(&party[p]);
+            while (CountBits(codes) < 2)
+            {
+                s32 t, best = -1;
+                for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+                    if (!(codes & (1u << t)) && typeCount[t] && (best < 0 || typeCount[t] > typeCount[best]))
+                        best = t;
+                if (best < 0)
+                    best = (codes & (1u << TYPE_NORMAL)) ? TYPE_FIGHTING : TYPE_NORMAL;
+                codes |= 1u << best;
+            }
+            ch = &folder->chips[folder->count++];
+            ch->kind = FCHIP_SWITCH;
+            ch->target = p;
+            ch->codes = codes;
+        }
+        if (folder->count < FOLDER_MAX)
+        {
+            struct FolderChip *ch = &folder->chips[folder->count++];
+            ch->kind = FCHIP_WILD;
+            ch->codes = CODE_ALL;
+        }
+    }
+
+    for (p = 0; p < folder->count; p++)
+        folder->pile[p] = p;
+    folder->pileCount = folder->count;
+    Shuffle(folder->pile, folder->pileCount);
+}
+
+bool8 PkbnFolder_Draw(struct Folder *folder, u8 *outIdx)
+{
+    if (folder->pileCount == 0)
+    {
+        if (folder->discardCount == 0)
+            return FALSE;
+        memcpy(folder->pile, folder->discard, folder->discardCount);
+        folder->pileCount = folder->discardCount;
+        folder->discardCount = 0;
+        Shuffle(folder->pile, folder->pileCount);
+    }
+    *outIdx = folder->pile[--folder->pileCount];
+    return TRUE;
+}
+
+void PkbnFolder_Discard(struct Folder *folder, u8 idx)
+{
+    if (folder->discardCount < FOLDER_MAX)
+        folder->discard[folder->discardCount++] = idx;
+}
+
+static bool8 EndsChain(const struct FolderChip *ch)
+{
+    return ch->kind == FCHIP_WILD || (ch->kind == FCHIP_MOVE && ch->shape == SHAPE_BATON);
+}
+
+bool8 PkbnFolder_CanAppend(const struct Folder *folder, const u8 *queue, u8 queueCount, u8 cand,
+                           u8 active, const bool8 *alive, const struct BattlePokemon *party)
+{
+    const struct FolderChip *c = &folder->chips[cand];
+    u32 common = CODE_ALL;
+    u8 projected = active;
+    s32 i;
+
+    for (i = 0; i < queueCount; i++)
+    {
+        const struct FolderChip *q = &folder->chips[queue[i]];
+        if (queue[i] == cand)
+            return FALSE;       // already queued
+        if (EndsChain(q))
+            return FALSE;       // nothing may follow a wildcard / Baton
+        common &= q->codes;
+        if (q->kind == FCHIP_SWITCH)
+            projected = q->target;
+    }
+    if ((common & c->codes) == 0)
+        return FALSE;           // BN rule: all chips in one Custom share a code
+
+    switch (c->kind)
+    {
+    case FCHIP_MOVE:
+    {
+        s32 queuedUses = 0;
+        for (i = 0; i < queueCount; i++)
+        {
+            const struct FolderChip *q = &folder->chips[queue[i]];
+            if (q->kind == FCHIP_MOVE && q->owner == c->owner && q->slot == c->slot)
+                queuedUses++;
+        }
+        return c->owner == projected && alive[c->owner] && party[c->owner].pp[c->slot] > queuedUses;
+    }
+    case FCHIP_SWITCH:
+        return c->target != projected && alive[c->target];
+    case FCHIP_WILD:
+    {
+        // needs at least one other Pokémon able to come in
+        for (i = 0; i < PKBN_PARTY_MAX; i++)
+            if (i != projected && alive[i])
+                return TRUE;
+        return FALSE;
+    }
+    }
+    return FALSE;
+}
