--- /dev/null
+++ b/include/pkbn/folder.h
@@ -0,0 +1,53 @@
+#ifndef GUARD_PKBN_FOLDER_H
+#define GUARD_PKBN_FOLDER_H
+
+// Chip folder built from the party (docs/design/01-folder-and-switching.md, decisions of 2026-10-04):
+//  - 30 chips max (BN6 folder size). Move chips: copies by the move's max PP (>=30 -> 3, >=15 -> 2, else 1).
+//  - One Switch chip per party Pokémon, carrying 2+ codes taken from that Pokémon's move types.
+//  - One wildcard Switch: any target, matches any code, but nothing can be queued after it.
+//  - Codes are move types (bit per type). A selection is legal if all chips share a code.
+//  - Hand of 5 (BN). Used chips go to a discard pile that is reshuffled when the draw pile is empty
+//    (our change: BN never reshuffles, but early-game folders are tiny).
+
+#include "pkbn/move_shapes.h"
+
+#define FOLDER_MAX 30
+#define HAND_SIZE 5
+#define PKBN_PARTY_MAX 6
+#define CODE_ALL 0xFFFFFFFF
+
+enum { FCHIP_MOVE, FCHIP_SWITCH, FCHIP_WILD };
+
+struct FolderChip
+{
+    u8 kind;
+    u8 owner;   // FCHIP_MOVE: party slot that knows the move
+    u8 slot;    // FCHIP_MOVE: move slot
+    u8 shape;   // FCHIP_MOVE: Pkbn_ShapeForMove
+    u16 move;   // FCHIP_MOVE
+    u8 target;  // FCHIP_SWITCH: party slot to bring in
+    u32 codes;  // bit per type (1 << TYPE_x); CODE_ALL for the wildcard
+};
+
+struct Folder
+{
+    struct FolderChip chips[FOLDER_MAX];
+    u8 count;
+    u8 pile[FOLDER_MAX];
+    u8 pileCount;
+    u8 discard[FOLDER_MAX];
+    u8 discardCount;
+};
+
+// party[i].species == 0 for empty slots.
+void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party, u8 partyCount);
+// Draws one chip index; reshuffles the discard pile when needed. FALSE if nothing left.
+bool8 PkbnFolder_Draw(struct Folder *folder, u8 *outIdx);
+void PkbnFolder_Discard(struct Folder *folder, u8 idx);
+
+// Can `cand` be appended to the queue? `active` = party slot active before the queue runs,
+// `alive[i]` = party slot i can battle, `pp[i][m]` = remaining PP.
+bool8 PkbnFolder_CanAppend(const struct Folder *folder, const u8 *queue, u8 queueCount, u8 cand,
+                           u8 active, const bool8 *alive, const struct BattlePokemon *party);
+
+#endif // GUARD_PKBN_FOLDER_H
