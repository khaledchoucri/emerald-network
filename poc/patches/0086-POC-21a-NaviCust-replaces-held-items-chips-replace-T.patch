@@ -0,0 +1,30 @@
+#ifndef GUARD_PKBN_ITEMS_H
+#define GUARD_PKBN_ITEMS_H
+// POC-21: NaviCust replaces held items in grid battles, chips replace TMs (src/pkbn/items.c).
+#include "global.h"
+
+#define PKBN_TM_COPIES 3   // a TM gives what learning a move gives (TUNE)
+enum { PKBN_GOT_NONE, PKBN_GOT_CHIPS, PKBN_GOT_PROGRAM };
+
+s16 PkbnItem_ProgramFor(u16 item);       // the NaviCust program an item is (-1: none)
+bool8 PkbnItem_IsTM(u16 item);
+bool8 PkbnItem_AtFrontier(void);
+bool8 PkbnItem_BattleOnly(u16 item);      // its only effect is in battle (berries, herbs, species items)
+bool8 PkbnItem_CanHold(u16 item);         // GIVE: battle-only items only at the Battle Frontier
+// Getting an item: TMs become chips, program items programs. TRUE: handled - it doesn't go in the bag.
+bool8 PkbnItem_Acquire(u16 item, u16 count, bool8 quiet);
+u8 PkbnItem_LastNote(void);              // for scripts: PKBN_GOT_*; STR_VAR_2 item, STR_VAR_3 what it became
+void PkbnItem_MigrateSave(void);         // old saves: once on load
+bool8 PkbnExpShare_On(void);             // Gen 6's party-wide Exp. Share
+
+// POC-21: the Move Relearner also teaches the moves you own as chips (Khaled's pick: chips are TMs now)
+#define PKBN_RELEARNER_MAX 60
+u8 PkbnRelearner_AddChipMoves(struct Pokemon *mon, u16 *moves, u8 n, u8 max);
+
+// pkbn_save.c
+bool8 PkbnSave_ExpShareOn(void);
+void PkbnSave_SetExpShare(bool8 on);
+// item.c
+void PkbnBag_ClearSlot(struct ItemSlot *slot);
+
+#endif // GUARD_PKBN_ITEMS_H
