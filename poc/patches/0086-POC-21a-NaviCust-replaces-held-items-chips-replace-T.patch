 	call_if_eq VAR_0x8008, TRUE, EventScript_FoundTMHM
@@ -147,6 +177,7 @@ EventScript_HiddenItemScript::
 	waitse
 	additem VAR_0x8005
 	copyvar VAR_0x8007, VAR_RESULT
+	specialvar VAR_0x800A, PkbnItemNote
 	bufferitemnameplural STR_VAR_2, VAR_0x8005, 1
 	checkitemtype VAR_0x8005
 	call EventScript_BufferPocketNameAndTryFanfare
@@ -155,6 +186,7 @@ EventScript_HiddenItemScript::
 	end
 
 EventScript_PickUpHiddenItem::
+	goto_if_ne VAR_0x800A, 0, EventScript_PkbnFoundHiddenBecame
 	copyvar VAR_0x8008, VAR_0x8004
 	copyvar VAR_0x8004, VAR_0x8005
 	specialvar VAR_RESULT, BufferTMHMMoveName
@@ -186,6 +218,19 @@ EventScript_PutHiddenItemInPocket::
