diff --git a/data/scripts/obtain_item.inc b/data/scripts/obtain_item.inc
index d32db9d..a0698ac 100644
--- a/data/scripts/obtain_item.inc
+++ b/data/scripts/obtain_item.inc
@@ -4,9 +4,37 @@
 Std_ObtainItem::
 	additem ITEMID, AMOUNT
 	copyvar VAR_0x8007, VAR_RESULT
+	specialvar VAR_0x800A, PkbnItemNote
+	goto_if_ne VAR_0x800A, 0, EventScript_PkbnObtainedBecame
 	call EventScript_ObtainItemMessage
 	return
 
+@ pkbn POC-21: a TM became chips, a held item a NaviCust program (src/pkbn/items.c): say so, no pocket
+EventScript_PkbnObtainedBecame::
+	call_if_eq VAR_0x800A, 1, EventScript_PlayFanfareObtainedTMHM
+	call_if_eq VAR_0x800A, 2, EventScript_PlayFanfareObtainedItem
+	message Text_PkbnObtainedItem
+	waitfanfare
+	msgbox Text_PkbnItBecame, MSGBOX_DEFAULT
+	setvar VAR_RESULT, TRUE
+	return
+
+EventScript_PkbnFoundBecame::
+	message Text_PkbnFoundItem
+	waitfanfare
+	waitmessage
+	msgbox Text_PkbnItBecame, MSGBOX_DEFAULT
+	return
+
+Text_PkbnObtainedItem:
+	.string "{PLAYER} obtained the {STR_VAR_2}!$"
+
+Text_PkbnFoundItem:
+	.string "{PLAYER} found the {STR_VAR_2}!$"
+
+Text_PkbnItBecame:
+	.string "It became {STR_VAR_3}!$"
+
 EventScript_ObtainItemMessage::
 	bufferitemnameplural STR_VAR_2, ITEMID, AMOUNT
 	checkitemtype ITEMID
@@ -111,6 +139,8 @@ Std_FindItem::
 EventScript_PickUpItem::
 	removeobject VAR_LAST_TALKED
 	additem VAR_0x8004, VAR_0x8005
