diff --git a/src/pkbn/items.c b/src/pkbn/items.c
new file mode 100644
index 0000000..a89db19
--- /dev/null
+++ b/src/pkbn/items.c
@@ -0,0 +1,293 @@
+// POC-21: hardening - NaviCust replaces held items in grid battles, chips replace TMs (Khaled's picks). include/pkbn/items.h.
+//
+//  - Held items do nothing in grid battles (grid_battle.c MonToBattleMon). Emerald's own battles (Battle Frontier,
+//    Wally's demo, Safari) keep them.
+//  - An item that has a NaviCust program becomes that program when you get it: found, given, hidden, bought, or held
+//    by a Pokémon you catch. Already in the bag, the PC or held: converted once when the save loads. The Battle
+//    Frontier is the exception: what you get there stays an item, for the Frontier's own battles.
+//  - Items whose only effect is in battle (berries, herbs, species items) can't be given to hold, except at the Battle
+//    Frontier.
+//  - A TM gives 3 copies of its chip and never reaches the bag (3 = what learning a move gives, GrantLearned).
+//    HMs stay items in the TM case (field moves) and give 3 copies too.
+//  - Khaled's note: Exp. Share is Gen 6's party-wide toggle (a key item: use it to turn it ON/OFF).
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "item.h"
+#include "pokemon.h"
+#include "pokemon_storage_system.h"
+#include "string_util.h"
+#include "strings.h"
+#include "event_data.h"
+#include "constants/items.h"
+#include "constants/region_map_sections.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/folder.h"
+#include "pkbn/move_table.h"
+#include "pkbn/ncp_table.h"
+#include "pkbn/navicust.h"
+#include "pkbn/items.h"
+#include "pkbn/render.h"
+#include "party_menu.h"
+#include "data.h"
+#include "constants/characters.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+// The held items that are NaviCust programs (tools/navicust_curated.py). Cleanse Tag is SneakRun ("No weak enemies").
+static const struct { u16 item; const char *program; } sItemPrograms[] = {
+    { ITEM_LEFTOVERS, "Leftovrs" }, { ITEM_QUICK_CLAW, "QuickClw" }, { ITEM_KINGS_ROCK, "KingRock" },
+    { ITEM_SCOPE_LENS, "ScopLens" }, { ITEM_BRIGHT_POWDER, "BrtPowdr" }, { ITEM_SHELL_BELL, "ShelBell" },
+    { ITEM_FOCUS_BAND, "FocsBand" }, { ITEM_CHOICE_BAND, "ChoiceBd" }, { ITEM_LUCKY_EGG, "LuckyEgg" },
+    { ITEM_AMULET_COIN, "AmuletCn" }, { ITEM_CHARCOAL, "Charcoal" }, { ITEM_MYSTIC_WATER, "MystcWtr" },
+    { ITEM_MAGNET, "Magnet" }, { ITEM_MIRACLE_SEED, "MircSeed" }, { ITEM_NEVER_MELT_ICE, "NevMeltI" },
+    { ITEM_BLACK_BELT, "BlkBelt" }, { ITEM_POISON_BARB, "PoisBarb" }, { ITEM_SOFT_SAND, "SoftSand" },
+    { ITEM_SHARP_BEAK, "ShrpBeak" }, { ITEM_TWISTED_SPOON, "TwstSpn" }, { ITEM_SILVER_POWDER, "SlvPowdr" },
+    { ITEM_HARD_STONE, "HardStn" }, { ITEM_SPELL_TAG, "SpellTag" }, { ITEM_DRAGON_FANG, "DrgnFang" },
+    { ITEM_BLACK_GLASSES, "BlkGlass" }, { ITEM_METAL_COAT, "MetlCoat" }, { ITEM_SILK_SCARF, "SilkScrf" },
+    // POC-21 programs (Khaled: "everstone and soothe bell probably can be turned into programs")
+    { ITEM_EVERSTONE, "Everstone" }, { ITEM_SOOTHE_BELL, "SoothBel" }, { ITEM_SMOKE_BALL, "SmokeBal" },
+    { ITEM_CLEANSE_TAG, "SneakRun" },
+};
+
+static struct
+{
+    u8 kind;          // PKBN_GOT_*
+    u16 item, count;
+    u16 move;         // chips: the move
+    s16 program;      // programs: the index
+} sLast;
+
+s16 PkbnItem_ProgramFor(u16 item)
+{
+    s32 i;
+    for (i = 0; i < (s32)ARRAY_COUNT(sItemPrograms); i++)
+        if (sItemPrograms[i].item == item)
+            return (s16)PkbnProgram_ByName(sItemPrograms[i].program);
+    return -1;
+}
+
+bool8 PkbnItem_IsTM(u16 item)
+{
+    return item >= ITEM_TM01 && item <= ITEM_TM50;
+}
+
+bool8 PkbnItem_AtFrontier(void)
+{
+    return gMapHeader.regionMapSectionId == MAPSEC_BATTLE_FRONTIER;
+}
+
+// Items whose only effect is in battle (Gen 3 hold effects we don't run on the grid).
+bool8 PkbnItem_BattleOnly(u16 item)
+{
+    if (item >= ITEM_CHERI_BERRY && item <= ITEM_ENIGMA_BERRY)
+        return TRUE;
+    switch (item)
+    {
+    case ITEM_WHITE_HERB: case ITEM_MENTAL_HERB: case ITEM_LIGHT_BALL: case ITEM_THICK_CLUB: case ITEM_LUCKY_PUNCH:
+    case ITEM_STICK: case ITEM_METAL_POWDER: case ITEM_SOUL_DEW: case ITEM_DEEP_SEA_TOOTH: case ITEM_DEEP_SEA_SCALE:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+bool8 PkbnItem_CanHold(u16 item)
+{
+    return PkbnItem_AtFrontier() || !PkbnItem_BattleOnly(item);
+}
+
+// 3 copies of a move's chip, spread over its codes (the GrantLearned rule).
+static void GrantChips(u16 move, u16 copies)
+{
+    const struct PkbnMoveInfo *info = &gPkbnMoveInfo[move];
+    u16 k;
+    if (!PkbnFolder_MoveIsChip(move) || info->laneCount == 0)
+        return;
+    for (k = 0; k < copies; k++)
+        PkbnPack_Add(move, info->lanes[k % info->laneCount], 1);
+}
+
+bool8 PkbnItem_Acquire(u16 item, u16 count, bool8 quiet)
+{
+    s16 prog;
+    if (count == 0)
+        return FALSE;
+    if (!quiet)
+        memset(&sLast, 0, sizeof(sLast));
+    if (item >= ITEM_TM01 && item <= ITEM_HM08)
+    {
+        u16 move = ItemIdToBattleMoveId(item);
+        GrantChips(move, PKBN_TM_COPIES * count);
+        printf("[pkbn] %s item %u -> move %u x%u\n", PkbnItem_IsTM(item) ? "TM" : "HM", item, move, PKBN_TM_COPIES * count);
+        if (!PkbnItem_IsTM(item))
+            return FALSE;   // HMs: also into the TM case, for the field moves
+        if (!quiet)
+            sLast.kind = PKBN_GOT_CHIPS, sLast.item = item, sLast.count = PKBN_TM_COPIES * count, sLast.move = move;
+        return TRUE;
+    }
+    prog = PkbnItem_ProgramFor(item);
+    if (prog >= 0 && !PkbnItem_AtFrontier())
+    {
+        PkbnProgram_Grant(prog, count);
+        printf("[pkbn] item %u -> program %s x%u\n", item, gPkbnNcps[prog].name, count);
+        if (!quiet)
+            sLast.kind = PKBN_GOT_PROGRAM, sLast.item = item, sLast.count = count, sLast.program = prog;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// ASCII to Emerald's text encoding (charmap.txt; the reverse of Pkbn_GameStringToAscii).
+static void AsciiToGame(u8 *dst, const char *src, u32 max)
+{
+    u32 i;
+    for (i = 0; i + 1 < max && src[i]; i++)
+    {
+        char c = src[i];
+        u8 o = 0x00;
+        if (c >= '0' && c <= '9') o = 0xA1 + (c - '0');
+        else if (c >= 'A' && c <= 'Z') o = 0xBB + (c - 'A');
+        else if (c >= 'a' && c <= 'z') o = 0xD5 + (c - 'a');
+        else if (c == '!') o = 0xAB;
+        else if (c == '?') o = 0xAC;
+        else if (c == '.') o = 0xAD;
+        else if (c == '-') o = 0xAE;
+        else if (c == '\'') o = 0xB4;
+        else if (c == ',') o = 0xB8;
+        else if (c == '/') o = 0xBA;
+        else if (c == ':') o = 0xF0;
+        else if (c == '+') o = 0x2E;
+        dst[i] = o;
+    }
+    dst[i] = EOS;
+}
+
+// For the scripts (data/scripts/obtain_item.inc): what the last additem became. VAR_RESULT: PKBN_GOT_*.
+// STR_VAR_2: the item's name, STR_VAR_3: what it became.
+u8 PkbnItem_LastNote(void)
+{
+    u8 kind = sLast.kind;
+    char text[40];
+    if (kind == PKBN_GOT_NONE)
+        return kind;
+    CopyItemName(sLast.item, gStringVar2);
+    if (kind == PKBN_GOT_CHIPS)
+    {
+        char name[MOVE_NAME_LENGTH + 1];
+        Pkbn_GameStringToAscii(name, gMoveNames[sLast.move], sizeof(name));
+        snprintf(text, sizeof(text), "%u %s CHIPS", sLast.count, name);
+    }
+    else
+        snprintf(text, sizeof(text), "the %s program", gPkbnNcps[sLast.program].name);
+    AsciiToGame(gStringVar3, text, 40);
+    sLast.kind = PKBN_GOT_NONE;
+    return kind;
+}
+
+// ---- The Move Relearner: chips you own that the Pokémon can learn and doesn't know (after its level-up moves) ----
+u8 PkbnRelearner_AddChipMoves(struct Pokemon *mon, u16 *moves, u8 n, u8 max)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES), mv;
+    s32 k;
+    for (mv = 1; mv < MOVES_COUNT && n < max; mv++)
+    {
+        bool8 dup = FALSE;
+        if (PkbnPack_Total(mv) == 0 || !Chip_SpeciesCanLearn(species, mv))
+            continue;
+        for (k = 0; k < MAX_MON_MOVES; k++)
+            dup |= GetMonData(mon, MON_DATA_MOVE1 + k) == mv;
+        for (k = 0; k < n; k++)
+            dup |= moves[k] == mv;
+        if (!dup)
+            moves[n++] = mv;
+    }
+    return n;
+}
+
+// ---- Gen 6's Exp. Share: ON/OFF ------------------------------------------------------------------------------------
+bool8 PkbnExpShare_On(void)
+{
+    if (getenv("PKBN_TEST_EXP_SHARE") != NULL)
+        return TRUE;
+    return CheckBagHasItem(ITEM_EXP_SHARE, 1) && PkbnSave_ExpShareOn();
+}
+
+// ---- Old saves: convert once on load ---------------------------------------------------------------------------
+static void MigrateMon(struct BoxPokemon *box, u32 *got)
+{
+    u16 item = GetBoxMonData(box, MON_DATA_HELD_ITEM), none = ITEM_NONE;
+    if (item == ITEM_NONE || GetBoxMonData(box, MON_DATA_SPECIES) == SPECIES_NONE)
+        return;
+    if (item == ITEM_EXP_SHARE)
+    {
+        if (!CheckBagHasItem(ITEM_EXP_SHARE, 1))
+            AddBagItem(ITEM_EXP_SHARE, 1);   // the key item now
+        SetBoxMonData(box, MON_DATA_HELD_ITEM, &none);
+        (*got)++;
+        return;
+    }
+    if (PkbnItem_ProgramFor(item) >= 0 && PkbnItem_Acquire(item, 1, TRUE))
+    {
+        SetBoxMonData(box, MON_DATA_HELD_ITEM, &none);
+        (*got)++;
+    }
+}
+
+void PkbnItem_MigrateSave(void)
+{
+    u32 got = 0;
+    s32 i, j;
+    u16 item;
+    // Exp. Share: it was in the ITEMS pocket; the key item keeps one
+    for (i = 0; i < BAG_ITEMS_COUNT; i++)
+        if (gSaveBlock1Ptr->bagPocket_Items[i].itemId == ITEM_EXP_SHARE)
+        {
+            PkbnBag_ClearSlot(&gSaveBlock1Ptr->bagPocket_Items[i]);
+            if (!CheckBagHasItem(ITEM_EXP_SHARE, 1))
+                AddBagItem(ITEM_EXP_SHARE, 1);
+            got++;
+        }
+    // TMs and program items in the bag
+    for (item = ITEM_TM01; item <= ITEM_TM50; item++)
+    {
+        u16 n = CountTotalItemQuantityInBag(item);
+        if (n && PkbnItem_Acquire(item, n, TRUE))
+            RemoveBagItem(item, n), got += n;
+    }
+    for (i = 0; i < (s32)ARRAY_COUNT(sItemPrograms); i++)
+    {
+        u16 n = CountTotalItemQuantityInBag(sItemPrograms[i].item);
+        if (n && PkbnItem_Acquire(sItemPrograms[i].item, n, TRUE))
+            RemoveBagItem(sItemPrograms[i].item, n), got += n;
+    }
+    // the PC's item storage
+    for (i = 0; i < PC_ITEMS_COUNT; i++)
+    {
+        struct ItemSlot *s = &gSaveBlock1Ptr->pcItems[i];
+        if (s->itemId == ITEM_EXP_SHARE || (s->itemId && (PkbnItem_IsTM(s->itemId) || PkbnItem_ProgramFor(s->itemId) >= 0)))
+        {
+            if (s->itemId == ITEM_EXP_SHARE)
+            {
+                if (!CheckBagHasItem(ITEM_EXP_SHARE, 1))
+                    AddBagItem(ITEM_EXP_SHARE, 1);
+            }
+            else
+                PkbnItem_Acquire(s->itemId, s->quantity, TRUE);
+            got += s->quantity;
+            s->itemId = ITEM_NONE;
+            s->quantity = 0;
+        }
+    }
+    CompactPCItems();
+    // held by the party and the boxes
+    for (i = 0; i < PARTY_SIZE; i++)
+        MigrateMon(&gPlayerParty[i].box, &got);
+    for (i = 0; i < TOTAL_BOXES_COUNT; i++)
+        for (j = 0; j < IN_BOX_COUNT; j++)
+            MigrateMon(GetBoxedMonPtr(i, j), &got);
+    if (got)
+        printf("[pkbn] POC-21: converted %u items, TMs and held items into programs and chips\n", (unsigned)got);
+}
+
+#endif // PORTABLE
