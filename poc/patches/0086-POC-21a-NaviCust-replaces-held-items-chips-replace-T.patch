 	end
 
+@ pkbn POC-21: a hidden TM became chips, a hidden held item a program
+EventScript_PkbnFoundHiddenBecame::
+	message Text_PkbnFoundItem
+	waitmessage
+	waitfanfare
+	msgbox Text_PkbnItBecame, MSGBOX_DEFAULT
+	special TryPutTreasureInvestigatorsOnAir
+	special SetHiddenItemFlag
+	special PkbnHiddenChipData
+	goto_if_eq VAR_RESULT, TRUE, EventScript_PkbnHiddenChipData
