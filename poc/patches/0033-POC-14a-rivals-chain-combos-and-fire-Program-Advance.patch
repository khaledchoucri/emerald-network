 // Use a move from this Custom's chain. A contest combo with the previous chip pays off (design 03 §4).
+// Chains (POC-14): Emerald's contest combos (AreMovesContestCombo, src/contest_effect.c:60) plus our own pairs, themed
+// on the Gym Leaders' and Elite Four's movesets (TUNE). Used by the player's chains and the rivals' follow-ups.
+static const u16 sExtraCombos[][2] =
+{
+    { MOVE_DEFENSE_CURL, MOVE_ROCK_TOMB }, { MOVE_BULK_UP, MOVE_ARM_THRUST }, { MOVE_BULK_UP, MOVE_FOCUS_PUNCH },
+    { MOVE_THUNDER_WAVE, MOVE_SHOCK_WAVE }, { MOVE_THUNDER_WAVE, MOVE_SPARK }, { MOVE_SUNNY_DAY, MOVE_HEAT_WAVE },
+    { MOVE_BELLY_DRUM, MOVE_FACADE }, { MOVE_FEATHER_DANCE, MOVE_AERIAL_ACE }, { MOVE_DRAGON_DANCE, MOVE_DRAGON_CLAW },
+    { MOVE_CALM_MIND, MOVE_PSYCHIC }, { MOVE_CALM_MIND, MOVE_EXTRASENSORY }, { MOVE_RAIN_DANCE, MOVE_WATER_PULSE },
+    { MOVE_RAIN_DANCE, MOVE_WATER_SPOUT }, { MOVE_SWORDS_DANCE, MOVE_SLASH }, { MOVE_SWORDS_DANCE, MOVE_CRUNCH },
+    { MOVE_CONFUSE_RAY, MOVE_SHADOW_BALL }, { MOVE_CONFUSE_RAY, MOVE_NIGHT_SHADE }, { MOVE_WILL_O_WISP, MOVE_SHADOW_BALL },
+    { MOVE_HAIL, MOVE_ICE_BALL }, { MOVE_HAIL, MOVE_BLIZZARD }, { MOVE_LEECH_SEED, MOVE_GIGA_DRAIN },
+    { MOVE_TOXIC, MOVE_SLUDGE_BOMB }, { MOVE_SANDSTORM, MOVE_ROCK_SLIDE }, { MOVE_AMNESIA, MOVE_SURF },
+};
+
+static bool8 ChainCombo(u16 prev, u16 next)
+{
+    u32 i;
+    if (AreMovesContestCombo(prev, next))
+        return TRUE;
+    for (i = 0; i < ARRAY_COUNT(sExtraCombos); i++)
+        if (sExtraCombos[i][0] == prev && sExtraCombos[i][1] == next)
+            return TRUE;
+    return FALSE;
+}
+
