 {
     struct Fighter *p = &sB.f[SIDE_PLAYER];
-    if (sB.chainPrev != MOVE_NONE && AreMovesContestCombo(sB.chainPrev, move))
+    if (sB.chainPrev != MOVE_NONE && ChainCombo(sB.chainPrev, move))
     {
         char a[16], b[16], line[40];
         Pkbn_GameStringToAscii(a, gMoveNames[sB.chainPrev], sizeof(a));
@@ -1536,6 +1563,72 @@ static void EnemyDodge(void)
             }
 }
 
+// ---- Rivals chain and fire Program Advances (POC-14, our design - TUNE) ---------------------------------------------
+// A BN boss Navi strings its attacks together and has a big move it saves for when it's hurt. Rivals (src/pkbn/rival.c)
+// from tier 2: after a move, a combo follow-up it knows comes right after (ChainCombo, the same pairs the player's
+// chains use) with the combo payoff. From tier 3: a Program Advance once below half HP (tier 5:
+// again below a quarter), if the Pokémon knows 2 of its 3 recipe moves, or its finisher and the PA's type.
+static s8 RivalPA(const struct Fighter *e)
+{
+    s32 k, m, i, best = -1, bestPow = 0;
+    for (k = 0; k < PKBN_PA_COUNT; k++)
+    {
+        const struct PkbnProgramAdvance *pa = &gPkbnProgramAdvances[k];
+        s32 known = 0;
+        bool8 finisher = FALSE;
+        for (i = 0; i < 3; i++)
+            for (m = 0; m < MAX_MON_MOVES; m++)
+                if (e->bm.moves[m] == pa->recipe[i])
+                {
+                    known++;
+                    if (i == 2)
+                        finisher = TRUE;
+                }
+        if (known >= 2 || (finisher && (e->bm.types[0] == pa->type || e->bm.types[1] == pa->type)))
+            if (pa->power > bestPow)
+                best = k, bestPow = pa->power;
+    }
+    return best;
+}
+
+static bool8 RivalSpecial(struct Fighter *e)
+{
+    s8 pa;
+    u8 allowed = sB.rivalTier >= 5 ? 2 : sB.rivalTier >= 3 ? 1 : 0;
+    u32 hpLine = e->paUses == 0 ? e->bm.maxHP / 2 : e->bm.maxHP / 4;
+    if (e->paUses >= allowed || e->bm.hp > hpLine || (pa = RivalPA(e)) < 0)
+        return FALSE;
+    {
+        char line[48];
+        snprintf(line, sizeof(line), "%s: %s!", e->name, gPkbnProgramAdvances[pa].name);
+        Flash(line, 90);
+        PlaySE(SE_SUCCESS);
+        PKBN_LOG("rival program advance: %s", line);
+    }
+    e->paUses++;
+    e->chainSlot = 0;   // the PA replaces a queued follow-up
+    EnemyLineUp(gPkbnProgramAdvances[pa].kind);
+    Moves_UsePA(SIDE_ENEMY, pa, &e->bm, e->name, 0);
+    return TRUE;
+}
+
+// After the rival's move `slot`, line up a contest-combo follow-up it knows (tier 2+).
+static void RivalQueueCombo(struct Fighter *e, u8 slot)
+{
+    s32 m;
+    e->chainSlot = 0;
+    if (sB.rivalTier < 2)
+        return;
+    for (m = 0; m < MAX_MON_MOVES; m++)
+        if (m != slot && e->bm.pp[m] && PkbnFolder_MoveIsChip(e->bm.moves[m])
+         && ChainCombo(e->bm.moves[slot], e->bm.moves[m]))
+        {
+            e->chainSlot = m + 1;
+            sB.aiAttackTimer = 40;   // TUNE: the follow-up comes quickly
+            return;
+        }
+}
+
 static void UpdateOneEnemy(void)
 {
     struct Fighter *e = &sB.f[SIDE_ENEMY];
@@ -1556,12 +1649,34 @@ static void UpdateOneEnemy(void)
             SetMsg(line, 50);
             return;
         }
+        if (sB.rivalTier && RivalSpecial(e))
+            return;
+        if (e->chainSlot && e->bm.pp[e->chainSlot - 1])
+        {
+            // the combo follow-up (POC-14): the chain payoff applies, as for the player's chains
+            char a[16], b[16], line[48];
+            slot = e->chainSlot - 1;
+            Pkbn_GameStringToAscii(a, gMoveNames[e->lastMove], sizeof(a));
+            Pkbn_GameStringToAscii(b, gMoveNames[e->bm.moves[slot]], sizeof(b));
+            snprintf(line, sizeof(line), "FOE COMBO! %s>%s", a, b);
+            Flash(line, 70);
+            e->chainSlot = 0;
+            EnemyLineUp(Moves_KindOf(e->bm.moves[slot]));
+            e->bm.pp[slot]--;
+            sB.nextCombo = TRUE;
+            Moves_Use(SIDE_ENEMY, e->bm.moves[slot], slot, &e->bm, e->name, 0);
+            sB.nextCombo = FALSE;
+            PKBN_LOG("rival combo: %s", line);
+            return;
+        }
         if (!PickEnemyMove(&slot))
             return;
         EnemyLineUp(Moves_KindOf(e->bm.moves[slot]));
         e->bm.pp[slot]--;
         if (!TryTeleportEscape(SIDE_ENEMY, e->bm.moves[slot]))
             Moves_Use(SIDE_ENEMY, e->bm.moves[slot], slot, &e->bm, e->name, 0);
+        if (sB.rivalTier)
+            RivalQueueCombo(e, slot);
         return;
     }
 
