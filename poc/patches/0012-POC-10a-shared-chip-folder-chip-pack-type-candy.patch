+// Chip pack for self-tests (POC-10). Default: the pre-POC-10 folder (copies by max PP: >=30 -> 3, >=15 -> 2,
+// else 1; copy k gets the move's k-th lane), so the older suites keep testing the same chips.
+// PKBN_TEST_PACK_LEARNED=1: the real rule instead (1 copy per known move, first code).
+// PKBN_TEST_PACK="move_id:L:n,...": extra copies (L = A..Z or *).
+static void SeedTestPack(void)
+{
+    const char *t;
+    s32 i, m;
+    if (getenv("PKBN_TEST_PACK_LEARNED") == NULL)
+        for (i = 0; i < PARTY_SIZE; i++)
+            for (m = 0; m < MAX_MON_MOVES; m++)
+            {
+                u16 mv = GetMonData(&gPlayerParty[i], MON_DATA_MOVE1 + m);
+                const struct PkbnMoveInfo *info = &gPkbnMoveInfo[mv];
+                u8 pp, c, k;
+                if (!PkbnFolder_MoveIsChip(mv) || PkbnPack_Total(mv))
+                    continue;
+                pp = gBattleMoves[mv].pp;
+                c = pp >= 30 ? 3 : pp >= 15 ? 2 : 1;
+                for (k = 0; k < c; k++)
+                    PkbnPack_Add(mv, info->lanes[k % info->laneCount], 1);
+                PkbnPack_SetGranted(mv);
+            }
+    if ((t = getenv("PKBN_TEST_PACK")) != NULL)
+        while (*t)
+        {
+            u16 mv = (u16)strtol(t, (char **)&t, 10);
+            u8 letter = 0, n = 1;
+            if (*t == ':')
+            {
+                t++;
+                letter = (*t == '*') ? LETTER_WILD : (u8)(*t - 'A');
+                t++;
+            }
+            if (*t == ':')
+                n = (u8)strtol(t + 1, (char **)&t, 10);
+            PkbnPack_Add(mv, letter, n);
+            while (*t == ',' || *t == ' ')
+                t++;
+        }
+}
