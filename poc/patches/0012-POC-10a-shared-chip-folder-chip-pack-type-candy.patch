+// ---- Chip pack, candy (POC-10) ------------------------------------------------------------------------------
+
+u8 PkbnPack_Get(u16 move, u8 letter)
+{
+    return (move < MOVES_COUNT && letter < PACK_LETTERS) ? sSave.pack[move][letter] : 0;
+}
+
+void PkbnPack_Add(u16 move, u8 letter, s32 n)
+{
+    s32 v;
+    if (move == MOVE_NONE || move >= MOVES_COUNT || letter >= PACK_LETTERS)
+        return;
+    v = sSave.pack[move][letter] + n;
+    sSave.pack[move][letter] = v < 0 ? 0 : v > PACK_MAX ? PACK_MAX : v;
+}
+
+u16 PkbnPack_Total(u16 move)
+{
+    s32 i, n = 0;
+    for (i = 0; i < PACK_LETTERS; i++)
+        n += PkbnPack_Get(move, i);
+    return n;
+}
+
+void PkbnPack_SetGranted(u16 move)
+{
+    if (move < MOVES_COUNT)
+        sSave.granted[move / 8] |= 1 << (move % 8);
+}
+
+static void GrantLearned(u16 move)
+{
+    if (move == MOVE_NONE || move >= MOVES_COUNT || !PkbnFolder_MoveIsChip(move))
+        return;
+    if (sSave.granted[move / 8] & (1 << (move % 8)))
+        return;
+    sSave.granted[move / 8] |= 1 << (move % 8);
+    PkbnPack_Add(move, gPkbnMoveInfo[move].lanes[0], 1); // design 08 §11.4: learning gives 1 copy, first code
+}
+
+// "Learning a move gives one copy": every move any owned Pokémon knows, once per move. Scanning instead of
+// hooking every learn path (level-up, TM, tutor, eggs, trades, gifts) catches them all.
+void PkbnPack_SyncLearned(void)
+{
+    s32 i, j, m;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            for (m = 0; m < MAX_MON_MOVES; m++)
+                GrantLearned(GetMonData(&gPlayerParty[i], MON_DATA_MOVE1 + m));
+    for (i = 0; i < TOTAL_BOXES_COUNT; i++)
+        for (j = 0; j < IN_BOX_COUNT; j++)
+            if (GetBoxMonDataAt(i, j, MON_DATA_SPECIES) && !GetBoxMonDataAt(i, j, MON_DATA_IS_EGG))
+                for (m = 0; m < MAX_MON_MOVES; m++)
+                    GrantLearned(GetBoxMonDataAt(i, j, MON_DATA_MOVE1 + m));
+}
+
+u16 PkbnCandy_Get(u8 type)
+{
+    return type < NUMBER_OF_MON_TYPES ? sSave.candy[type] : 0;
+}
+
+void PkbnCandy_Add(u8 type, s32 n)
+{
+    s32 v;
+    if (type >= NUMBER_OF_MON_TYPES)
+        return;
+    v = sSave.candy[type] + n;
+    sSave.candy[type] = v < 0 ? 0 : v > CANDY_MAX ? CANDY_MAX : v;
+}
+
 #endif // PORTABLE
