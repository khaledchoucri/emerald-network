+            folder->chips[j] = folder->chips[j - 1], key[j] = key[j - 1];
+            folder->chips[j - 1] = t, key[j - 1] = kt;
+        }
+    for (i = 0; i < folder->count; i++)
+        folder->pile[i] = i;
