+            for (l = 0; l < 32; l++)
+                if (info->lanes[l % info->laneCount] == c->letter && seen-- == 0)
+                    break;
+        }
+        key[i] = (k << 8) | l;
+    }
+    for (i = 1; i < folder->count; i++)   // stable insertion sort; equal keys keep their order
+        for (j = i; j > 0 && key[j - 1] > key[j]; j--)
