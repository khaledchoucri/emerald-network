+// Type candy for a catch (design 10 §10.1, TUNE): 1 + (255 - catchRate) / 50 of each of its types (catchRate from
+// gSpeciesInfo, so common Pokémon pay least), x3 the first time the species is caught.
+static void GrantCatchCandy(u16 species, bool8 first)
+{
+    const struct SpeciesInfo *si = &gSpeciesInfo[species];
+    u8 n = 1 + (255 - si->catchRate) / 50;
+    char t1[16], t2[16];
+    if (first)
+        n *= 3;
+    PkbnCandy_Add(si->types[0], n);
+    Pkbn_GameStringToAscii(t1, gTypeNames[si->types[0]], sizeof(t1));
+    if (si->types[1] != si->types[0])
+    {
+        PkbnCandy_Add(si->types[1], n);
+        Pkbn_GameStringToAscii(t2, gTypeNames[si->types[1]], sizeof(t2));
+        snprintf(sPB.candyMsg, sizeof(sPB.candyMsg), "GOT %u %s CANDY AND %u %s CANDY!", n, t1, n, t2);
+    }
+    else
+        snprintf(sPB.candyMsg, sizeof(sPB.candyMsg), "GOT %u %s CANDY!", n, t1);
+    PKBN_LOG("candy: %s (first catch %d, catch rate %u)", sPB.candyMsg, first, si->catchRate);
+}
