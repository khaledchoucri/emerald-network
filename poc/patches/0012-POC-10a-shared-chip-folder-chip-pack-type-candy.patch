diff --git a/include/pkbn/chip_pack.h b/include/pkbn/chip_pack.h
new file mode 100644
index 0000000..71e1713
--- /dev/null
+++ b/include/pkbn/chip_pack.h
@@ -0,0 +1,36 @@
+#ifndef GUARD_PKBN_CHIP_PACK_H
+#define GUARD_PKBN_CHIP_PACK_H
+
+// Chip pack and type candy (POC-10). docs/design/08-folder-memory.md §11-12, docs/design/10-catching-and-chips.md §10.
+//  - The pack holds chip copies per (move, code letter), like BN6's pack (max 99 each). Stored in pkbn.sav (v2).
+//  - A chip is a MOVE: whoever is in battle may use it if its species can learn the move (src/pkbn/chip_data.c)
+//    or already knows it.
+//  - Learning a move (any way) gives 1 copy with the move's first code, once per move (PkbnPack_SyncLearned).
+#include "global.h"
+#include "battle.h"
+#include "pkbn/folder.h"
+#include "pkbn/chip_data.h"
+
+#define PACK_LETTERS 27          // A..Z + * (LETTER_WILD)
+#define PACK_MAX     99          // BN6 pack cap per chip/code
+#define CANDY_MAX    9999
+#define PKBN_FOLDER_SLOTS FOLDER_MAX
+
+u8 PkbnPack_Get(u16 move, u8 letter);
+void PkbnPack_Add(u16 move, u8 letter, s32 n);
+u16 PkbnPack_Total(u16 move);
+void PkbnPack_SyncLearned(void);
+void PkbnPack_SetGranted(u16 move);
+// Self-tests: the pre-POC-10 folder order (party slot, move slot, copy) so scripted picks keep their meaning.
+void PkbnFolder_SortForTests(struct Folder *folder, const struct BattlePokemon *party, u8 partyCount);
+u16 PkbnCandy_Get(u8 type);
+void PkbnCandy_Add(u8 type, s32 n);
+
+// Chips (src/pkbn/folder.c)
+u8 Chip_MB(u16 move);
+u8 Chip_CopyCap(u16 move);                 // BN6: <=19 MB -> 5, 20-29 -> 4, 30-39 -> 3, 40-49 -> 2, else 1
+bool8 Chip_SpeciesCanLearn(u16 species, u16 move);
+bool8 Chip_CanUse(const struct BattlePokemon *bm, u16 move);   // can learn it, or knows it
+u8 Chip_FolderSize(u8 partyCount);         // 30 + 2 per extra Pokémon (design 08 §11.1)
+
+#endif // GUARD_PKBN_CHIP_PACK_H
diff --git a/include/pkbn/folder.h b/include/pkbn/folder.h
index a6e36e8..98737ba 100644
--- a/include/pkbn/folder.h
+++ b/include/pkbn/folder.h
@@ -1,7 +1,12 @@
 #ifndef GUARD_PKBN_FOLDER_H
 #define GUARD_PKBN_FOLDER_H
 
-// Chip folder built from the party (docs/design/01-folder-and-switching.md, decisions of 2026-10-04,
+// POC-10 (design 08 §11-12): ONE shared folder of move chips built from the chip pack (include/pkbn/chip_pack.h).
+// A chip is a move: whoever is in battle uses it if its species can learn it. Chips no longer switch Pokémon in
+// (owner = CHIP_SHARED; partner chips come later). Copies are the stamina: no PP is spent, and a used chip is gone
+// for the battle unless the folder is under FOLDER_RESHUFFLE_BELOW chips. Folder size 30 + 2 per extra Pokémon.
+//
+// Before POC-10 (kept for history): chip folder built from the party (docs/design/01-folder-and-switching.md, decisions of 2026-10-04,
 // and the lane review of the same day):
 //  - 30 chips max (BN6 folder size). Move chips for every party member, copies by the move's max PP
 //    (>=30 -> 3, >=15 -> 2, else 1). Moves cut by the review (laneCount 0) never become chips.
@@ -15,7 +20,9 @@
 //  - Hand of 5 (BN). Used chips go to a discard pile that is reshuffled when the draw pile is empty
 //    (our change: BN never reshuffles, but early-game folders are tiny).
 
-#define FOLDER_MAX 30
+#define FOLDER_MAX 40   // 30 + 2 per extra party Pokémon (design 08 §11.1)
+#define FOLDER_RESHUFFLE_BELOW 15   // small early folders still reshuffle (design 08 §11.4)
+#define CHIP_SHARED 0xFF
 #define HAND_SIZE 5   // BN's base hand
 #define HAND_MAX 8    // with Custom programs (BN6 caps the Custom level at 8)
 #define PKBN_PARTY_MAX 6
@@ -23,8 +30,8 @@
 
 struct FolderChip
 {
-    u8 owner;   // party slot that knows the move
-    u8 slot;    // move slot
+    u8 owner;   // CHIP_SHARED (POC-10); a party slot for partner chips (later)
+    u8 slot;    // unused for shared chips
     u16 move;
     u8 letter;  // 0..25 = A..Z, LETTER_WILD = *
 };
