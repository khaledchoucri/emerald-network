+// ---- Program Advances ---------------------------------------------------------------------
+// Three chips whose moves are a recipe, consecutive and in order in one Custom selection, become
+// one brand-new move (design 03/04; recipes in tools/lanes_curated.py). BN6 forms a PA the same way
+// at the Custom screen; its recipe table isn't decoded in bn6f yet, so the trigger rule is ours.
+static s8 FindPA(const u8 *q, u8 n, u8 *at)
+{
+    s32 i, p;
+    for (i = 0; i + 2 < n; i++)
+    {
+        if (q[i] >= QUEUE_PA_BASE || q[i + 1] >= QUEUE_PA_BASE || q[i + 2] >= QUEUE_PA_BASE)
+            continue;
+        for (p = 0; p < PKBN_PA_COUNT; p++)
+        {
+            const u16 *r = gPkbnProgramAdvances[p].recipe;
+            if (sB.folder.chips[q[i]].move == r[0] && sB.folder.chips[q[i + 1]].move == r[1]
+             && sB.folder.chips[q[i + 2]].move == r[2])
+            {
+                *at = i;
+                return p;
+            }
+        }
+    }
+    return -1;
+}
+
+static void UpdatePAPreview(void)
+{
+    u8 at;
+    s8 p = FindPA(sB.queue, sB.queueCount, &at);
+    if (p >= 0)
+        snprintf(sB.paPreview, sizeof(sB.paPreview), "%s", gPkbnProgramAdvances[p].name);
+    else
+        sB.paPreview[0] = '\0';
+}
+
+static void FormProgramAdvances(void)
+{
+    u8 at;
+    s8 p;
+    while (sB.paCount < ARRAY_COUNT(sB.paQueue) && (p = FindPA(sB.queue, sB.queueCount, &at)) >= 0)
+    {
+        s32 i;
+        u8 k = sB.paCount++;
+        char line[40];
+        sB.paQueue[k].pa = p;
+        for (i = 0; i < 3; i++)
+        {
+            sB.paQueue[k].chips[i] = sB.queue[at + i];
+            PkbnFolder_Discard(&sB.folder, sB.queue[at + i]);
+        }
+        sB.queue[at] = QUEUE_PA_BASE + k;
+        for (i = at + 1; i + 2 < sB.queueCount; i++)
+            sB.queue[i] = sB.queue[i + 2];
+        sB.queueCount -= 2;
+        snprintf(line, sizeof(line), "PROGRAM ADVANCE! %s", gPkbnProgramAdvances[p].name);
+        Flash(line, 120);
+        PlaySE(SE_EXP_MAX);
+        PKBN_LOG("Program Advance formed: %s", gPkbnProgramAdvances[p].name);
+    }
+}
