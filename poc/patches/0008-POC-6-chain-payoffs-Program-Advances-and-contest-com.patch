+// Use a move from this Custom's chain. A contest combo with the previous chip pays off (design 03 §4).
+static void ChainUse(u16 move, u8 slot)
+{
+    struct Fighter *p = &sB.f[SIDE_PLAYER];
+    if (sB.chainPrev != MOVE_NONE && AreMovesContestCombo(sB.chainPrev, move))
+    {
+        char a[16], b[16], line[40];
+        Pkbn_GameStringToAscii(a, gMoveNames[sB.chainPrev], sizeof(a));
+        Pkbn_GameStringToAscii(b, gMoveNames[move], sizeof(b));
+        snprintf(line, sizeof(line), "COMBO! %s>%s", a, b);
+        Flash(line, 90);
+        PlaySE(SE_SUCCESS);
+        sB.nextCombo = TRUE; // read by Moves_Use
+        PKBN_LOG("contest combo: %s -> %s (rewards 0x%x)", a, b, sB.comboMask);
+    }
+    sB.chainPrev = move;
+    if (!TryTeleportEscape(SIDE_PLAYER, move))
+        Moves_Use(SIDE_PLAYER, move, slot, &p->bm, p->name, sB.active);
+    sB.nextCombo = FALSE;
+}
+
+static bool8 PAChipsHavePP(u8 k)
+{
+    s32 i;
+    for (i = 0; i < 3; i++)
+    {
+        const struct FolderChip *c = &sB.folder.chips[sB.paQueue[k].chips[i]];
+        const struct BattlePokemon *b = (c->owner == sB.active) ? &sB.f[SIDE_PLAYER].bm : &sB.party[c->owner].bm;
+        if (b->pp[c->slot] == 0)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static void SpendPAChips(u8 k)
+{
+    s32 i;
+    for (i = 0; i < 3; i++)
+    {
+        const struct FolderChip *c = &sB.folder.chips[sB.paQueue[k].chips[i]];
+        struct BattlePokemon *b = (c->owner == sB.active) ? &sB.f[SIDE_PLAYER].bm : &sB.party[c->owner].bm;
+        if (b->pp[c->slot])
+            b->pp[c->slot]--;
+    }
+}
