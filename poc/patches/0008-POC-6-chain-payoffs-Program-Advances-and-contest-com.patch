+// ---- Chain payoffs -----------------------------------------------------------------------------
+
+// Combo panel reward: the follow-up's type changes the panel it lands on, using the BN6 panel types.
+void Moves_ComboPanel(u8 type, s8 x, s8 y)
+{
+    u8 panel;
+    if (!InGrid(x, y) || sB.panel[y][x] == PANEL_BROKEN)
+        return;
+    switch (type)
+    {
+    case TYPE_GROUND: case TYPE_ROCK: case TYPE_FIGHTING: panel = PANEL_CRACKED; break; // quakes and blows crack it
+    case TYPE_POISON: case TYPE_BUG:                      panel = PANEL_POISON; break;
+    case TYPE_GRASS:                                      panel = PANEL_GRASS; break;
+    case TYPE_ICE: case TYPE_WATER:                       panel = PANEL_ICE; break;    // BN6 ice panel: you slide
+    case TYPE_PSYCHIC: case TYPE_NORMAL:                 panel = PANEL_HOLY; break;
+    default: return; // Fire, Electric, Flying, Dark, Ghost, Dragon, Steel: no panel of their own in BN6
+    }
+    Field_SetPanel(x, y, panel);
+    FlashPanel(x, y, 10);
+    PKBN_LOG("combo panel %u at (%d,%d)", panel, x, y);
+}
+
+// A Program Advance: a brand-new move made from three chips (tools/attacks_curated.py PA_EFFECTS).
+void Moves_UsePA(u8 side, u8 paIndex, const struct BattlePokemon *user, const char *userName, u8 userSlot)
+{
+    const struct PkbnProgramAdvance *pa = &gPkbnProgramAdvances[paIndex];
+    struct Fighter *me = &sB.f[side];
+    struct Attack *a;
+
+    sB.nextCombo = FALSE;
+    if (!Field_CanAct(side, TRUE))
+    {
+        me->lockout = CHIP_LOCKOUT;
+        return;
+    }
+    PKBN_LOG("%s unleashes PROGRAM ADVANCE %s (%s, type %u, power %u)", userName, pa->name, gPkbnKindNames[pa->kind],
+             pa->type, pa->power);
+    a = NewAttack();
+    if (a == NULL)
+        return;
+    a->side = side;
+    a->move = pa->recipe[2];
+    a->info = gPkbnMoveInfo[a->move];
+    a->info.rows = pa->rows;
+    a->info.hits = pa->hits;
+    a->info.windup = 0;          // e.g. Mega Solar Beam: no charge
+    a->info.flags = (pa->flags & PAF_FAST) ? GF_FAST : 0;
+    a->kind = pa->kind;
+    a->pa = paIndex + 1;
+    a->powerOverride = pa->power;
+    a->typeOverride = pa->type + 1;
+    a->user = *user;
+    a->userSlot = userSlot;
+    strncpy(a->userName, userName, sizeof(a->userName) - 1);
+    me->lockout = CHIP_LOCKOUT;
+    me->lastMove = a->move;
+    me->lastKind = a->kind;
+    a->phase = PH_CHARGE;
+    a->timer = 0;
+    UpdateAttack(a);
+}
+
 #endif // PORTABLE
