+// Double battles (POC-13): the trainer whose Pokémon fainted sends out their next one into that spot (two trainers:
+// each from their own half of gEnemyParty, as CreateNPCTrainerParty laid them out). FALSE if they have none left.
+static bool8 SendOutReplacement(u8 k)
+{
+    u8 from = 0, to = PARTY_SIZE, i;
+    char nm[16], mon[16];
+    u16 trainer = gTrainerBattleOpponent_A;
+    if (gBattleTypeFlags & BATTLE_TYPE_TWO_OPPONENTS)
+    {
+        if (sB.foeSlot[k] >= PARTY_SIZE / 2)
+            from = PARTY_SIZE / 2, trainer = gTrainerBattleOpponent_B;
+        else
+            to = PARTY_SIZE / 2;
+    }
+    for (i = from; i < to; i++)
+        if (!(sB.enemyUsed & (1 << i)) && GetMonData(&gEnemyParty[i], MON_DATA_SPECIES) != SPECIES_NONE
+         && GetMonData(&gEnemyParty[i], MON_DATA_HP) > 0)
+            break;
+    if (i >= to)
+        return FALSE;
+    {
+        s8 x = sB.f[SIDE_ENEMY].x, y = sB.f[SIDE_ENEMY].y;
+        LoadEnemy(&gEnemyParty[i]);
+        sB.f[SIDE_ENEMY].x = x;
+        sB.f[SIDE_ENEMY].y = y;
+        if (!Field_CanStand(SIDE_ENEMY, x, y))
+        {
+            s32 r, c;
+            for (r = 0; r < GRID_ROWS; r++)
+                for (c = PLAYER_COLS; c < GRID_COLS; c++)
+                    if (Field_CanStand(SIDE_ENEMY, c, r))
+                        sB.f[SIDE_ENEMY].x = c, sB.f[SIDE_ENEMY].y = r;
+        }
+    }
+    sB.foeSlot[k] = i;
+    sB.enemySlot = i;
+    sB.foeDown[k] = FALSE;
+    sB.enemyUsed |= 1 << i;
+    sB.aiAttackTimer = 90;
+    sB.f[SIDE_ENEMY].iframes = SWITCH_IFRAMES;
+    Field_OnEntry(SIDE_ENEMY);
+    Pkbn_GameStringToAscii(nm, gTrainers[trainer].trainerName, sizeof(nm));
+    Pkbn_GameStringToAscii(mon, gSpeciesNames[sB.f[SIDE_ENEMY].bm.species], sizeof(mon));
+    {
+        char line[40];
+        snprintf(line, sizeof(line), "%s SENT OUT %s!", nm, mon);
+        SetMsg(line, 70);
+        PKBN_LOG("%s", line);
+    }
+    PlaySE(SE_FAINT);
+    return TRUE;
+}
