+// ---- Wild Pokémon patterns (POC-13, our design - TUNE) ----------------------------------------------------------
+// BN viruses each have a pattern: Mettaurs track your row, Canodumbs sit at the back and fire. A wild Pokémon gets one
+// from its own base stats (gSpeciesInfo):
+//   HARASSER  fast (Speed is its best stat, or 90+): hugs the front column on your row, steps and attacks often,
+//             dodges more, likes priority moves
+//   BRUISER   physical hitter (Attack is its best stat): walks to the front on your row, likes swords and dashes
+//   SNIPER    special hitter (Sp. Atk is its best stat): middle column on your row, likes cannons, waves and balls
+//   TURRET    slow and bulky (Speed 45 or less, HP/Def/SpDef 80+): back column, rarely moves, likes bombs and
+//             attacks that land wherever you stand; dodges less
+//   BALANCED  the rest: wanders like before, one panel at a time
+static u8 StyleOf(u16 species)
+{
+    const struct SpeciesInfo *s = &gSpeciesInfo[species];
+    u8 best = s->baseAttack;
+    if (s->baseSpAttack > best) best = s->baseSpAttack;
+    if (s->baseSpeed >= 90 || (s->baseSpeed > best && s->baseSpeed >= s->baseDefense))
+        return STYLE_HARASSER;
+    if (s->baseSpeed <= 45 && (s->baseHP >= 80 || s->baseDefense >= 80 || s->baseSpDefense >= 80))
+        return STYLE_TURRET;
+    if (s->baseAttack >= s->baseSpAttack + 10)
+        return STYLE_BRUISER;
+    if (s->baseSpAttack >= s->baseAttack + 10)
+        return STYLE_SNIPER;
+    return STYLE_BALANCED;
+}
+
+static const char *const sStyleNames[STYLE_COUNT] = { "-", "BALANCED", "HARASSER", "BRUISER", "SNIPER", "TURRET" };
+// per style: step interval %, attack interval %, dodge %
+static const u8 sStyleStep[STYLE_COUNT]   = { 100, 100,  55,  80, 100, 250 };
+static const u8 sStyleAttack[STYLE_COUNT] = { 100, 100,  80, 100, 100, 110 };
+static const u8 sStyleDodge[STYLE_COUNT]  = { 100, 100, 130, 100, 100,  50 };
+
+static bool8 StyleLikes(u8 style, u16 move)
+{
+    u8 k = Moves_KindOf(move);
+    switch (style)
+    {
+    case STYLE_HARASSER: return gBattleMoves[move].priority > 0 || k == GK_DASH || k == GK_SWORD;
+    case STYLE_BRUISER:  return k == GK_SWORD || k == GK_LONGSWORD || k == GK_WIDESWORD || k == GK_LIFESWORD || k == GK_DASH
+                             || k == GK_LINE3 || k == GK_CONE;
+    case STYLE_SNIPER:   return k == GK_CANNON || k == GK_AIRSHOT || k == GK_VULCAN || k == GK_SPREADER || k == GK_WAVE
+                             || k == GK_SHOCKWAVE || k == GK_BALL;
+    case STYLE_TURRET:   return k == GK_BOMB || k == GK_FIREHIT || k == GK_GOLEMHIT || k == GK_METEORS || k == GK_LOCKON
+                             || k == GK_FIELD || Moves_IsPositionFree(k);
+    }
+    return FALSE;
+}
+
+// One step of the pattern: toward the style's column and (most styles) the player's row; 1 in 4 a random step.
+static void StyleStep(struct Fighter *e)
+{
+    static const s8 sCol[STYLE_COUNT] = { 0, 4, 3, 3, 4, 5 };
+    const struct Fighter *p = &sB.f[SIDE_PLAYER];
+    s8 gx = sCol[e->style], gy = (e->style == STYLE_TURRET || e->style == STYLE_BALANCED) ? (s8)(Random() % GRID_ROWS) : p->y;
+    s8 nx = e->x, ny = e->y;
+    if (e->style == STYLE_BALANCED || Random() % 4 == 0)
+    {
+        gx = PLAYER_COLS + Random() % (GRID_COLS - PLAYER_COLS);
+        gy = Random() % GRID_ROWS;
+    }
+    if (gy != e->y && Field_CanStand(SIDE_ENEMY, e->x, e->y + (gy > e->y ? 1 : -1)))
+        ny = e->y + (gy > e->y ? 1 : -1);
+    else if (gx != e->x && Field_CanStand(SIDE_ENEMY, e->x + (gx > e->x ? 1 : -1), e->y))
+        nx = e->x + (gx > e->x ? 1 : -1);
+    if (nx != e->x || ny != e->y)
+        Field_Step(SIDE_ENEMY, nx, ny);
+}
