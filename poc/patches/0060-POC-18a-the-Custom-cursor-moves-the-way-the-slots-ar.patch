+// POC-18a: the Custom cursor moves the way the slots are drawn (grid_draw.c DrawSlots). Row 0: hand chips 0-4. Row 1:
+// the Custom-program chips 5-7, the wildcard Switch, the Poké Ball (1-3 slots wide) and OK when it fits.
+// Cursor values: a hand chip, handCount = Switch, handCount + 1 = ball, handCount + 2 = OK.
+#define CUS_SLOT_W 24
+#define CUS_WIDTH  132
+static s32 CusExtra(void)
+{
+    return sB.handSize > HAND_SIZE ? sB.handSize - HAND_SIZE : 0;
+}
+
+static s32 CusBallW(void)
+{
+    s32 w = 3 - CusExtra();
+    return w < 1 ? 1 : w;
+}
+
+bool8 PkbnGrid_CustomOkShown(void)
+{
+    return 6 + (CusExtra() + 1 + CusBallW()) * CUS_SLOT_W + CUS_SLOT_W <= CUS_WIDTH;
+}
+
+// The cell a cursor value sits on: its row and the middle of it in half-slot units. FALSE if there's nothing there.
+static bool8 CustomCell(u8 idx, s8 *row, s16 *mid)
+{
+    s32 extra = CusExtra();
+    if (idx < sB.handCount)
+    {
+        if (idx < HAND_SIZE)
+            *row = 0, *mid = idx * 2 + 1;
+        else
+            *row = 1, *mid = (idx - HAND_SIZE) * 2 + 1;
+        return TRUE;
+    }
+    *row = 1;
+    if (idx == sB.handCount)
+        *mid = extra * 2 + 1;
+    else if (idx == sB.handCount + 1)
+        *mid = (extra + 1) * 2 + CusBallW();
+    else if (idx == sB.handCount + 2 && PkbnGrid_CustomOkShown())
+        *mid = (extra + 1 + CusBallW()) * 2 + 1;
+    else
+        return FALSE;
+    return TRUE;
+}
+
+// Left/Right: the next cell along the row (wrapping). Up/Down: the other row's cell nearest above or below.
+static void MoveCustomCursor(u16 keys)
+{
+    s8 row, r;
+    s16 mid, m;
+    u8 i, best = sB.cursor, n = sB.handCount + 3;
+    s32 bestD = 0x7FFF;
+    if (!CustomCell(sB.cursor, &row, &mid))
+    {
+        sB.cursor = sB.handCount ? 0 : sB.handCount;   // off the board (the hand shrank): back to the first slot
+        PlaySE(SE_SELECT);
+        return;
+    }
+    if (keys & (DPAD_LEFT | DPAD_RIGHT))
+    {
+        s32 dir = (keys & DPAD_RIGHT) ? 1 : -1;
+        for (i = 0; i < n; i++)
+        {
+            s32 d;
+            if (i == sB.cursor || !CustomCell(i, &r, &m) || r != row)
+                continue;
+            d = (m - mid) * dir;
+            if (d <= 0)
+                d += 64;   // wrap around the row
+            if (d < bestD)
+                bestD = d, best = i;
+        }
+    }
+    else if (keys & (DPAD_UP | DPAD_DOWN))
+    {
+        for (i = 0; i < n; i++)
+        {
+            s32 d;
+            if (!CustomCell(i, &r, &m) || r == row)
+                continue;
+            d = abs(m - mid) * 2 + (m > mid);   // ties go left
+            if (d < bestD)
+                bestD = d, best = i;
+        }
+    }
+    if (best != sB.cursor)
+    {
+        sB.cursor = best;
+        PlaySE(SE_SELECT);
+    }
+}
+
+// For the bots (bot.c, selftest.c): the key that moves the Custom cursor one step toward cursor value `target`, and the
+// next cursor value after the current one (in index order, wrapping) for bots that walk every slot.
+u16 PkbnGrid_CursorKeyToward(u8 target)
+{
+    s8 row, trow;
+    s16 mid, tmid;
+    if (!CustomCell(sB.cursor, &row, &mid) || !CustomCell(target, &trow, &tmid))
+        return DPAD_DOWN;
+    if (trow != row)
+        return row == 0 ? DPAD_DOWN : DPAD_UP;
+    return tmid > mid ? DPAD_RIGHT : DPAD_LEFT;
+}
+
+u8 PkbnGrid_CursorNext(void)
+{
+    u8 i, n = sB.handCount + 3;
+    s8 r;
+    s16 m;
+    for (i = 1; i <= n; i++)
+        if (CustomCell((sB.cursor + i) % n, &r, &m))
+            return (sB.cursor + i) % n;
+    return sB.cursor;
+}
