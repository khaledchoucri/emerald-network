     {
-        sB.ballItem = Catch_NextBall(sB.ballItem, (keys & DPAD_RIGHT) ? 1 : -1);
+        // POC-18a (Khaled): L/R change the ball; the D-pad moves the cursor
+        sB.ballItem = Catch_NextBall(sB.ballItem, (keys & R_BUTTON) ? 1 : -1);
         PlaySE(SE_SELECT);
     }
     if (sB.cursor == itemRow && (keys & A_BUTTON))
@@ -1348,17 +1464,11 @@ static void UpdateCustom(void)
         return;
     }
 
-    if (keys & DPAD_UP)
-    {
-        sB.cursor = (sB.cursor + rows - 1) % rows;
-        PlaySE(SE_SELECT);
-    }
-    if (keys & DPAD_DOWN)
-    {
-        sB.cursor = (sB.cursor + 1) % rows;
-        PlaySE(SE_SELECT);
-    }
-    if (keys & A_BUTTON)
+    if (keys & DPAD_ANY)
+        MoveCustomCursor(keys);
+    if ((keys & A_BUTTON) && sB.cursor == sB.handCount + 2)
+        keys |= START_BUTTON;   // A on OK confirms
+    else if (keys & A_BUTTON)
     {
         if (PkbnGrid_HandSelectable(sB.cursor))
         {
@@ -1392,7 +1502,7 @@ static void UpdateCustom(void)
