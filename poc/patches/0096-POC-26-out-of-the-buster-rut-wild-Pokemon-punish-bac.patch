+// Move a fighter `panels` columns along its row: dir -1 = toward its own back column, +1 = toward the foe. Stops at
+// the first panel it can't stand on. Anchored Pokémon (Ingrain, Suction Cups) and the SuprArmr program don't budge.
+// POC-26: pulls (binding moves) and the recoil bounce share this with the knock-back.
+static bool8 Shove(u8 side, s8 dir, u8 panels, bool8 quiet)
+{
+    struct Fighter *f = &sB.f[side];
+    s8 step = (side == SIDE_PLAYER) ? dir : -dir;
+    s8 ox = f->x;
+    if (f->rooted || f->bm.ability == ABILITY_SUCTION_CUPS)
+    {
+        if (!quiet)
+            SetMsg("IT ANCHORED ITSELF!", 40);
+        return FALSE;
+    }
+    if (f->navi.flags & NCPF_SUPER_ARMOR)
+        return FALSE;   // SuprArmr program: no knock-back
+    while (panels-- && Field_CanStand(side, f->x + step, f->y))
+        Field_Step(side, f->x + step, f->y);
+    if (f->x != ox)
+    {
+        Vis_Post(VEV_PUSH, side, MOVE_NONE, 0, (s8)(f->x - ox), ox, f->y);   // POC-15: the slide
+        PKBN_LOG("%s %s to (%d,%d)", f->name, dir > 0 ? "pulled in" : "knocked back", f->x, f->y);
+    }
+    return f->x != ox;
+}
+
 void Field_PushBack(u8 side, u8 panels)
+{
+    if (side == SIDE_PLAYER && !(sB.f[side].rooted || sB.f[side].bm.ability == ABILITY_SUCTION_CUPS
+                                 || (sB.f[side].navi.flags & NCPF_SUPER_ARMOR)))
+        Busting_NotePush();   // BN6 counts the push state among the busting "hits" (asm/asm00_2.s:18735)
+    Shove(side, -1, panels, FALSE);
+}
+
+// POC-26 (Khaled's picks M1/M2): binding moves drag the target toward the user; Mean Look, Block and Spider Web drag
+// it all the way to its front column.
+void Field_PullIn(u8 side, u8 panels)
+{
+    Shove(side, +1, panels, FALSE);
+}
+
+// POC-26 (M6): a recoil move bounces its user one panel back after the hit (quiet: no message, no busting push).
+void Field_Bounce(u8 side)
+{
+    Shove(side, -1, 1, TRUE);
+}
+
+// POC-26 (M3): a throw lifts the target and drops it in its back column on another row, briefly stunned. Rows are
+// tried nearest first (TUNE); if no panel is free it lands back where it was, still stunned.
+void Field_Throw(u8 side)
 {
     struct Fighter *f = &sB.f[side];
-    s8 back = (side == SIDE_PLAYER) ? -1 : 1;
+    s8 back = (side == SIDE_PLAYER) ? 0 : GRID_COLS - 1, ox = f->x, oy = f->y, d, nx = -1, ny = -1;
     if (f->rooted || f->bm.ability == ABILITY_SUCTION_CUPS)
     {
         SetMsg("IT ANCHORED ITSELF!", 40);
         return;
     }
     if (f->navi.flags & NCPF_SUPER_ARMOR)
-        return;   // SuprArmr program: no knock-back
-    if (side == SIDE_PLAYER)
-        Busting_NotePush();   // BN6 counts the push state among the busting "hits" (asm/asm00_2.s:18735)
+        return;
+    for (d = 1; d < GRID_ROWS && nx < 0; d++)
+    {
+        s8 order[2] = { (s8)(oy + d), (s8)(oy - d) };
+        s32 k;
+        if (Random() & 1)
+            order[0] = (s8)(oy - d), order[1] = (s8)(oy + d);
+        for (k = 0; k < 2 && nx < 0; k++)
+            if (order[k] >= 0 && order[k] < GRID_ROWS && Field_CanStand(side, back, order[k]))
+                nx = back, ny = order[k];
+    }
+    if (nx >= 0)
     {
-        s8 ox = f->x;
-        while (panels-- && Field_CanStand(side, f->x + back, f->y))
-            Field_Step(side, f->x + back, f->y);
-        if (f->x != ox)
-            Vis_Post(VEV_PUSH, side, MOVE_NONE, 0, (s8)(f->x - ox), ox, f->y);   // POC-15: the slide back
+        Field_Step(side, nx, ny);
+        Vis_Post(VEV_PUSH, side, MOVE_NONE, (u8)(1 + (ny - oy + 2)), (s8)(nx - ox), ox, oy);   // kind != 0: a throw
+        PKBN_LOG("%s thrown to (%d,%d)", f->name, nx, ny);
+    }
+    if (f->stun < 30)
+        f->stun = 30;   // TUNE
