 // ---- Chip pack, candy (POC-10) ------------------------------------------------------------------------------
 
+// ---- POC-26: codes unlock as you go (T3/K1) and lean toward your folder's (T2) -------------------------------------
+// The order the codes open in (TUNE): a greedy cover of the chips that early Hoenn Pokémon learn by level 25, so the
+// first six already fit three in four of them (computed from move_table.c and the level-up learnsets).
+static const char sCodeOrder[] = "AVLHGTQKYZONFUSMCEXRWPBIDJ";
+#define CODES_START 6
+#define CODES_PER_STEP 2
+static const u16 sRivalBattles[][6] = {
+    { TRAINER_BRENDAN_ROUTE_103_MUDKIP, TRAINER_BRENDAN_ROUTE_103_TREECKO, TRAINER_BRENDAN_ROUTE_103_TORCHIC,
+      TRAINER_MAY_ROUTE_103_MUDKIP, TRAINER_MAY_ROUTE_103_TREECKO, TRAINER_MAY_ROUTE_103_TORCHIC },
+    { TRAINER_BRENDAN_RUSTBORO_MUDKIP, TRAINER_BRENDAN_RUSTBORO_TREECKO, TRAINER_BRENDAN_RUSTBORO_TORCHIC,
+      TRAINER_MAY_RUSTBORO_MUDKIP, TRAINER_MAY_RUSTBORO_TREECKO, TRAINER_MAY_RUSTBORO_TORCHIC },
+    { TRAINER_BRENDAN_ROUTE_110_MUDKIP, TRAINER_BRENDAN_ROUTE_110_TREECKO, TRAINER_BRENDAN_ROUTE_110_TORCHIC,
+      TRAINER_MAY_ROUTE_110_MUDKIP, TRAINER_MAY_ROUTE_110_TREECKO, TRAINER_MAY_ROUTE_110_TORCHIC },
+    { TRAINER_BRENDAN_ROUTE_119_MUDKIP, TRAINER_BRENDAN_ROUTE_119_TREECKO, TRAINER_BRENDAN_ROUTE_119_TORCHIC,
+      TRAINER_MAY_ROUTE_119_MUDKIP, TRAINER_MAY_ROUTE_119_TREECKO, TRAINER_MAY_ROUTE_119_TORCHIC },
+    { TRAINER_BRENDAN_LILYCOVE_MUDKIP, TRAINER_BRENDAN_LILYCOVE_TREECKO, TRAINER_BRENDAN_LILYCOVE_TORCHIC,
+      TRAINER_MAY_LILYCOVE_MUDKIP, TRAINER_MAY_LILYCOVE_TREECKO, TRAINER_MAY_LILYCOVE_TORCHIC },
+};
+
+u8 PkbnCode_UnlockedCount(void)
+{
+    s32 steps = 0, i, k, n;
+    if (getenv("PKBN_CODES_ALL") != NULL)
+        return sizeof(sCodeOrder) - 1;
+    for (i = FLAG_BADGE01_GET; i <= FLAG_BADGE08_GET; i++)
+        steps += FlagGet(i) ? 1 : 0;
+    for (i = 0; i < (s32)ARRAY_COUNT(sRivalBattles); i++)
+        for (k = 0; k < 6; k++)
+            if (HasTrainerBeenFought(sRivalBattles[i][k]))
+            {
+                steps++;
+                break;
+            }
+    n = CODES_START + CODES_PER_STEP * steps;
+    return n > (s32)sizeof(sCodeOrder) - 1 ? sizeof(sCodeOrder) - 1 : n;
+}
+
+bool8 PkbnCode_Unlocked(u8 letter)
+{
+    s32 i, n;
+    if (letter == LETTER_WILD)
+        return TRUE;
+    n = PkbnCode_UnlockedCount();
+    for (i = 0; i < n; i++)
+        if (sCodeOrder[i] - 'A' == letter)
+            return TRUE;
+    return FALSE;
+}
+
+// How many chips of this code your folder has: the equipped folder, or the whole pack while the folder is auto-built.
+static u32 FolderCodeCount(u8 letter)
+{
+    u16 moves[FOLDER_MAX];
+    u8 letters[FOLDER_MAX], n = PkbnFolderEdit_Get(moves, letters), i;
+    u32 c = 0;
+    if (n > 0)
+    {
+        for (i = 0; i < n; i++)
+            c += letters[i] == letter;
+        return c;
+    }
+    {
+        u16 mv;
+        for (mv = 1; mv < MOVES_COUNT; mv++)
+            c += sSave.pack[mv][letter];
+    }
+    return c;
+}
+
+// A move none of whose codes is unlocked yet takes one of the unlocked codes instead, the same one every time for that
+// move (so its copies chain with each other). TUNE: Khaled's K1 said "*", but with 6 codes open about a third of
+// early chips would have come as * and chained with anything.
+u8 PkbnCode_Substitute(u16 move)
+{
+    u8 n = PkbnCode_UnlockedCount();
+    return (u8)(sCodeOrder[(move * 7) % n] - 'A');
+}
+
+u8 PkbnCode_FitStable(u16 move, u8 letter)
+{
+    const struct PkbnMoveInfo *info;
+    u8 i;
+    if (move == MOVE_NONE || move >= MOVES_COUNT || PkbnCode_Unlocked(letter))
+        return letter;
+    info = &gPkbnMoveInfo[move];
+    for (i = 0; i < info->laneCount; i++)
+        if (PkbnCode_Unlocked(info->lanes[i]))
+            return info->lanes[i];
+    return PkbnCode_Substitute(move);
+}
+
+u8 PkbnCode_Fit(u16 move, u8 letter)
+{
+    const struct PkbnMoveInfo *info;
+    u8 allowed[4], na = 0, i;
+    if (move == MOVE_NONE || move >= MOVES_COUNT || letter == LETTER_WILD)
+        return letter;   // a * stays a * (rare drops, shiny catches)
+    info = &gPkbnMoveInfo[move];
+    for (i = 0; i < info->laneCount; i++)
+        if (PkbnCode_Unlocked(info->lanes[i]))
+            allowed[na++] = info->lanes[i];
+    if (na == 0)
+        allowed[na++] = PkbnCode_Substitute(move);   // every code it comes in is still locked
+    if (na > 1 && (Random() & 1))
+    {
+        // T2: the allowed code your folder already has the most of
+        u8 best = allowed[0];
+        u32 bestN = FolderCodeCount(best);
+        for (i = 1; i < na; i++)
+            if (FolderCodeCount(allowed[i]) > bestN)
+                bestN = FolderCodeCount(allowed[i]), best = allowed[i];
+        if (bestN > 0)
+            return best;
+    }
+    if (letter == LETTER_WILD || PkbnCode_Unlocked(letter))
+        return letter;
+    return allowed[Random() % na];
+}
+
