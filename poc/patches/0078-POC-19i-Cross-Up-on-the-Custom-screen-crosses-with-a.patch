+// POC-19i: the Cross window over the art box - the Pokémon in + a benched one = the type it takes (no words).
+static void DrawCrossWindow(u16 *fb, u32 t)
+{
+    u8 slot = sB.crossOpts[sB.crossCursor], type = PkbnGrid_CrossTypeOf(slot);
+    const struct PartyMember *pm = &sB.party[slot];
+    struct PkbnImage icon = Gfx_TypeIcon(type);
+    s32 cx = ART_X + ART_W / 2, y = ART_Y + ART_H + 3;
+    DrawArtBackground(fb, Vfx_TypeColor(type), t);
+    Gfx_ClipRect(ART_X, ART_Y, ART_X + ART_W, ART_Y + ART_H);
+    Pkbn_BlitIcon(fb, sB.f[SIDE_PLAYER].icon[(t / 16) & 1], cx - 52, ART_Y + 8, FALSE, 0);
+    TextBig(fb, cx - 14, ART_Y + 14, "+", COL_WHITE);
+    Pkbn_BlitIcon(fb, pm->icon[(t / 8) & 1], cx + 2, ART_Y + 8, FALSE, 0);
+    if (sB.crossCount > 1)
+    {
+        s32 b = (t / 10) & 1;
+        Text(fb, cx - 4 - b, ART_Y + 36, "<", COL_WHITE);
+        Text(fb, cx + 36 + b, ART_Y + 36, ">", COL_WHITE);
+    }
+    Gfx_Draw(fb, &icon, cx + 2, ART_Y + 40, 0, 0, 0);
+    Gfx_ClipNone();
+    Gfx_Draw(fb, &icon, ART_X, y, 0, 0, 0);
+    TextBig(fb, ART_X + 35, y - 2, "CROSS", (t & 8) ? COL_GAUGE_FULL : COL_WHITE);
+}
