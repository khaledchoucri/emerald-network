+// POC-19g: chips left (hand + draw pile) that party slot `who` can use. Copies are stamina (Khaled's note 8), so a
+// player whose Pokémon has used its chips switches to one that still has some - the bot did not, and busted for
+// half the fight (Norman: Swampert's last chip on turn 8 of 20).
+static u8 ChipsLeftFor(u8 who)
+{
+    const struct BattlePokemon *bm = who == sB.active ? &sB.f[SIDE_PLAYER].bm : &sB.party[who].bm;
+    s32 i, n = 0;
+    for (i = 0; i < sB.folder.pileCount; i++)
+    {
+        const struct FolderChip *c = &sB.folder.chips[sB.folder.pile[i]];
+        n += c->owner == CHIP_SHARED && Chip_CanUse(bm, c->move);
+    }
+    for (i = 0; i < sB.handCount; i++)
+    {
+        const struct FolderChip *c = &sB.folder.chips[sB.hand[i]];
+        n += sB.hand[i] != FOLDER_STRUGGLE && c->owner == CHIP_SHARED && Chip_CanUse(bm, c->move);
+    }
+    return n;
+}
+
+// The benched Pokémon with the most chips left (0xFF: none has any).
+static u8 BestBench(void)
+{
+    s32 i, best = 0xFF, bestN = 0;
+    for (i = 0; i < sB.partyCount; i++)
+        if (i != sB.active && PartyAlive(i))
+        {
+            s32 n = ChipsLeftFor(i);
+            if (n > bestN)
+                best = i, bestN = n;
+        }
+    return best;
+}
+
+void PkbnBot_Pick(u16 *pressed)
+{
+    u8 want = BestBench();
+    if (want != 0xFF && sB.pickPurpose != PICK_BATON && sB.pickOptions[sB.pickCursor] != want)
+        *pressed = DPAD_DOWN;
+    else
+        *pressed = A_BUTTON;
+}
