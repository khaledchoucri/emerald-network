+// ---- POC-19i: Cross (Khaled's pick: BN6's Cross, adapted) ----------------------------------------------------------
+// BN6: on the Custom screen Up opens the Cross window (CrossSelect); "Activating once lets you stay linked during a
+// battle"; a hit of the element the Cross is weak to does double damage and ends it (bn6f
+// data/textscript/TextScriptShukoCrossTut.s; CompText86D0614.s:527-958). Crosses add a matching-element chip bonus
+// (+50 attack for non-dimming chips of the Cross's element) and change the buster.
+// Ours (TUNE): you cross with a benched Pokémon - the one in takes its type for the battle: moves of that type x1.5,
+// the buster +1 level, it can use the partner's chips too (they share the folder: copies are stamina), and a
+// super-effective hit on that type does x2 and ends the Cross. Once per battle; it ends when the Pokémon leaves.
+// Unlocked with the Dynamo Badge (Wattson, the 3rd; TUNE).
+bool8 PkbnGrid_CrossUnlocked(void)
+{
+    return FlagGet(FLAG_BADGE03_GET) || getenv("PKBN_TEST_CROSS") != NULL;
+}
+
+bool8 PkbnGrid_CrossAvailable(void)
+{
+    s32 i;
+    if (!PkbnGrid_CrossUnlocked() || sB.crossUsed || sB.firstBattle || sB.f[SIDE_PLAYER].crossType)
+        return FALSE;
+    for (i = 0; i < sB.partyCount; i++)
+        if (i != sB.active && PartyAlive(i))
+            return TRUE;
+    return FALSE;
+}
+
+bool8 PkbnGrid_CrossOpen(void)
+{
+    return sB.crossOpen;
+}
+
+// The type a Cross with `slot` gives: the partner's first type the Pokémon in doesn't have (else its first).
+u8 PkbnGrid_CrossTypeOf(u8 slot)
+{
+    const struct BattlePokemon *me = &sB.f[SIDE_PLAYER].bm, *pt = &sB.party[slot].bm;
+    s32 k;
+    for (k = 0; k < 2; k++)
+        if (pt->types[k] != me->types[0] && pt->types[k] != me->types[1])
+            return pt->types[k];
+    return pt->types[0];
+}
+
+static void OpenCross(void)
+{
+    s32 i;
+    sB.crossCount = 0;
+    for (i = 0; i < sB.partyCount; i++)
+        if (i != sB.active && PartyAlive(i))
+            sB.crossOpts[sB.crossCount++] = i;
+    sB.crossCursor = 0;
+    sB.crossOpen = TRUE;
+    PlaySE(SE_WIN_OPEN);
+}
+
+static void ApplyCross(u8 slot)
+{
+    struct Fighter *p = &sB.f[SIDE_PLAYER];
+    p->crossType = PkbnGrid_CrossTypeOf(slot) + 1;
+    p->crossSlot = slot;
+    sB.crossUsed = TRUE;
+    gPkbnCross.userSpecies = p->bm.species;
+    gPkbnCross.userPid = p->bm.personality;
+    gPkbnCross.partnerSpecies = sB.party[slot].bm.species;
+    memcpy(gPkbnCross.partnerMoves, sB.party[slot].bm.moves, sizeof(gPkbnCross.partnerMoves));
+    p->hurtFlash = 24;
+    PlaySE(SE_M_DETECT);
+    PKBN_LOG("CROSS: %s takes %s's type %u", p->name, sB.party[slot].name, p->crossType - 1);
+}
+
+void PkbnGrid_EndCross(bool8 broken)
+{
+    struct Fighter *p = &sB.f[SIDE_PLAYER];
+    if (!p->crossType)
+        return;
+    p->crossType = 0;
+    memset(&gPkbnCross, 0, sizeof(gPkbnCross));
+    if (broken)
+    {
+        SetMsg("CROSS BROKE!", 50);
+        PlaySE(SE_M_BARRIER);
+        PKBN_LOG("CROSS broken: %s", p->name);
+    }
+}
+
+static void UpdateCrossWindow(u16 keys)
+{
+    if (keys & (DPAD_LEFT | DPAD_RIGHT))
+    {
+        sB.crossCursor = (sB.crossCursor + ((keys & DPAD_RIGHT) ? 1 : sB.crossCount - 1)) % sB.crossCount;
+        PlaySE(SE_SELECT);
+    }
+    else if (keys & A_BUTTON)
+    {
+        ApplyCross(sB.crossOpts[sB.crossCursor]);
+        sB.crossOpen = FALSE;
+    }
+    else if (keys & (B_BUTTON | DPAD_DOWN))
+    {
+        sB.crossOpen = FALSE;
+        PlaySE(SE_WIN_OPEN);
+    }
+}
+
 static void UpdateCustom(void)
 {
     u16 keys = gMain.newKeys;
     u8 itemRow = sB.handCount + 1;
 
+    if (sB.crossOpen)
+    {
+        UpdateCrossWindow(keys);
