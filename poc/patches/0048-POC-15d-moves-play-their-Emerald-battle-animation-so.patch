@@ -0,0 +1,17 @@
+#ifndef GUARD_PKBN_MOVE_SOUNDS_H
+#define GUARD_PKBN_MOVE_SOUNDS_H
+
+// POC-15: each move's sound effects, from Emerald's battle animation scripts (tools/gen_move_sounds.py).
+#define PKBN_MOVE_SOUNDS 14
+#define PKBN_SOUND_CRY   0xFFFF   // the user's cry (Growl, Roar, Hyper Voice...)
+
+struct PkbnMoveSound
+{
+    u8 frame;     // frames after the move starts (0 = end of list when se is 0)
+    u16 se;       // SE_* or PKBN_SOUND_CRY
+    s8 pan;       // SOUND_PAN_ATTACKER (-64) .. SOUND_PAN_TARGET (63), from the attacker's side
+};
+
+extern const struct PkbnMoveSound gPkbnMoveSounds[MOVES_COUNT][PKBN_MOVE_SOUNDS];
+
+#endif // GUARD_PKBN_MOVE_SOUNDS_H
