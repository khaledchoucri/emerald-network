     sMaxSerial = sB.attackSerial;
@@ -387,6 +398,56 @@ static void ResetVisuals(void)
 
 // How long the strike pose holds after the attack leaves (the rest of MegaMan's BN6 animation after its action frame,
 // battleSpriteMegaMan.spr: cannon 29 - 14, sword 22 - 12, throw 22 - 9 (anim 6), cast 16 - 6). POC-15.
+// ---- POC-15: each move's sounds, as Emerald's battle animation plays them (src/pkbn/move_sounds.c) ------------------
+// They start when the move is used. Emerald's animations run 1-3 seconds; ours are shorter, so a timeline longer than
+// SOUND_SPAN frames is squeezed into it (TUNE). Pans are from the attacker's side: mirrored when the foe attacks.
+
+static void ScheduleMoveSounds(u16 move, u8 side, u8 v)
+{
+    const struct PkbnMoveSound *list = gPkbnMoveSounds[move];
+    s32 i, k, last = 0;
+    if (getenv("PKBN_NO_MOVE_SOUNDS") != NULL)
+        return;
+    // a new move's sounds replace what is left of this side's last move (an Emerald animation ends before the next)
+    for (k = 0; k < MAX_PENDING_SOUNDS; k++)
+        if (sPendingSound[k].se && sPendingSound[k].side == side)
+            sPendingSound[k].se = 0;
+    m4aMPlayStop(&gMPlayInfo_SE1);   // a long sound still playing (Hyper Beam's) would block the new one
+    m4aMPlayStop(&gMPlayInfo_SE2);
+    sLastSoundMove[v] = move;
+    sLastSoundT[v] = sTick;
+    for (i = 0; i < PKBN_MOVE_SOUNDS && list[i].se; i++)
+        if (list[i].frame > last)
+            last = list[i].frame;
+    for (i = 0; i < PKBN_MOVE_SOUNDS && list[i].se; i++)
+        for (k = 0; k < MAX_PENDING_SOUNDS; k++)
+            if (sPendingSound[k].se == 0)
+            {
+                sPendingSound[k].due = sTick + (last > SOUND_SPAN ? list[i].frame * SOUND_SPAN / last : list[i].frame);
+                sPendingSound[k].se = list[i].se;
+                sPendingSound[k].pan = side == SIDE_PLAYER ? list[i].pan : (s8)-list[i].pan;
+                sPendingSound[k].species = sB.f[side].bm.species;
+                sPendingSound[k].side = side;
+                break;
+            }
+}
+
+static void PlayDueSounds(void)
+{
+    s32 k;
+    for (k = 0; k < MAX_PENDING_SOUNDS; k++)
+        if (sPendingSound[k].se && sPendingSound[k].due <= sTick)
+        {
+            if (getenv("PKBN_LOG_SOUNDS") != NULL)
+                printf("[pkbn-sound] tick %u se %u pan %d\n", (unsigned)sTick, sPendingSound[k].se, sPendingSound[k].pan);
+            if (sPendingSound[k].se == PKBN_SOUND_CRY)
+                PlayCry_Normal(sPendingSound[k].species, sPendingSound[k].pan);
+            else
+                PlaySE12WithPanning(sPendingSound[k].se, sPendingSound[k].pan);
+            sPendingSound[k].se = 0;
+        }
+}
+
 static u8 PoseHold(u8 kind)
 {
     switch (kind)
@@ -1447,11 +1508,15 @@ void Draw_Overlay(u16 *fb)
             switch (e->ev)
             {
             case VEV_USE:
+                ScheduleMoveSounds(e->move, e->side, v);
                 sWindT[v] = (u8)e->arg;
                 sPoseLen[v] = sPoseT[v] = PoseHold(e->kind);
                 Vfx_OnUse(e);
                 break;
             case VEV_LAUNCH:
+                if (sB.attacks[e->kind].move && !sB.attacks[e->kind].pa
+                 && (sLastSoundMove[v] != sB.attacks[e->kind].move || sTick - sLastSoundT[v] > 120))
+                    ScheduleMoveSounds(sB.attacks[e->kind].move, e->side, v);   // charge moves, enemy telegraphs
                 if (sB.attacks[e->kind].side == SIDE_ENEMY && sB.attacks[e->kind].kind <= GK_TORNADO
                  && sB.attacks[e->kind].phase == PH_WAIT && sB.attacks[e->kind].timer)
                 {
@@ -1493,6 +1558,7 @@ void Draw_Overlay(u16 *fb)
         }
         (void)s;
         (void)i;
+        PlayDueSounds();
         ForEachVis(VisTrack);
         Vfx_ScanImpacts();
     }
