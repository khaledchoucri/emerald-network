From 806d79ab4fc78e8eaf942852e228eb055530645a Mon Sep 17 00:00:00 2001
From: Khaled <khaledchoucri@gmail.com>
Date: Tue, 6 Oct 2026 14:18:21 +0300
Subject: [PATCH] POC-15c: chip gallery captions (PKBN_GALLERY_LABEL) and a
 warm-up before the first move, for recordings

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FbWSqvcg6G5Gpw6ynvR5tJ
---
 src/pkbn/selftest.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/pkbn/selftest.c b/src/pkbn/selftest.c
index 3eea946..07a00dc 100644
--- a/src/pkbn/selftest.c
+++ b/src/pkbn/selftest.c
@@ -22,6 +22,9 @@
 #include "pkbn/challenge.h"
 #include "pkbn/replay.h"
 #include "pkbn/folder.h"
+#include "data.h"
+#include "battle_main.h"
+#include "pkbn/gfx.h"
 #include "pkbn/render.h"
 #include "pokedex.h"
 #include "pkbn/bot.h"
@@ -201,6 +204,19 @@ static void (*sGalInner)(u16 *fb);
 static void GalleryOverlay(u16 *fb)
 {
     sGalInner(fb);
+    if (sGalIdx < sGalCount && getenv("PKBN_GALLERY_LABEL") != NULL)
+    {
+        // a caption for recordings: "12/312  EMBER  CANNON  FIRE"
+        char line[80], mv[16], ty[16];
+        u16 m = sGalMoves[sGalIdx];
+        s32 i;
+        Pkbn_GameStringToAscii(mv, gMoveNames[m], sizeof(mv));
+        Pkbn_GameStringToAscii(ty, gTypeNames[gBattleMoves[m].type], sizeof(ty));
+        snprintf(line, sizeof(line), "%u/%u  %s  %s  %s", sGalIdx + 1, sGalCount, mv, gPkbnKindNames[gPkbnMoveInfo[m].kind], ty);
+        for (i = 0; i < 14; i++)
+            Gfx_FillBlend(fb, 0, gPkbnFbH - 14 + i, gPkbnFbW, 1, PKBN_RGB(0, 0, 4), 13);
+        Pkbn_DrawEmText(fb, 4, gPkbnFbH - 15, line, PKBN_FONT_SMALL, PKBN_RGB(31, 31, 31), PKBN_RGB(2, 2, 5));
+    }
     if (sDumpDir != NULL && sGalIdx < sGalCount && sGalT > 0 && (sGalT - 1) % sDumpEvery == 0)
     {
         char path[512];
@@ -236,6 +252,14 @@ static void CB2_Gallery(void)
     }
     if (d.state != PKBN_GRID_FIGHT && sGalT == 0)
         return;
+    {
+        static u8 sWarm;
+        if (sWarm < 30)   // let the intro / Custom screen clear before the first move
+        {
+            sWarm++;
+            return;
+        }
+    }
     if (sGalT == 0)
     {
         printf("[pkbn-gallery] move %u kind %u type %u\n", sGalMoves[sGalIdx], gPkbnMoveInfo[sGalMoves[sGalIdx]].kind,
-- 
2.43.0

