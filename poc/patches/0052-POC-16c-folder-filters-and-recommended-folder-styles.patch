+// ---- POC-16c: filters ----------------------------------------------------------------------------------------------
+static bool8 Filterable(void)
+{
+    return sF.page == PAGE_FOLDER || sF.page == PAGE_PACK || sF.page == PAGE_LIBRARY || sF.page == PAGE_SHELF;
+}
+
+static bool8 CodeMatches(u16 mv, u8 letter, u8 code)
+{
+    s32 i;
+    if (sF.page != PAGE_LIBRARY)
+        return letter == code;
+    for (i = 0; i < gPkbnMoveInfo[mv].laneCount; i++)   // the Library: any code the chip comes in
+        if (gPkbnMoveInfo[mv].lanes[i] == code)
+            return TRUE;
+    return FALSE;
+}
+
+static bool8 RowMatches(u16 mv, u8 letter, u8 type, u8 code, u8 kind)
+{
+    return (type == 0xFF || gBattleMoves[mv].type == type) && (kind == 0xFF || gPkbnMoveInfo[mv].kind == kind)
+        && (code == 0xFF || CodeMatches(mv, letter, code));
+}
+
+static void RebuildMap(void)
+{
+    u16 i, n = RawCount(), mv;
+    u8 letter;
+    sF.mapCount = 0;
+    for (i = 0; i < n && sF.mapCount < ARRAY_COUNT(sF.map); i++)
+    {
+        if (Filterable())
+        {
+            RawChip(i, &mv, &letter);
+            if (!RowMatches(mv, letter, sF.fltType, sF.fltCode, sF.fltKind))
+                continue;
+        }
+        sF.map[sF.mapCount++] = i;
+    }
+}
