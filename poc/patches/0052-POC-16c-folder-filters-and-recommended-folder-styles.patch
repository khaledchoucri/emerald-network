+static void BuildWithStyle(u8 style)
+{
+    char what[48], line[64];
+    if (style == FOLDER_STYLE_BALANCED)
+    {
+        sF.edited = FALSE;
+        PkbnFolderEdit_Set(NULL, NULL, 0);
+        LoadFolder();
+        BuildGroups();
+        PlaySE(SE_SELECT);
+        Note("AUTO-BUILT FROM YOUR PACK");
+        return;
+    }
+    sF.fCount = PkbnFolder_BuildStyle(style, sF.party, sF.partyCount, sF.fMove, sF.fLetter, what, sizeof(what));
+    if (sF.fCount > sF.fMax)
+        sF.fCount = sF.fMax;
+    sF.edited = TRUE;
+    BuildGroups();
+    sF.cursor[PAGE_FOLDER] = sF.top[PAGE_FOLDER] = 0;
+    PlaySE(SE_SUCCESS);
+    if (style == FOLDER_STYLE_GYM && PkbnFolder_NextGym() >= 0)
+    {
+        char tn[16];
+        s8 g = PkbnFolder_NextGym();
+        Pkbn_GameStringToAscii(tn, gTypeNames[PkbnFolder_GymType(g)], sizeof(tn));
+        snprintf(line, sizeof(line), "VS %s (%s): %u CHIPS", Leader_Name(g), tn, sF.fCount);
+    }
+    else
+        snprintf(line, sizeof(line), "%s: %s", sStyleNames[style], what[0] ? what : "BUILT");
+    Note(line);
+    printf("[pkbn] folder style %s -> %u chips (%s)\n", sStyleNames[style], sF.fCount, line);
+}
