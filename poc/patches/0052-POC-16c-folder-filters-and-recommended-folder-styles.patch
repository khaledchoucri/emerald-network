+// ---- POC-16c: recommended folders (our design, TUNE) ---------------------------------------------------------------
+// The FOLDER screen's SELECT menu. BALANCED is the auto-build above; the others start from it with a twist and give a
+// folder you can then edit (the result goes into the folder being edited: F1, F2 and the extra folder are presets).
+
+// The Gym Leaders' types in badge order (their gyms' specialities in Emerald).
+static const u8 sGymTypes[PKBN_LEADERS] = { TYPE_ROCK, TYPE_FIGHTING, TYPE_ELECTRIC, TYPE_FIRE, TYPE_NORMAL,
+                                            TYPE_FLYING, TYPE_PSYCHIC, TYPE_WATER };
+
+s8 PkbnFolder_NextGym(void)
+{
+    s32 b;
+    for (b = 0; b < PKBN_LEADERS; b++)
+        if (!FlagGet(FLAG_BADGE01_GET + b))
+            return b;
+    return -1;
+}
+
+u8 PkbnFolder_GymType(u8 gym)
+{
+    return sGymTypes[gym & 7];
+}
+
+// Attack type vs one defending type, from Gen 3's own chart (gTypeEffectiveness, as TypeCalc reads it).
+static u8 Effectiveness(u8 atk, u8 def)
+{
+    s32 i;
+    for (i = 0; TYPE_EFFECT_ATK_TYPE(i) != TYPE_ENDTABLE; i += 3)
+    {
+        if (TYPE_EFFECT_ATK_TYPE(i) == TYPE_FORESIGHT)
+            continue;
+        if (TYPE_EFFECT_ATK_TYPE(i) == atk && TYPE_EFFECT_DEF_TYPE(i) == def)
+            return TYPE_EFFECT_MULTIPLIER(i);
+    }
+    return TYPE_MUL_NORMAL;
+}
+
+static void AddChip(struct Folder *folder, u16 mv, u8 letter, u8 size)
+{
+    s32 i, same = 0;
+    if (folder->count >= size)
+        return;
+    for (i = 0; i < folder->count; i++)
+        same += folder->chips[i].move == mv;
+    if (same >= Chip_CopyCap(mv) || !FolderClassFits(folder, mv))
+        return;
+    folder->chips[folder->count].move = mv;
+    folder->chips[folder->count].letter = letter;
+    folder->chips[folder->count].owner = CHIP_SHARED;
+    folder->chips[folder->count].slot = 0;
+    folder->count++;
+}
+
+static bool8 AnyCanUse(const struct BattlePokemon *party, u8 partyCount, u16 mv)
+{
+    s32 p;
+    for (p = 0; p < partyCount; p++)
+        if (Chip_CanUse(&party[p], mv))
+            return TRUE;
+    return FALSE;
+}
+
+u8 PkbnFolder_BuildStyle(u8 style, const struct BattlePokemon *party, u8 partyCount, u16 *moves, u8 *letters,
+                         char *what, u32 whatSize)
+{
+    struct Folder f;
+    s32 i, p, mons = 0;
+    u8 size;
+    memset(&f, 0, sizeof(f));
+    for (p = 0; p < partyCount; p++)
+        if (party[p].species != SPECIES_NONE)
+            mons++;
+    size = Chip_FolderSize(mons);
+    what[0] = '\0';
+    switch (style)
+    {
+    case FOLDER_STYLE_GYM:
+    {
+        // weigh each attack type by how it does against the next Gym Leader's type: x2 -> 2.5, x0.5 -> 0.375, x0 out
+        u8 mul[NUMBER_OF_MON_TYPES], t, def;
+        s8 gym = PkbnFolder_NextGym();
+        if (gym < 0)
+        {
+            snprintf(what, whatSize, "EVERY BADGE WON - BALANCED");
+            GreedyFill(&f, party, partyCount, size, NULL, -1);
+            break;
+        }
+        def = sGymTypes[gym];
+        for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+        {
+            u8 e = Effectiveness(t, def);
+            mul[t] = e == TYPE_MUL_SUPER_EFFECTIVE ? 40 : e == TYPE_MUL_NOT_EFFECTIVE ? 6 : e == TYPE_MUL_NO_EFFECT ? 0 : 16;
+        }
+        snprintf(what, whatSize, "VS GYM %u", gym + 1);   // the screen names the Leader and type
+        GreedyFill(&f, party, partyCount, size, mul, -1);
+        break;
+    }
+    case FOLDER_STYLE_PA:
+    {
+        // every PA whose three moves you own and someone can use: two of each, in one code they share (else *)
+        u8 formed = 0;
+        for (i = 0; i < PKBN_PA_COUNT && f.count + 6 <= size; i++)
+        {
+            const u16 *r = gPkbnProgramAdvances[i].recipe;
+            s32 k, l, code = -1;
+            for (k = 0; k < 3; k++)
+                if (!PkbnFolder_MoveIsChip(r[k]) || PkbnPack_Total(r[k]) == 0 || !AnyCanUse(party, partyCount, r[k]))
+                    break;
+            if (k < 3)
+                continue;
+            for (l = 0; l < PACK_LETTERS && code < 0; l++)
+                if (LetterLeft(&f, r[0], l) && LetterLeft(&f, r[1], l) && LetterLeft(&f, r[2], l))
+                    code = l;
+            for (k = 0; k < 3; k++)
+            {
+                s32 copies;
+                for (copies = 0; copies < 2; copies++)
+                {
+                    u8 letter = code >= 0 && LetterLeft(&f, r[k], code) ? code
+                              : LetterLeft(&f, r[k], LETTER_WILD) ? LETTER_WILD : 0xFF;
+                    if (letter == 0xFF)
+                        for (l = 0; l < PACK_LETTERS; l++)
+                            if (LetterLeft(&f, r[k], l))
+                            {
+                                letter = l;
+                                break;
+                            }
+                    if (letter != 0xFF)
+                        AddChip(&f, r[k], letter, size);
+                }
+            }
+            formed++;
+        }
+        snprintf(what, whatSize, formed ? "%u PROGRAM ADVANCE%s READY" : "NO PA YOU CAN BUILD YET", formed, formed == 1 ? "" : "S");
+        GreedyFill(&f, party, partyCount, size, NULL, -1);
+        break;
+    }
+    case FOLDER_STYLE_CODE:
+    {
+        // the code you own the most usable copies of (up to the copy caps), then everything that has it or *
+        u32 best = 0;
+        s8 code = -1;
+        s32 l;
+        u16 mv;
+        for (l = 0; l < LETTER_WILD; l++)
+        {
+            u32 n = 0;
+            for (mv = 1; mv < MOVES_COUNT; mv++)
+                if (PkbnFolder_MoveIsChip(mv) && PkbnPack_Get(mv, l) && AnyCanUse(party, partyCount, mv))
+                    n += PkbnPack_Get(mv, l) < Chip_CopyCap(mv) ? PkbnPack_Get(mv, l) : Chip_CopyCap(mv);
+            if (n > best)
+                best = n, code = l;
+        }
+        if (code >= 0)
+            snprintf(what, whatSize, "CODE %c: %u CHIPS", PkbnFolder_LetterChar(code), (unsigned)best);
+        GreedyFill(&f, party, partyCount, size, NULL, code);
+        break;
+    }
+    default:
+        GreedyFill(&f, party, partyCount, size, NULL, -1);
+        break;
+    }
+    for (i = 0; i < f.count; i++)
+        moves[i] = f.chips[i].move, letters[i] = f.chips[i].letter;
+    return f.count;
+}
