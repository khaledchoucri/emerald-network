+// The folder (design 08 §11): the edited folder when there is one (FOLDER editor, later), otherwise auto-built
+// from the pack: greedy, one copy at a time, favouring chips several party members can use and members that
+// have little so far (tools/shared_folder_sim.py's "balanced" builder). BN6 copy caps by MB.
+void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party, u8 partyCount)
+{
+    s32 i, p, mons = 0;
+    u8 size;
+
+    memset(folder, 0, sizeof(*folder));
+    for (p = 0; p < partyCount; p++)
+        if (party[p].species != SPECIES_NONE)
+            mons++;
+    size = Chip_FolderSize(mons);
+
+    {
+        // The FOLDER screen's folder: its chips in order, while the pack still has them, someone can use them, the
+        // copy caps hold and they fit (30 + 2 per extra Pokémon).
+        u16 em[PKBN_FOLDER_SLOTS];
+        u8 el[PKBN_FOLDER_SLOTS], ne = PkbnFolderEdit_Get(em, el), cnt[PACK_LETTERS];
+        if (ne > 0)
+        {
+            for (i = 0; i < ne && folder->count < size; i++)
+            {
+                s32 k, same = 0, sameCode = 0;
+                for (k = 0; k < folder->count; k++)
+                {
+                    same += folder->chips[k].move == em[i];
+                    sameCode += folder->chips[k].move == em[i] && folder->chips[k].letter == el[i];
+                }
+                for (p = 0; p < partyCount; p++)
+                    if (Chip_CanUse(&party[p], em[i]))
+                        break;
+                if (p == partyCount || same >= Chip_CopyCap(em[i]) || sameCode >= PkbnPack_Get(em[i], el[i])
+                 || !FolderClassFits(folder, em[i]))
+                    continue;
+                folder->chips[folder->count].move = em[i];
+                folder->chips[folder->count].letter = el[i];
+                folder->chips[folder->count].owner = CHIP_SHARED;
+                folder->chips[folder->count].slot = 0;
+                folder->count++;
+            }
+            (void)cnt;
+            goto shuffle;
+        }
+    }
+
+    GreedyFill(folder, party, partyCount, size, NULL, -1);
 
 shuffle:
     // Partner chips (POC-11): one per assigned slot whose Pokémon is in the party, on top of the folder size.
@@ -483,3 +524,169 @@ bool8 PkbnFolder_CanAppend(const struct Folder *folder, const u8 *queue, u8 queu
         return alive[active] && Chip_CanUse(&party[active], c->move);
