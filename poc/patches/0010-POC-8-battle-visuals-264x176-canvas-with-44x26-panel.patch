diff --git a/src/pkbn/gfx.c b/src/pkbn/gfx.c
new file mode 100644
index 0000000..684d87d
--- /dev/null
+++ b/src/pkbn/gfx.c
@@ -0,0 +1,277 @@
+// Sprite drawing for the grid battle canvas (POC-8). PC builds only. See include/pkbn/gfx.h.
+#include "global.h"
+#include "data.h"
+#include "decompress.h"
+#include "pokemon.h"
+#include "graphics.h"
+#include "pkbn/gfx.h"
+#include "pkbn/render.h"
+
+#ifdef PORTABLE
+
+#if __has_include("pkbn/bn6_gfx_data.h")
+#include "pkbn/bn6_gfx_data.h" // generated by tools/gen_bn6_gfx.py from upstream/bn6f (never committed)
+#else
+#error "include/pkbn/bn6_gfx_data.h is missing: run scripts/setup_host.sh (it runs tools/gen_bn6_gfx.py on upstream/bn6f)"
+#endif
+
+static s32 sClipBottom = 9999, sClipLeft = -9999, sClipRight = 9999, sClipTop = -9999;
+
+void Gfx_ClipRect(s32 left, s32 top, s32 right, s32 bottom)
+{
+    sClipLeft = left;
+    sClipTop = top;
+    sClipRight = right;
+    sClipBottom = bottom;
+}
+
+void Gfx_ClipNone(void)
+{
+    Gfx_ClipRect(-9999, -9999, 9999, 9999);
+}
+
+void Gfx_ClipBottom(s32 y)
+{
+    sClipBottom = y;
+}
+
+void Gfx_ClipX(s32 left, s32 right)
+{
+    sClipLeft = left;
+    sClipRight = right;
+}
+
+u16 Gfx_Blend(u16 a, u16 b, u8 amt)
+{
+    s32 r = (a & 31) + (((s32)(b & 31) - (s32)(a & 31)) * amt) / 16;
+    s32 g = ((a >> 5) & 31) + (((s32)((b >> 5) & 31) - (s32)((a >> 5) & 31)) * amt) / 16;
+    s32 bl = ((a >> 10) & 31) + (((s32)((b >> 10) & 31) - (s32)((a >> 10) & 31)) * amt) / 16;
+    return (u16)(r | (g << 5) | (bl << 10) | 0x8000);
+}
+
+static u16 Add(u16 a, u16 b)
+{
+    s32 r = (a & 31) + (b & 31), g = ((a >> 5) & 31) + ((b >> 5) & 31), bl = ((a >> 10) & 31) + ((b >> 10) & 31);
+    if (r > 31) r = 31;
+    if (g > 31) g = 31;
+    if (bl > 31) bl = 31;
+    return (u16)(r | (g << 5) | (bl << 10) | 0x8000);
+}
+
+static inline void Plot(u16 *fb, s32 x, s32 y, u16 c, u32 flags, u16 color, u8 amt)
+{
+    u16 *d;
+    if (x < 0 || y < 0 || x >= gPkbnFbW || y >= gPkbnFbH || y >= sClipBottom || y < sClipTop || x < sClipLeft || x >= sClipRight)
+        return;
+    d = &fb[y * gPkbnFbW + x];
+    if (flags & GFX_SHADOWED)
+    {
+        *d = Gfx_Blend(*d, 0x8000, 8);
+        return;
+    }
+    if (flags & GFX_SOLID)
+        c = color;
+    else if (flags & GFX_TINT)
+        c = Gfx_Blend(c, color, amt);
+    if (flags & GFX_ADD)
+        *d = Add(*d, c);
+    else if (flags & GFX_HALF)
+        *d = Gfx_Blend(*d, c | 0x8000, 8);
+    else
+        *d = c | 0x8000;
+}
+
+void Gfx_Draw(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, u32 flags, u16 color, u8 amt)
+{
+    s32 i, j;
+    s32 x0 = (flags & GFX_FLIPX) ? x - img->ox - img->w + 1 : x + img->ox;
+    s32 y0 = (flags & GFX_FLIPY) ? y - img->oy - img->h + 1 : y + img->oy;
+    for (j = 0; j < img->h; j++)
+    {
+        s32 sy = (flags & GFX_FLIPY) ? img->h - 1 - j : j;
+        for (i = 0; i < img->w; i++)
+        {
+            s32 sx = (flags & GFX_FLIPX) ? img->w - 1 - i : i;
+            u8 idx = img->px[sy * img->w + sx];
+            if (idx)
+                Plot(fb, x0 + i, y0 + j, img->pal[idx], flags, color, amt);
+        }
+    }
+}
+
+void Gfx_DrawScaled(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, s32 sx256, s32 sy256, u32 flags, u16 color, u8 amt)
+{
+    s32 i, j, w, h, x0, y0;
+    if (sx256 == 256 && sy256 == 256)
+    {
+        Gfx_Draw(fb, img, x, y, flags, color, amt);
+        return;
+    }
+    if (sx256 <= 0 || sy256 <= 0)
+        return;
+    w = img->w * sx256 / 256;
+    h = img->h * sy256 / 256;
+    // the anchor (x, y) maps to source pixel (-ox, -oy)
+    x0 = (flags & GFX_FLIPX) ? x - (img->ox + img->w) * sx256 / 256 : x + img->ox * sx256 / 256;
+    y0 = (flags & GFX_FLIPY) ? y - (img->oy + img->h) * sy256 / 256 : y + img->oy * sy256 / 256;
+    for (j = 0; j < h; j++)
+    {
+        s32 sy = j * 256 / sy256;
+        if (flags & GFX_FLIPY)
+            sy = img->h - 1 - sy;
+        for (i = 0; i < w; i++)
+        {
+            s32 sx = i * 256 / sx256;
+            u8 idx;
+            if (flags & GFX_FLIPX)
+                sx = img->w - 1 - sx;
+            if (sx < 0 || sy < 0 || sx >= img->w || sy >= img->h)
+                continue;
+            idx = img->px[sy * img->w + sx];
+            if (idx)
+                Plot(fb, x0 + i, y0 + j, img->pal[idx], flags, color, amt);
+        }
+    }
+}
+
+void Gfx_FillBlend(u16 *fb, s32 x, s32 y, s32 w, s32 h, u16 color, u8 amt)
+{
+    s32 i, j;
+    for (j = y; j < y + h; j++)
+        for (i = x; i < x + w; i++)
+            if (i >= 0 && j >= 0 && i < gPkbnFbW && j < gPkbnFbH)
+                fb[j * gPkbnFbW + i] = Gfx_Blend(fb[j * gPkbnFbW + i], color, amt);
+}
+
+void Gfx_Darken(u16 *fb, s32 x, s32 y, s32 w, s32 h, u8 amt)
+{
+    Gfx_FillBlend(fb, x, y, w, h, 0x8000, amt);
+}
+
+void Gfx_Ellipse(u16 *fb, s32 cx, s32 cy, s32 rx, s32 ry, u16 color, u8 amt)
+{
+    s32 i, j;
+    if (rx <= 0 || ry <= 0)
+        return;
+    for (j = -ry; j <= ry; j++)
+        for (i = -rx; i <= rx; i++)
+            if (i * i * ry * ry + j * j * rx * rx <= rx * rx * ry * ry)
+                Gfx_FillBlend(fb, cx + i, cy + j, 1, 1, color, amt);
+}
+
+// Emerald front pictures: anim_front.png holds two 64x64 frames (8x16 tiles), LZ77-compressed 4bpp,
+// loaded the way the battle does it (LoadSpecialPokePic: Unown letters, Spinda spots), and the palette
+// GetMonSpritePalFromSpeciesAndPersonality picks (shiny from otId/personality).
+void Gfx_LoadMonPic(struct PkbnMonPic *dst, u16 species, u32 personality, u32 otId)
+{
+    static u8 sTiles[MON_PIC_SIZE * MAX_MON_PIC_FRAMES];
+    u16 pal[16];
+    s32 f, px, py;
+
+    LoadSpecialPokePic(&gMonFrontPicTable[species], sTiles, species, personality, TRUE);
+    LZ77UnCompWram(GetMonSpritePalFromSpeciesAndPersonality(species, otId, personality), pal);
+    for (f = 0; f < 16; f++)
+        dst->pal[f] = pal[f] & 0x7FFF;
+    for (f = 0; f < 2; f++)
+    {
+        const u8 *tiles = sTiles + f * MON_PIC_SIZE;
+        for (py = 0; py < 64; py++)
+            for (px = 0; px < 64; px++)
+            {
+                s32 tile = (py / 8) * 8 + (px / 8);
+                u8 byte = tiles[tile * 32 + (py % 8) * 4 + (px % 8) / 2];
+                dst->px[f][py * 64 + px] = (px & 1) ? (byte >> 4) : (byte & 0xF);
+            }
+    }
+    dst->bottom = gMonFrontPicCoords[species].y_offset;
+}
+
+struct PkbnImage Gfx_MonImage(const struct PkbnMonPic *pic, u8 frame)
+{
+    struct PkbnImage img;
+    img.w = 64;
+    img.h = 64;
+    img.ox = -32;
+    img.oy = -(64 - pic->bottom);
+    img.px = pic->px[frame & 1];
+    img.pal = pic->pal;
+    return img;
+}
+
+// Emerald's move type icons (graphics/types/move_types.png, as the summary screen shows them): 32x16 each,
+// type t starts at tile t * 8 (ANIMCMD_FRAME(TYPE_x * 8), pokemon_summary_screen.c:774), 4x2 tiles; three
+// palettes, chosen per type by sMoveTypeToOamPaletteNum (pokemon_summary_screen.c:907, palettes 13-15).
+static const u8 sTypePal[NUMBER_OF_MON_TYPES] =
+{
+    [TYPE_NORMAL] = 0, [TYPE_FIGHTING] = 0, [TYPE_FLYING] = 1, [TYPE_POISON] = 1, [TYPE_GROUND] = 0,
+    [TYPE_ROCK] = 0, [TYPE_BUG] = 2, [TYPE_GHOST] = 1, [TYPE_STEEL] = 0, [TYPE_MYSTERY] = 2, [TYPE_FIRE] = 0,
+    [TYPE_WATER] = 1, [TYPE_GRASS] = 2, [TYPE_ELECTRIC] = 0, [TYPE_PSYCHIC] = 1, [TYPE_ICE] = 1,
+    [TYPE_DRAGON] = 2, [TYPE_DARK] = 0,
+};
+
+struct PkbnImage Gfx_TypeIcon(u8 type)
+{
+    static u8 sTiles[NUMBER_OF_MON_TYPES * 8 * 32 + 0x400];
+    static u16 sPal[3 * 16];
+    static u8 sPx[NUMBER_OF_MON_TYPES][32 * 16];
+    static bool8 sLoaded;
+    struct PkbnImage img;
+    s32 t, px, py;
+    if (!sLoaded)
+    {
+        LZ77UnCompWram(gMoveTypes_Gfx, sTiles);
+        LZ77UnCompWram(gMoveTypes_Pal, sPal);
+        for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+            for (py = 0; py < 16; py++)
+                for (px = 0; px < 32; px++)
+                {
+                    s32 tile = t * 8 + (py / 8) * 4 + (px / 8);
+                    u8 byte = sTiles[tile * 32 + (py % 8) * 4 + (px % 8) / 2];
+                    sPx[t][py * 32 + px] = (px & 1) ? (byte >> 4) : (byte & 0xF);
+                }
+        for (t = 0; t < 48; t++)
+            sPal[t] &= 0x7FFF;
+        sLoaded = TRUE;
+    }
+    if (type >= NUMBER_OF_MON_TYPES)
+        type = TYPE_MYSTERY;
+    img.w = 32;
+    img.h = 16;
+    img.ox = 0;
+    img.oy = 0;
+    img.px = sPx[type];
+    img.pal = &sPal[sTypePal[type] * 16];
+    return img;
+}
+
+const struct PkbnImage *Fx_Frame(u8 id, u32 t)
+{
+    const struct PkbnFxAnim *a = &sBn6Anims[id];
+    u32 total = Fx_Duration(id), k;
+    if (a->loop && total)
+        t %= total;
+    for (k = 0; k < a->count; k++)
+    {
+        const struct PkbnFxFrame *fr = &sBn6Frames[a->first + k];
+        if (t < fr->delay)
+            return &fr->img;
+        t -= fr->delay;
+    }
+    return &sBn6Frames[a->first + a->count - 1].img;
+}
+
+u32 Fx_Duration(u8 id)
+{
+    const struct PkbnFxAnim *a = &sBn6Anims[id];
+    u32 k, total = 0;
+    for (k = 0; k < a->count; k++)
+        total += sBn6Frames[a->first + k].delay;
+    return total;
+}
+
+bool8 Fx_Loops(u8 id)
+{
+    return sBn6Anims[id].loop;
+}
+
+#endif // PORTABLE
