index 896f084..42d7fd2 100644
--- a/include/pkbn/render.h
+++ b/include/pkbn/render.h
@@ -6,7 +6,17 @@
 
 #define PKBN_RGB(r, g, b) ((u16)(((r) & 31) | (((g) & 31) << 5) | (((b) & 31) << 10) | 0x8000))
 
-extern void (*gPkbnFrameOverlay)(u16 *pixels);
