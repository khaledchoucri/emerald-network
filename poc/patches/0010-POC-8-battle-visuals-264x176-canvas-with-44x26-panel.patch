+// GENERATED by tools/gen_fx_ids.py from tools/fx_curated.py. Names of BN6 effect sprites (bn6f category:index anim).
+#ifndef GUARD_PKBN_FX_IDS_H
+#define GUARD_PKBN_FX_IDS_H
+
+enum PkbnFxId
+{
+    FX_HIT, // bn6f 5:0x04 anim 0
+    FX_HIT_SMALL, // bn6f 5:0x05 anim 0
+    FX_HIT_STAR, // bn6f 4:0x26 anim 0
+    FX_EXPLODE, // bn6f 5:0x00 anim 0
+    FX_EXPLODE_SMALL, // bn6f 5:0x01 anim 0
+    FX_SHOT, // bn6f 3:0x06 anim 0
+    FX_CANNON, // bn6f 3:0x19 anim 1
+    FX_MUZZLE, // bn6f 5:0x0f anim 0
+    FX_SLASH, // bn6f 3:0x14 anim 0
+    FX_SLASH_WIDE, // bn6f 3:0x20 anim 0
+    FX_SLASH_WIDE2, // bn6f 4:0x3c anim 0
+    FX_SLASH_ARC, // bn6f 4:0x3b anim 0
+    FX_LONGSWORD, // bn6f 4:0x2f anim 5
+    FX_BOMB, // bn6f 3:0x24 anim 0
+    FX_FIRE_PANEL, // bn6f 4:0x02 anim 1
+    FX_FIRE_BURST, // bn6f 4:0x48 anim 0
+    FX_FIRE_TALL, // bn6f 4:0x24 anim 2
+    FX_FLAME_JET, // bn6f 4:0x1b anim 2
+    FX_FIREBALL, // bn6f 3:0x0e anim 0
+    FX_BUBBLE, // bn6f 4:0x23 anim 0
+    FX_BUBBLE_POP, // bn6f 4:0x23 anim 1
+    FX_SPLASH, // bn6f 5:0x12 anim 0
+    FX_WAVE, // bn6f 4:0x22 anim 0
+    FX_ICE, // bn6f 4:0x03 anim 0
+    FX_ICE_SPIKE, // bn6f 4:0x2c anim 0
+    FX_BOLT, // bn6f 4:0x13 anim 2
+    FX_BOLT_ORANGE, // bn6f 4:0x12 anim 1
+    FX_SPARK, // bn6f 4:0x32 anim 0
+    FX_SPARKS, // bn6f 4:0x32 anim 1
+    FX_TORNADO, // bn6f 3:0x17 anim 0
+    FX_WIND, // bn6f 4:0x41 anim 0
+    FX_ROCKS, // bn6f 4:0x30 anim 0
+    FX_ROCK, // bn6f 4:0x05 anim 0
+    FX_BOULDER, // bn6f 4:0x08 anim 0
+    FX_POISON, // bn6f 4:0x4b anim 0
+    FX_POISON2, // bn6f 5:0x11 anim 0
+    FX_SMOKE, // bn6f 5:0x02 anim 0
+    FX_DUST, // bn6f 3:0x2e anim 0
+    FX_CHARGE, // bn6f 5:0x0d anim 0
+    FX_CHARGE_RINGS, // bn6f 5:0x1b anim 0
+    FX_HEAL, // bn6f 4:0x0f anim 0
+    FX_HEAL2, // bn6f 5:0x15 anim 0
+    FX_LOCKON, // bn6f 4:0x45 anim 0
+    FX_METEOR, // bn6f 3:0x31 anim 0
+    FX_SPIKE, // bn6f 4:0x17 anim 0
+    FX_VORTEX, // bn6f 4:0x0d anim 0
+    FX_BEAM, // bn6f 4:0x20 anim 1
+    FX_CLAW, // bn6f 4:0x38 anim 0
+    FX_FANG, // bn6f 4:0x10 anim 0
+    FX_CONFUSE, // bn6f 5:0x0b anim 0
+    FX_PARALYZE, // bn6f 5:0x07 anim 0
+    FX_LEAF, // bn6f 3:0x5c anim 0
+    FX_LOGS, // bn6f 4:0x34 anim 0
+    FX_BARRIER, // bn6f 4:0x47 anim 1
+    FX_CRACK, // bn6f 5:0x03 anim 0
+    FX_COUNT
+};
+
+#endif // GUARD_PKBN_FX_IDS_H
diff --git a/include/pkbn/gfx.h b/include/pkbn/gfx.h
new file mode 100644
index 0000000..c75df3c
--- /dev/null
+++ b/include/pkbn/gfx.h
@@ -0,0 +1,75 @@
+#ifndef GUARD_PKBN_GFX_H
+#define GUARD_PKBN_GFX_H
+
+// Sprite drawing for the grid battle canvas (POC-8). PC builds only.
+// Images are 8-bit palette indices (0 = transparent) + a 16-colour BGR555 palette, so the same
+// pixels work for Emerald's 4bpp Pokémon pictures and BN6's 4bpp effect sprites.
+#include "global.h"
+#include "pkbn/fx_ids.h"
+
+struct PkbnImage
+{
+    u16 w, h;
+    s16 ox, oy;          // pixel (0,0) is drawn at (x + ox, y + oy) when not flipped
+    const u8 *px;
+    const u16 *pal;
+};
+
+struct PkbnFxFrame
+{
+    struct PkbnImage img;
+    u8 delay;            // frames this picture stays (BN6 frame delay byte)
+};
+
+struct PkbnFxAnim
+{
+    u16 first;
+    u8 count;
+    u8 loop;
+};
+
+// Emerald front picture, both frames of anim_front (2 x 64x64), decoded with its normal/shiny palette.
+struct PkbnMonPic
+{
+    u8 px[2][64 * 64];
+    u16 pal[16];
+    u8 bottom;           // first empty row from the bottom (gMonFrontPicCoords y_offset): feet line = 64 - bottom
+};
+
+// Draw flags
+#define GFX_FLIPX    (1 << 0)
+#define GFX_FLIPY    (1 << 1)
+#define GFX_TINT     (1 << 2)  // blend every pixel toward `color` by amt/16
+#define GFX_SOLID    (1 << 3)  // every pixel = `color` (silhouettes, hit flash)
+#define GFX_HALF     (1 << 4)  // 50% blend with what is behind
+#define GFX_ADD      (1 << 5)  // additive (glows)
+#define GFX_SHADOWED (1 << 6)  // darken like a cast shadow (pixels become 50% darker background)
+
+void Gfx_Draw(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, u32 flags, u16 color, u8 amt);
+// Nearest-neighbour scaled draw, scale in 1/256 units, anchored like Gfx_Draw (the anchor point stays put).
+void Gfx_DrawScaled(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, s32 sx256, s32 sy256, u32 flags, u16 color, u8 amt);
+// Rows at or below this canvas y are not drawn (sinking into the ground, Dig). Reset with Gfx_ClipBottom(9999).
+void Gfx_ClipBottom(s32 y);
+// Columns outside [left, right) are not drawn. Reset with Gfx_ClipX(-9999, 9999).
+void Gfx_ClipX(s32 left, s32 right);
+void Gfx_ClipRect(s32 left, s32 top, s32 right, s32 bottom);
+void Gfx_ClipNone(void);
+// Emerald's 32x16 move type icon (TYPE_*), anchored at its top-left corner.
+struct PkbnImage Gfx_TypeIcon(u8 type);
+
+u16 Gfx_Blend(u16 a, u16 b, u8 amt16);           // amt16 = 0 -> a, 16 -> b
+void Gfx_FillBlend(u16 *fb, s32 x, s32 y, s32 w, s32 h, u16 color, u8 amt16);
+void Gfx_Darken(u16 *fb, s32 x, s32 y, s32 w, s32 h, u8 amt16);
+void Gfx_Ellipse(u16 *fb, s32 cx, s32 cy, s32 rx, s32 ry, u16 color, u8 amt16);
+
+void Gfx_LoadMonPic(struct PkbnMonPic *dst, u16 species, u32 personality, u32 otId);
+// Image view of frame 0/1 of a loaded picture, anchored at the horizontal centre of its feet line.
+// (Built on demand so struct copies of a PkbnMonPic never point at another copy's pixels.)
+struct PkbnImage Gfx_MonImage(const struct PkbnMonPic *pic, u8 frame);
+
+// BN6 effects (tools/fx_curated.py). Frame for `t` frames after the start (loops or holds the last frame).
+const struct PkbnImage *Fx_Frame(u8 id, u32 t);
+u32 Fx_Duration(u8 id);
+bool8 Fx_Loops(u8 id);
+
+#endif // GUARD_PKBN_GFX_H
