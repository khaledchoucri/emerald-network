+// always shows this canvas at an integer scale; outside battles the GBA frame sits centred in it with a border.
+#define PKBN_CANVAS_W 264
+#define PKBN_CANVAS_H 176
+
+extern void (*gPkbnFrameOverlay)(u16 *pixels);   // draws over the 240x160 GBA frame
+extern void (*gPkbnCanvasOverlay)(u16 *canvas);  // when set, draws the whole 264x176 canvas instead
+// Size of the buffer the Pkbn_* drawing helpers clip to (set before each overlay call).
+extern s32 gPkbnFbW, gPkbnFbH;
+void Pkbn_SetTarget(s32 w, s32 h);
 
 void Pkbn_FillRect(u16 *fb, s32 x, s32 y, s32 w, s32 h, u16 color);
 void Pkbn_FrameRect(u16 *fb, s32 x, s32 y, s32 w, s32 h, u16 color);
