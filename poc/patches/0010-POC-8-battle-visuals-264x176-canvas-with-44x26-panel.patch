+#ifndef GUARD_PKBN_GRID_VFX_H
+#define GUARD_PKBN_GRID_VFX_H
+
+// Battle visual effects (POC-8): particles built from BN6 effect sprites, damage numbers, screen shake,
+// weather, the thrown ball. Visual only - nothing here changes the battle. src/pkbn/grid_vfx.c
+#include "pkbn/grid_internal.h"
+
+enum { VFX_LAYER_GROUND, VFX_LAYER_AIR, VFX_LAYER_HUD };
+
+void Vfx_Reset(void);
+void Vfx_OnLaunch(const struct Attack *a);                 // a new attack appeared
+void Vfx_OnSendOut(s32 feetX, s32 feetY);
+void Vfx_OnHpChange(u8 side, s32 delta, s32 feetX, s32 feetY);
+void Vfx_ScanImpacts(void);                                // panels hit since last frame (sB.fxSeq)
+void Vfx_BeginFrame(void);
+void Vfx_DrawLayer(u16 *fb, u8 layer);
+void Vfx_DrawAttacks(u16 *fb);                             // attacks in flight / winding up
+void Vfx_DrawWeather(u16 *fb, u32 t);
+void Vfx_EndFrame(u16 *fb);                                // screen shake
+void Vfx_DrawBall(u16 *fb, u16 ballItem, s32 x, s32 y, s32 t);
+u16 Vfx_TypeColor(u8 type);
+// Custom screen: a looping preview of the effect a move makes (centre x, y).
+void Vfx_DrawChipArt(u16 *fb, s32 x, s32 y, u16 move, u8 kind, u8 type, u32 t);
+
+// grid_draw.c
+void Draw_PanelCenter(s32 c, s32 r, s32 *x, s32 *y);
+void Draw_FeetPos(s32 c, s32 r, s32 *x, s32 *y);
+void Draw_Box(u16 *fb, s32 x, s32 y, s32 w, s32 h, u16 fill, u16 rim, u8 fillAmt);
+
+#endif // GUARD_PKBN_GRID_VFX_H
