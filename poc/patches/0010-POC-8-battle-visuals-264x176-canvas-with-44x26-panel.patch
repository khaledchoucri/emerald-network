new file mode 100644
index 0000000..dfe3506
--- /dev/null
+++ b/src/pkbn/grid_vfx.c
@@ -0,0 +1,901 @@
+// Battle visual effects (POC-8). Visual only: reads sB, never changes the battle.
+//
+// Effects are BN6 sprites (tools/fx_curated.py) chosen per attack kind and per Gen 3 type; damage numbers use
+// Emerald's font; the thrown ball is Emerald's own ball sprite (gBallSpriteSheets, pokeball.c).
+// Which effect goes with which kind/type is our choice (TUNE) - reviewable in docs/design/05-visuals.md.
+#include "pkbn/grid_vfx.h"
+#include "battle_anim.h"
+#include "decompress.h"
+#include "pokeball.h"
+#include "constants/moves.h"
+#include "constants/battle_move_effects.h"
+#include "constants/items.h"
+#include "pkbn/render.h"
+
+#ifdef PORTABLE
+
+#define CW PKBN_CANVAS_W
+#define CH PKBN_CANVAS_H
+
+// ---- type colours (approximations of Emerald's type icon colours, graphics/types/*.png) -------------------
+u16 Vfx_TypeColor(u8 type)
+{
+    switch (type)
+    {
+    case TYPE_NORMAL:   return PKBN_RGB(24, 24, 18);
+    case TYPE_FIGHTING: return PKBN_RGB(24, 8, 6);
+    case TYPE_FLYING:   return PKBN_RGB(20, 18, 31);
+    case TYPE_POISON:   return PKBN_RGB(20, 8, 22);
+    case TYPE_GROUND:   return PKBN_RGB(28, 23, 12);
+    case TYPE_ROCK:     return PKBN_RGB(23, 20, 9);
+    case TYPE_BUG:      return PKBN_RGB(21, 24, 4);
+    case TYPE_GHOST:    return PKBN_RGB(14, 11, 20);
+    case TYPE_STEEL:    return PKBN_RGB(23, 23, 26);
+    case TYPE_FIRE:     return PKBN_RGB(31, 16, 6);
+    case TYPE_WATER:    return PKBN_RGB(12, 18, 31);
+    case TYPE_GRASS:    return PKBN_RGB(14, 25, 9);
+    case TYPE_ELECTRIC: return PKBN_RGB(31, 26, 6);
+    case TYPE_PSYCHIC:  return PKBN_RGB(31, 11, 17);
+    case TYPE_ICE:      return PKBN_RGB(19, 29, 29);
+    case TYPE_DRAGON:   return PKBN_RGB(14, 7, 31);
+    case TYPE_DARK:     return PKBN_RGB(12, 9, 7);
+    }
+    return PKBN_RGB(31, 31, 31);
+}
+
+// ---- particles -----------------------------------------------------------------------------------------------
+
+#define MAX_VFX 72
+enum { P_SPRITE, P_NUMBER, P_ARROW, P_RING, P_SHOT, P_FLASH, P_BEAM, P_ORB };
+
+struct Particle
+{
+    u8 active;
+    u8 type;
+    u8 layer;
+    u8 id;           // FX_* for P_SPRITE
+    s16 x, y;        // 1/16 px
+    s16 vx, vy;      // 1/16 px per frame
+    s16 ay;          // gravity
+    u16 t, life, delay;
+    u32 flags;
+    u16 color;
+    u8 amt;
+    s16 value;       // number / arrow direction
+    u16 scale;       // 256 = 1x
+    s16 clipL, clipR; // horizontal clip in screen pixels (0, 0 = none)
+};
+
+static struct Particle sP[MAX_VFX];
+static u8 sSeenSeq[GRID_ROWS][GRID_COLS];
+static s32 sShakeT, sShakeMag;
+static s32 sFlashT;
+static u16 sFlashColor;
+static u32 sT;
+
+static struct Particle *Spawn(u8 type, u8 layer, s32 x, s32 y)
+{
+    s32 i;
+    for (i = 0; i < MAX_VFX; i++)
+        if (!sP[i].active)
+        {
+            memset(&sP[i], 0, sizeof(sP[i]));
+            sP[i].active = TRUE;
+            sP[i].type = type;
+            sP[i].layer = layer;
+            sP[i].x = x * 16;
+            sP[i].y = y * 16;
+            sP[i].scale = 256;
+            sP[i].life = 30;
+            return &sP[i];
+        }
+    return NULL;
+}
+
+// A BN6 effect sprite. life 0 = one play of the animation (loops get 24 frames).
+static struct Particle *Fx(u8 id, u8 layer, s32 x, s32 y, u32 flags, u16 color, u8 amt, u16 life)
+{
+    struct Particle *p = Spawn(P_SPRITE, layer, x, y);
+    if (p == NULL)
+        return NULL;
+    p->id = id;
+    p->flags = flags;
+    p->color = color;
+    p->amt = amt;
+    p->life = life ? life : (Fx_Loops(id) ? 24 : (u16)Fx_Duration(id));
+    return p;
+}
+
+static void Shake(s32 frames, s32 mag)
+{
+    if (frames > sShakeT)
+        sShakeT = frames;
+    if (mag > sShakeMag)
+        sShakeMag = mag;
+}
+
+static void ScreenFlash(u16 color, s32 frames)
+{
+    sFlashColor = color;
+    sFlashT = frames;
+}
+
+void Vfx_Reset(void)
+{
+    memset(sP, 0, sizeof(sP));
+    memcpy(sSeenSeq, sB.fxSeq, sizeof(sSeenSeq));
+    sShakeT = sShakeMag = sFlashT = 0;
+}
+
+// ---- what each type looks like when it lands ----------------------------------------------------------------
+
+struct TypeLook { u8 fx; u8 tinted; u8 layer; s8 dy; };
+
+static struct TypeLook TypeImpact(u8 type)
+{
+    struct TypeLook l = { FX_HIT_STAR, FALSE, VFX_LAYER_AIR, -14 };
+    switch (type)
+    {
+    case TYPE_FIGHTING: l.fx = FX_HIT; break;
+    case TYPE_FLYING:   l.fx = FX_WIND; l.dy = -16; break;
+    case TYPE_POISON:   l.fx = FX_POISON; l.dy = -14; break;
+    case TYPE_GROUND:   l.fx = FX_ROCKS; l.dy = -6; break;
+    case TYPE_ROCK:     l.fx = FX_ROCKS; l.dy = -8; break;
+    case TYPE_BUG:      l.fx = FX_HIT_SMALL; l.tinted = TRUE; break;
+    case TYPE_GHOST:    l.fx = FX_VORTEX; l.tinted = TRUE; break;
+    case TYPE_STEEL:    l.fx = FX_HIT; l.tinted = TRUE; break;
+    case TYPE_FIRE:     l.fx = FX_FIRE_BURST; l.dy = -2; break;
+    case TYPE_WATER:    l.fx = FX_WAVE; l.dy = -8; break;
+    case TYPE_GRASS:    l.fx = FX_HEAL2; l.tinted = TRUE; break;
+    case TYPE_ELECTRIC: l.fx = FX_SPARK; l.dy = -16; break;
+    case TYPE_PSYCHIC:  l.fx = FX_VORTEX; break;
+    case TYPE_ICE:      l.fx = FX_ICE_SPIKE; l.dy = -8; break;
+    case TYPE_DRAGON:   l.fx = FX_HIT; l.tinted = TRUE; break;
+    case TYPE_DARK:     l.fx = FX_CLAW; l.tinted = TRUE; break;
+    case TYPE_MYSTERY:  l.fx = FX_HIT_SMALL; break; // buster
+    }
+    return l;
+}
+
+static void TypeBurst(u8 type, s32 x, s32 y, bool8 big)
+{
+    struct TypeLook l = TypeImpact(type);
+    struct Particle *p = Fx(l.fx, l.layer, x, y + l.dy, l.tinted ? GFX_TINT : 0, Vfx_TypeColor(type), 8, 0);
+    if (p && Fx_Loops(l.fx))
+        p->life = big ? 22 : 14;
+}
+
+// ---- events ---------------------------------------------------------------------------------------------------
+
+static u8 AttackType(const struct Attack *a)
+{
+    if (a->pa)
+        return gPkbnProgramAdvances[a->pa - 1].type;
+    return a->typeOverride ? a->typeOverride : gBattleMoves[a->move].type;
+}
+
+void Vfx_OnLaunch(const struct Attack *a)
+{
+    const struct Fighter *me = &sB.f[a->side];
+    s32 x, y, ex, ey;
+    s8 dir = a->side == SIDE_PLAYER ? 1 : -1;
+    u32 flip = a->side == SIDE_PLAYER ? 0 : GFX_FLIPX;
+    u8 type = AttackType(a);
+    u16 tc = Vfx_TypeColor(type);
+    struct Particle *p;
+    Draw_FeetPos(me->x, me->y, &x, &y);
+    Draw_FeetPos(sB.f[a->side ^ 1].x, sB.f[a->side ^ 1].y, &ex, &ey);
+
+    if (a->pa)
+    {
+        // Program Advance: a flash in the type's colour and a jolt
+        ScreenFlash(Gfx_Blend(tc, PKBN_RGB(31, 31, 31), 8), 8);
+        Shake(10, 2);
+    }
+    switch (a->kind)
+    {
+    case GK_CANNON: case GK_AIRSHOT: case GK_VULCAN: case GK_SPREADER:
+        // muzzle flash and a shot that flies down the row (the hit itself is instant, BN Cannon style)
+        Fx(FX_MUZZLE, VFX_LAYER_AIR, x + dir * 22, y - 20, flip, 0, 0, 0);
+        p = Spawn(P_SHOT, VFX_LAYER_AIR, x + dir * 22, y - 20);
+        if (p)
+        {
+            p->vx = dir * 16 * 14;
+            p->life = 18;
+            p->color = tc;
+        }
+        Shake(4, 1);
+        break;
+    case GK_LINE3: case GK_CONE:
+        if (type == TYPE_FIRE)
+        {
+            // BN6's flame jet (anchored at its nozzle end, so it reaches forward)
+            p = Fx(FX_FLAME_JET, VFX_LAYER_AIR, x + dir * 14, y - 18, flip ^ GFX_FLIPX, 0, 0, 22);
+            if (p)
+            {
+                // hide BN's burner nozzle: only the flame leaves the Pokémon's mouth
+                p->clipL = dir > 0 ? x + 8 : -9999;
+                p->clipR = dir > 0 ? 9999 : x - 8;
+            }
+        }
+        break;
+    case GK_BALL: case GK_WAVE: case GK_SHOCKWAVE: case GK_AIRHOCKEY:
+        Fx(FX_MUZZLE, VFX_LAYER_AIR, x + dir * 20, y - 16, flip | GFX_TINT, tc, 6, 0);
+        break;
+    case GK_SELF:
+        if (gBattleMoves[a->move].effect == EFFECT_RESTORE_HP || gBattleMoves[a->move].effect == EFFECT_SOFTBOILED
+         || gBattleMoves[a->move].effect == EFFECT_MORNING_SUN || gBattleMoves[a->move].effect == EFFECT_SYNTHESIS
+         || gBattleMoves[a->move].effect == EFFECT_MOONLIGHT || gBattleMoves[a->move].effect == EFFECT_REST
+         || gBattleMoves[a->move].effect == EFFECT_WISH || gBattleMoves[a->move].effect == EFFECT_INGRAIN)
+            Fx(FX_HEAL, VFX_LAYER_AIR, x, y - 24, 0, 0, 0, 40);
+        else
+            Fx(FX_CHARGE_RINGS, VFX_LAYER_AIR, x, y - 18, GFX_TINT, tc, 6, 30);
+        break;
+    case GK_STATS:
+    {
+        // Emerald shows stat changes as coloured rising/falling streaks; ours: arrows on whoever it targets
+        const struct BattleMove *bm = &gBattleMoves[a->move];
+        bool8 onFoe = bm->target != MOVE_TARGET_USER;
+        bool8 up = !onFoe;
+        s32 i, tx = onFoe ? ex : x, ty = onFoe ? ey : y;
+        for (i = 0; i < 6; i++)
+        {
+            p = Spawn(P_ARROW, VFX_LAYER_AIR, tx - 14 + i * 6, ty - (up ? 4 : 48) - (i & 1) * 8);
+            if (p)
+            {
+                p->vy = up ? -20 : 20;
+                p->value = up;
+                p->life = 26;
+                p->delay = i * 2;
+                p->color = up ? PKBN_RGB(31, 14, 8) : PKBN_RGB(8, 16, 31);
+            }
+        }
+        break;
+    }
+    case GK_STATUS:
+    {
+        u16 eff = gBattleMoves[a->move].effect;
+        u8 fx = FX_POISON;
+        if (eff == EFFECT_PARALYZE) fx = FX_PARALYZE;
+        else if (eff == EFFECT_CONFUSE || eff == EFFECT_SWAGGER || eff == EFFECT_FLATTER || eff == EFFECT_TEETER_DANCE) fx = FX_CONFUSE;
+        else if (eff == EFFECT_SLEEP || eff == EFFECT_YAWN) fx = FX_SMOKE;
+        else if (eff == EFFECT_WILL_O_WISP) fx = FX_FIRE_PANEL;
+        Fx(fx, VFX_LAYER_AIR, ex, ey - 26, 0, 0, 0, 36);
+        break;
+    }
+    case GK_WEATHER:
+        ScreenFlash(tc, 16);
+        break;
+    case GK_FIELD:
+        Fx(FX_CHARGE, VFX_LAYER_AIR, x, y - 20, GFX_ADD, 0, 0, 0);
+        break;
+    case GK_METEORS:
+        Fx(FX_CHARGE_RINGS, VFX_LAYER_AIR, x, y - 18, GFX_TINT, tc, 6, 24);
+        break;
+    }
+}
+
+void Vfx_OnSendOut(s32 x, s32 y)
+{
+    // the ball opens: a white burst and sparkles where the Pokémon appears
+    Fx(FX_HIT_STAR, VFX_LAYER_AIR, x, y - 16, GFX_TINT, PKBN_RGB(31, 31, 31), 10, 0);
+    Fx(FX_HEAL, VFX_LAYER_AIR, x, y - 20, 0, 0, 0, 26);
+}
+
+void Vfx_OnHpChange(u8 side, s32 delta, s32 fx, s32 fy)
+{
+    // damage numbers for real hits only (the 1-damage buster and poison ticks would just be noise)
+    struct Particle *p = (delta <= -2 || delta >= 2) ? Spawn(P_NUMBER, VFX_LAYER_HUD, fx + (side == SIDE_PLAYER ? -8 : 8), fy - 46) : NULL;
+    if (p)
+    {
+        p->value = delta;
+        p->vy = -10;
+        p->life = 40;
+        p->color = delta < 0 ? PKBN_RGB(31, 31, 31) : PKBN_RGB(10, 31, 12);
+    }
+    if (delta < 0)
+    {
+        s32 maxHP = sB.f[side].bm.maxHP ? sB.f[side].bm.maxHP : 1;
+        if (-delta * 4 >= maxHP)
+            Shake(10, 3);
+        else if (-delta * 12 >= maxHP)
+            Shake(5, 1);
+    }
+    else
+    {
+        Fx(FX_HEAL, VFX_LAYER_AIR, fx, fy - 22, 0, 0, 0, 30);
+    }
+}
+
+// A panel was struck (or a wave passed over it): pick the picture by attack kind, then by type.
+static void OnImpact(s32 c, s32 r, bool8 passing)
+{
+    u8 kind = sB.fxKind[r][c], type = sB.fxType[r][c], side = sB.fxSide[r][c];
+    u16 tc = Vfx_TypeColor(type);
+    s32 x, y;
+    u32 flip = (side == SIDE_ENEMY) ? GFX_FLIPX : 0;
+    struct Particle *p;
+    Draw_FeetPos(c, r, &x, &y);
+
+    if (sB.fxMove[r][c] == MOVE_NONE)
+    {
+        if (side <= SIDE_ENEMY)
+        {
+            // the buster: a small spark only where it actually hit someone
+            if ((sB.f[side ^ 1].x == c && sB.f[side ^ 1].y == r))
+                Fx(FX_HIT_SMALL, VFX_LAYER_AIR, x, y - 18, 0, 0, 0, 0);
+        }
+        else
+            TypeBurst(TYPE_NORMAL, x, y, FALSE); // Bide / combo panel
+        return;
+    }
+    if (passing)
+    {
+        switch (kind)
+        {
+        case GK_SHOCKWAVE:
+            Fx(FX_DUST, VFX_LAYER_GROUND, x, y - 4, GFX_TINT, tc, 5, 0);
+            break;
+        case GK_WAVE:
+            Fx(type == TYPE_WATER || type == TYPE_ICE ? FX_WAVE : FX_WIND, VFX_LAYER_AIR, x, y - 10,
+               flip | ((type == TYPE_WATER || type == TYPE_FLYING) ? 0 : GFX_TINT), tc, 9, 12);
+            break;
+        }
+        return;
+    }
+
+    switch (kind)
+    {
+    case GK_CANNON: case GK_AIRSHOT: case GK_VULCAN:
+        if (sB.fxPA[r][c])
+        {
+            // a Program Advance cannon: a beam all the way down the row
+            p = Spawn(P_BEAM, VFX_LAYER_AIR, x, y - 16);
+            if (p)
+            {
+                p->life = 18;
+                p->color = tc;
+            }
+        }
+        // the shot flies down the row (drawn at launch); only the panel it stops on bursts
+        if (sB.f[side ^ 1].x == c && sB.f[side ^ 1].y == r)
+        {
+            Fx(FX_HIT, VFX_LAYER_AIR, x, y - 18, type == TYPE_NORMAL ? 0 : GFX_TINT, tc, 6, 0);
+            TypeBurst(type, x, y, FALSE);
+        }
+        break;
+    case GK_LINE3: case GK_CONE:
+        // breath / spray moves: no blade, the type's own picture on every panel
+        TypeBurst(type, x, y, TRUE);
+        break;
+    case GK_SWORD: case GK_LONGSWORD: case GK_DASH:
+        Fx(FX_SLASH, VFX_LAYER_AIR, x, y - 16, flip | (type == TYPE_NORMAL ? 0 : GFX_TINT), tc, 7, 0);
+        TypeBurst(type, x, y, FALSE);
+        break;
+    case GK_WIDESWORD: case GK_LIFESWORD:
+        if (type == TYPE_WATER)
+            Fx(FX_WAVE, VFX_LAYER_AIR, x, y - 10, flip, 0, 0, 16);
+        else
+            Fx(FX_SLASH_ARC, VFX_LAYER_AIR, x, y - 14, flip | (type == TYPE_NORMAL ? 0 : GFX_TINT), tc, 7, 0);
+        break;
+    case GK_TORNADO:
+        Fx(FX_TORNADO, VFX_LAYER_AIR, x, y - 6, type == TYPE_FLYING ? 0 : GFX_TINT, tc, 8, 10);
+        break;
+    case GK_FIREHIT: case GK_GOLEMHIT:
+        if (type == TYPE_FIRE)
+            Fx(FX_FIRE_TALL, VFX_LAYER_AIR, x, y - 4, 0, 0, 0, 20);
+        else if (type == TYPE_ELECTRIC)
+            Fx(FX_BOLT, VFX_LAYER_AIR, x, y - 6, 0, 0, 0, 16);
+        else if (type == TYPE_ICE)
+            Fx(FX_ICE, VFX_LAYER_AIR, x, y - 10, 0, 0, 0, 0);
+        else
+        {
+            Fx(FX_HIT_STAR, VFX_LAYER_AIR, x, y - 14, GFX_TINT, tc, 5, 0);
+            Fx(FX_DUST, VFX_LAYER_GROUND, x, y - 2, 0, 0, 0, 0);
+        }
+        Shake(6, 2);
+        break;
+    case GK_METEORS:
+        if (type == TYPE_ROCK || type == TYPE_GROUND || type == TYPE_FIRE || type == TYPE_STEEL)
+        {
+            // BN6 meteor streaking in, then a burst
+            p = Fx(FX_METEOR, VFX_LAYER_AIR, x - 24, y - 70, type == TYPE_FIRE || type == TYPE_ROCK ? 0 : GFX_TINT, tc, 6, 10);
+            if (p)
+            {
+                p->vx = 16 * 24 / 10;
+                p->vy = 16 * 62 / 10;
+            }
+            p = Fx(FX_EXPLODE_SMALL, VFX_LAYER_AIR, x, y - 10, 0, 0, 0, 0);
+            if (p)
+                p->delay = 10;
+        }
+        else
+        {
+            // a drop of the move's type falling straight down, then its splash
+            p = Spawn(P_ORB, VFX_LAYER_AIR, x, y - 80);
+            if (p)
+            {
+                p->vy = 16 * 62 / 10;
+                p->life = 10;
+                p->value = type;
+            }
+            p = Fx(TypeImpact(type).fx, VFX_LAYER_AIR, x, y + TypeImpact(type).dy, TypeImpact(type).tinted ? GFX_TINT : 0, tc, 8, 18);
+            if (p)
+                p->delay = 10;
+        }
+        Shake(5, 1);
+        break;
+    case GK_FIELD:
+        if (type == TYPE_ELECTRIC)
+        {
+            p = Fx(FX_BOLT, VFX_LAYER_AIR, x, y - 6, 0, 0, 0, 18); // a bolt on every panel
+            ScreenFlash(PKBN_RGB(31, 31, 20), 6);
+        }
+        else if (type == TYPE_WATER || type == TYPE_ICE)
+            p = Fx(type == TYPE_WATER ? FX_WAVE : FX_ICE_SPIKE, VFX_LAYER_AIR, x, y - 8, 0, 0, 0, 20);
+        else
+        {
+            p = Fx(FX_EXPLODE, VFX_LAYER_AIR, x, y - 12, 0, 0, 0, 0);
+            ScreenFlash(PKBN_RGB(31, 31, 31), 6);
+        }
+        if (p)
+            p->delay = (u16)((c + r) % 3) * 4;
+        Shake(24, 3);
+        break;
+    case GK_BOMB:
+        Fx(FX_EXPLODE_SMALL, VFX_LAYER_AIR, x, y - 10, 0, 0, 0, 0);
+        Shake(6, 2);
+        break;
+    case GK_DIG:
+        Fx(FX_SPIKE, VFX_LAYER_AIR, x, y - 2, GFX_TINT, tc, 4, 0);
+        Fx(FX_ROCKS, VFX_LAYER_GROUND, x, y - 4, 0, 0, 0, 14);
+        Shake(6, 2);
+        break;
+    case GK_SWEEP:
+        // a solid beam across the panel (BN6 has no row-sized beam sprite; ours is drawn)
+        p = Spawn(P_BEAM, VFX_LAYER_AIR, x, y - 14);
+        if (p)
+        {
+            p->life = 14;
+            p->color = tc;
+        }
+        Shake(3, 1);
+        break;
+    case GK_PANEL:
+        TypeBurst(type, x, y, FALSE);
+        break;
+    case GK_LOCKON:
+        Fx(FX_HIT, VFX_LAYER_AIR, x, y - 16, 0, 0, 0, 0);
+        TypeBurst(type, x, y, TRUE);
+        Shake(4, 1);
+        break;
+    default:
+        TypeBurst(type, x, y, kind == GK_BALL);
+        break;
+    }
+}
+
+void Vfx_ScanImpacts(void)
+{
+    s32 r, c;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (sB.fxSeq[r][c] != sSeenSeq[r][c])
+            {
+                sSeenSeq[r][c] = sB.fxSeq[r][c];
+                // travelling waves flash each panel for 2 frames as they pass; real hits flash 8-12
+                OnImpact(c, r, sB.fx[r][c] <= 3 && sB.fxMove[r][c] != MOVE_NONE);
+            }
+}
+
+// ---- per frame -----------------------------------------------------------------------------------------------
+
+void Vfx_BeginFrame(void)
+{
+    s32 i;
+    sT++;
+    for (i = 0; i < MAX_VFX; i++)
+    {
+        struct Particle *p = &sP[i];
+        if (!p->active)
+            continue;
+        if (p->delay)
+        {
+            p->delay--;
+            continue;
+        }
+        p->x += p->vx;
+        p->y += p->vy;
+        p->vy += p->ay;
+        if (++p->t >= p->life)
+            p->active = FALSE;
+    }
+    if (sShakeT)
+        sShakeT--;
+    else
+        sShakeMag = 0;
+    if (sFlashT)
+        sFlashT--;
+}
+
+static void DrawOrb(u16 *fb, s32 x, s32 y, u8 type, u32 t);
+
+static void DrawBeam(u16 *fb, const struct Particle *p)
+{
+    s32 x = p->x / 16 - PANEL_W / 2 - 1, y = p->y / 16, w = PANEL_W + 2;
+    s32 h = p->t < 4 ? 2 + p->t * 2 : (p->life - p->t < 5 ? (p->life - p->t) * 2 : 10);
+    s32 k;
+    Gfx_FillBlend(fb, x, y - h / 2 - 3, w, h + 6, p->color, 6);
+    Gfx_FillBlend(fb, x, y - h / 2, w, h, p->color, 13);
+    Gfx_FillBlend(fb, x, y - h / 4, w, h / 2 > 1 ? h / 2 : 1, PKBN_RGB(31, 31, 31), 14);
+    for (k = 0; k < 3; k++) // sparkles riding the beam
+        Pkbn_FillRect(fb, x + (s32)((p->t * 7 + k * 15) % w), y - h / 2 + (k * 3) % (h > 2 ? h : 2), 2, 1, PKBN_RGB(31, 31, 31));
+}
+
+static void DrawNumber(u16 *fb, const struct Particle *p)
+{
+    char line[8];
+    s32 x = p->x / 16, y = p->y / 16, dx, dy, w;
+    u16 ring = p->value < 0 ? PKBN_RGB(20, 2, 2) : PKBN_RGB(2, 12, 2);
+    snprintf(line, sizeof(line), "%d", (int)(p->value < 0 ? -p->value : p->value));
+    w = Pkbn_EmTextWidth(line, PKBN_FONT_NORMAL);
+    x -= w / 2;
+    if (p->t > 30 && (p->t & 2))
+        return; // blink out
+    for (dy = -1; dy <= 1; dy++)
+        for (dx = -1; dx <= 1; dx++)
+            if (dx || dy)
+                Pkbn_DrawEmText(fb, x + dx, y + dy, line, PKBN_FONT_NORMAL, ring, 0);
+    Pkbn_DrawEmText(fb, x, y, line, PKBN_FONT_NORMAL, p->color, 0);
+}
+
+static void DrawArrow(u16 *fb, const struct Particle *p)
+{
+    s32 x = p->x / 16, y = p->y / 16, i;
+    u8 a = (u8)(p->t < 6 ? p->t * 2 : p->t > p->life - 8 ? (p->life - p->t) * 2 : 12);
+    for (i = 0; i < 4; i++)
+    {
+        s32 row = p->value ? y + i : y + 6 - i; // up arrow: point on top
+        Gfx_FillBlend(fb, x - i, row, i * 2 + 1, 1, p->color, a);
+    }
+    Gfx_FillBlend(fb, x - 1, p->value ? y + 4 : y - 4, 3, 6, p->color, a);
+}
+
+void Vfx_DrawLayer(u16 *fb, u8 layer)
+{
+    s32 i;
+    for (i = 0; i < MAX_VFX; i++)
+    {
+        const struct Particle *p = &sP[i];
+        if (!p->active || p->layer != layer || p->delay)
+            continue;
+        switch (p->type)
+        {
+        case P_SPRITE:
+            if (p->clipL || p->clipR)
+                Gfx_ClipX(p->clipL, p->clipR);
+            Gfx_DrawScaled(fb, Fx_Frame(p->id, p->t), p->x / 16, p->y / 16, p->scale, p->scale, p->flags, p->color, p->amt);
+            Gfx_ClipX(-9999, 9999);
+            break;
+        case P_NUMBER:
+            DrawNumber(fb, p);
+            break;
+        case P_ARROW:
+            DrawArrow(fb, p);
+            break;
+        case P_BEAM:
+            DrawBeam(fb, p);
+            break;
+        case P_ORB:
+            DrawOrb(fb, p->x / 16, p->y / 16, (u8)p->value, sT);
+            break;
+        case P_SHOT:
+        {
+            s32 x = p->x / 16, y = p->y / 16, k;
+            for (k = 0; k < 4; k++)
+                Gfx_FillBlend(fb, x - (p->vx > 0 ? k * 6 : -k * 6), y - 1, 6, 3, p->color, (u8)(14 - k * 3));
+            Pkbn_FillRect(fb, x - 1, y - 1, 3, 3, PKBN_RGB(31, 31, 31));
+            break;
+        }
+        }
+    }
+}
+
+// ---- attacks in flight -----------------------------------------------------------------------------------------
+
+static void DrawOrb(u16 *fb, s32 x, s32 y, u8 type, u32 t)
+{
+    u16 c = Vfx_TypeColor(type);
+    switch (type)
+    {
+    case TYPE_FIRE:     Gfx_Draw(fb, Fx_Frame(FX_FIREBALL, t), x, y, 0, 0, 0); return;
+    case TYPE_ELECTRIC: Gfx_Draw(fb, Fx_Frame(FX_SPARK, t), x, y + 8, GFX_ADD, 0, 0); break;
+    case TYPE_WATER:    Gfx_Draw(fb, Fx_Frame(FX_BUBBLE, t % 12), x, y, 0, 0, 0); break;
+    }
+    Gfx_Ellipse(fb, x, y, 7, 7, c, 8);
+    Gfx_Ellipse(fb, x, y, 5, 5, Gfx_Blend(c, PKBN_RGB(31, 31, 31), 6), 12);
+    Gfx_Ellipse(fb, x - 1, y - 1, 2, 2, PKBN_RGB(31, 31, 31), 14);
+}
+
+void Vfx_DrawAttacks(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+    {
+        const struct Attack *a = &sB.attacks[i];
+        s32 x, y, x1, y1;
+        u8 type;
+        if (!a->active)
+            continue;
+        type = AttackType(a);
+        if (a->kind == GK_LOCKON)
+        {
+            Draw_FeetPos(a->tx, a->ty, &x, &y);
+            Gfx_Draw(fb, Fx_Frame(FX_LOCKON, sT), x, y - 14, 0, 0, 0);
+            continue;
+        }
+        if (a->phase == PH_CHARGE)
+        {
+            Draw_FeetPos(sB.f[a->side].x, sB.f[a->side].y, &x, &y);
+            Gfx_Draw(fb, Fx_Frame(FX_CHARGE, sT), x, y - 22, GFX_ADD | GFX_TINT, Vfx_TypeColor(type), 6);
+        }
+        if ((a->kind == GK_BOMB || (a->kind == GK_PANEL && a->move == MOVE_TOXIC)) && a->phase == PH_WAIT && a->duration > 0)
+        {
+            s32 d = a->duration, t = d - a->timer, arc;
+            Draw_FeetPos(a->ox, a->oy, &x, &y);
+            Draw_FeetPos(a->tx, a->ty, &x1, &y1);
+            arc = 4 * 40 * t * (d - t) / (d * d);
+            x = x + (x1 - x) * t / d;
+            y = y + (y1 - y) * t / d - 14 - arc;
+            if (a->kind == GK_BOMB)
+                Gfx_Draw(fb, Fx_Frame(FX_BOMB, sT), x, y, 0, 0, 0);
+            else
+                DrawOrb(fb, x, y, TYPE_POISON, sT);
+            continue;
+        }
+        if ((a->kind == GK_METEORS || a->kind == GK_FIREHIT || a->kind == GK_GOLEMHIT) && a->phase == PH_WAIT)
+        {
+            // something gathering above the target while the panel flashes
+            s32 r, c;
+            for (r = 0; r < GRID_ROWS; r++)
+                for (c = 0; c < GRID_COLS; c++)
+                    if (a->cells[r][c])
+                    {
+                        Draw_FeetPos(c, r, &x, &y);
+                        Gfx_Ellipse(fb, x, y - 1, 8 + (s32)(sT & 3), 2, Vfx_TypeColor(type), 7);
+                    }
+        }
+        if (a->phase != PH_TRAVEL)
+            continue;
+        {
+            // smooth position between panels: the projectile moves one panel every `step` frames
+            s32 frac = a->step ? (s32)(a->step - a->timer) * 256 / a->step : 0;
+            s32 x0, y0;
+            Draw_FeetPos(a->px, a->py, &x0, &y0);
+            x = x0 + a->vx * PANEL_W * frac / 256;
+            y = y0 + a->vy * PANEL_H * frac / 256;
+        }
+        switch (a->kind)
+        {
+        case GK_BALL:
+            DrawOrb(fb, x, y - 18, type, sT);
+            break;
+        case GK_DELAYED:
+            Gfx_Draw(fb, Fx_Frame(FX_VORTEX, sT), x, y - 16, GFX_HALF, 0, 0);
+            break;
+        case GK_AIRHOCKEY:
+            Gfx_Ellipse(fb, x, y - 4, 9, 4, PKBN_RGB(4, 4, 8), 14);
+            Gfx_Ellipse(fb, x, y - 6, 8, 3, Vfx_TypeColor(type), 15);
+            Gfx_Ellipse(fb, x + ((sT / 2) & 1 ? 2 : -2), y - 7, 2, 1, PKBN_RGB(31, 31, 31), 14);
+            break;
+        case GK_WAVE:
+        case GK_SHOCKWAVE:
+        {
+            s32 r;
+            bool8 three = a->info.rows == 3;
+            for (r = three ? 0 : a->py; r <= (three ? GRID_ROWS - 1 : a->py); r++)
+            {
+                s32 wx, wy;
+                Draw_FeetPos(a->px, r, &wx, &wy);
+                wx = x;
+                if (a->kind == GK_WAVE)
+                    Gfx_Draw(fb, Fx_Frame(type == TYPE_WATER || type == TYPE_ICE ? FX_WAVE : FX_WIND, sT), wx, wy - 10,
+                             (a->vx < 0 ? GFX_FLIPX : 0) | ((type == TYPE_WATER || type == TYPE_FLYING) ? 0 : GFX_TINT),
+                             Vfx_TypeColor(type), 9);
+                else
+                {
+                    // a ground wave: a rock riding a dust plume
+                    Gfx_Draw(fb, Fx_Frame(FX_DUST, sT % 6), wx, wy - 4, GFX_TINT, Vfx_TypeColor(type), 5);
+                    Gfx_Draw(fb, Fx_Frame(FX_ROCK, 0), wx, wy - 6 - (s32)((sT / 2) & 3), 0, 0, 0);
+                }
+            }
+            break;
+        }
+        }
+    }
+}
+
+// ---- the Custom screen's chip picture: the effect this move will make, looping -------------------------
+
+static void PlayLoop(u16 *fb, u8 id, s32 x, s32 y, u32 flags, u16 color, u8 amt, u32 t)
+{
+    u32 d = Fx_Duration(id);
+    u32 k = Fx_Loops(id) ? t : t % (d + 16);
+    if (k < d || Fx_Loops(id))
+        Gfx_Draw(fb, Fx_Frame(id, k), x, y, flags, color, amt);
+}
+
+void Vfx_DrawChipArt(u16 *fb, s32 x, s32 y, u16 move, u8 kind, u8 type, u32 t)
+{
+    u16 tc = Vfx_TypeColor(type);
+    struct TypeLook l = TypeImpact(type);
+    switch (kind)
+    {
+    case GK_SWORD: case GK_LONGSWORD: case GK_DASH:
+        PlayLoop(fb, FX_SLASH, x, y - 8, type == TYPE_NORMAL ? 0 : GFX_TINT, tc, 7, t);
+        break;
+    case GK_WIDESWORD: case GK_LIFESWORD:
+        PlayLoop(fb, type == TYPE_WATER ? FX_WAVE : FX_SLASH_ARC, x, y - 6, type == TYPE_NORMAL || type == TYPE_WATER ? 0 : GFX_TINT, tc, 7, t);
+        break;
+    case GK_LINE3: case GK_CONE:
+        if (type == TYPE_FIRE)
+        {
+            Gfx_ClipX(x - 30, x + 40);
+            PlayLoop(fb, FX_FLAME_JET, x - 20, y - 8, GFX_FLIPX, 0, 0, t);
+            Gfx_ClipX(-9999, 9999);
+        }
+        else
+            PlayLoop(fb, l.fx, x, y + l.dy / 2, l.tinted ? GFX_TINT : 0, tc, 8, t);
+        break;
+    case GK_BALL:
+        DrawOrb(fb, x + (s32)((t % 40) - 20), y - 8, type, t);
+        break;
+    case GK_TORNADO:
+        PlayLoop(fb, FX_TORNADO, x, y + 6, type == TYPE_FLYING ? 0 : GFX_TINT, tc, 8, t);
+        break;
+    case GK_FIREHIT: case GK_GOLEMHIT:
+        if (type == TYPE_FIRE)          PlayLoop(fb, FX_FIRE_TALL, x, y + 10, 0, 0, 0, t);
+        else if (type == TYPE_ELECTRIC) PlayLoop(fb, FX_BOLT, x, y + 18, 0, 0, 0, t);
+        else                            PlayLoop(fb, FX_HIT_STAR, x, y - 2, GFX_TINT, tc, 5, t);
+        break;
+    case GK_METEORS:
+        PlayLoop(fb, FX_METEOR, x, y - 6, type == TYPE_FIRE || type == TYPE_ROCK ? 0 : GFX_TINT, tc, 6, t);
+        break;
+    case GK_FIELD:
+        PlayLoop(fb, type == TYPE_ELECTRIC ? FX_BOLT : FX_EXPLODE, x, y + (type == TYPE_ELECTRIC ? 18 : 0), 0, 0, 0, t);
+        break;
+    case GK_BOMB:
+        Gfx_Draw(fb, Fx_Frame(FX_BOMB, t), x, y - 4 - (s32)((t / 8) & 1), 0, 0, 0);
+        break;
+    case GK_SHOCKWAVE:
+        Gfx_Draw(fb, Fx_Frame(FX_DUST, t % 6), x, y + 4, GFX_TINT, tc, 5);
+        Gfx_Draw(fb, Fx_Frame(FX_ROCK, 0), x, y + 2 - (s32)((t / 2) & 3), 0, 0, 0);
+        break;
+    case GK_WAVE:
+        PlayLoop(fb, type == TYPE_WATER || type == TYPE_ICE ? FX_WAVE : FX_WIND, x, y,
+                 (type == TYPE_WATER || type == TYPE_FLYING) ? 0 : GFX_TINT, tc, 9, t);
+        break;
+    case GK_AIRHOCKEY:
+        Gfx_Ellipse(fb, x, y + 4, 9, 4, PKBN_RGB(4, 4, 8), 14);
+        Gfx_Ellipse(fb, x, y + 2, 8, 3, tc, 15);
+        break;
+    case GK_LOCKON:
+        PlayLoop(fb, FX_LOCKON, x, y - 2, 0, 0, 0, t);
+        break;
+    case GK_DELAYED:
+        PlayLoop(fb, FX_VORTEX, x, y - 4, GFX_HALF, 0, 0, t);
+        break;
+    case GK_BARRIER:
+        PlayLoop(fb, FX_BARRIER, x, y - 4, GFX_HALF, 0, 0, t);
+        break;
+    case GK_STATS:
+    {
+        s32 i, k = (s32)(t % 24);
+        for (i = 0; i < 3; i++)
+        {
+            s32 ax = x - 12 + i * 12, ay = y + 4 - k - (i & 1) * 6, j;
+            for (j = 0; j < 4; j++)
+                Gfx_FillBlend(fb, ax - j, ay + j, j * 2 + 1, 1, PKBN_RGB(31, 14, 8), 12);
+            Gfx_FillBlend(fb, ax - 1, ay + 4, 3, 6, PKBN_RGB(31, 14, 8), 12);
+        }
+        break;
+    }
+    case GK_SELF: case GK_WEATHER:
+        PlayLoop(fb, FX_CHARGE_RINGS, x, y + 4, GFX_TINT, tc, 6, t);
+        break;
+    case GK_STATUS:
+        PlayLoop(fb, gBattleMoves[move].effect == EFFECT_PARALYZE ? FX_PARALYZE :
+                     gBattleMoves[move].effect == EFFECT_CONFUSE ? FX_CONFUSE : FX_POISON, x, y - 4, 0, 0, 0, t);
+        break;
+    default:
+        PlayLoop(fb, l.fx, x, y + l.dy / 2, l.tinted ? GFX_TINT : 0, tc, 8, t);
+        break;
+    }
+}
+
+// ---- weather (drawn over the field; Gen 3 weather is battle-wide) ---------------------------------------------
+
+void Vfx_DrawWeather(u16 *fb, u32 t)
+{
+    s32 i;
+    if (sB.weather & B_WEATHER_RAIN)
+        for (i = 0; i < 40; i++)
+        {
+            s32 x = (i * 53 + (s32)t * 3) % CW, y = (i * 37 + (s32)t * 7) % CH;
+            Gfx_FillBlend(fb, x, y, 1, 6, PKBN_RGB(18, 22, 31), 9);
+        }
+    if (sB.weather & B_WEATHER_HAIL)
+        for (i = 0; i < 24; i++)
+        {
+            s32 x = (i * 71 + (s32)t) % CW, y = (i * 29 + (s32)t * 3) % CH;
+            Pkbn_FillRect(fb, x, y, 2, 2, PKBN_RGB(28, 31, 31));
+        }
+    if (sB.weather & B_WEATHER_SANDSTORM)
+        for (i = 0; i < 60; i++)
+        {
+            s32 x = (i * 97 + (s32)t * 6) % CW, y = (i * 23 + (s32)(t / 2)) % CH;
+            Gfx_FillBlend(fb, x, y, 3, 1, PKBN_RGB(28, 22, 12), 10);
+        }
+    if (sB.weather & B_WEATHER_SUN)
+        Gfx_FillBlend(fb, 0, 0, CW, CH, PKBN_RGB(31, 24, 10), (u8)(2 + ((t / 20) & 1)));
+}
+
+void Vfx_EndFrame(u16 *fb)
+{
+    if (sFlashT)
+        Gfx_FillBlend(fb, 0, 0, CW, CH, sFlashColor, (u8)(sFlashT > 8 ? 12 : sFlashT + 3));
+    if (sShakeT && sShakeMag)
+    {
+        // shift the whole picture (BN shakes the screen on heavy hits)
+        static u16 sCopy[CW * CH];
+        s32 dx = ((sT & 1) ? sShakeMag : -sShakeMag), dy = ((sT & 2) ? sShakeMag / 2 : 0), x, y;
+        memcpy(sCopy, fb, sizeof(sCopy));
+        for (y = 0; y < CH; y++)
+            for (x = 0; x < CW; x++)
+            {
+                s32 sx = x - dx, sy = y - dy;
+                if (sx < 0) sx = 0;
+                if (sx >= CW) sx = CW - 1;
+                if (sy < 0) sy = 0;
+                if (sy >= CH) sy = CH - 1;
+                fb[y * CW + x] = sCopy[sy * CW + sx];
+            }
+    }
+}
+
+// ---- Emerald's Poké Ball sprite (graphics/balls/*.png: 16x16 frames; pokeball.c gBallSpriteSheets) ------
+
+void Vfx_DrawBall(u16 *fb, u16 ballItem, s32 x, s32 y, s32 t)
+{
+    static u8 sTiles[384];
+    static u16 sPal[16];
+    static u8 sPx[16 * 16];
+    static u8 sLoadedBall = 0xFF;
+    struct PkbnImage img;
+    u8 ball = ItemIdToBallId(ballItem ? ballItem : ITEM_POKE_BALL);
+    s32 px, py;
+    if (ball != sLoadedBall)
+    {
+        LZ77UnCompWram(gBallSpriteSheets[ball].data, sTiles);
+        LZ77UnCompWram(gBallSpritePalettes[ball].data, sPal);
+        sLoadedBall = ball;
+    }
+    // frame 0 = closed ball: 2x2 tiles, row-major
+    for (py = 0; py < 16; py++)
+        for (px = 0; px < 16; px++)
+        {
+            s32 tile = (py / 8) * 2 + (px / 8);
+            u8 byte = sTiles[tile * 32 + (py % 8) * 4 + (px % 8) / 2];
+            sPx[py * 16 + px] = (px & 1) ? (byte >> 4) : (byte & 0xF);
+        }
+    img.w = 16;
+    img.h = 16;
+    img.ox = -8;
+    img.oy = -8;
+    img.px = sPx;
+    img.pal = sPal;
+    Gfx_Ellipse(fb, x, y + 10, 6, 2, PKBN_RGB(0, 0, 0), 8);
+    Gfx_Draw(fb, &img, x, y, (t < 30 && (t / 3) & 1) ? GFX_FLIPX : 0, 0, 0);
+}
