+// ---- Emerald's own fonts (POC-8) ---------------------------------------------------------------------
+// Glyph data as text.c reads it: 2bpp rows (u16 per 8 pixels, high byte = left 4 pixels, 2 bits per pixel
+// MSB first), 1 = text colour, 2 = shadow, 0/3 = background (GenerateFontHalfRowLookupTable / DecompressGlyphTile).
+// A glyph is 0x20 u16: top-left, top-right, bottom-left, bottom-right 8x8 tiles; widths from the width tables.
+static u8 AsciiToGame(char c)
+{
+    if (c >= 'A' && c <= 'Z') return 0xBB + (c - 'A');
+    if (c >= 'a' && c <= 'z') return 0xD5 + (c - 'a');
+    if (c >= '0' && c <= '9') return 0xA1 + (c - '0');
+    switch (c)
+    {
+    case '!': return 0xAB;
+    case '?': return 0xAC;
+    case '.': return 0xAD;
+    case '-': return 0xAE;
+    case '\'': return 0xB4;
+    case ',': return 0xB8;
+    case '/': return 0xBA;
+    case ':': return 0xF0;
+    case '+': return 0x2E;
+    case '&': return 0x2D;
+    case '=': return 0x35;
+    case '%': return 0x5B;
+    case '(': return 0x5C;
+    case ')': return 0x5D;
+    case '$': return 0xB7; // the Pokédollar sign
+    case '*': return 0xB9; // multiplication sign (x)
+    }
+    return 0x00;
+}
+
+static s32 GlyphWidth(u8 font, u8 ch)
+{
+    return font == PKBN_FONT_SMALL ? gFontSmallLatinGlyphWidths[ch] : gFontNormalLatinGlyphWidths[ch];
+}
+
+static void DrawGlyph(u16 *fb, s32 x, s32 y, u8 font, u8 ch, u16 fg, u16 shadow)
+{
+    const u16 *g = (font == PKBN_FONT_SMALL ? gFontSmallLatinGlyphs : gFontNormalLatinGlyphs) + 0x20 * ch;
+    s32 tile, row, i;
+    for (tile = 0; tile < 4; tile++)
+    {
+        const u16 *t = g + tile * 8;
+        s32 tx = x + (tile & 1) * 8, ty = y + (tile >> 1) * 8;
+        for (row = 0; row < 8; row++)
+        {
+            u16 bits = t[row];
+            for (i = 0; i < 8; i++)
+            {
+                u8 byte = (i < 4) ? (bits >> 8) : (bits & 0xFF);
+                u8 v = (byte >> (6 - 2 * (i & 3))) & 3;
+                if (v == 1)
+                    Pkbn_FillRect(fb, tx + i, ty + row, 1, 1, fg);
+                else if (v == 2 && shadow)
+                    Pkbn_FillRect(fb, tx + i, ty + row, 1, 1, shadow);
+            }
+        }
+    }
+}
+
+s32 Pkbn_EmTextWidth(const char *text, u8 font)
+{
+    s32 w = 0;
+    for (; *text; text++)
+        w += GlyphWidth(font, AsciiToGame(*text));
+    return w;
+}
+
+s32 Pkbn_DrawEmText(u16 *fb, s32 x, s32 y, const char *text, u8 font, u16 fg, u16 shadow)
+{
+    for (; *text; text++)
+    {
+        u8 ch = AsciiToGame(*text);
+        DrawGlyph(fb, x, y, font, ch, fg, shadow);
+        x += GlyphWidth(font, ch);
+    }
+    return x;
+}
+
+// Gen 3 string (EOS-terminated) in Emerald's font, keeping its own characters (é, ♂/♀...).
+s32 Pkbn_DrawGameString(u16 *fb, s32 x, s32 y, const u8 *str, u8 font, u16 fg, u16 shadow)
+{
+    for (; *str != EOS; str++)
+    {
+        if (*str >= 0xF7) // control codes: stop
+            break;
+        DrawGlyph(fb, x, y, font, *str, fg, shadow);
+        x += GlyphWidth(font, *str);
+    }
+    return x;
