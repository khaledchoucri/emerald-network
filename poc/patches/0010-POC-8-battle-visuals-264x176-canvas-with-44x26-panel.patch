+// Visuals: the attack being updated right now (or NULL), so impacts can say what hit the panel.
+static const struct Attack *sVisAttack;
+static u8 sVisBusterSide = 0xFF;
+
+static void NoteImpact(s32 r, s32 c)
+{
+    const struct Attack *a = sVisAttack;
+    sB.fxSeq[r][c]++;
+    if (a == NULL && sVisBusterSide == 0xFF)
+    {
+        // hits made while an attack is being launched (Moves_Use -> Impact): the newest active attack
+        s32 i;
+        for (i = 0; i < MAX_ATTACKS; i++)
+            if (sB.attacks[i].active && (a == NULL || sB.attacks[i].serial > a->serial))
+                a = &sB.attacks[i];
+    }
+    if (a != NULL)
+    {
+        sB.fxMove[r][c] = a->move;
+        sB.fxKind[r][c] = a->kind;
+        sB.fxType[r][c] = a->pa ? gPkbnProgramAdvances[a->pa - 1].type : a->typeOverride ? a->typeOverride : gBattleMoves[a->move].type;
+        sB.fxSide[r][c] = a->side;
+        sB.fxPA[r][c] = a->pa;
+    }
+    else
+    {
+        sB.fxMove[r][c] = MOVE_NONE; // buster / Bide / combo panel
+        sB.fxKind[r][c] = GK_NONE;
+        sB.fxType[r][c] = TYPE_MYSTERY;
+        sB.fxSide[r][c] = sVisBusterSide;
+        sB.fxPA[r][c] = 0;
+    }
