+// ---- POC-20a: Unison look - the partner's colours on your Pokémon's body ------------------------------------------
+// Khaled asked us to look at sprite fusion (Pokémon Infinite Fusion, Alex Onsager's Pokémon Fusion). Those paste the
+// head of one Pokémon on the body of the other and "swap the colors on the body to match the head" (Onsager); the
+// head part needs a hand-cut head per species. We do the colour step only, which works for every pair: the body's
+// colour ramps (grouped by hue, biggest area first) take the hue and saturation of the partner's ramps in the same
+// order, keeping the body's own lightness so the shading survives. Outline, near-white and grey stay as they are.
+// Studied in research/fusion_study.py (same algorithm).
+static void Rgb555ToHls(u16 c, s32 *h, s32 *l, s32 *s)   // h 0..359, l and s 0..1000
+{
+    s32 r = (c & 31) * 1000 / 31, g = ((c >> 5) & 31) * 1000 / 31, b = ((c >> 10) & 31) * 1000 / 31;
+    s32 mx = r > g ? (r > b ? r : b) : (g > b ? g : b), mn = r < g ? (r < b ? r : b) : (g < b ? g : b), d = mx - mn;
+    *l = (mx + mn) / 2;
+    if (d == 0)
+    {
+        *h = *s = 0;
+        return;
+    }
+    *s = *l < 500 ? d * 1000 / (mx + mn) : d * 1000 / (2000 - mx - mn);
+    if (mx == r)      *h = (60 * (g - b) / d + 360) % 360;
+    else if (mx == g) *h = 60 * (b - r) / d + 120;
+    else              *h = 60 * (r - g) / d + 240;
+}
+
+static s32 HueToRgb(s32 p, s32 q, s32 t)   // t in degrees, values 0..1000
+{
+    t = (t % 360 + 360) % 360;
+    if (t < 60)  return p + (q - p) * t / 60;
+    if (t < 180) return q;
+    if (t < 240) return p + (q - p) * (240 - t) / 60;
+    return p;
+}
+
+static u16 HlsToRgb555(s32 h, s32 l, s32 s)
+{
+    s32 q = l < 500 ? l * (1000 + s) / 1000 : l + s - l * s / 1000, p = 2 * l - q, r, g, b;
+    if (s == 0)
+        r = g = b = l;
+    else
+    {
+        r = HueToRgb(p, q, h + 120);
+        g = HueToRgb(p, q, h);
+        b = HueToRgb(p, q, h - 120);
+    }
+    return (u16)((r * 31 / 1000) | ((g * 31 / 1000) << 5) | ((b * 31 / 1000) << 10));
+}
+
+struct FuseRamp { u8 n; u8 idx[15]; s32 area, hue; };
+
+// Colour ramps of a picture: palette entries in use grouped by hue (within 25 degrees), biggest area first.
+static u8 FuseRamps(const struct PkbnMonPic *pic, struct FuseRamp *out)
+{
+    s32 cnt[16] = {0}, i, k, n = 0, order[16], m = 0;
+    for (i = 0; i < 64 * 64; i++)
+        cnt[pic->px[0][i] & 15]++;
+    for (i = 1; i < 16; i++)
+        if (cnt[i])
+            order[m++] = i;
+    for (i = 0; i < m; i++)   // by area, largest first
+        for (k = i + 1; k < m; k++)
+            if (cnt[order[k]] > cnt[order[i]])
+            {
+                s32 t = order[i]; order[i] = order[k]; order[k] = t;
+            }
+    for (i = 0; i < m; i++)
+    {
+        s32 h, l, s, c = order[i];
+        Rgb555ToHls(pic->pal[c], &h, &l, &s);
+        if (s < 180 || l < 120 || l > 930)
+            continue;   // outline, highlight, grey: not a colour ramp
+        for (k = 0; k < n; k++)
+        {
+            s32 d = h - out[k].hue;
+            d = d < 0 ? -d : d;
+            if ((d > 180 ? 360 - d : d) < 25 && out[k].n < 15)
+                break;
+        }
+        if (k == n)
+        {
+            if (n == 8)
+                continue;
+            out[n].n = 0, out[n].area = 0, out[n].hue = h, n++;
+        }
+        out[k].idx[out[k].n++] = c;
+        out[k].area += cnt[c];
+    }
+    for (i = 0; i < n; i++)
+        for (k = i + 1; k < n; k++)
+            if (out[k].area > out[i].area)
+            {
+                struct FuseRamp t = out[i]; out[i] = out[k]; out[k] = t;
+            }
+    return n;
+}
+
+void Gfx_FusePalette(struct PkbnMonPic *body, const struct PkbnMonPic *partner)
+{
+    struct FuseRamp br[8], pr[8];
+    u8 nb = FuseRamps(body, br), np = FuseRamps(partner, pr), i, j;
+    u16 pal[16];
+    if (np == 0)
+        return;
+    memcpy(pal, body->pal, sizeof(pal));
+    for (i = 0; i < nb; i++)
+    {
+        const struct FuseRamp *t = &pr[i % np];
+        s32 th, tl, ts;
+        Rgb555ToHls(partner->pal[t->idx[0]], &th, &tl, &ts);   // the partner ramp's main colour
+        for (j = 0; j < br[i].n; j++)
+        {
+            s32 h, l, s;
+            Rgb555ToHls(body->pal[br[i].idx[j]], &h, &l, &s);
+            pal[br[i].idx[j]] = HlsToRgb555(th, l, ts);
+        }
+    }
+    memcpy(body->pal, pal, sizeof(pal));
+}
