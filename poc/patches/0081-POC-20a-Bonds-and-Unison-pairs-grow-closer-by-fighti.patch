+// ---- POC-20a: Bonds (src/pkbn/grid_battle.c) ----------------------------------------------------------------------
+// A pair is stored by the two Pokémon's personality values (order-free), so it follows them through the PC.
+static s32 BondFind(u32 a, u32 b)
+{
+    s32 i;
+    for (i = 0; i < PKBN_BOND_SLOTS; i++)
+        if ((sSave.bonds[i].pidA == a && sSave.bonds[i].pidB == b) || (sSave.bonds[i].pidA == b && sSave.bonds[i].pidB == a))
+            return i;
+    return -1;
+}
+
+u8 PkbnBond_Get(u32 pidA, u32 pidB)
+{
+    s32 i;
+    if (getenv("PKBN_TEST_BOND") != NULL)
+        return (u8)atoi(getenv("PKBN_TEST_BOND"));   // self-tests: every pair at this Bond
+    i = BondFind(pidA, pidB);
+    return i < 0 ? 0 : sSave.bonds[i].points;
+}
+
+void PkbnBond_Add(u32 pidA, u32 pidB, s32 delta)
+{
+    s32 i, v;
+    if (pidA == pidB || delta == 0)
+        return;
+    i = BondFind(pidA, pidB);
+    if (i < 0)
+    {
+        s32 k, low = 0x7FFF;
+        if (delta < 0)
+            return;
+        for (k = 0; k < PKBN_BOND_SLOTS; k++)   // a free slot, else the weakest Bond makes room
+            if (sSave.bonds[k].points < low)
+                low = sSave.bonds[k].points, i = k;
+        sSave.bonds[i].pidA = pidA;
+        sSave.bonds[i].pidB = pidB;
+        sSave.bonds[i].points = 0;
+    }
+    v = sSave.bonds[i].points + delta;
+    sSave.bonds[i].points = v < 0 ? 0 : v > PKBN_BOND_MAX ? PKBN_BOND_MAX : v;
+}
+
+// POC-20c: Dark Chips - who already offered (bit per giver) and who was accepted
+bool8 PkbnDark_Offered(u8 giver) { return (sSave.darkOffered >> giver) & 1; }
+bool8 PkbnDark_Taken(u8 giver) { return (sSave.darkTaken >> giver) & 1; }
+void PkbnDark_SetOffered(u8 giver, bool8 taken)
+{
+    sSave.darkOffered |= 1 << giver;
+    if (taken)
+        sSave.darkTaken |= 1 << giver;
+}
+
+// POC-20b: ghost records - best win time and Busting Level per ghost (by its code's hash)
