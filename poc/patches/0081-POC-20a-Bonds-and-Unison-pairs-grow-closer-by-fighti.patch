+// ---- POC-20a: Bonds and Unison (Khaled's picks) ----------------------------------------------------------------------
+// Each pair of party Pokémon builds a Bond by fighting together (all TUNE): Cross with that partner +6; switching in for
+// the other right after it took a hit +2; a Program Advance using both their chips +4; both took part in a won battle
+// +1. At PKBN_BOND_MAX their Cross is a Unison: the partner's colours on your Pokémon (Gfx_FusePalette) and a pair
+// Program Advance. A Bond is kept by the two Pokémon (personality values), so it follows them through the PC.
+struct PkbnProgramAdvance gPkbnUnisonPA;
+static char sUnisonName[24];
+
+static u32 SlotPid(u8 slot)
+{
+    return slot == sB.active ? sB.f[SIDE_PLAYER].bm.personality : sB.party[slot].bm.personality;
+}
+
+static void BondEvent(u8 a, u8 b, s32 pts, const char *why)
+{
+    if (gPkbnReplayActive || a == b || a >= sB.partyCount || b >= sB.partyCount)
+        return;
+    PkbnBond_Add(SlotPid(a), SlotPid(b), pts);
+    PKBN_LOG("bond %s+%s %+d (%s) -> %u", sB.party[a].name, sB.party[b].name, (int)pts, why,
+             PkbnBond_Get(SlotPid(a), SlotPid(b)));
+}
+
+u8 PkbnGrid_BondWith(u8 slot)
+{
+    return PkbnBond_Get(SlotPid(sB.active), SlotPid(slot));
+}
+
+// The pair's best damaging move each: same-type first, then power.
+static u16 BestOwnMove(const struct BattlePokemon *bm)
+{
+    s32 k, best = -1;
+    u16 mv = MOVE_NONE;
+    for (k = 0; k < MAX_MON_MOVES; k++)
+    {
+        u16 m = bm->moves[k];
+        s32 sc;
+        if (m == MOVE_NONE || gBattleMoves[m].power == 0 || !PkbnFolder_MoveIsChip(m))
+            continue;
+        sc = gBattleMoves[m].power + ((gBattleMoves[m].type == bm->types[0] || gBattleMoves[m].type == bm->types[1]) ? 1000 : 0);
+        if (sc > best)
+            best = sc, mv = m;
+    }
+    return mv;
+}
+
+// The Unison's Program Advance: the two best moves, then any * chip. It strikes every enemy panel with whichever of
+// the pair's types hits the foe harder (picked when it fires), 200 power (TUNE).
+static void BuildUnisonPA(u8 slot)
+{
+    const struct BattlePokemon *a = &sB.f[SIDE_PLAYER].bm, *b = &sB.party[slot].bm;
+    memset(&gPkbnUnisonPA, 0, sizeof(gPkbnUnisonPA));
+    snprintf(sUnisonName, sizeof(sUnisonName), "%s+%s", sB.f[SIDE_PLAYER].name, sB.party[slot].name);
+    gPkbnUnisonPA.name = sUnisonName;
+    gPkbnUnisonPA.recipe[0] = BestOwnMove(a);
+    gPkbnUnisonPA.recipe[1] = BestOwnMove(b);
+    gPkbnUnisonPA.recipe[2] = MOVE_NONE;   // any * chip
+    gPkbnUnisonPA.kind = GK_FIELD;
+    gPkbnUnisonPA.type = a->types[0];
+    gPkbnUnisonPA.power = 200;
