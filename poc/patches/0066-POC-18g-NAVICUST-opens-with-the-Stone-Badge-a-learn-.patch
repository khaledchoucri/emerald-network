-        PkbnProgram_GrantByName(sStarterPrograms[i], 1);
+    // POC-18 (Khaled's pick): no starter programs - NAVICUST opens after Roxanne, whose first defeat pays Iron and
+    // UnderSht (src/pkbn/leader.c sFirstWinPrograms)
+    (void)sStarterPrograms;
 }
 
 // POC-18: read one file into `tmp`. FALSE if it's missing or not a save we can read.
