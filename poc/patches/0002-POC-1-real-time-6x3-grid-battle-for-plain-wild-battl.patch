+#ifndef GUARD_PKBN_GRID_BATTLE_H
+#define GUARD_PKBN_GRID_BATTLE_H
+
+// POC-1: real-time 6x3 grid battle (Battle Network style) for plain wild battles.
+// Design notes: poc/POC-1.md. PC (PORTABLE) builds only.
+void CB2_PkbnGridBattle(void);
+
+enum { PKBN_GRID_INTRO, PKBN_GRID_CUSTOM, PKBN_GRID_FIGHT, PKBN_GRID_END };
+
+struct PkbnGridDebug
+{
+    u8 state;
+    u32 frame;
+    s8 px, py, ex, ey;
+    bool8 playerThreatened;
+    u8 queueCount;
+    bool8 gaugeFull;
+    u8 handCount, cursor, pickedCount;
+    bool8 cursorPicked;
+    bool8 playerLocked;
+};
+void PkbnGrid_GetDebug(struct PkbnGridDebug *d);
+
+#endif // GUARD_PKBN_GRID_BATTLE_H
