From a548f4aa49251b06f5457ad4a9bd323f73278d9b Mon Sep 17 00:00:00 2001
From: Khaled <khaledchoucri@gmail.com>
Date: Sun, 4 Oct 2026 17:13:54 +0300
Subject: [PATCH] POC-3: plus-shaped bomb blast; stat-stage status moves that
 always land; Speed stage drives tempo

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/pkbn/move_shapes.h |   8 ++-
 src/pkbn/grid_battle.c     | 122 +++++++++++++++++++++++++++++++++----
 src/pkbn/move_shapes.c     |  29 ++++++++-
 src/pkbn/selftest.c        |   2 +-
 4 files changed, 146 insertions(+), 15 deletions(-)

diff --git a/include/pkbn/move_shapes.h b/include/pkbn/move_shapes.h
index 43ff93b..4ee1500 100644
--- a/include/pkbn/move_shapes.h
+++ b/include/pkbn/move_shapes.h
@@ -8,13 +8,19 @@ enum
     SHAPE_CANNON,    // BN6 family 0x14: hits the first target down the row
     SHAPE_LONGSWORD, // BN6 family 0x13 sub 2: hits up to 2 panels ahead
     SHAPE_SPREADER,  // BN6 family 0x25: Cannon + 3x3 splash around the target
-    SHAPE_GRENADE,   // BN6 family 0x12 (MiniBomb): thrown 3 panels ahead, 3x3 blast on landing
+    SHAPE_GRENADE,   // BN6 family 0x12 (MiniBomb): thrown 3 panels ahead, + shaped blast on landing (no diagonals)
     SHAPE_LOCKON,    // BN6 MachGun family 0x29 idea: lock onto the target, then a hit it can't dodge
     SHAPE_BARRIER,   // BN6 Barrier (family 0x15 sub 4, param 1): absorbs the next hit
+    SHAPE_STATUS,    // pure status move (stat stages): always lands, ignores position, Barrier and i-frames
     SHAPE_COUNT
 };
 
 u8 Pkbn_ShapeForMove(u16 move);
+
+// Stat-stage change of a pure status move (Gen 3 effect ids). Returns FALSE if the move
+// isn't a stat-stage move. *stat = STAT_ATK..STAT_EVASION, *delta = +/-1 or 2,
+// *onSelf = TRUE for raises (Growl targets the foe, Howl the user).
+bool8 Pkbn_GetStatChange(u16 move, u8 *stat, s8 *delta, bool8 *onSelf);
 const char *Pkbn_ShapeLabel(u8 shape);
 
 #endif // GUARD_PKBN_MOVE_SHAPES_H
