             pressed = L_BUTTON;
         else if (d.playerThreatened)
             held = (d.py > 0) ? DPAD_UP : DPAD_DOWN;
-        else if (d.queueCount > 0 && (d.nextShape == SHAPE_BARRIER || d.nextShape == SHAPE_LOCKON) && !d.playerLocked)
+        else if (d.queueCount > 0 && (d.nextShape == SHAPE_BARRIER || d.nextShape == SHAPE_LOCKON || d.nextShape == SHAPE_STATUS) && !d.playerLocked)
             pressed = A_BUTTON; // position doesn't matter
         else if (d.py != d.ey)
             held = (d.py < d.ey) ? DPAD_DOWN : DPAD_UP;
