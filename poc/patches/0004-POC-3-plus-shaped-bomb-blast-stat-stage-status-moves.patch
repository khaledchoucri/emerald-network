+// Bomb blast: the landing panel plus its 4 orthogonal neighbours (no diagonals).
 static void BlastCells(s8 cx, s8 cy, u8 cells[GRID_ROWS][GRID_COLS])
 {
-    s8 dx, dy;
-    for (dy = -1; dy <= 1; dy++)
-        for (dx = -1; dx <= 1; dx++)
-            if (InGrid(cx + dx, cy + dy))
-                cells[cy + dy][cx + dx] = 1;
+    static const s8 sOffsets[5][2] = { {0, 0}, {1, 0}, {-1, 0}, {0, 1}, {0, -1} };
+    s32 i;
+    for (i = 0; i < 5; i++)
