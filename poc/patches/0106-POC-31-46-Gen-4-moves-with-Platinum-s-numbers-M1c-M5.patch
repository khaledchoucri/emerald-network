 #define LANE_WILD 26
 
 struct PkbnMoveInfo
@@ -69,7 +70,9 @@ struct PkbnMoveInfo
     u8 rows;      // CANNON / WAVE / SHOCKWAVE: 1 or 3
     u8 flags;     // GF_*
