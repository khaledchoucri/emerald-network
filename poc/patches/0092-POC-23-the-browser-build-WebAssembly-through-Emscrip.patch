diff --git a/tools/web/elf2wasm.py b/tools/web/elf2wasm.py
new file mode 100644
index 0000000..bcd1581
--- /dev/null
+++ b/tools/web/elf2wasm.py
@@ -0,0 +1,126 @@
+#!/usr/bin/env python3
+"""POC-23: turn a 32-bit x86 ELF object of pure data (the host `as --32` output of data/*.s and the songs) into
+WebAssembly assembly that emcc can assemble, keeping every byte, every symbol at its offset (so tables that run into
+each other stay contiguous) and every pointer (R_386_32 relocations become .int32 sym+addend).
+
+usage: elf2wasm.py <in.o> <out.s> <functions.txt>
+  functions.txt: names of the functions defined in the C objects (llvm-nm); a pointer to one of them becomes a function
+  table reference (.functype), anything else a data reference.
+"""
+import struct, sys
+from elftools.elf.elffile import ELFFile
+from elftools.elf.relocation import RelocationSection
+
+src, dst, fnlist = sys.argv[1:4]
+funcs = set(open(fnlist).read().split())
+tag = ''.join(c if c.isalnum() else '_' for c in src.split('/')[-1].rsplit('.', 1)[0])
+
+with open(src, 'rb') as fh:
+    elf = ELFFile(fh)
+    assert elf.elfclass == 32 and elf['e_machine'] == 'EM_386', 'expects an ELF32 i386 object (as --32)'
+    symtab = elf.get_section_by_name('.symtab')
+    syms = list(symtab.iter_symbols())
+    secs = list(elf.iter_sections())
+
+    # which sections carry data
+    keep = {}
+    for i, s in enumerate(secs):
+        if not (s['sh_flags'] & 0x2):          # SHF_ALLOC
+            continue
+        if s['sh_type'] not in ('SHT_PROGBITS', 'SHT_NOBITS'):
+            continue
+        if s['sh_size'] == 0 and not any(sym['st_shndx'] == i and sym.name and
+                                         sym['st_info']['type'] not in ('STT_SECTION', 'STT_FILE') for sym in syms):
+            continue   # empty and unnamed (an empty section that only carries Start/End labels is kept)
+        keep[i] = s
+
+    # labels per section: global and local named symbols, plus a base label for section-relative relocations
+    labels = {i: {} for i in keep}
+    for sym in syms:
+        sh = sym['st_shndx']
+        if not isinstance(sh, int) or sh not in keep or sym['st_info']['type'] in ('STT_SECTION', 'STT_FILE'):
+            continue
+        if not sym.name:
+            continue
+        labels[sh].setdefault(sym['st_value'], []).append((sym.name, sym['st_info']['bind'] == 'STB_GLOBAL'))
+    base = {i: f'.Lsec_{tag}_{i}' for i in keep}
+
+    # relocations: section index -> {offset: (target, addend)}
+    relocs = {i: {} for i in keep}
+    for rs in secs:
+        if not isinstance(rs, RelocationSection):
+            continue
+        tgt = rs['sh_info']
+        if tgt not in keep:
+            continue
+        data = keep[tgt].data()
+        for r in rs.iter_relocations():
+            rtype = r['r_info_type']
+            if rtype == 20:   # R_386_16: GBA-address halves in the Mystery Gift / e-Reader blobs; WebAssembly has no
+                print(f'elf2wasm: {src}: 16-bit relocation at {r["r_offset"]:#x} left as raw bytes', file=sys.stderr)
+                continue      # 16-bit data relocation, and those features don't run on the PC port
+            assert rtype == 1, f'{src}: relocation type {rtype} (only R_386_32 data pointers expected)'
+            off = r['r_offset']
+            addend = struct.unpack_from('<i', data, off)[0]
+            sym = syms[r['r_info_sym']]
+            if sym['st_info']['type'] == 'STT_SECTION' or (not sym.name and isinstance(sym['st_shndx'], int)):
+                name = base.get(sym['st_shndx'])
+                assert name, f'{src}: reloc against a section that holds no data'
+                addend += sym['st_value']
+            else:
+                name = sym.name
+                if isinstance(sym['st_shndx'], int) and sym['st_shndx'] in keep and sym['st_info']['bind'] != 'STB_GLOBAL':
+                    pass   # a local label in this object: emitted as a label, referenced by name
+            relocs[tgt][off] = (name, addend)
+
+    out = []
+    used_funcs = sorted({n for r in relocs.values() for n, _ in r.values() if n in funcs})
+    for f in used_funcs:
+        out.append(f'\t.functype {f} () -> ()')
+
+    def esc(b):
+        return ''.join(chr(c) if 32 <= c < 127 and c not in (34, 92) else '\\%03o' % c for c in b)
+
+    for i, s in keep.items():
+        name = s.name.lstrip('.') or 'data'
+        kind = '.bss' if s['sh_type'] == 'SHT_NOBITS' else ('.data' if s['sh_flags'] & 0x1 else '.rodata')
+        out.append(f'\t.section {kind}.{tag}.{i}.{"".join(c if c.isalnum() else "_" for c in name)},"",@')
+        align = max(1, s['sh_addralign'])
+        out.append(f'\t.p2align {align.bit_length() - 1}')
+        size = s['sh_size']
+        offsets = sorted(set(labels[i]) | {0})
+        sizes = {}
+        for k, o in enumerate(offsets):
+            sizes[o] = (offsets[k + 1] if k + 1 < len(offsets) else size) - o
+        out.append(f'{base[i]}:')
+        data = None if kind == '.bss' else s.data()
+        pos = 0
+        cuts = sorted(set(offsets) | set(relocs[i]) | {size})
+        for o in cuts:
+            if o > pos:
+                if data is None:
+                    out.append(f'\t.skip {o - pos}')
+                else:
+                    chunk = data[pos:o]
+                    for k in range(0, len(chunk), 64):
+                        out.append(f'\t.ascii "{esc(chunk[k:k + 64])}"')
+                pos = o
+            for lab, glob in labels[i].get(o, []):
+                if glob:
+                    out.append(f'\t.globl {lab}')
+                out.append(f'\t.type {lab},@object')
+                out.append(f'{lab}:')
+            if o == size:
+                if size == 0:
+                    out.append('\t.int8 0')   # a WebAssembly data segment can't be empty
+                break
+            if o in relocs[i]:
+                assert data is not None, 'pointer in .bss'
+                n, a = relocs[i][o]
+                out.append(f'\t.int32 {n}{"+%d" % a if a > 0 else ("%d" % a if a < 0 else "")}')
+                pos = o + 4
+        out.append(f'\t.size {base[i]}, {max(size, 1) if size == 0 else size}')
+        for o, labs in labels[i].items():
+            for lab, _ in labs:
+                out.append(f'\t.size {lab}, {max(sizes.get(o, 0), 0)}')
+    open(dst, 'w').write('\n'.join(out) + '\n')
diff --git a/web.mk b/web.mk
new file mode 100644
index 0000000..c90728f
--- /dev/null
+++ b/web.mk
@@ -0,0 +1,72 @@
+# POC-23: the browser build (WebAssembly, Emscripten + its SDL2 port).
+#   make -f web.mk -j4          ->  build/web/dist/ (index.html, pokeemerald.js, pokeemerald.wasm)
+# Needs the normal `make linux` once first: it builds the tools and the assets (build/assets, sound/songs/midi/*.s).
+# scripts/setup_host.sh web does both. Tested with Emscripten 3.1.6 (emsdk install 3.1.6).
+#
+# C is compiled by emcc (32-bit wasm, so the data's pointers are 4 bytes as in the 32-bit build). The data written in
+# assembly (data/*.s, the songs) is assembled by the host's `as --32` exactly as the PC build does, then
+# tools/web/elf2wasm.py turns each object into WebAssembly assembly with the same bytes, symbols and pointers.
+
+SHELL     := bash -o pipefail
+EMCC      ?= emcc
+EMNM      ?= emnm
+HOST_AS   ?= as
+PREPROC   := tools/preproc/preproc
+ASSETS    := build/assets
+OUT       := build/web
+DIST      := $(OUT)/dist
+
+DEFS      := -D NONMATCHING -D PORTABLE -D PLATFORM_SDL2 -D RENDERER_EASY_DRAW -D UBFIX -DMODERN=1 -D PKBN_WEB
+CPPFLAGS  := -iquote include -Wno-trigraphs $(DEFS) -sUSE_SDL=2
+CFLAGS    := -O2 -std=gnu99 -fno-builtin -fno-strict-aliasing -Wno-everything
+ASFLAGS   := --32 --defsym VER_64BIT=0 --defsym MODERN=1 --defsym PORTABLE=1 --defsym UBFIX=1
+
+C_SRCS_IN := $(wildcard src/*.c src/*/*.c src/*/*/*.c)
+C_SRCS    := $(filter-out %.inc.c src/platform/win32.c,$(C_SRCS_IN))
+C_OBJS    := $(patsubst src/%.c,$(OUT)/src/%.o,$(C_SRCS))
+DATA_SRCS := $(wildcard data/*.s)
+MID_SRCS  := $(wildcard sound/songs/midi/*.s)
+ASM_ELF   := $(patsubst %.s,$(OUT)/elf/%.o,$(DATA_SRCS) $(MID_SRCS))
+ASM_OBJS  := $(patsubst %.s,$(OUT)/wasm/%.o,$(DATA_SRCS) $(MID_SRCS))
+
+LDFLAGS   := -O2 $(WEB_LDEXTRA) -sUSE_SDL=2 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=134217728 -sTOTAL_STACK=1048576 \
+             -sEXPORTED_RUNTIME_METHODS=['FS','ENV','callMain','addRunDependency','removeRunDependency'] -sEXPORTED_FUNCTIONS=['_main','_Web_SetTouchKeys','_malloc','_free'] \
+             -sEMULATE_FUNCTION_POINTER_CASTS=1 -sFORCE_FILESYSTEM=1 -lidbfs.js -sENVIRONMENT=web
+
+.PHONY: all clean
+.PRECIOUS: $(OUT)/elf/%.o $(OUT)/wasm/%.s
+all: $(DIST)/index.html
+
+$(OUT)/src/%.o: src/%.c
+	@mkdir -p $(dir $@)
+	@$(EMCC) -E $(CPPFLAGS) $< | $(PREPROC) -i -g $(ASSETS) $< charmap.txt > $(@:.o=.i)
+	@$(EMCC) -x c -c $(CFLAGS) $(@:.o=.i) -o $@ || (echo "FAILED: $<"; exit 1)
+
+$(OUT)/elf/sound/songs/midi/%.o: sound/songs/midi/%.s
+	@mkdir -p $(dir $@)
+	@sed -e 's/\.4byte/\.int/g;s/\.2byte/\.short/g' $< | $(HOST_AS) $(ASFLAGS) -I sound -o $@
+
+$(OUT)/elf/%.o: %.s
+	@mkdir -p $(dir $@)
+	@$(PREPROC) $< charmap.txt | cpp -iquote include - | $(PREPROC) -ie $< charmap.txt \
+	  | sed -e 's/\.4byte/\.int/g;s/\.2byte/\.short/g' | $(HOST_AS) $(ASFLAGS) -o $@
+
+$(OUT)/functions.txt: $(C_OBJS)
+	@$(EMNM) --defined-only $(C_OBJS) 2>/dev/null | awk '$$2 ~ /^[Tt]$$/ {print $$3}' | sort -u > $@
+
+$(OUT)/wasm/%.o: $(OUT)/elf/%.o $(OUT)/functions.txt
+	@mkdir -p $(dir $@)
+	@python3 tools/web/elf2wasm.py $< $(@:.o=.s) $(OUT)/functions.txt
+	@$(EMCC) -c $(@:.o=.s) -o $@
+
+$(DIST)/pokeemerald.js: $(C_OBJS) $(ASM_OBJS) web/pkbn_web.js
+	@mkdir -p $(DIST)
+	$(EMCC) $(LDFLAGS) --pre-js web/pkbn_web.js $(C_OBJS) $(ASM_OBJS) -o $@
+
+# (the page is written here rather than by emcc --shell-file: this Emscripten's HTML minifier step is broken)
+$(DIST)/index.html: web/shell.html $(DIST)/pokeemerald.js
+	@sed -e 's#{{{ SCRIPT }}}#<script async src="pokeemerald.js"></script>#' web/shell.html > $@
+	@ls -la $(DIST)
+
+clean:
+	rm -rf $(OUT)
diff --git a/web/pkbn_web.js b/web/pkbn_web.js
new file mode 100644
index 0000000..0890278
--- /dev/null
+++ b/web/pkbn_web.js
@@ -0,0 +1,93 @@
+// POC-23: the page side of the browser build (linked in with --pre-js; web.mk).
+//  - Saves: /save/ is IndexedDB (IDBFS). It's loaded before the game starts and written back whenever the game saves
+//    (Platform_Persist -> Module.pkbnPersist), every 30 seconds, and when the tab is hidden or closed.
+//  - Backups: Module.pkbnExport() downloads every save file as one .json; Module.pkbnImport(file) restores one.
+//  - Self-tests: ?env=KEY=VALUE (repeatable) sets environment variables, as the desktop tests do; ?autostart=1 starts
+//    without the tap.
+var Module = typeof Module !== 'undefined' ? Module : {};
+(function () {
+  var query = new URLSearchParams(location.search);
+  Module.noInitialRun = true;
+  Module.preRun = (Module.preRun || []).concat(function () {
+    query.getAll('env').forEach(function (kv) {
+      var i = kv.indexOf('=');
+      if (i > 0) ENV[kv.slice(0, i)] = kv.slice(i + 1);
+    });
+    if (ENV.PKBN_DATA_DIR) FS.mkdirTree(ENV.PKBN_DATA_DIR);   // (self-tests that use their own save folder)
+    FS.mkdir('/save');
+    FS.mount(IDBFS, {}, '/save');
+    addRunDependency('pkbn-saves');
+    FS.syncfs(true, function (err) {
+      if (err) console.error('[pkbn] loading saves:', err);
+      removeRunDependency('pkbn-saves');
+    });
+  });
+
+  var dirty = false, syncing = false;
+  function flush(force) {
+    if ((!dirty && !force) || syncing || typeof FS === 'undefined') return;
+    dirty = false;
+    syncing = true;
+    FS.syncfs(false, function (err) {
+      syncing = false;
+      if (err) console.error('[pkbn] saving:', err);
+      if (Module.pkbnOnSaved) Module.pkbnOnSaved(err);
+    });
+  }
+  Module.pkbnPersist = function () { dirty = true; setTimeout(flush, 50); };
+  setInterval(function () { flush(true); }, 30000);   // the play log and replay are written without a call
+  addEventListener('pagehide', function () { flush(true); });
+  document.addEventListener('visibilitychange', function () { if (document.hidden) flush(true); });
+
+  // Ghost codes: a browser can't read the clipboard synchronously, so pasting asks for the code
+  Module.pkbnCopy = function (text) {
+    if (navigator.clipboard && navigator.clipboard.writeText)
+      navigator.clipboard.writeText(text).catch(function () { prompt('Your ghost code:', text); });
+    else
+      prompt('Your ghost code:', text);
+  };
+  Module.pkbnPaste = function () { return prompt('Paste a ghost code:'); };
+
+  function b64(bytes) {
+    var s = '';
+    for (var i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+    return btoa(s);
+  }
+  Module.pkbnExport = function () {
+    var out = { game: 'pkbn', version: 1, files: {} };
+    FS.readdir('/save').forEach(function (name) {
+      if (name === '.' || name === '..') return;
+      var path = '/save/' + name;
+      if (FS.isFile(FS.stat(path).mode)) out.files[name] = b64(FS.readFile(path));
+    });
+    var blob = new Blob([JSON.stringify(out)], { type: 'application/json' });
+    var a = document.createElement('a');
+    a.href = URL.createObjectURL(blob);
+    a.download = 'pkbn-saves-' + new Date().toISOString().slice(0, 10) + '.json';
+    a.click();
+    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
+  };
+  Module.pkbnImport = function (file, done) {
+    file.text().then(function (text) {
+      var data = JSON.parse(text);
+      if (!data || data.game !== 'pkbn' || !data.files) throw new Error('not a save backup');
+      Object.keys(data.files).forEach(function (name) {
+        if (name.indexOf('/') >= 0) return;
+        var bin = atob(data.files[name]), bytes = new Uint8Array(bin.length);
+        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        FS.writeFile('/save/' + name, bytes);
+      });
+      FS.syncfs(false, function (err) { done(err); });
+    }).catch(function (err) { done(err); });
+  };
+  Module.pkbnStart = function () {
+    if (Module.pkbnStarted) return;
+    Module.pkbnStarted = true;
+    if (Module.pkbnOnStart) Module.pkbnOnStart();
+    Module.callMain([]);
+  };
+  Module.onRuntimeInitialized = function () {
+    if (Module.pkbnReady) Module.pkbnReady();
+    if (query.get('autostart') === '1') Module.pkbnStart();
+  };
+})();
diff --git a/web/shell.html b/web/shell.html
