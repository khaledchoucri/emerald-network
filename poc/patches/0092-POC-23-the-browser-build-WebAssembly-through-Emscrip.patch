+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
+<meta name="theme-color" content="#0b1220">
+<link rel="icon" href="data:,">
+<title>Pokémon × Battle Network</title>
+<style>
+  :root { --bg: #0b1220; --panel: #121c2e; --ink: #e6edf7; --muted: #93a2bb; --line: #24324a; --accent: #f2b84b;
+          --btn: #1a2740; --btn-on: #2c4470; --a: #c8323a; --b: #2f5fd0; }
+  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
+  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink);
+               font: 14px/1.4 "Segoe UI", system-ui, -apple-system, sans-serif; overflow: hidden; touch-action: none; }
+  #app { height: 100%; display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: minmax(0, 1fr); }
+  header { display: flex; align-items: center; gap: 6px; padding: 6px 10px; padding-top: max(6px, env(safe-area-inset-top));
+           border-bottom: 1px solid var(--line); background: var(--panel); }
+  header b { font-size: 13px; letter-spacing: .02em; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+  header button { font: inherit; font-size: 12px; color: var(--ink); background: var(--btn); border: 1px solid var(--line);
+                  border-radius: 6px; padding: 4px 8px; cursor: pointer; }
+  header button:focus-visible { outline: 2px solid var(--accent); }
+  #status { font-size: 12px; color: var(--muted); min-width: 0; }
+  #stage { position: relative; min-height: 0; display: grid; place-items: center; padding: 8px; }
+  canvas#canvas { display: block; image-rendering: pixelated; image-rendering: crisp-edges; background: #000;
+                  width: min(100%, calc((100dvh - 120px) * 1.5)); aspect-ratio: 3 / 2; height: auto; border-radius: 4px; }
+  canvas#canvas:focus { outline: none; }
+  #start { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(11, 18, 32, .86); cursor: pointer; }
+  #start div { text-align: center; }
+  #start h1 { margin: 0 0 6px; font-size: 22px; }
+  #start p { margin: 0; color: var(--muted); }
+  #start .go { margin-top: 14px; display: inline-block; padding: 10px 18px; border-radius: 999px; background: var(--accent);
+               color: #1b1300; font-weight: 700; }
+  /* touch controls: below the screen in portrait, beside it in landscape */
+  #pad { --u: min(50px, 10.5vw); display: none; padding: 6px 12px calc(10px + env(safe-area-inset-bottom));
+         user-select: none; -webkit-user-select: none; }
+  body.touch #pad { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; }
+  .shoulders { grid-column: 1 / -1; display: flex; justify-content: space-between; }
+  .k { display: grid; place-items: center; background: var(--btn); border: 1px solid var(--line); color: var(--ink);
+       font-weight: 700; font-size: 14px; border-radius: 10px; touch-action: none; }
+  .k.on { background: var(--btn-on); border-color: var(--accent); }
+  .sh { width: calc(var(--u) * 1.8); height: 38px; border-radius: 10px 10px 14px 14px; }
+  #dpad { position: relative; width: calc(var(--u) * 3); height: calc(var(--u) * 3); justify-self: start; }
+  #dpad .k { position: absolute; width: var(--u); height: var(--u); border-radius: 8px; }
+  #dpad .u { left: var(--u); top: 0; } #dpad .d { left: var(--u); bottom: 0; } #dpad .l { left: 0; top: var(--u); } #dpad .r { right: 0; top: var(--u); }
+  #dpad .c { left: var(--u); top: var(--u); background: var(--panel); border-radius: 4px; }
+  .mid { display: grid; gap: 8px; justify-items: center; }
+  .mid .row { display: grid; gap: 8px; }
+  .pill { width: 64px; height: 28px; border-radius: 999px; font-size: 11px; }
+  .ff { width: 52px; height: 28px; border-radius: 999px; font-size: 13px; }
+  #ab { position: relative; width: calc(var(--u) * 3); height: calc(var(--u) * 2.6); justify-self: end; }
+  #ab .k { position: absolute; width: calc(var(--u) * 1.28); height: calc(var(--u) * 1.28); border-radius: 50%; font-size: 18px; }
+  #ab .a { right: 0; top: 8px; background: var(--a); } #ab .b { left: 0; bottom: 4px; background: var(--b); }
+  @media (orientation: landscape) and (max-height: 520px) {
+    body.touch #app { grid-template-rows: auto 1fr; }
+    /* the pad sits beside the screen: L and the D-pad on the left, R and A/B on the right, SELECT/START/» under it */
+    body.touch #pad { --u: 50px; position: fixed; inset: 44px 0 0 0; pointer-events: none; background: none;
+                      grid-template-rows: auto 1fr; padding-left: max(12px, env(safe-area-inset-left));
+                      padding-right: max(12px, env(safe-area-inset-right)); }
+    body.touch #pad .k { pointer-events: auto; opacity: .85; }
+    body.touch .mid { align-self: end; grid-auto-flow: column; }
+    body.touch .mid .row { grid-auto-flow: column; }
+    body.touch canvas#canvas { width: min(calc(100% - 2 * 160px), calc((100dvh - 100px) * 1.5)); margin-bottom: 36px; }
+  }
+  dialog { background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 12px; max-width: 420px; }
+  dialog table { border-collapse: collapse; width: 100%; } dialog td { padding: 3px 8px; border-bottom: 1px solid var(--line); }
+  kbd { font: 600 12px ui-monospace, Consolas, monospace; background: var(--btn); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
+  input[type=file] { display: none; }
