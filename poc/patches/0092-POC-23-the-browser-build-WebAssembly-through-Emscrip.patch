+</head>
+<body>
+<div id="app">
+  <header>
+    <b>Pokémon × Battle Network</b>
+    <span id="status">Loading…</span>
+    <button id="btnFull" type="button" title="Fullscreen">⛶</button>
+    <button id="btnKeys" type="button">Keys</button>
+    <button id="btnSaves" type="button">Saves</button>
+  </header>
+  <div id="stage">
+    <canvas id="canvas" width="792" height="528" tabindex="-1" oncontextmenu="event.preventDefault()"></canvas>
+    <div id="start" role="button" tabindex="0" aria-label="Start the game">
+      <div><h1>Pokémon × Battle Network</h1><p id="startMsg">Loading the game…</p><span class="go" id="go" hidden>Tap to start</span></div>
+    </div>
+  </div>
+  <div id="pad" aria-hidden="true">
+    <div class="shoulders"><div class="k sh" data-k="512">L</div><div class="k sh" data-k="256">R</div></div>
+    <div id="dpad"><div class="k u">▲</div><div class="k l">◀</div><div class="k c"></div><div class="k r">▶</div><div class="k d">▼</div></div>
+    <div class="mid">
+      <div class="row"><div class="k pill" data-k="4">SELECT</div><div class="k pill" data-k="8">START</div></div>
+      <div class="k ff" data-k="1024">»</div>
+    </div>
+    <div id="ab"><div class="k b" data-k="2">B</div><div class="k a" data-k="1">A</div></div>
+  </div>
+</div>
+
+<dialog id="dlgKeys">
+  <table>
+    <tr><td>A</td><td><kbd>Z</kbd></td></tr><tr><td>B</td><td><kbd>X</kbd></td></tr>
+    <tr><td>L / R</td><td><kbd>A</kbd> / <kbd>S</kbd></td></tr><tr><td>START</td><td><kbd>Enter</kbd></td></tr>
+    <tr><td>SELECT</td><td><kbd>Backspace</kbd></td></tr><tr><td>+Control Pad</td><td>Arrow keys</td></tr>
+    <tr><td>Fast-forward (hold)</td><td><kbd>Space</kbd></td></tr><tr><td>Pause</td><td><kbd>Ctrl</kbd>+<kbd>P</kbd></td></tr>
+  </table>
+  <p>Gamepads work too: plug one in and press a button.</p>
+  <form method="dialog"><button>Close</button></form>
+</dialog>
+
+<dialog id="dlgSaves">
+  <p>Your game saves in this browser on this device. Keep a backup, or move it to another browser.</p>
+  <p><button id="btnExport" type="button">Download a backup</button>
+     <button id="btnImport" type="button">Restore a backup…</button></p>
+  <input id="fileImport" type="file" accept=".json,application/json">
+  <p id="saveMsg"></p>
+  <form method="dialog"><button>Close</button></form>
+</dialog>
+
+<script>
+(function () {
+  var statusEl = document.getElementById('status'), start = document.getElementById('start');
+  var startMsg = document.getElementById('startMsg'), go = document.getElementById('go');
+  var touch = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
+  if (touch) document.body.classList.add('touch');
+
+  window.Module = window.Module || {};
+  Module.canvas = document.getElementById('canvas');
+  Module.print = function (t) { console.log(t); };
+  Module.printErr = function (t) { console.warn(t); };
+  Module.setStatus = function (t) {
+    var m = /\((\d+(\.\d+)?)\/(\d+)\)/.exec(t || '');
+    statusEl.textContent = m ? 'Loading ' + Math.round(100 * m[1] / m[3]) + '%' : (t || '');
+  };
+  Module.pkbnReady = function () {
+    statusEl.textContent = '';
+    startMsg.textContent = touch ? 'Touch controls are below the screen.' : 'Keyboard or gamepad. Keys are under “Keys”.';
+    go.hidden = false;
+    go.textContent = touch ? 'Tap to start' : 'Click or press a key to start';
+  };
+  Module.pkbnOnSaved = function (err) {
+    statusEl.textContent = err ? 'Couldn’t save in this browser' : 'Saved';
+    clearTimeout(Module._st); Module._st = setTimeout(function () { statusEl.textContent = ''; }, 1500);
+  };
+  Module.pkbnOnStart = function () {   // (also runs for ?autostart=1)
+    if (start.parentNode) start.remove();
+    Module.canvas.focus();
+  };
+  function begin() {
+    if (go.hidden) return;
+    Module.pkbnStart();
+  }
+  start.addEventListener('click', begin);
+  addEventListener('keydown', function (e) { if (document.getElementById('start')) { e.preventDefault(); begin(); } });
+
+  // ---- touch controls -> Module._Web_SetTouchKeys(mask): GBA key bits, 1024 = fast-forward
+  var pointers = {};
+  function keyAt(x, y) {
+    var el = document.elementFromPoint(x, y);
+    if (!el) return 0;
+    var dp = document.getElementById('dpad');
+    if (dp.contains(el)) {
+      var r = dp.getBoundingClientRect(), dx = x - (r.left + r.width / 2), dy = y - (r.top + r.height / 2), k = 0;
+      if (Math.hypot(dx, dy) < 12) return 0;
+      var a = Math.atan2(dy, dx) * 180 / Math.PI;   // 0 = right, 90 = down
+      if (a > -67.5 && a < 67.5) k |= 16;           // right
+      if (a > 112.5 || a < -112.5) k |= 32;         // left
+      if (a < -22.5 && a > -157.5) k |= 64;         // up
+      if (a > 22.5 && a < 157.5) k |= 128;          // down
+      return k;
+    }
+    return +(el.dataset && el.dataset.k) || 0;
+  }
