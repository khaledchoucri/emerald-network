     if (keys & DPAD_UP)
         sC.cursor = sC.cursor ? sC.cursor - 1 : PKBN_CHALLENGE_COUNT - 1, PlaySE(SE_SELECT);
     else if (keys & DPAD_DOWN)
@@ -233,6 +307,8 @@ static void CB2_ChallengeMenu(void)
             case 'A': keys = A_BUTTON; break;
             case 'B': keys = B_BUTTON; break;
             case 'E': keys = SELECT_BUTTON; break;
+            case '<': keys = L_BUTTON; break;
+            case '>': keys = R_BUTTON; break;
             }
             if (*sKeys)
                 sKeys++;
@@ -249,6 +325,13 @@ void PkbnChallengeMenu_Open(MainCallback exitCallback)
     sC.exit = exitCallback;
     sC.iconsFor = 0xFF;
     sC.replay = PkbnReplay_Available();
+    if (getenv("PKBN_TEST_RECORDS") != NULL)   // owtests: some records to show
