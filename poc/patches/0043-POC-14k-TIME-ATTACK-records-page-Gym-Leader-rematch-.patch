-void PkbnChallenge_AfterWin(u8 i, char *line1, char *line2, u32 size)
+void PkbnChallenge_AfterWin(u8 i, u32 frames, char *line1, char *line2, u32 size)
 {
     const struct PkbnChallenge *c = &gPkbnChallenges[i];
+    u16 best = PkbnChallenge_Best(i);
+    u32 s10 = frames * 10 / 60;
+    bool8 record = best == 0 || frames < best;
     line1[0] = line2[0] = '\0';
+    if (frames > 0xFFFF)
+        frames = 0xFFFF;
+    if (record)
+        PkbnChallenge_SetBest(i, frames);
     if (!PkbnChallenge_Cleared(i))
     {
         PkbnChallenge_SetCleared(i);
         PkbnProgram_GrantByName(c->rewards[0], 1);
         PkbnProgram_GrantByName(c->rewards[1], 1);
-        snprintf(line1, size, "%s CLEARED!", c->name);
+        snprintf(line1, size, "%s CLEARED IN %u:%02u.%u!", c->name, (unsigned)(s10 / 600), (unsigned)(s10 / 10 % 60),
+                 (unsigned)(s10 % 10));
         snprintf(line2, size, "GOT PROGRAMS %s AND %s!", c->rewards[0], c->rewards[1]);
     }
     else
@@ -79,7 +87,10 @@ void PkbnChallenge_AfterWin(u8 i, char *line1, char *line2, u32 size)
         char nm[16];
         PkbnPack_Add(mv, LETTER_WILD, 1);
         Pkbn_GameStringToAscii(nm, gMoveNames[mv], sizeof(nm));
-        snprintf(line1, size, "%s CLEARED AGAIN!", c->name);
+        if (record)
+            snprintf(line1, size, "NEW RECORD %u:%02u.%u!", (unsigned)(s10 / 600), (unsigned)(s10 / 10 % 60), (unsigned)(s10 % 10));
+        else
+            snprintf(line1, size, "%s CLEARED AGAIN!", c->name);
         snprintf(line2, size, "GOT %s * CHIP DATA!", nm);
     }
     printf("[pkbn] net challenge %u cleared: %s / %s\n", i, line1, line2);
