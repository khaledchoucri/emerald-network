         Text(fb, CW - 4 - Pkbn_EmTextWidth("SELECT:REPLAY LAST BATTLE", PKBN_FONT_SMALL), CH - 13, "SELECT:REPLAY LAST BATTLE",
              RGB(31, 20, 10));
@@ -191,6 +253,18 @@ static void Leave(u16 result)
 
 static void HandleInput(u16 keys)
 {
+    if (keys & (L_BUTTON | R_BUTTON))
+    {
+        sC.page ^= 1;
