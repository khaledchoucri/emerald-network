+static void TimeText(char *dst, u32 size, u16 frames)
+{
+    u32 s10 = (u32)frames * 10 / 60;
+    if (frames == 0)
+        snprintf(dst, size, "--:--.-");
+    else
+        snprintf(dst, size, "%u:%02u.%u", (unsigned)(s10 / 600), (unsigned)(s10 / 10 % 60), (unsigned)(s10 % 10));
+}
+
+// TIME ATTACK (POC-14): each Gym Leader's best win - fight time, Busting Level - and their Leader chip. Rematches are
+// where the records get beaten: a new record pays a * chip, an S on a rematch makes the chip V3 (src/pkbn/leader.c).
+static void DrawRecords(u16 *fb)
+{
+    u8 l;
+    char line[40], t[16];
+    Pkbn_DrawEmText(fb, 6, 0, "TIME ATTACK", PKBN_FONT_NORMAL, RGB(31, 26, 6), RGB(2, 2, 5));
+    Text(fb, CW - 4 - Pkbn_EmTextWidth("GYM LEADERS", PKBN_FONT_SMALL), 4, "GYM LEADERS", RGB(31, 31, 31));
+    Text(fb, 12, LIST_Y, "LEADER", RGB(16, 18, 24));
+    Text(fb, 110, LIST_Y, "BEST TIME", RGB(16, 18, 24));
+    Text(fb, 170, LIST_Y, "BUSTING", RGB(16, 18, 24));
+    Text(fb, 220, LIST_Y, "CHIP", RGB(16, 18, 24));
+    for (l = 0; l < PKBN_LEADERS; l++)
+    {
+        u16 frames;
+        u8 level, chip = PkbnLeader_Chip(l);
+        s32 y = LIST_Y + 14 + l * 14;
+        PkbnLeader_Record(l, &frames, &level);
+        Pkbn_FillRect(fb, 6, y - 1, CW - 12, 13, l & 1 ? RGB(2, 3, 9) : RGB(3, 5, 12));
+        Text(fb, 12, y, Leader_Name(l), frames ? RGB(31, 31, 31) : RGB(12, 13, 16));
+        TimeText(t, sizeof(t), frames);
+        Text(fb, 110, y, t, frames ? RGB(8, 28, 31) : RGB(12, 13, 16));
+        if (level)
+        {
+            if (level >= 11)
+                snprintf(line, sizeof(line), "S");
+            else
+                snprintf(line, sizeof(line), "%u", level);
+            Text(fb, 186, y, line, level >= 11 ? RGB(31, 26, 6) : RGB(31, 31, 31));
+        }
+        if (chip)
+        {
+            snprintf(line, sizeof(line), "V%u", chip);
+            Text(fb, 224, y, line, RGB(10, 31, 12));
+        }
+    }
+}
+
