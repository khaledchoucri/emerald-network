diff --git a/src/pkbn/challenge_ui.c b/src/pkbn/challenge_ui.c
new file mode 100644
index 0000000..a3b7966
--- /dev/null
+++ b/src/pkbn/challenge_ui.c
@@ -0,0 +1,247 @@
+// NET CHALLENGE list (POC-14): PC -> NET CHALLENGE. Drawn on our 264x176 canvas like the FOLDER screen.
+// Up/Down: pick a challenge. A: start it (gSpecialVar_Result = its index). B: back (0xFF).
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "data.h"
+#include "main.h"
+#include "pokemon.h"
+#include "sound.h"
+#include "event_data.h"
+#include "constants/songs.h"
+#include "pkbn/challenge.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/render.h"
+#include "pkbn/gfx.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+#define CW PKBN_CANVAS_W
+#define CH PKBN_CANVAS_H
+#define RGB PKBN_RGB
+#define LIST_X 4
+#define LIST_Y 24
+#define ROW_H 11
+#define PANEL_X 150
+
+static struct
+{
+    MainCallback exit;
+    u8 cursor;
+    u8 iconsFor;
+    u16 icons[PARTY_SIZE][32 * 32];
+    u32 t;
+} sC;
+
+static const char *sKeys;
+static u32 sKeyClock;
+
+static s32 Text(u16 *fb, s32 x, s32 y, const char *s, u16 col)
+{
+    return Pkbn_DrawEmText(fb, x, y, s, PKBN_FONT_SMALL, col, RGB(2, 2, 5));
+}
+
+static s32 TextWrap(u16 *fb, s32 x, s32 y, s32 width, s32 lines, const char *s, u16 col)
+{
+    char line[96];
+    while (*s && lines-- > 0)
+    {
+        s32 n = 0, lastSpace = -1;
+        while (s[n] && n < (s32)sizeof(line) - 1)
+        {
+            memcpy(line, s, n + 1);
+            line[n + 1] = '\0';
+            if (Pkbn_EmTextWidth(line, PKBN_FONT_SMALL) > width)
+                break;
+            if (s[n] == ' ')
+                lastSpace = n;
+            n++;
+        }
+        if (s[n] && lastSpace > 0)
+            n = lastSpace;
+        memcpy(line, s, n);
+        line[n] = '\0';
+        Text(fb, x, y, line, col);
+        y += 10;
+        s += n;
+        while (*s == ' ')
+            s++;
+    }
+    return y;
+}
+
+static void LoadIcons(void)
+{
+    const struct PkbnChallenge *c = &gPkbnChallenges[sC.cursor];
+    u8 i;
+    for (i = 0; i < c->monCount; i++)
+        Pkbn_DecodeMonIcon(sC.icons[i], c->mons[i].species, 0, 0);
+    sC.iconsFor = sC.cursor;
+}
+
+static void DrawList(u16 *fb)
+{
+    u8 i, cleared = 0;
+    char line[40];
+    for (i = 0; i < PKBN_CHALLENGE_COUNT; i++)
+        cleared += PkbnChallenge_Cleared(i);
+    Pkbn_DrawEmText(fb, 6, 0, "NET CHALLENGE", PKBN_FONT_NORMAL, RGB(8, 28, 31), RGB(2, 2, 5));
+    snprintf(line, sizeof(line), "CLEARED %u/%u", cleared, PKBN_CHALLENGE_COUNT);
+    Text(fb, CW - 4 - Pkbn_EmTextWidth(line, PKBN_FONT_SMALL), 4, line, RGB(31, 31, 31));
+    for (i = 0; i < PKBN_CHALLENGE_COUNT; i++)
+    {
+        s32 y = LIST_Y + i * ROW_H;
+        bool8 open = PkbnChallenge_Unlocked(i), on = i == sC.cursor;
+        if (on)
+        {
+            Pkbn_FillRect(fb, LIST_X, y, PANEL_X - LIST_X - 4, ROW_H, RGB(6, 10, 22));
+            Pkbn_FrameRect(fb, LIST_X, y, PANEL_X - LIST_X - 4, ROW_H, RGB(8, 28, 31));
+        }
+        if (PkbnChallenge_Cleared(i))
+            Text(fb, LIST_X + 3, y, "*", RGB(31, 26, 6));
+        Text(fb, LIST_X + 12, y, gPkbnChallenges[i].name, open ? RGB(31, 31, 31) : RGB(12, 13, 16));
+        if (!open)
+        {
+            snprintf(line, sizeof(line), gPkbnChallenges[i].badges == PKBN_CHALLENGE_BADGES_CHAMPION ? "CHAMP"
+                     : gPkbnChallenges[i].badges == 1 ? "%u BADGE" : "%u BADGES",
+                     gPkbnChallenges[i].badges);
+            Text(fb, PANEL_X - 8 - Pkbn_EmTextWidth(line, PKBN_FONT_SMALL), y, line, RGB(20, 10, 10));
+        }
+    }
+}
+
+static void DrawPanel(u16 *fb)
+{
+    static const char *const sWeather[] = { NULL, "SUN", "RAIN", "SANDSTORM", "HAIL" };
+    static const char *const sPanels[] = { NULL, "CRACKED PANELS", "HOLY PANELS", "CURRENTS", "POISON PANELS" };
+    const struct PkbnChallenge *c = &gPkbnChallenges[sC.cursor];
+    bool8 open = PkbnChallenge_Unlocked(sC.cursor), done = PkbnChallenge_Cleared(sC.cursor);
+    char line[64];
+    s32 i, y, lo = 100, hi = 0;
+    if (sC.iconsFor != sC.cursor)
+        LoadIcons();
+    Pkbn_FillRect(fb, PANEL_X, LIST_Y - 2, CW - PANEL_X - 4, CH - LIST_Y - 24, RGB(2, 3, 9));
+    Pkbn_FrameRect(fb, PANEL_X, LIST_Y - 2, CW - PANEL_X - 4, CH - LIST_Y - 24, RGB(8, 10, 16));
+    for (i = 0; i < c->monCount; i++)
+        Pkbn_BlitIcon(fb, sC.icons[i], PANEL_X + 4 + (i % 3) * 34, LIST_Y - 6 + (i / 3) * 26, FALSE,
+                      open ? 0 : RGB(4, 4, 8));
+    y = LIST_Y + 2 + ((c->monCount + 2) / 3) * 26;
+    y = TextWrap(fb, PANEL_X + 4, y, CW - PANEL_X - 12, 2, c->desc, RGB(22, 26, 31));
+    for (i = 0; i < c->monCount; i++)
+    {
+        if (c->mons[i].level < lo) lo = c->mons[i].level;
+        if (c->mons[i].level > hi) hi = c->mons[i].level;
+    }
+    if (lo == hi)
+        snprintf(line, sizeof(line), "%u FOES LV%u, %u AT ONCE", c->monCount, lo, c->together);
+    else
+        snprintf(line, sizeof(line), "%u FOES LV%u-%u, %u AT ONCE", c->monCount, lo, hi, c->together);
+    Text(fb, PANEL_X + 4, y, line, RGB(31, 31, 31));
+    y += 10;
+    line[0] = '\0';
+    if (c->weather)
+        snprintf(line, sizeof(line), "%s", sWeather[c->weather]);
+    if (c->panels)
+        snprintf(line + strlen(line), sizeof(line) - strlen(line), "%s%s", line[0] ? ", " : "", sPanels[c->panels]);
+    if (c->seconds)
+        snprintf(line + strlen(line), sizeof(line) - strlen(line), "%s%u SEC", line[0] ? ", " : "", c->seconds);
+    if (line[0])
+    {
+        Text(fb, PANEL_X + 4, y, line, RGB(31, 20, 10));
+        y += 10;
+    }
+    snprintf(line, sizeof(line), "FOE STRENGTH %u/5", c->tier);
+    Text(fb, PANEL_X + 4, y, line, RGB(16, 18, 24));
+    y += 11;
+    if (done)
+        Text(fb, PANEL_X + 4, y, "CLEARED: PAYS * CHIP DATA", RGB(31, 26, 6));
+    else
+    {
+        Text(fb, PANEL_X + 4, y, "FIRST CLEAR PAYS PROGRAMS", RGB(10, 31, 12));
+        snprintf(line, sizeof(line), "%s + %s", c->rewards[0], c->rewards[1]);
+        Text(fb, PANEL_X + 10, y + 10, line, RGB(10, 31, 12));
+    }
+}
+
+static void Draw(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < CW * CH; i++)
+        fb[i] = RGB(1, 2, 6);
+    for (i = 0; i < CH; i += 16)
+        Gfx_FillBlend(fb, 0, (i + (s32)(sC.t / 4)) % CH, CW, 1, RGB(4, 18, 22), 4);
+    DrawList(fb);
+    DrawPanel(fb);
+    Pkbn_FillRect(fb, 0, CH - 13, CW, 13, RGB(1, 2, 5));
+    Text(fb, 4, CH - 13, PkbnChallenge_Unlocked(sC.cursor) ? "A:JACK IN  B:BACK   A SIMULATION: NOTHING IS LOST"
+                                                           : "LOCKED: EARN MORE BADGES   B:BACK", RGB(16, 18, 24));
+}
+
+static void Leave(u16 result)
+{
+    gSpecialVar_Result = result;
+    gPkbnCanvasOverlay = NULL;
+    SetMainCallback2(sC.exit);
+}
+
+static void HandleInput(u16 keys)
+{
+    if (keys & DPAD_UP)
+        sC.cursor = sC.cursor ? sC.cursor - 1 : PKBN_CHALLENGE_COUNT - 1, PlaySE(SE_SELECT);
+    else if (keys & DPAD_DOWN)
+        sC.cursor = (sC.cursor + 1) % PKBN_CHALLENGE_COUNT, PlaySE(SE_SELECT);
+    else if (keys & A_BUTTON)
+    {
+        if (!PkbnChallenge_Unlocked(sC.cursor))
+        {
+            PlaySE(SE_FAILURE);
+            return;
+        }
+        PlaySE(SE_SELECT);
+        Leave(sC.cursor);
+    }
+    else if (keys & B_BUTTON)
+    {
+        PlaySE(SE_SELECT);
+        Leave(0xFF);
+    }
+}
+
+static void CB2_ChallengeMenu(void)
+{
+    u16 keys = gMain.newKeys;
+    sC.t++;
+    if (sKeys != NULL)
+    {
+        keys = 0;
+        if (++sKeyClock % 4 == 0)
+        {
+            switch (*sKeys)
+            {
+            case 'U': keys = DPAD_UP; break;
+            case 'D': keys = DPAD_DOWN; break;
+            case 'A': keys = A_BUTTON; break;
+            case 'B': keys = B_BUTTON; break;
+            }
+            if (*sKeys)
+                sKeys++;
+            if (*sKeys == '\0')
+                sKeys = NULL;   // the script is done: real keys again
+        }
+    }
+    HandleInput(keys);
+}
+
+void PkbnChallengeMenu_Open(MainCallback exitCallback)
+{
+    memset(&sC, 0, sizeof(sC));
+    sC.exit = exitCallback;
+    sC.iconsFor = 0xFF;
+    sKeys = getenv("PKBN_TEST_CHALLENGE_KEYS");
+    sKeyClock = 0;
+    gPkbnCanvasOverlay = Draw;
+    SetMainCallback2(CB2_ChallengeMenu);
+}
+
+#endif // PORTABLE
