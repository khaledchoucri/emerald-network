@@ -0,0 +1,47 @@
+#ifndef GUARD_PKBN_CHALLENGE_H
+#define GUARD_PKBN_CHALLENGE_H
+
+#include "main.h"
+
+// NET CHALLENGE (POC-14): custom battles from the PC, our own content (TUNE throughout). A challenge is a
+// simulation: nothing is lost, no EXP is gained, and the first clear pays two NaviCust programs.
+
+enum { CH_WEATHER_NONE, CH_WEATHER_SUN, CH_WEATHER_RAIN, CH_WEATHER_SAND, CH_WEATHER_HAIL };
+enum { CH_PANELS_NONE, CH_PANELS_CRACKED, CH_PANELS_HOLY, CH_PANELS_CURRENT, CH_PANELS_POISON };
+
+#define PKBN_CHALLENGE_COUNT 12
+#define PKBN_CHALLENGE_BADGES_CHAMPION 9   // "badges" 9: the Champion beaten (FLAG_SYS_GAME_CLEAR)
+
+struct PkbnChallengeMon
+{
+    u16 species;
+    u8 level;
+    u16 moves[MAX_MON_MOVES];
+};
+
+struct PkbnChallenge
+{
+    const char *name;
+    const char *desc;
+    u8 badges;       // badges needed to open it
+    u8 tier;         // rival strength of the foes (AI, NaviCust, combos and PAs)
+    u8 together;     // foes on the grid at once; the rest come in as they fall
+    u8 weather;
+    u8 panels;
+    u16 seconds;     // time limit, 0 = none
+    const char *rewards[2];   // NaviCust programs for the first clear
+    u8 monCount;
+    struct PkbnChallengeMon mons[PARTY_SIZE];
+};
+
+extern const struct PkbnChallenge gPkbnChallenges[PKBN_CHALLENGE_COUNT];
+extern u8 gPkbnChallengeActive;   // 0: none; else the running challenge + 1
+
+u8 PkbnChallenge_Badges(void);                 // badges for unlocking, 9 once the game is cleared
+bool8 PkbnChallenge_Unlocked(u8 i);
+void PkbnChallenge_BuildParty(u8 i);           // fills gEnemyParty
+// After a challenge battle: the first clear pays its programs; any clear pays a * copy of a foe's move.
+void PkbnChallenge_AfterWin(u8 i, char *line1, char *line2, u32 size);
+void PkbnChallengeMenu_Open(MainCallback exitCallback);   // the NET CHALLENGE list (gSpecialVar_Result: pick or 0xFF)
+
+#endif // GUARD_PKBN_CHALLENGE_H
