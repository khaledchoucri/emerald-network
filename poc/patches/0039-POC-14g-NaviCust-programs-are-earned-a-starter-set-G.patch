diff --git a/src/pkbn/challenge.c b/src/pkbn/challenge.c
new file mode 100644
index 0000000..3782125
--- /dev/null
+++ b/src/pkbn/challenge.c
@@ -0,0 +1,88 @@
+// NET CHALLENGE (POC-14): custom battles on the PC that pay NaviCust programs. Our own content (TUNE): the foes,
+// levels, rules and rewards are not from either game. See include/pkbn/challenge.h.
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "pokemon.h"
+#include "event_data.h"
+#include "random.h"
+#include "constants/species.h"
+#include "constants/moves.h"
+#include "constants/flags.h"
+#include "pkbn/challenge.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/navicust.h"
+#include "pkbn/folder.h"
+#include "pkbn/render.h"
+#include "data.h"
+
+u8 gPkbnChallengeActive;
+
+const struct PkbnChallenge gPkbnChallenges[PKBN_CHALLENGE_COUNT] = {
+#include "challenge_table.inc"
+};
+
+u8 PkbnChallenge_Badges(void)
+{
+    u8 b = 0;
+    u16 f;
+    if (FlagGet(FLAG_SYS_GAME_CLEAR))
+        return PKBN_CHALLENGE_BADGES_CHAMPION;
+    for (f = FLAG_BADGE01_GET; f <= FLAG_BADGE08_GET; f++)
+        b += FlagGet(f) ? 1 : 0;
+    return b;
+}
+
+bool8 PkbnChallenge_Unlocked(u8 i)
+{
+    return i < PKBN_CHALLENGE_COUNT && PkbnChallenge_Badges() >= gPkbnChallenges[i].badges;
+}
+
+void PkbnChallenge_BuildParty(u8 i)
+{
+    const struct PkbnChallenge *c = &gPkbnChallenges[i];
+    u8 m, k;
+    ZeroEnemyPartyMons();
+    for (m = 0; m < c->monCount && m < PARTY_SIZE; m++)
+    {
+        // full IVs, like a strong trainer (CreateNPCTrainerParty uses fixedIV from the party data)
+        CreateMon(&gEnemyParty[m], c->mons[m].species, c->mons[m].level, MAX_PER_STAT_IVS, FALSE, 0, OT_ID_RANDOM_NO_SHINY, 0);
+        for (k = 0; k < MAX_MON_MOVES; k++)
+        {
+            u16 mv = c->mons[m].moves[k];
+            u8 pp = gBattleMoves[mv].pp;
+            SetMonData(&gEnemyParty[m], MON_DATA_MOVE1 + k, &mv);
+            SetMonData(&gEnemyParty[m], MON_DATA_PP1 + k, &pp);
+        }
+    }
+    printf("[pkbn] net challenge %u: %s, %u Pokemon, tier %u, %u at once\n", i, c->name, c->monCount, c->tier, c->together);
+}
+
+void PkbnChallenge_AfterWin(u8 i, char *line1, char *line2, u32 size)
+{
+    const struct PkbnChallenge *c = &gPkbnChallenges[i];
+    line1[0] = line2[0] = '\0';
+    if (!PkbnChallenge_Cleared(i))
+    {
+        PkbnChallenge_SetCleared(i);
+        PkbnProgram_GrantByName(c->rewards[0], 1);
+        PkbnProgram_GrantByName(c->rewards[1], 1);
+        snprintf(line1, size, "%s CLEARED!", c->name);
+        snprintf(line2, size, "GOT PROGRAMS %s AND %s!", c->rewards[0], c->rewards[1]);
+    }
+    else
+    {
+        // a repeat clear: a * copy of one of the foes' moves (TUNE)
+        const struct PkbnChallengeMon *m = &c->mons[Random() % c->monCount];
+        u16 mv = m->moves[Random() % MAX_MON_MOVES];
+        char nm[16];
+        PkbnPack_Add(mv, LETTER_WILD, 1);
+        Pkbn_GameStringToAscii(nm, gMoveNames[mv], sizeof(nm));
+        snprintf(line1, size, "%s CLEARED AGAIN!", c->name);
+        snprintf(line2, size, "GOT %s * CHIP DATA!", nm);
+    }
+    printf("[pkbn] net challenge %u cleared: %s / %s\n", i, line1, line2);
+}
+
+#endif // PORTABLE
