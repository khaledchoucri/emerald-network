+// A NET CHALLENGE's preset field (POC-14, TUNE): permanent weather and panels that never fade.
+void Field_ChallengeConditions(u8 weather, u8 panels)
+{
+    static const u8 sPanelType[] = { 0, PANEL_CRACKED, PANEL_HOLY, 0, PANEL_POISON };
+    s32 side, n;
+    switch (weather)
+    {
+    case CH_WEATHER_SUN:  sB.weather = B_WEATHER_SUN; SetMsg("THE SUNLIGHT IS STRONG.", 70); break;
+    case CH_WEATHER_RAIN: sB.weather = B_WEATHER_RAIN_TEMPORARY | B_WEATHER_RAIN_PERMANENT; SetMsg("IT IS RAINING.", 70); break;
+    case CH_WEATHER_SAND: sB.weather = B_WEATHER_SANDSTORM; SetMsg("A SANDSTORM IS RAGING.", 70); break;
+    case CH_WEATHER_HAIL: sB.weather = B_WEATHER_HAIL; SetMsg("IT IS HAILING.", 70); break;
+    }
+    if (panels == CH_PANELS_CURRENT)
+    {
+        // currents on both sides' middle rows and the top row of the foes' side, carrying toward each back
+        sB.panel[1][0] = PANEL_ROAD_LEFT;
+        sB.panel[1][GRID_COLS - 1] = PANEL_ROAD_RIGHT;
+        sB.panel[0][PLAYER_COLS - 1] = PANEL_ROAD_LEFT;
+        sB.panel[2][PLAYER_COLS] = PANEL_ROAD_RIGHT;
+        return;
+    }
+    if (panels == CH_PANELS_NONE)
+        return;
+    for (side = 0; side < 2; side++)
+    {
+        n = panels == CH_PANELS_HOLY ? 1 : 2;
+        while (n > 0)
+        {
+            s8 x = (side == SIDE_PLAYER ? 0 : PLAYER_COLS) + Random() % PLAYER_COLS, y = Random() % GRID_ROWS;
+            if (sB.panel[y][x] != PANEL_NORMAL || (y == 1 && (x == 1 || x == 4)) || (side == SIDE_ENEMY && x == 5))
+                continue;   // not where the fighters start (the pack's back corners included)
+            sB.panel[y][x] = sPanelType[panels];
+            n--;
+        }
+    }
+}
+
