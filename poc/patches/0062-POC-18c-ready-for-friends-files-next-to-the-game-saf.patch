+// ---- pkbn POC-18: where files live, the log, the window ------------------------------------------------------------
+// Saves, logs, the play log and the replay go next to the game (SDL_GetBasePath), not wherever it was launched from.
+// If that folder can't be written (an install folder), they go to the user's app-data folder (SDL_GetPrefPath).
+// PKBN_DATA_DIR overrides both (the test scripts keep using the folder they run in).
+#define PKBN_GAME_TITLE "Pokemon x Battle Network " PKBN_VERSION
+static char sDataDir[1024];
+
+static bool DirWritable(const char *dir)
+{
+    char probe[1100];
+    FILE *f;
+    snprintf(probe, sizeof(probe), "%s.pkbn_write_test", dir);
+    f = fopen(probe, "ab");
+    if (f == NULL)
+        return false;
+    fclose(f);
+    remove(probe);
+    return true;
+}
+
+static void InitDataDir(void)
+{
+    const char *env = getenv("PKBN_DATA_DIR");
+    char *base;
+    if (env != NULL)
+    {
+        snprintf(sDataDir, sizeof(sDataDir), "%s%s", env, (env[0] && env[strlen(env) - 1] != '/' && env[strlen(env) - 1] != '\\') ? "/" : "");
+        return;
+    }
+    base = SDL_GetBasePath();
+    if (base != NULL && DirWritable(base))
+    {
+        snprintf(sDataDir, sizeof(sDataDir), "%s", base);
+        SDL_free(base);
+        return;
+    }
+    if (base != NULL)
+        SDL_free(base);
+    base = SDL_GetPrefPath("pkbn", "PokemonBattleNetwork");
+    snprintf(sDataDir, sizeof(sDataDir), "%s", base != NULL ? base : "");
+    if (base != NULL)
+        SDL_free(base);
+}
+
+// The full path of one of our files (a few rotating buffers, so two can be in use at once).
+const char *Platform_DataPath(const char *file)
+{
+    static char sBuf[4][1100];
+    static int sNext;
+    char *out = sBuf[sNext++ & 3];
+    if (sDataDir[0] == '\0' && getenv("PKBN_DATA_DIR") == NULL)
+        InitDataDir();
+    snprintf(out, 1100, "%s%s", sDataDir, file);
+    return out;
+}
+
+static bool sFullscreen;
+static void ToggleFullscreen(void)
+{
+    sFullscreen = !sFullscreen;
+    SDL_SetWindowFullscreen(sdlWindow, sFullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+}
