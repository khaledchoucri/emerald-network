+// POC-18: read one file into `tmp`. FALSE if it's missing or not a save we can read.
+static bool8 ReadFile(const char *path, struct PkbnSaveFile *tmp)
+{
+    FILE *f = fopen(path, "rb");
+    size_t got;
+    memset(tmp, 0, sizeof(*tmp));
+    if (f == NULL)
+        return FALSE;
+    got = fread(tmp, 1, sizeof(*tmp), f);
+    fclose(f);
+    if (got < V1_SIZE || memcmp(tmp->magic, "PKBNSAVE", 8) != 0 || tmp->version == 0 || tmp->version > PKBN_SAVE_VERSION)
+        return FALSE;
+    if (tmp->version == PKBN_SAVE_VERSION && got < sizeof(*tmp))
+        memset((u8 *)tmp + got, 0, sizeof(*tmp) - got);   // fields appended without a version bump start empty
+    return TRUE;
+}
+
 void PkbnSave_Read(void)
 {
-    FILE *f = fopen(PKBN_SAVE_PATH, "rb");
     struct PkbnSaveFile tmp;
     s32 i;
-    size_t got;
-    memset(&tmp, 0, sizeof(tmp));
-    got = (f != NULL) ? fread(&tmp, 1, sizeof(tmp), f) : 0;
-    if (f != NULL)
-        fclose(f);
-    if (got < V1_SIZE || memcmp(tmp.magic, "PKBNSAVE", 8) != 0 || tmp.version == 0 || tmp.version > PKBN_SAVE_VERSION
-     || (tmp.version == PKBN_SAVE_VERSION && got != sizeof(tmp)))
+    if (!ReadFile(PKBN_SAVE_PATH, &tmp))
     {
-        PkbnSave_Reset();
-        return;
+        // POC-18: never silently lose a friend's data. The last good copy (written before every save) is tried; a
+        // file we can't read is kept as pkbn.sav.bad rather than overwritten at the next save.
+        FILE *f = fopen(PKBN_SAVE_PATH, "rb");
+        if (f != NULL)
+        {
+            fclose(f);
+            remove(PKBN_SAVE_BAD);
+            rename(PKBN_SAVE_PATH, PKBN_SAVE_BAD);
+            printf("[pkbn] pkbn.sav couldn't be read; kept as pkbn.sav.bad\n");
+        }
+        if (!ReadFile(PKBN_SAVE_BAK, &tmp))
+        {
+            // nothing to read: start like a new game's economy (programs are earned), not "everything unlocked"
+            PkbnSave_Reset();
+            if (getenv("PKBN_SELFTEST") == NULL)   // (self-tests keep every program, as before)
+            {
+                memset(sSave.owned, 0, sizeof(sSave.owned));
+                sSave.programEconomy = 1;
+            }
+            return;
+        }
+        printf("[pkbn] read pkbn.sav.bak instead\n");
     }
     if (tmp.version == 1)
         memset((u8 *)&tmp + V1_SIZE, 0, sizeof(tmp) - V1_SIZE); // v1 -> v3: an empty pack (filled by SyncLearned)
@@ -151,13 +186,25 @@ void PkbnSave_Read(void)
     sSave.ncpCount = NCP_COUNT;
 }
 
+// POC-18: written whole to pkbn.sav.tmp first, then swapped in; the previous file is kept as pkbn.sav.bak. A crash or
+// a full disk mid-write can't leave a half-written pkbn.sav.
 void PkbnSave_Write(void)
 {
-    FILE *f = fopen(PKBN_SAVE_PATH, "wb");
+    FILE *f = fopen(PKBN_SAVE_TMP, "wb");
+    bool8 ok;
     if (f == NULL)
         return;
-    fwrite(&sSave, 1, sizeof(sSave), f);
-    fclose(f);
+    ok = fwrite(&sSave, 1, sizeof(sSave), f) == sizeof(sSave);
+    ok = (fclose(f) == 0) && ok;
+    if (!ok)
+    {
+        remove(PKBN_SAVE_TMP);
+        return;
+    }
+    remove(PKBN_SAVE_BAK);
+    rename(PKBN_SAVE_PATH, PKBN_SAVE_BAK);   // (fails harmlessly when there's no pkbn.sav yet)
+    if (rename(PKBN_SAVE_TMP, PKBN_SAVE_PATH) != 0)
+        rename(PKBN_SAVE_BAK, PKBN_SAVE_PATH);
 }
 
