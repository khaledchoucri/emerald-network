+// POC-19: BN6's Regular Chip, one per folder ("Choose a chip to use as a Regular Chip!", bn6f
+// data/textscript/compressed/CompText86CEE84.s)
+bool8 PkbnFolder_Regular(u8 folder, u16 *move, u8 *letter)
+{
+    if (folder >= PKBN_FOLDERS || sSave.regMove[folder] == MOVE_NONE)
+        return FALSE;
+    *move = sSave.regMove[folder];
+    *letter = sSave.regLetter[folder];
+    return TRUE;
+}
+
+void PkbnFolder_SetRegular(u8 folder, u16 move, u8 letter)
+{
+    if (folder >= PKBN_FOLDERS)
+        return;
+    sSave.regMove[folder] = move;
+    sSave.regLetter[folder] = letter;
+}
