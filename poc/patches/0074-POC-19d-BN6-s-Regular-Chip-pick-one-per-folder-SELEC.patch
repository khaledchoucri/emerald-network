+// POC-19: BN6's Regular Chip - the folder's chosen chip is in the first hand of every battle (PkbnFolder_Regular).
+static void DealRegular(void)
+{
+    u16 rm;
+    u8 rl;
+    s32 i, p;
+    if (sB.regDealt || sB.challenge)
+        return;
+    sB.regDealt = TRUE;
+    if (!PkbnFolder_Regular(PkbnFolder_Equipped(), &rm, &rl))
+        return;
+    for (i = 0; i < sB.handCount; i++)
+        if (sB.folder.chips[sB.hand[i]].move == rm && sB.folder.chips[sB.hand[i]].letter == rl)
+        {
+            PKBN_LOG("regular chip already in hand: move %u", rm);
+            return;   // dealt already
+        }
+    for (p = 0; p < sB.folder.pileCount; p++)
+    {
+        u8 idx = sB.folder.pile[p];
+        if (sB.folder.chips[idx].move != rm || sB.folder.chips[idx].letter != rl || !ChipAlive(idx))
+            continue;
+        if (sB.handCount < sB.handSize)
+        {
+            sB.hand[sB.handCount++] = idx;
+            memmove(&sB.folder.pile[p], &sB.folder.pile[p + 1], sB.folder.pileCount - p - 1);
+            sB.folder.pileCount--;
+        }
+        else
+        {
+            sB.folder.pile[p] = sB.hand[0];
+            sB.hand[0] = idx;
+        }
+        PKBN_LOG("regular chip dealt: move %u", rm);
+        return;
+    }
+}
