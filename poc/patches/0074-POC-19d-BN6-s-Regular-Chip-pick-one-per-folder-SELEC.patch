+// POC-19: how big (MB) a Regular Chip may be. BN6 has a limit that RegUP programs raise ("RegUP",
+// bn6f data/textscript/TextScript873D9FC.s); here it grows with badges instead (TUNE): 20 MB, +5 per badge.
+u8 PkbnFolder_RegularMB(void)
+{
+    s32 b, n = 0;
+    for (b = 0; b < PKBN_LEADERS; b++)
+        n += FlagGet(FLAG_BADGE01_GET + b) ? 1 : 0;
+    return (u8)(20 + 5 * n);
+}
