+// Test bot (POC-12): would the player's `move` (or a PA of `kind`) used from (x, y) reach the panel (tx, ty)?
+// Position-free kinds always do. Uses the real shapes (DirectCells, BlastCells).
+bool8 Moves_WouldHit(u8 kind, u16 move, s8 x, s8 y, s8 tx, s8 ty)
+{
+    struct Attack a;
+    u8 cells[GRID_ROWS][GRID_COLS];
+    memset(&a, 0, sizeof(a));
+    a.side = SIDE_PLAYER;
+    a.kind = kind;
+    if (move < MOVES_COUNT)
+        a.info = gPkbnMoveInfo[move];
+    switch (kind)
+    {
+    case GK_CANNON: case GK_AIRSHOT: case GK_SPREADER: case GK_VULCAN:
+    case GK_SWORD: case GK_LONGSWORD: case GK_WIDESWORD: case GK_LIFESWORD: case GK_LINE3:
+    case GK_DASH: case GK_CONE: case GK_TORNADO:
+        DirectCells(SIDE_PLAYER, &a, x, y, cells);
+        return cells[ty][tx] != 0;
+    case GK_BOMB:
+        BlastCells(a.info.pattern, x + GRENADE_RANGE, y, cells);
+        return InGrid(x + GRENADE_RANGE, y) && cells[ty][tx] != 0;
+    case GK_SHOCKWAVE: case GK_WAVE: case GK_BALL: case GK_DELAYED:
+        return ty == y || (a.info.rows == 3 && kind != GK_BALL && kind != GK_DELAYED);
+    case GK_AIRHOCKEY:
+        return TRUE;   // bounces around: close enough
+    }
+    return TRUE;
+}
+
 static void EnemyAreaCells(u8 side, u8 cells[GRID_ROWS][GRID_COLS])
 {
     s32 r, c;
