+            else
+                memset(sC.icons[i], 0, sizeof(sC.icons[i]));
+        return;
+    }
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (i < sC.ghosts[sC.gCursor - 1].count)
+            Pkbn_DecodeMonIcon(sC.icons[i], sC.ghosts[sC.gCursor - 1].mon[i].species, 0, 0);
+        else
+            memset(sC.icons[i], 0, sizeof(sC.icons[i]));
+}
+
+static void DrawGhosts(u16 *fb)
+{
+    char line[40], t[16];
+    u8 i, n = sC.ghostCount + 1;
+    Pkbn_DrawEmText(fb, 6, 0, "GHOSTS", PKBN_FONT_NORMAL, RGB(22, 14, 31), RGB(2, 2, 5));
+    snprintf(line, sizeof(line), "%u", sC.ghostCount);
+    Text(fb, CW - 4 - Pkbn_EmTextWidth(line, PKBN_FONT_SMALL), 4, line, RGB(31, 31, 31));
+    for (i = 0; i < n && i < LIST_ROWS; i++)
+    {
+        s32 y = LIST_Y + i * ROW_H;
+        u16 frames;
+        u8 bust;
+        if (i == sC.gCursor)
+        {
+            Pkbn_FillRect(fb, LIST_X, y, PANEL_X - LIST_X - 4, ROW_H, RGB(10, 5, 20));
+            Pkbn_FrameRect(fb, LIST_X, y, PANEL_X - LIST_X - 4, ROW_H, RGB(22, 14, 31));
+        }
+        if (i == 0)
+        {
+            Text(fb, LIST_X + 12, y, "YOU", RGB(31, 26, 6));
+            continue;
+        }
+        Text(fb, LIST_X + 12, y, sC.ghosts[i - 1].name, RGB(31, 31, 31));
+        if (PkbnGhost_Best(sC.ghosts[i - 1].hash, &frames, &bust))
+        {
+            Text(fb, LIST_X + 3, y, "*", RGB(31, 26, 6));
+            TimeText(t, sizeof(t), frames);
+            Text(fb, PANEL_X - 50, y, t, RGB(8, 28, 31));
+        }
+    }
+    // the team
+    GhostIcons();
+    Pkbn_FillRect(fb, PANEL_X, LIST_Y - 2, CW - PANEL_X - 4, CH - LIST_Y - 24, RGB(4, 2, 10));
+    Pkbn_FrameRect(fb, PANEL_X, LIST_Y - 2, CW - PANEL_X - 4, CH - LIST_Y - 24, RGB(14, 8, 22));
+    for (i = 0; i < PARTY_SIZE; i++)
+        Pkbn_BlitIcon(fb, sC.icons[i], PANEL_X + 4 + (i % 3) * 34, LIST_Y - 6 + (i / 3) * 26, FALSE,
+                      sC.gCursor ? RGB(14, 10, 24) : 0);   // a friend's ghost is a ghost: tinted
+    if (sC.gCursor > 0)
+    {
+        u16 frames;
+        u8 bust;
+        const struct PkbnGhost *g = &sC.ghosts[sC.gCursor - 1];
+        s32 y = LIST_Y + 2 + 2 * 26;
+        for (i = 0; i < g->count; i++)
+        {
+            snprintf(line, sizeof(line), "Lv%u", g->mon[i].level);
+            Text(fb, PANEL_X + 4 + (i % 3) * 34, LIST_Y + 14 + (i / 3) * 26, line, RGB(20, 22, 28));
+        }
+        if (PkbnGhost_Best(g->hash, &frames, &bust))
+        {
+            TimeText(t, sizeof(t), frames);
+            snprintf(line, sizeof(line), "BEST %s", t);
+            Text(fb, PANEL_X + 4, y + 4, line, RGB(8, 28, 31));
+            snprintf(line, sizeof(line), bust >= 11 ? "BUSTING S" : "BUSTING %u", bust);
+            Text(fb, PANEL_X + 4, y + 16, line, RGB(31, 31, 31));
+        }
+    }
+    if (sC.noteT)
+    {
+        s32 w = Pkbn_EmTextWidth(sC.note, PKBN_FONT_SMALL);
+        sC.noteT--;
+        Pkbn_FillRect(fb, PANEL_X + 2, CH - 40, w + 8, 12, RGB(2, 2, 6));
+        Text(fb, PANEL_X + 6, CH - 41, sC.note, sC.noteCol);
+    }
+}
+
+static void GhostInput(u16 keys)
+{
+    u8 n = sC.ghostCount + 1;
+    if (keys & DPAD_UP)
+        sC.gCursor = sC.gCursor ? sC.gCursor - 1 : n - 1, PlaySE(SE_SELECT);
+    else if (keys & DPAD_DOWN)
+        sC.gCursor = (sC.gCursor + 1) % n, PlaySE(SE_SELECT);
+    else if (keys & START_BUTTON)
+    {
+        static char code[GHOST_CODE_MAX];
+        if (PkbnGhost_Export(code, sizeof(code)) && Platform_SetClipboard(code))
+            GhostNote("COPIED!", RGB(10, 31, 12)), PlaySE(SE_SUCCESS);
+        else
+            GhostNote("CAN'T COPY", RGB(31, 10, 8)), PlaySE(SE_FAILURE);
+    }
+    else if (keys & SELECT_BUTTON)
+    {
+        static char code[GHOST_CODE_MAX + 64];
+        s32 r = Platform_GetClipboard(code, sizeof(code)) ? PkbnGhost_Add(code) : -1;
+        if (r == 1)
+        {
+            LoadGhosts();
+            sC.gCursor = sC.ghostCount;
+            GhostNote("NEW GHOST!", RGB(10, 31, 12)), PlaySE(SE_SUCCESS);
+        }
+        else
+            GhostNote(r == 0 ? "ALREADY HERE" : r == -2 ? "LIST FULL" : "NO GHOST CODE", RGB(31, 10, 8)), PlaySE(SE_FAILURE);
+    }
+    else if (keys & A_BUTTON)
+    {
+        if (sC.gCursor == 0)
+        {
+            PlaySE(SE_FAILURE);
+            return;
+        }
+        PlaySE(SE_SELECT);
+        Leave(0x80 + sC.gCursor - 1);
+    }
+    else if (keys & B_BUTTON)
+        sC.page = 0, PlaySE(SE_SELECT);
+}
