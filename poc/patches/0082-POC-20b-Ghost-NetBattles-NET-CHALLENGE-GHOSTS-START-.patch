+#ifndef GUARD_PKBN_GHOST_H
+#define GUARD_PKBN_GHOST_H
+// POC-20b: Ghost NetBattles (src/pkbn/ghost.c). Your party as a code a friend's game fights: species, level, moves,
+// nature, IVs, EVs, ability and NaviCust per Pokémon, plus a fighting style read from your play log.
+#include "global.h"
+#include "pkbn/navicust.h"
+#include "pkbn/challenge.h"
+
+#define GHOST_MAX_PARTS 8      // NaviCust programs carried per Pokémon (a 5x4 board rarely holds more)
+#define GHOST_LIST_MAX  16     // friends' ghosts kept in pkbn_ghosts.txt
+#define GHOST_CODE_MAX  640
+#define CHALLENGE_GHOST PKBN_CHALLENGE_COUNT   // the challenge index a ghost battle uses
+
+struct PkbnGhostMon
+{
+    u16 species;
+    u8 level;
+    u16 moves[MAX_MON_MOVES];
+    u8 nature, abilityNum;
+    u8 iv[NUM_STATS], ev[NUM_STATS];
+    u8 style;                  // STYLE_* (src/pkbn/grid_internal.h), from your habits
+    u8 partCount;
+    struct PkbnNaviPart parts[GHOST_MAX_PARTS];
+};
+
+struct PkbnGhost
+{
+    char name[8];              // the trainer's name, ASCII
+    u8 count;
+    struct PkbnGhostMon mon[PARTY_SIZE];
+    u32 hash;                  // of the code: its records key
+};
+
+bool8 PkbnGhost_Export(char *out, u32 size);                    // your party now, as a code
+bool8 PkbnGhost_Decode(const char *code, struct PkbnGhost *g);  // FALSE: not a ghost code
+u8 PkbnGhost_LoadList(struct PkbnGhost *out, u8 max);          // friends' ghosts in pkbn_ghosts.txt
+s32 PkbnGhost_Add(const char *code);   // 1 added, 0 already there, -1 not a ghost code, -2 the list is full
+bool8 PkbnGhost_Select(u8 listIndex);  // the ghost the next NET CHALLENGE battle fights
+void PkbnGhost_BuildParty(void);       // gEnemyParty and gPkbnGhostChallenge from the selected ghost
+const struct PkbnGhost *PkbnGhost_Active(void);
+void PkbnGhost_AfterWin(u32 frames, u8 bust, char *line1, char *line2, u32 size);
+// For grid_battle.c: the ghost's NaviCust and style for enemy party slot `slot`
+bool8 PkbnGhost_NaviFor(u8 slot, struct Pokemon *mon, struct PkbnNaviStats *out);
+u8 PkbnGhost_StyleFor(u8 slot);
+
+extern struct PkbnChallenge gPkbnGhostChallenge;
+#define PKBN_CHAL(i) (*((i) == CHALLENGE_GHOST ? &gPkbnGhostChallenge : &gPkbnChallenges[(i)]))
+
+// Platform (src/platform/sdl2.c)
+bool8 Platform_SetClipboard(const char *text);
+bool8 Platform_GetClipboard(char *out, u32 size);
+
+#endif // GUARD_PKBN_GHOST_H
