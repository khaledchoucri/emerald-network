diff --git a/src/pkbn/ghost.c b/src/pkbn/ghost.c
new file mode 100644
index 0000000..8cafa08
--- /dev/null
+++ b/src/pkbn/ghost.c
@@ -0,0 +1,433 @@
+// POC-20b: Ghost NetBattles (Khaled's pick). include/pkbn/ghost.h.
+//
+// NET CHALLENGE > GHOSTS: START copies your ghost code to the clipboard, SELECT pastes a friend's, A fights it. A ghost
+// is your party as it is now - species, level, moves, nature, IVs, EVs, ability and NaviCust - plus a fighting style
+// per Pokémon read from your play log (where it stood, which reach of chips it used). The foe AI plays that style
+// (the wild styles of POC-13: BRUISER, SNIPER, TURRET...) at rival tier 5. Records only: best time and Busting Level
+// per ghost (pkbn.sav v9), shared on the Ghost League page.
+//
+// Code: "PKBN-" + Crockford base32 of the bytes below + a 16-bit check. Our format (TUNE):
+//   version, name[7], count, then per Pokémon: species u16, level, moves 4 x u16, nature, ability | style << 1,
+//   IVs 6 x 5 bits (4 bytes), EVs 6 bytes, part count, parts 3 bytes each (prog 7, colour 5, x+1 3, y+1 3, rot 2).
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "pokemon.h"
+#include "random.h"
+#include "string_util.h"
+#include "pkbn/grid_internal.h"
+#include "pkbn/ghost.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/render.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+#define GHOST_VERSION 1
+#define GHOSTS_PATH Platform_DataPath("pkbn_ghosts.txt")
+#define PLAYLOG_PATH Platform_DataPath("pkbn_playlog.jsonl")
+extern const char *Platform_DataPath(const char *file);
+
+struct PkbnChallenge gPkbnGhostChallenge;
+static struct PkbnGhost sActive;
+static char sTitle[24];
+
+static const char sB32[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";   // Crockford base32
+
+static u32 Fnv(const u8 *p, u32 n)
+{
+    u32 h = 2166136261u, i;
+    for (i = 0; i < n; i++)
+        h = (h ^ p[i]) * 16777619u;
+    return h;
+}
+
+// ---- Habits -> a style (from the play log's "habits" arrays, POC-20b) ---------------------------------------------
+static u8 HabitStyle(u16 species)
+{
+    FILE *f = fopen(getenv("PKBN_PLAYLOG") ? getenv("PKBN_PLAYLOG") : PLAYLOG_PATH, "r");
+    static char line[8192];
+    u32 col[3] = {0, 0, 0}, melee = 0, ranged = 0, area = 0, total;
+    if (f == NULL)
+        return STYLE_BALANCED;
+    while (fgets(line, sizeof(line), f))
+    {
+        char *p = strstr(line, "\"habits\":[");
+        if (p == NULL)
+            continue;
+        p += 10;
+        while (*p == '[')
+        {
+            unsigned sp, c0, c1, c2, me, ra, ar;
+            if (sscanf(p, "[%u,%u,%u,%u,%u,%u,%u]", &sp, &c0, &c1, &c2, &me, &ra, &ar) == 7 && sp == species)
+            {
+                col[0] += c0, col[1] += c1, col[2] += c2;
+                melee += me, ranged += ra, area += ar;
+            }
+            p = strchr(p, ']');
+            if (p == NULL)
+                break;
+            p++;
+            if (*p == ',')
+                p++;
+        }
+    }
+    fclose(f);
+    total = col[0] + col[1] + col[2];
+    if (total < 600)
+        return STYLE_BALANCED;   // under 10 s of fighting on record: no habits yet (TUNE)
+    // TUNE: front column = harasser/bruiser, back = sniper/turret; the reach of the chips it used decides between them
+    if (area * 3 >= melee + ranged + area && area)
+        return STYLE_TURRET;
+    if (col[2] * 100 / total >= 40)
+        return melee >= ranged ? STYLE_BRUISER : STYLE_HARASSER;
+    if (col[0] * 100 / total >= 50)
+        return STYLE_SNIPER;
+    return STYLE_BALANCED;
+}
+
+// ---- Encoding ---------------------------------------------------------------------------------------------------
+static u32 Pack(const struct PkbnGhost *g, u8 *b)
+{
+    u32 n = 0;
+    u8 m, k;
+    b[n++] = GHOST_VERSION;
+    for (k = 0; k < 7; k++)
+        b[n++] = (u8)g->name[k];
+    b[n++] = g->count;
+    for (m = 0; m < g->count; m++)
+    {
+        const struct PkbnGhostMon *gm = &g->mon[m];
+        u32 ivs = 0;
+        b[n++] = gm->species & 0xFF, b[n++] = gm->species >> 8;
+        b[n++] = gm->level;
+        for (k = 0; k < MAX_MON_MOVES; k++)
+            b[n++] = gm->moves[k] & 0xFF, b[n++] = gm->moves[k] >> 8;
+        b[n++] = gm->nature;
+        b[n++] = (gm->abilityNum & 1) | (gm->style << 1);
+        for (k = 0; k < NUM_STATS; k++)
+            ivs |= (u32)(gm->iv[k] & 31) << (5 * k);
+        b[n++] = ivs, b[n++] = ivs >> 8, b[n++] = ivs >> 16, b[n++] = ivs >> 24;
+        for (k = 0; k < NUM_STATS; k++)
+            b[n++] = gm->ev[k];
+        b[n++] = gm->partCount;
+        for (k = 0; k < gm->partCount; k++)
+        {
+            const struct PkbnNaviPart *p = &gm->parts[k];
+            u32 v = (p->prog & 127) | ((u32)(p->type & 31) << 7) | ((u32)((p->x + 1) & 7) << 12)
+                  | ((u32)((p->y + 1) & 7) << 15) | ((u32)(p->rot & 3) << 18);
+            b[n++] = v, b[n++] = v >> 8, b[n++] = v >> 16;
+        }
+    }
+    return n;
+}
+
+static bool8 Unpack(const u8 *b, u32 len, struct PkbnGhost *g)
+{
+    u32 n = 0;
+    u8 m, k;
+    memset(g, 0, sizeof(*g));
+#define NEED(c) do { if (n + (c) > len) return FALSE; } while (0)
+    NEED(9);
+    if (b[n++] != GHOST_VERSION)
+        return FALSE;
+    for (k = 0; k < 7; k++)
+        g->name[k] = (b[n] >= ' ' && b[n] < 127) ? (char)b[n] : '\0', n++;
+    g->count = b[n++];
+    if (g->count == 0 || g->count > PARTY_SIZE)
+        return FALSE;
+    for (m = 0; m < g->count; m++)
+    {
+        struct PkbnGhostMon *gm = &g->mon[m];
+        u32 ivs;
+        NEED(24);
+        gm->species = b[n] | (b[n + 1] << 8), n += 2;
+        gm->level = b[n++];
+        for (k = 0; k < MAX_MON_MOVES; k++)
+            gm->moves[k] = b[n] | (b[n + 1] << 8), n += 2;
+        gm->nature = b[n++];
+        gm->abilityNum = b[n] & 1;
+        gm->style = b[n++] >> 1;
+        ivs = b[n] | (b[n + 1] << 8) | (b[n + 2] << 16) | ((u32)b[n + 3] << 24), n += 4;
+        for (k = 0; k < NUM_STATS; k++)
+            gm->iv[k] = (ivs >> (5 * k)) & 31;
+        for (k = 0; k < NUM_STATS; k++)
+            gm->ev[k] = b[n++];
+        gm->partCount = b[n++];
+        if (gm->species == SPECIES_NONE || gm->species >= NUM_SPECIES || gm->level == 0 || gm->level > MAX_LEVEL
+         || gm->nature >= NUM_NATURES || gm->style >= STYLE_COUNT || gm->partCount > GHOST_MAX_PARTS)
+            return FALSE;
+        for (k = 0; k < MAX_MON_MOVES; k++)
+            if (gm->moves[k] >= MOVES_COUNT)
+                return FALSE;
+        NEED(3 * gm->partCount);
+        for (k = 0; k < gm->partCount; k++)
+        {
+            u32 v = b[n] | (b[n + 1] << 8) | ((u32)b[n + 2] << 16);
+            struct PkbnNaviPart *p = &gm->parts[k];
+            n += 3;
+            p->prog = v & 127;
+            p->type = (v >> 7) & 31;
+            p->x = (s8)((v >> 12) & 7) - 1;
+            p->y = (s8)((v >> 15) & 7) - 1;
+            p->rot = (v >> 18) & 3;
+            if (p->prog >= NCP_COUNT)
+                return FALSE;
+        }
+    }
+#undef NEED
+    return n == len;
+}
+
+static void Encode(const u8 *b, u32 n, char *out, u32 size)
+{
+    u32 acc = 0, bits = 0, o = 0, i;
+    u16 check = (u16)Fnv(b, n);
+    u8 buf[512];
+    memcpy(buf, b, n);
+    buf[n] = check & 0xFF, buf[n + 1] = check >> 8;
+    n += 2;
+    o = snprintf(out, size, "PKBN-");
+    for (i = 0; i < n && o + 2 < size; i++)
+    {
+        acc = (acc << 8) | buf[i];
+        bits += 8;
+        while (bits >= 5)
+            out[o++] = sB32[(acc >> (bits - 5)) & 31], bits -= 5;
+    }
+    if (bits && o + 1 < size)
+        out[o++] = sB32[(acc << (5 - bits)) & 31];
+    out[o] = '\0';
+}
+
+static s32 Decode(const char *s, u8 *b, u32 cap)
+{
+    u32 acc = 0, bits = 0, n = 0;
+    while (*s == ' ' || *s == '\n' || *s == '\r' || *s == '\t')
+        s++;
+    if (strncmp(s, "PKBN-", 5) != 0)
+        return -1;
+    for (s += 5; *s; s++)
+    {
+        char c = *s >= 'a' && *s <= 'z' ? *s - 32 : *s;
+        const char *p;
+        if (c == '-' || c == ' ' || c == '\n' || c == '\r')
+            continue;
+        if (c == 'O') c = '0';
+        if (c == 'I' || c == 'L') c = '1';
+        p = strchr(sB32, c);
+        if (p == NULL || c == '\0')
+            break;
+        acc = (acc << 5) | (u32)(p - sB32);
+        bits += 5;
+        if (bits >= 8)
+        {
+            if (n >= cap)
+                return -1;
+            b[n++] = (acc >> (bits - 8)) & 0xFF;
+            bits -= 8;
+        }
+    }
+    if (n < 3 || (u16)Fnv(b, n - 2) != (b[n - 2] | (b[n - 1] << 8)))
+        return -1;
+    return n - 2;
+}
+
+bool8 PkbnGhost_Decode(const char *code, struct PkbnGhost *g)
+{
+    u8 b[512];
+    s32 n = Decode(code, b, sizeof(b));
+    if (n <= 0 || !Unpack(b, n, g))
+        return FALSE;
+    g->hash = Fnv(b, n);
+    return TRUE;
+}
+
+bool8 PkbnGhost_Export(char *out, u32 size)
+{
+    struct PkbnGhost g;
+    u8 b[512], i, k;
+    u32 n;
+    memset(&g, 0, sizeof(g));
+    {
+        char nm[16];
+        Pkbn_GameStringToAscii(nm, gSaveBlock2Ptr->playerName, sizeof(nm));
+        strncpy(g.name, nm, 7);
+        while (g.name[0] == ' ')
+            memmove(g.name, g.name + 1, 7);
+        if (g.name[0] == '\0')
+            strcpy(g.name, "TRAINER");
+    }
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        struct PkbnGhostMon *gm = &g.mon[g.count];
+        struct PkbnNavi *navi;
+        if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG))
+            continue;
+        gm->species = GetMonData(mon, MON_DATA_SPECIES);
+        gm->level = GetMonData(mon, MON_DATA_LEVEL);
+        for (k = 0; k < MAX_MON_MOVES; k++)
+            gm->moves[k] = GetMonData(mon, MON_DATA_MOVE1 + k);
+        gm->nature = GetNature(mon);
+        gm->abilityNum = GetMonData(mon, MON_DATA_ABILITY_NUM);
+        for (k = 0; k < NUM_STATS; k++)
+        {
+            gm->iv[k] = GetMonData(mon, MON_DATA_HP_IV + k);
+            gm->ev[k] = GetMonData(mon, MON_DATA_HP_EV + k);
+        }
+        gm->style = HabitStyle(gm->species);
+        navi = Navi_ForMon(mon, FALSE);
+        if (navi != NULL)
+            for (k = 0; k < navi->count && gm->partCount < GHOST_MAX_PARTS; k++)
+                gm->parts[gm->partCount++] = navi->parts[k];
+        g.count++;
+    }
+    if (g.count == 0)
+        return FALSE;
+    n = Pack(&g, b);
+    Encode(b, n, out, size);
+    printf("[pkbn] ghost exported: %s, %u Pokemon, %u chars\n", g.name, g.count, (unsigned)strlen(out));
+    return TRUE;
+}
+
+// ---- The list of friends' ghosts (pkbn_ghosts.txt, one code per line) --------------------------------------------
+u8 PkbnGhost_LoadList(struct PkbnGhost *out, u8 max)
+{
+    FILE *f = fopen(GHOSTS_PATH, "r");
+    char line[GHOST_CODE_MAX + 8];
+    u8 n = 0;
+    if (f == NULL)
+        return 0;
+    while (n < max && fgets(line, sizeof(line), f))
+        if (PkbnGhost_Decode(line, &out[n]))
+            n++;
+    fclose(f);
+    return n;
+}
+
+s32 PkbnGhost_Add(const char *code)
+{
+    struct PkbnGhost g, list[GHOST_LIST_MAX];
+    u8 n, i;
+    FILE *f;
+    if (!PkbnGhost_Decode(code, &g))
+        return -1;
+    n = PkbnGhost_LoadList(list, GHOST_LIST_MAX);
+    for (i = 0; i < n; i++)
+        if (list[i].hash == g.hash)
+            return 0;
+    if (n >= GHOST_LIST_MAX)
+        return -2;
+    f = fopen(GHOSTS_PATH, "a");
+    if (f == NULL)
+        return -2;
+    while (*code == ' ' || *code == '\n' || *code == '\r')
+        code++;
+    {
+        char clean[GHOST_CODE_MAX + 8];
+        u32 k = 0;
+        for (; *code && k < sizeof(clean) - 1; code++)
+            if (*code != '\n' && *code != '\r' && *code != ' ')
+                clean[k++] = *code;
+        clean[k] = '\0';
+        fprintf(f, "%s\n", clean);
+    }
+    fclose(f);
+    printf("[pkbn] ghost added: %s\n", g.name);
+    return 1;
+}
+
+bool8 PkbnGhost_Select(u8 listIndex)
+{
+    struct PkbnGhost list[GHOST_LIST_MAX];
+    u8 n = PkbnGhost_LoadList(list, GHOST_LIST_MAX);
+    if (listIndex >= n)
+        return FALSE;
+    sActive = list[listIndex];
+    return TRUE;
+}
+
+const struct PkbnGhost *PkbnGhost_Active(void)
+{
+    return &sActive;
+}
+
+// ---- The battle ------------------------------------------------------------------------------------------------
+void PkbnGhost_BuildParty(void)
+{
+    u8 m, k;
+    if (getenv("PKBN_TEST_GHOST") != NULL && !PkbnGhost_Decode(getenv("PKBN_TEST_GHOST"), &sActive))
+        printf("[pkbn] PKBN_TEST_GHOST is not a ghost code\n");
+    ZeroEnemyPartyMons();
+    memset(&gPkbnGhostChallenge, 0, sizeof(gPkbnGhostChallenge));
+    snprintf(sTitle, sizeof(sTitle), "%s'S GHOST", sActive.name);
+    gPkbnGhostChallenge.name = sTitle;
+    gPkbnGhostChallenge.desc = "";
+    gPkbnGhostChallenge.tier = 5;       // TUNE: a friend's team fights like the Elite Four
+    gPkbnGhostChallenge.together = 1;
+    gPkbnGhostChallenge.monCount = sActive.count;
+    for (m = 0; m < sActive.count; m++)
+    {
+        const struct PkbnGhostMon *gm = &sActive.mon[m];
+        struct Pokemon *mon = &gEnemyParty[m];
+        u8 ab = gm->abilityNum;
+        CreateMonWithNature(mon, gm->species, gm->level, 0, gm->nature);
+        for (k = 0; k < NUM_STATS; k++)
+        {
+            u8 iv = gm->iv[k], ev = gm->ev[k];
+            SetMonData(mon, MON_DATA_HP_IV + k, &iv);
+            SetMonData(mon, MON_DATA_HP_EV + k, &ev);
+        }
+        SetMonData(mon, MON_DATA_ABILITY_NUM, &ab);
+        for (k = 0; k < MAX_MON_MOVES; k++)
+        {
+            u16 mv = gm->moves[k];
+            u8 pp = gBattleMoves[mv].pp;
+            SetMonData(mon, MON_DATA_MOVE1 + k, &mv);
+            SetMonData(mon, MON_DATA_PP1 + k, &pp);
+        }
+        CalculateMonStats(mon);
+        gPkbnGhostChallenge.mons[m].species = gm->species;
+        gPkbnGhostChallenge.mons[m].level = gm->level;
+        memcpy(gPkbnGhostChallenge.mons[m].moves, gm->moves, sizeof(gm->moves));
+    }
+    printf("[pkbn] ghost battle: %s, %u Pokemon\n", sTitle, sActive.count);
+}
+
+bool8 PkbnGhost_NaviFor(u8 slot, struct Pokemon *mon, struct PkbnNaviStats *out)
+{
+    struct PkbnNavi navi;
+    struct PkbnNaviOwner owner;
+    if (slot >= sActive.count)
+        return FALSE;
+    memset(&navi, 0, sizeof(navi));
+    navi.id = 1;
+    navi.count = sActive.mon[slot].partCount;
+    memcpy(navi.parts, sActive.mon[slot].parts, sizeof(struct PkbnNaviPart) * navi.count);
+    Navi_OwnerFromMon(&owner, mon);
+    Navi_Compile(&navi, &owner, out, NULL);
+    return TRUE;
+}
+
+u8 PkbnGhost_StyleFor(u8 slot)
+{
+    return slot < sActive.count ? sActive.mon[slot].style : STYLE_NONE;
+}
+
+void PkbnGhost_AfterWin(u32 frames, u8 bust, char *line1, char *line2, u32 size)
+{
+    u16 best = 0;
+    u8 bestBust = 0;
+    u32 s10 = frames * 10 / 60;
+    bool8 had = PkbnGhost_Best(sActive.hash, &best, &bestBust);
+    if (frames > 0xFFFF)
+        frames = 0xFFFF;
+    PkbnGhost_NoteWin(sActive.hash, (u16)frames, bust);
+    snprintf(line1, size, "%s %u:%02u.%u!", (!had || frames < best) ? "NEW RECORD" : "TIME", (unsigned)(s10 / 600),
+             (unsigned)(s10 / 10 % 60), (unsigned)(s10 % 10));
+    snprintf(line2, size, "BEAT %s!", sTitle);
+    printf("[pkbn] ghost beaten: %s %u frames bust %u\n", sTitle, (unsigned)frames, bust);
+}
+
