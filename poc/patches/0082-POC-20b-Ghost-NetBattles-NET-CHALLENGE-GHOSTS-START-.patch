+// ---- POC-20b: GHOSTS ------------------------------------------------------------------------------------------------
+// Row 0 is your own ghost (START copies its code); the rest are friends' ghosts pasted with SELECT. A fights one.
+static void Leave(u16 result);
+
+static void GhostNote(const char *s, u16 col)
+{
+    sC.note = s, sC.noteT = 90, sC.noteCol = col;
+}
+
+static void LoadGhosts(void)
+{
+    sC.ghostCount = PkbnGhost_LoadList(sC.ghosts, GHOST_LIST_MAX);
+    sC.gIconsFor = 0xFF;
+}
+
+static void GhostIcons(void)
+{
+    u8 i;
+    if (sC.gIconsFor == sC.gCursor)
+        return;
+    sC.gIconsFor = sC.gCursor;
+    if (sC.gCursor == 0)
+    {
+        for (i = 0; i < PARTY_SIZE; i++)
+            if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
