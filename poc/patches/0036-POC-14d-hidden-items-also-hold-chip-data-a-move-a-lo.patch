+// POC-14: a hidden item (the Itemfinder kind) also holds chip data, like BN's mystery data: one copy of a move a
+// Pokémon living here learns by the lead's level (GetLocalWildMon picks one of the map's wild Pokémon), in one of
+// its codes. No wild Pokémon here: a move the lead knows. TUNE. Writes "MOVE X" (game text) for the message.
+bool8 PkbnPack_GrantHiddenData(u8 *nameOut)
+{
+    bool8 water;
+    u16 species = GetLocalWildMon(&water), cand[64], mv = MOVE_NONE;
+    u8 lead = GetMonData(&gPlayerParty[0], MON_DATA_LEVEL), n = 0, letter;
+    const struct PkbnMoveInfo *info;
+    s32 i;
+    if (species != SPECIES_NONE)
+        for (i = 0; gLevelUpLearnsets[species][i] != LEVEL_UP_END && n < 64; i++)
+        {
+            u16 m = gLevelUpLearnsets[species][i] & LEVEL_UP_MOVE_ID;
+            if ((gLevelUpLearnsets[species][i] & LEVEL_UP_MOVE_LV) <= (lead << 9) && PkbnFolder_MoveIsChip(m))
+                cand[n++] = m;
+        }
+    if (n == 0)
+        for (i = 0; i < MAX_MON_MOVES; i++)
+        {
+            u16 m = GetMonData(&gPlayerParty[0], MON_DATA_MOVE1 + i);
+            if (PkbnFolder_MoveIsChip(m))
+                cand[n++] = m;
+        }
+    if (n == 0)
+        return FALSE;
+    mv = cand[Random() % n];
+    info = &gPkbnMoveInfo[mv];
+    letter = info->lanes[Random() % info->laneCount];
+    PkbnPack_Add(mv, letter, 1);
+    printf("[pkbn] chip grant: hidden data move %u code %c (wild species %u)\n", mv, PkbnFolder_LetterChar(letter), species);
+    if (nameOut != NULL)
+    {
+        u8 *p = StringCopy(nameOut, gMoveNames[mv]);
+        *p++ = CHAR_SPACE;
+        *p++ = letter == LETTER_WILD ? CHAR_MULT_SIGN : CHAR_A + letter;   // BN draws the * code as a star; Emerald has the times sign
+        *p = EOS;
+    }
+    return TRUE;
+}
