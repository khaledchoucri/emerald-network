         // small type-coloured chip mark + code letter
@@ -736,6 +759,10 @@ static void AddToFolder(u16 mv, u8 letter)
         Note("THE FOLDER IS FULL");
     else if (InFolder(mv, letter) >= PkbnPack_Get(mv, letter))
         Note("ALL YOUR COPIES ARE IN ALREADY");
+    else if (Chip_Class(mv) != CHIP_STANDARD && !Chip_ClassFits(sF.fMove, sF.fCount, mv))
+        Note(Chip_Class(mv) == CHIP_GIGA ? "YOU CAN USE ONLY 1 GIGACHIP" : "YOU CAN USE ONLY 5 MEGACHIPS");   // CompText86CF1A8 unk6/7
+    else if (Chip_Class(mv) != CHIP_STANDARD && InFolder(mv, -1) >= 1)
+        Note(Chip_Class(mv) == CHIP_GIGA ? "ONLY 1 OF THE SAME GIGACHIP" : "ONLY 1 OF THE SAME MEGACHIP");  // unk4/5
     else if (InFolder(mv, -1) >= Chip_CopyCap(mv))
