+// BN6 chip classes (POC-13). BN6 MegaMan starts with room for 5 MegaChips and 1 GigaChip (byte_80210DD +6/+7,
+// bn6f data/dat01.s:295, read by init_8013B64, asm/asm00_2.s:10942-10945) and allows "only 1 of the same MegaChip /
+// GigaChip" (CompText86CF1A8 unk4/unk5). Which moves are Mega or Giga is our design (TUNE): Giga = the legendaries'
+// signature moves; Mega = damaging moves of 36 MB or more (power 120+) and the one-hit KO moves.
+u8 Chip_Class(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_SACRED_FIRE: case MOVE_AEROBLAST: case MOVE_MIST_BALL: case MOVE_LUSTER_PURGE:
+    case MOVE_DOOM_DESIRE: case MOVE_PSYCHO_BOOST:
+        return CHIP_GIGA;
+    }
+    if (gBattleMoves[move].effect == EFFECT_OHKO || (gBattleMoves[move].power > 1 && Chip_MB(move) >= 36))
+        return CHIP_MEGA;
+    return CHIP_STANDARD;
+}
+
+u8 Chip_ClassMax(u8 cls)
+{
+    return cls == CHIP_GIGA ? 1 : cls == CHIP_MEGA ? 5 : 0xFF;
+}
+
+// Can `mv` join a folder holding moves[0..n)? Only the class rule: room for another distinct Mega / Giga chip.
+bool8 Chip_ClassFits(const u16 *moves, u8 n, u16 mv)
+{
+    u8 cls = Chip_Class(mv), distinct = 0;
+    s32 i, j;
+    if (cls == CHIP_STANDARD)
+        return TRUE;
+    for (i = 0; i < n; i++)
+    {
+        if (moves[i] == mv)
+            return TRUE;   // already counted (the copy cap of 1 handles the rest)
+        if (Chip_Class(moves[i]) != cls)
+            continue;
+        for (j = 0; j < i; j++)
+            if (moves[j] == moves[i])
+                break;
+        if (j == i)
+            distinct++;
+    }
+    return distinct < Chip_ClassMax(cls);
+}
+
 u8 Chip_CopyCap(u16 move)
 {
     u8 mb = Chip_MB(move); // BN6 sub_8135500 (bn6f asm/asm36.s:10634)
+    if (Chip_Class(move) != CHIP_STANDARD)
+        return 1;          // "only 1 of the same MegaChip / GigaChip"
     return mb <= 19 ? 5 : mb <= 29 ? 4 : mb <= 39 ? 3 : mb <= 49 ? 2 : 1;
 }
 
+static bool8 FolderClassFits(const struct Folder *folder, u16 mv)
+{
+    u16 moves[FOLDER_MAX];
+    s32 i;
+    for (i = 0; i < folder->count; i++)
+        moves[i] = folder->chips[i].move;
+    return Chip_ClassFits(moves, folder->count, mv);
+}
+
 bool8 Chip_SpeciesCanLearn(u16 species, u16 move)
 {
     if (species == SPECIES_NONE || species >= NUM_SPECIES || move == MOVE_NONE || move >= MOVES_COUNT)
@@ -188,7 +243,8 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
                 for (p = 0; p < partyCount; p++)
                     if (Chip_CanUse(&party[p], em[i]))
                         break;
-                if (p == partyCount || same >= Chip_CopyCap(em[i]) || sameCode >= PkbnPack_Get(em[i], el[i]))
+                if (p == partyCount || same >= Chip_CopyCap(em[i]) || sameCode >= PkbnPack_Get(em[i], el[i])
+                 || !FolderClassFits(folder, em[i]))
                     continue;
                 folder->chips[folder->count].move = em[i];
                 folder->chips[folder->count].letter = el[i];
@@ -220,7 +276,7 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
         {
             u32 v = 0;
             mv = cand[i];
-            if (used[mv] >= Chip_CopyCap(mv) || used[mv] >= PkbnPack_Total(mv))
+            if (used[mv] >= Chip_CopyCap(mv) || used[mv] >= PkbnPack_Total(mv) || !FolderClassFits(folder, mv))
                 continue;
             for (p = 0; p < partyCount; p++)
                 if (Chip_CanUse(&party[p], mv))
@@ -250,7 +306,7 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
             ch->slot = 0;
         }
         used[mv]++;
-        for (p = 0; p < partyCount; p++)
+        for (p = 0; p < partyCount && p < PKBN_PARTY_MAX; p++)
             if (Chip_CanUse(&party[p], mv))
                 usable[p]++;
     }
