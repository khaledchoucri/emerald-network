+// POC-14 LIBRARY page: every chip move, by type then move number; how many you have ever owned
+static void BuildLibrary(void)
+{
+    u16 mv;
+    u8 t;
+    sF.libCount = sF.libSeen = 0;
+    for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+        for (mv = 1; mv < MOVES_COUNT; mv++)
+            if (gBattleMoves[mv].type == t && PkbnFolder_MoveIsChip(mv))
+            {
+                sF.lib[sF.libCount++] = mv;
+                sF.libSeen += PkbnLibrary_Has(mv);
+            }
+}
+
+// Library milestones (POC-14, TUNE): PP Up / PP Max and NaviCust programs, paid once each.
+static void LibraryMilestones(void)
+{
+    static const struct { u16 seen; u16 item; const char *program; } sMilestones[] = {
+        { 25, ITEM_PP_UP, NULL }, { 50, 0, "Custom1" }, { 100, ITEM_PP_MAX, NULL }, { 150, 0, "HP+100" },
+        { 200, 0, "Custom2" }, { 250, 0, "BugStop" }, { 0xFFFF, 0, "BustPack" },   // 0xFFFF = all of them
+    };
+    u8 paid = PkbnLibrary_Paid(), i;
+    char line[64];
+    line[0] = '\0';
+    for (i = 0; i < ARRAY_COUNT(sMilestones); i++)
+    {
+        u16 need = sMilestones[i].seen == 0xFFFF ? sF.libCount : sMilestones[i].seen;
+        if ((paid & (1 << i)) || sF.libSeen < need)
+            continue;
+        paid |= 1 << i;
+        if (sMilestones[i].item)
+        {
+            AddBagItem(sMilestones[i].item, 1);
+            snprintf(line, sizeof(line), "LIBRARY %u: GOT A %s!", need, sMilestones[i].item == ITEM_PP_UP ? "PP UP" : "PP MAX");
+        }
+        else
+        {
+            s32 k;
+            for (k = 0; k < NCP_COUNT; k++)
+                if (strcmp(gPkbnNcps[k].name, sMilestones[i].program) == 0)
+                    PkbnProgram_Grant(k, 1);
+            snprintf(line, sizeof(line), "LIBRARY %u: GOT PROGRAM %s!", need, sMilestones[i].program);
+        }
+        printf("[pkbn] %s\n", line);
+    }
+    PkbnLibrary_SetPaid(paid);
+    if (line[0])
+        Note(line);
+}
+
