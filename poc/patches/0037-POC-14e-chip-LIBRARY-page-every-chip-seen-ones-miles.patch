+// ---- POC-14: library, Leader chips, records, challenges, programs ------------------------------------------------
+
+bool8 PkbnLibrary_Has(u16 move)
+{
+    return move < MOVES_COUNT && (sSave.library[move / 8] & (1 << (move % 8)));
+}
+
+u8 PkbnLibrary_Paid(void) { return sSave.libraryPaid; }
+void PkbnLibrary_SetPaid(u8 bits) { sSave.libraryPaid = bits; }
+
+u8 PkbnLeader_Chip(u8 leader) { return leader < PKBN_LEADERS ? sSave.leaderChip[leader] : 0; }
+void PkbnLeader_SetChip(u8 leader, u8 level) { if (leader < PKBN_LEADERS) sSave.leaderChip[leader] = level; }
+void PkbnLeader_Record(u8 leader, u16 *frames, u8 *level)
+{
+    *frames = leader < PKBN_LEADERS ? sSave.leaderBestFrames[leader] : 0;
+    *level = leader < PKBN_LEADERS ? sSave.leaderBestLevel[leader] : 0;
+}
+void PkbnLeader_SetRecord(u8 leader, u16 frames, u8 level)
+{
+    if (leader < PKBN_LEADERS)
+        sSave.leaderBestFrames[leader] = frames, sSave.leaderBestLevel[leader] = level;
+}
+
+bool8 PkbnChallenge_Cleared(u8 n) { return n < 32 && (sSave.challengeCleared & (1u << n)); }
+void PkbnChallenge_SetCleared(u8 n) { if (n < 32) sSave.challengeCleared |= 1u << n; }
+
+// NaviCust programs owned (POC-14: earned in new games)
+void PkbnProgram_Grant(u8 prog, u8 n)
+{
+    if (prog >= NCP_COUNT)
+        return;
+    sSave.owned[prog] = sSave.owned[prog] + n > NCP_OWNED_TEST ? NCP_OWNED_TEST : sSave.owned[prog] + n;
+    printf("[pkbn] program grant: %s x%u (now %u)\n", gPkbnNcps[prog].name, n, sSave.owned[prog]);
+}
+
+bool8 PkbnProgram_Economy(void) { return sSave.programEconomy; }
+
 #endif // PORTABLE
