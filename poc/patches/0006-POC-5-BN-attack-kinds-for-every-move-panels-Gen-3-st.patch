+// ---- Power, type, damage ------------------------------------------------------------------------
+
+static u8 WeatherBallType(void)
+{
+    if (sB.weather & B_WEATHER_RAIN) return TYPE_WATER;
+    if (sB.weather & B_WEATHER_SUN) return TYPE_FIRE;
+    if (sB.weather & B_WEATHER_SANDSTORM) return TYPE_ROCK;
+    if (sB.weather & B_WEATHER_HAIL) return TYPE_ICE;
+    return TYPE_NORMAL;
+}
+
+static void HiddenPower(const struct BattlePokemon *u, u16 *power, u8 *type)
+{
+    u8 powerBits = ((u->hpIV & 2) >> 1) | ((u->attackIV & 2) << 0) | ((u->defenseIV & 2) << 1)
+                 | ((u->speedIV & 2) << 2) | ((u->spAttackIV & 2) << 3) | ((u->spDefenseIV & 2) << 4);
+    u8 typeBits = ((u->hpIV & 1) << 0) | ((u->attackIV & 1) << 1) | ((u->defenseIV & 1) << 2)
+                | ((u->speedIV & 1) << 3) | ((u->spAttackIV & 1) << 4) | ((u->spDefenseIV & 1) << 5);
+    *power = (40 * powerBits) / 63 + 30;
+    *type = ((NUMBER_OF_MON_TYPES - 3) * typeBits) / 63 + 1;
+    if (*type >= TYPE_MYSTERY)
+        (*type)++;
+}
+
+// gDynamicBasePower / dynamicMoveType equivalents for the moves that set them.
+static void PowerAndType(struct Attack *a, u8 defSide, u16 *power, u8 *type)
+{
+    const struct BattlePokemon *u = &a->user;
+    const struct Fighter *def = &sB.f[defSide];
+    const struct BattleMove *m = &gBattleMoves[a->move];
+    *power = m->power;
+    *type = m->type;
+    if (a->powerOverride)
+        *power = a->powerOverride;
+    if (a->typeOverride)
+        *type = a->typeOverride - 1;
+
+    switch (m->effect)
+    {
+    case EFFECT_FLAIL:
+    {
+        s32 i, frac = (u->hp * 48) / (u->maxHP ? u->maxHP : 1);
+        for (i = 0; i < (s32)sizeof(sFlailTable) - 2; i += 2)
+            if (frac <= sFlailTable[i])
+                break;
+        *power = sFlailTable[i + 1];
+        break;
+    }
+    case EFFECT_ERUPTION: // Cmd_scaledamagebyhealthratio
+        *power = m->power * u->hp / (u->maxHP ? u->maxHP : 1);
+        if (*power == 0) *power = 1;
+        break;
+    case EFFECT_RETURN:
+        *power = 10 * u->friendship / 25;
+        break;
+    case EFFECT_FRUSTRATION:
+        *power = 10 * (MAX_FRIENDSHIP - u->friendship) / 25;
+        break;
+    case EFFECT_HIDDEN_POWER:
+        HiddenPower(u, power, type);
+        break;
+    case EFFECT_MAGNITUDE:
+    {
+        s32 r = Random() % 100;
+        *power = r < 5 ? 10 : r < 15 ? 30 : r < 35 ? 50 : r < 65 ? 70 : r < 85 ? 90 : r < 95 ? 110 : 150;
+        a->powerOverride = *power; // one roll per use
+        break;
+    }
+    case EFFECT_LOW_KICK:
+    {
+        s32 i;
+        u32 weight = GetPokedexHeightWeight(SpeciesToNationalPokedexNum(def->bm.species), 1);
+        for (i = 0; sWeightTable[i] != 0xFFFF; i += 2)
+            if (sWeightTable[i] > weight)
+                break;
+        *power = sWeightTable[i] != 0xFFFF ? sWeightTable[i + 1] : 120;
+        break;
+    }
+    case EFFECT_WEATHER_BALL:
+        if (sB.weather)
+        {
+            *power = m->power * 2;
+            *type = WeatherBallType();
+        }
+        break;
+    case EFFECT_FACADE:
+        if (u->status1 & (STATUS1_POISON | STATUS1_BURN | STATUS1_PARALYSIS | STATUS1_TOXIC_POISON))
+            *power = m->power * 2;
+        break;
+    case EFFECT_REVENGE:
+        if (a->side == SIDE_PLAYER || a->side == SIDE_ENEMY)
+        {
+            const struct Fighter *me = &sB.f[a->side];
+            if (me->lastHitFrame && sB.frame - me->lastHitFrame < RECENT_HIT)
+                *power = m->power * 2;
+        }
+        break;
+    case EFFECT_TRIPLE_KICK: // Gen 3: 10, 20, 30
+        *power = m->power * (a->hitIndex + 1);
+        break;
+    }
+    // Mud Sport / Water Sport (Gen 3: halve Electric / Fire power while the user is in)
+    if (*type == TYPE_ELECTRIC && (sB.f[0].mudSport || sB.f[1].mudSport))
+        *power /= 2;
+    if (*type == TYPE_FIRE && (sB.f[0].waterSport || sB.f[1].waterSport))
+        *power /= 2;
+}
+
+// Type chart walk (Cmd_typecalc). Returns the multiplier x10 and applies it to *dmg.
+static u16 ApplyTypeChart(u8 type, const struct BattlePokemon *def, s32 *dmg)
+{
+    s32 i;
+    u16 mult = TYPE_MUL_NORMAL;
+    for (i = 0; TYPE_EFFECT_ATK_TYPE(i) != TYPE_ENDTABLE; i += 3)
+    {
+        u8 mm;
+        if (TYPE_EFFECT_ATK_TYPE(i) == TYPE_FORESIGHT)
+            continue; // no Foresight: the Ghost immunities below the marker apply
+        if (TYPE_EFFECT_ATK_TYPE(i) != type)
+            continue;
+        mm = TYPE_EFFECT_MULTIPLIER(i);
+        if (TYPE_EFFECT_DEF_TYPE(i) == def->types[0]
+         || (TYPE_EFFECT_DEF_TYPE(i) == def->types[1] && def->types[0] != def->types[1]))
+        {
+            *dmg = *dmg * mm / 10;
+            if (*dmg == 0 && mm != 0)
+                *dmg = 1;
+            mult = mult * mm / 10;
+        }
+    }
+    return mult;
+}
+
+static struct BattlePokemon DefenderData(u8 defSide)
+{
+    struct BattlePokemon d = sB.f[defSide].bm;
+    if (sB.f[defSide].typeOverride)
+        d.types[0] = d.types[1] = sB.f[defSide].typeOverride - 1;
+    return d;
+}
+
+// Full Gen 3 damage for one hit of `a` on defSide. *eff = multiplier x10. Returns -1 if the move has
+// no effect for a non-type reason (e.g. Dream Eater on an awake target).
+static s32 CalcHitDamage(struct Attack *a, u8 defSide, u16 *eff, bool8 *crit)
+{
+    struct BattlePokemon atk = a->user;
+    struct BattlePokemon def = DefenderData(defSide);
+    struct Fighter *dF = &sB.f[defSide];
+    const struct BattleMove *m = &gBattleMoves[a->move];
+    u8 atkSide = defSide ^ 1;
+    u16 power;
+    u8 type;
+    s32 dmg;
+
+    *eff = TYPE_MUL_NORMAL;
+    *crit = FALSE;
+    PowerAndType(a, defSide, &power, &type);
+
+    // fixed-damage moves still respect type immunity (Gen 3 typecalc2)
+    switch (m->effect)
+    {
+    case EFFECT_LEVEL_DAMAGE:
+    case EFFECT_DRAGON_RAGE:
+    case EFFECT_SUPER_FANG:
+    case EFFECT_PSYWAVE:
+    case EFFECT_ENDEAVOR:
+    case EFFECT_COUNTER:
+    {
+        s32 tmp = 1;
+        if (ApplyTypeChart(type, &def, &tmp) == TYPE_MUL_NO_EFFECT && m->effect != EFFECT_ENDEAVOR)
+        {
+            *eff = TYPE_MUL_NO_EFFECT;
+            return 0;
+        }
+        if (m->effect == EFFECT_LEVEL_DAMAGE) return atk.level;
+        if (m->effect == EFFECT_DRAGON_RAGE) return 40;
+        if (m->effect == EFFECT_SUPER_FANG) return def.hp / 2 ? def.hp / 2 : 1;
+        if (m->effect == EFFECT_PSYWAVE)
+        {
+            s32 r;
+            while ((r = Random() % 16) > 10);
+            return atk.level * (r * 10 + 50) / 100;
+        }
+        if (m->effect == EFFECT_ENDEAVOR)
+            return def.hp > atk.hp ? def.hp - atk.hp : -1;
+        // Counter: 2x the physical damage taken recently
+        {
+            const struct Fighter *me = &sB.f[atkSide];
+            if (me->lastPhysDamage && sB.frame - me->lastHitFrame < RECENT_HIT)
+                return me->lastPhysDamage * 2;
+            return -1;
+        }
+    }
+    case EFFECT_DREAM_EATER:
+        if (!(def.status1 & STATUS1_SLEEP))
+            return -1;
+        break;
+    case EFFECT_BEAT_UP:
+        // Cmd_trydobeatup: per party member, typeless.
+        {
+            const struct BattlePokemon *mem = &a->user;
+            if (a->side == SIDE_PLAYER)
+            {
+                s32 i, n = 0;
+                for (i = 0; i < sB.partyCount; i++)
+                {
+                    const struct BattlePokemon *b = (i == sB.active) ? &sB.f[SIDE_PLAYER].bm : &sB.party[i].bm;
+                    if (b->species && b->hp && !b->status1 && n++ == a->hitIndex)
+                    {
+                        mem = b;
+                        break;
+                    }
+                }
+            }
+            s32 d = gSpeciesInfo[mem->species].baseAttack * m->power * (mem->level * 2 / 5 + 2);
+            d /= gSpeciesInfo[def.species].baseDefense;
+            return d / 50 + 2;
+        }
+    }
+
+    // Globals CalculateBaseDamage and the ability checks read.
+    gBattleMons[atkSide] = atk;
+    gBattleMons[defSide] = def;
+    gBattlersCount = 2;
+    gBattleWeather = sB.weather;
+    gCurrentMove = a->move;
+    gBattleScripting.dmgMultiplier = 1;
+
+    // Cmd_critcalc
+    {
+        u16 c = 2 * (a->info.flags & 0x80 ? 1 : 0) // focus energy captured at launch (bit 7)
+              + (m->effect == EFFECT_HIGH_CRITICAL) + (m->effect == EFFECT_SKY_ATTACK)
+              + (m->effect == EFFECT_BLAZE_KICK) + (m->effect == EFFECT_POISON_TAIL);
+        if (c >= ARRAY_COUNT(sCritChance))
+            c = ARRAY_COUNT(sCritChance) - 1;
+        gCritMultiplier = (def.ability != ABILITY_BATTLE_ARMOR && def.ability != ABILITY_SHELL_ARMOR
+                           && !(Random() % sCritChance[c])) ? 2 : 1;
+        *crit = gCritMultiplier == 2;
+    }
+
+    dmg = CalculateBaseDamage(&atk, &def, a->move, 0, power, type, atkSide, defSide);
+    dmg = dmg * gCritMultiplier * gBattleScripting.dmgMultiplier;
+    if ((a->info.flags & 0x40) && type == TYPE_ELECTRIC) // Charge captured at launch (bit 6)
+        dmg *= 2;
+
+    // Cmd_typecalc: STAB, Levitate, chart, Wonder Guard
+    if (a->move != MOVE_STRUGGLE)
+    {
+        u8 t0 = atk.types[0], t1 = atk.types[1];
+        if (a->side < 2 && sB.f[a->side].typeOverride && sB.f[a->side].bm.species == atk.species)
+            t0 = t1 = sB.f[a->side].typeOverride - 1;
+        if (t0 == type || t1 == type)
+            dmg = dmg * 15 / 10;
+        if (def.ability == ABILITY_LEVITATE && type == TYPE_GROUND)
+        {
+            *eff = TYPE_MUL_NO_EFFECT;
+            return 0;
+        }
+        *eff = ApplyTypeChart(type, &def, &dmg);
+        if (def.ability == ABILITY_WONDER_GUARD && *eff <= TYPE_MUL_NORMAL && m->power)
+        {
+            *eff = TYPE_MUL_NO_EFFECT;
+            return 0;
+        }
+    }
+    // Absorbing abilities (Gen 3 AbilityBattleEffects ABILITYEFFECT_ABSORBING)
+    if ((type == TYPE_ELECTRIC && def.ability == ABILITY_VOLT_ABSORB) || (type == TYPE_WATER && def.ability == ABILITY_WATER_ABSORB))
+    {
+        Heal(dF, dF->bm.maxHP / 4);
+        SayFighter(dF, "ABSORBED IT!", 50);
+        *eff = TYPE_MUL_NO_EFFECT;
+        return 0;
+    }
+    if (type == TYPE_FIRE && def.ability == ABILITY_FLASH_FIRE)
+    {
+        *eff = TYPE_MUL_NO_EFFECT;
+        return 0;
+    }
+    if (*eff == TYPE_MUL_NO_EFFECT)
+        return 0;
+
+    // ApplyRandomDmgMultiplier (:1639)
+    if (dmg != 0)
+    {
+        dmg = dmg * (100 - (Random() % 16)) / 100;
+        if (dmg == 0)
+            dmg = 1;
+    }
+    return dmg;
+}
+
+// ---- Secondary effects (Gen 3 MOVE_EFFECT_* chances from secondaryEffectChance) ------------------
+
+static void Flinch(u8 side)
+{
+    struct Fighter *f = &sB.f[side];
+    if (f->bm.ability == ABILITY_INNER_FOCUS || f->bm.hp == 0)
+        return;
+    f->stun = FLINCH_FRAMES;
+    if (f->charging)
+        f->focusBroken = TRUE;
+    PKBN_LOG("%s flinched", f->name);
+}
+
+static void SecondaryEffect(struct Attack *a, u8 defSide)
+{
+    const struct BattleMove *m = &gBattleMoves[a->move];
+    struct Fighter *def = &sB.f[defSide];
+    u8 atkSide = defSide ^ 1;
+    bool8 roll = m->secondaryEffectChance && (Random() % 100) < m->secondaryEffectChance;
+    bool8 onTarget = def->bm.ability != ABILITY_SHIELD_DUST;
+
+    switch (m->effect)
+    {
+    case EFFECT_BURN_HIT: case EFFECT_BLAZE_KICK: case EFFECT_THAW_HIT:
+        if (roll && onTarget) Field_TryStatus(defSide, atkSide, a->move, STATUS1_BURN, FALSE);
+        break;
+    case EFFECT_FREEZE_HIT:
+        if (roll && onTarget) Field_TryStatus(defSide, atkSide, a->move, STATUS1_FREEZE, FALSE);
+        break;
+    case EFFECT_PARALYZE_HIT: case EFFECT_THUNDER:
+        if (roll && onTarget) Field_TryStatus(defSide, atkSide, a->move, STATUS1_PARALYSIS, FALSE);
+        break;
+    case EFFECT_POISON_HIT: case EFFECT_POISON_TAIL: case EFFECT_TWINEEDLE:
+        if (roll && onTarget) Field_TryStatus(defSide, atkSide, a->move, STATUS1_POISON, FALSE);
+        break;
+    case EFFECT_POISON_FANG:
+        if (roll && onTarget) Field_TryStatus(defSide, atkSide, a->move, STATUS1_TOXIC_POISON, FALSE);
+        break;
+    case EFFECT_TRI_ATTACK:
+        if (roll && onTarget)
+        {
+            static const u32 sTri[3] = { STATUS1_BURN, STATUS1_FREEZE, STATUS1_PARALYSIS };
+            Field_TryStatus(defSide, atkSide, a->move, sTri[Random() % 3], FALSE);
+        }
+        break;
+    case EFFECT_CONFUSE_HIT:
+        if (roll && onTarget) Field_TryConfuse(defSide, atkSide, a->move, FALSE);
+        break;
+    case EFFECT_FLINCH_HIT: case EFFECT_FLINCH_MINIMIZE_HIT: case EFFECT_TWISTER: case EFFECT_SKY_ATTACK:
+    case EFFECT_SNORE:
+        if (roll && onTarget) Flinch(defSide);
+        break;
+    case EFFECT_FAKE_OUT:
+        if (onTarget) Flinch(defSide);
+        break;
+    case EFFECT_ATTACK_DOWN_HIT: if (roll && onTarget) Field_ApplyStatStage(defSide, STAT_ATK, -1, TRUE); break;
+    case EFFECT_DEFENSE_DOWN_HIT: if (roll && onTarget) Field_ApplyStatStage(defSide, STAT_DEF, -1, TRUE); break;
+    case EFFECT_SPEED_DOWN_HIT: if (roll && onTarget) Field_ApplyStatStage(defSide, STAT_SPEED, -1, TRUE); break;
+    case EFFECT_SPECIAL_ATTACK_DOWN_HIT: if (roll && onTarget) Field_ApplyStatStage(defSide, STAT_SPATK, -1, TRUE); break;
+    case EFFECT_SPECIAL_DEFENSE_DOWN_HIT: if (roll && onTarget) Field_ApplyStatStage(defSide, STAT_SPDEF, -1, TRUE); break;
+    case EFFECT_ACCURACY_DOWN_HIT: if (roll && onTarget) Field_ApplyStatStage(defSide, STAT_ACC, -1, TRUE); break;
+    case EFFECT_ATTACK_UP_HIT: if (roll) Field_ApplyStatStage(atkSide, STAT_ATK, 1, FALSE); break;
+    case EFFECT_DEFENSE_UP_HIT: if (roll) Field_ApplyStatStage(atkSide, STAT_DEF, 1, FALSE); break;
+    case EFFECT_ALL_STATS_UP_HIT:
+        if (roll)
+        {
+            u8 s;
+            for (s = STAT_ATK; s <= STAT_SPDEF; s++)
+                Field_ApplyStatStage(atkSide, s, 1, FALSE);
+        }
+        break;
+    case EFFECT_SECRET_POWER: // Cmd_getsecretpowereffect (:9639)
+        if (roll && onTarget)
+        {
+            switch (gBattleEnvironment)
+            {
+            case BATTLE_ENVIRONMENT_GRASS: Field_TryStatus(defSide, atkSide, a->move, STATUS1_POISON, FALSE); break;
+            case BATTLE_ENVIRONMENT_LONG_GRASS: Field_TryStatus(defSide, atkSide, a->move, STATUS1_SLEEP, FALSE); break;
+            case BATTLE_ENVIRONMENT_SAND: Field_ApplyStatStage(defSide, STAT_ACC, -1, TRUE); break;
+            case BATTLE_ENVIRONMENT_UNDERWATER: Field_ApplyStatStage(defSide, STAT_DEF, -1, TRUE); break;
+            case BATTLE_ENVIRONMENT_WATER: Field_ApplyStatStage(defSide, STAT_ATK, -1, TRUE); break;
+            case BATTLE_ENVIRONMENT_POND: Field_ApplyStatStage(defSide, STAT_SPEED, -1, TRUE); break;
+            case BATTLE_ENVIRONMENT_MOUNTAIN: Field_TryConfuse(defSide, atkSide, a->move, FALSE); break;
+            case BATTLE_ENVIRONMENT_CAVE: Flinch(defSide); break;
+            default: Field_TryStatus(defSide, atkSide, a->move, STATUS1_PARALYSIS, FALSE); break;
+            }
+        }
+        break;
+    }
+}
+
+// ---- Hitting ---------------------------------------------------------------------------------------
+
+static bool8 CanHitInvulnerable(u16 move, u8 kind)
+{
+    switch (kind)
+    {
+    case INVULN_AIR:         return move == MOVE_GUST || move == MOVE_TWISTER || move == MOVE_THUNDER || move == MOVE_SKY_UPPERCUT;
+    case INVULN_UNDERGROUND: return move == MOVE_EARTHQUAKE || move == MOVE_MAGNITUDE;
+    case INVULN_UNDERWATER:  return move == MOVE_SURF || move == MOVE_WHIRLPOOL;
+    }
+    return FALSE;
+}
+
+static struct Fighter *LiveUser(const struct Attack *a)
+{
+    // The fighter that launched the attack, if it is still the one on the field.
+    struct Fighter *f = &sB.f[a->side];
+    if (a->side == SIDE_PLAYER && a->userSlot != sB.active)
+        return NULL;
+    return f->bm.hp ? f : NULL;
+}
+
+// One hit of attack `a` on the opponent. `last` = final hit of this attack (i-frames, recoil...).
+static void ApplyHit(struct Attack *a, bool8 last)
+{
+    u8 defSide = a->side ^ 1;
+    struct Fighter *def = &sB.f[defSide];
+    struct Fighter *me = LiveUser(a);
+    const struct BattleMove *m = &gBattleMoves[a->move];
+    u16 eff;
+    bool8 crit;
+    s32 dmg;
+    u8 type = m->type;
+
+    if (def->bm.hp == 0)
+        return;
+    if (def->invuln && !CanHitInvulnerable(a->move, def->invulnKind))
+        return;
+    if (def->iframes)
+        return;
+    if (def->barrier && (m->flags & FLAG_PROTECT_AFFECTED))
+    {
+        if (a->move == MOVE_BRICK_BREAK)
+        {
+            def->barrier = FALSE; // Gen 3 Brick Break shatters screens; here the BN Barrier
+            SetMsg("IT SHATTERED THE BARRIER!", 50);
+        }
+        else
+        {
+            def->barrier = FALSE;
+            def->hurtFlash = 6;
+            SetMsg("BARRIER BLOCKED IT!", 50);
+            PlaySE(SE_BOO);
+            PKBN_LOG("%s's barrier absorbed move %u", def->name, a->move);
+            a->hitAnything = TRUE;
+            return;
+        }
+    }
+
+    dmg = CalcHitDamage(a, defSide, &eff, &crit);
+    a->hitAnything = TRUE;
+    if (dmg < 0)
+    {
+        SayFighter(def, "WASN'T AFFECTED!", 50);
+        return;
+    }
+    if (eff == TYPE_MUL_NO_EFFECT)
+    {
+        SetMsg("IT DOESN'T AFFECT IT...", 50);
+        PlaySE(SE_FAILURE);
+        PKBN_LOG("move %u: no effect on %s", a->move, def->name);
+        return;
+    }
+    // Gust / Twister x2 on a flyer, Earthquake / Magnitude x2 on a digger, Surf / Whirlpool on a diver (Gen 3)
+    if (def->invuln && CanHitInvulnerable(a->move, def->invulnKind))
+        dmg *= 2;
+    // Tornado ticks split one hit's damage (TUNE: keeps Gen 3 totals)
+    if (a->kind == GK_TORNADO)
+    {
+        dmg /= TORNADO_TICKS;
+        if (dmg < 1) dmg = 1;
+    }
+    // BN6 holy panel: (damage + 1) >> 1 (object_calculateFinalDamage1, object.s:4811)
+    if (sB.panel[def->y][def->x] == PANEL_HOLY)
+        dmg = (dmg + 1) >> 1;
+    // False Swipe leaves 1 HP (Gen 3)
+    if (m->effect == EFFECT_FALSE_SWIPE && dmg >= def->bm.hp)
+        dmg = def->bm.hp - 1;
+    if (dmg > def->bm.hp)
+        dmg = def->bm.hp;
+
+    // Bide stores what it takes
+    if (def->bideFrames)
+        def->bideDamage += dmg;
+
+    def->bm.hp -= dmg;
+    def->hurtFlash = 8;
+    def->lastHitFrame = sB.frame ? sB.frame : 1;
+    if (IS_TYPE_PHYSICAL(type))
+        def->lastPhysDamage = dmg;
+    if (def->charging)
+        def->focusBroken = TRUE; // Focus Punch: "lost its focus"
+    if (last && defSide == SIDE_PLAYER)
+        def->iframes = HIT_IFRAMES;
+    Field_WakeOnHit(defSide);
+    if ((def->bm.status1 & STATUS1_FREEZE) && type == TYPE_FIRE)
+    {
+        def->bm.status1 &= ~STATUS1_FREEZE; // Gen 3: Fire moves thaw the target
+        SayFighter(def, "THAWED OUT!", 40);
+    }
+
+    if (crit)
+        SetMsg("A CRITICAL HIT!", 50);
+    else if (eff > TYPE_MUL_NORMAL)
+        SetMsg("SUPER EFFECTIVE!", 50);
+    else if (eff < TYPE_MUL_NORMAL)
+        SetMsg("NOT VERY EFFECTIVE", 50);
+    PlaySE(eff > TYPE_MUL_NORMAL ? SE_SUPER_EFFECTIVE : eff < TYPE_MUL_NORMAL ? SE_NOT_EFFECTIVE : SE_EFFECTIVE);
+    PKBN_LOG("%s's %s (move %u) hit %s: %d dmg (x%u/10%s) -> %u/%u HP", a->userName, gPkbnKindNames[a->kind],
+             a->move, def->name, (int)dmg, eff, crit ? ", crit" : "", def->bm.hp, def->bm.maxHP);
+
+    // drain (Absorb family, Dream Eater): half the damage (Gen 3)
+    if ((m->effect == EFFECT_ABSORB || m->effect == EFFECT_DREAM_EATER) && me)
+        Heal(me, dmg / 2 ? dmg / 2 : 1);
+    // recoil (Gen 3: 1/4, Double-Edge family 1/3); Rock Head ignores it
+    if (me && me->bm.ability != ABILITY_ROCK_HEAD)
+    {
+        if (m->effect == EFFECT_RECOIL)
+            Moves_DamageFighter(a->side, dmg / 4 ? dmg / 4 : 1, "IS HIT WITH RECOIL!");
+        else if (m->effect == EFFECT_DOUBLE_EDGE)
+            Moves_DamageFighter(a->side, dmg / 3 ? dmg / 3 : 1, "IS HIT WITH RECOIL!");
+    }
+    if (a->move == MOVE_STRUGGLE && me)
+        Moves_DamageFighter(a->side, dmg / 4 ? dmg / 4 : 1, "IS HIT WITH RECOIL!");
+
+    if (def->bm.hp == 0)
+        return;
+    SecondaryEffect(a, defSide);
+    if ((a->info.flags & GF_HOLD) && !def->trapTurns)
+    {
+        def->hold = HOLD_FRAMES;
+        def->trapTurns = (Random() % 4) + 2; // Gen 3 wrap: 2-5 turns
+        SayFighter(def, "IS TRAPPED!", 50);
+    }
+    if (a->info.flags & GF_PUSH)
+        Field_PushBack(defSide, 1);
+}
+
+// Hit the opponent if it stands on one of `cells`.
+static bool8 StrikeCells(struct Attack *a, const u8 cells[GRID_ROWS][GRID_COLS], bool8 last)
+{
+    struct Fighter *opp = &sB.f[a->side ^ 1];
+    if (cells[opp->y][opp->x])
+    {
+        ApplyHit(a, last);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// ---- Shapes ---------------------------------------------------------------------------------------
+
+static void Mark(u8 cells[GRID_ROWS][GRID_COLS], s32 c, s32 r)
+{
+    if (InGrid(c, r))
+        cells[r][c] = 1;
+}
+
+// Panels a direct kind hits from (x, y). CANNON-like kinds stop at the first target.
+static void DirectCells(u8 side, struct Attack *a, s8 x, s8 y, u8 cells[GRID_ROWS][GRID_COLS])
+{
+    struct Fighter *opp = &sB.f[side ^ 1];
+    s8 dir = Facing(side);
+    s32 c, r, d;
+    memset(cells, 0, GRID_ROWS * GRID_COLS);
+
+    switch (a->kind)
+    {
+    case GK_CANNON:
+    case GK_AIRSHOT:
+    case GK_SPREADER:
+    case GK_VULCAN:
+        for (r = (a->info.rows == 3 ? y - 1 : y); r <= (a->info.rows == 3 ? y + 1 : y); r++)
+        {
+            if (r < 0 || r >= GRID_ROWS)
+                continue;
+            for (c = x + dir; c >= 0 && c < GRID_COLS; c += dir)
+            {
+                cells[r][c] = 1;
+                if (opp->x == c && opp->y == r && !opp->invuln)
+                {
+                    if (a->kind == GK_SPREADER)
+                    {
+                        s32 dx, dy;
+                        for (dy = -1; dy <= 1; dy++)
+                            for (dx = -1; dx <= 1; dx++)
+                                Mark(cells, c + dx, r + dy);
+                    }
+                    if (a->kind == GK_VULCAN)
+                        Mark(cells, c + dir, r); // BN6 Vulcan pierces 1 panel
+                    break;
+                }
+            }
+        }
+        break;
+    case GK_SWORD:
+        Mark(cells, x + dir, y);
+        break;
+    case GK_LONGSWORD:
+        Mark(cells, x + dir, y);
+        Mark(cells, x + 2 * dir, y);
+        break;
+    case GK_WIDESWORD:
+        for (r = -1; r <= 1; r++)
+            Mark(cells, x + dir, y + r);
+        break;
+    case GK_LIFESWORD:
+        for (r = -1; r <= 1; r++)
+            for (d = 1; d <= 2; d++)
+                Mark(cells, x + d * dir, y + r);
+        break;
+    case GK_LINE3:
+        for (d = 1; d <= 3; d++)
+            Mark(cells, x + d * dir, y);
+        break;
+    case GK_DASH:
+        for (d = 1; d <= 5; d++)
+            Mark(cells, x + d * dir, y);
+        break;
+    case GK_CONE:
+        Mark(cells, x + dir, y);
+        for (r = -1; r <= 1; r++)
+            Mark(cells, x + 2 * dir, y + r);
+        break;
+    case GK_TORNADO:
+        Mark(cells, x + 2 * dir, y);
+        break;
+    }
+}
+
+static void BlastCells(u8 pattern, s8 cx, s8 cy, u8 cells[GRID_ROWS][GRID_COLS])
+{
+    s32 dx, dy;
+    memset(cells, 0, GRID_ROWS * GRID_COLS);
+    Mark(cells, cx, cy);
+    if (pattern == BLAST_SINGLE)
+        return;
+    for (dy = -1; dy <= 1; dy++)
+        for (dx = -1; dx <= 1; dx++)
+        {
+            bool8 orth = (dx == 0) != (dy == 0);
+            bool8 diag = dx != 0 && dy != 0;
+            if ((pattern == BLAST_PLUS && orth) || (pattern == BLAST_X && diag) || pattern == BLAST_SQUARE)
+                Mark(cells, cx + dx, cy + dy);
+        }
+}
+
+static void EnemyAreaCells(u8 side, u8 cells[GRID_ROWS][GRID_COLS])
+{
+    s32 r, c;
+    memset(cells, 0, GRID_ROWS * GRID_COLS);
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (side == SIDE_PLAYER ? c >= PLAYER_COLS : c < PLAYER_COLS)
+                cells[r][c] = 1;
+}
+
+static u8 HitCount(const struct Attack *a)
+{
+    if (a->info.hits == HITS_2_TO_5)
+    {
+        // Cmd_setmultihitcounter (:7159)
+        u8 n = Random() & 3;
+        return n > 1 ? (Random() & 3) + 2 : n + 2;
+    }
+    if (a->info.hits == HITS_PARTY)
+    {
+        // Beat Up: every party member with HP and no status (Cmd_trydobeatup)
+        u8 n = 0, i;
+        if (a->side == SIDE_ENEMY)
+            return 1;
+        for (i = 0; i < sB.partyCount; i++)
+        {
+            const struct BattlePokemon *b = (i == sB.active) ? &sB.f[SIDE_PLAYER].bm : &sB.party[i].bm;
+            if (b->species && b->hp && !b->status1)
+                n++;
+        }
+        return n ? n : 1;
+    }
+    return a->info.hits ? a->info.hits : 1;
+}
+
+// ---- Launch / update per kind -------------------------------------------------------------------------
+
+static u16 FireHitWarn(const struct Attack *a)
+{
+    u16 base = (a->info.flags & GF_FAST) ? FIREHIT_FAST : (a->info.flags & GF_SLOW) ? FIREHIT_SLOW : FIREHIT_NORMAL;
+    return ScaleByAccuracy(base, a->side, &a->user);
+}
+
+// Ball speed: 100% accuracy -> 10 frames per panel; every 5% below adds 2 (TUNE).
+// Review: low-accuracy moves become slow projectiles that are easy to dodge.
+static u8 BallStep(const struct Attack *a)
+{
+    u8 acc = gBattleMoves[a->move].accuracy;
+    u16 step = 10 + (acc && acc < 100 ? (100 - acc) * 2 / 5 : 0);
+    if (a->info.flags & GF_FAST)
+        step /= 2;
+    return ScaleByAccuracy(step, a->side, &a->user);
+}
+
+static void StartProjectile(struct Attack *a, u8 step)
+{
+    a->phase = PH_TRAVEL;
+    a->px = a->ox + Facing(a->side);
+    a->py = a->oy;
+    a->vx = Facing(a->side);
+    a->vy = 0;
+    a->step = step;
+    a->timer = step;
+}
+
+static void NextMeteor(struct Attack *a)
+{
+    struct Fighter *opp = &sB.f[a->side ^ 1];
+    s8 x = opp->x, y = opp->y;
+    if (Random() & 1) // half the rocks drift to a neighbouring enemy panel (TUNE)
+    {
+        s8 nx = x + (s8)(Random() % 3) - 1, ny = y + (s8)(Random() % 3) - 1;
+        if (Field_CanStand(a->side ^ 1, nx, ny) || (InGrid(nx, ny) && (a->side == SIDE_PLAYER ? nx >= PLAYER_COLS : nx < PLAYER_COLS)))
+            x = nx, y = ny;
+    }
+    a->tx = x;
+    a->ty = y;
+    memset(a->cells, 0, sizeof(a->cells));
+    Mark(a->cells, x, y);
+    a->timer = ScaleByAccuracy(METEOR_WARN, a->side, &a->user);
+}
+
+static void Finish(struct Attack *a)
+{
+    struct Fighter *me = LiveUser(a);
+    const struct BattleMove *m = &gBattleMoves[a->move];
+    // Jump Kick / Hi Jump Kick crash if they hit nothing (Gen 3: half the damage they would have done)
+    if (m->effect == EFFECT_RECOIL_IF_MISS && !a->hitAnything && me)
+    {
+        u16 eff; bool8 crit;
+        s32 d = CalcHitDamage(a, a->side ^ 1, &eff, &crit) / 2;
+        Moves_DamageFighter(a->side, d ? d : 1, "KEPT GOING AND CRASHED!");
+    }
+    // Thrash / Outrage / Petal Dance: confused afterwards (Gen 3 rampage end)
+    if (m->effect == EFFECT_RAMPAGE && me)
+        Field_TryConfuse(a->side, a->side, a->move, FALSE);
+    if (me && (m->effect == EFFECT_OVERHEAT))
+        Field_ApplyStatStage(a->side, STAT_SPATK, -2, FALSE);
+    if (me && m->effect == EFFECT_SUPERPOWER)
+    {
+        Field_ApplyStatStage(a->side, STAT_ATK, -1, FALSE);
+        Field_ApplyStatStage(a->side, STAT_DEF, -1, FALSE);
+    }
+    if (me && a->move == MOVE_FLY)
+        me->lockout = FLY_RECOVERY;
+    a->active = FALSE;
+}
+
+static void Launch(struct Attack *a)
+{
+    struct Fighter *me = &sB.f[a->side];
+    struct Fighter *opp = &sB.f[a->side ^ 1];
+
+    a->ox = me->x;
+    a->oy = me->y;
+    a->hitsLeft = HitCount(a);
+    a->hitIndex = 0;
+    a->phase = PH_WAIT;
+
+    switch (a->kind)
+    {
+    case GK_CANNON: case GK_AIRSHOT: case GK_SPREADER: case GK_VULCAN:
+    case GK_SWORD: case GK_LONGSWORD: case GK_WIDESWORD: case GK_LIFESWORD: case GK_LINE3:
+    case GK_DASH: case GK_CONE: case GK_TORNADO:
+        DirectCells(a->side, a, a->ox, a->oy, a->cells);
+        // The player's direct attacks land at once; the enemy telegraphs them.
+        a->timer = (a->side == SIDE_ENEMY) ? ScaleByAccuracy(ENEMY_TELEGRAPH, a->side, &a->user) : 0;
+        if (a->kind == GK_TORNADO)
+            a->hitsLeft = TORNADO_TICKS;
+        break;
+    case GK_FIREHIT:
+    case GK_GOLEMHIT:
+        a->tx = opp->x;
+        a->ty = opp->y;
+        memset(a->cells, 0, sizeof(a->cells));
+        Mark(a->cells, a->tx, a->ty);
+        if (a->kind == GK_GOLEMHIT)
+        {
+            Mark(a->cells, a->tx, a->ty - 1);
+            Mark(a->cells, a->tx, a->ty + 1);
+        }
+        a->timer = FireHitWarn(a);
+        break;
+    case GK_METEORS:
+        a->hitsLeft = 3; // TUNE: three rocks
+        NextMeteor(a);
+        break;
+    case GK_DIG:
+        me->invuln = DIG_VANISH + 60;
+        me->invulnKind = a->move == MOVE_DIVE ? INVULN_UNDERWATER : INVULN_UNDERGROUND;
+        a->timer = DIG_VANISH;
+        a->phase = PH_UNDERGROUND; // vanish sub-phase, see UpdateAttack
+        memset(a->cells, 0, sizeof(a->cells));
+        break;
+    case GK_DELAYED:
+        a->timer = DELAYED_WAIT;
+        memset(a->cells, 0, sizeof(a->cells));
+        break;
+    case GK_FIELD:
+        EnemyAreaCells(a->side, a->cells);
+        a->timer = FIELD_WARN;
+        break;
+    case GK_BOMB:
+        a->tx = a->ox + Facing(a->side) * GRENADE_RANGE;
+        a->ty = a->oy;
+        BlastCells(a->info.pattern, a->tx, a->ty, a->cells);
+        a->timer = (a->info.flags & GF_SLOW) ? GRENADE_FLIGHT * 2 : GRENADE_FLIGHT;
+        a->duration = a->timer;
+        if (a->info.flags & GF_INVULN)
+        {
+            me->invuln = a->timer;
+            me->invulnKind = INVULN_AIR;
+        }
+        me->lockout = THROW_LOCKOUT;
+        break;
+    case GK_SHOCKWAVE:
+        StartProjectile(a, (a->info.flags & GF_FAST) ? SHOCKWAVE_STEP / 2 : SHOCKWAVE_STEP);
+        break;
+    case GK_WAVE:
+        StartProjectile(a, ScaleByAccuracy((a->info.flags & GF_FAST) ? WAVE_STEP / 2 : WAVE_STEP, a->side, &a->user));
+        break;
+    case GK_BALL:
+        StartProjectile(a, BallStep(a));
+        break;
+    case GK_AIRHOCKEY:
+        StartProjectile(a, AIRHOCKEY_STEP);
+        a->vy = (a->oy == GRID_ROWS - 1) ? -1 : 1; // BN6 AirHocky starts on a diagonal
+        a->bounces = AIRHOCKEY_BOUNCES;
+        break;
+    case GK_LOCKON:
+        a->tx = opp->x;
+        a->ty = opp->y;
+        a->timer = LOCKON_FRAMES;
+        break;
+    }
+    a->duration = a->timer ? a->timer : 1;
+    if (a->info.flags & GF_RECHARGE)
+        me->recharge = TRUE; // review: no chips at the next Custom
+}
+
+// A projectile entering (px, py): hit the opponent standing there.
+static bool8 ProjectileHits(struct Attack *a, s8 x, s8 y)
+{
+    struct Fighter *opp = &sB.f[a->side ^ 1];
+    if (opp->x == x && opp->y == y && !(opp->invuln && !CanHitInvulnerable(a->move, opp->invulnKind)))
+        return TRUE;
+    return FALSE;
+}
+
+static void ApplyBallStatus(struct Attack *a);
+static void ResolvePanelAttack(struct Attack *a);
+
+static void UpdateTravel(struct Attack *a)
+{
+    s32 r;
+    if (--a->timer > 0)
+        return;
+    a->timer = a->step;
+
+    switch (a->kind)
+    {
+    case GK_AIRHOCKEY:
+    {
+        s8 nx = a->px + a->vx, ny = a->py + a->vy;
+        if (ny < 0 || ny >= GRID_ROWS)
+        {
+            a->vy = -a->vy;
+            ny = a->py + a->vy;
+        }
+        if (nx < 0 || nx >= GRID_COLS)
+        {
+            if (a->bounces == 0)
+            {
+                Finish(a);
+                return;
+            }
+            a->bounces--;
+            a->vx = -a->vx;
+            nx = a->px + a->vx;
+        }
+        a->px = nx;
+        a->py = ny;
+        if (ProjectileHits(a, a->px, a->py) && a->hitsLeft)
+        {
+            ApplyHit(a, a->hitsLeft == 1);
+            FlashPanel(a->px, a->py, 8);
+            a->hitsLeft--;
+            if (a->hitsLeft == 0)
+            {
+                Finish(a);
+                return;
+            }
+        }
+        break;
+    }
+    case GK_SHOCKWAVE:
+    case GK_WAVE:
+    case GK_BALL:
+    case GK_DELAYED:
+    {
+        bool8 three = a->info.rows == 3 && a->kind != GK_BALL && a->kind != GK_DELAYED;
+        a->px += a->vx;
+        if (a->px < 0 || a->px >= GRID_COLS)
+        {
+            Finish(a);
+            return;
+        }
+        // A ground wave stops at a hole (BN shockwaves can't cross broken panels).
+        if (a->kind == GK_SHOCKWAVE && sB.panel[a->py][a->px] == PANEL_BROKEN)
+        {
+            Finish(a);
+            return;
+        }
+        memset(a->cells, 0, sizeof(a->cells));
+        for (r = three ? 0 : a->py; r <= (three ? GRID_ROWS - 1 : a->py); r++)
+        {
+            Mark(a->cells, a->px, r);
+            FlashPanel(a->px, r, 2);
+            if (!a->hitDone && ProjectileHits(a, a->px, r))
+            {
+                a->hitDone = TRUE;
+                if (a->kind == GK_BALL && gBattleMoves[a->move].power == 0)
+                    ApplyBallStatus(a);
+                else
+                    ApplyHit(a, TRUE);
+                FlashPanel(a->px, r, 10);
+                if (a->kind == GK_BALL || a->kind == GK_DELAYED)
+                {
+                    Finish(a);
+                    return;
+                }
+            }
+        }
+        break;
+    }
+    }
+}
+
+static void Impact(struct Attack *a)
+{
+    struct Fighter *me = &sB.f[a->side];
+    switch (a->kind)
+    {
+    case GK_CANNON: case GK_AIRSHOT: case GK_SPREADER: case GK_VULCAN:
+    case GK_SWORD: case GK_LONGSWORD: case GK_WIDESWORD: case GK_LIFESWORD: case GK_LINE3:
+    case GK_DASH: case GK_CONE: case GK_TORNADO:
+        DirectCells(a->side, a, a->ox, a->oy, a->cells);
+        StrikeCells(a, a->cells, a->hitsLeft <= 1);
+        FlashCells(a->cells, 10);
+        if (a->kind == GK_AIRSHOT && a->hitAnything)
+            Field_PushBack(a->side ^ 1, 1);
+        break;
+    case GK_FIREHIT:
+    case GK_GOLEMHIT:
+    case GK_FIELD:
+        StrikeCells(a, a->cells, TRUE);
+        FlashCells(a->cells, 12);
+        if (a->kind == GK_FIELD)
+        {
+            if (LiveUser(a))
+                Moves_DamageFighter(a->side, me->bm.hp, "FAINTED FROM THE BLAST!"); // Gen 3: the user faints
+            PlaySE(SE_M_EXPLOSION);
+        }
+        break;
+    case GK_METEORS:
+        StrikeCells(a, a->cells, a->hitsLeft <= 1);
+        FlashCells(a->cells, 10);
+        PlaySE(SE_M_ROCK_THROW);
+        break;
+    case GK_BOMB:
+        StrikeCells(a, a->cells, a->hitsLeft <= 1);
+        FlashCells(a->cells, 12);
+        PKBN_LOG("%s's bomb (move %u) landed on (%d,%d)", a->userName, a->move, a->tx, a->ty);
+        break;
+    case GK_LOCKON:
+    {
+        struct Fighter *opp = &sB.f[a->side ^ 1];
+        memset(a->cells, 0, sizeof(a->cells));
+        a->cells[opp->y][opp->x] = 1;
+        ApplyHit(a, TRUE); // can't be dodged; Barrier / i-frames still apply
+        FlashCells(a->cells, 10);
+        break;
+    }
+    }
+}
+
+static void UpdateAttack(struct Attack *a)
+{
+    struct Fighter *me = &sB.f[a->side];
+
+    if (a->kind == GK_LOCKON)
+    {
+        a->tx = sB.f[a->side ^ 1].x;
+        a->ty = sB.f[a->side ^ 1].y;
+    }
+
+    switch (a->phase)
+    {
+    case PH_CHARGE:
+        if (a->timer && --a->timer)
+            return;
+        me->charging = 0;
+        if (me->focusBroken)
+        {
+            me->focusBroken = FALSE;
+            SayFighter(me, "LOST ITS FOCUS!", 50);
+            PlaySE(SE_FAILURE);
+            a->active = FALSE;
+            return;
+        }
+        Launch(a);
+        if (a->timer == 0 && a->phase == PH_WAIT)
+        {
+            Impact(a);
+            goto after_impact;
+        }
+        return;
+    case PH_UNDERGROUND: // Dig / Dive: underground, then the strike is marked under the target
+        if (--a->timer)
+            return;
+        {
+            struct Fighter *opp = &sB.f[a->side ^ 1];
+            a->tx = opp->x;
+            a->ty = opp->y;
+            memset(a->cells, 0, sizeof(a->cells));
+            Mark(a->cells, a->tx, a->ty);
+            a->timer = ScaleByAccuracy(DIG_WARN, a->side, &a->user);
+            a->phase = PH_WAIT;
+            a->kind = GK_FIREHIT; // resolves like a FireHit
+        }
+        return;
+    case PH_TRAVEL:
+        UpdateTravel(a);
+        return;
+    case PH_GAP:
+        if (--a->timer)
+            return;
+        a->phase = PH_WAIT;
+        if (a->kind == GK_METEORS)
+        {
+            NextMeteor(a);
+            return;
+        }
+        if (a->kind == GK_BOMB)
+        {
+            // next bomb of a volley, thrown from where the user stands now
+            a->ox = me->x;
+            a->oy = me->y;
+            a->tx = a->ox + Facing(a->side) * GRENADE_RANGE;
+            a->ty = a->oy;
+            BlastCells(a->info.pattern, a->tx, a->ty, a->cells);
+            a->timer = a->duration = GRENADE_FLIGHT / 2;
+            return;
+        }
+        Impact(a);
+        goto after_impact;
+    case PH_WAIT:
+        if (a->kind == GK_DELAYED)
+        {
+            if (--a->timer)
+                return;
+            // Future Sight / Doom Desire: the shot comes down the row the user stood in
+            StartProjectile(a, DELAYED_STEP);
+            PlaySE(SE_M_HYPER_BEAM);
+            return;
+        }
+        if (a->timer && --a->timer)
+            return;
+        if (a->kind == GK_PANEL)
+        {
+            ResolvePanelAttack(a);
+            return;
+        }
+        Impact(a);
+        goto after_impact;
+    }
+    return;
+
+after_impact:
+    if (!a->active)
+        return;
+    a->hitIndex++;
+    if (a->hitsLeft > 1)
+    {
+        a->hitsLeft--;
+        a->phase = PH_GAP;
+        a->timer = (a->kind == GK_VULCAN) ? VULCAN_GAP : (a->kind == GK_TORNADO) ? TORNADO_GAP
+                 : (a->kind == GK_METEORS) ? 12 : (a->kind == GK_BOMB) ? 10 : MULTI_HIT_GAP;
+        return;
+    }
+    if (a->hitIndex > 1 && a->kind != GK_TORNADO && a->kind != GK_METEORS)
+    {
+        char line[24];
+        snprintf(line, sizeof(line), "HIT %u TIMES!", a->hitIndex);
+        SetMsg(line, 40);
+    }
+    Finish(a);
+}
+
+void Moves_Update(void)
+{
+    s32 i;
+    for (i = 0; i < 2; i++)
+    {
+        struct Fighter *f = &sB.f[i];
+        if (f->bideFrames && --f->bideFrames == 0 && f->bm.hp)
+        {
+            // Bide (Gen 3): returns double the damage taken, ignoring type
+            if (f->bideDamage)
+            {
+                Moves_DamageFighter(i ^ 1, f->bideDamage * 2, "TOOK THE UNLEASHED ENERGY!");
+                FlashPanel(sB.f[i ^ 1].x, sB.f[i ^ 1].y, 12);
+            }
+            else
+                SayFighter(f, "UNLEASHED ENERGY... BUT FAILED!", 50);
+        }
+    }
+    for (i = 0; i < MAX_ATTACKS; i++)
+        if (sB.attacks[i].active)
+            UpdateAttack(&sB.attacks[i]);
+}
+
+void Moves_ApplyBuster(u8 side)
+{
+    u8 cells[GRID_ROWS][GRID_COLS];
+    struct Fighter *me = &sB.f[side];
+    struct Fighter *opp = &sB.f[side ^ 1];
+    s32 c;
+    memset(cells, 0, sizeof(cells));
+    for (c = me->x + Facing(side); c >= 0 && c < GRID_COLS; c += Facing(side))
+    {
+        cells[me->y][c] = 1;
+        if (opp->x == c && opp->y == me->y)
+            break;
+    }
+    FlashCells(cells, 3);
+    if (!cells[opp->y][opp->x] || opp->iframes || opp->invuln || opp->bm.hp == 0)
+        return;
+    if (opp->barrier)
+    {
+        opp->barrier = FALSE;
+        SetMsg("BARRIER BLOCKED IT!", 50);
+        return;
+    }
+    if (opp->bm.hp > BUSTER_DAMAGE)
+        opp->bm.hp -= BUSTER_DAMAGE;
+    else
+        opp->bm.hp = 0;
+    opp->hurtFlash = 4;
+    opp->lastHitFrame = sB.frame;
+    Field_WakeOnHit(side ^ 1);
+}
+
+// ---- Non-damaging moves --------------------------------------------------------------------------
+
+static bool8 MagicCoatBounce(u8 *targetSide, u8 userSide, u16 move)
+{
+    struct Fighter *t = &sB.f[*targetSide];
+    if (*targetSide != userSide && t->magicCoat && (gBattleMoves[move].flags & FLAG_MAGIC_COAT_AFFECTED))
+    {
+        t->magicCoat = FALSE; // review: like Safeguard, but the effect goes back to the user
+        SetMsg("MAGIC COAT BOUNCED IT BACK!", 50);
+        PKBN_LOG("Magic Coat bounced move %u", move);
+        *targetSide = userSide;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 Soundproofed(u8 targetSide, u16 move)
+{
+    if (sB.f[targetSide].bm.ability == ABILITY_SOUNDPROOF && InList(sSoundMoves, ARRAY_COUNT(sSoundMoves), move))
+    {
+        SetMsg("SOUNDPROOF BLOCKS IT!", 50);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// Stat-stage moves (Gen 3 effect ids, constants/battle_move_effects.h). Always land (POC-3 rule).
+static void UseStatsMove(u8 side, u16 move)
+{
+    u8 e = gBattleMoves[move].effect;
+    u8 foe = side ^ 1;
+    struct Fighter *me = &sB.f[side];
+
+    if (e >= EFFECT_ATTACK_UP && e <= EFFECT_EVASION_UP)
+        Field_ApplyStatStage(side, STAT_ATK + (e - EFFECT_ATTACK_UP), 1, FALSE);
+    else if (e >= EFFECT_ATTACK_UP_2 && e <= EFFECT_EVASION_UP_2)
+        Field_ApplyStatStage(side, STAT_ATK + (e - EFFECT_ATTACK_UP_2), 2, FALSE);
+    else if ((e >= EFFECT_ATTACK_DOWN && e <= EFFECT_EVASION_DOWN) || (e >= EFFECT_ATTACK_DOWN_2 && e <= EFFECT_EVASION_DOWN_2)
+          || e == EFFECT_TICKLE)
+    {
+        u8 target = foe;
+        if (Soundproofed(foe, move))
+            return;
+        MagicCoatBounce(&target, side, move);
+        if (e == EFFECT_TICKLE)
+        {
+            Field_ApplyStatStage(target, STAT_ATK, -1, target != side);
+            Field_ApplyStatStage(target, STAT_DEF, -1, target != side);
+        }
+        else if (e <= EFFECT_EVASION_DOWN)
+            Field_ApplyStatStage(target, STAT_ATK + (e - EFFECT_ATTACK_DOWN), -1, target != side);
+        else
+            Field_ApplyStatStage(target, STAT_ATK + (e - EFFECT_ATTACK_DOWN_2), -2, target != side);
+    }
+    else switch (e)
+    {
+    case EFFECT_DEFENSE_CURL:
+        Field_ApplyStatStage(side, STAT_DEF, 1, FALSE);
+        me->defenseCurl = TRUE;
+        break;
+    case EFFECT_BULK_UP:
+        Field_ApplyStatStage(side, STAT_ATK, 1, FALSE);
+        Field_ApplyStatStage(side, STAT_DEF, 1, FALSE);
+        break;
+    case EFFECT_CALM_MIND:
+        Field_ApplyStatStage(side, STAT_SPATK, 1, FALSE);
+        Field_ApplyStatStage(side, STAT_SPDEF, 1, FALSE);
+        break;
+    case EFFECT_COSMIC_POWER:
+        Field_ApplyStatStage(side, STAT_DEF, 1, FALSE);
+        Field_ApplyStatStage(side, STAT_SPDEF, 1, FALSE);
+        break;
+    case EFFECT_DRAGON_DANCE:
+        Field_ApplyStatStage(side, STAT_ATK, 1, FALSE);
+        Field_ApplyStatStage(side, STAT_SPEED, 1, FALSE);
+        break;
+    case EFFECT_CURSE:
+        if (FighterHasType(me, TYPE_GHOST))
+        {
+            // Ghost Curse (Gen 3): lose half your max HP, the foe loses 1/4 every turn
+            Moves_DamageFighter(side, me->bm.maxHP / 2, "CUT ITS OWN HP!");
+            sB.f[foe].cursed = TRUE;
+        }
+        else
+        {
+            Field_ApplyStatStage(side, STAT_SPEED, -1, FALSE);
+            Field_ApplyStatStage(side, STAT_ATK, 1, FALSE);
+            Field_ApplyStatStage(side, STAT_DEF, 1, FALSE);
+        }
+        break;
+    }
+}
+
+static u32 StatusOfMove(u16 move)
+{
+    switch (gBattleMoves[move].effect)
+    {
+    case EFFECT_SLEEP: return STATUS1_SLEEP;
+    case EFFECT_POISON: return STATUS1_POISON;
+    case EFFECT_TOXIC: return STATUS1_TOXIC_POISON;
+    case EFFECT_PARALYZE: return STATUS1_PARALYSIS;
+    case EFFECT_WILL_O_WISP: return STATUS1_BURN;
+    }
+    return 0;
+}
+
+static void Seed(struct Fighter *t)
+{
+    // Leech Seed (Gen 3): Grass types are immune; 1/8 per turn goes to the other side.
+    if (FighterHasType(t, TYPE_GRASS) || t->seeded)
+    {
+        SetMsg("IT DOESN'T AFFECT IT...", 40);
+        return;
+    }
+    t->seeded = TRUE;
+    SayFighter(t, "WAS SEEDED!", 50);
+}
+
+// Status moves (STATUS kind, or a status BALL that connected).
+static void ApplyStatusEffect(u8 side, u16 move, u8 target)
+{
+    struct Fighter *t = &sB.f[target];
+    struct Fighter *me = &sB.f[side];
+    u8 e = gBattleMoves[move].effect;
+    u32 status = StatusOfMove(move);
+
+    if (Soundproofed(target, move))
+        return;
+    MagicCoatBounce(&target, side, move);
+    t = &sB.f[target];
+
+    // Thunder Wave doesn't affect Ground types (Gen 3 typecalc on the move's type)
+    if (move == MOVE_THUNDER_WAVE && FighterHasType(t, TYPE_GROUND))
+    {
+        SetMsg("IT DOESN'T AFFECT IT...", 50);
+        return;
+    }
+    if (status)
+    {
+        if (!Field_TryStatus(target, side, move, status, TRUE) && !t->statusFlash)
+            SetMsg("BUT IT FAILED!", 40);
+        return;
+    }
+    switch (e)
+    {
+    case EFFECT_CONFUSE:
+    case EFFECT_TEETER_DANCE:
+        Field_TryConfuse(target, side, move, TRUE);
+        break;
+    case EFFECT_SWAGGER:
+        Field_ApplyStatStage(target, STAT_ATK, 2, FALSE);
+        Field_TryConfuse(target, side, move, TRUE);
+        break;
+    case EFFECT_FLATTER:
+        Field_ApplyStatStage(target, STAT_SPATK, 1, FALSE);
+        Field_TryConfuse(target, side, move, TRUE);
+        break;
+    case EFFECT_ROAR:
+        // BN GoingRd "Push an enemy to the back"
+        Field_PushBack(target, 2);
+        PlaySE(SE_M_GUST);
+        break;
+    case EFFECT_MEAN_LOOK:
+        t->hold = 180; // TUNE
+        t->noEscape = TRUE;
+        SayFighter(t, "CAN'T ESCAPE NOW!", 50);
+        break;
+    case EFFECT_ATTRACT:
+    {
+        u8 g1 = GetGenderFromSpeciesAndPersonality(me->bm.species, me->bm.personality);
+        u8 g2 = GetGenderFromSpeciesAndPersonality(t->bm.species, t->bm.personality);
+        if (g1 == MON_GENDERLESS || g2 == MON_GENDERLESS || g1 == g2 || t->bm.ability == ABILITY_OBLIVIOUS || t->infatuated)
+            SetMsg("BUT IT FAILED!", 40);
+        else
+        {
+            t->infatuated = TRUE;
+            SayFighter(t, "FELL IN LOVE!", 50);
+        }
+        break;
+    }
+    case EFFECT_LEECH_SEED:
+        Seed(t);
+        break;
+    case EFFECT_LOCK_ON:
+        me->lockOnNext = TRUE;
+        SayFighter(me, "TOOK AIM!", 50);
+        break;
+    case EFFECT_NIGHTMARE:
+        if (t->bm.status1 & STATUS1_SLEEP)
+        {
+            t->nightmare = TRUE;
+            SayFighter(t, "BEGAN HAVING A NIGHTMARE!", 50);
+        }
+        else
+            SetMsg("BUT IT FAILED!", 40);
+        break;
+    case EFFECT_YAWN:
+        if (t->bm.status1 || t->yawn)
+            SetMsg("BUT IT FAILED!", 40);
+        else
+        {
+            t->yawn = 2; // Gen 3: asleep at the end of the next turn
+            SayFighter(t, "GREW DROWSY!", 50);
+        }
+        break;
+    case EFFECT_MEMENTO:
+        Field_ApplyStatStage(target, STAT_ATK, -2, TRUE);
+        Field_ApplyStatStage(target, STAT_SPATK, -2, TRUE);
+        Moves_DamageFighter(side, me->bm.hp, "FAINTED!");
+        break;
+    default:
+        SetMsg("BUT NOTHING HAPPENED!", 40);
+        break;
+    }
+}
+
+static void ApplyBallStatus(struct Attack *a)
+{
+    ApplyStatusEffect(a->side, a->move, a->side ^ 1);
+}
+
+static void HealHalf(struct Fighter *f)
+{
+    s32 h = f->bm.maxHP / 2;
+    if (f->bm.hp == f->bm.maxHP)
+    {
+        SetMsg("ITS HP IS FULL!", 40);
+        return;
+    }
+    Heal(f, h ? h : 1);
+    SayFighter(f, "REGAINED HEALTH!", 50);
+    PlaySE(SE_M_MORNING_SUN);
+}
+
+static void UseSelfMove(u8 side, u16 move)
+{
+    struct Fighter *me = &sB.f[side];
+    struct Fighter *foe = &sB.f[side ^ 1];
+    u8 e = gBattleMoves[move].effect;
+    s32 i;
+
+    switch (e)
+    {
+    case EFFECT_RESTORE_HP:
+    case EFFECT_SOFTBOILED:
+        HealHalf(me);
+        break;
+    case EFFECT_MORNING_SUN:
+    case EFFECT_SYNTHESIS:
+    case EFFECT_MOONLIGHT:
+    {
+        // Cmd_recoverbasedonsunlight (:8884)
+        s32 h = sB.weather == 0 ? me->bm.maxHP / 2 : (sB.weather & B_WEATHER_SUN) ? 20 * me->bm.maxHP / 30 : me->bm.maxHP / 4;
+        Heal(me, h ? h : 1);
+        SayFighter(me, "REGAINED HEALTH!", 50);
+        PlaySE(SE_M_MORNING_SUN);
+        break;
+    }
+    case EFFECT_REST:
+        // Gen 3 Rest: full HP, status replaced by 2 turns of sleep. Review: the sleep breaks when hit.
+        if (me->bm.hp == me->bm.maxHP || me->bm.ability == ABILITY_INSOMNIA || me->bm.ability == ABILITY_VITAL_SPIRIT)
+        {
+            SetMsg("BUT IT FAILED!", 40);
+            break;
+        }
+        me->bm.hp = me->bm.maxHP;
+        me->bm.status1 = STATUS1_SLEEP_TURN(3);
+        SayFighter(me, "SLEPT AND BECAME HEALTHY!", 60);
+        break;
+    case EFFECT_WISH:
+        sB.wishHeal[side] = me->bm.maxHP / 2; // review: lands when the next Custom opens
+        SayFighter(me, "MADE A WISH!", 50);
+        break;
+    case EFFECT_HAZE:
+        for (i = 0; i < NUM_BATTLE_STATS; i++)
+            me->bm.statStages[i] = foe->bm.statStages[i] = DEFAULT_STAT_STAGE;
+        SetMsg("ALL STAT CHANGES WERE ELIMINATED!", 50);
+        break;
+    case EFFECT_MIST:
+        me->mistTurns = 5;
+        SayFighter(me, "IS SHROUDED IN MIST!", 50);
+        break;
+    case EFFECT_FOCUS_ENERGY:
+        me->focusEnergy = TRUE;
+        SayFighter(me, "IS GETTING PUMPED!", 50);
+        break;
+    case EFFECT_BIDE:
+        me->bideFrames = 120; // Gen 3: 2 turns; here 2 seconds (TUNE)
+        me->bideDamage = 0;
+        SayFighter(me, "IS STORING ENERGY!", 50);
+        break;
+    case EFFECT_BELLY_DRUM:
+        if (me->bm.hp <= me->bm.maxHP / 2)
+        {
+            SetMsg("BUT IT FAILED!", 40);
+            break;
+        }
+        Moves_DamageFighter(side, me->bm.maxHP / 2, "CUT ITS OWN HP!");
+        me->bm.statStages[STAT_ATK] = MAX_STAT_STAGE;
+        SetMsg("AND MAXIMIZED ATTACK!", 50);
+        break;
+    case EFFECT_CONVERSION:
+    {
+        // Gen 3: becomes the type of one of its moves that it isn't already
+        u8 opts[MAX_MON_MOVES], n = 0;
+        for (i = 0; i < MAX_MON_MOVES; i++)
+        {
+            u16 mv = me->bm.moves[i];
+            u8 t = gBattleMoves[mv].type;
+            if (mv && t != TYPE_MYSTERY && !FighterHasType(me, t))
+                opts[n++] = t;
+        }
+        if (n == 0)
+        {
+            SetMsg("BUT IT FAILED!", 40);
+            break;
+        }
+        me->typeOverride = opts[Random() % n] + 1;
+        SayFighter(me, "CHANGED TYPE!", 50);
+        break;
+    }
+    case EFFECT_TELEPORT:
+        // Gen 3: Teleport in a wild battle ends it; on the grid it blinks to a free panel first.
+        {
+            s8 x, y, tries = 20;
+            do
+            {
+                x = (side == SIDE_PLAYER) ? Random() % PLAYER_COLS : PLAYER_COLS + Random() % (GRID_COLS - PLAYER_COLS);
+                y = Random() % GRID_ROWS;
+            } while (tries-- && !Field_CanStand(side, x, y));
+            if (Field_CanStand(side, x, y))
+                Field_Step(side, x, y);
+            me->iframes = 20;
+        }
+        break;
+    case EFFECT_HEAL_BELL:
+        me->bm.status1 = 0;
+        if (side == SIDE_PLAYER)
+            for (i = 0; i < sB.partyCount; i++)
+                sB.party[i].bm.status1 = 0;
+        SetMsg("A BELL CHIMED!", 50);
+        PlaySE(SE_M_HEAL_BELL);
+        break;
+    case EFFECT_REFRESH:
+        if (me->bm.status1 & (STATUS1_POISON | STATUS1_TOXIC_POISON | STATUS1_BURN | STATUS1_PARALYSIS))
+        {
+            me->bm.status1 = 0;
+            SayFighter(me, "'S STATUS RETURNED TO NORMAL!", 50);
+        }
+        else
+            SetMsg("BUT IT FAILED!", 40);
+        break;
+    case EFFECT_SAFEGUARD:
+        me->safeguard = TRUE;
+        SayFighter(me, "IS PROTECTED BY SAFEGUARD!", 50);
+        break;
+    case EFFECT_MAGIC_COAT:
+        me->magicCoat = TRUE;
+        SayFighter(me, "SHROUDED ITSELF IN MAGIC COAT!", 50);
+        break;
+    case EFFECT_CHARGE:
+        me->chargeNext = TRUE;
+        SayFighter(me, "BEGAN CHARGING POWER!", 50);
+        break;
+    case EFFECT_PSYCH_UP:
+        memcpy(me->bm.statStages, foe->bm.statStages, sizeof(me->bm.statStages));
+        SayFighter(me, "COPIED THE FOE'S STAT CHANGES!", 50);
+        break;
+    case EFFECT_MUD_SPORT:
+        me->mudSport = TRUE;
+        SetMsg("ELECTRICITY'S POWER WAS WEAKENED!", 50);
+        break;
+    case EFFECT_WATER_SPORT:
+        me->waterSport = TRUE;
+        SetMsg("FIRE'S POWER WAS WEAKENED!", 50);
+        break;
+    default:
+        SetMsg("BUT NOTHING HAPPENED!", 40);
+        break;
+    }
+}
+
+static void UseWeatherMove(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_RAIN_DANCE: sB.weather = B_WEATHER_RAIN_TEMPORARY; SetMsg("IT STARTED TO RAIN!", 60); PlaySE(SE_M_RAIN_DANCE); break;
+    case MOVE_SUNNY_DAY:  sB.weather = B_WEATHER_SUN_TEMPORARY; SetMsg("THE SUNLIGHT GOT BRIGHT!", 60); break;
+    case MOVE_SANDSTORM:  sB.weather = B_WEATHER_SANDSTORM_TEMPORARY; SetMsg("A SANDSTORM BREWED!", 60); PlaySE(SE_M_SAND_ATTACK); break;
+    case MOVE_HAIL:       sB.weather = B_WEATHER_HAIL_TEMPORARY; SetMsg("IT STARTED TO HAIL!", 60); PlaySE(SE_M_HAIL); break;
+    }
+    sB.weatherTurns = 5; // Gen 3: 5 turns
+    PKBN_LOG("weather 0x%x for 5 turns", sB.weather);
+}
+
+// Panels in `side`'s own area around (x, y).
+static void OwnAreaPanels(u8 side, s8 x, s8 y, bool8 column, u8 type)
+{
+    s32 r, dx;
+    for (r = -1; r <= 1; r++)
+        for (dx = column ? 0 : -1; dx <= (column ? 0 : 1); dx++)
+        {
+            s8 cx = x + dx, cy = y + r;
+            if (!column && dx != 0 && r != 0)
+                continue; // plus shape
+            if (InGrid(cx, cy) && (side == SIDE_PLAYER ? cx < PLAYER_COLS : cx >= PLAYER_COLS) && sB.panel[cy][cx] != PANEL_BROKEN)
+                Field_SetPanel(cx, cy, type);
+        }
+}
+
+static void UsePanelMove(u8 side, u16 move, const struct BattlePokemon *user, const char *userName, u8 userSlot)
+{
+    struct Fighter *me = &sB.f[side];
+    struct Fighter *foe = &sB.f[side ^ 1];
+    s32 i;
+
+    switch (move)
+    {
+    case MOVE_REFLECT:
+    case MOVE_LIGHT_SCREEN:
+        // BN6 HolyPanl: damage on it is halved. Gen 3 screens halve physical / special damage.
+        OwnAreaPanels(side, me->x, me->y, TRUE, PANEL_HOLY);
+        SetMsg("HOLY PANELS!", 50);
+        break;
+    case MOVE_INGRAIN:
+        OwnAreaPanels(side, me->x, me->y, FALSE, PANEL_GRASS);
+        me->rooted = TRUE;
+        SayFighter(me, "PLANTED ITS ROOTS!", 50);
+        break;
+    case MOVE_SPIKES:
+    {
+        // Gen 3 Spikes hurt on switch-in; on the grid they crack enemy panels (BN cracked panels
+        // break when the one on them steps off).
+        u8 done = 0, tries = 30;
+        while (done < 3 && tries--)
+        {
+            s8 x = (side == SIDE_PLAYER) ? PLAYER_COLS + Random() % (GRID_COLS - PLAYER_COLS) : Random() % PLAYER_COLS;
+            s8 y = Random() % GRID_ROWS;
+            if (sB.panel[y][x] == PANEL_NORMAL)
+            {
+                Field_SetPanel(x, y, PANEL_CRACKED);
+                done++;
+            }
+        }
+        SetMsg("SPIKES CRACKED THE PANELS!", 50);
+        break;
+    }
+    case MOVE_POISON_GAS:
+    case MOVE_TOXIC:
+    {
+        // Review: poison panels. Toxic = BN6 PoisSeed ("Makes 9sq poisn swp 3sq ahead"), a thrown seed;
+        // Poison Gas = a cloud that settles on the foe's panel and its neighbours.
+        struct Attack *a = NewAttack();
+        if (a == NULL)
+            return;
+        a->side = side;
+        a->move = move;
+        a->kind = GK_PANEL;
+        a->info = gPkbnMoveInfo[move];
+        a->user = *user;
+        a->userSlot = userSlot;
+        strncpy(a->userName, userName, sizeof(a->userName) - 1);
+        a->ox = me->x;
+        a->oy = me->y;
+        if (move == MOVE_TOXIC)
+        {
+            a->tx = me->x + Facing(side) * GRENADE_RANGE;
+            a->ty = me->y;
+            BlastCells(BLAST_SQUARE, a->tx, a->ty, a->cells);
+            a->timer = GRENADE_FLIGHT;
+            me->lockout = THROW_LOCKOUT;
+        }
+        else
+        {
+            a->tx = foe->x;
+            a->ty = foe->y;
+            BlastCells(BLAST_PLUS, a->tx, a->ty, a->cells);
+            a->timer = ScaleByAccuracy(FIREHIT_SLOW, side, user);
+        }
+        a->duration = a->timer;
+        a->phase = PH_WAIT;
+        PlaySE(SE_M_POISON_POWDER);
+        return;
+    }
+    }
+    (void)i;
+}
+
+// Panel attacks resolve here (called from the generic update via kind GK_PANEL).
+static void ResolvePanelAttack(struct Attack *a)
+{
+    struct Fighter *opp = &sB.f[a->side ^ 1];
+    s32 r, c;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (a->cells[r][c] && (a->side == SIDE_PLAYER ? c >= PLAYER_COLS : c < PLAYER_COLS) && sB.panel[r][c] != PANEL_BROKEN)
+                Field_SetPanel(c, r, PANEL_POISON);
+    FlashCells(a->cells, 10);
+    PlaySE(SE_M_TOXIC);
+    if (a->move == MOVE_TOXIC && a->cells[opp->y][opp->x])
+        ApplyStatusEffect(a->side, MOVE_TOXIC, a->side ^ 1); // badly poisoned if the seed lands on it
+    PKBN_LOG("%s's move %u made poison panels around (%d,%d)", a->userName, a->move, a->tx, a->ty);
+    a->active = FALSE;
+}
+
+// ---- Can the Pokémon act? (Gen 3 attackcanceler order, grid version) -----------------------------
+
+bool8 Field_CanAct(u8 side, bool8 announce)
+{
+    struct Fighter *f = &sB.f[side];
+    if (f->stun)
+        return FALSE;
+    if (f->bm.status1 & STATUS1_SLEEP)
+    {
+        if (announce) SayFighter(f, "IS FAST ASLEEP.", 40);
+        return FALSE;
+    }
+    if (f->bm.status1 & STATUS1_FREEZE)
+    {
+        if (announce) SayFighter(f, "IS FROZEN SOLID!", 40);
+        return FALSE;
+    }
+    if (!announce)
+        return TRUE;
+    if (f->confTurns && (Random() & 1))
+    {
+        // Gen 3: 40-power typeless physical hit on itself (CalculateBaseDamage(..., MOVE_POUND, 0, 40, 0, ...))
+        struct BattlePokemon me = f->bm;
+        s32 d;
+        gBattleMons[side] = me;
+        gBattleWeather = sB.weather;
+        gCurrentMove = MOVE_POUND;
+        gCritMultiplier = 1;
+        d = CalculateBaseDamage(&me, &me, MOVE_POUND, 0, 40, 0, side, side);
+        Moves_DamageFighter(side, d, "HURT ITSELF IN CONFUSION!");
+        f->stun = 20;
+        return FALSE;
+    }
+    if ((f->bm.status1 & STATUS1_PARALYSIS) && Random() % 4 == 0)
+    {
+        SayFighter(f, "IS PARALYZED! IT CAN'T MOVE!", 50); // Gen 3: 25% full paralysis
+        f->stun = 30;
+        return FALSE;
+    }
+    if (f->infatuated && (Random() & 1))
+    {
+        SayFighter(f, "IS IMMOBILIZED BY LOVE!", 50); // Gen 3: 50%
+        f->stun = 20;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+// ---- Move-calling --------------------------------------------------------------------------------
+
+static u16 RandomCallableMove(void)
+{
+    u16 mv;
+    s32 tries = 200;
+    do
+    {
+        mv = 1 + Random() % (MOVES_COUNT - 2);
+    } while (tries-- && (gPkbnMoveInfo[mv].laneCount == 0 || gPkbnMoveInfo[mv].kind == GK_NONE
+             || gPkbnMoveInfo[mv].kind == GK_CALL || gPkbnMoveInfo[mv].kind == GK_BATON
+             || gPkbnMoveInfo[mv].kind == GK_ASSIST || InList(sForbiddenToCall, ARRAY_COUNT(sForbiddenToCall), mv)));
+    return mv;
+}
+
+// ---- Entry point ---------------------------------------------------------------------------------
+
+void Moves_Use(u8 side, u16 move, u8 slot, const struct BattlePokemon *user, const char *userName, u8 userSlot)
+{
+    struct Fighter *me = &sB.f[side];
+    struct Fighter *foe = &sB.f[side ^ 1];
+    const struct PkbnMoveInfo *info = &gPkbnMoveInfo[move];
+    const struct BattleMove *m = &gBattleMoves[move];
+    struct Attack *a;
+    u8 kind = info->kind;
+    char line[40];
+
+    (void)slot;
+    if (move == MOVE_NONE || move >= MOVES_COUNT)
+        return;
+
+    // Sleep Talk / Snore are the only moves a sleeping Pokémon can use (Gen 3).
+    if ((me->bm.status1 & STATUS1_SLEEP) && (m->effect == EFFECT_SLEEP_TALK || m->effect == EFFECT_SNORE))
+        ;
+    else if (!Field_CanAct(side, TRUE))
+    {
+        me->lockout = CHIP_LOCKOUT;
+        return;
+    }
+
+    if (sCallDepth == 0)
+    {
+        Pkbn_GameStringToAscii(line, gMoveNames[move], sizeof(line));
+        PKBN_LOG("%s uses %s (%s)", userName, line, gPkbnKindNames[kind]);
+    }
+    me->lockout = CHIP_LOCKOUT;
+    if (kind != GK_CALL)
+        me->lastMove = move;
+
+    // consecutive-use counters (Gen 3 Rollout / Ice Ball 5 hits, Fury Cutter up to 5)
+    if (m->effect == EFFECT_ROLLOUT)
+        me->rolloutCount = (me->lastKind == 0xFE) ? me->rolloutCount + 1 : 0;
+    else
+        me->rolloutCount = 0;
+    if (m->effect == EFFECT_FURY_CUTTER)
+        me->furyCount = (me->lastKind == 0xFD && me->furyCount < 4) ? me->furyCount + 1 : 0;
+    else
+        me->furyCount = 0;
+
+    switch (kind)
+    {
+    case GK_NONE:
+        SetMsg("CAN'T USE THAT ON THE GRID YET", 40);
+        PlaySE(SE_FAILURE);
+        return;
+    case GK_NOTHING:
+        SetMsg("BUT NOTHING HAPPENED!", 40);
+        return;
+    case GK_CALL:
+    {
+        u16 called = MOVE_NONE;
+        if (sCallDepth > 0)
+            return;
+        switch (m->effect)
+        {
+        case EFFECT_METRONOME:
+        case EFFECT_SLEEP_TALK: // review: a random move, like Metronome; usable while asleep
+            called = RandomCallableMove();
+            break;
+        case EFFECT_MIRROR_MOVE:
+        case EFFECT_MIMIC:
+            called = foe->lastMove;
+            if (called && (gPkbnMoveInfo[called].kind == GK_CALL || InList(sForbiddenToCall, ARRAY_COUNT(sForbiddenToCall), called)))
+                called = MOVE_NONE;
+            break;
+        case EFFECT_NATURE_POWER:
+            called = gBattleEnvironment < ARRAY_COUNT(sNaturePower) ? sNaturePower[gBattleEnvironment] : MOVE_SWIFT;
+            break;
+        }
+        if (called == MOVE_NONE)
+        {
+            SetMsg("BUT IT FAILED!", 40);
+            PlaySE(SE_FAILURE);
+            return;
+        }
+        Pkbn_GameStringToAscii(line, gMoveNames[called], sizeof(line));
+        PKBN_LOG("  -> calls %s", line);
+        {
+            char text[40];
+            snprintf(text, sizeof(text), "%s!", line);
+            SetMsg(text, 50);
+        }
+        sCallDepth++;
+        {
+            u8 st = me->bm.status1 & STATUS1_SLEEP;
+            if (st) me->bm.status1 &= ~STATUS1_SLEEP; // Sleep Talk acts through sleep
+            Moves_Use(side, called, slot, user, userName, userSlot);
+            me->bm.status1 |= st;
+        }
+        sCallDepth--;
+        return;
+    }
+    case GK_BARRIER:
+    {
+        // Gen 3 Protect odds (Cmd_setprotectlike :6523, sProtectSuccessRates :719)
+        static const u16 sSuccess[] = { USHRT_MAX, USHRT_MAX / 2, USHRT_MAX / 4, USHRT_MAX / 8 };
+        if (me->lastKind != GK_BARRIER)
+            me->protectUses = 0;
+        me->lastKind = GK_BARRIER;
+        if (sSuccess[min(me->protectUses, 3)] >= Random())
+        {
+            me->barrier = TRUE;
+            me->protectUses++;
+            PlaySE(SE_SELECT);
+            PKBN_LOG("%s raised a barrier (consecutive %u)", me->name, me->protectUses);
+        }
+        else
+        {
+            me->protectUses = 0;
+            SetMsg("BARRIER FAILED!", 50);
+            PlaySE(SE_FAILURE);
+        }
+        return;
+    }
+    case GK_STATS:
+        UseStatsMove(side, move);
+        me->lastKind = kind;
+        return;
+    case GK_STATUS:
+        ApplyStatusEffect(side, move, side ^ 1);
+        me->lastKind = kind;
+        return;
+    case GK_SELF:
+        UseSelfMove(side, move);
+        me->lastKind = kind;
+        return;
+    case GK_WEATHER:
+        UseWeatherMove(move);
+        me->lastKind = kind;
+        return;
+    case GK_PANEL:
+        UsePanelMove(side, move, user, userName, userSlot);
+        me->lastKind = kind;
+        return;
+    case GK_BATON:
+    case GK_ASSIST:
+        return; // handled by grid_battle.c (they need the party)
+    }
+
+    // ---- damaging kinds ----
+    if (m->effect == EFFECT_FAKE_OUT && !me->fakeOutReady)
+    {
+        SetMsg("BUT IT FAILED!", 40); // Gen 3: only on the first turn in
+        PlaySE(SE_FAILURE);
+        return;
+    }
+    if (move == MOVE_RAPID_SPIN)
+    {
+        // Gen 3: frees the user from Wrap / Leech Seed and clears Spikes -> BN PnlRetrn "Fix your area's panels"
+        s32 r, c;
+        me->hold = 0; me->trapTurns = 0; me->seeded = FALSE;
+        for (r = 0; r < GRID_ROWS; r++)
+            for (c = 0; c < GRID_COLS; c++)
+                if ((side == SIDE_PLAYER ? c < PLAYER_COLS : c >= PLAYER_COLS)
+                 && (sB.panel[r][c] == PANEL_CRACKED || sB.panel[r][c] == PANEL_BROKEN || sB.panel[r][c] == PANEL_POISON))
+                    Field_SetPanel(c, r, PANEL_NORMAL);
+    }
+    if (move == MOVE_BRICK_BREAK)
+    {
+        // Gen 3 Brick Break removes screens -> holy panels in the foe's area
+        s32 r, c;
+        for (r = 0; r < GRID_ROWS; r++)
+            for (c = 0; c < GRID_COLS; c++)
+                if ((side == SIDE_PLAYER ? c >= PLAYER_COLS : c < PLAYER_COLS) && sB.panel[r][c] == PANEL_HOLY)
+                    Field_SetPanel(c, r, PANEL_NORMAL);
+    }
+
+    a = NewAttack();
+    if (a == NULL)
+        return;
+    a->side = side;
+    a->move = move;
+    a->info = *info;
+    a->kind = kind;
+    a->user = *user;
+    a->userSlot = userSlot;
+    strncpy(a->userName, userName, sizeof(a->userName) - 1);
+
+    // captured user conditions (bits in info.flags: 0x80 Focus Energy, 0x40 Charge)
+    if (me->focusEnergy) a->info.flags |= 0x80;
+    if (me->chargeNext && m->type == TYPE_ELECTRIC) { a->info.flags |= 0x40; me->chargeNext = FALSE; }
+
+    // Lock-On / Thunder in rain: can't be dodged (Gen 3: sure hit)
+    if (me->lockOnNext)
+    {
+        me->lockOnNext = FALSE;
+        a->kind = GK_LOCKON;
+    }
+    if (move == MOVE_THUNDER && (sB.weather & B_WEATHER_RAIN))
+        a->kind = GK_LOCKON;
+
+    // Rollout / Ice Ball / Fury Cutter power (Cmd_rolloutdamagecalculation, Cmd_furycuttercalc)
+    if (m->effect == EFFECT_ROLLOUT)
+    {
+        u16 p = m->power << me->rolloutCount;
+        if (me->defenseCurl) p *= 2;
+        a->powerOverride = p;
+        me->lastKind = 0xFE;
+    }
+    else if (m->effect == EFFECT_FURY_CUTTER)
+    {
+        a->powerOverride = m->power << me->furyCount;
+        me->lastKind = 0xFD;
+    }
+    else
+        me->lastKind = kind;
+    if (m->effect == EFFECT_BEAT_UP)
+        a->powerOverride = 0;
+
+    // charge-up (Solar Beam skips it in sun, Gen 3)
+    a->phase = PH_CHARGE;
+    a->timer = info->windup;
+    if (move == MOVE_SOLAR_BEAM && (sB.weather & B_WEATHER_SUN))
+        a->timer = 0;
+    if (a->timer)
+    {
+        me->charging = a->timer;
+        me->chargeMove = move;
+        me->focusBroken = FALSE;
+        me->lockout = a->timer + CHIP_LOCKOUT;
+        SayFighter(me, "IS CHARGING UP!", 40);
+        return;
+    }
+    UpdateAttack(a); // launches now (PH_CHARGE with timer 0)
+}
+
+#endif // PORTABLE
