+    Tick(&sB.f[SIDE_PLAYER]);
+    Tick(&sB.f[SIDE_ENEMY]);
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (sB.fx[r][c])
+                sB.fx[r][c]--;
+    Field_Update();
+
+    UpdatePlayer();
+    if (sB.state != ST_FIGHT)
+        return;
+    UpdateEnemy();
+    if (sB.state != ST_FIGHT)
+        return;
+    Moves_Update();
+    CheckFaints();
