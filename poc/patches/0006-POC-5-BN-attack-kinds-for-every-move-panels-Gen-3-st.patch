+++ b/src/pkbn/grid_draw.c
@@ -0,0 +1,483 @@
+// Grid battle: drawing (overlay on the PC port's 240x160 frame). See include/pkbn/grid_internal.h.
+#include "pkbn/grid_internal.h"
+#include "data.h"
+#include "constants/moves.h"
+#include "pkbn/render.h"
+
+#ifdef PORTABLE
+
+#define COL_BG        PKBN_RGB(2, 3, 6)
+#define COL_PANEL_P   PKBN_RGB(20, 6, 6)
+#define COL_PANEL_E   PKBN_RGB(6, 8, 22)
+#define COL_EDGE      PKBN_RGB(28, 28, 28)
+#define COL_FX        PKBN_RGB(31, 31, 12)
+#define COL_WARN      PKBN_RGB(31, 18, 0)
+#define COL_SHADOW    PKBN_RGB(12, 12, 14)
+#define COL_TEXT      PKBN_RGB(31, 31, 31)
+#define COL_DIM       PKBN_RGB(16, 16, 16)
+#define COL_HP        PKBN_RGB(6, 28, 8)
+#define COL_HP_LOW    PKBN_RGB(31, 8, 4)
+#define COL_GAUGE     PKBN_RGB(8, 20, 31)
+#define COL_GAUGE_FULL PKBN_RGB(31, 26, 4)
+#define COL_BOX       PKBN_RGB(4, 5, 10)
+#define COL_BARRIER   PKBN_RGB(8, 31, 31)
+#define COL_CROSS     PKBN_RGB(31, 4, 4)
+#define COL_BOMB      PKBN_RGB(10, 10, 10)
+#define COL_STATUS    PKBN_RGB(24, 8, 28)
+#define COL_CODE      PKBN_RGB(31, 20, 8)
+#define COL_POISON    PKBN_RGB(18, 4, 22)
+#define COL_HOLY      PKBN_RGB(30, 28, 18)
+#define COL_GRASS     PKBN_RGB(6, 20, 6)
+#define COL_HOLE      PKBN_RGB(1, 1, 2)
+#define COL_CRACK     PKBN_RGB(3, 3, 4)
+#define COL_BALL      PKBN_RGB(31, 24, 31)
+#define COL_WAVE      PKBN_RGB(20, 28, 31)
+#define COL_GROUND    PKBN_RGB(24, 16, 6)
+
+static void PanelOrigin(s32 c, s32 r, s32 *x, s32 *y)
+{
+    *x = GRID_X + c * PANEL_W;
+    *y = GRID_Y + r * PANEL_H;
+}
+
+static void PanelCenter(s32 c, s32 r, s32 *x, s32 *y)
+{
+    PanelOrigin(c, r, x, y);
+    *x += PANEL_W / 2;
+    *y += PANEL_H / 2;
+}
+
+static void DrawHpBar(u16 *fb, s32 x, s32 y, s32 w, u16 hp, u16 maxHP)
+{
+    s32 fill = maxHP ? (w - 2) * hp / maxHP : 0;
+    Pkbn_FrameRect(fb, x, y, w, 5, COL_EDGE);
+    Pkbn_FillRect(fb, x + 1, y + 1, fill, 3, (hp * 4 <= maxHP) ? COL_HP_LOW : COL_HP);
+}
+
+static const char *StatusTag(const struct Fighter *f)
+{
+    u32 s = f->bm.status1;
+    if (s & STATUS1_SLEEP) return "SLP";
+    if (s & (STATUS1_POISON | STATUS1_TOXIC_POISON)) return "PSN";
+    if (s & STATUS1_BURN) return "BRN";
+    if (s & STATUS1_FREEZE) return "FRZ";
+    if (s & STATUS1_PARALYSIS) return "PAR";
+    return NULL;
+}
+
+static void DrawFighterHud(u16 *fb, s32 x, const struct Fighter *f)
+{
+    char line[32];
+    const char *tag = StatusTag(f);
+    s32 tx;
+    snprintf(line, sizeof(line), "%s L%u", f->name, f->bm.level);
+    tx = Pkbn_DrawText(fb, x, 4, line, COL_TEXT, 1) + 3;
+    if (tag)
+        tx = Pkbn_DrawText(fb, tx, 4, tag, COL_STATUS, 1) + 3;
+    if (f->confTurns)
+        tx = Pkbn_DrawText(fb, tx, 4, "CNF", COL_STATUS, 1) + 3;
+    DrawHpBar(fb, x, 11, 80, f->bm.hp, f->bm.maxHP);
+    snprintf(line, sizeof(line), "%u/%u", f->bm.hp, f->bm.maxHP);
+    Pkbn_DrawText(fb, x, 18, line, COL_TEXT, 1);
+    {
+        static const char *const sShort[NUM_BATTLE_STATS] = { "", "A", "D", "S", "SA", "SD", "AC", "EV" };
+        s32 st;
+        tx = x + 26;
+        for (st = STAT_ATK; st < NUM_BATTLE_STATS; st++)
+        {
+            s32 d = (s32)f->bm.statStages[st] - DEFAULT_STAT_STAGE;
+            if (d != 0)
+            {
+                snprintf(line, sizeof(line), "%s%+d", sShort[st], (int)d);
+                tx = Pkbn_DrawText(fb, tx, 18, line, d > 0 ? COL_GAUGE : COL_HP_LOW, 1) + 3;
+            }
+        }
+        if (f->barrier)
+            tx = Pkbn_DrawText(fb, tx, 18, "BAR", COL_BARRIER, 1) + 3;
+        if (f->safeguard)
+            tx = Pkbn_DrawText(fb, tx, 18, "SG", COL_BARRIER, 1) + 3;
+        if (f->magicCoat)
+            tx = Pkbn_DrawText(fb, tx, 18, "MC", COL_BARRIER, 1) + 3;
+        if (f->recharge)
+            Pkbn_DrawText(fb, tx, 18, "RCH", COL_HP_LOW, 1);
+    }
+}
+
+static void DrawPartyPips(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < sB.partyCount; i++)
+    {
+        u16 col = !PartyAlive(i) ? COL_HP_LOW : (i == sB.active) ? COL_TEXT : COL_DIM;
+        Pkbn_FillRect(fb, 4 + i * 7, 26, 5, 5, col);
+    }
+}
+
+static u16 PanelColor(s32 c, s32 r)
+{
+    switch (sB.panel[r][c])
+    {
+    case PANEL_POISON: return COL_POISON;
+    case PANEL_HOLY:   return COL_HOLY;
+    case PANEL_GRASS:  return COL_GRASS;
+    case PANEL_BROKEN: return COL_HOLE;
+    }
+    return c < PLAYER_COLS ? COL_PANEL_P : COL_PANEL_E;
+}
+
+static void DrawGrid(u16 *fb)
+{
+    s32 r, c, i;
+    u8 warn[GRID_ROWS][GRID_COLS];
+    u8 shadow[GRID_ROWS][GRID_COLS];
+
+    memset(warn, 0, sizeof(warn));
+    memset(shadow, 0, sizeof(shadow));
+    for (i = 0; i < MAX_ATTACKS; i++)
+    {
+        const struct Attack *a = &sB.attacks[i];
+        if (!a->active || a->kind == GK_LOCKON || a->phase == PH_TRAVEL)
+            continue;
+        for (r = 0; r < GRID_ROWS; r++)
+            for (c = 0; c < GRID_COLS; c++)
+                if (a->cells[r][c])
+                {
+                    if (a->side == SIDE_ENEMY || a->kind == GK_FIREHIT || a->kind == GK_GOLEMHIT || a->kind == GK_METEORS)
+                        warn[r][c] = 1; // warnings show for both sides' "appears on the target" kinds
+                    else
+                        shadow[r][c] = 1;
+                }
+    }
+
+    for (r = 0; r < GRID_ROWS; r++)
+    {
+        for (c = 0; c < GRID_COLS; c++)
+        {
+            s32 x, y;
+            u16 col = PanelColor(c, r);
+            PanelOrigin(c, r, &x, &y);
+            if (shadow[r][c])
+                col = COL_SHADOW;
+            if (warn[r][c] && (sB.frame & 4))
+                col = COL_WARN;
+            if (sB.fx[r][c])
+                col = COL_FX;
+            Pkbn_FillRect(fb, x + 1, y + 1, PANEL_W - 2, PANEL_H - 2, col);
+            Pkbn_FrameRect(fb, x, y, PANEL_W, PANEL_H, COL_EDGE);
+            if (sB.panel[r][c] == PANEL_CRACKED)
+            {
+                // crack lines
+                Pkbn_FillRect(fb, x + 6, y + 9, PANEL_W - 12, 1, COL_CRACK);
+                Pkbn_FillRect(fb, x + 12, y + 4, 1, 6, COL_CRACK);
+                Pkbn_FillRect(fb, x + 22, y + 9, 1, 7, COL_CRACK);
+            }
+            if (sB.panel[r][c] == PANEL_POISON && ((sB.frame / 8 + c + r) & 1))
+                Pkbn_FillRect(fb, x + 8 + (sB.frame / 4) % 18, y + 6, 3, 3, COL_STATUS);
+        }
+    }
+}
+
+static void DrawFighter(u16 *fb, u8 side)
+{
+    const struct Fighter *f = &sB.f[side];
+    s32 x, y, lift = 0;
+    u16 tint = f->hurtFlash ? COL_TEXT : (f->statusFlash && (sB.frame & 2)) ? COL_STATUS : 0;
+
+    PanelOrigin(f->x, f->y, &x, &y);
+    if (f->bm.hp == 0 && (sB.state == ST_END || sB.state == ST_PICK))
+        return; // fainted
+    if (f->invuln && (f->invulnKind == INVULN_UNDERGROUND || f->invulnKind == INVULN_UNDERWATER))
+    {
+        // underground: just a mound
+        Pkbn_FillRect(fb, x + 10, y + PANEL_H - 6, PANEL_W - 20, 3, COL_GROUND);
+        return;
+    }
+    if (f->invuln && f->invulnKind == INVULN_AIR)
+    {
+        lift = 22;
+        Pkbn_FillRect(fb, x + 12, y + PANEL_H - 5, PANEL_W - 24, 2, COL_SHADOW);
+    }
+    if (f->barrier)
+        Pkbn_FrameRect(fb, x + 2, y - 14 - lift, PANEL_W - 4, PANEL_H + 12, (sB.frame & 8) ? COL_BARRIER : COL_TEXT);
+    if (f->charging && (sB.frame & 4))
+        Pkbn_FrameRect(fb, x + 4, y - 12, PANEL_W - 8, PANEL_H + 8, COL_GAUGE_FULL);
+    if (f->iframes && (sB.frame & 2))
+        return;
+    if ((f->bm.status1 & STATUS1_FREEZE))
+        tint = COL_WAVE;
+    Pkbn_BlitIcon(fb, f->icon[((f->bm.status1 & (STATUS1_SLEEP | STATUS1_FREEZE)) || f->stun) ? 0 : (sB.frame / 16) & 1],
+                  x + (PANEL_W - 32) / 2, y + PANEL_H - 34 - lift, side == SIDE_PLAYER, tint);
+    if ((f->bm.status1 & STATUS1_SLEEP) && (sB.frame & 32))
+        Pkbn_DrawText(fb, x + PANEL_W - 10, y - 12, "Z", COL_TEXT, 1);
+    if (f->confTurns && (sB.frame & 16))
+        Pkbn_DrawText(fb, x + 4, y - 12, "?", COL_GAUGE_FULL, 1);
+}
+
+static void DrawAttacksOverlay(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+    {
+        const struct Attack *a = &sB.attacks[i];
+        s32 x0, y0, x1, y1, t, d, bx, by, arc;
+        if (!a->active)
+            continue;
+        if (a->kind == GK_LOCKON)
+        {
+            PanelOrigin(a->tx, a->ty, &x1, &y1);
+            if (sB.frame & 2)
+            {
+                Pkbn_FrameRect(fb, x1 + 4, y1 + 2, PANEL_W - 8, PANEL_H - 4, COL_CROSS);
+                Pkbn_FillRect(fb, x1 + PANEL_W / 2, y1 + 1, 1, PANEL_H - 2, COL_CROSS);
+                Pkbn_FillRect(fb, x1 + 1, y1 + PANEL_H / 2, PANEL_W - 2, 1, COL_CROSS);
+            }
+            continue;
+        }
+        if ((a->kind == GK_BOMB || (a->kind == GK_PANEL && a->move == MOVE_TOXIC)) && a->phase == PH_WAIT && a->duration > 0)
+        {
+            PanelOrigin(a->ox, a->oy, &x0, &y0);
+            PanelOrigin(a->tx, a->ty, &x1, &y1);
+            d = a->duration;
+            t = d - a->timer;
+            bx = x0 + (x1 - x0) * t / d + PANEL_W / 2 - 3;
+            arc = 4 * 28 * t * (d - t) / (d * d);
+            by = y0 + (y1 - y0) * t / d + PANEL_H / 2 - 3 - arc;
+            Pkbn_FillRect(fb, bx, by, 6, 6, a->kind == GK_PANEL ? COL_POISON : COL_BOMB);
+            Pkbn_FrameRect(fb, bx, by, 6, 6, COL_TEXT);
+            continue;
+        }
+        if (a->phase != PH_TRAVEL)
+            continue;
+        PanelCenter(a->px, a->py, &bx, &by);
+        switch (a->kind)
+        {
+        case GK_BALL:
+            Pkbn_FillRect(fb, bx - 3, by - 6, 7, 7, COL_BALL);
+            Pkbn_FrameRect(fb, bx - 4, by - 7, 9, 9, COL_TEXT);
+            break;
+        case GK_DELAYED:
+            Pkbn_FillRect(fb, bx - 8, by - 3, 16, 3, COL_STATUS);
+            break;
+        case GK_AIRHOCKEY:
+            Pkbn_FillRect(fb, bx - 5, by - 2, 10, 4, COL_TEXT);
+            Pkbn_FrameRect(fb, bx - 6, by - 3, 12, 6, COL_CROSS);
+            break;
+        case GK_WAVE:
+        case GK_SHOCKWAVE:
+        {
+            s32 r;
+            u16 col = a->kind == GK_WAVE ? COL_WAVE : COL_GROUND;
+            for (r = 0; r < GRID_ROWS; r++)
+            {
+                s32 cx, cy;
+                if (!a->cells[r][a->px])
+                    continue;
+                PanelCenter(a->px, r, &cx, &cy);
+                if (a->kind == GK_WAVE)
+                    Pkbn_FillRect(fb, cx - 2, cy - 9, 4, 14, col);
+                else
+                    Pkbn_FillRect(fb, cx - 7, cy + 2, 14, 5, col);
+            }
+            break;
+        }
+        }
+    }
+}
+
+static void ChipText(char *line, u32 size, const struct FolderChip *ch)
+{
+    char name[MOVE_NAME_LENGTH + 1];
+    const struct BattlePokemon *owner = (ch->owner == sB.active) ? &sB.f[SIDE_PLAYER].bm : &sB.party[ch->owner].bm;
+    Pkbn_GameStringToAscii(name, gMoveNames[ch->move], sizeof(name));
+    snprintf(line, size, "%-12s %-10s %-9s PP%u", name, sB.party[ch->owner].name,
+             gPkbnKindNames[gPkbnMoveInfo[ch->move].kind], owner->pp[ch->slot]);
+}
+
+static const char *WeatherName(void)
+{
+    if (sB.weather & B_WEATHER_RAIN) return "RAIN";
+    if (sB.weather & B_WEATHER_SUN) return "SUN";
+    if (sB.weather & B_WEATHER_SANDSTORM) return "SAND";
+    if (sB.weather & B_WEATHER_HAIL) return "HAIL";
+    return NULL;
+}
+
+static void DrawBottomHud(u16 *fb)
+{
+    s32 gw = 120;
+    char line[64];
+    u16 gc = sB.gauge >= CUSTOM_FRAMES ? COL_GAUGE_FULL : COL_GAUGE;
+    Pkbn_DrawText(fb, 60, 28, "CUSTOM", COL_DIM, 1);
+    Pkbn_FrameRect(fb, 86, 28, gw, 5, COL_EDGE);
+    Pkbn_FillRect(fb, 87, 29, (gw - 2) * sB.gauge / CUSTOM_FRAMES, 3, gc);
+    if (sB.gauge >= CUSTOM_FRAMES && (sB.frame & 16))
+        Pkbn_DrawText(fb, 86, 36, "PRESS L/R", COL_GAUGE_FULL, 1);
+    if (WeatherName())
+    {
+        snprintf(line, sizeof(line), "%s %u", WeatherName(), sB.weatherTurns);
+        Pkbn_DrawText(fb, 210, 28, line, COL_WAVE, 1);
+    }
+
+    if (sB.queueCount > 0)
+    {
+        if (sB.queue[0] == FOLDER_QUEUE_WILD)
+            snprintf(line, sizeof(line), "SWITCH>ANY  *");
+        else
+        {
+            const struct FolderChip *ch = &sB.folder.chips[sB.queue[0]];
+            char tmp[60];
+            ChipText(tmp, sizeof(tmp), ch);
+            snprintf(line, sizeof(line), "%s %c", tmp, PkbnFolder_LetterChar(ch->letter));
+        }
+        Pkbn_DrawText(fb, 4, 136, "A:", COL_DIM, 1);
+        Pkbn_DrawText(fb, 14, 136, line, COL_TEXT, 1);
+        if (sB.queueCount > 1)
+        {
+            snprintf(line, sizeof(line), "+%u QUEUED", sB.queueCount - 1);
+            Pkbn_DrawText(fb, 4, 144, line, COL_DIM, 1);
+        }
+    }
+    Pkbn_DrawText(fb, 4, 152, "B:BUSTER  ARROWS:MOVE  SELECT:RUN", COL_DIM, 1);
+}
+
+bool8 PkbnGrid_HandSelectable(u8 pos);
+
+static void DrawCustomScreen(u16 *fb)
+{
+    s32 i;
+    char line[64];
+    bool8 locked = sB.f[SIDE_PLAYER].recharge;
+    Pkbn_FillRect(fb, 4, 38, 232, 104, COL_BOX);
+    Pkbn_FrameRect(fb, 4, 38, 232, 104, COL_EDGE);
+    Pkbn_DrawText(fb, 10, 43, "CUSTOM", COL_GAUGE_FULL, 2);
+    snprintf(line, sizeof(line), "FOLDER %u  USED %u", sB.folder.pileCount, sB.folder.discardCount);
+    Pkbn_DrawText(fb, 70, 46, line, COL_DIM, 1);
+    if (locked)
+        Pkbn_DrawText(fb, 150, 46, "MUST RECHARGE!", COL_HP_LOW, 1);
+    if (sB.handCount == 0)
+        Pkbn_DrawText(fb, 10, 60, "NO CHIPS LEFT - BUSTER ONLY", COL_TEXT, 1);
+    for (i = 0; i <= sB.handCount; i++)
+    {
+        s32 y = 60 + i * 9;
+        bool8 ok = PkbnGrid_HandSelectable(i);
+        bool8 picked = (i < sB.handCount) ? sB.picked[i] : sB.wildPicked;
+        u16 color = picked ? COL_GAUGE : ok ? COL_TEXT : COL_DIM;
+        u8 queueId = (i < sB.handCount) ? sB.hand[i] : FOLDER_QUEUE_WILD;
+        char code[8];
+        if (i == sB.cursor)
+            Pkbn_DrawText(fb, 8, y, ">", COL_GAUGE_FULL, 1);
+        if (picked)
+        {
+            s32 q;
+            for (q = 0; q < sB.queueCount; q++)
+                if (sB.queue[q] == queueId)
+                {
+                    snprintf(code, sizeof(code), "%d", (int)q + 1);
+                    Pkbn_DrawText(fb, 8, y, code, COL_GAUGE_FULL, 1);
+                }
+        }
+        if (i < sB.handCount)
+        {
+            const struct FolderChip *ch = &sB.folder.chips[sB.hand[i]];
+            ChipText(line, sizeof(line), ch);
+            if (ch->owner != sB.active)
+                Pkbn_DrawText(fb, 14, y, line, picked ? COL_GAUGE : ok ? COL_HP : COL_DIM, 1); // benched: switches in
+            else
+                Pkbn_DrawText(fb, 14, y, line, color, 1);
+            snprintf(code, sizeof(code), "%c", PkbnFolder_LetterChar(ch->letter));
+        }
+        else
+        {
+            Pkbn_DrawText(fb, 14, y, "SWITCH>ANY   (NOTHING AFTER IT)", color, 1);
+            snprintf(code, sizeof(code), "*");
+        }
+        Pkbn_DrawText(fb, 228 - Pkbn_TextWidth(code, 1), y, code, ok || picked ? COL_CODE : COL_DIM, 1);
+    }
+    Pkbn_DrawText(fb, 10, 118, "A:ADD  B:UNDO  SAME LETTER OR SAME MOVE", COL_DIM, 1);
+    Pkbn_DrawText(fb, 10, 126, "GREEN = BENCHED, SWITCHES IN TO USE IT", COL_HP, 1);
+    Pkbn_DrawText(fb, 10, 134, "START:FIGHT", COL_GAUGE_FULL, 1);
+}
+
+static void DrawPicker(u16 *fb)
+{
+    s32 i;
+    const char *title = sB.pickPurpose == PICK_FAINT ? "CHOOSE NEXT" : sB.pickPurpose == PICK_BATON ? "BATON PASS TO" : "SWITCH TO";
+    Pkbn_FillRect(fb, 40, 40, 160, 20 + sB.pickCount * 14, COL_BOX);
+    Pkbn_FrameRect(fb, 40, 40, 160, 20 + sB.pickCount * 14, COL_EDGE);
+    Pkbn_DrawText(fb, 46, 45, title, COL_GAUGE_FULL, 1);
+    for (i = 0; i < sB.pickCount; i++)
+    {
+        const struct PartyMember *pm = &sB.party[sB.pickOptions[i]];
+        char line[32];
+        s32 y = 56 + i * 14;
+        if (i == sB.pickCursor)
+            Pkbn_DrawText(fb, 46, y + 2, ">", COL_GAUGE_FULL, 1);
+        snprintf(line, sizeof(line), "%s L%u", pm->name, pm->bm.level);
+        Pkbn_DrawText(fb, 54, y, line, COL_TEXT, 1);
+        DrawHpBar(fb, 54, y + 7, 60, pm->bm.hp, pm->bm.maxHP);
+        snprintf(line, sizeof(line), "%u/%u", pm->bm.hp, pm->bm.maxHP);
+        Pkbn_DrawText(fb, 120, y + 6, line, COL_TEXT, 1);
+    }
+}
+
+static void DimFrame(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < DISPLAY_WIDTH * DISPLAY_HEIGHT; i++)
+    {
+        u16 c = fb[i];
+        u16 r = (c & 31) >> 2, g = ((c >> 5) & 31) >> 2, b = ((c >> 10) & 31) >> 2;
+        fb[i] = PKBN_RGB(r, g, b);
+    }
+}
+
+static void DrawTimeStop(u16 *fb)
+{
+    const struct PartyMember *pm = &sB.party[sB.tsTarget];
+    s32 x, y, t = TIMESTOP_FRAMES - sB.timer;
+    char line[40];
+    DimFrame(fb);
+    PanelOrigin(sB.f[SIDE_PLAYER].x, sB.f[SIDE_PLAYER].y, &x, &y);
+    y = y + PANEL_H - 34 - (TIMESTOP_FRAMES / 2 > t ? (TIMESTOP_FRAMES / 2 - t) * 2 : 0);
+    Pkbn_BlitIcon(fb, pm->icon[(sB.frame / 8) & 1], x + (PANEL_W - 32) / 2, y, TRUE, (t & 4) ? COL_TEXT : 0);
+    if (sB.tsKind == TS_ASSIST)
+        snprintf(line, sizeof(line), "ASSIST: %s!", pm->name);
+    else
+        snprintf(line, sizeof(line), "GO! %s!", pm->name);
+    Pkbn_FillRect(fb, 0, 42, DISPLAY_WIDTH, 18, COL_BOX);
+    Pkbn_DrawText(fb, (DISPLAY_WIDTH - Pkbn_TextWidth(line, 2)) / 2, 46, line, COL_TEXT, 2);
+}
+
+void Draw_Overlay(u16 *fb)
+{
+    s32 bw;
+    Pkbn_FillRect(fb, 0, 0, DISPLAY_WIDTH, DISPLAY_HEIGHT, COL_BG);
+    DrawFighterHud(fb, 4, &sB.f[SIDE_PLAYER]);
+    DrawFighterHud(fb, 156, &sB.f[SIDE_ENEMY]);
+    DrawPartyPips(fb);
+    DrawGrid(fb);
+    DrawFighter(fb, SIDE_PLAYER);
+    DrawFighter(fb, SIDE_ENEMY);
+    DrawAttacksOverlay(fb);
+    DrawBottomHud(fb);
+
+    if (sB.state == ST_TIMESTOP)
+        DrawTimeStop(fb);
+    if (sB.state == ST_CUSTOM)
+        DrawCustomScreen(fb);
+    if (sB.state == ST_PICK)
+        DrawPicker(fb);
+    if (sB.msgTimer && sB.state != ST_TIMESTOP && sB.state != ST_CUSTOM)
+    {
+        bw = Pkbn_TextWidth(sB.msg, 1);
+        Pkbn_DrawText(fb, (DISPLAY_WIDTH - bw) / 2, 48, sB.msg, COL_GAUGE_FULL, 1);
+    }
+    if (sB.state == ST_INTRO || sB.state == ST_END)
+    {
+        bw = Pkbn_TextWidth(sB.banner, 2);
+        Pkbn_FillRect(fb, 0, 42, DISPLAY_WIDTH, 18, COL_BOX);
+        Pkbn_DrawText(fb, (DISPLAY_WIDTH - bw) / 2, 46, sB.banner, COL_TEXT, 2);
+    }
+}
+
+#endif // PORTABLE
diff --git a/src/pkbn/grid_field.c b/src/pkbn/grid_field.c
new file mode 100644
index 0000000..27e0b76
--- /dev/null
+++ b/src/pkbn/grid_field.c
@@ -0,0 +1,454 @@
+// Grid battle: panels, statuses, weather and the turn clock. See include/pkbn/grid_internal.h.
+//
+// Grounding:
+//  - Panel types and their effects follow the BN6 code named in grid_internal.h (PANEL_*).
+//  - One "turn" = one Custom gauge (CUSTOM_FRAMES). Gen 3 end-of-turn effects run once per turn with
+//    Gen 3 amounts: poison 1/8, toxic n/16, burn 1/8, Leech Seed 1/8, Nightmare 1/4, wrap 1/16,
+//    sandstorm / hail 1/16, Ingrain 1/16 (battle_util.c DoBattlerEndTurnEffects / DoFieldEndTurnEffects).
+//  - Sleep 2-5 turns, confusion 2-5 turns, freeze thaws 20% (Gen 3). Review rule: sleep breaks when hit.
+#include "pkbn/grid_internal.h"
+#include "random.h"
+#include "sound.h"
+#include "constants/abilities.h"
+#include "constants/battle_move_effects.h"
+#include "constants/moves.h"
+#include "constants/songs.h"
+
+#ifdef PORTABLE
+
+static const char *const sStatNames[NUM_BATTLE_STATS] =
+{
+    [STAT_HP] = "HP", [STAT_ATK] = "ATTACK", [STAT_DEF] = "DEFENSE", [STAT_SPEED] = "SPEED",
+    [STAT_SPATK] = "SP. ATK", [STAT_SPDEF] = "SP. DEF", [STAT_ACC] = "ACCURACY", [STAT_EVASION] = "EVASION",
+};
+
+const char *Field_StatName(u8 stat)
+{
+    return stat < NUM_BATTLE_STATS ? sStatNames[stat] : "";
+}
+
+static bool8 HasType(const struct Fighter *f, u8 type)
+{
+    if (f->typeOverride)
+        return f->typeOverride - 1 == type;
+    return f->bm.types[0] == type || f->bm.types[1] == type;
+}
+
+void Field_Init(void)
+{
+    memset(sB.panel, 0, sizeof(sB.panel));
+    memset(sB.panelTimer, 0, sizeof(sB.panelTimer));
+    sB.weather = 0;
+    sB.weatherTurns = 0;
+}
+
+void Field_SetPanel(s8 x, s8 y, u8 type)
+{
+    if (!InGrid(x, y))
+        return;
+    sB.panel[y][x] = type;
+    switch (type)
+    {
+    case PANEL_BROKEN:
+        sB.panelTimer[y][x] = BROKEN_PANEL_FRAMES;
+        break;
+    case PANEL_POISON:
+    case PANEL_HOLY:
+    case PANEL_GRASS:
+        sB.panelTimer[y][x] = PANEL_EFFECT_FRAMES;
+        break;
+    default:
+        sB.panelTimer[y][x] = 0; // cracked panels stay cracked until stepped off (BN)
+        break;
+    }
+}
+
+bool8 Field_CanStand(u8 side, s8 x, s8 y)
+{
+    if (!InGrid(x, y))
+        return FALSE;
+    if (side == SIDE_PLAYER ? x >= PLAYER_COLS : x < PLAYER_COLS)
+        return FALSE;
+    return sB.panel[y][x] != PANEL_BROKEN;
+}
+
+// Move a fighter. A cracked panel breaks when its occupant steps off it (BN).
+void Field_Step(u8 side, s8 nx, s8 ny)
+{
+    struct Fighter *f = &sB.f[side];
+    if (sB.panel[f->y][f->x] == PANEL_CRACKED && (nx != f->x || ny != f->y))
+    {
+        Field_SetPanel(f->x, f->y, PANEL_BROKEN);
+        PlaySE(SE_BREAKABLE_DOOR);
+    }
+    f->x = nx;
+    f->y = ny;
+}
+
+void Field_PushBack(u8 side, u8 panels)
+{
+    struct Fighter *f = &sB.f[side];
+    s8 back = (side == SIDE_PLAYER) ? -1 : 1;
+    if (f->rooted || f->bm.ability == ABILITY_SUCTION_CUPS)
+    {
+        SetMsg("IT ANCHORED ITSELF!", 40);
+        return;
+    }
+    while (panels-- && Field_CanStand(side, f->x + back, f->y))
+        Field_Step(side, f->x + back, f->y);
+}
+
+// ---- Statuses ---------------------------------------------------------------------------------
+
+bool8 Field_IsAsleep(u8 side)
+{
+    return (sB.f[side].bm.status1 & STATUS1_SLEEP) != 0;
+}
+
+static bool8 BlockedBySafeguard(u8 targetSide, u8 fromSide, bool8 viaMove)
+{
+    struct Fighter *t = &sB.f[targetSide];
+    if (viaMove && targetSide != fromSide && t->safeguard)
+    {
+        t->safeguard = FALSE; // review: Safeguard is a Barrier for status moves (one use)
+        SetMsg("SAFEGUARD PROTECTED IT!", 50);
+        PlaySE(SE_BOO);
+        PKBN_LOG("%s's Safeguard blocked a status", t->name);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// Major status (Gen 3 status1). Immunities as Gen 3 (types + abilities).
+bool8 Field_TryStatus(u8 targetSide, u8 fromSide, u16 move, u32 status, bool8 viaMove)
+{
+    struct Fighter *t = &sB.f[targetSide];
+    const char *text = NULL;
+    u8 ab = t->bm.ability;
+
+    if (t->bm.hp == 0 || t->bm.status1 != 0)
+        return FALSE;
+    if (status & STATUS1_SLEEP)
+    {
+        if (ab == ABILITY_INSOMNIA || ab == ABILITY_VITAL_SPIRIT)
+            return FALSE;
+    }
+    else if (status & (STATUS1_POISON | STATUS1_TOXIC_POISON))
+    {
+        if (HasType(t, TYPE_POISON) || HasType(t, TYPE_STEEL) || ab == ABILITY_IMMUNITY)
+            return FALSE;
+    }
+    else if (status & STATUS1_BURN)
+    {
+        if (HasType(t, TYPE_FIRE) || ab == ABILITY_WATER_VEIL)
+            return FALSE;
+    }
+    else if (status & STATUS1_FREEZE)
+    {
+        if (HasType(t, TYPE_ICE) || ab == ABILITY_MAGMA_ARMOR || (sB.weather & B_WEATHER_SUN))
+            return FALSE;
+    }
+    else if (status & STATUS1_PARALYSIS)
+    {
+        if (ab == ABILITY_LIMBER)
+            return FALSE;
+    }
+    if (BlockedBySafeguard(targetSide, fromSide, viaMove))
+        return FALSE;
+
+    if (status & STATUS1_SLEEP)
+    {
+        t->bm.status1 = (Random() & 3) + 2; // Gen 3: 2-5 turns
+        text = "FELL ASLEEP!";
+    }
+    else if (status & STATUS1_TOXIC_POISON)
+    {
+        t->bm.status1 = STATUS1_TOXIC_POISON; // counter starts at 0
+        text = "WAS BADLY POISONED!";
+    }
+    else if (status & STATUS1_POISON)
+    {
+        t->bm.status1 = STATUS1_POISON;
+        text = "WAS POISONED!";
+    }
+    else if (status & STATUS1_BURN)
+    {
+        t->bm.status1 = STATUS1_BURN;
+        text = "WAS BURNED!";
+    }
+    else if (status & STATUS1_FREEZE)
+    {
+        t->bm.status1 = STATUS1_FREEZE;
+        text = "WAS FROZEN SOLID!";
+    }
+    else if (status & STATUS1_PARALYSIS)
+    {
+        t->bm.status1 = STATUS1_PARALYSIS;
+        t->stun = 30; // TUNE: the jolt (BN paralysis is a short stun)
+        text = "IS PARALYZED!";
+    }
+    if (text != NULL)
+    {
+        char line[40];
+        snprintf(line, sizeof(line), "%s %s", t->name, text);
+        SetMsg(line, 60);
+        t->statusFlash = 20;
+        PlaySE(SE_BOO);
+        PKBN_LOG("%s status1=0x%x (move %u)", t->name, (unsigned)t->bm.status1, move);
+    }
+    return TRUE;
+}
+
+bool8 Field_TryConfuse(u8 targetSide, u8 fromSide, u16 move, bool8 viaMove)
+{
+    struct Fighter *t = &sB.f[targetSide];
+    char line[40];
+    if (t->bm.hp == 0 || t->confTurns || t->bm.ability == ABILITY_OWN_TEMPO)
+        return FALSE;
+    if (BlockedBySafeguard(targetSide, fromSide, viaMove))
+        return FALSE;
+    t->confTurns = (Random() % 4) + 2; // Gen 3: 2-5 turns
+    snprintf(line, sizeof(line), "%s BECAME CONFUSED!", t->name);
+    SetMsg(line, 60);
+    t->statusFlash = 20;
+    PKBN_LOG("%s confused for %u turns (move %u)", t->name, t->confTurns, move);
+    return TRUE;
+}
+
+// Review rule: a sleeping Pokémon wakes up when an attack lands.
+void Field_WakeOnHit(u8 side)
+{
+    struct Fighter *f = &sB.f[side];
+    if (f->bm.status1 & STATUS1_SLEEP)
+    {
+        char line[40];
+        f->bm.status1 &= ~STATUS1_SLEEP;
+        f->nightmare = FALSE;
+        snprintf(line, sizeof(line), "%s WOKE UP!", f->name);
+        SetMsg(line, 50);
+        PKBN_LOG("%s woke up (hit)", f->name);
+    }
+}
+
+// Stat stage change (Gen 3 limits). Mist blocks drops from the foe (Gen 3). Returns TRUE if changed.
+u8 Field_ApplyStatStage(u8 side, u8 stat, s8 delta, bool8 fromFoe)
+{
+    struct Fighter *f = &sB.f[side];
+    s32 stage = f->bm.statStages[stat];
+    char text[40];
+
+    if (delta < 0 && fromFoe)
+    {
+        if (f->mistTurns)
+        {
+            SetMsg("IT'S PROTECTED BY MIST!", 50);
+            return FALSE;
+        }
+        if (f->bm.ability == ABILITY_CLEAR_BODY || f->bm.ability == ABILITY_WHITE_SMOKE
+         || (stat == STAT_ATK && f->bm.ability == ABILITY_HYPER_CUTTER)
+         || (stat == STAT_ACC && f->bm.ability == ABILITY_KEEN_EYE))
+        {
+            SetMsg("ITS ABILITY PREVENTS IT!", 50);
+            return FALSE;
+        }
+    }
+    if ((delta > 0 && stage >= MAX_STAT_STAGE) || (delta < 0 && stage <= MIN_STAT_STAGE))
+    {
+        snprintf(text, sizeof(text), "%s WON'T GO %s!", sStatNames[stat], delta > 0 ? "HIGHER" : "LOWER");
+        SetMsg(text, 50);
+        return FALSE;
+    }
+    stage += delta;
+    if (stage < MIN_STAT_STAGE) stage = MIN_STAT_STAGE;
+    if (stage > MAX_STAT_STAGE) stage = MAX_STAT_STAGE;
+    f->bm.statStages[stat] = stage;
+    f->statusFlash = 12;
+    snprintf(text, sizeof(text), "%s %s!", sStatNames[stat],
+             delta > 1 ? "ROSE SHARPLY" : delta > 0 ? "ROSE" : delta < -1 ? "HARSHLY FELL" : "FELL");
+    SetMsg(text, 60);
+    PlaySE(delta > 0 ? SE_EXP_MAX : SE_BOO);
+    PKBN_LOG("%s stat %u %+d -> stage %d", f->name, stat, delta, (int)stage);
+    return TRUE;
+}
+
+void Field_ResetFighterConditions(struct Fighter *f)
+{
+    f->barrier = FALSE;
+    f->protectUses = 0;
+    f->lastKind = GK_NONE;
+    f->stun = f->hold = f->invuln = f->charging = 0;
+    f->invulnKind = INVULN_NONE;
+    f->noEscape = f->cursed = FALSE;
+    f->chargeMove = MOVE_NONE;
+    f->focusBroken = FALSE;
+    f->confTurns = f->trapTurns = f->yawn = f->mistTurns = 0;
+    f->infatuated = f->seeded = f->nightmare = f->safeguard = f->magicCoat = FALSE;
+    f->focusEnergy = f->chargeNext = f->lockOnNext = f->rooted = FALSE;
+    f->mudSport = f->waterSport = f->defenseCurl = f->recharge = FALSE;
+    f->fakeOutReady = TRUE;
+    f->rolloutCount = f->furyCount = 0;
+    f->bideFrames = f->bideDamage = 0;
+    f->lastPhysDamage = 0;
+    f->typeOverride = 0;
+}
+
+// ---- Per-frame -------------------------------------------------------------------------------
+
+static void TickFighterTimers(struct Fighter *f)
+{
+    if (f->stun) f->stun--;
+    if (f->hold) f->hold--;
+    if (f->invuln && --f->invuln == 0)
+        f->invulnKind = INVULN_NONE;
+}
+
+void Field_Update(void)
+{
+    s32 r, c, s;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (sB.panelTimer[r][c] && --sB.panelTimer[r][c] == 0)
+                sB.panel[r][c] = PANEL_NORMAL;
+
+    for (s = 0; s < 2; s++)
+    {
+        struct Fighter *f = &sB.f[s];
+        TickFighterTimers(f);
+        if (f->bm.hp == 0)
+            continue;
+        // BN6 poison panel: 1 damage every 7 frames while standing on it (sub_801A186).
+        // Pokémon HP is far lower than a Navi's, so one "damage" here is maxHP/128 (TUNE).
+        if (sB.panel[f->y][f->x] == PANEL_POISON && !f->invuln
+         && !HasType(f, TYPE_POISON) && !HasType(f, TYPE_STEEL))
+        {
+            if (sB.poisonTick[s] == 0)
+            {
+                s32 dmg = f->bm.maxHP / 128;
+                sB.poisonTick[s] = POISON_PANEL_PERIOD;
+                Moves_DamageFighter(s, dmg < 1 ? 1 : dmg, NULL);
+            }
+            sB.poisonTick[s]--;
+        }
+        else
+        {
+            sB.poisonTick[s] = 0;
+        }
+    }
+}
+
+// ---- End of turn (one Custom gauge of fight time) ----------------------------------------------
+
+static s32 Frac(const struct Fighter *f, s32 div)
+{
+    s32 v = f->bm.maxHP / div;
+    return v < 1 ? 1 : v;
+}
+
+static void Heal(struct Fighter *f, s32 amount)
+{
+    if (f->bm.hp == 0)
+        return;
+    f->bm.hp = (f->bm.hp + amount > f->bm.maxHP) ? f->bm.maxHP : f->bm.hp + amount;
+}
+
+void Field_EndTurn(void)
+{
+    s32 s;
+    char line[40];
+
+    sB.turn++;
+    PKBN_LOG("---- end of turn %u ----", (unsigned)sB.turn);
+
+    // Weather (Gen 3 DoFieldEndTurnEffects): 5 turns, sandstorm / hail chip 1/16.
+    if (sB.weatherTurns && --sB.weatherTurns == 0)
+    {
+        SetMsg(sB.weather & B_WEATHER_RAIN ? "THE RAIN STOPPED." : sB.weather & B_WEATHER_SUN ? "THE SUNLIGHT FADED."
+             : sB.weather & B_WEATHER_SANDSTORM ? "THE SANDSTORM SUBSIDED." : "THE HAIL STOPPED.", 60);
+        sB.weather = 0;
+    }
+    for (s = 0; s < 2; s++)
+    {
+        struct Fighter *f = &sB.f[s];
+        if (f->bm.hp == 0 || f->invuln)
+            continue;
+        if ((sB.weather & B_WEATHER_SANDSTORM) && !HasType(f, TYPE_ROCK) && !HasType(f, TYPE_GROUND) && !HasType(f, TYPE_STEEL))
+            Moves_DamageFighter(s, Frac(f, 16), "IS BUFFETED BY THE SANDSTORM!");
+        if ((sB.weather & B_WEATHER_HAIL) && !HasType(f, TYPE_ICE))
+            Moves_DamageFighter(s, Frac(f, 16), "IS PELTED BY HAIL!");
+    }
+
+    for (s = 0; s < 2; s++)
+    {
+        struct Fighter *f = &sB.f[s];
+        struct Fighter *o = &sB.f[s ^ 1];
+        if (f->bm.hp == 0)
+            continue;
+        // Ingrain (Gen 3: 1/16) - only while rooted on its grass.
+        if (f->rooted && sB.panel[f->y][f->x] == PANEL_GRASS)
+            Heal(f, Frac(f, 16));
+        // BN grass panel heals Wood-element objects; here Grass types (1/16 per turn, TUNE).
+        else if (sB.panel[f->y][f->x] == PANEL_GRASS && HasType(f, TYPE_GRASS))
+            Heal(f, Frac(f, 16));
+        // Leech Seed: 1/8 to whoever is in on the other side.
+        if (f->seeded && o->bm.hp)
+        {
+            s32 d = Frac(f, 8);
+            if (d > f->bm.hp) d = f->bm.hp;
+            Moves_DamageFighter(s, d, "IS SAPPED BY LEECH SEED!");
+            Heal(o, d);
+        }
+        if (f->bm.status1 & STATUS1_POISON)
+            Moves_DamageFighter(s, Frac(f, 8), "IS HURT BY POISON!");
+        if (f->bm.status1 & STATUS1_TOXIC_POISON)
+        {
+            s32 d = Frac(f, 16);
+            if ((f->bm.status1 & STATUS1_TOXIC_COUNTER) != STATUS1_TOXIC_TURN(15))
+                f->bm.status1 += STATUS1_TOXIC_TURN(1);
+            d *= (f->bm.status1 & STATUS1_TOXIC_COUNTER) >> 8;
+            Moves_DamageFighter(s, d, "IS HURT BY POISON!");
+        }
+        if (f->bm.status1 & STATUS1_BURN)
+            Moves_DamageFighter(s, Frac(f, 8), "IS HURT BY ITS BURN!");
+        if (f->nightmare && (f->bm.status1 & STATUS1_SLEEP))
+            Moves_DamageFighter(s, Frac(f, 4), "IS LOCKED IN A NIGHTMARE!");
+        if (f->cursed)
+            Moves_DamageFighter(s, Frac(f, 4), "IS AFFLICTED BY THE CURSE!");
+        if (f->trapTurns)
+        {
+            f->trapTurns--;
+            Moves_DamageFighter(s, Frac(f, 16), "IS HURT BY THE TRAP!");
+        }
+        if (f->bm.hp == 0)
+            continue;
+        // Sleep counts down (Gen 3 decrements on each move attempt; here once per turn).
+        if (f->bm.status1 & STATUS1_SLEEP)
+        {
+            f->bm.status1 -= 1;
+            if ((f->bm.status1 & STATUS1_SLEEP) == 0)
+            {
+                f->nightmare = FALSE;
+                snprintf(line, sizeof(line), "%s WOKE UP!", f->name);
+                SetMsg(line, 50);
+            }
+        }
+        // Freeze: Gen 3 thaws 20% of the time (checked when the frozen Pokémon tries to move).
+        if ((f->bm.status1 & STATUS1_FREEZE) && Random() % 5 == 0)
+        {
+            f->bm.status1 &= ~STATUS1_FREEZE;
+            snprintf(line, sizeof(line), "%s THAWED OUT!", f->name);
+            SetMsg(line, 50);
+        }
+        if (f->confTurns && --f->confTurns == 0)
+        {
+            snprintf(line, sizeof(line), "%s IS NO LONGER CONFUSED!", f->name);
+            SetMsg(line, 50);
+        }
+        if (f->mistTurns)
+            f->mistTurns--;
+        if (f->yawn && --f->yawn == 0)
+            Field_TryStatus(s, s, MOVE_YAWN, STATUS1_SLEEP, FALSE);
+        f->fakeOutReady = FALSE;
+    }
+}
+
+#endif // PORTABLE
diff --git a/src/pkbn/grid_moves.c b/src/pkbn/grid_moves.c
new file mode 100644
index 0000000..3196fdc
--- /dev/null
+++ b/src/pkbn/grid_moves.c
@@ -0,0 +1,2190 @@
+// Grid battle: what a move does on the 6x3 grid.
+//
+// Every move has a KIND (tools/attacks_curated.py -> src/pkbn/move_table.c), modelled on a BN6 chip
+// family. The numbers that decide damage and side effects are Gen 3's own:
+//  - damage: CalculateBaseDamage (pokemon.c:3106) x crit x Charge, then STAB / type chart / random,
+//    as Cmd_damagecalc and Cmd_typecalc (battle_script_commands.c:1290, :1355) and :1639.
+//  - crits: Cmd_critcalc (:1253) with sCriticalHitChance {16, 8, 4, 3, 2} (:606).
+//  - power formulas: Flail / Reversal (:8320), Rollout (:8556), Fury Cutter (:8600), Return /
+//    Frustration (:8623), Magnitude (:8690), Hidden Power (:8909), Beat Up (:8977), Psywave (:7952),
+//    Low Kick weight table (:774), Eruption / Water Spout (scaledamagebyhealthratio), Secret Power (:9639).
+//  - multi-hit 2-5 odds: Cmd_setmultihitcounter (:7159).
+//  - accuracy: Gen 3 rolls accuracy; on the grid you dodge instead. A Pokémon's accuracy stage against
+//    the target's evasion stage (sAccuracyStageRatios, :588) stretches or shortens warnings and
+//    projectile speed, so Sand Attack makes the foe's attacks easier to dodge.
+// Kinds' timings are TUNE values unless a comment names the BN6 source.
+#include "pkbn/grid_internal.h"
+#include "data.h"
+#include "pkbn/render.h"
+#include "pokedex.h"
+#include "random.h"
+#include "sound.h"
+#include "constants/abilities.h"
+#include "constants/battle_move_effects.h"
+#include "constants/moves.h"
+#include "constants/songs.h"
+#include "constants/species.h"
+
+#ifdef PORTABLE
+
+// TUNE timings (frames)
+#define FIREHIT_FAST     14
+#define FIREHIT_NORMAL   22
+#define FIREHIT_SLOW     32
+#define MULTI_HIT_GAP    8
+#define VULCAN_GAP       6
+#define TORNADO_TICKS    4
+#define TORNADO_GAP      6
+#define METEOR_WARN      24
+#define DIG_VANISH       40
+#define DIG_WARN         20
+#define DELAYED_WAIT     240   // Gen 3 Future Sight lands 2 turns later; here ~4 seconds
+#define FIELD_WARN       48
+#define WAVE_STEP        8
+#define SHOCKWAVE_STEP   10
+#define AIRHOCKEY_STEP   6
+#define AIRHOCKEY_BOUNCES 4
+#define DELAYED_STEP     3
+#define HOLD_FRAMES      90
+#define FLINCH_FRAMES    20
+#define RECENT_HIT       120   // "this turn" for Counter / Revenge
+#define FLY_RECOVERY     60    // review: Fly has a very slow recovery
+
+
+static const u8 sAccRatio[13][2] = // sAccuracyStageRatios (battle_script_commands.c:588), as dividend/divisor
+{
+    {33, 100}, {36, 100}, {43, 100}, {50, 100}, {60, 100}, {75, 100}, {1, 1},
+    {133, 100}, {166, 100}, {2, 1}, {233, 100}, {133, 50}, {3, 1},
+};
+static const u16 sCritChance[] = {16, 8, 4, 3, 2};                   // sCriticalHitChance (:606)
+static const u8 sFlailTable[] = {1, 200, 4, 150, 9, 100, 16, 80, 32, 40, 48, 20}; // (:749)
+static const u16 sWeightTable[] = {100, 20, 250, 40, 500, 60, 1000, 80, 2000, 100, 0xFFFF, 0xFFFF}; // (:774)
+static const u16 sNaturePower[] = // sNaturePowerMoves (:760)
+{
+    [BATTLE_ENVIRONMENT_GRASS] = MOVE_STUN_SPORE, [BATTLE_ENVIRONMENT_LONG_GRASS] = MOVE_RAZOR_LEAF,
+    [BATTLE_ENVIRONMENT_SAND] = MOVE_EARTHQUAKE, [BATTLE_ENVIRONMENT_UNDERWATER] = MOVE_HYDRO_PUMP,
+    [BATTLE_ENVIRONMENT_WATER] = MOVE_SURF, [BATTLE_ENVIRONMENT_POND] = MOVE_BUBBLE_BEAM,
+    [BATTLE_ENVIRONMENT_MOUNTAIN] = MOVE_ROCK_SLIDE, [BATTLE_ENVIRONMENT_CAVE] = MOVE_SHADOW_BALL,
+    [BATTLE_ENVIRONMENT_BUILDING] = MOVE_SWIFT, [BATTLE_ENVIRONMENT_PLAIN] = MOVE_SWIFT,
+};
+// Sound-based moves (Gen 3 sSoundMovesTable, battle_util.c) that are still chips.
+static const u16 sSoundMoves[] =
+{
+    MOVE_GROWL, MOVE_ROAR, MOVE_SING, MOVE_SUPERSONIC, MOVE_SCREECH, MOVE_SNORE, MOVE_HEAL_BELL,
+    MOVE_METAL_SOUND, MOVE_GRASS_WHISTLE, MOVE_HYPER_VOICE,
+};
+// Moves Metronome / Sleep Talk won't call (sMovesForbiddenToCopy, :725, plus moves cut by the review).
+static const u16 sForbiddenToCall[] =
+{
+    MOVE_METRONOME, MOVE_STRUGGLE, MOVE_SKETCH, MOVE_MIMIC, MOVE_COUNTER, MOVE_PROTECT, MOVE_DETECT,
+    MOVE_SLEEP_TALK, MOVE_THIEF, MOVE_COVET, MOVE_FOCUS_PUNCH, MOVE_ASSIST, MOVE_BATON_PASS,
+    MOVE_MIRROR_MOVE, MOVE_NATURE_POWER,
+};
