diff --git a/include/pkbn/move_table.h b/include/pkbn/move_table.h
new file mode 100644
index 0000000..c334a15
--- /dev/null
+++ b/include/pkbn/move_table.h
@@ -0,0 +1,75 @@
+// GENERATED by tools/gen_move_table.py. Kinds are documented in tools/attacks_curated.py (KINDS).
+#ifndef GUARD_PKBN_MOVE_TABLE_H
+#define GUARD_PKBN_MOVE_TABLE_H
+
+enum
+{
+    GK_CANNON, // Hits the first target down the row. [Cannon (0x14) "Cannon to attack 1 enemy"]
+    GK_AIRSHOT, // Cannon that knocks the target 1 panel back. [AirShot (0x21) "Knock enmy back 1 square"]
+    GK_VULCAN, // Rapid shots; each hits the first target and the panel behind it. [Vulcan1 (0x17) "3-shot to pierce 1 panel!"]
+    GK_SPREADER, // Cannon whose hit splashes the 8 panels around the target. [Spreadr1 (0x25) "Spreads damg to adj panls"]
+    GK_SWORD, // The panel in front of you. [Sword (0x13/0) "Cuts enmy in front! Range: 1"]
+    GK_LONGSWORD, // 2 panels ahead in your row. [LongSwrd (0x13/2) "Range: 2"]
+    GK_WIDESWORD, // The column in front of you, all 3 rows. [WideSwrd (0x13/1) "Range: 3"]
+    GK_LIFESWORD, // 2 columns x 3 rows in front of you. [LifeSrd (BN6 Program Advance of the Sword family)]
+    GK_LINE3, // 3 panels ahead in your row. [FireSwrd (0x13/0xC) "Cut enmy 3sq fwrd w/fire!"]
+    GK_DASH, // Charge through your whole row ahead (up to 5 panels). [review: Rollout / Volt Tackle / Waterfall / Pursuit]
+    GK_CONE, // 1 panel ahead, then all 3 rows 2 ahead. [GunDelS1 (0x37) - review: "Gun Del Sol pattern (cone basically)"]
+    GK_TORNADO, // A multi-hit storm on the panel 2 ahead. [Tornado (0x2F/1) "8hit strm 2 squares ahead"]
+    GK_FIREHIT, // Spawns on the target's panel after a short warning; step away in time to dodge. [FireHit1 (0x1C/8) "Slams closest enemy"]
+    GK_GOLEMHIT, // Like FireHit but slams the target's panel and the panels above and below. [GolmHit1 (0x1C/0x15) "Hit 3panl area arnd clst enmy"]
+    GK_METEORS, // Several rocks drop on the enemy area, aimed near the target. [Meteors (0x15/0x10) "Drop many meteor on enmy area"]
+    GK_DIG, // Vanish (can't be hit), then burst out under the target after a warning. [SandWrm1 (0x1C/0xC) "Attk enmy from rear w/snakarm"]
+    GK_DELAYED, // Nothing happens now; a fast shot fires down your row later. [review: Future Sight / Doom Desire]
+    GK_FIELD, // Hits the whole enemy area after a warning. The user faints. [Gen 3: Explosion / Self-Destruct hit every foe]
+    GK_BOMB, // Thrown 3 panels ahead; blast pattern on landing. [MiniBomb (0x12/0) "Throws a MiniBomb 3sq ahead"; BigBomb "9 panl bomb"]
+    GK_SHOCKWAVE, // A ground wave that rolls along the row, panel by panel. [WaveArm1 (0x31) "fire trap wave"; Mettaur-style shockwave]
+    GK_WAVE, // A travelling wave you can see coming (1 or 3 rows). [WideSht (0x30) "Fires 3sq shotgun blast!"]
+    GK_AIRHOCKEY, // A puck that flies diagonally and bounces off the walls. [AirHocky (0x26) "Bounce the puck off walls"]
+    GK_BALL, // A slow ball down your row. Low-accuracy moves fly slower, so they are easy to dodge. [Thunder (0x1F) "Pralyzing electric attack!" (slow ball); review: low accuracy = slow projectile]
+    GK_LOCKON, // Locks onto the target, then a hit that can't be dodged. [MachGun1 (0x29) "Fire 9sts at row w/ clst enmy"]
+    GK_BARRIER, // Absorbs the next hit (Gen 3 Protect odds). [Barrier (0x15/4) "Nullifies 10 HP of damage"]
+    GK_STATS, // Stat stages; always lands, ignores Barrier and dodging. [design rule (POC-3)]
+    GK_STATUS, // A status effect that always lands wherever the target stands. [review note on Thunder Wave]
+    GK_PANEL, // Changes panels: poison, cracked, holy, grass. [PoisSeed "Makes 9sq poisn swp 3sq ahead"; HolyPanl; GrasSeed; object_panel_setPoison (object.s:2517)]
+    GK_SELF, // Something the user does to itself: heal, cure, shield, set up. [Recov10 (0x20) "Recovers 10HP"]
+    GK_WEATHER, // Gen 3 weather for 5 turns (one turn = one Custom gauge). [Gen 3 gBattleWeather]
+    GK_BATON, // Baton Pass: switch, keeping stat stages; ends the chain. [POC-4]
+    GK_ASSIST, // A benched Pokemon pops in and uses one of its moves. [POC-4]
+    GK_CALL, // Uses another move (Metronome, Sleep Talk, Mirror Move, Nature Power). [Gen 3 move-calling effects]
+    GK_NOTHING, // Nothing happens (Splash). [Gen 3]
+    GK_NONE, // Not on the grid yet.
+    GK_COUNT
+};
