+u8 Moves_KindOf(u16 move)
+{
+    return (move != MOVE_NONE && move < MOVES_COUNT) ? gPkbnMoveInfo[move].kind : GK_NONE;
+}
+
+// Kinds that don't care where the user stands (enemy AI / autopilot don't need to line up).
+bool8 Moves_IsPositionFree(u8 kind)
+{
+    switch (kind)
+    {
+    case GK_FIREHIT: case GK_GOLEMHIT: case GK_METEORS: case GK_DIG: case GK_FIELD: case GK_LOCKON:
+    case GK_BARRIER: case GK_STATS: case GK_STATUS: case GK_PANEL: case GK_SELF: case GK_WEATHER:
+    case GK_BATON: case GK_ASSIST: case GK_CALL: case GK_NOTHING: case GK_NONE: case GK_AIRHOCKEY:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 InList(const u16 *list, u32 n, u16 move)
+{
+    u32 i;
+    for (i = 0; i < n; i++)
+        if (list[i] == move)
+            return TRUE;
+    return FALSE;
+}
+
+static bool8 FighterHasType(const struct Fighter *f, u8 type)
+{
+    if (f->typeOverride)
+        return f->typeOverride - 1 == type;
+    return f->bm.types[0] == type || f->bm.types[1] == type;
+}
+
+s32 Moves_EffectiveSpeed(const struct Fighter *f)
+{
+    u8 st = f->bm.statStages[STAT_SPEED];
+    s32 spd = (s32)f->bm.speed * gStatStageRatios[st][0] / gStatStageRatios[st][1];
+    if (f->bm.status1 & STATUS1_PARALYSIS)
+        spd /= 4; // Gen 3 paralysis quarters Speed
+    return spd;
+}
+
+// Stretch a warning / projectile step by the attacker's accuracy against the target's evasion.
+static u16 ScaleByAccuracy(u16 frames, u8 atkSide, const struct BattlePokemon *user)
+{
+    const struct Fighter *def = &sB.f[atkSide ^ 1];
+    s32 stage = (s32)user->statStages[STAT_ACC] + DEFAULT_STAT_STAGE - def->bm.statStages[STAT_EVASION];
+    u32 out;
+    if (stage < 0) stage = 0;
+    if (stage > 12) stage = 12;
+    out = (u32)frames * sAccRatio[stage][1] / sAccRatio[stage][0];
+    if (out < 4) out = 4;
+    if (out > 180) out = 180;
+    return out;
+}
+
+static void FlashCells(const u8 cells[GRID_ROWS][GRID_COLS], u8 frames)
+{
+    s32 r, c;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < GRID_COLS; c++)
+            if (cells[r][c] && sB.fx[r][c] < frames)
+                sB.fx[r][c] = frames;
+}
+
+static void FlashPanel(s8 x, s8 y, u8 frames)
+{
+    if (InGrid(x, y) && sB.fx[y][x] < frames)
+        sB.fx[y][x] = frames;
+}
+
+static void Heal(struct Fighter *f, s32 amount)
+{
+    if (f->bm.hp == 0 || amount <= 0)
+        return;
+    f->bm.hp = (f->bm.hp + amount > f->bm.maxHP) ? f->bm.maxHP : f->bm.hp + amount;
+    f->statusFlash = 12;
+}
+
+static void SayFighter(const struct Fighter *f, const char *what, u16 frames)
+{
+    char line[40];
+    snprintf(line, sizeof(line), "%s %s", f->name, what);
+    SetMsg(line, frames);
+}
+
+// Direct HP loss that isn't a move hit (status, recoil, panels). Never wakes the target.
+void Moves_DamageFighter(u8 side, s32 dmg, const char *why)
+{
+    struct Fighter *f = &sB.f[side];
+    if (f->bm.hp == 0 || dmg <= 0)
+        return;
+    if (dmg > f->bm.hp)
+        dmg = f->bm.hp;
+    f->bm.hp -= dmg;
+    f->hurtFlash = 4;
+    if (why != NULL)
+    {
+        SayFighter(f, why, 50);
+        PKBN_LOG("%s %s (-%d -> %u)", f->name, why, (int)dmg, f->bm.hp);
+    }
+}
