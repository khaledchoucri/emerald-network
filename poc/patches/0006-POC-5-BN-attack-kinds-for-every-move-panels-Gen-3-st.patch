+static struct Attack *NewAttack(void)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+        if (!sB.attacks[i].active)
+        {
+            memset(&sB.attacks[i], 0, sizeof(sB.attacks[i]));
+            sB.attacks[i].active = TRUE;
+            return &sB.attacks[i];
+        }
+    return NULL;
+}
