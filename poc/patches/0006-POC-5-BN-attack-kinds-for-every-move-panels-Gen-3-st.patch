@@ -0,0 +1,257 @@
+// Shared state of the grid battle (src/pkbn/grid_*.c). PC (PORTABLE) builds only.
+//
+// File map:
+//   grid_battle.c  setup / teardown, state machine, Custom screen, party & switching, input, enemy AI
+//   grid_moves.c   what a move does on the grid: attack kinds (tools/attacks_curated.py), damage, effects
+//   grid_field.c   panels, statuses, weather, the turn clock, movement rules
+//   grid_draw.c    the overlay drawn on top of the PC port's frame
+//
+// Values marked TUNE are our own design numbers, not taken from either game.
+#ifndef GUARD_PKBN_GRID_INTERNAL_H
+#define GUARD_PKBN_GRID_INTERNAL_H
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+#endif
+#include "global.h"
+#include "battle.h"
+#include "pokemon.h"
+#include "pkbn/folder.h"
+#include "pkbn/move_table.h"
+
+#define PKBN_LOG(...) do { printf("[pkbn f%u] ", (unsigned)sB.frame); printf(__VA_ARGS__); printf("\n"); fflush(stdout); } while (0)
+
+// ---- Layout -------------------------------------------------------------------------------
+#define GRID_COLS 6
+#define GRID_ROWS 3
+#define PANEL_W   36
+#define PANEL_H   20
+#define GRID_X    12
+#define GRID_Y    66
+#define PLAYER_COLS 3 // columns 0-2 belong to the player, 3-5 to the enemy
+
+// ---- Tuning ---------------------------------------------------------------------------------
+#define CUSTOM_FRAMES        480  // TUNE: Custom gauge fill time = one "turn" for Gen 3 end-of-turn effects
+#define MOVE_COOLDOWN        6    // TUNE: frames between panel steps
+#define BUSTER_COOLDOWN      20   // TUNE
+#define BUSTER_DAMAGE        1    // BN6 MegaBuster attack_power (ChipDataArr index 0)
+#define CHIP_LOCKOUT         24   // TUNE: frames the attacker is busy after using a move
+#define THROW_LOCKOUT        21   // BN6 bomb routine ends the thrower's attack at frame 0x15 (asm31.s, sub_80EB644)
+#define HIT_IFRAMES          45   // TUNE: invincibility after taking a move hit
+#define SWITCH_IFRAMES       30   // TUNE
+#define ENEMY_STEP_MIN       40   // TUNE
+#define ENEMY_STEP_RAND      50   // TUNE
+#define ENEMY_TELEGRAPH      36   // TUNE: warning before an enemy's direct attack lands
+#define GRENADE_RANGE        3    // BN6 MiniBomb "Throws a MiniBomb 3sq ahead"
+#define GRENADE_FLIGHT       30   // TUNE
+#define LOCKON_FRAMES        40   // TUNE
+#define TIMESTOP_FRAMES      48   // TUNE
+#define POISON_PANEL_PERIOD  7    // BN6: poison panel timer reloads 6 and fires below 0 (asm00_2.s sub_801A186)
+#define BROKEN_PANEL_FRAMES  600  // TUNE: a broken panel comes back after this long
+#define PANEL_EFFECT_FRAMES  900  // TUNE: poison / holy / grass panels fade after this long
+#define MAX_ATTACKS          10
+
+enum { ST_INTRO, ST_CUSTOM, ST_FIGHT, ST_END, ST_PICK, ST_TIMESTOP };
+enum { SIDE_PLAYER, SIDE_ENEMY };
+enum { PICK_WILD, PICK_BATON, PICK_FAINT };
+enum { TS_SWITCH, TS_ASSIST, TS_BENCH };
+
+// Panel types. Numbers in comments are BN6 oPanelData_Type values from the code we model.
+enum
+{
+    PANEL_NORMAL,   // 1
+    PANEL_CRACKED,  // 2: breaks when the one standing on it steps off (object_crackPanel)
+    PANEL_BROKEN,   // 3: a hole, nobody can stand on it (object_breakPanel)
+    PANEL_POISON,   // 4: drains HP while you stand on it (object_panel_setPoison, sub_801A186)
+    PANEL_HOLY,     // 5: halves damage taken on it (object_calculateFinalDamage1, object.s:4811)
+    PANEL_GRASS,    // 6: heals Wood-element objects (sub_801A186) -> here: Grass types
+};
+
+struct Fighter
+{
+    struct BattlePokemon bm;
+    s8 x, y;
+    u16 moveCd;
+    u16 lockout;
+    u16 iframes;
+    u16 hurtFlash;
+    u16 statusFlash;
+    bool8 barrier;
+    u8 protectUses;
+    u16 lastMove;        // last move this Pokémon used (Mirror Move / Mimic read the foe's)
+    u16 lastKind;
+    // grid conditions
+    u16 stun;            // can't act or move (flinch, paralysis jolt)
+    u16 hold;            // can't move (trapping moves, Mean Look)
+    u16 invuln;          // can't be hit (Fly / Bounce / Dig / Dive wind-up)
+    u8 invulnKind;       // INVULN_AIR / INVULN_UNDERGROUND / INVULN_UNDERWATER (Gen 3 STATUS3_ON_AIR etc.)
+    bool8 noEscape;      // Mean Look / Spider Web: the player can't run
+    bool8 cursed;        // Ghost-type Curse: 1/4 per turn
+    u16 charging;        // frames left on a charge-up (Focus Punch fails if hit)
+    u16 chargeMove;
+    bool8 focusBroken;
+    u8 confTurns;        // Gen 3 confusion 2-5 turns
+    u8 trapTurns;        // Gen 3 wrap damage 2-5 turns (1/16 per turn)
+    u8 yawn;             // turns until Yawn's sleep
+    u8 mistTurns;
+    bool8 infatuated;
+    bool8 seeded;
+    bool8 nightmare;
+    bool8 safeguard;     // review: blocks the next status move
+    bool8 magicCoat;     // review: bounces the next status move back
+    bool8 focusEnergy;
+    bool8 chargeNext;    // Charge: next Electric move x2
+    bool8 lockOnNext;    // Lock-On: next attack becomes a lock-on
+    bool8 rooted;        // Ingrain
+    bool8 mudSport, waterSport;
+    bool8 defenseCurl;
+    bool8 recharge;      // review: can't pick chips at the next Custom
+    bool8 fakeOutReady;  // Fake Out only works right after coming in
+    u8 rolloutCount, furyCount;
+    u16 bideFrames;
+    u16 bideDamage;
+    u32 lastHitFrame;
+    u16 lastPhysDamage;
+    u8 typeOverride;     // Conversion
+    u16 icon[2][32 * 32];
+    char name[POKEMON_NAME_LENGTH + 1];
+};
+
+struct PartyMember
+{
+    struct BattlePokemon bm;
+    u16 icon[2][32 * 32];
+    char name[POKEMON_NAME_LENGTH + 1];
+    bool8 participated;
+};
+
+// An attack in flight / winding up / ticking.
+struct Attack
+{
+    bool8 active;
+    u8 side;
+    u16 move;
+    u8 kind;                 // GK_*
+    struct PkbnMoveInfo info;
+    struct BattlePokemon user;  // snapshot of the attacker at launch
+    char userName[POKEMON_NAME_LENGTH + 1];
+    u8 userSlot;             // party slot (player side), for Beat Up
+    u16 timer;               // frames until the next event
+    u16 duration;
+    u8 phase;
+    u8 hitsLeft;
+    u8 hitIndex;
+    s8 ox, oy;               // launch panel
+    s8 tx, ty;               // target / landing panel
+    s8 px, py, vx, vy;       // projectile position (panels) and direction
+    u8 step;                 // frames per panel for projectiles
+    u8 bounces;
+    bool8 hitDone;           // single-hit projectiles stop after a hit
+    bool8 hitAnything;
+    u16 powerOverride;
+    u8 typeOverride;
+    u8 cells[GRID_ROWS][GRID_COLS];  // panels threatened right now (telegraph / impact)
+};
+
+struct GridBattle
+{
+    u8 state;
+    u16 timer;
+    u32 frame;
+    struct Fighter f[2];
+    struct PartyMember party[PKBN_PARTY_MAX];
+    u8 partyCount;
+    u8 active;
+    struct Folder folder;
+    u8 hand[HAND_SIZE];
+    u8 handCount;
+    bool8 picked[HAND_SIZE];
+    bool8 wildPicked;          // the always-available wildcard Switch slot
+    u8 cursor;                 // 0..handCount-1 = hand, handCount = wildcard slot
+    u8 queue[HAND_SIZE + 1];   // folder chip indices; QUEUE_WILD = the wildcard slot
+    u8 queueCount;
+    u16 gauge, gaugeSub;
+    u16 turnClock;
+    u32 turn;
+    u16 busterCd;
+    struct Attack attacks[MAX_ATTACKS];
+    // panels
+    u8 panel[GRID_ROWS][GRID_COLS];
+    u16 panelTimer[GRID_ROWS][GRID_COLS];
+    u8 poisonTick[2];
+    // weather (Gen 3 gBattleWeather bits) and turns left
+    u16 weather;
+    u8 weatherTurns;
+    // Wish: heals whoever is in on that side when the next Custom opens
+    u16 wishHeal[2];
+    // picker
+    u8 pickPurpose;
+    u8 pickOptions[PKBN_PARTY_MAX];
+    u8 pickCount;
+    u8 pickCursor;
+    // time-stop
+    u8 tsKind;
+    u8 tsTarget;
+    bool8 tsKeepStages;
+    u16 tsMove;
+    u8 tsSlot;
+    // enemy AI
+    u16 aiStepTimer;
+    u16 aiAttackTimer;
+    // effects
+    u8 fx[GRID_ROWS][GRID_COLS];
+    char msg[40];
+    u16 msgTimer;
+    char banner[40];
+    u8 outcome;
+};
+
+enum { INVULN_NONE, INVULN_AIR, INVULN_UNDERGROUND, INVULN_UNDERWATER };
+enum { PH_CHARGE, PH_WAIT, PH_TRAVEL, PH_GAP, PH_UNDERGROUND }; // struct Attack phases
+
+extern struct GridBattle sB;
+
+// grid_battle.c
+void SetMsg(const char *text, u16 frames);
+bool8 InGrid(s32 c, s32 r);
+s8 Facing(u8 side);
+bool8 PartyAlive(u8 slot);
+void SyncActiveToParty(void);
+void BeginTimeStop(u8 kind, u8 target, bool8 keepStages);
+void OpenPicker(u8 purpose);
+void BeginAssist(void);
+
+// grid_moves.c
+void Moves_Use(u8 side, u16 move, u8 slot, const struct BattlePokemon *user, const char *userName, u8 userSlot);
+void Moves_Update(void);
+void Moves_Clear(void);
+bool8 Moves_SideHasPending(u8 side);
+bool8 Moves_PanelThreatened(u8 bySide, s8 x, s8 y);
+void Moves_DamageFighter(u8 side, s32 dmg, const char *why);
+void Moves_ApplyBuster(u8 side);
+s32 Moves_EffectiveSpeed(const struct Fighter *f);
+u8 Moves_KindOf(u16 move);
+bool8 Moves_IsPositionFree(u8 kind);
+
+// grid_field.c
+void Field_Init(void);
+void Field_Update(void);          // per fight frame: panels, poison, timers
+void Field_EndTurn(void);         // every CUSTOM_FRAMES of fight time
+bool8 Field_CanStand(u8 side, s8 x, s8 y);
+void Field_Step(u8 side, s8 nx, s8 ny);   // move a fighter (handles cracked panels)
+void Field_SetPanel(s8 x, s8 y, u8 type);
+bool8 Field_TryStatus(u8 targetSide, u8 fromSide, u16 move, u32 status1, bool8 viaMove);
+bool8 Field_TryConfuse(u8 targetSide, u8 fromSide, u16 move, bool8 viaMove);
+void Field_WakeOnHit(u8 side);
+bool8 Field_CanAct(u8 side, bool8 announce);
+bool8 Field_IsAsleep(u8 side);
+u8 Field_ApplyStatStage(u8 side, u8 stat, s8 delta, bool8 fromFoe);
+void Field_ResetFighterConditions(struct Fighter *f);
+void Field_PushBack(u8 side, u8 panels);
+const char *Field_StatName(u8 stat);
+
+// grid_draw.c
+void Draw_Overlay(u16 *fb);
+
+#endif // GUARD_PKBN_GRID_INTERNAL_H
