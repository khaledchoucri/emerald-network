+bool8 Moves_SideHasPending(u8 side)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+        if (sB.attacks[i].active && sB.attacks[i].side == side)
+            return TRUE;
+    return FALSE;
+}
+
+bool8 Moves_PanelThreatened(u8 bySide, s8 x, s8 y)
+{
+    s32 i;
+    for (i = 0; i < MAX_ATTACKS; i++)
+    {
+        const struct Attack *a = &sB.attacks[i];
+        if (!a->active || a->side != bySide || a->kind == GK_LOCKON)
+            continue;
+        if (a->cells[y][x])
+            return TRUE;
+        // a projectile coming down this row
+        if ((a->phase == PH_TRAVEL) && (a->py == y || (a->info.rows == 3 && a->kind != GK_BALL && a->kind != GK_DELAYED))
+         && ((bySide == SIDE_PLAYER) ? a->px <= x : a->px >= x)
+         && (a->kind == GK_BALL || a->kind == GK_WAVE || a->kind == GK_SHOCKWAVE || a->kind == GK_DELAYED))
+            return TRUE;
+    }
+    return FALSE;
+}
