From 7b5f0665127142dc68266f8b867cdf0eb10d9b59 Mon Sep 17 00:00:00 2001
From: Khaled <khaledchoucri@gmail.com>
Date: Sun, 4 Oct 2026 20:57:49 +0300
Subject: [PATCH] Window opens at 3x (720x480); PKBN_SCALE=N overrides

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FbWSqvcg6G5Gpw6ynvR5tJ
---
 src/platform/sdl2.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/platform/sdl2.c b/src/platform/sdl2.c
index 0826337..edacd0c 100644
--- a/src/platform/sdl2.c
+++ b/src/platform/sdl2.c
@@ -1,3 +1,4 @@
+#include <stdlib.h>
 #ifdef PLATFORM_SDL2
 #include <assert.h>
 #include <stdbool.h>
@@ -31,7 +32,7 @@ SDL_Texture *sdlTexture;
 SDL_sem *vBlankSemaphore;
 SDL_atomic_t isFrameAvailable;
 bool speedUp = false;
-unsigned int videoScale = 1;
+unsigned int videoScale = 3; // pkbn: window starts at 3x (720x480); PKBN_SCALE=N overrides
 bool videoScaleChanged = false;
 bool isRunning = true;
 bool paused = false;
@@ -77,6 +78,10 @@ int main(int argc, char **argv)
         return 1;
     }
 
+    // pkbn: PKBN_SCALE=N sets the starting window size (N x 240x160). The window can still be resized.
+    if (getenv("PKBN_SCALE") != NULL && atoi(getenv("PKBN_SCALE")) > 0)
+        videoScale = (unsigned int)atoi(getenv("PKBN_SCALE"));
+
     sdlWindow = SDL_CreateWindow("pokeemerald", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, DISPLAY_WIDTH * videoScale, DISPLAY_HEIGHT * videoScale, SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE);
     if (sdlWindow == NULL)
     {
