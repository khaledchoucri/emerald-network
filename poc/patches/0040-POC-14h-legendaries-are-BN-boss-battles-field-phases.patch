+// ---- Legendaries as BN boss battles (POC-14, our design - TUNE) -------------------------------------------------------
+// A BN boss reshapes the field on a rhythm and saves a big attack for when it's hurt. Each legendary here keeps its
+// Gen 3 stats and moves; on top it has a field phase every few seconds (announced first, so you can move) and a
+// signature Program Advance it fires below half HP and again below a quarter. The Regis stand still with Super Armor.
+enum { BOSS_CRACK, BOSS_TIDE, BOSS_FREEZE, BOSS_PA };
+struct BossDef
+{
+    u16 species;
+    u8 phase;
+    const char *phaseText;
+    const char *phasePA;      // BOSS_PA: the Program Advance the phase fires
+    const char *signature;    // below 1/2 and 1/4 HP
+    bool8 still;              // stands its ground (the Regis)
+};
+static const struct BossDef sBosses[] = {
+    { SPECIES_GROUDON,   BOSS_CRACK,  "GROUDON SPLITS THE GROUND!",  NULL,             "EARTH RENDER", FALSE },
+    { SPECIES_KYOGRE,    BOSS_TIDE,   "KYOGRE CALLS THE TIDE!",      NULL,             "TSUNAMI",      FALSE },
+    { SPECIES_RAYQUAZA,  BOSS_PA,     "RAYQUAZA DIVES!",             "DIVE BOMBER",    "DRAGON RUSH",  FALSE },
+    { SPECIES_REGIROCK,  BOSS_PA,     "REGIROCK: ROCK AVALANCHE!",   "ROCK AVALANCHE", NULL,           TRUE },
+    { SPECIES_REGICE,    BOSS_FREEZE, "REGICE FREEZES THE GROUND!",  NULL,             "GLACIAL TOMB", TRUE },
+    { SPECIES_REGISTEEL, BOSS_PA,     "REGISTEEL: IRON FIST!",       "IRON FIST",      NULL,           TRUE },
+    { SPECIES_LATIAS,    BOSS_PA,     "LATIAS: COSMIC DUET!",        "COSMIC DUET",    "DRAGON RUSH",  FALSE },
+    { SPECIES_LATIOS,    BOSS_PA,     "LATIOS: COSMIC DUET!",        "COSMIC DUET",    "DRAGON RUSH",  FALSE },
+    { SPECIES_DEOXYS,    BOSS_PA,     "DEOXYS: Z-PSI!",              "Z-PSI",          "COSMIC DUET",  FALSE },
+    { SPECIES_MEW,       BOSS_PA,     "MEW: Z-PSI!",                 "Z-PSI",          NULL,           FALSE },
+    { SPECIES_LUGIA,     BOSS_PA,     "LUGIA: GEYSER!",              "GEYSER",         "DIVE BOMBER",  FALSE },
+    { SPECIES_HO_OH,     BOSS_PA,     "HO-OH: SOLAR FLARE!",         "SOLAR FLARE",    "DIVE BOMBER",  FALSE },
+};
+#define BOSS_PHASE_FRAMES     540   // TUNE: 9 s of fight time; 6 s below half HP
+#define BOSS_PHASE_FRAMES_LOW 360
+#define BOSS_WARN_FRAMES      45    // TUNE: the announcement, then the phase lands
+
+static s8 PAByName(const char *name)
+{
+    s32 k;
+    if (name == NULL)
+        return -1;
+    for (k = 0; k < PKBN_PA_COUNT; k++)
+        if (strcmp(gPkbnProgramAdvances[k].name, name) == 0)
+            return k;
+    return -1;
+}
+
+static u8 BossOf(u16 species)
+{
+    u32 i;
+    for (i = 0; i < ARRAY_COUNT(sBosses); i++)
+        if (sBosses[i].species == species)
+            return i + 1;
+    return 0;
+}
+
