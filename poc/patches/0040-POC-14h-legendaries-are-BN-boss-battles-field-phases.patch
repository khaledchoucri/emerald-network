+            sB.aiFlags = AI_SCRIPT_CHECK_BAD_MOVE | AI_SCRIPT_TRY_TO_FAINT | AI_SCRIPT_CHECK_VIABILITY;
+            sB.bossTimer = BOSS_PHASE_FRAMES / 2;
