     sB.f[SIDE_ENEMY].x = 4;
@@ -1657,12 +1722,93 @@ static s8 RivalPA(const struct Fighter *e)
     return best;
 }
 
+static void BossPhaseLands(struct Fighter *e)
+{
+    const struct BossDef *b = &sBosses[sB.boss - 1];
+    s32 n, tries;
+    switch (b->phase)
+    {
+    case BOSS_CRACK:
+        // 3 of your panels crack; one already cracked breaks (never the one you stand on, never more than 3 holes)
+        for (n = 0, tries = 0; n < 3 && tries < 40; tries++)
+        {
+            s8 x = Random() % PLAYER_COLS, y = Random() % GRID_ROWS;
+            u8 holes = 0, r, c;
+            for (r = 0; r < GRID_ROWS; r++)
+                for (c = 0; c < PLAYER_COLS; c++)
+                    holes += sB.panel[r][c] == PANEL_BROKEN;
+            if (sB.panel[y][x] == PANEL_CRACKED && holes < 3 && (x != sB.f[SIDE_PLAYER].x || y != sB.f[SIDE_PLAYER].y))
+                Field_SetPanel(x, y, PANEL_BROKEN), n++;
+            else if (sB.panel[y][x] == PANEL_NORMAL)
+                Moves_ComboPanel(TYPE_GROUND, x, y), n++;
+        }
+        PlaySE(SE_M_EARTHQUAKE);
+        break;
+    case BOSS_TIDE:
+    {
+        // the row you're on becomes a current toward the foes: it carries you to your front column
+        s8 y = sB.f[SIDE_PLAYER].y, x;
+        for (x = 0; x < PLAYER_COLS; x++)
+            if (sB.panel[y][x] != PANEL_BROKEN)
+                Field_SetPanel(x, y, PANEL_ROAD_RIGHT);
+        PlaySE(SE_M_SURF);
+        break;
+    }
+    case BOSS_FREEZE:
+        for (n = 0, tries = 0; n < 3 && tries < 40; tries++)
+        {
+            s8 x = Random() % PLAYER_COLS, y = Random() % GRID_ROWS;
+            if (sB.panel[y][x] == PANEL_NORMAL)
+                Moves_ComboPanel(TYPE_ICE, x, y), n++;
+        }
+        PlaySE(SE_M_ICY_WIND);
+        break;
+    case BOSS_PA:
+    {
+        s8 pa = PAByName(b->phasePA);
+        if (pa >= 0)
+        {
+            EnemyLineUp(gPkbnProgramAdvances[pa].kind);
+            Moves_UsePA(SIDE_ENEMY, pa, &e->bm, e->name, 0);
+        }
+        break;
+    }
+    }
+    PKBN_LOG("boss phase: %s", b->phaseText);
+}
+
+// Per fight frame for a boss: the phase rhythm (time stops with the Custom screen, like everything else).
+static void BossFrame(void)
+{
+    struct Fighter *e = &sB.f[SIDE_ENEMY];
+    if (!sB.boss || e->bm.hp == 0)
+        return;
+    if (sB.bossPending)
+    {
+        if (--sB.bossPending == 0 && !BusyOrDisabled(SIDE_ENEMY))
+            BossPhaseLands(e);
+        return;
+    }
+    if (sB.bossTimer && --sB.bossTimer)
+        return;
+    sB.bossTimer = e->bm.hp <= e->bm.maxHP / 2 ? BOSS_PHASE_FRAMES_LOW : BOSS_PHASE_FRAMES;
+    if (Moves_SideHasPending(SIDE_ENEMY))
+    {
+        sB.bossTimer = 30;   // after its attack lands
+        return;
+    }
+    Flash(sBosses[sB.boss - 1].phaseText, BOSS_WARN_FRAMES + 30);
+    PlayCry_Normal(e->bm.species, 0);
+    sB.bossPending = BOSS_WARN_FRAMES;
+}
+
 static bool8 RivalSpecial(struct Fighter *e)
 {
     s8 pa;
-    u8 allowed = sB.rivalTier >= 5 ? 2 : sB.rivalTier >= 3 ? 1 : 0;
+    u8 allowed = sB.boss ? 2 : sB.rivalTier >= 5 ? 2 : sB.rivalTier >= 3 ? 1 : 0;
     u32 hpLine = e->paUses == 0 ? e->bm.maxHP / 2 : e->bm.maxHP / 4;
-    if (e->paUses >= allowed || e->bm.hp > hpLine || (pa = RivalPA(e)) < 0)
+    if (e->paUses >= allowed || e->bm.hp > hpLine
+     || (pa = sB.boss ? PAByName(sBosses[sB.boss - 1].signature) : RivalPA(e)) < 0)
         return FALSE;
     {
         char line[48];
@@ -1746,6 +1892,8 @@ static void UpdateOneEnemy(void)
         return;
     }
 
+    if (sB.boss && sBosses[sB.boss - 1].still)
+        return;   // a Regi stands its ground
     if (sB.aiStepTimer && --sB.aiStepTimer == 0 && !e->hold)
     {
         if (e->style)
@@ -2123,6 +2271,7 @@ static void UpdateFight(void)
     UpdateEnemy();
     if (sB.state != ST_FIGHT)
         return;
+    BossFrame();
     Moves_Update();
     CheckFaints();
 }
