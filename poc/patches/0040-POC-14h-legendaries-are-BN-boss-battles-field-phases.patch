 {
     s32 i;
@@ -798,6 +850,17 @@ static void Begin(void)
         sB.timeLimit = c->seconds * 60;
         PKBN_LOG("net challenge %u: %s, tier %u, %u at once, %u s", sB.challenge - 1, c->name, c->tier, c->together, c->seconds);
     }
+    else if (!sB.trainer && (gBattleTypeFlags & BATTLE_TYPE_LEGENDARY))
