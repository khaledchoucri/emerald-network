+#ifndef GUARD_PKBN_BUSTING_H
+#define GUARD_PKBN_BUSTING_H
+// Busting Level and Capture Grade (POC-10b): src/pkbn/busting.c, docs/design/09 and 10.
+
+struct PkbnBustStats
+{
+    u32 fightFrames;     // fight time (the Custom screen and time-stops don't count, as BN6's timer)
+    u16 hits;            // hits that stunned or pushed the player's Pokémon
+    u16 steps;           // panel moves by the player
+    u8 chainPts;         // best chain: 2 chips +2, 3 +4, Program Advance +6
+    u8 counters;         // counter hits landed
+    bool8 fainted;       // a player Pokémon fainted
+    u8 balls;            // balls thrown
+    bool8 prevStun;
+};
+
+void Busting_Reset(void);
+void Busting_OnFightFrame(void);
+void Busting_NotePush(void);
+void Busting_NoteStep(void);
+void Busting_NoteChain(u8 chips, bool8 programAdvance);
+void Busting_NoteCounter(void);
+void Busting_NoteFaint(void);
+void Busting_NoteThrow(void);
+u8 Busting_Level(void);                              // 1..11 (11 = S); logs both clocks
+void Busting_Reward(u8 level, char *msg, u32 size);  // grants it
+void Busting_ScaleExp(u8 level);
+u8 Capture_Grade(void);
+void Capture_Reward(u8 grade, char *msg, u32 size);
+#endif // GUARD_PKBN_BUSTING_H
