diff --git a/src/pkbn/leader.c b/src/pkbn/leader.c
new file mode 100644
index 0000000..d22f105
--- /dev/null
+++ b/src/pkbn/leader.c
@@ -0,0 +1,140 @@
+// Leader chips and rematch time attacks (POC-14, our design after BN's Navi chips - TUNE).
+//
+// BN gives a boss Navi as a chip when you delete it (ProtoMan V1), and better versions (V2, V3) for deleting it again
+// fast. Here each Gym Leader gives a Leader chip the first time you win: it calls the Leader's ace in for one big
+// attack. Winning with Busting Level 9+ makes it V2, an S on a rematch V3 (power x1.0 / x1.3 / x1.6, the partner chip
+// scale). Leader chips count as MegaChips (BN Navi chips are MegaChips) and join the folder like partner chips.
+// Every Leader battle also keeps a record: the best fight time and Busting Level, and a new record pays a chip.
+#include "global.h"
+#include "data.h"
+#include "pokemon.h"
+#include "battle.h"
+#include "pkbn/leader.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/folder.h"
+#include "pkbn/move_table.h"
+#include "constants/opponents.h"
+#include "constants/trainers.h"
+#include "constants/moves.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+static const u16 sFirst[PKBN_LEADERS] = {
+    TRAINER_ROXANNE_1, TRAINER_BRAWLY_1, TRAINER_WATTSON_1, TRAINER_FLANNERY_1,
+    TRAINER_NORMAN_1, TRAINER_WINONA_1, TRAINER_TATE_AND_LIZA_1, TRAINER_JUAN_1 };
+static const char *const sNames[PKBN_LEADERS] = {
+    "ROXANNE", "BRAWLY", "WATTSON", "FLANNERY", "NORMAN", "WINONA", "TATE&LIZA", "JUAN" };
+static const char sCodes[PKBN_LEADERS] = { 'R', 'B', 'W', 'F', 'N', 'W', 'T', 'J' };   // their initials
+
+s8 Leader_FromTrainer(u16 id)
+{
+    if (id >= TRAINER_ROXANNE_1 && id <= TRAINER_JUAN_1)
+        return id - TRAINER_ROXANNE_1;
+    if (id >= TRAINER_ROXANNE_2 && id <= TRAINER_JUAN_5)
+        return (id - TRAINER_ROXANNE_2) / 4;   // _2.._5 for each Leader in order (include/constants/opponents.h)
+    return -1;
+}
+
+bool8 Leader_IsRematch(u16 id)
+{
+    return id >= TRAINER_ROXANNE_2 && id <= TRAINER_JUAN_5;
+}
+
+char Leader_Code(u8 leader)
+{
+    return sCodes[leader & 7] - 'A';
+}
+
+const char *Leader_Name(u8 leader)
+{
+    return sNames[leader & 7];
+}
+
+// The ace: the last Pokémon of the Leader's first battle; its move: the strongest one of its own type
+// (the strongest of all if none), from the Leader's real moveset (src/data/trainer_parties.h).
+void Leader_Ace(u8 leader, u16 *species, u8 *level, u16 *move)
+{
+    const struct Trainer *t = &gTrainers[sFirst[leader & 7]];
+    u8 last = t->partySize - 1, i;
+    u16 best = 0;
+    const u16 *moves = NULL;
+    *move = MOVE_TACKLE;
+    switch (t->partyFlags)
+    {
+    case F_TRAINER_PARTY_CUSTOM_MOVESET:
+        *species = t->party.NoItemCustomMoves[last].species, *level = t->party.NoItemCustomMoves[last].lvl;
+        moves = t->party.NoItemCustomMoves[last].moves;
+        break;
+    case F_TRAINER_PARTY_CUSTOM_MOVESET | F_TRAINER_PARTY_HELD_ITEM:
+        *species = t->party.ItemCustomMoves[last].species, *level = t->party.ItemCustomMoves[last].lvl;
+        moves = t->party.ItemCustomMoves[last].moves;
+        break;
+    case F_TRAINER_PARTY_HELD_ITEM:
+        *species = t->party.ItemDefaultMoves[last].species, *level = t->party.ItemDefaultMoves[last].lvl;
+        break;
+    default:
+        *species = t->party.NoItemDefaultMoves[last].species, *level = t->party.NoItemDefaultMoves[last].lvl;
+        break;
+    }
+    if (moves == NULL)
+        return;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 m = moves[i], score;
+        bool8 stab = gBattleMoves[m].type == gSpeciesInfo[*species].types[0]
+                  || gBattleMoves[m].type == gSpeciesInfo[*species].types[1];
+        if (!PkbnFolder_MoveIsChip(m) || gBattleMoves[m].power <= 1)
+            continue;
+        score = (stab ? 256 : 0) + gBattleMoves[m].power;
+        if (score > best)
+            best = score, *move = m;
+    }
+}
+
+void Leader_AfterWin(u16 trainerId, u8 bust, u32 frames, char *line1, char *line2, u32 size)
+{
+    s8 l = Leader_FromTrainer(trainerId);
+    u8 have, want;
+    u16 bestF;
+    u8 bestL;
+    line1[0] = line2[0] = '\0';
+    if (l < 0)
+        return;
+    // the chip: V1 for any win, V2 with Busting Level 9+, V3 with an S on a rematch
+    have = PkbnLeader_Chip(l);
+    want = (bust >= 11 && Leader_IsRematch(trainerId)) ? 3 : bust >= 9 ? 2 : 1;
+    if (want > have)
+    {
+        PkbnLeader_SetChip(l, want);
+        snprintf(line1, size, have ? "%s CHIP UPGRADED TO V%u!" : "GOT %s'S LEADER CHIP V%u!", sNames[l], want);
+        printf("[pkbn] leader chip: %s V%u\n", sNames[l], want);
+    }
+    // the record: best time, then best level
+    PkbnLeader_Record(l, &bestF, &bestL);
+    if (frames > 0xFFFF)
+        frames = 0xFFFF;
+    if (bestF == 0 || frames < bestF || (frames == bestF && bust > bestL))
+    {
+        u16 species, mv;
+        u8 lv;
+        u32 s10 = frames * 10 / 60;   // tenths of a second
+        PkbnLeader_SetRecord(l, frames, bust > bestL ? bust : bestL);
+        Leader_Ace(l, &species, &lv, &mv);
+        if (bestF)
+        {
+            PkbnPack_Add(mv, LETTER_WILD, 1);   // a new record pays a * copy of the ace's move
+            snprintf(line2, size, "NEW RECORD %u:%02u.%u! GOT A * CHIP!", (unsigned)(s10 / 600), (unsigned)(s10 / 10 % 60),
+                     (unsigned)(s10 % 10));
+        }
+        else
+            snprintf(line2, size, "TIME %u:%02u.%u - THE RECORD TO BEAT", (unsigned)(s10 / 600), (unsigned)(s10 / 10 % 60),
+                     (unsigned)(s10 % 10));
+        printf("[pkbn] leader record: %s %u frames, level %u\n", sNames[l], (unsigned)frames, bust);
+    }
+    else if (bust > bestL)
+        PkbnLeader_SetRecord(l, bestF, bust);
+}
+
+#endif // PORTABLE
