--- /dev/null
+++ b/include/pkbn/leader.h
@@ -0,0 +1,18 @@
+#ifndef GUARD_PKBN_LEADER_H
+#define GUARD_PKBN_LEADER_H
+// Leader chips and rematch records (POC-14): src/pkbn/leader.c
+#include "global.h"
+
+// A Leader chip in the folder: owner CHIP_SHARED, slot = LEADER_CHIP | level << 4 | leader
+#define LEADER_CHIP 0x80
+#define LEADER_INDEX(slot) ((slot) & 7)
+#define LEADER_LEVEL(slot) (((slot) >> 4) & 3)
+
+s8 Leader_FromTrainer(u16 trainerId);              // 0-7 for a Gym Leader (first battle or rematch), else -1
+bool8 Leader_IsRematch(u16 trainerId);
+void Leader_Ace(u8 leader, u16 *species, u8 *level, u16 *move);   // the ace a Leader chip calls in, and its move
+char Leader_Code(u8 leader);                       // 0-25
+const char *Leader_Name(u8 leader);
+// After a won Gym Leader battle: chip and record. Writes up to two lines of post-battle text (empty if none).
+void Leader_AfterWin(u16 trainerId, u8 bustingLevel, u32 fightFrames, char *line1, char *line2, u32 size);
+#endif // GUARD_PKBN_LEADER_H
