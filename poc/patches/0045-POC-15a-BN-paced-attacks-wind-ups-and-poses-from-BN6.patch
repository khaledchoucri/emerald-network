+// PKBN_GALLERY="m,m,...|all" (POC-15): each move in turn, used by the player (or the foe with PKBN_GALLERY_SIDE=enemy)
+// on a fixed stage; PKBN_GALLERY_FRAMES frames each (default 150), every PKBN_DUMP_EVERY-th dumped as g_MOVE_TTT.ppm.
+static u16 sGalMoves[MOVES_COUNT], sGalCount, sGalIdx, sGalT, sGalLen = 150;
+static u8 sGalSide;
+static void (*sGalInner)(u16 *fb);
+static void GalleryOverlay(u16 *fb)
+{
+    sGalInner(fb);
+    if (sDumpDir != NULL && sGalIdx < sGalCount && sGalT > 0 && (sGalT - 1) % sDumpEvery == 0)
+    {
+        char path[512];
+        FILE *f;
+        s32 i;
+        snprintf(path, sizeof(path), "%s/g_%03u_%03u.ppm", sDumpDir, (unsigned)sGalMoves[sGalIdx], (unsigned)(sGalT - 1));
+        f = fopen(path, "wb");
+        if (f == NULL)
+            return;
+        fprintf(f, "P6\n%d %d\n255\n", (int)gPkbnFbW, (int)gPkbnFbH);
+        for (i = 0; i < gPkbnFbW * gPkbnFbH; i++)
+        {
+            u16 c = fb[i];
+            u8 rgb[3] = { (u8)((c & 31) << 3), (u8)(((c >> 5) & 31) << 3), (u8)(((c >> 10) & 31) << 3) };
+            fwrite(rgb, 1, 3, f);
+        }
+        fclose(f);
+    }
+}
+
+static void CB2_Gallery(void)
+{
+    struct PkbnGridDebug d;
+    PkbnGrid_GetDebug(&d);
+    gMain.newKeys = gMain.heldKeys = 0;
+    if (d.state == PKBN_GRID_CUSTOM && (d.frame & 1))
+        gMain.newKeys = START_BUTTON;   // close the Custom screen
+    CB2_PkbnGridBattle();
+    if (gPkbnCanvasOverlay != NULL && gPkbnCanvasOverlay != GalleryOverlay)
+    {
+        sGalInner = gPkbnCanvasOverlay;
+        gPkbnCanvasOverlay = GalleryOverlay;
+    }
+    if (d.state != PKBN_GRID_FIGHT && sGalT == 0)
+        return;
+    if (sGalT == 0)
+    {
+        printf("[pkbn-gallery] move %u kind %u type %u\n", sGalMoves[sGalIdx], gPkbnMoveInfo[sGalMoves[sGalIdx]].kind,
+               gBattleMoves[sGalMoves[sGalIdx]].type);
+        PkbnGrid_GalleryStage(sGalMoves[sGalIdx], sGalSide);
+    }
+    if (++sGalT > sGalLen)
+    {
+        sGalT = 0;
+        if (++sGalIdx >= sGalCount)
+        {
+            printf("[pkbn-gallery] done: %u moves\n", sGalCount);
+            fflush(stdout);
+            exit(0);
+        }
+    }
+}
