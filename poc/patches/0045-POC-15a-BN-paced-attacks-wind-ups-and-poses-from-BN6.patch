+// How long the strike pose holds after the attack leaves (the rest of MegaMan's BN6 animation after its action frame,
+// battleSpriteMegaMan.spr: cannon 29 - 14, sword 22 - 12, throw 22 - 9 (anim 6), cast 16 - 6). POC-15.
+static u8 PoseHold(u8 kind)
+{
+    switch (kind)
+    {
+    case GK_CANNON: case GK_AIRSHOT: case GK_SPREADER: case GK_VULCAN: case GK_LOCKON:
+        return 15;
+    case GK_BOMB:
+        return 13;
+    default:
+        return 10;
+    }
+}
