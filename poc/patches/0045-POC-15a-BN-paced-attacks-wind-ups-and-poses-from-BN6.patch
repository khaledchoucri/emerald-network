+// ---- Chip gallery (POC-15 visual review) ----------------------------------------------------------------------------
+// PKBN_GALLERY (src/pkbn/selftest.c): every chip's animation on the same stage - the user at (1,1), the foe at (4,1),
+// both at full HP, a clean field - so each move can be looked at frame by frame. The foe doesn't act and nobody faints.
+bool8 gPkbnGallery;
+
+void PkbnGrid_GalleryStage(u16 move, u8 side)
+{
+    s32 i;
+    Moves_Clear();
+    Field_Init();
+    for (i = 0; i < 2; i++)
+    {
+        struct Fighter *f = &sB.f[i];
+        s32 st;
+        Field_ResetFighterConditions(f);
+        f->x = i == SIDE_PLAYER ? 1 : 4;
+        f->y = 1;
+        f->bm.hp = f->bm.maxHP;
+        f->bm.status1 = 0;
+        f->bm.status2 = 0;
+        for (st = 0; st < NUM_BATTLE_STATS; st++)
+            f->bm.statStages[st] = DEFAULT_STAT_STAGE;
+        f->lockout = f->iframes = f->hurtFlash = f->statusFlash = f->stun = f->hold = f->invuln = 0;
+        f->charging = f->chargeMove = 0;
+        f->moveCd = 0;
+        f->barrier = f->recharge = f->safeguard = f->magicCoat = FALSE;
+        f->slideDx = f->slideDy = 0;
+        f->confTurns = f->trapTurns = 0;
+        f->bideFrames = 0;
+        f->rolloutCount = f->furyCount = 0;
+    }
+    sB.f[side].bm.pp[0] = 30;
+    sB.f[side].bm.moves[0] = move;
+    if (side == SIDE_PLAYER)
+        sB.party[sB.active].bm.hp = sB.f[SIDE_PLAYER].bm.hp;
+    Moves_Use(side, move, 0, &sB.f[side].bm, sB.f[side].name, side == SIDE_PLAYER ? sB.active : 0);
+}
