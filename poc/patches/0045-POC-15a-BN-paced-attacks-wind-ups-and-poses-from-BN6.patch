+static s32 Sin256(s32 a)   // a: 0..255 = one turn; result -256..256
+{
+    static const s16 sQ[17] = { 0, 25, 50, 74, 98, 121, 142, 162, 181, 198, 213, 226, 237, 245, 251, 255, 256 };
+    a &= 255;
+    if (a < 64)  return sQ[a / 4];
+    if (a < 128) return sQ[(128 - a) / 4];
+    if (a < 192) return -sQ[(a - 128) / 4];
+    return -sQ[(256 - a) / 4];
+}
+static s32 Cos256(s32 a) { return Sin256(a + 64); }
