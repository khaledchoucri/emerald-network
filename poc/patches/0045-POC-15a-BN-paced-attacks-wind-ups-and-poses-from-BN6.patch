+static u8 StrikeOf(u16 move)
+{
+    if (InMoves(move, sStrikeClaw, ARRAY_COUNT(sStrikeClaw))) return STRIKE_CLAW;
+    if (InMoves(move, sStrikeBite, ARRAY_COUNT(sStrikeBite))) return STRIKE_BITE;
+    if (InMoves(move, sStrikeBlow, ARRAY_COUNT(sStrikeBlow))) return STRIKE_BLOW;
+    if (InMoves(move, sStrikeStab, ARRAY_COUNT(sStrikeStab))) return STRIKE_STAB;
+    if (InMoves(move, sStrikeWhip, ARRAY_COUNT(sStrikeWhip))) return STRIKE_WHIP;
+    if (InMoves(move, sStrikeBody, ARRAY_COUNT(sStrikeBody))) return STRIKE_BODY;
