+// ---- Visual events and BN pacing (POC-15) --------------------------------------------------------------------------
+
+bool8 gPkbnNoWindup;   // PKBN_NO_WINDUP=1: the POC-14 timing (attacks leave at once)
+
+void Vis_Post(u8 ev, u8 side, u16 move, u8 kind, s8 arg, s8 x, s8 y)
+{
+    struct VisEvent *e = &sB.visEv[sB.visSerial % MAX_VIS_EVENTS];
+    sB.visSerial++;
+    e->serial = sB.visSerial;
+    e->ev = ev;
+    e->side = side;
+    e->foe = side == SIDE_ENEMY ? sB.cur : 0;
+    e->kind = kind;
+    e->move = move;
+    e->arg = arg;
+    e->x = x;
+    e->y = y;
+}
+
+// The user's wind-up before an attack leaves, as BN6 paces it. BN6's attack routines start one of MegaMan's battle
+// animations and act on a frame counter (frame delays read from data/sprites/battleSpriteMegaMan.spr; which animation
+// is which was identified by rendering their frames):
+//  - cannons: animation 8 (delays 1,2,2,9,1,1,1,12), the arm cannon is out by frame 5 and fires at frame 14; the one
+//    routine that plays it (asm/asm31.s sub_80EBC28) acts at counter 8 and 15.
+//  - swords: animation 5 (8,2,2,10), the swing frame starts at 12; its routines (sub_80EB862, sub_80EE1AC ...) act at
+//    counter 12.
+//  - throws: animation 6, the bomb leaves at counter 9 (sub_80EB644).
+//  - pointing / casting: animation 12 (2,2,2,10), the arm is out at frame 6.
