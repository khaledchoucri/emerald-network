+// Visual events (POC-15): the rules post what happened, the drawing code plays it. Visual only.
+enum { VEV_USE, VEV_LAUNCH, VEV_PUSH, VEV_STAT };
+struct VisEvent
+{
+    u32 serial;
+    u8 ev;
+    u8 side;
+    u8 foe;          // enemy side: which foe (sB.cur)
+    u8 kind;         // VEV_USE: GK_* ; VEV_LAUNCH: attack slot
+    u16 move;
+    s8 arg;          // VEV_USE: wind-up frames; VEV_PUSH: panels moved (signed); VEV_STAT: stages (+/-)
+    s8 x, y;         // VEV_PUSH: where it was before
+};
+#define MAX_VIS_EVENTS 16
