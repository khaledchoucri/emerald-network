+// A close-range strike landing on a panel (x, y = the panel's feet point), facing `flip`.
+static void Strike(u16 move, u8 type, s32 x, s32 y, u32 flip, bool8 wide)
+{
+    u16 tc = Vfx_TypeColor(type);
+    u32 tint = type == TYPE_NORMAL ? 0 : GFX_TINT;
+    struct Particle *p;
+    switch (StrikeOf(move))
+    {
+    case STRIKE_CLAW:
+        Fx(FX_CLAW, VFX_LAYER_AIR, x, y - 18, flip | tint, tc, 7, 18);
+        break;
+    case STRIKE_BITE:
+        if ((p = Spawn(P_JAWS, VFX_LAYER_AIR, x, y - 20)) != NULL)
+        {
+            p->life = 20;
+            p->color = type == TYPE_NORMAL ? PKBN_RGB(28, 10, 10) : tc;
+        }
+        Shake(3, 1);
+        break;
+    case STRIKE_BLOW:
+        // a fist or foot: BN's hit flash, a white impact ring and the type's own burst
+        Fx(FX_HIT, VFX_LAYER_AIR, x, y - 18, tint, tc, 6, 18);
+        if ((p = Spawn(P_RING, VFX_LAYER_AIR, x, y - 18)) != NULL)
+        {
+            p->life = 12;
+            p->value = 14;
+            p->color = PKBN_RGB(31, 31, 31);
+        }
+        TypeBurst(type, x, y, FALSE);
+        Shake(4, 1);
+        return;
+    case STRIKE_STAB:
+        if ((p = Fx(FX_SPIKE, VFX_LAYER_AIR, x - (flip ? -10 : 10), y - 18, flip | tint, tc, 6, 16)) != NULL)
+            p->vx = flip ? -24 : 24;
+        break;
+    case STRIKE_WHIP:
+        Fx(FX_SLASH_ARC, VFX_LAYER_AIR, x, y - 14, flip | GFX_TINT, tc, 10, 0);
+        break;
+    case STRIKE_BODY:
+        Fx(FX_HIT_STAR, VFX_LAYER_AIR, x, y - 16, tint, tc, 6, 18);
+        Fx(FX_DUST, VFX_LAYER_GROUND, x, y - 2, 0, 0, 0, 0);
+        Shake(5, 2);
+        TypeBurst(type, x, y, FALSE);
+        return;
+    default:
+        // a blade: BN's slash, tinted strongly enough to show the type
+        Fx(wide ? FX_SLASH_ARC : FX_SLASH, VFX_LAYER_AIR, x, y - (wide ? 14 : 16), flip | tint, tc, 10, 0);
+        break;
+    }
+    TypeBurst(type, x, y, FALSE);
+}
