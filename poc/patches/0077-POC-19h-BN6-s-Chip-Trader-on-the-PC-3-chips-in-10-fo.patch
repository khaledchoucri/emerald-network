+// ---- POC-19: Chip Trader (BN6) ----------------------------------------------------------------------------------
+static u8 FreeCopies(u16 row)
+{
+    u16 mv = sF.pack[row].move;
+    u8 l = sF.pack[row].letter, have = PkbnPack_Get(mv, l), used = sF.edited ? InFolder(mv, l) : 0;
+    return have > used ? have - used : 0;   // (an auto-built folder just builds from what's left)
+}
+
+static void DoTrade(void)
+{
+    u16 i, mv;
+    u8 l;
+    for (i = 0; i < sF.packCount; i++)
+        if (sF.mark[i])
+            PkbnPack_Add(sF.pack[i].move, sF.pack[i].letter, -(s32)sF.mark[i]);
+    if (!PkbnChipTrader_Roll(sF.need == 10, &mv, &l))
+        return;
+    PkbnPack_Add(mv, l, 1);
+    sF.gotMove = mv, sF.gotLetter = l, sF.gotT = 1;
+    memset(sF.mark, 0, sizeof(sF.mark));
+    sF.marked = 0;
+    BuildPack();
+    PlaySE(SE_BALL_TRAY_ENTER);   // BN6: "Click-k-k-k...THUNK!"
+}
+
+static bool8 TraderInput(u16 keys, u16 *cur, u16 n)
+{
+    if (sF.gotT)
+    {
+        if (keys & (A_BUTTON | B_BUTTON | START_BUTTON))
+            sF.gotT = 0, PlaySE(SE_SELECT);   // (the next trade)
+        return TRUE;
+    }
+    keys &= ~(L_BUTTON | R_BUTTON);
+    if ((keys & A_BUTTON) && n)
+    {
+        u16 r = Raw(*cur);
+        if (sF.mark[r] < FreeCopies(r) && sF.marked < sF.need)
+            sF.mark[r]++, sF.marked++, PlaySE(SE_SELECT);
+        else if (sF.mark[r])
+            sF.marked -= sF.mark[r], sF.mark[r] = 0, PlaySE(SE_RG_BAG_CURSOR);
+        else
+            PlaySE(SE_FAILURE);
+        return TRUE;
+    }
+    if ((keys & SELECT_BUTTON) && PkbnChipTrader_Special())
+    {
+        sF.need = sF.need == 3 ? 10 : 3;
+        memset(sF.mark, 0, sizeof(sF.mark));
+        sF.marked = 0;
+        PlaySE(SE_SELECT);
+        return TRUE;
+    }
+    if (keys & START_BUTTON)
+    {
+        if (sF.marked == sF.need)
+            DoTrade();
+        else
+            PlaySE(SE_FAILURE);
+        return TRUE;
+    }
+    return FALSE;   // moving, filters, B: as on the PACK page
+}
+
 static void HandleInput(u16 keys)
 {
     u16 n, *cur = &sF.cursor[sF.page];
     RebuildMap();
     n = RowCount();
+    if (sF.trader && TraderInput(keys, cur, n))
+        return;
     if (sF.menu)
     {
         if (keys & DPAD_UP)
@@ -1407,6 +1539,16 @@ void PkbnChipShelf_Open(MainCallback exitCallback)
     SetMainCallback2(CB2_Folder);
 }
 
