+// POC-19: BN6's Chip Trader (Khaled's pick) - chips in, one random chip out. The screen is the FOLDER screen's PACK page
+// in trader mode (src/pkbn/folder_ui.c PkbnChipTrader_Open); the roll is here.
+//
+// BN6 (bn6f, read by a research pass):
+//  - "It's a Chip Trader. Insert 3 BtlChips?" / "Chip Trader Special! Insert 10 BtlChips?"
+//    (data/textscript/TextScriptChipTrader86C580C.s:6-7, 215-216). The chips put in don't affect the reward
+//    (sub_804A970, asm/asm03_2.s:7692; sub_804BD00, :8970): 3 or 10 in, one out.
+//  - The roll (sub_804BD00, :8970-9015): 75% / 25% between two groups of the trader's list by a per-chip flag
+//    (EVENT_1E20 + chip, meaning UNVERIFIED - here: chips you have had before / never had, by the Library); a rarity
+//    0-4 by weights ({0x70,0x60,0x18,0x10,0x08} for the first trader, byte_804B00C); the first non-empty rarity; one chip
+//    of it at random (sub_804BE88, :9139).
+//  - Redraw (chipTraderRedrawChance_804BEEC, :9171): rarity 3+ is rerolled flat over the whole list with a chance by the
+//    copies you own: 0 -> ~0, 1 -> 25%, 2 -> 50%, 3 -> 62.5%, 4+ -> 75% (off_804B048).
+//  - The code (sub_804BF18, :9288): 75% a code you don't own, 25% one you do ("75% new code 25% old code", :9331).
+// Ours (TUNE): BN6's list is per machine; here it is every chip move up to an MB cap that grows with badges, rarity by
+// MB, no Giga or Mega chips. The Special trader's weights aren't decoded (byte_804B011): ours lean rarer.
+#include <stdlib.h>
+#include "global.h"
+#include "random.h"
+#include "event_data.h"
+#include "constants/flags.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/folder.h"
+#include "pkbn/move_table.h"
+#include "pkbn/grid_internal.h"
+#include <stdio.h>
+
+#ifdef PORTABLE
+
+static const u8 sWeights[2][5] = {
+    { 0x70, 0x60, 0x18, 0x10, 0x08 },   // BN6 byte_804B00C (asm/asm03_2.s)
+    { 0x40, 0x50, 0x38, 0x20, 0x10 },   // the Special trader: ours (TUNE)
+};
+static const u8 sRedraw[5] = { 1, 64, 128, 160, 192 };   // /256, by copies owned (BN6 off_804B048)
+
+static u8 Badges(void)
+{
+    s32 b, n = 0;
+    for (b = 0; b < PKBN_LEADERS; b++)
+        n += FlagGet(FLAG_BADGE01_GET + b) ? 1 : 0;
+    return n;
+}
+
+// The Special trader (10 in) opens with the 5th badge (ours, TUNE; BN6 has its own machine).
+bool8 PkbnChipTrader_Special(void)
+{
+    return Badges() >= 5 || getenv("PKBN_TEST_TRADER_SP") != NULL;
+}
+
+u8 PkbnChipTrader_MBCap(bool8 special)
+{
+    return 24 + 6 * Badges() + (special ? 15 : 0);   // TUNE
+}
+
+static u8 Rarity(u16 mv)
+{
+    u8 mb = Chip_MB(mv);
+    return mb <= 12 ? 0 : mb <= 20 ? 1 : mb <= 30 ? 2 : mb <= 40 ? 3 : 4;
+}
+
+static bool8 InPool(u16 mv, u8 cap)
+{
+    return PkbnFolder_MoveIsChip(mv) && gPkbnMoveInfo[mv].laneCount && Chip_MB(mv) <= cap
+        && Chip_Class(mv) == CHIP_STANDARD;
+}
+
+static u8 WeightedPick(const u8 *w, u8 n)
+{
+    s32 i, sum = 0, r;
+    for (i = 0; i < n; i++)
+        sum += w[i];
+    r = Random() % (sum ? sum : 1);
+    for (i = 0; i < n; i++)
+        if ((r -= w[i]) < 0)
+            return i;
+    return n - 1;
+}
+
+// A random chip of the pool: from group (0: had before, 1: never had; -1: either), rarity (-1: any).
+static u16 PickMove(u8 cap, s32 group, s32 rarity)
+{
+    u16 mv, n = 0, k;
+    for (mv = 1; mv < MOVES_COUNT; mv++)
+        if (InPool(mv, cap) && (group < 0 || PkbnLibrary_Has(mv) == (group == 0)) && (rarity < 0 || Rarity(mv) == rarity))
+            n++;
+    if (n == 0)
+        return MOVE_NONE;
+    k = Random() % n;
+    for (mv = 1; mv < MOVES_COUNT; mv++)
+        if (InPool(mv, cap) && (group < 0 || PkbnLibrary_Has(mv) == (group == 0)) && (rarity < 0 || Rarity(mv) == rarity))
+            if (k-- == 0)
+                return mv;
+    return MOVE_NONE;
+}
+
+static u8 PickCode(u16 mv)
+{
+    const struct PkbnMoveInfo *in = &gPkbnMoveInfo[mv];
+    u8 fresh[4], old[4], nf = 0, no = 0, k;
+    for (k = 0; k < in->laneCount && k < 4; k++)
+    {
+        if (PkbnPack_Get(mv, in->lanes[k]))
+            old[no++] = in->lanes[k];
+        else
+            fresh[nf++] = in->lanes[k];
+    }
+    if (nf && (!no || Random() % 4 != 0))   // 75% a new code (BN6 byte_804B068 {0xC0, 0x40})
+        return fresh[Random() % nf];
+    return no ? old[Random() % no] : in->lanes[0];
+}
+
+bool8 PkbnChipTrader_Roll(bool8 special, u16 *outMove, u8 *outLetter)
+{
+    u8 cap = PkbnChipTrader_MBCap(special), r, k;
+    s32 group = Random() % 4 == 0 ? 1 : 0;   // BN6 dword_804B008 {0xC0, 0x40}
+    u16 mv = MOVE_NONE;
+    if (PickMove(cap, group, -1) == MOVE_NONE)
+        group = !group;
+    r = WeightedPick(sWeights[special ? 1 : 0], 5);
+    for (k = 0; k < 5 && mv == MOVE_NONE; k++)   // the first rarity that has chips, down then up
+        mv = PickMove(cap, group, r >= k ? r - k : k);
+    if (mv == MOVE_NONE)
+        mv = PickMove(cap, -1, -1);
+    if (mv == MOVE_NONE)
+        return FALSE;
+    if (Rarity(mv) >= 3)
+    {
+        u16 owned = PkbnPack_Total(mv);
+        if (Random() % 256 < sRedraw[owned > 4 ? 4 : owned])
+            mv = PickMove(cap, -1, -1);   // BN6: a flat pick over the whole list
+    }
+    *outMove = mv;
+    *outLetter = PickCode(mv);
+    printf("[pkbn] chip trader (%s): move %u code %u (MB %u, cap %u)\n", special ? "special" : "3", mv, *outLetter,
+           Chip_MB(mv), cap);
+    return TRUE;
+}
+
+#endif // PORTABLE
