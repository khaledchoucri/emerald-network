diff --git a/src/pkbn/tutorial.c b/src/pkbn/tutorial.c
new file mode 100644
index 0000000..10c63bb
--- /dev/null
+++ b/src/pkbn/tutorial.c
@@ -0,0 +1,437 @@
+// POC-18: lessons for players new to Battle Network. include/pkbn/tutorial.h.
+//
+// Grounding: BN6 teaches its battle system in its first three battles. Lan and MegaMan talk through each part of the
+// Custom screen and the field, and the battle waits until the player does each thing (BATTLE_MODE_TUTORIAL_1-3,
+// bn6f constants/enums/battle_constants.inc:32-34; the lines are in data/textscript/TextScriptBattleTut1.s,
+// TextScriptBattleTutAreaGrab.s and TextScriptBattleTutFullSynchro.s). The order of the first lesson follows
+// TextScriptBattleTut1: the Custom Window, the chips, a chip's data and Attack, the virus's HP, picking chips that go
+// together (and B to take one back when it's wrong), OK, then moving, the buster, the chips above MegaMan's head, A,
+// once each, and the Custom Gauge with L or R. Here Prof. Birch speaks: he is the one in trouble in Emerald's first
+// battle. The words are ours (Khaled picked "Birch talks you through it"); everything else on screen stays
+// show-don't-tell.
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "main.h"
+#include "sound.h"
+#include "event_data.h"
+#include "constants/songs.h"
+#include "constants/flags.h"
+#include "pkbn/grid_internal.h"
+#include "pkbn/tutorial.h"
+#include "pkbn/replay.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/move_table.h"
+#include "pkbn/folder.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#ifdef PORTABLE
+
+enum { W_A, W_PICK2, W_PICK1, W_OK, W_MOVE, W_BUSTER, W_CHIP };
+
+struct TutLine { const char *text; u8 target; u8 wait; };
+
+// The rescue (BN6 TextScriptBattleTut1's order). "%c" is the letter of the pair in hand.
+static const struct TutLine sBasics[] = {
+    { "Quick! Your POKEMON fights with its moves. Here, they're CHIPS!", TT_HAND, W_A },
+    { "These are the chips you can send this turn.", TT_HAND, W_A },
+    { "Up here: what the chip does, and how many are left.", TT_INFO, W_A },
+    { "And that's the ZIGZAGOON. Knock its HP down to 0!", TT_FOE_HP, W_A },
+    { "Chips with the same letter go together. Pick both %c chips with A!", TT_HAND, W_PICK2 },
+    { "Now send them! Pick OK.", TT_OK, W_OK },
+    { "Move with the +Control Pad. Your panels are the red ones.", TT_PLAYER, W_MOVE },
+    { "B fires your BUSTER. Hold it to keep firing!", TT_PLAYER, W_BUSTER },
+    { "Your chips ride above your POKEMON. A uses the front one!", TT_HEAD, W_CHIP },
+    { "Each chip works once. When the CUSTOM gauge up here fills...", TT_GAUGE, W_A },
+    { "...press L or R for more chips. Now, help me!", TT_GAUGE, W_A },
+};
+#define BASICS_FOE_FREE 9   // the foe waits until the lines from here on
+
+static const struct TutLine sBasicsOneChip[] = {   // a hand with no pair (shouldn't happen with the rescue's folder)
+    { "Pick a chip with A!", TT_HAND, W_PICK1 },
+};
+
+static const struct TutLine sWild[] = {   // BN6 TextScriptBattleTutAreaGrab: the * code
+    { "A chip with a * goes with any letter!", TT_HAND, W_A },
+};
+
+static const struct TutLine sCatch[] = {
+    { "Want to catch it? Weaken it first...", TT_FOE_HP, W_A },
+    { "...then pick a POKE BALL here and press A. L and R change the ball.", TT_BALL, W_A },
+};
+
+static const struct TutLine sSwitch[] = {
+    { "SW sends in another of your POKEMON.", TT_SW, W_A },
+    { "Pick it like a chip. Nothing can follow it.", TT_SW, W_A },
+};
+
+static const struct TutLine sCounter[] = {   // BN6 TextScriptBattleTutFullSynchro: Counter
+    { "Now! It's about to strike. Hit it while it's busy!", TT_FOE, W_A },
+    { "That's a COUNTER: it's stunned, and your next chip hits twice as hard.", TT_FOE, W_A },
+};
+
+static struct
+{
+    const struct TutLine *lines;
+    u8 count, at;
+    u8 bits;          // set as seen when the lesson ends
+    bool8 firstBattle;
+    bool8 basicsDone;
+    u8 pairLetter;    // the pair to pick in the rescue
+    char text[96];    // the line, filled in
+    const char *nag;  // a short refusal shown instead for a moment
+    u16 nagT;
+    u8 waitT;         // a lesson starting in Custom waits for the window to slide in (grid_draw.c SLIDE_IN)
+    const struct TutLine *pending;
+    u8 pendingCount, pendingBits;
+    u8 did;           // what the player has already done (a "do it" line is skipped if it's done)
+} sT;
+
+bool8 Tut_Enabled(void)
+{
+    if (gPkbnReplayActive)
+        return FALSE;
+    if ((getenv("PKBN_SELFTEST") != NULL || getenv("PKBN_OWTEST") != NULL) && getenv("PKBN_TEST_TUTORIAL") == NULL)
+        return FALSE;
+    return TRUE;
+}
+
+static void StartNow(const struct TutLine *lines, u8 count, u8 bits);
+static void Start(const struct TutLine *lines, u8 count, u8 bits)
+{
+    if (sB.state == ST_CUSTOM)
+    {
+        sT.pending = lines, sT.pendingCount = count, sT.pendingBits = bits;
+        sT.waitT = 16;
+        return;
+    }
+    StartNow(lines, count, bits);
+}
+
+static void StartNow(const struct TutLine *lines, u8 count, u8 bits)
+{
+    sT.lines = lines;
+    sT.count = count;
+    sT.at = 0;
+    sT.bits = bits;
+    sT.nag = NULL;
+    PKBN_LOG("lesson %x: %u lines", bits, count);
+}
+
+static void Finish(void)
+{
+    PkbnTutorial_SetSeen(sT.bits);
+    PKBN_LOG("lesson %x done", sT.bits);
+    sT.lines = NULL;
+}
+
+static void Next(void)
+{
+    if (sT.lines == NULL)
+        return;
+    sT.nag = NULL;
+    if (++sT.at >= sT.count)
+        Finish();
+}
+
+static const struct TutLine *Cur(void)
+{
+    return sT.lines != NULL ? &sT.lines[sT.at] : NULL;
+}
+
+void Tut_BattleBegin(bool8 firstBattle)
+{
+    memset(&sT, 0, sizeof(sT));
+    sT.firstBattle = firstBattle && Tut_Enabled() && !PkbnTutorial_Seen(TUT_BASICS);
+}
+
+bool8 Tut_Active(void)
+{
+    return sT.lines != NULL || sT.firstBattle;
+}
+
+// The rescue's folder (Khaled's pick: "the starter's first moves share one code, 3 copies each"; BN6 hands Lan two
+// Cannons for the first battle, TextScriptBattleTut1). The first move's first code; the second move takes the same
+// code if it has it, else its * (every starter move here has one, src/pkbn/move_table.c).
+void Tut_StarterFolder(void)
+{
+    u16 m0 = MOVE_NONE, m1 = MOVE_NONE;
+    u8 c0, c1, k;
+    s32 m;
+    if (!sT.firstBattle)
+        return;
+    for (m = 0; m < MAX_MON_MOVES; m++)
+    {
+        u16 mv = GetMonData(&gPlayerParty[0], MON_DATA_MOVE1 + m);
+        if (mv == MOVE_NONE || !PkbnFolder_MoveIsChip(mv) || gPkbnMoveInfo[mv].laneCount == 0)
+            continue;
+        if (m0 == MOVE_NONE)
+            m0 = mv;
+        else if (m1 == MOVE_NONE)
+            m1 = mv;
+    }
+    if (m0 == MOVE_NONE)
+        return;
+    c0 = gPkbnMoveInfo[m0].lanes[0];
+    PkbnPack_SetGranted(m0);
+    PkbnPack_Add(m0, c0, 3 - PkbnPack_Get(m0, c0));
+    if (m1 != MOVE_NONE)
+    {
+        c1 = gPkbnMoveInfo[m1].lanes[0];
+        for (k = 0; k < gPkbnMoveInfo[m1].laneCount; k++)
+            if (gPkbnMoveInfo[m1].lanes[k] == c0)
+                c1 = c0;
+        if (c1 != c0)
+            for (k = 0; k < gPkbnMoveInfo[m1].laneCount; k++)
+                if (gPkbnMoveInfo[m1].lanes[k] == LANE_WILD)
+                    c1 = LANE_WILD;
+        PkbnPack_SetGranted(m1);
+        PkbnPack_Add(m1, c1, 3 - PkbnPack_Get(m1, c1));
+    }
+    PKBN_LOG("rescue folder: move %u code %u x3, move %u x3", m0, c0, m1);
+}
+
+static u8 HandLetter(u8 pos)
+{
+    return sB.folder.chips[sB.hand[pos]].letter;
+}
+
+// The letter with the most chips in hand (a * counts toward every letter).
+static u8 PairLetter(void)
+{
+    u8 best = 0xFF, bestN = 1, i, j;
+    for (i = 0; i < sB.handCount; i++)
+    {
+        u8 l = HandLetter(i), n = 0;
+        if (l == LANE_WILD)
+            continue;
+        for (j = 0; j < sB.handCount; j++)
+            if (HandLetter(j) == l || HandLetter(j) == LANE_WILD)
+                n++;
+        if (n > bestN)
+            best = l, bestN = n;
+    }
+    if (best == 0xFF)
+    {
+        u8 wild = 0;
+        for (i = 0; i < sB.handCount; i++)
+            wild += HandLetter(i) == LANE_WILD;
+        if (wild >= 2)
+            best = LANE_WILD;
+    }
+    return best;
+}
+
+static bool8 HandHasWild(void)
+{
+    u8 i;
+    for (i = 0; i < sB.handCount; i++)
+        if (HandLetter(i) == LANE_WILD)
+            return TRUE;
+    return FALSE;
+}
+
+static bool8 CanSwitch(void)
+{
+    u8 i, n = 0;
+    for (i = 0; i < sB.partyCount; i++)
+        if (sB.party[i].bm.hp && sB.party[i].bm.species)
+            n++;
+    return n >= 2;
+}
+
+void Tut_Event(u8 ev)
+{
+    const struct TutLine *l = Cur();
+    if (!Tut_Enabled())
+        return;
+    if (ev == TEV_CUSTOM_OPEN && l == NULL && sT.pending == NULL)
+    {
+        if (sT.firstBattle && !sT.basicsDone)
+        {
+            sT.basicsDone = TRUE;
+            sT.pairLetter = PairLetter();
+            if (sT.pairLetter == 0xFF)
+                Start(sBasicsOneChip, ARRAY_COUNT(sBasicsOneChip), 0);
+            else
+                Start(sBasics, ARRAY_COUNT(sBasics), TUT_BASICS);
+            return;
+        }
+        if (sT.firstBattle && !PkbnTutorial_Seen(TUT_CODES))
+        {
+            if (HandHasWild())
+                Start(sWild, ARRAY_COUNT(sWild), TUT_CODES);
+            return;
+        }
+        if (sT.firstBattle)
+            return;
+        if (!PkbnTutorial_Seen(TUT_CATCH) && !sB.trainer && !sB.challenge && sB.ballItem && Foe_LiveCount() == 1)
+            Start(sCatch, ARRAY_COUNT(sCatch), TUT_CATCH);
+        else if (!PkbnTutorial_Seen(TUT_SWITCH) && CanSwitch())
+            Start(sSwitch, ARRAY_COUNT(sSwitch), TUT_SWITCH);
+        return;
+    }
+    if (ev == TEV_STEP) sT.did |= 1 << W_MOVE;
+    if (ev == TEV_BUSTER) sT.did |= 1 << W_BUSTER;
+    if (ev == TEV_CHIP_USED) sT.did |= 1 << W_CHIP;
+    if (l == NULL)
+        return;
+    if ((ev == TEV_CUSTOM_OK && l->wait == W_OK) || (ev == TEV_STEP && l->wait == W_MOVE)
+     || (ev == TEV_BUSTER && l->wait == W_BUSTER) || (ev == TEV_CHIP_USED && l->wait == W_CHIP))
+        Next();
+    if (ev == TEV_CUSTOM_OK && sT.lines == sBasicsOneChip)
+        Finish();
+}
+
+bool8 Tut_HoldFoe(void)
+{
+    return sT.lines == sBasics && sT.at < BASICS_FOE_FREE;
+}
+
+static void Nag(const char *s)
+{
+    sT.nag = s;
+    sT.nagT = 120;
+    PlaySE(SE_FAILURE);
+}
+
+// The Custom screen while a "pick" or "OK" line waits: wrong keys are refused (BN6: "Come on,Lan! Let's select a
+// Cannon! Cancel with the B Button and reselect!").
+static void FilterCustom(const struct TutLine *l)
+{
+    u16 *keys = &gMain.newKeys;
+    bool8 onChip = sB.cursor < sB.handCount;
+    if (*keys & L_BUTTON)
+        *keys &= ~L_BUTTON;   // (the rescue can't be run from anyway)
+    if (l->wait == W_PICK2 || l->wait == W_PICK1)
+    {
+        u8 need = l->wait == W_PICK2 ? 2 : 1;
+        if (*keys & A_BUTTON)
+        {
+            bool8 ok = onChip && !sB.picked[sB.cursor]
+                    && (l->wait == W_PICK1 || HandLetter(sB.cursor) == sT.pairLetter || HandLetter(sB.cursor) == LANE_WILD);
+            if (!ok)
+            {
+                *keys &= ~A_BUTTON;
+                Nag(sB.cursor == sB.handCount + 2 ? "Pick the chips first!" : "Not that one! B takes a chip back.");
+            }
+        }
+        if (*keys & START_BUTTON)
+        {
+            *keys &= ~START_BUTTON;
+            Nag("Pick the chips first!");
+        }
+        if (sB.queueCount >= need)
+            Next();
+    }
+}
+
+bool8 Tut_Frame(void)
+{
+    const struct TutLine *l;
+    if (sT.nagT && --sT.nagT == 0)
+        sT.nag = NULL;
+    if (!Tut_Enabled())
+        return FALSE;
+    if (sT.pending != NULL && sB.state == ST_CUSTOM && --sT.waitT == 0)
+    {
+        StartNow(sT.pending, sT.pendingCount, sT.pendingBits);
+        sT.pending = NULL;
+    }
+    if (sT.pending != NULL)
+    {
+        gMain.newKeys = 0;   // (nothing is picked before Birch speaks)
+        return FALSE;
+    }
+    // the first counter chance in a fight (BN6 TextScriptBattleTutFullSynchro)
+    if (sT.lines == NULL && !sT.firstBattle && sB.state == ST_FIGHT && !PkbnTutorial_Seen(TUT_COUNTER)
+     && sB.f[SIDE_ENEMY].bm.hp && (sB.f[SIDE_ENEMY].lockout || sB.f[SIDE_ENEMY].charging) && sB.queueCount > 0
+     && !sB.hitStop && !sB.cinemaT)
+        Start(sCounter, ARRAY_COUNT(sCounter), TUT_COUNTER);
+    l = Cur();
+    if (l == NULL)
+        return FALSE;
+    // a "do it" line for something already done is skipped (a player who used their chips before being told to)
+    if ((l->wait == W_MOVE || l->wait == W_BUSTER || l->wait == W_CHIP) && sB.state == ST_FIGHT
+     && ((sT.did & (1 << l->wait)) || (l->wait == W_CHIP && sB.queueCount == 0)))
+    {
+        Next();
+        return FALSE;
+    }
+    if (l->wait == W_A)
+    {
+        if (gMain.newKeys & A_BUTTON)
+        {
+            PlaySE(SE_SELECT);
+            Next();
+        }
+        gMain.newKeys = 0;
+        gMain.heldKeys = 0;
+        return TRUE;   // the battle waits for the line
+    }
+    if (sB.state == ST_CUSTOM)
+        FilterCustom(l);
+    return FALSE;
+}
+
+// For the self-test bots: the Custom cursor value the open line wants picked next (0xFF = nothing in particular).
+u8 Tut_WantedCursor(void)
+{
+    const struct TutLine *l = Cur();
+    u8 i;
+    if (l == NULL)
+        return 0xFF;
+    if (l->wait == W_OK)
+        return sB.handCount + 2;
+    if (l->wait == W_PICK1 || l->wait == W_PICK2)
+        for (i = 0; i < sB.handCount; i++)
+            if (!sB.picked[i] && (l->wait == W_PICK1 || HandLetter(i) == sT.pairLetter || HandLetter(i) == LANE_WILD))
+                return i;
+    return 0xFF;
+}
+
+u32 Tut_StepId(void)
+{
+    return sT.lines != NULL ? ((u32)(uintptr_t)sT.lines & 0xFFFFFF) * 64 + sT.at + 1 + (sT.nag != NULL ? 32 : 0) : 0;
+}
+
+bool8 Tut_Blocking(void)
+{
+    const struct TutLine *l = Cur();
+    return l != NULL && l->wait == W_A;
+}
+
+u16 Tut_WantedFightKey(void)
+{
+    const struct TutLine *l = Cur();
+    if (l == NULL || (sB.chipReadyT && l->wait != W_A))
+        return 0;
+    return l->wait == W_MOVE ? DPAD_UP : l->wait == W_BUSTER ? B_BUTTON : (l->wait == W_CHIP || l->wait == W_A) ? A_BUTTON : 0;
+}
+
+const char *Tut_Line(u8 *target, bool8 *waitsForA)
+{
+    const struct TutLine *l = Cur();
+    if (l == NULL)
+        return NULL;
+    *target = l->target;
+    *waitsForA = l->wait == W_A;
+    if (sT.nag != NULL)
+        return sT.nag;
+    if (strstr(l->text, "%c") != NULL)
+        snprintf(sT.text, sizeof(sT.text), l->text, sT.pairLetter == LANE_WILD ? '*' : 'A' + sT.pairLetter);
+    else
+        snprintf(sT.text, sizeof(sT.text), "%s", l->text);
+    return sT.text;
+}
+
+// POC-18 (Khaled: "the navicust get unlocked after winning first gym battle (against Roxanne)"): the Stone Badge.
+bool8 PkbnNaviCust_Unlocked(void)
+{
+    return FlagGet(FLAG_BADGE01_GET) || PkbnTutorial_Seen(TUT_NAVI_OPEN);
+}
+
+#else
+bool8 PkbnNaviCust_Unlocked(void) { return TRUE; }
+#endif // PORTABLE
-- 
