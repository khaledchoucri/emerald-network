+// ---- POC-18: lessons (src/pkbn/tutorial.c) ------------------------------------------------------------------------
+// Prof. Birch's line in an Emerald-style box, and a pulsing frame with a bouncing arrow on what it's about.
+static void TutTargetRect(u8 target, s32 *x, s32 *y, s32 *w, s32 *h)
+{
+    s32 extra = sB.handSize > HAND_SIZE ? sB.handSize - HAND_SIZE : 0, ballW = 3 - extra < 1 ? 1 : 3 - extra, fx, fy;
+    *w = *h = 0;
+    switch (target)
+    {
+    case TT_HAND:  *x = 4; *y = SLOTS_Y - 2; *w = HAND_SIZE * SLOT_W + 2; *h = SLOT_H + 4; break;
+    case TT_INFO:  *x = 2; *y = 12; *w = CUS_W - 4; *h = 88; break;
+    case TT_OK:    *x = 4 + (extra + 1 + ballW) * SLOT_W; *y = ROW2_Y - 2; *w = SLOT_W + 2; *h = SLOT_H + 4; break;
+    case TT_SW:    *x = 4 + extra * SLOT_W; *y = ROW2_Y - 2; *w = SLOT_W + 2; *h = SLOT_H + 4; break;
+    case TT_BALL:  *x = 4 + (extra + 1) * SLOT_W; *y = ROW2_Y - 2; *w = SLOT_W * ballW + 2; *h = SLOT_H + 4; break;
+    case TT_GAUGE: *x = 72; *y = 22; *w = 120; *h = 14; break;
+    case TT_FOE_HP:
+        if (sB.state == ST_CUSTOM)
+        {
+            char line[24];
+            s32 tw;
+            snprintf(line, sizeof(line), "%s Lv%u", sB.f[SIDE_ENEMY].name, sB.f[SIDE_ENEMY].bm.level);
+            tw = Pkbn_EmTextWidth(line, PKBN_FONT_SMALL);
+            *x = CW - 4 - tw - 6; *y = 0; *w = tw + 12; *h = 21;
+            break;
+        }
+        Draw_FeetPos(sB.f[SIDE_ENEMY].x, sB.f[SIDE_ENEMY].y, &fx, &fy);
+        *x = fx - 14; *y = fy - 1; *w = 28; *h = 14;
+        break;
+    case TT_HEAD:
+        if (sHeadValid)
+        {
+            *x = sHeadX - 14; *y = sHeadY - CHIP_ICON_H - 10; *w = 28; *h = CHIP_ICON_H + 8;
+            if (*y < 26) *y = 26;
+            break;
+        }
+        // fallthrough
+    case TT_PLAYER:
+    case TT_FOE:
+        Draw_FeetPos(sB.f[target == TT_FOE ? SIDE_ENEMY : SIDE_PLAYER].x, sB.f[target == TT_FOE ? SIDE_ENEMY : SIDE_PLAYER].y,
+                     &fx, &fy);
+        *x = fx - 20; *y = fy - 44; *w = 40; *h = 48;
+        break;
+    }
+}
+
+static void DrawTutorial(u16 *fb)
+{
+    static u32 sT;
+    u8 target = TT_NONE;
+    bool8 waitsForA = FALSE;
+    const char *text = Tut_Line(&target, &waitsForA);
+    s32 tx, ty, tw, th, bx = 6, bw = CW - 12, bh = 36, by, i, n, lines = 0;
+    char buf[96], *words[24], *line;
+    sT++;
+    if (text == NULL)
+        return;
+    TutTargetRect(target, &tx, &ty, &tw, &th);
+    by = (tw && ty + th / 2 > CH / 2) ? 2 : CH - bh - 2;
+    if (tw)
+    {
+        // the frame pulses; the arrow bobs above (or below) it
+        u16 c = Gfx_Blend(COL_GAUGE_FULL, COL_WHITE, (u8)((sT / 2) % 16 < 8 ? (sT / 2) % 8 : 8 - (sT / 2) % 8));
+        s32 ax = tx + tw / 2, bob = (s32)((sT / 6) % 4), ay;
+        Pkbn_FrameRect(fb, tx, ty, tw, th, c);
+        Pkbn_FrameRect(fb, tx - 1, ty - 1, tw + 2, th + 2, Gfx_Blend(c, COL_BLACK, 8));
+        if (ty > 14)
+        {
+            ay = ty - 9 - bob;
+            for (i = 0; i < 5; i++)
+                Pkbn_FillRect(fb, ax - 4 + i, ay + i, 9 - 2 * i, 1, c);   // a triangle pointing down
+        }
+        else
+        {
+            ay = ty + th + 3 + bob;
+            for (i = 0; i < 5; i++)
+                Pkbn_FillRect(fb, ax - i, ay + i, 1 + 2 * i, 1, c);       // pointing up
+        }
+    }
+    // Emerald's message box: white with a dark rim, the speaker on a tab
+    Draw_Box(fb, bx, by, bw, bh, RGB(29, 30, 31), RGB(6, 9, 16), 16);
+    Draw_Box(fb, bx + 4, by - 9 < 0 ? by + bh - 1 : by - 9, 62, 11, RGB(6, 9, 16), RGB(6, 9, 16), 16);
+    Text(fb, bx + 8, (by - 9 < 0 ? by + bh - 1 : by - 9) - 2, "PROF. BIRCH", COL_WHITE);
+    // word-wrap into up to 3 lines
+    snprintf(buf, sizeof(buf), "%s", text);
+    n = 0;
+    for (line = strtok(buf, " "); line != NULL && n < 24; line = strtok(NULL, " "))
+        words[n++] = line;
+    {
+        char row[96];
+        s32 k = 0;
+        row[0] = '\0';
+        for (i = 0; i <= n && lines < 3; i++)
+        {
+            char test[96];
+            if (i < n)
+                snprintf(test, sizeof(test), row[0] ? "%s %s" : "%s%s", row, words[i]);
+            if (i == n || Pkbn_EmTextWidth(test, PKBN_FONT_SMALL) > bw - 14)
+            {
+                Pkbn_DrawEmText(fb, bx + 7, by + 2 + lines * 10, row, PKBN_FONT_SMALL, RGB(6, 7, 9), RGB(22, 23, 25));
+                lines++;
+                if (i < n)
+                    snprintf(row, sizeof(row), "%s", words[i]);
+                else
+                    row[0] = '\0';
+            }
+            else
+                snprintf(row, sizeof(row), "%s", test);
+            (void)k;
+        }
+    }
+    if (waitsForA && ((sT / 16) & 1))
+        for (i = 0; i < 4; i++)
+            Pkbn_FillRect(fb, bx + bw - 12 + i, by + bh - 9 + i, 7 - 2 * i, 1, RGB(31, 8, 6));   // Emerald's red arrow
 }
 
 #endif // PORTABLE
