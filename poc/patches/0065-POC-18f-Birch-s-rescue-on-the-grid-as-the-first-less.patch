+#ifndef GUARD_PKBN_TUTORIAL_H
+#define GUARD_PKBN_TUTORIAL_H
+// POC-18: lessons for players new to Battle Network (src/pkbn/tutorial.c). Khaled's picks: Birch's rescue on Route 101
+// is the first grid battle and Birch talks you through it, the way Lan and MegaMan do in BN6's first battles
+// (bn6f data/textscript/TextScriptBattleTut1.s, TextScriptBattleTutAreaGrab.s, TextScriptBattleTutFullSynchro.s);
+// later lessons come once, in the first battle where they fit.
+#include "global.h"
+
+#define TUT_BASICS    (1 << 0)   // Birch's rescue: Custom, chips, codes, OK, moving, buster, using a chip, the gauge
+#define TUT_CODES     (1 << 1)   // the * code (second Custom of the rescue, when a * chip is in hand)
+#define TUT_CATCH     (1 << 2)   // first wild battle with Poké Balls
+#define TUT_SWITCH    (1 << 3)   // first battle with two Pokémon able to fight
+#define TUT_COUNTER   (1 << 4)   // first counter chance
+#define TUT_NAVICUST  (1 << 5)   // first time in NAVICUST
+#define TUT_NAVI_OPEN (1 << 7)   // a save from before POC-18: NAVICUST stays open without the Stone Badge
+
+// What a line points at (drawn by grid_draw.c)
+enum { TT_NONE, TT_HAND, TT_INFO, TT_FOE_HP, TT_OK, TT_PLAYER, TT_GAUGE, TT_HEAD, TT_BALL, TT_SW, TT_FOE };
+
+// Events the battle reports
+enum { TEV_CUSTOM_OPEN, TEV_CUSTOM_OK, TEV_STEP, TEV_BUSTER, TEV_CHIP_USED };
+
+bool8 PkbnTutorial_Seen(u8 bits);      // pkbn_save.c
+void PkbnTutorial_SetSeen(u8 bits);
+
+bool8 Tut_Enabled(void);                // FALSE in replays and self-tests (PKBN_TEST_TUTORIAL=1 turns it on there)
+void Tut_BattleBegin(bool8 firstBattle);
+void Tut_StarterFolder(void);           // the rescue's folder: the starter's first two moves, 3 copies, one code
+bool8 Tut_Frame(void);                  // each battle frame, first: TRUE = a line is open and the battle waits
+void Tut_Event(u8 ev);
+bool8 Tut_HoldFoe(void);                // the foe waits while you learn
+bool8 Tut_Active(void);                 // a lesson is running this battle
+// For grid_draw.c: the open line (NULL = none), what it points at, whether A closes it (else it's a "do it" prompt)
+const char *Tut_Line(u8 *target, bool8 *waitsForA);
+u8 Tut_WantedCursor(void);              // self-test bots
+u16 Tut_WantedFightKey(void);
+u32 Tut_StepId(void);                   // self-test screenshots: changes with each line
+bool8 Tut_Blocking(void);               // a line waits for A (the battle is frozen)
+bool8 PkbnNaviCust_Unlocked(void);      // NAVICUST in the party menu: after Roxanne (POC-18)
+
+#endif // GUARD_PKBN_TUTORIAL_H
