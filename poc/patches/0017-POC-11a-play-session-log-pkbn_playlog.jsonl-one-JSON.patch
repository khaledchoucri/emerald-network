diff --git a/src/pkbn/playlog.c b/src/pkbn/playlog.c
new file mode 100644
index 0000000..5cc5229
--- /dev/null
+++ b/src/pkbn/playlog.c
@@ -0,0 +1,130 @@
+// Play-session log (POC-11). include/pkbn/playlog.h.
+#include "pkbn/grid_vfx.h"
+#include "pkbn/grid_internal.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/playlog.h"
+#include "event_data.h"
+#include "battle_setup.h"
+#include "money.h"
+#include "constants/flags.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define PLAYLOG_PATH "pkbn_playlog.jsonl"
+
+static struct
+{
+    u16 chips[96];
+    u8 chipCount;
+    u8 pas[8];
+    u8 paCount;
+    s16 bustTurns, bustSecs, used;
+    s32 parts[6];
+    s16 capture;
+    char reward[96];
+} sL;
+
+void PlayLog_Reset(void)
+{
+    memset(&sL, 0, sizeof(sL));
+    sL.bustTurns = sL.bustSecs = sL.capture = -1;
+}
+
+void PlayLog_NoteChip(u16 move)
+{
+    if (sL.chipCount < ARRAY_COUNT(sL.chips))
+        sL.chips[sL.chipCount++] = move;
+}
+
+void PlayLog_NotePA(u8 pa)
+{
+    if (sL.paCount < ARRAY_COUNT(sL.pas))
+        sL.pas[sL.paCount++] = pa;
+}
+
+void PlayLog_SetBusting(u8 turnsLevel, u8 secondsLevel, const s32 *parts, u8 used)
+{
+    sL.bustTurns = turnsLevel;
+    sL.bustSecs = secondsLevel;
+    sL.used = used;
+    memcpy(sL.parts, parts, sizeof(sL.parts));
+}
+
+void PlayLog_SetCapture(u8 grade)
+{
+    sL.capture = grade;
+}
+
+void PlayLog_SetReward(const char *text)
+{
+    s32 i, n = 0;
+    for (i = 0; text[i] && n < (s32)sizeof(sL.reward) - 1; i++)
+        if (text[i] != '"' && text[i] != '\\')
+            sL.reward[n++] = text[i];
+    sL.reward[n] = '\0';
+}
+
+static u32 Badges(void)
+{
+    u32 i, n = 0;
+    for (i = FLAG_BADGE01_GET; i <= FLAG_BADGE08_GET; i++)
+        n += FlagGet(i) ? 1 : 0;
+    return n;
+}
+
+void PlayLog_Write(void)
+{
+    FILE *f;
+    s32 i;
+    u32 packTotal = 0, candy = 0;
+    u16 mv;
+    if (getenv("PKBN_SELFTEST") != NULL && getenv("PKBN_PLAYLOG") == NULL)
+        return;
+    f = fopen(getenv("PKBN_PLAYLOG") ? getenv("PKBN_PLAYLOG") : PLAYLOG_PATH, "a");
+    if (f == NULL)
+        return;
+    for (mv = 1; mv < MOVES_COUNT; mv++)
+        packTotal += PkbnPack_Total(mv);
+    for (i = 0; i < NUMBER_OF_MON_TYPES; i++)
+        candy += PkbnCandy_Get(i);
+    fprintf(f, "{\"time\":%ld,\"map\":[%d,%d],\"badges\":%u,\"trainer\":%d,\"outcome\":%u,",
+            (long)time(NULL), gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum, Badges(),
+            sB.trainer ? gTrainerBattleOpponent_A : -1, sB.outcome);
+    fprintf(f, "\"frames\":%u,\"turns\":%u,\"enemies\":[", (unsigned)sB.bust.fightFrames,
+            (unsigned)(sB.bust.fightFrames / CUSTOM_FRAMES));
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        u16 sp = GetMonData(&gEnemyParty[i], MON_DATA_SPECIES);
+        if (sp == SPECIES_NONE)
+            break;
+        fprintf(f, "%s[%u,%u]", i ? "," : "", sp, (unsigned)GetMonData(&gEnemyParty[i], MON_DATA_LEVEL));
+    }
+    fprintf(f, "],\"party\":[");
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        u16 sp = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES);
+        if (sp == SPECIES_NONE)
+            break;
+        fprintf(f, "%s[%u,%u,%u,%u]", i ? "," : "", sp, (unsigned)GetMonData(&gPlayerParty[i], MON_DATA_LEVEL),
+                (unsigned)GetMonData(&gPlayerParty[i], MON_DATA_HP), (unsigned)GetMonData(&gPlayerParty[i], MON_DATA_MAX_HP));
+    }
+    fprintf(f, "],\"busting\":{\"turns\":%d,\"seconds\":%d,\"used\":%d,\"time\":%d,\"hits\":%d,\"steps\":%d,\"chain\":%d,"
+               "\"counters\":%d,\"nofaint\":%d},\"capture\":%d,\"reward\":\"%s\",",
+            sL.bustTurns, sL.bustSecs, sL.used, (int)sL.parts[0], (int)sL.parts[1], (int)sL.parts[2], (int)sL.parts[3],
+            (int)sL.parts[4], (int)sL.parts[5], sL.capture, sL.reward);
+    fprintf(f, "\"folder\":%u,\"folderLeft\":%u,\"chips\":[", sB.folder.count, sB.folder.pileCount);
+    for (i = 0; i < sL.chipCount; i++)
+        fprintf(f, "%s%u", i ? "," : "", sL.chips[i]);
+    fprintf(f, "],\"pas\":[");
+    for (i = 0; i < sL.paCount; i++)
+        fprintf(f, "%s%u", i ? "," : "", sL.pas[i]);
+    fprintf(f, "],\"pack\":%u,\"candy\":%u,\"money\":%u}\n", packTotal, candy,
+            (unsigned)GetMoney(&gSaveBlock1Ptr->money));
+    fclose(f);
+}
+
+#endif // PORTABLE
