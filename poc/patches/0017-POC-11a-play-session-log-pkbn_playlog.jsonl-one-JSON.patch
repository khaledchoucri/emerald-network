--- /dev/null
+++ b/include/pkbn/playlog.h
@@ -0,0 +1,13 @@
+#ifndef GUARD_PKBN_PLAYLOG_H
+#define GUARD_PKBN_PLAYLOG_H
+// Play-session log (POC-11): one JSON line per battle appended to pkbn_playlog.jsonl next to the save, so balance
+// (Busting thresholds, drop rates, candy prices, MB) can be tuned from real play. src/pkbn/playlog.c.
+// Written in normal play; in self-tests only when PKBN_PLAYLOG is set.
+void PlayLog_Reset(void);
+void PlayLog_NoteChip(u16 move);
+void PlayLog_NotePA(u8 pa);
+void PlayLog_SetBusting(u8 turnsLevel, u8 secondsLevel, const s32 *parts, u8 used);
+void PlayLog_SetCapture(u8 grade);
+void PlayLog_SetReward(const char *text);
+void PlayLog_Write(void);
+#endif // GUARD_PKBN_PLAYLOG_H
