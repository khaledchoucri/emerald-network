index 83892ad..fe523de 100644
--- a/src/pkbn/gfx.c
+++ b/src/pkbn/gfx.c
@@ -134,6 +134,25 @@ void Gfx_DrawScaled(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, s32 sx25
     }
 }
 
+// POC-17b: an image through a GBA OAM affine matrix (a, b, c, d in 8.8, screen -> texture, as gOamMatrices holds it),
+// double-size like ST_OAM_AFFINE_DOUBLE, around the image's centre. GFX_FLIPX mirrors the whole transformed picture.
+void Gfx_DrawAffine(u16 *fb, const struct PkbnImage *img, s32 x, s32 y, s16 a, s16 b, s16 c, s16 d, u32 flags, u16 color, u8 amt)
+{
+    s32 cx = x + img->ox + img->w / 2, cy = y + img->oy + img->h / 2, dx, dy;
+    for (dy = -img->h; dy < img->h; dy++)
+        for (dx = -img->w; dx < img->w; dx++)
+        {
+            s32 ux = (flags & GFX_FLIPX) ? -dx : dx;
+            s32 tx = ((a * ux + b * dy) >> 8) + img->w / 2, ty = ((c * ux + d * dy) >> 8) + img->h / 2;
+            u8 idx;
+            if (tx < 0 || ty < 0 || tx >= img->w || ty >= img->h)
+                continue;
+            idx = img->px[ty * img->w + tx];
+            if (idx)
+                Plot(fb, cx + dx, cy + dy, img->pal[idx], flags & ~GFX_FLIPX, color, amt);
+        }
+}
