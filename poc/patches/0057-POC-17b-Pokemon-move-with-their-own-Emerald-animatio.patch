+// POC-17b: a big move's moment (our design, TUNE): MegaChips 12 frames, PAs and GigaChips 28. The fight waits for it
+// (like a hit-stop, but the pictures keep moving). PKBN_NO_CINEMA=1 turns it off.
+void Vis_Cinema(u8 side, u8 level)
+{
+    static s8 sOff = -1;
+    u8 frames = level >= 2 ? 28 : 12;
+    if (sOff < 0)
+        sOff = getenv("PKBN_NO_CINEMA") != NULL;
+    if (sOff || gPkbnGallery)
+        return;
+    if (frames > sB.cinemaT)
+        sB.cinemaT = frames;
+    Vis_Post(VEV_CINEMA, side, MOVE_NONE, level, (s8)frames, 0, 0);
+}
