+// ---- POC-17b: each Pokémon moves the way it does in Emerald ----------------------------------------------------------
+// Emerald gives every species a front animation (sMonFrontAnimIdsTable, pokemon.c) and plays it when the Pokémon appears
+// in battle (pokemon_animation.c). Here Emerald's own animation code runs on a puppet sprite the grid owns: each frame
+// we read back its offset (x2, y2), its affine matrix (gOamMatrices) and its palette glow, and draw our picture with
+// them. It plays when a Pokémon comes out, and at double speed as it winds up and strikes (TUNE: then eased back).
+extern u8 Pkbn_FrontAnimId(u16 species);
+extern void Pkbn_MonAnimStart(struct Sprite *sprite, u8 animId);
+extern bool8 Pkbn_MonAnimDone(struct Sprite *sprite);
+
+#define PUPPET_MATRIX  31                       // an OAM matrix the grid battle has to itself
+#define PUPPET_PAL     15                       // and an OBJ palette slot, for the glow animations
+#define PUPPET_GREY    RGB(16, 16, 16)
+#define PUPPET_EASE    6
+
+struct MonPuppet
+{
+    struct Sprite spr;
+    bool8 on;
+    u8 speed;
+    u16 t, maxT;
+    u8 ease;                                    // frames of easing back to rest
+    s16 a, b, c, d, x2, y2;                     // this frame's pose
+    u16 tint;
+    u8 tintAmt;
+    bool8 hidden;
+};
+static struct MonPuppet sPuppet[NVIS];
+
+// POC-17b: a big move's cut-in (VEV_CINEMA)
+static u8 sCinemaT, sCinemaLen, sCinemaLevel, sCinemaV;
+#include "trig.h"
+
+static void Puppet_Start(u8 v, u16 species, u8 speed, u16 maxT)
+{
+    struct MonPuppet *p = &sPuppet[v];
+    if (species == SPECIES_NONE || getenv("PKBN_NO_MON_ANIMS") != NULL)
+        return;
+    memset(p, 0, sizeof(*p));
+    p->spr.oam.matrixNum = PUPPET_MATRIX;
+    p->spr.oam.paletteNum = PUPPET_PAL;
+    p->spr.oam.affineMode = ST_OAM_AFFINE_OFF;
+    p->spr.animEnded = TRUE;                    // nothing else animates it: WaitAnimEnd ends at once
+    p->spr.data[2] = species;
+    p->a = p->d = 256;
+    p->on = TRUE;
+    p->speed = speed;
+    p->maxT = maxT;
+    Pkbn_MonAnimStart(&p->spr, Pkbn_FrontAnimId(species));
+}
+
+static void Puppet_Step(u8 v)
+{
+    struct MonPuppet *p = &sPuppet[v];
+    u8 k;
+    if (!p->on)
+        return;
+    if (p->ease)
+    {
+        // back to rest: blend the last pose toward the identity
+        p->a = 256 + (p->a - 256) * (p->ease - 1) / p->ease;
+        p->d = 256 + (p->d - 256) * (p->ease - 1) / p->ease;
+        p->b = p->b * (p->ease - 1) / p->ease;
+        p->c = p->c * (p->ease - 1) / p->ease;
+        p->x2 = p->x2 * (p->ease - 1) / p->ease;
+        p->y2 = p->y2 * (p->ease - 1) / p->ease;
+        p->tintAmt = p->tintAmt * (p->ease - 1) / p->ease;
+        p->hidden = FALSE;
+        if (--p->ease == 0)
+            p->on = FALSE;
+        return;
+    }
+    for (k = 0; k < p->speed && !Pkbn_MonAnimDone(&p->spr); k++)
+    {
+        s32 i;
+        for (i = 0; i < 16; i++)
+            gPlttBufferUnfaded[OBJ_PLTT_ID(PUPPET_PAL) + i] = gPlttBufferFaded[OBJ_PLTT_ID(PUPPET_PAL) + i] = PUPPET_GREY;
+        p->spr.callback(&p->spr);
+    }
+    p->x2 = p->spr.x2;
+    p->y2 = p->spr.y2;
+    p->hidden = p->spr.invisible;
+    if (p->spr.oam.affineMode != ST_OAM_AFFINE_OFF)
+    {
+        p->a = gOamMatrices[PUPPET_MATRIX].a, p->b = gOamMatrices[PUPPET_MATRIX].b;
+        p->c = gOamMatrices[PUPPET_MATRIX].c, p->d = gOamMatrices[PUPPET_MATRIX].d;
+    }
+    else
+        p->a = p->d = 256, p->b = p->c = 0;
+    {
+        // a glow blends the palette toward a colour: grey in, the blend's direction and size out
+        u16 f = gPlttBufferFaded[OBJ_PLTT_ID(PUPPET_PAL) + 1];
+        s32 r = (f & 31) - 16, g = ((f >> 5) & 31) - 16, bl = ((f >> 10) & 31) - 16, m = abs(r);
+        if (abs(g) > m) m = abs(g);
+        if (abs(bl) > m) m = abs(bl);
+        if (m)
+        {
+            p->tint = RGB(16 + r * 15 / m, 16 + g * 15 / m, 16 + bl * 15 / m);
+            p->tintAmt = (u8)(m > 15 ? 15 : m);
+        }
+        else
+            p->tintAmt = 0;
+    }
+    if (++p->t >= p->maxT || Pkbn_MonAnimDone(&p->spr))
+        p->ease = PUPPET_EASE;
+}
