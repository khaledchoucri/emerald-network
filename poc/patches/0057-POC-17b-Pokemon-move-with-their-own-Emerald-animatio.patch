+            if (amt == 0 && pp->tintAmt)
+                flags |= GFX_TINT, color = pp->tint, amt = pp->tintAmt;
+            Gfx_DrawAffine(fb, &img, x + dx + ((flags & GFX_FLIPX) ? -pp->x2 : pp->x2), y - lift + pp->y2,
+                           pp->a, pp->b, pp->c, pp->d, flags, color, amt);
+        }
+    }
     else
         Gfx_Draw(fb, &img, x + dx, y - lift, flags, color, amt);
     Gfx_ClipBottom(9999);
@@ -1624,8 +1759,9 @@ static void VisTrack(u8 s, u8 v)
         sPushT[v]--;
     if (sDashT[v])
         sDashT[v]--;
-    if (sAppearT[v])
-        sAppearT[v]--;
