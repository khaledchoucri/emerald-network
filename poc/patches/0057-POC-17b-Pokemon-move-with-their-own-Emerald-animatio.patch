+void Pkbn_MonAnimStart(struct Sprite *sprite, u8 animId)
+{
+    u32 i;
+    sprite->sDontFlip = TRUE;
+    sprite->data[0] = 0;
+    for (i = 2; i < ARRAY_COUNT(sprite->data); i++)
+        sprite->data[i] = 0;
+    sIsSummaryAnim = FALSE;
+    sprite->callback = sMonAnimFunctions[animId];
+}
