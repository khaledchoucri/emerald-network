+    }
+    else if (sPuppet[VS(side)].on)
+    {
+        // POC-17b: its Emerald animation's pose (mirrored with the picture on the player's side)
+        const struct MonPuppet *pp = &sPuppet[VS(side)];
+        if (!pp->hidden)
