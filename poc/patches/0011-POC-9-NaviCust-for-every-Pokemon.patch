diff --git a/src/pkbn/pkbn_save.c b/src/pkbn/pkbn_save.c
new file mode 100644
index 0000000..07443e1
--- /dev/null
+++ b/src/pkbn/pkbn_save.c
@@ -0,0 +1,151 @@
+// Sidecar save for our own data (POC-9): pkbn.sav next to pokeemerald.sav. PC builds only.
+//
+// Why a separate file: every sector of Emerald's 128 KB flash already has an owner (include/save.h:19-31), and on
+// the 64-bit PC port SaveBlock1 is already 408 bytes larger than the 4 sectors that save it (docs/design/06 §0),
+// so nothing of ours goes into the vanilla save. Written whenever the game saves (TrySavingData), read whenever it
+// loads (LoadGameSave), reset on a new game (NewGameInitData).
+#include "global.h"
+#include "pokemon.h"
+#include "pokemon_storage_system.h"
+#include "pkbn/navicust.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+#define PKBN_SAVE_PATH    "pkbn.sav"
+#define PKBN_SAVE_VERSION 1
+
+struct PkbnSaveFile
+{
+    char magic[8];            // "PKBNSAVE"
+    u16 version;
+    u16 nextId;
+    u16 ncpCount;             // NCP_COUNT when written
+    u16 pad;
+    struct PkbnNavi navis[NAVI_MAX];
+    u8 owned[256];            // programs owned, by gPkbnNcps index
+};
+
+static struct PkbnSaveFile sSave;
+
+void PkbnSave_Reset(void)
+{
+    s32 i;
+    memset(&sSave, 0, sizeof(sSave));
+    memcpy(sSave.magic, "PKBNSAVE", 8);
+    sSave.version = PKBN_SAVE_VERSION;
+    sSave.nextId = 1;
+    sSave.ncpCount = NCP_COUNT;
+    for (i = 0; i < NCP_COUNT; i++)
+        sSave.owned[i] = NCP_OWNED_TEST; // everything unlocked for now (decision of 2026-10-05)
+}
+
+void PkbnSave_Read(void)
+{
+    FILE *f = fopen(PKBN_SAVE_PATH, "rb");
+    struct PkbnSaveFile tmp;
+    s32 i;
+    if (f == NULL || fread(&tmp, 1, sizeof(tmp), f) != sizeof(tmp) || memcmp(tmp.magic, "PKBNSAVE", 8) != 0
+     || tmp.version != PKBN_SAVE_VERSION)
+    {
+        if (f != NULL)
+            fclose(f);
+        PkbnSave_Reset();
+        return;
+    }
+    fclose(f);
+    sSave = tmp;
+    for (i = sSave.ncpCount; i < NCP_COUNT; i++) // programs added since this file was written
+        sSave.owned[i] = NCP_OWNED_TEST;
+    sSave.ncpCount = NCP_COUNT;
+}
+
+void PkbnSave_Write(void)
+{
+    FILE *f = fopen(PKBN_SAVE_PATH, "wb");
+    if (f == NULL)
+        return;
+    fwrite(&sSave, 1, sizeof(sSave), f);
+    fclose(f);
+}
+
+struct PkbnNavi *PkbnSave_FindNavi(u16 id)
+{
+    s32 i;
+    if (id == 0)
+        return NULL;
+    for (i = 0; i < NAVI_MAX; i++)
+        if (sSave.navis[i].id == id)
+            return &sSave.navis[i];
+    return NULL;
+}
+
+static bool8 IdReferenced(u16 id)
+{
+    s32 i, j;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_ENCRYPT_SEPARATOR) == id)
+            return TRUE;
+    for (i = 0; i < TOTAL_BOXES_COUNT; i++)
+        for (j = 0; j < IN_BOX_COUNT; j++)
+            if (GetBoxMonDataAt(i, j, MON_DATA_ENCRYPT_SEPARATOR) == id)
+                return TRUE;
+    return FALSE;
+}
+
+struct PkbnNavi *PkbnSave_NewNavi(void)
+{
+    s32 i, pass;
+    for (pass = 0; pass < 2; pass++)
+    {
+        for (i = 0; i < NAVI_MAX; i++)
+            if (sSave.navis[i].id == 0)
+            {
+                struct PkbnNavi *n = &sSave.navis[i];
+                memset(n, 0, sizeof(*n));
+                for (;;)
+                {
+                    s32 j;
+                    bool8 taken = FALSE;
+                    u16 id = sSave.nextId++;
+                    if (sSave.nextId == 0)
+                        sSave.nextId = 1;
+                    if (id == 0)
+                        continue;
+                    for (j = 0; j < NAVI_MAX; j++)
+                        if (sSave.navis[j].id == id)
+                            taken = TRUE;
+                    if (!taken && !IdReferenced(id))
+                    {
+                        n->id = id;
+                        break;
+                    }
+                }
+                return n;
+            }
+        // full: free the layouts no Pokémon in the party or boxes points at any more (released / traded away)
+        for (i = 0; i < NAVI_MAX; i++)
+            if (sSave.navis[i].id && !IdReferenced(sSave.navis[i].id))
+                sSave.navis[i].id = 0;
+    }
+    return NULL;
+}
+
+u8 Navi_ProgramsOwned(u8 prog)
+{
+    return sSave.owned[prog];
+}
+
+u8 Navi_ProgramsInUse(u8 prog)
+{
+    s32 i, j, n = 0;
+    for (i = 0; i < NAVI_MAX; i++)
+        if (sSave.navis[i].id)
+            for (j = 0; j < sSave.navis[i].count; j++)
+                if (sSave.navis[i].parts[j].prog == prog)
+                    n++;
+    return n > 255 ? 255 : n;
+}
+
+#endif // PORTABLE
