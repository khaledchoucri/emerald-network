+// HP+ and stat programs change the battle copy only; Finish() takes the HP bonus off again.
+static void ApplyNaviToBattleMon(struct BattlePokemon *bm, const struct PkbnNaviStats *n, u16 *hpBonus)
+{
+    *hpBonus = bm->maxHP * n->hpPct / 100;
+    bm->maxHP += *hpBonus;
+    if (bm->hp)
+        bm->hp += *hpBonus;
+    bm->attack  += bm->attack  * n->statPct[STAT_ATK] / 100;
+    bm->defense += bm->defense * n->statPct[STAT_DEF] / 100;
+    bm->spAttack  += bm->spAttack  * n->statPct[STAT_SPATK] / 100;
+    bm->spDefense += bm->spDefense * n->statPct[STAT_SPDEF] / 100;
+    bm->speed   += bm->speed   * n->statPct[STAT_SPEED] / 100;
+    if (n->choiceBand)
+        bm->attack += bm->attack * n->choiceBand / 100;   // Choice Band x1.5
+}
