index 0000000..6e59c5a
--- /dev/null
+++ b/include/pkbn/ncp_table.h
@@ -0,0 +1,68 @@
+// GENERATED by tools/gen_navicust.py from tools/navicust_curated.py - do not edit.
+#ifndef GUARD_PKBN_NCP_TABLE_H
+#define GUARD_PKBN_NCP_TABLE_H
+
+#include "global.h"
+
+enum PkbnNcpEffect
+{
+    NCPE_NONE,
+    NCPE_SUPER_ARMOR,
+    NCPE_HAND,
+    NCPE_FIRST_BARRIER,
+    NCPE_FLOAT_SHOES,
+    NCPE_AIR_SHOES,
+    NCPE_UNDER_SHIRT,
+    NCPE_BUG_STOP,
+    NCPE_BUST_PACK,
+    NCPE_BUSTER_ATK,
+    NCPE_BUSTER_SPEED,
+    NCPE_BUSTER_CHARGE,
+    NCPE_HP_PCT,
+    NCPE_STAT_PCT,
+    NCPE_QUICK_CLAW,
+    NCPE_KINGS_ROCK,
+    NCPE_SCOPE_LENS,
+    NCPE_BRIGHT_POWDER,
+    NCPE_LEFTOVERS,
+    NCPE_SHELL_BELL,
+    NCPE_FOCUS_BAND,
+    NCPE_CHOICE_BAND,
+    NCPE_LUCKY_EGG,
+    NCPE_AMULET_COIN,
+    NCPE_TYPE_BOOST,
+    NCPE_COUNT
+};
+
+enum { NCP_COND_COOL, NCP_COND_BEAUTY, NCP_COND_CUTE, NCP_COND_SMART, NCP_COND_TOUGH, NCP_COND_COUNT };
+
+// Program effects an ability grants (BN-style twins), and flags in compiled results.
+#define NCPF_SUPER_ARMOR (1 << 0)
+#define NCPF_FLOAT_SHOES (1 << 1)
+#define NCPF_AIR_SHOES   (1 << 2)
+#define NCPF_UNDER_SHIRT (1 << 3)
+
+struct PkbnNcpShape { u8 w, h; u8 rows[5]; }; // rows[y] bit x = cell
+
+struct PkbnNcp
+{
+    const char *name;
+    const char *desc;
+    u8 effect;        // NCPE_*
+    u8 arg;           // STAT_* for STAT_PCT, TYPE_* for TYPE_BOOST
+    s16 value;
+    bool8 plus;       // plus part: must not touch the command line
+    u8 group;         // exclusive group (0 = none)
+    u8 bug;           // bug type it causes
+    u8 cond;          // NCP_COND_*: the Pokéblock condition that compresses it
+    u8 typeCount;
+    u8 types[3];      // colour variants
+    struct PkbnNcpShape shape, cshape;
+};
+
+#define NCP_COUNT 48
+extern const struct PkbnNcp gPkbnNcps[NCP_COUNT];
+extern const u8 gPkbnAbilityCells[];   // 1..3 cells of the fixed ability program, by ABILITY_*
+extern const u8 gPkbnAbilityGrants[];  // NCPF_* an ability grants
+
+#endif // GUARD_PKBN_NCP_TABLE_H
