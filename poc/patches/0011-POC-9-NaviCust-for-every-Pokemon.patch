+// PKBN_TEST_POKERUS="slot:byte/...".
+static u8 FindProgram(const char *name, u32 len)
+{
+    u8 i;
+    for (i = 0; i < NCP_COUNT; i++)
+        if (strlen(gPkbnNcps[i].name) == len && strncmp(gPkbnNcps[i].name, name, len) == 0)
+            return i;
+    return 0xFF;
+}
+
+static void ApplyTestNaviCusts(void)
+{
+    const char *t;
+    char buf[512];
+    char *slotSpec, *save1;
+    if ((t = getenv("PKBN_TEST_COND")) != NULL)
+    {
+        strncpy(buf, t, sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = '\0';
+        for (slotSpec = strtok_r(buf, "/", &save1); slotSpec; slotSpec = strtok_r(NULL, "/", &save1))
+        {
+            static const u8 sIds[5] = {MON_DATA_COOL, MON_DATA_BEAUTY, MON_DATA_CUTE, MON_DATA_SMART, MON_DATA_TOUGH};
+            unsigned slot, c[5], i;
+            if (sscanf(slotSpec, "%u:%u,%u,%u,%u,%u", &slot, &c[0], &c[1], &c[2], &c[3], &c[4]) == 6 && slot < PARTY_SIZE)
+                for (i = 0; i < 5; i++)
+                    SetMonData(&gPlayerParty[slot], sIds[i], &c[i]);
+        }
+    }
+    if ((t = getenv("PKBN_TEST_POKERUS")) != NULL)
+    {
+        strncpy(buf, t, sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = '\0';
+        for (slotSpec = strtok_r(buf, "/", &save1); slotSpec; slotSpec = strtok_r(NULL, "/", &save1))
+        {
+            unsigned slot, v;
+            if (sscanf(slotSpec, "%u:%u", &slot, &v) == 2 && slot < PARTY_SIZE)
+                SetMonData(&gPlayerParty[slot], MON_DATA_POKERUS, &v);
+        }
+    }
+    if ((t = getenv("PKBN_TEST_NCP")) != NULL)
+    {
+        strncpy(buf, t, sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = '\0';
+        for (slotSpec = strtok_r(buf, "/", &save1); slotSpec; slotSpec = strtok_r(NULL, "/", &save1))
+        {
+            unsigned slot = (unsigned)atoi(slotSpec);
+            char *part, *save2, *colon = strchr(slotSpec, ':');
+            struct PkbnNavi *navi;
+            struct PkbnNaviOwner owner;
+            if (colon == NULL || slot >= PARTY_SIZE || (navi = Navi_ForMon(&gPlayerParty[slot], TRUE)) == NULL)
+                continue;
+            Navi_OwnerFromMon(&owner, &gPlayerParty[slot]);
+            for (part = strtok_r(colon + 1, ";", &save2); part; part = strtok_r(NULL, ";", &save2))
+            {
+                char *at = strchr(part, '@');
+                int x, y, rot, v = 0;
+                u8 prog;
+                struct PkbnNaviPart np;
+                if (at == NULL || sscanf(at + 1, "%d,%d,%d,%d", &x, &y, &rot, &v) < 3)
+                    continue;
+                prog = FindProgram(part, at - part);
+                if (prog == 0xFF || navi->count >= NAVI_MAX_PARTS)
+                {
+                    printf("[pkbn-selftest] unknown program in %s\n", part);
+                    continue;
+                }
+                np.prog = prog;
+                np.type = gPkbnNcps[prog].types[v < gPkbnNcps[prog].typeCount ? v : 0];
+                np.x = x;
+                np.y = y;
+                np.rot = rot & 3;
+                if (!Navi_CanPlace(navi, &owner, &np, -1))
+                    printf("[pkbn-selftest] can't place %s\n", part);
+                else
+                    navi->parts[navi->count++] = np;
+            }
+        }
+    }
+}
