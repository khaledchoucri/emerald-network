+// NaviCust bugs that run on the clock (player side only has a NaviCust).
+static void NaviBugsTick(u8 side)
+{
+    struct Fighter *f = &sB.f[side];
+    // HP bug: lose 1 HP every N frames. BN6 byte_80102A4 = {40, 35, 30, ...} by level (asm/asm00_2.s:3018);
+    // Pokémon have a tenth of a Navi's HP or less, so ours waits 4x as long (TUNE).
+    if (f->navi.bug[9])
+    {
+        static const u16 sEvery[4] = {0, 160, 140, 120};
+        if (++f->bugHpTimer >= sEvery[f->navi.bug[9]])
+        {
+            f->bugHpTimer = 0;
+            if (f->bm.hp > 1)
+                Moves_DamageFighter(side, 1, NULL);
+        }
+    }
+    // Move bug ("Panel Skip", BN6 bug type 1; its exact BN6 behaviour is UNVERIFIED): a random step every
+    // 300 / 240 / 180 frames (TUNE)
+    if (f->navi.bug[1] && f->moveCd == 0 && !f->hold)
+    {
+        static const u16 sEvery[4] = {0, 300, 240, 180};
+        if (++f->bugMoveTimer >= sEvery[f->navi.bug[1]])
+        {
+            static const s8 sDx[4] = {0, 0, -1, 1}, sDy[4] = {-1, 1, 0, 0};
+            u8 d = Random() % 4;
+            f->bugMoveTimer = 0;
+            if (Field_CanStand(side, f->x + sDx[d], f->y + sDy[d]))
+                Field_Step(side, f->x + sDx[d], f->y + sDy[d]);
+        }
+    }
+    // Status bug: the battle-start status wears off after 300 / 600 frames (BN6 sub_8013E58)
+    if (f->bugStatusTimer && --f->bugStatusTimer == 0)
+    {
+        f->bm.status1 &= ~(STATUS1_PARALYSIS | STATUS1_POISON | STATUS1_BURN);
+        f->confTurns = 0;
+    }
+}
+
+// Status bug at battle start (5 colours: 300 frames, 6+: 600; BN6 asm/asm00_2.s:11273): one of our statuses.
+void Field_NaviStatusBug(u8 side)
+{
+    struct Fighter *f = &sB.f[side];
+    static const char *const sWhat[4] = {"IS PARALYZED! (BUG)", "IS POISONED! (BUG)", "IS BURNED! (BUG)", "IS CONFUSED! (BUG)"};
+    u8 k = Random() % 4;
+    char line[48];
+    switch (k)
+    {
+    case 0: f->bm.status1 |= STATUS1_PARALYSIS; break;
+    case 1: f->bm.status1 |= STATUS1_POISON; break;
+    case 2: f->bm.status1 |= STATUS1_BURN; break;
+    case 3: f->confTurns = 5; break;
+    }
+    f->bugStatusTimer = f->navi.bug[12] ? 600 : 300;
+    snprintf(line, sizeof(line), "%s %s", f->name, sWhat[k]);
+    SetMsg(line, 60);
+    PKBN_LOG("%s", line);
+}
