diff --git a/src/pkbn/navicust.c b/src/pkbn/navicust.c
new file mode 100644
index 0000000..16fd814
--- /dev/null
+++ b/src/pkbn/navicust.c
@@ -0,0 +1,394 @@
+// NaviCust for every Pokémon: shapes, placement, and BN6's compile step ("RUN"). See include/pkbn/navicust.h.
+//
+// The compile follows BN6's sub_813BBD4 (bn6f asm/asm37_0.s:702) and applyNavicustPrograms_813C684 (:2012):
+//   - a plus part touching the command line: a bug of its type (:773)
+//   - a normal part not touching the command line: a bug, and it doesn't run (:839)
+//   - two parts of the same colour touching: a bug each (:889-1076)
+//   - 5 colours: bug 11 +1; 6 or more: bug 12 +2 (:1098)
+//   - a part on the overhang frame: a bug (:1890)
+//   - bug levels cap at 3 (:1158); BugStop clears them (:2782)
+//   - normal parts run from the command line right to left, one per exclusive group (:2018-2052); plus parts run
+//     wherever they are (:2055-2093)
+// Our changes (design, 2026-10-05):
+//   - colours are Pokémon types; the owner's own types never bug when touching and don't count toward the colour
+//     limit
+//   - the owner's ability is a fixed program at the left end of the command line (1-3 cells, its first type)
+//   - a high Emerald condition (Pokéblocks) compresses the programs of that condition (BN6 uses button codes)
+//   - active Pokérus: every bug one level lower and one more colour allowed (a "good bug")
+#include "global.h"
+#include "pokemon.h"
+#include "constants/abilities.h"
+#include "constants/pokemon.h"
+#include "pkbn/navicust.h"
+
+#ifdef PORTABLE
+#include <string.h>
+
+void Navi_OwnerFromMon(struct PkbnNaviOwner *o, struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    memset(o, 0, sizeof(*o));
+    o->species = species;
+    o->ability = GetAbilityBySpecies(species, GetMonData(mon, MON_DATA_ABILITY_NUM));
+    o->types[0] = gSpeciesInfo[species].types[0];
+    o->types[1] = gSpeciesInfo[species].types[1];
+    o->cond[NCP_COND_COOL] = GetMonData(mon, MON_DATA_COOL);
+    o->cond[NCP_COND_BEAUTY] = GetMonData(mon, MON_DATA_BEAUTY);
+    o->cond[NCP_COND_CUTE] = GetMonData(mon, MON_DATA_CUTE);
+    o->cond[NCP_COND_SMART] = GetMonData(mon, MON_DATA_SMART);
+    o->cond[NCP_COND_TOUGH] = GetMonData(mon, MON_DATA_TOUGH);
+    o->pokerus = GetMonData(mon, MON_DATA_POKERUS);
+}
+
+bool8 Navi_IsCompressed(u8 prog, const struct PkbnNaviOwner *owner)
+{
+    return owner->cond[gPkbnNcps[prog].cond] >= NCP_COMPRESS_AT;
+}
+
+// Pokérus byte: high nibble strain, low nibble days left; days == 0 with a strain = cured (pokemon.c CheckPartyPokerus)
+static bool8 PokerusActive(u8 pokerus)
+{
+    return (pokerus & 0xF) != 0;
+}
+
+static bool8 OwnType(const struct PkbnNaviOwner *o, u8 type)
+{
+    return type == o->types[0] || type == o->types[1];
+}
+
+u8 Navi_ShapeCells(u8 prog, bool8 compressed, u8 rot, s8 *dx, s8 *dy)
+{
+    const struct PkbnNcpShape *s = compressed ? &gPkbnNcps[prog].cshape : &gPkbnNcps[prog].shape;
+    u8 n = 0;
+    s32 x, y;
+    for (y = 0; y < s->h; y++)
+        for (x = 0; x < s->w; x++)
+            if (s->rows[y] & (1 << x))
+            {
+                s32 rx = x, ry = y, t;
+                u8 r;
+                for (r = 0; r < (rot & 3); r++)
+                {
+                    // quarter turn clockwise inside the shape's box (w,h swap each turn)
+                    s32 h = (r & 1) ? s->w : s->h;
+                    t = rx;
+                    rx = h - 1 - ry;
+                    ry = t;
+                }
+                dx[n] = rx;
+                dy[n] = ry;
+                n++;
+            }
+    return n;
+}
+
+static void AbilityCells(const struct PkbnNaviOwner *o, u8 *n, s8 *x, s8 *y)
+{
+    u8 size = (o->ability && o->ability < ABILITIES_COUNT) ? gPkbnAbilityCells[o->ability] : 0;
+    *n = 0;
+    if (size >= 1) { x[*n] = 0; y[*n] = NAVI_CMD_ROW; (*n)++; }
+    if (size >= 2) { x[*n] = 1; y[*n] = NAVI_CMD_ROW; (*n)++; }
+    if (size >= 3) { x[*n] = 0; y[*n] = NAVI_CMD_ROW - 1; (*n)++; }
+}
+
+static bool8 OnBoard(s32 x, s32 y)
+{
+    return x >= 0 && x < NAVI_W && y >= 0 && y < NAVI_H;
+}
+
+static bool8 OnFrame(s32 x, s32 y)
+{
+    // the ring around the board, without its corners (byte_813B2CD's 3-cells)
+    if (OnBoard(x, y))
+        return FALSE;
+    if (x >= 0 && x < NAVI_W && (y == -1 || y == NAVI_H))
+        return TRUE;
+    if (y >= 0 && y < NAVI_H && (x == -1 || x == NAVI_W))
+        return TRUE;
+    return FALSE;
+}
+
+bool8 Navi_CanPlace(const struct PkbnNavi *navi, const struct PkbnNaviOwner *owner, const struct PkbnNaviPart *part, s32 skip)
+{
+    s8 dx[25], dy[25], ax[3], ay[3];
+    u8 n = Navi_ShapeCells(part->prog, Navi_IsCompressed(part->prog, owner), part->rot, dx, dy), an, i, j, k;
+    bool8 any = FALSE;
+    AbilityCells(owner, &an, ax, ay);
+    for (i = 0; i < n; i++)
+    {
+        s32 x = part->x + dx[i], y = part->y + dy[i];
+        if (!OnBoard(x, y) && !OnFrame(x, y))
+            return FALSE;     // sub_813BAEC: no cell on a 0-cell
+        if (OnBoard(x, y))
+            any = TRUE;
+        for (k = 0; k < an; k++)
+            if (ax[k] == x && ay[k] == y)
+                return FALSE;
+        for (j = 0; j < navi->count; j++)
+        {
+            s8 ex[25], ey[25];
+            u8 m, q;
+            if ((s32)j == skip)
+                continue;
+            m = Navi_ShapeCells(navi->parts[j].prog, Navi_IsCompressed(navi->parts[j].prog, owner), navi->parts[j].rot, ex, ey);
+            for (q = 0; q < m; q++)
+                if (navi->parts[j].x + ex[q] == x && navi->parts[j].y + ey[q] == y)
+                    return FALSE; // sub_813BB68: overlap
+        }
+    }
+    return any;               // at least one cell on the board
+}
+
+static void AddBug(struct PkbnNaviStats *s, u8 type, u8 amount)
+{
+    if (type && type < NAVI_BUG_TYPES)
+        s->bug[type] += amount;
+}
+
+#define CAP(v, m) do { if ((v) > (m)) (v) = (m); } while (0)
+
+static void Apply(struct PkbnNaviStats *s, const struct PkbnNcp *p)
+{
+    switch (p->effect)
+    {
+    case NCPE_SUPER_ARMOR:   s->flags |= NCPF_SUPER_ARMOR; break;
+    case NCPE_FLOAT_SHOES:   s->flags |= NCPF_FLOAT_SHOES; break;
+    case NCPE_AIR_SHOES:     s->flags |= NCPF_AIR_SHOES; break;
+    case NCPE_UNDER_SHIRT:   s->flags |= NCPF_UNDER_SHIRT; break;
+    case NCPE_FIRST_BARRIER: s->firstBarrier = TRUE; break;
+    case NCPE_BUG_STOP:      s->bugStop = TRUE; break;
+    case NCPE_HAND:          s->hand += p->value; break;
+    case NCPE_BUST_PACK:     s->busterAtk += p->value; s->busterSpeed += p->value; s->busterCharge += p->value; break;
+    case NCPE_BUSTER_ATK:    s->busterAtk += p->value; break;
+    case NCPE_BUSTER_SPEED:  s->busterSpeed += p->value; break;
+    case NCPE_BUSTER_CHARGE: s->busterCharge += p->value; break;
+    case NCPE_HP_PCT:        s->hpPct += p->value; break;
+    case NCPE_STAT_PCT:      s->statPct[p->arg] += p->value; break;
+    case NCPE_TYPE_BOOST:    s->typePct[p->arg] += p->value; break;
+    case NCPE_QUICK_CLAW:    s->quickClaw = p->value; break;
+    case NCPE_KINGS_ROCK:    s->kingsRock = p->value; break;
+    case NCPE_SCOPE_LENS:    s->scopeLens += p->value; break;
+    case NCPE_BRIGHT_POWDER: s->brightPowder = p->value; break;
+    case NCPE_LEFTOVERS:     s->leftovers = p->value; break;
+    case NCPE_SHELL_BELL:    s->shellBell = p->value; break;
+    case NCPE_FOCUS_BAND:    s->focusBand = p->value; break;
+    case NCPE_CHOICE_BAND:   s->choiceBand = p->value; break;
+    case NCPE_LUCKY_EGG:     s->luckyEgg = p->value; break;
+    case NCPE_AMULET_COIN:   s->amuletCoin = p->value; break;
+    }
+}
+
+void Navi_Compile(const struct PkbnNavi *navi, const struct PkbnNaviOwner *owner, struct PkbnNaviStats *s, struct PkbnNaviBoard *b)
+{
+    struct PkbnNaviBoard local;
+    s8 cx[NAVI_MAX_PARTS][25], cy[NAVI_MAX_PARTS][25], ax[3], ay[3];
+    u8 cn[NAVI_MAX_PARTS], an;
+    bool8 onLine[NAVI_MAX_PARTS];
+    bool8 groupUsed[16];
+    u32 colourMask = 0;
+    s32 i, j, k, x, y, colours = 0;
+
+    if (b == NULL)
+        b = &local;
+    memset(s, 0, sizeof(*s));
+    memset(b, 0, sizeof(*b));
+    memset(groupUsed, 0, sizeof(groupUsed));
+
+    // the fixed ability program
+    AbilityCells(owner, &an, ax, ay);
+    b->abilityCells = an;
+    for (k = 0; k < an; k++)
+        b->cell[ay[k] + 1][ax[k] + 1] = NCELL_ABILITY;
+    if (owner->ability < ABILITIES_COUNT)
+        s->flags |= gPkbnAbilityGrants[owner->ability];
+
+    // lay the parts down
+    for (i = 0; i < navi->count; i++)
+    {
+        const struct PkbnNaviPart *p = &navi->parts[i];
+        b->partCompressed[i] = Navi_IsCompressed(p->prog, owner);
+        cn[i] = Navi_ShapeCells(p->prog, b->partCompressed[i], p->rot, cx[i], cy[i]);
+        onLine[i] = FALSE;
+        for (k = 0; k < cn[i]; k++)
+        {
+            x = p->x + cx[i][k];
+            y = p->y + cy[i][k];
+            if (y == NAVI_CMD_ROW && OnBoard(x, y))
+                onLine[i] = TRUE;
+            if (x >= -1 && x <= NAVI_W && y >= -1 && y <= NAVI_H)
+            {
+                b->cell[y + 1][x + 1] = NCELL_PART;
+                b->part[y + 1][x + 1] = i;
+            }
+        }
+        if (!OwnType(owner, p->type) && !(colourMask & (1u << p->type)))
+        {
+            colourMask |= 1u << p->type;
+            colours++;
+        }
+    }
+    s->colours = colours;
+
+    // bugs (sub_813BBD4)
+    for (i = 0; i < navi->count; i++)
+    {
+        const struct PkbnNaviPart *p = &navi->parts[i];
+        const struct PkbnNcp *ncp = &gPkbnNcps[p->prog];
+        bool8 bugged = FALSE;
+        if (ncp->plus && onLine[i])
+            bugged = TRUE;            // plus part on the command line
+        if (!ncp->plus && !onLine[i])
+            bugged = TRUE;            // normal part off the command line
+        for (k = 0; k < cn[i]; k++)
+            if (OnFrame(p->x + cx[i][k], p->y + cy[i][k]))
+                bugged = TRUE;        // on the overhang frame
+        if (bugged)
+            AddBug(s, ncp->bug, 1);
+        b->partBugged[i] = bugged;
+    }
+    // same colour touching (not the owner's own types)
+    for (i = 0; i < navi->count; i++)
+    {
+        const struct PkbnNaviPart *p = &navi->parts[i];
+        bool8 touching = FALSE;
+        if (OwnType(owner, p->type))
+            continue;
+        for (j = 0; j < navi->count && !touching; j++)
+        {
+            s32 a, c;
+            if (j == i || navi->parts[j].type != p->type)
+                continue;
+            for (a = 0; a < cn[i] && !touching; a++)
+                for (c = 0; c < cn[j] && !touching; c++)
+                {
+                    s32 ddx = (p->x + cx[i][a]) - (navi->parts[j].x + cx[j][c]);
+                    s32 ddy = (p->y + cy[i][a]) - (navi->parts[j].y + cy[j][c]);
+                    if ((ddx == 0 && (ddy == 1 || ddy == -1)) || (ddy == 0 && (ddx == 1 || ddx == -1)))
+                        touching = TRUE;
+                }
+        }
+        if (touching)
+        {
+            AddBug(s, gPkbnNcps[p->prog].bug, 1);
+            b->partBugged[i] = TRUE;
+        }
+    }
+    // colour count (sub_813BEA8): 4 is fine; active Pokérus allows one more
+    {
+        s32 limit = 4 + (PokerusActive(owner->pokerus) ? 1 : 0);
+        if (colours == limit + 1)
+            AddBug(s, 11, 1);
+        else if (colours > limit + 1)
+            AddBug(s, 12, 2);
+    }
+    for (k = 0; k < NAVI_BUG_TYPES; k++)
+    {
+        if (PokerusActive(owner->pokerus) && s->bug[k])
+        {
+            s->bug[k]--;
+            s->pokerus = TRUE;
+        }
+        CAP(s->bug[k], 3);   // sub_813BF0C
+    }
+
+    // run (applyNavicustPrograms_813C684): command line right to left, one per group, then plus parts
+    for (x = NAVI_W - 1; x >= 0; x--)
+    {
+        if (b->cell[NAVI_CMD_ROW + 1][x + 1] != NCELL_PART)
+            continue;
+        i = b->part[NAVI_CMD_ROW + 1][x + 1];
+        if (b->partRuns[i] || gPkbnNcps[navi->parts[i].prog].plus)
+            continue;
+        if (gPkbnNcps[navi->parts[i].prog].group)
+        {
+            if (groupUsed[gPkbnNcps[navi->parts[i].prog].group])
+                continue;
+            groupUsed[gPkbnNcps[navi->parts[i].prog].group] = TRUE;
+        }
+        b->partRuns[i] = TRUE;
+        Apply(s, &gPkbnNcps[navi->parts[i].prog]);
+        s->programsRun++;
+    }
+    for (i = 0; i < navi->count; i++)
+        if (gPkbnNcps[navi->parts[i].prog].plus)
+        {
+            b->partRuns[i] = TRUE;
+            Apply(s, &gPkbnNcps[navi->parts[i].prog]);
+            s->programsRun++;
+        }
+
+    // BN6 caps (asm/asm37_0.s:2180-2780) and ours (TUNE)
+    CAP(s->hand, 3);                       // Custom: hand 5 -> 8 at most (BN6 CustomLevel caps at 8)
+    s->busterAtk += 1; s->busterSpeed += 1; s->busterCharge += 1;
+    CAP(s->busterAtk, 5); CAP(s->busterSpeed, 5); CAP(s->busterCharge, 5);   // BN6 levels 1-5 (cap 4 extra)
+    CAP(s->hpPct, 50);
+    for (k = 0; k < NUM_BATTLE_STATS; k++)
+        CAP(s->statPct[k], 30);
+    for (k = 0; k < NUMBER_OF_MON_TYPES; k++)
+        CAP(s->typePct[k], 30);
+    CAP(s->scopeLens, 2);
+    if (s->bugStop)
+        memset(s->bug, 0, sizeof(s->bug));
+}
+
+struct PkbnNavi *Navi_ForMon(struct Pokemon *mon, bool8 create)
+{
+    u32 id;
+    struct PkbnNavi *n;
+    if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG))
+        return NULL;
+    id = GetMonData(mon, MON_DATA_ENCRYPT_SEPARATOR);
+    n = PkbnSave_FindNavi(id);
+    if (n != NULL || !create)
+        return n;
+    n = PkbnSave_NewNavi();
+    if (n != NULL)
+    {
+        id = n->id;
+        SetMonData(mon, MON_DATA_ENCRYPT_SEPARATOR, &id);
+    }
+    return n;
+}
+
+void Navi_StatsForMon(struct Pokemon *mon, struct PkbnNaviStats *out)
+{
+    struct PkbnNaviOwner owner;
+    struct PkbnNavi empty;
+    struct PkbnNavi *n = Navi_ForMon(mon, FALSE);
+    Navi_OwnerFromMon(&owner, mon);
+    if (n == NULL)
+    {
+        memset(&empty, 0, sizeof(empty));
+        n = &empty;
+    }
+    Navi_Compile(n, &owner, out, NULL);
+}
+
+const char *Navi_BugShort(u8 t)
+{
+    switch (t)
+    {
+    case 1: return "MOV"; case 3: return "PNL"; case 4: return "CUS"; case 6: return "COL";
+    case 7: return "BUS"; case 9: return "HP"; case 11: return "ST"; case 12: return "ST+";
+    }
+    return "?";
+}
+
+const char *Navi_BugName(u8 t)
+{
+    // what each bug does in our battles (BN6 byte_813CC18 types, asm/asm37_0.s:2819)
+    switch (t)
+    {
+    case 1:  return "MOVE BUG";     // panel skip: you step by yourself
+    case 3:  return "PANEL BUG";    // panels crack under you
+    case 4:  return "CUSTOM BUG";   // fewer chips from a later turn
+    case 6:  return "COLLECT BUG";  // smaller rewards
+    case 7:  return "BUSTER BUG";   // the buster misfires
+    case 9:  return "HP BUG";       // HP drains
+    case 11: return "STATUS BUG";   // a status at battle start
+    case 12: return "STATUS BUG+";
+    }
+    return "BUG";
+}
+
+#endif // PORTABLE
diff --git a/src/pkbn/navicust_ui.c b/src/pkbn/navicust_ui.c
new file mode 100644
index 0000000..d1ac3d4
--- /dev/null
+++ b/src/pkbn/navicust_ui.c
@@ -0,0 +1,624 @@
+// The NaviCust editor (POC-9): opened from the party menu ("NAVICUST"). Drawn on our 264x176 canvas.
+//
+// Controls (BN6's NaviCust, adapted to a list on the right):
+//   program list:  Up/Down choose, A pick the program up, LEFT go to the board, START run, B leave
+//   placing:       D-pad move, L/R turn, SELECT change colour (type), A put it down, B cancel
+//   board:         D-pad move the cursor, A pick a placed program up again, RIGHT/B back to the list
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "battle_main.h"
+#include "data.h"
+#include "main.h"
+#include "pokemon.h"
