diff --git a/include/pkbn/navicust.h b/include/pkbn/navicust.h
new file mode 100644
index 0000000..d0334d4
--- /dev/null
+++ b/include/pkbn/navicust.h
@@ -0,0 +1,108 @@
+#ifndef GUARD_PKBN_NAVICUST_H
+#define GUARD_PKBN_NAVICUST_H
+
+// NaviCust for every Pokémon (POC-9). docs/design/07-navicust.md.
+//
+// Board: BN6's middle board, 5 wide x 4 tall (byte_813B2CD, bn6f data/dat36.s:1340), the command line is its 3rd row
+// (row y=3 of BN6's 7x7 space, asm/asm37_0.s:732) and an overhang frame rings it (cells there cause a bug,
+// asm/asm37_0.s:1890). Programs: src/pkbn/ncp_table.c (tools/navicust_curated.py).
+//
+// Storage: each Pokémon carries a "Navi ID" in BoxPokemon.unknown (MON_DATA_ENCRYPT_SEPARATOR: unencrypted and
+// outside the checksum, src/pokemon.c:2790/3827); its layout lives in the sidecar save pkbn.sav (src/pkbn/pkbn_save.c).
+#include "global.h"
+#include "main.h"
+#include "pkbn/ncp_table.h"
+
+#define NAVI_W        5
+#define NAVI_H        4
+#define NAVI_CMD_ROW  2       // the command line
+#define NAVI_MAX_PARTS 20
+#define NAVI_MAX      600     // layouts kept in pkbn.sav (party + 14 boxes x 30 = 426, plus room)
+#define NAVI_BUG_TYPES 13     // BN6 bug types 1..12 (index 0 unused)
+#define NCP_COMPRESS_AT 80    // TUNE: a condition this high (Pokéblocks) compresses the matching programs
+#define NCP_OWNED_TEST  9     // "everything unlocked for now": 9 of each (BN6's max per program, asm/asm03_1_1.s:8326)
+
+struct PkbnNaviPart
+{
+    u8 prog;      // index into gPkbnNcps
+    u8 type;      // colour variant (TYPE_*)
+    s8 x, y;      // board cell of the shape's top-left corner (can be -1 / past the edge: the overhang frame)
+    u8 rot;       // 0-3 quarter turns clockwise
+};
+
+struct PkbnNavi
+{
+    u16 id;       // 0 = free slot
+    u8 count;
+    u8 pad;
+    struct PkbnNaviPart parts[NAVI_MAX_PARTS];
+};
+
+// What a layout compiles to (BN6's "RUN"): the abilities a battle uses.
+struct PkbnNaviStats
+{
+    u8 flags;                 // NCPF_*
+    bool8 firstBarrier;
+    bool8 bugStop;
+    u8 hand;                  // extra chips in the Custom hand (0-3)
+    u8 busterAtk, busterSpeed, busterCharge;   // BN6 levels 1-5 (base 1)
+    u8 hpPct;                 // max HP bonus in battle, %
+    u8 statPct[NUM_BATTLE_STATS];
+    u8 typePct[NUMBER_OF_MON_TYPES];
+    u8 quickClaw, kingsRock, scopeLens, brightPowder, leftovers, shellBell, focusBand, choiceBand;
+    u8 luckyEgg, amuletCoin;
+    u8 bug[NAVI_BUG_TYPES];   // bug levels 0-3 by BN6 bug type
+    u8 colours;               // distinct colours that count toward BN6's colour limit
+    bool8 pokerus;            // active Pokérus softened the bugs
+    u8 programsRun;
+};
+
+// One cell of the compiled board, for the editor.
+enum { NCELL_EMPTY, NCELL_ABILITY, NCELL_PART };
+
+struct PkbnNaviBoard
+{
+    u8 cell[NAVI_H + 2][NAVI_W + 2];   // [y+1][x+1]: NCELL_*  (frame included)
+    u8 part[NAVI_H + 2][NAVI_W + 2];   // part index for NCELL_PART
+    u8 abilityCells;
+    bool8 partRuns[NAVI_MAX_PARTS];
+    bool8 partBugged[NAVI_MAX_PARTS];
+    bool8 partCompressed[NAVI_MAX_PARTS];
+};
+
+// Who the board belongs to (taken from a Pokémon).
+struct PkbnNaviOwner
+{
+    u16 species;
+    u8 ability;
+    u8 types[2];
+    u8 cond[NCP_COND_COUNT];  // cool, beauty, cute, smart, tough
+    u8 pokerus;               // MON_DATA_POKERUS byte
+};
+
+void Navi_OwnerFromMon(struct PkbnNaviOwner *owner, struct Pokemon *mon);
+// The cells (board coordinates relative to the shape origin) of a program, rotated; returns the count.
+u8 Navi_ShapeCells(u8 prog, bool8 compressed, u8 rot, s8 *dx, s8 *dy);
+bool8 Navi_IsCompressed(u8 prog, const struct PkbnNaviOwner *owner);
+// Can `part` go on `navi` (ignoring part index `skip`, e.g. the one being moved)? Fills nothing.
+bool8 Navi_CanPlace(const struct PkbnNavi *navi, const struct PkbnNaviOwner *owner, const struct PkbnNaviPart *part, s32 skip);
+void Navi_Compile(const struct PkbnNavi *navi, const struct PkbnNaviOwner *owner, struct PkbnNaviStats *out, struct PkbnNaviBoard *board);
+// The layout of a Pokémon; create = give it a Navi ID (and an empty layout) when it has none. NULL if none.
+struct PkbnNavi *Navi_ForMon(struct Pokemon *mon, bool8 create);
+void Navi_StatsForMon(struct Pokemon *mon, struct PkbnNaviStats *out);
+u8 Navi_ProgramsInUse(u8 prog);        // copies placed on all Pokémon
+u8 Navi_ProgramsOwned(u8 prog);
+const char *Navi_BugName(u8 bugType);
+const char *Navi_BugShort(u8 bugType);
+
+// Sidecar save (src/pkbn/pkbn_save.c)
+void PkbnSave_Reset(void);
+void PkbnSave_Read(void);
+void PkbnSave_Write(void);
+struct PkbnNavi *PkbnSave_FindNavi(u16 id);
+struct PkbnNavi *PkbnSave_NewNavi(void);
+
+// Editor (src/pkbn/navicust_ui.c): opens for a party slot, returns to `exitCallback`.
+void PkbnNaviCust_Open(u8 partySlot, MainCallback exitCallback);
+
+#endif // GUARD_PKBN_NAVICUST_H
diff --git a/include/pkbn/ncp_table.h b/include/pkbn/ncp_table.h
