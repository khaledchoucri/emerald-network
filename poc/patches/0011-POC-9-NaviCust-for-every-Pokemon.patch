+// ---- text helpers ---------------------------------------------------------------------------------------------
+
+static s32 Text(u16 *fb, s32 x, s32 y, const char *s, u16 col)
+{
+    return Pkbn_DrawEmText(fb, x, y, s, PKBN_FONT_SMALL, col, RGB(2, 2, 5));
+}
+
+// Word-wrap `s` into at most `lines` lines of `width` pixels, starting at (x, y), 10 px apart.
+static void TextWrap(u16 *fb, s32 x, s32 y, s32 width, s32 lines, const char *s, u16 col)
+{
+    char line[96];
+    while (*s && lines-- > 0)
+    {
+        s32 n = 0, lastSpace = -1;
+        while (s[n])
+        {
+            char tmp[96];
+            memcpy(tmp, s, n + 1);
+            tmp[n + 1] = '\0';
+            if (Pkbn_EmTextWidth(tmp, PKBN_FONT_SMALL) > width)
+                break;
+            if (s[n] == ' ')
+                lastSpace = n;
+            n++;
+        }
+        if (s[n] && lastSpace > 0)
+            n = lastSpace;
+        memcpy(line, s, n);
+        line[n] = '\0';
+        Text(fb, x, y, line, col);
+        y += 10;
+        s += n;
+        while (*s == ' ')
+            s++;
+    }
+}
+
+static void Hint(u16 *fb, s32 y, const char *s)
+{
+    Text(fb, LIST_X - 10 - Pkbn_EmTextWidth(s, PKBN_FONT_SMALL), y, s, RGB(14, 16, 20));
+}
+
+static void Note(const char *s)
+{
+    snprintf(sN.note, sizeof(sN.note), "%s", s);
+    sN.noteTimer = 90;
+}
+
+static u8 Available(u8 prog)
+{
+    u8 owned = Navi_ProgramsOwned(prog), used = Navi_ProgramsInUse(prog);
+    return owned > used ? owned - used : 0;
+}
+
+static void Recompile(void)
+{
+    Navi_Compile(sN.navi, &sN.owner, &sN.stats, &sN.board);
+}
+
+// ---- drawing ------------------------------------------------------------------------------------------------
+
+static void CellRect(s32 x, s32 y, s32 *px, s32 *py)
+{
+    *px = BOARD_X + x * CELL;
+    *py = BOARD_Y + y * CELL;
+}
+
+static void DrawCellFill(u16 *fb, s32 x, s32 y, u16 col, u8 alpha16)
+{
+    s32 px, py;
+    CellRect(x, y, &px, &py);
+    if (alpha16 >= 16)
+    {
+        Pkbn_FillRect(fb, px + 1, py + 1, CELL - 2, CELL - 2, col);
+        Pkbn_FillRect(fb, px + 1, py + 1, CELL - 2, 2, Gfx_Blend(col, RGB(31, 31, 31), 7));      // bevel light
+        Pkbn_FillRect(fb, px + 1, py + 1, 2, CELL - 2, Gfx_Blend(col, RGB(31, 31, 31), 5));
+        Pkbn_FillRect(fb, px + 1, py + CELL - 3, CELL - 2, 2, Gfx_Blend(col, RGB(0, 0, 0), 7));  // bevel dark
+        Pkbn_FillRect(fb, px + CELL - 3, py + 1, 2, CELL - 2, Gfx_Blend(col, RGB(0, 0, 0), 6));
+    }
+    else
+        Gfx_FillBlend(fb, px + 1, py + 1, CELL - 2, CELL - 2, col, alpha16);
+}
+
+static bool8 OnFrame(s32 x, s32 y)
+{
+    if (x >= 0 && x < NAVI_W && y >= 0 && y < NAVI_H)
+        return FALSE;
+    return (x >= 0 && x < NAVI_W && (y == -1 || y == NAVI_H)) || (y >= 0 && y < NAVI_H && (x == -1 || x == NAVI_W));
+}
+
+static void DrawBoard(u16 *fb)
+{
+    s32 x, y, i;
+    struct PkbnImage img = Gfx_MonImage(&sN.pic, 0);
+    // the Navi behind its board, dimmed (BN6 shows the Navi on the NaviCust screen)
+    Gfx_ClipRect(BOARD_X - CELL, BOARD_Y - CELL, BOARD_X + (NAVI_W + 1) * CELL, BOARD_Y + (NAVI_H + 1) * CELL);
+    Gfx_Draw(fb, &img, BOARD_X + NAVI_W * CELL / 2, BOARD_Y + NAVI_H * CELL + 6, GFX_TINT, RGB(4, 6, 14), 11);
+    Gfx_ClipNone();
+
+    for (y = -1; y <= NAVI_H; y++)
+        for (x = -1; x <= NAVI_W; x++)
+        {
+            s32 px, py;
+            CellRect(x, y, &px, &py);
+            if (OnFrame(x, y))
+            {
+                // the overhang frame: usable, but a program here bugs (BN6's 3-cells)
+                Gfx_FillBlend(fb, px, py, CELL, CELL, RGB(10, 4, 6), 8);
+                for (i = 0; i < CELL; i += 4)
+                    Gfx_FillBlend(fb, px + i, py, 1, CELL, RGB(20, 8, 10), 6);
+            }
+            else if (x >= 0 && x < NAVI_W && y >= 0 && y < NAVI_H)
+            {
+                Gfx_FillBlend(fb, px, py, CELL, CELL, RGB(3, 6, 16), 12);
+                Pkbn_FrameRect(fb, px, py, CELL, CELL, RGB(8, 14, 26));
+            }
+        }
+    // the command line (BN6: row 3 of the 7x7 space, the 3rd row of this board)
+    {
+        s32 px, py;
+        CellRect(-1, NAVI_CMD_ROW, &px, &py);
+        Gfx_FillBlend(fb, px, py + CELL / 2 - 2, (NAVI_W + 2) * CELL, 4, RGB(31, 26, 6), 10);
+    }
+    // ability (fixed) and placed parts
+    for (y = -1; y <= NAVI_H; y++)
+        for (x = -1; x <= NAVI_W; x++)
+        {
+            u8 c = sN.board.cell[y + 1][x + 1];
+            if (c == NCELL_ABILITY)
+            {
+                s32 px, py;
+                DrawCellFill(fb, x, y, Vfx_TypeColor(sN.owner.types[0]), 16);
+                CellRect(x, y, &px, &py);
+                for (i = 2; i < CELL - 2; i += 4)  // a "locked" hatching
+                    Gfx_FillBlend(fb, px + i, py + 2, 1, CELL - 4, RGB(0, 0, 0), 5);
+            }
+            else if (c == NCELL_PART)
+            {
+                u8 p = sN.board.part[y + 1][x + 1];
+                const struct PkbnNaviPart *part = &sN.navi->parts[p];
+                u16 col = Vfx_TypeColor(part->type);
+                s32 px, py;
+                DrawCellFill(fb, x, y, col, 16);
+                CellRect(x, y, &px, &py);
+                if (sN.board.partBugged[p] && ((sN.t / 8) & 1))
+                    Pkbn_FrameRect(fb, px + 1, py + 1, CELL - 2, CELL - 2, RGB(31, 4, 4));
+                // joins: no inner border between two cells of the same part
+                if (x + 1 <= NAVI_W && sN.board.cell[y + 1][x + 2] == NCELL_PART && sN.board.part[y + 1][x + 2] == p)
+                    Pkbn_FillRect(fb, px + CELL - 3, py + 3, 4, CELL - 6, col);
+                if (y + 1 <= NAVI_H && sN.board.cell[y + 2][x + 1] == NCELL_PART && sN.board.part[y + 2][x + 1] == p)
+                    Pkbn_FillRect(fb, px + 3, py + CELL - 3, CELL - 6, 4, col);
+            }
+        }
+    // a label on each part's first cell
+    for (i = 0; i < sN.navi->count; i++)
+    {
+        s8 dx[25], dy[25];
+        const struct PkbnNaviPart *part = &sN.navi->parts[i];
+        u8 n = Navi_ShapeCells(part->prog, sN.board.partCompressed[i], part->rot, dx, dy);
+        s32 px, py;
+        char tag[4];
+        if (n == 0)
+            continue;
+        CellRect(part->x + dx[0], part->y + dy[0], &px, &py);
+        snprintf(tag, sizeof(tag), "%.2s", gPkbnNcps[part->prog].name);
+        Text(fb, px + 3, py + 2, tag, sN.board.partRuns[i] ? RGB(31, 31, 31) : RGB(14, 14, 16));
+        if (sN.board.partCompressed[i])
+            Text(fb, px + 12, py + 7, "c", RGB(31, 31, 20));
+    }
+    // the ability's label
+    if (sN.board.abilityCells)
+    {
+        s32 px, py;
+        CellRect(0, NAVI_CMD_ROW, &px, &py);
+        Text(fb, px + 3, py + 2, "AB", RGB(31, 31, 31));
+    }
+}
+
+static void DrawGhost(u16 *fb)
+{
+    s8 dx[25], dy[25];
+    u8 n = Navi_ShapeCells(sN.ghost.prog, Navi_IsCompressed(sN.ghost.prog, &sN.owner), sN.ghost.rot, dx, dy), i;
+    bool8 ok = Navi_CanPlace(sN.navi, &sN.owner, &sN.ghost, -1);
+    u16 col = ok ? Vfx_TypeColor(sN.ghost.type) : RGB(31, 4, 4);
+    for (i = 0; i < n; i++)
+    {
+        s32 px, py;
+        CellRect(sN.ghost.x + dx[i], sN.ghost.y + dy[i], &px, &py);
+        Gfx_FillBlend(fb, px + 2, py + 2, CELL - 4, CELL - 4, col, (sN.t & 8) ? 13 : 9);
+        Pkbn_FrameRect(fb, px + 1, py + 1, CELL - 2, CELL - 2, ok ? RGB(31, 31, 31) : RGB(31, 10, 10));
+    }
+}
+
+static void DrawList(u16 *fb)
+{
+    s32 i;
+    char line[24];
+    Draw_Box(fb, LIST_X - 4, LIST_Y - 2, CW - LIST_X + 2, LIST_ROWS * ROW_H + 4, RGB(3, 5, 12), RGB(20, 24, 31), 14);
+    for (i = 0; i < LIST_ROWS && sN.listTop + i < NCP_COUNT; i++)
+    {
+        u8 prog = sN.listTop + i;
+        s32 y = LIST_Y + i * ROW_H;
+        u8 avail = Available(prog);
+        bool8 cur = prog == sN.listCursor;
+        if (cur)
+            Gfx_FillBlend(fb, LIST_X - 2, y, CW - LIST_X - 2, ROW_H, RGB(31, 26, 6), (sN.mode == M_LIST) ? 8 : 4);
+        Pkbn_FillRect(fb, LIST_X, y + 2, 6, 7, Vfx_TypeColor(gPkbnNcps[prog].types[0]));
+        Text(fb, LIST_X + 9, y - 2, gPkbnNcps[prog].name, avail ? RGB(31, 31, 31) : RGB(14, 14, 16));
+        snprintf(line, sizeof(line), "x%u", avail);
+        Text(fb, CW - 18, y - 2, line, avail ? RGB(31, 27, 8) : RGB(14, 14, 16));
+    }
+    // scroll marks
+    if (sN.listTop > 0)
+        Text(fb, CW - 30, LIST_Y - 14, "^", RGB(31, 31, 31));
+    if (sN.listTop + LIST_ROWS < NCP_COUNT)
+        Text(fb, CW - 30, LIST_Y + LIST_ROWS * ROW_H - 4, "~", RGB(31, 31, 31));
+}
+
+static void DrawPreview(u16 *fb)
+{
+    const struct PkbnNcp *p = &gPkbnNcps[sN.listCursor];
+    s8 dx[25], dy[25];
+    bool8 comp = Navi_IsCompressed(sN.listCursor, &sN.owner);
+    u8 n = Navi_ShapeCells(sN.listCursor, comp, 0, dx, dy), i, t;
+    s32 y = LIST_Y + LIST_ROWS * ROW_H + 6;
+    Draw_Box(fb, LIST_X - 4, y, CW - LIST_X + 2, CH - y - 1, RGB(3, 5, 12), RGB(20, 24, 31), 14);
+    for (i = 0; i < n; i++)
+        Pkbn_FillRect(fb, LIST_X + 2 + dx[i] * 7, y + 4 + dy[i] * 7, 6, 6, Vfx_TypeColor(p->types[0]));
+    Text(fb, LIST_X + 40, y - 1, p->plus ? "PLUS PART" : "ON THE LINE", p->plus ? RGB(16, 28, 31) : RGB(31, 26, 6));
+    {
+        static const char *const sCond[NCP_COND_COUNT] = {"COOL", "BEAUTY", "CUTE", "SMART", "TOUGH"};
+        char line[24];
+        snprintf(line, sizeof(line), comp ? "COMPRESSED!" : "%s %u/%u", sCond[p->cond], sN.owner.cond[p->cond], NCP_COMPRESS_AT);
+        Text(fb, LIST_X + 40, y + 9, line, comp ? RGB(31, 31, 20) : RGB(16, 18, 22));
+    }
+    // colour variants
+    for (t = 0; t < p->typeCount; t++)
+    {
+        struct PkbnImage icon = Gfx_TypeIcon(p->types[t]);
+        Gfx_Draw(fb, &icon, LIST_X - 1 + t * 35, y + 27, 0, 0, 0);
+    }
+}
+
+static void DrawInfo(u16 *fb)
+{
+    char line[80];
+    s32 y = BOARD_Y + (NAVI_H + 1) * CELL + 2, x, k;
+    Draw_Box(fb, 2, y, LIST_X - 8, CH - y - 1, RGB(3, 5, 12), RGB(20, 24, 31), 14);
+    if (sN.noteTimer)
+    {
+        Text(fb, 6, y + 1, sN.note, RGB(31, 26, 6));
+        return;
+    }
+    if (sN.mode == M_LIST || sN.mode == M_PLACE)
+    {
+        const struct PkbnNcp *p = &gPkbnNcps[sN.mode == M_PLACE ? sN.ghost.prog : sN.listCursor];
+        Text(fb, 6, y + 1, p->name, RGB(31, 31, 31));
+        Hint(fb, y + 1, sN.mode == M_PLACE ? "L/R:TURN A:PUT" : "A:PICK START:RUN");
+        TextWrap(fb, 6, y + 11, LIST_X - 16, 2, p->desc, RGB(22, 26, 31));
+        return;
+    }
+    if (sN.mode == M_BOARD)
+    {
+        u8 c = sN.board.cell[sN.by + 1][sN.bx + 1];
+        if (c == NCELL_ABILITY)
+        {
+            char ab[ABILITY_NAME_LENGTH + 4];
+            Pkbn_GameStringToAscii(ab, gAbilityNames[sN.owner.ability], sizeof(ab));
+            snprintf(line, sizeof(line), "%s (ABILITY)", ab);
+            Text(fb, 6, y + 1, line, RGB(31, 31, 31));
+            Pkbn_GameTextToAscii(line, gAbilityDescriptionPointers[sN.owner.ability], sizeof(line));
+            TextWrap(fb, 6, y + 11, LIST_X - 16, 2, line, RGB(22, 26, 31));
+        }
+        else if (c == NCELL_PART)
+        {
+            u8 p = sN.board.part[sN.by + 1][sN.bx + 1];
+            const struct PkbnNcp *ncp = &gPkbnNcps[sN.navi->parts[p].prog];
+            snprintf(line, sizeof(line), "%s%s%s", ncp->name, sN.board.partRuns[p] ? "" : "  (NOT RUNNING)",
+                     sN.board.partBugged[p] ? "  BUG!" : "");
+            Text(fb, 6, y + 1, line, sN.board.partBugged[p] ? RGB(31, 10, 8) : RGB(31, 31, 31));
+            TextWrap(fb, 6, y + 11, LIST_X - 16, 2, ncp->desc, RGB(22, 26, 31));
+        }
+        else
+            Text(fb, 6, y + 1, "(EMPTY)", RGB(22, 26, 31));
+        if (c != NCELL_ABILITY)
+            Hint(fb, y + 1, "A:MOVE  B:LIST");
+        return;
+    }
+    // M_RESULT: BN6's RUN
+    x = Text(fb, 6, y + 1, "RUN: ", RGB(31, 31, 31));
+    {
+        bool8 bugs = FALSE;
+        for (k = 1; k < NAVI_BUG_TYPES; k++)
+            if (sN.stats.bug[k])
+                bugs = TRUE;
+        if (!bugs)
+            Text(fb, x, y + 1, "OK! NO BUGS", RGB(10, 31, 12));
+        else
+        {
+            line[0] = '\0';
+            for (k = 1; k < NAVI_BUG_TYPES; k++)
+                if (sN.stats.bug[k])
+                    snprintf(line + strlen(line), sizeof(line) - strlen(line), "%s%u ", Navi_BugShort(k), sN.stats.bug[k]);
+            x = Text(fb, x, y + 1, "BUG! ", ((sN.t / 8) & 1) ? RGB(31, 8, 6) : RGB(31, 20, 8));
+            Text(fb, x, y + 1, line, RGB(31, 14, 10));
+        }
+    }
+    snprintf(line, sizeof(line), "HAND+%u  BUSTER %u/%u/%u  HP+%u%%%s%s", sN.stats.hand, sN.stats.busterAtk,
+             sN.stats.busterSpeed, sN.stats.busterCharge, sN.stats.hpPct, sN.stats.pokerus ? "  PKRUS" : "",
+             sN.stats.firstBarrier ? "  BARRIER" : "");
+    Text(fb, 6, y + 11, line, RGB(22, 26, 31));
+    snprintf(line, sizeof(line), "%s%s%s%s  COLOURS %u", (sN.stats.flags & NCPF_SUPER_ARMOR) ? "ARMOR " : "",
+             (sN.stats.flags & NCPF_FLOAT_SHOES) ? "FLOAT " : "", (sN.stats.flags & NCPF_AIR_SHOES) ? "AIR " : "",
+             (sN.stats.flags & NCPF_UNDER_SHIRT) ? "SHIRT " : "", sN.stats.colours);
+    Text(fb, 6, y + 21, line, RGB(22, 26, 31));
+}
+
+static void DrawHeader(u16 *fb)
+{
+    struct PkbnImage icon;
+    s32 x;
+    Pkbn_DrawEmText(fb, 4, -2, "NAVICUST", PKBN_FONT_NORMAL, RGB(31, 26, 6), RGB(2, 2, 5));
+    x = Text(fb, 74, 0, sN.name, RGB(31, 31, 31));
+    icon = Gfx_TypeIcon(sN.owner.types[0]);
+    Gfx_Draw(fb, &icon, x + 4, 2, 0, 0, 0);
+    if (sN.owner.types[1] != sN.owner.types[0])
+    {
+        icon = Gfx_TypeIcon(sN.owner.types[1]);
+        Gfx_Draw(fb, &icon, x + 38, 2, 0, 0, 0);
+    }
+    if (sN.owner.pokerus & 0xF)
+        Text(fb, CW - 44, 0, "PKRS", RGB(31, 12, 20));
+}
+
+static void Draw(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < CW * CH; i++)
+        fb[i] = PKBN_RGB(1, 2, 6);
+    for (i = 0; i < CH; i += 16) // the Net grid
+        Gfx_FillBlend(fb, 0, (i + (s32)(sN.t / 4)) % CH, CW, 1, RGB(4, 12, 18), 4);
+    DrawHeader(fb);
+    DrawBoard(fb);
+    if (sN.mode == M_PLACE)
+        DrawGhost(fb);
+    if (sN.mode == M_BOARD)
+    {
+        s32 px, py;
+        CellRect(sN.bx, sN.by, &px, &py);
+        Pkbn_FrameRect(fb, px - 1, py - 1, CELL + 2, CELL + 2, (sN.t & 8) ? RGB(31, 26, 6) : RGB(31, 31, 31));
+    }
+    DrawList(fb);
+    DrawPreview(fb);
+    DrawInfo(fb);
+}
+
+// ---- input ---------------------------------------------------------------------------------------------------
+
+static void StartPlacing(u8 prog)
+{
+    sN.ghost.prog = prog;
+    sN.ghost.type = gPkbnNcps[prog].types[0];
+    sN.ghost.rot = 0;
+    sN.ghost.x = 1;
+    sN.ghost.y = gPkbnNcps[prog].plus ? 0 : NAVI_CMD_ROW - 1;
+    sN.moving = FALSE;
+    sN.mode = M_PLACE;
+}
+
+static void RemovePart(u8 i)
+{
+    for (; i + 1 < sN.navi->count; i++)
+        sN.navi->parts[i] = sN.navi->parts[i + 1];
+    sN.navi->count--;
+}
+
+static void Leave(void)
+{
+    gPkbnCanvasOverlay = NULL;
+    SetMainCallback2(sN.exit);
+}
+
+static void HandleInput(u16 keys)
+{
+    switch (sN.mode)
+    {
+    case M_RESULT:
+        if (keys & (A_BUTTON | B_BUTTON | START_BUTTON))
+            sN.mode = M_LIST;
+        break;
+    case M_LIST:
+        if (keys & DPAD_UP)
+        {
+            sN.listCursor = sN.listCursor ? sN.listCursor - 1 : NCP_COUNT - 1;
+            PlaySE(SE_SELECT);
+        }
+        if (keys & DPAD_DOWN)
+        {
+            sN.listCursor = (sN.listCursor + 1) % NCP_COUNT;
+            PlaySE(SE_SELECT);
+        }
+        if (sN.listCursor < sN.listTop)
+            sN.listTop = sN.listCursor;
+        if (sN.listCursor >= sN.listTop + LIST_ROWS)
+            sN.listTop = sN.listCursor - LIST_ROWS + 1;
+        if (keys & A_BUTTON)
+        {
+            if (Available(sN.listCursor) == 0)
+            {
+                Note("NONE LEFT - ALL IN USE");
+                PlaySE(SE_FAILURE);
+            }
+            else if (sN.navi->count >= NAVI_MAX_PARTS)
+                PlaySE(SE_FAILURE);
+            else
+            {
+                StartPlacing(sN.listCursor);
+                PlaySE(SE_SELECT);
+            }
+        }
+        if (keys & DPAD_LEFT)
+        {
+            sN.mode = M_BOARD;
+            sN.bx = NAVI_W - 1;
+            sN.by = NAVI_CMD_ROW;
+        }
+        if (keys & START_BUTTON)
+        {
+            Recompile();
+            sN.mode = M_RESULT;
+            PlaySE(SE_PIN);
+        }
+        if (keys & B_BUTTON)
+        {
+            PlaySE(SE_SELECT);
+            Leave();
+        }
+        break;
+    case M_PLACE:
+        if (keys & DPAD_UP && sN.ghost.y > -2)            sN.ghost.y--;
+        if (keys & DPAD_DOWN && sN.ghost.y < NAVI_H)      sN.ghost.y++;
+        if (keys & DPAD_LEFT && sN.ghost.x > -2)          sN.ghost.x--;
+        if (keys & DPAD_RIGHT && sN.ghost.x < NAVI_W)     sN.ghost.x++;
+        if (keys & R_BUTTON)
+            sN.ghost.rot = (sN.ghost.rot + 1) & 3;
+        if (keys & L_BUTTON)
+            sN.ghost.rot = (sN.ghost.rot + 3) & 3;
+        if (keys & SELECT_BUTTON)
+        {
+            const struct PkbnNcp *p = &gPkbnNcps[sN.ghost.prog];
+            u8 k;
+            for (k = 0; k < p->typeCount && p->types[k] != sN.ghost.type; k++)
+                ;
+            sN.ghost.type = p->types[(k + 1) % p->typeCount];
+        }
+        if (keys & A_BUTTON)
+        {
+            if (Navi_CanPlace(sN.navi, &sN.owner, &sN.ghost, -1))
+            {
+                sN.navi->parts[sN.navi->count++] = sN.ghost;
+                Recompile();
+                sN.mode = sN.moving ? M_BOARD : M_LIST;
+                PlaySE(SE_PIN);
+            }
+            else
+                PlaySE(SE_FAILURE);
+        }
+        if (keys & B_BUTTON)
+        {
+            if (sN.moving) // put it back where it was
+            {
+                sN.navi->parts[sN.navi->count++] = sN.movedFrom;
+                Recompile();
+            }
+            sN.mode = sN.moving ? M_BOARD : M_LIST;
+        }
+        break;
+    case M_BOARD:
+        if (keys & DPAD_UP && sN.by > -1)          sN.by--;
+        if (keys & DPAD_DOWN && sN.by < NAVI_H)    sN.by++;
+        if (keys & DPAD_LEFT && sN.bx > -1)        sN.bx--;
+        if (keys & DPAD_RIGHT)
+        {
+            if (sN.bx < NAVI_W)
+                sN.bx++;
+            else
+                sN.mode = M_LIST;
+        }
+        if (keys & B_BUTTON)
+            sN.mode = M_LIST;
+        if ((keys & A_BUTTON) && sN.board.cell[sN.by + 1][sN.bx + 1] == NCELL_PART)
+        {
+            u8 p = sN.board.part[sN.by + 1][sN.bx + 1];
+            sN.movedFrom = sN.navi->parts[p];
+            sN.ghost = sN.movedFrom;
+            RemovePart(p);
+            Recompile();
+            sN.moving = TRUE;
+            sN.mode = M_PLACE;
+            PlaySE(SE_SELECT);
+        }
+        break;
+    }
+}
+
+// Self-tests drive the editor with PKBN_TEST_NCP_KEYS = "U,D,L,R,A,B,S(tart),E(select),<,>(L/R)" one per 4 frames.
+static const char *sKeys;
+static u32 sKeyClock;
+
+static void CB2_NaviCust(void)
+{
+    u16 keys = gMain.newKeys;
+    sN.t++;
+    if (sN.noteTimer)
+        sN.noteTimer--;
+    if (sKeys != NULL)
+    {
+        keys = 0;
+        if (++sKeyClock % 4 == 0)
+        {
+            switch (*sKeys)
+            {
+            case 'U': keys = DPAD_UP; break;
+            case 'D': keys = DPAD_DOWN; break;
+            case 'L': keys = DPAD_LEFT; break;
+            case 'R': keys = DPAD_RIGHT; break;
+            case 'A': keys = A_BUTTON; break;
+            case 'B': keys = B_BUTTON; break;
+            case 'S': keys = START_BUTTON; break;
+            case 'E': keys = SELECT_BUTTON; break;
+            case '<': keys = L_BUTTON; break;
+            case '>': keys = R_BUTTON; break;
+            case '.': break; // wait
+            }
+            if (*sKeys)
+                sKeys++;
+            if (*sKeys == ',')
+                sKeys++;
+        }
+    }
+    HandleInput(keys);
+}
+
+void PkbnNaviCust_Open(u8 partySlot, MainCallback exitCallback)
+{
+    struct Pokemon *mon = &gPlayerParty[partySlot];
+    memset(&sN, 0, sizeof(sN));
+    sN.slot = partySlot;
+    sN.exit = exitCallback;
+    sN.navi = Navi_ForMon(mon, TRUE);
+    if (sN.navi == NULL)
+    {
+        SetMainCallback2(exitCallback);
+        return;
+    }
+    Navi_OwnerFromMon(&sN.owner, mon);
+    Gfx_LoadMonPic(&sN.pic, sN.owner.species, GetMonData(mon, MON_DATA_PERSONALITY), GetMonData(mon, MON_DATA_OT_ID));
+    Pkbn_GameStringToAscii(sN.name, gSpeciesNames[sN.owner.species], sizeof(sN.name));
+    Recompile();
+    sN.mode = M_LIST;
+    sKeys = getenv("PKBN_TEST_NCP_KEYS");
+    sKeyClock = 0;
+    gPkbnCanvasOverlay = Draw;
+    SetMainCallback2(CB2_NaviCust);
+}
+
+#endif // PORTABLE
