+static struct
+{
+    u8 slot;
+    MainCallback exit;
+    struct PkbnNavi *navi;
+    struct PkbnNaviOwner owner;
+    struct PkbnMonPic pic;
+    u8 mode;
+    u8 listCursor, listTop;
+    struct PkbnNaviPart ghost;
