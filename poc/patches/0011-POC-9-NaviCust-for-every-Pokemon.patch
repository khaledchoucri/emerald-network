+// Hand size: BN's 5, + Custom programs, - the custom bug (BN6 sub_802A40C: from turn N on, the draw count drops
+// by turn - N + 1, never below 2; N = 4/3/2 for bug level 1/2/3, asm/asm37_0.s:2988).
+static u8 HandSizeNow(void)
+{
+    const struct PkbnNaviStats *n = &sB.f[SIDE_PLAYER].navi;
+    s32 size = HAND_SIZE + n->hand;
+    if (n->bug[4])
