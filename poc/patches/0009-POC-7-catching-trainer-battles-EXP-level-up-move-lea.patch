+// Dialogue text (trainer speech): line breaks / prompts become spaces, control codes are skipped.
+void Pkbn_GameTextToAscii(char *dst, const u8 *src, u32 maxLen)
+{
+    u32 o = 0;
+    while (*src != EOS && o + 1 < maxLen)
+    {
+        u8 c = *src++;
+        if (c == EXT_CTRL_CODE_BEGIN)
+        {
+            u8 len = GetExtCtrlCodeLength(*src); // includes the code byte itself
+            src += len ? len : 1;
+            continue;
+        }
+        if (c == PLACEHOLDER_BEGIN)
+        {
+            src++;
+            continue;
+        }
+        if (c == CHAR_NEWLINE || c == CHAR_PROMPT_SCROLL || c == CHAR_PROMPT_CLEAR)
+            c = 0x00;
+        if (c == CHAR_e_ACUTE)
+        {
+            dst[o++] = 'E';
+            continue;
+        }
+        {
+            u8 one[2] = { c, EOS };
+            char out[2];
+            Pkbn_GameStringToAscii(out, one, 2);
+            if (out[0] == ' ' && o > 0 && dst[o - 1] == ' ')
+                continue;
+            dst[o++] = out[0];
+        }
+    }
+    dst[o] = '\0';
+}
