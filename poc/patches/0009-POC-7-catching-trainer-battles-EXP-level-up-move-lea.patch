+++ b/src/pkbn/post_battle.c
@@ -0,0 +1,612 @@
+// After a grid battle: the parts of Emerald's battle end that need screens.
+//
+// Order follows Emerald's battle scripts and battle_main.c:
+//  1. Outcome text: trainer win (BattleScript_LocalTrainerBattleWon: "defeated", the trainer's lose text,
+//     getmoneyreward), Pay Day money, white-out (BattleScript_LocalBattleLost), or a catch
+//     (BattleScript_SuccessBallThrow: Pokédex flags, nickname via DoNamingScreen, givecaughtmon).
+//  2. EXP, one level at a time (Cmd_getexp + the controller's level-up), with Emerald's own move
+//     learning: MonTryLearningNewMove (pokemon.c:3014) and the delete-a-move flow of
+//     Cmd_yesnoboxlearnmove (battle_script_commands.c:5415) using the real summary screen.
+//  3. Evolutions after a win (TryEvolvePokemon, battle_main.c:5191 -> EvolutionScene).
+//  4. The contract exit (PkbnContract_Exit).
+// The screen is our overlay: a text box with A/B prompts. PKBN_SELFTEST auto-answers (A for text, B for prompts).
+#ifdef PORTABLE
+#include <stdarg.h>
+#endif
+#include "pkbn/grid_internal.h"
+#include "battle_main.h"
+#include "battle_setup.h"
+#include "constants/flags.h"
+#include "constants/characters.h"
+#include "constants/game_stat.h"
+#include "data.h"
+#include "event_data.h"
+#include "evolution_scene.h"
+#include "item.h"
+#include "main.h"
+#include "money.h"
+#include "naming_screen.h"
+#include "overworld.h"
+#include "pokedex.h"
+#include "pokemon_storage_system.h"
+#include "pokemon_summary_screen.h"
+#include "sound.h"
+#include "string_util.h"
+#include "window.h"
+#include "constants/hold_effects.h"
+#include "constants/songs.h"
+#include "constants/trainers.h"
+#include "pkbn/battle_stub.h"
+#include "pkbn/render.h"
+
+#ifdef PORTABLE
+
+enum
+{
+    PB_START,
+    PB_TEXT,          // show sLines, wait for A
+    PB_NICK_ASK,      // "Give a nickname...?" A/B
+    PB_NICK_RETURN,   // back from the naming screen
+    PB_GIVE_CAUGHT,
+    PB_EXP_NEXT,      // find the next party slot with banked EXP
+    PB_LEVEL_STEP,    // one level
+    PB_LEARN_FIRST,
+    PB_LEARN_NEXT,
+    PB_DELETE_ASK,    // "Delete a move to make room for X?" A/B
+    PB_STOP_ASK,      // "Stop learning X?" A/B
+    PB_SUMMARY_RETURN,
+    PB_EVO_NEXT,
+    PB_EXIT,
+};
+
+struct PostBattle
+{
+    u8 step;
+    u8 next;                 // step after the current text
+    char lines[4][64];
+    u8 lineCount;
+    bool8 prompt;            // A=YES / B=NO
+    u16 waitFrames;
+    u8 slot;                 // party slot being processed
+    u32 targetExp;
+    u16 move;                // move being learned
+    u8 evoBits;
+    u8 nick[POKEMON_NAME_LENGTH + 1];
+    bool8 autopilot;
+};
+
+static struct PostBattle sPB;
+
+static void CB2_PkbnPostBattle(void);
+
+// ---- text ----------------------------------------------------------------------------------------
+
+static void Say(u8 next, const char *fmt, ...)
+{
+    char buf[256];
+    va_list ap;
+    u32 len, start = 0;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    // word-wrap to 56 columns, 4 lines max
+    sPB.lineCount = 0;
+    len = strlen(buf);
+    while (start < len && sPB.lineCount < 4)
+    {
+        u32 end = start + 56;
+        if (end >= len)
+            end = len;
+        else
+        {
+            u32 b = end;
+            while (b > start && buf[b] != ' ')
+                b--;
+            if (b > start)
+                end = b;
+        }
+        memcpy(sPB.lines[sPB.lineCount], buf + start, end - start);
+        sPB.lines[sPB.lineCount][end - start] = '\0';
+        sPB.lineCount++;
+        start = end;
+        while (buf[start] == ' ')
+            start++;
+    }
+    sPB.prompt = FALSE;
+    sPB.next = next;
+    sPB.step = PB_TEXT;
+    sPB.waitFrames = 0;
+    printf("[pkbn-post] %s\n", buf);
+    fflush(stdout);
+}
+
+static void Ask(u8 step, const char *fmt, ...)
+{
+    char buf[256];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    Say(0, "%s", buf);
+    sPB.prompt = TRUE;
+    sPB.step = step;
+}
+
+static void MonName(char *dst, u32 size, u8 slot)
+{
+    u8 nick[POKEMON_NAME_LENGTH + 2];
+    GetMonData(&gPlayerParty[slot], MON_DATA_NICKNAME, nick);
+    nick[POKEMON_NAME_LENGTH] = EOS;
+    Pkbn_GameStringToAscii(dst, nick, size);
+}
+
+static void MoveName(char *dst, u32 size, u16 move)
+{
+    Pkbn_GameStringToAscii(dst, gMoveNames[move], size);
+}
+
+static void PlayerName(char *dst, u32 size)
+{
+    Pkbn_GameStringToAscii(dst, gSaveBlock2Ptr->playerName, size);
+}
+
+// ---- overlay ---------------------------------------------------------------------------------------
+
+#define COL_BG   PKBN_RGB(2, 3, 6)
+#define COL_BOX  PKBN_RGB(4, 5, 10)
+#define COL_EDGE PKBN_RGB(28, 28, 28)
+#define COL_TEXT PKBN_RGB(31, 31, 31)
+#define COL_HINT PKBN_RGB(31, 26, 4)
+
+static void Overlay(u16 *fb)
+{
+    s32 i;
+    Pkbn_FillRect(fb, 0, 0, DISPLAY_WIDTH, DISPLAY_HEIGHT, COL_BG);
+    // party strip: whoever the current step is about
+    if (sPB.slot < PARTY_SIZE && GetMonData(&gPlayerParty[sPB.slot], MON_DATA_SPECIES) != SPECIES_NONE)
+    {
+        static u16 sIcon[32 * 32];
+        static u16 sIconSpecies;
+        u16 sp = GetMonData(&gPlayerParty[sPB.slot], MON_DATA_SPECIES);
+        char line[40], name[16];
+        if (sp != sIconSpecies)
+        {
+            Pkbn_DecodeMonIcon(sIcon, sp, GetMonData(&gPlayerParty[sPB.slot], MON_DATA_PERSONALITY), 0);
+            sIconSpecies = sp;
+        }
+        if (sPB.step >= PB_EXP_NEXT && sPB.step <= PB_SUMMARY_RETURN)
+        {
+            Pkbn_BlitIcon(fb, sIcon, 104, 30, FALSE, 0);
+            MonName(name, sizeof(name), sPB.slot);
+            snprintf(line, sizeof(line), "%s  LV. %u", name, (unsigned)GetMonData(&gPlayerParty[sPB.slot], MON_DATA_LEVEL));
+            Pkbn_DrawText(fb, (DISPLAY_WIDTH - Pkbn_TextWidth(line, 1)) / 2, 66, line, COL_TEXT, 1);
+        }
+    }
+    Pkbn_FillRect(fb, 4, 100, 232, 52, COL_BOX);
+    Pkbn_FrameRect(fb, 4, 100, 232, 52, COL_EDGE);
+    for (i = 0; i < sPB.lineCount; i++)
+        Pkbn_DrawText(fb, 10, 106 + i * 9, sPB.lines[i], COL_TEXT, 1);
+    if (sPB.prompt)
+        Pkbn_DrawText(fb, 150, 143, "A:YES  B:NO", COL_HINT, 1);
+    else if ((gMain.vblankCounter1 / 16) & 1)
+        Pkbn_DrawText(fb, 226, 143, ">", COL_HINT, 1);
+}
+
+static void ShowOverlay(void)
+{
+    gPkbnFrameOverlay = Overlay;
+}
+
+static void HideOverlay(void)
+{
+    gPkbnFrameOverlay = NULL;
+}
+
+// ---- steps -----------------------------------------------------------------------------------------
+
+static u8 TrainerLoseText(char *dst, u32 size)
+{
+    Pkbn_GameTextToAscii(dst, GetTrainerALoseText(), size);
+    return dst[0] != '\0';
+}
+
+// GetTrainerMoneyToGive (battle_script_commands.c:5598), single trainer.
+static u32 TrainerMoney(void)
+{
+    const struct Trainer *t = &gTrainers[gTrainerBattleOpponent_A];
+    u32 lastMonLevel = 0, i, multiplier = 1;
+    switch (t->partyFlags)
+    {
+    case 0: lastMonLevel = t->party.NoItemDefaultMoves[t->partySize - 1].lvl; break;
+    case F_TRAINER_PARTY_CUSTOM_MOVESET: lastMonLevel = t->party.NoItemCustomMoves[t->partySize - 1].lvl; break;
+    case F_TRAINER_PARTY_HELD_ITEM: lastMonLevel = t->party.ItemDefaultMoves[t->partySize - 1].lvl; break;
+    default: lastMonLevel = t->party.ItemCustomMoves[t->partySize - 1].lvl; break;
+    }
+    for (i = 0; gTrainerMoneyTable[i].classId != 0xFF; i++)
+        if (gTrainerMoneyTable[i].classId == t->trainerClass)
+            break;
+    // gBattleStruct->moneyMultiplier: 2 if an Amulet Coin holder was sent in (battle_util.c:3310)
+    for (i = 0; i < sB.partyCount; i++)
+        if (sB.party[i].participated && GetItemHoldEffect(GetMonData(&gPlayerParty[i], MON_DATA_HELD_ITEM)) == HOLD_EFFECT_DOUBLE_PRIZE)
+            multiplier = 2;
+    return 4 * lastMonLevel * multiplier * gTrainerMoneyTable[i].value;
+}
+
+static void StepStart(void)
+{
+    char player[16];
+    PlayerName(player, sizeof(player));
+    sPB.slot = 0xFF;
+
+    switch (sB.outcome)
+    {
+    case B_OUTCOME_WON:
+        if (sB.trainer)
+        {
+            static u8 sPart;
+            char cls[16], nm[16], text[200];
+            u32 money;
+            Pkbn_GameStringToAscii(cls, gTrainerClassNames[gTrainers[gTrainerBattleOpponent_A].trainerClass], sizeof(cls));
+            Pkbn_GameStringToAscii(nm, gTrainers[gTrainerBattleOpponent_A].trainerName, sizeof(nm));
+            switch (sPart++)
+            {
+            case 0:
+                Say(PB_START, "%s DEFEATED %s %s!", player, cls, nm); // sText_PlayerDefeatedLinkTrainerTrainer1
+                return;
+            case 1:
+                if (TrainerLoseText(text, sizeof(text)))
+                {
+                    Say(PB_START, "%s", text);
+                    return;
+                }
+                // fall through
+            case 2:
+                sPart = 3;
+                money = TrainerMoney();
+                AddMoney(&gSaveBlock1Ptr->money, money); // Cmd_getmoneyreward
+                Say(PB_START, "%s GOT $%u FOR WINNING!", player, (unsigned)money);
+                return;
+            }
+            sPart = 0;
+        }
+        if (sB.paydayMoney)
+        {
+            // Cmd_givepaydaymoney: gPaydayMoney x moneyMultiplier
+            u32 m = sB.paydayMoney;
+            sB.paydayMoney = 0;
+            AddMoney(&gSaveBlock1Ptr->money, m);
+            Say(PB_START, "%s PICKED UP $%u!", player, (unsigned)m);
+            return;
+        }
+        sPB.step = PB_EXP_NEXT;
+        return;
+    case B_OUTCOME_LOST:
+    {
+        static u8 sPart;
+        if (sPart++ == 0)
+        {
+            Say(PB_START, "%s IS OUT OF USABLE POKEMON!", player); // sText_PlayerWhiteout
+            return;
+        }
+        sPart = 0;
+        Say(PB_EXP_NEXT, "%s WHITED OUT!", player);             // sText_PlayerWhiteout2
+        return;
+    }
+    case B_OUTCOME_CAUGHT:
+    {
+        struct Pokemon *mon = &gEnemyParty[sB.enemySlot];
+        u16 species = GetMonData(mon, MON_DATA_SPECIES);
+        char name[16];
+        Pkbn_GameStringToAscii(name, gSpeciesNames[species], sizeof(name));
+        IncrementGameStat(GAME_STAT_POKEMON_CAPTURES); // BattleScript_SuccessBallThrow
+        // Cmd_trysetcaughtmondexflags: first catch registers it
+        if (!GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_GET_CAUGHT))
+        {
+            HandleSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_CAUGHT, GetMonData(mon, MON_DATA_PERSONALITY));
+            Say(PB_NICK_ASK, "%s'S DATA WAS ADDED TO THE POKEDEX.", name); // sText_PkmnDataAddedToDex
+            return;
+        }
+        sPB.step = PB_NICK_ASK;
+        return;
+    }
+    default:
+        sPB.step = PB_EXP_NEXT;
+        return;
+    }
+}
+
+static void StepGiveCaught(void)
+{
+    struct Pokemon *mon = &gEnemyParty[sB.enemySlot];
+    char name[16];
+    u8 nick[POKEMON_NAME_LENGTH + 2];
+    GetMonData(mon, MON_DATA_NICKNAME, nick);
+    nick[POKEMON_NAME_LENGTH] = EOS;
+    Pkbn_GameStringToAscii(name, nick, sizeof(name));
+    // Cmd_givecaughtmon
+    if (GiveMonToPlayer(mon) != MON_GIVEN_TO_PARTY)
+        Say(PB_EXP_NEXT, "%s WAS SENT TO %s PC.", name, FlagGet(FLAG_SYS_PC_LANETTE) ? "LANETTE'S" : "SOMEONE'S");
+    else
+        sPB.step = PB_EXP_NEXT;
+}
+
+static void StepExpNext(void)
+{
+    u8 i;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (sB.pendingExp[i] && GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE)
+        {
+            char name[16];
+            u32 gain = sB.pendingExp[i];
+            sB.pendingExp[i] = 0;
+            sPB.slot = i;
+            sPB.targetExp = GetMonData(&gPlayerParty[i], MON_DATA_EXP) + gain;
+            MonName(name, sizeof(name), i);
+            Say(PB_LEVEL_STEP, "%s GAINED %u EXP. POINTS!", name, (unsigned)gain); // sText_PkmnGainedEXP
+            return;
+        }
+    }
+    sPB.step = PB_EVO_NEXT;
+}
+
+// One level at a time, as Emerald's EXP bar does it: each level runs the move-learning check.
+static void StepLevel(void)
+{
+    struct Pokemon *mon = &gPlayerParty[sPB.slot];
+    u8 level = GetMonData(mon, MON_DATA_LEVEL);
+    u8 growth = gSpeciesInfo[GetMonData(mon, MON_DATA_SPECIES)].growthRate;
+    u32 exp = GetMonData(mon, MON_DATA_EXP);
+    char name[16];
+
+    if (level < MAX_LEVEL && sPB.targetExp >= gExperienceTables[growth][level + 1])
+    {
+        exp = gExperienceTables[growth][level + 1];
+        SetMonData(mon, MON_DATA_EXP, &exp);
+        CalculateMonStats(mon); // also adds the max-HP increase to current HP (pokemon.c)
+        AdjustFriendship(mon, FRIENDSHIP_EVENT_GROW_LEVEL);
+        gLeveledUpInBattle |= 1 << sPB.slot;
+        sPB.evoBits |= 1 << sPB.slot;
+        MonName(name, sizeof(name), sPB.slot);
+        PlayFanfare(MUS_LEVEL_UP);
+        Say(PB_LEARN_FIRST, "%s GREW TO LV. %u!", name, (unsigned)GetMonData(mon, MON_DATA_LEVEL)); // sText_PkmnGrewToLv
+        return;
+    }
+    // no more levels: bank the rest
+    exp = sPB.targetExp;
+    if (level >= MAX_LEVEL)
+        exp = gExperienceTables[growth][MAX_LEVEL];
+    SetMonData(mon, MON_DATA_EXP, &exp);
+    CalculateMonStats(mon);
+    sPB.step = PB_EXP_NEXT;
+}
+
+static void HandleLearnResult(u16 result)
+{
+    char name[16], move[16];
+    MonName(name, sizeof(name), sPB.slot);
+    if (result == MOVE_NONE)
+    {
+        sPB.step = PB_LEVEL_STEP;
+        return;
+    }
+    if (result == MON_ALREADY_KNOWS_MOVE)
+    {
+        sPB.step = PB_LEARN_NEXT;
+        return;
+    }
+    if (result == MON_HAS_MAX_MOVES)
+    {
+        sPB.move = gMoveToLearn;
+        MoveName(move, sizeof(move), sPB.move);
+        // sText_TryToLearnMove1 / 2 / 3
+        Say(PB_DELETE_ASK, "%s IS TRYING TO LEARN %s. BUT %s CAN'T LEARN MORE THAN FOUR MOVES.", name, move, name);
+        return;
+    }
+    MoveName(move, sizeof(move), result);
+    PlayFanfare(MUS_LEVEL_UP);
+    Say(PB_LEARN_NEXT, "%s LEARNED %s!", name, move); // sText_PkmnLearnedMove
+}
+
+static void StepEvoNext(void)
+{
+    u8 i;
+    if (sB.outcome != B_OUTCOME_WON) // TryEvolvePokemon only runs after a win (battle_main.c:5169)
+    {
+        sPB.step = PB_EXIT;
+        return;
+    }
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (sPB.evoBits & (1 << i))
+        {
+            u16 species;
+            sPB.evoBits &= ~(1 << i);
+            species = GetEvolutionTargetSpecies(&gPlayerParty[i], EVO_MODE_NORMAL, ITEM_NONE);
+            if (species != SPECIES_NONE)
+            {
+                if (sPB.autopilot && getenv("PKBN_TEST_EVOLVE") == NULL)
+                {
+                    printf("[pkbn-post] slot %u would evolve into species %u (evolution scene skipped in self-test)\n", i, species);
+                    continue;
+                }
+                HideOverlay();
+                FreeAllWindowBuffers();
+                gCB2_AfterEvolution = CB2_PkbnPostBattle;
+                EvolutionScene(&gPlayerParty[i], species, TRUE, i);
+                return;
+            }
+        }
+    }
+    sPB.step = PB_EXIT;
+}
+
+static bool8 Confirm(bool8 *yes)
+{
+    u16 keys = gMain.newKeys;
+    if (sPB.autopilot)
+    {
+        if (++sPB.waitFrames < 8)
+            return FALSE;
+        *yes = !sPB.prompt || (sPB.step == PB_DELETE_ASK && getenv("PKBN_TEST_FORGET") != NULL); // text: A; prompts: NO
+        return TRUE;
+    }
+    if (keys & A_BUTTON) { *yes = TRUE; PlaySE(SE_SELECT); return TRUE; }
+    if (keys & B_BUTTON) { *yes = FALSE; PlaySE(SE_SELECT); return TRUE; }
+    return FALSE;
+}
+
+static void CB2_PkbnPostBattle(void)
+{
+    bool8 yes;
+    char name[16], move[16];
+
+    if (gPkbnFrameOverlay != Overlay && sPB.step != PB_EXIT)
+        ShowOverlay(); // back from the naming / summary / evolution screens
+
+    switch (sPB.step)
+    {
+    case PB_START:
+        StepStart();
+        break;
+    case PB_TEXT:
+        if (Confirm(&yes))
+            sPB.step = sPB.next;
+        break;
+    case PB_NICK_ASK:
+        if (!sPB.prompt)
+        {
+            Pkbn_GameStringToAscii(name, gSpeciesNames[GetMonData(&gEnemyParty[sB.enemySlot], MON_DATA_SPECIES)], sizeof(name));
+            Ask(PB_NICK_ASK, "GIVE A NICKNAME TO THE CAPTURED %s?", name); // sText_GiveNicknameCaptured
+            break;
+        }
+        if (Confirm(&yes))
+        {
+            sPB.prompt = FALSE;
+            if (yes)
+            {
+                // Cmd_trygivecaughtmonnick
+                struct Pokemon *mon = &gEnemyParty[sB.enemySlot];
+                GetMonData(mon, MON_DATA_NICKNAME, sPB.nick);
+                HideOverlay();
+                sPB.step = PB_NICK_RETURN;
+                DoNamingScreen(NAMING_SCREEN_CAUGHT_MON, sPB.nick, GetMonData(mon, MON_DATA_SPECIES),
+                               GetMonGender(mon), GetMonData(mon, MON_DATA_PERSONALITY), CB2_PkbnPostBattle);
+                return;
+            }
+            sPB.step = PB_GIVE_CAUGHT;
+        }
+        break;
+    case PB_NICK_RETURN:
+        SetMonData(&gEnemyParty[sB.enemySlot], MON_DATA_NICKNAME, sPB.nick);
+        sPB.step = PB_GIVE_CAUGHT;
+        break;
+    case PB_GIVE_CAUGHT:
+        StepGiveCaught();
+        break;
+    case PB_EXP_NEXT:
+        StepExpNext();
+        break;
+    case PB_LEVEL_STEP:
+        StepLevel();
+        break;
+    case PB_LEARN_FIRST:
+        HandleLearnResult(MonTryLearningNewMove(&gPlayerParty[sPB.slot], TRUE));
+        break;
+    case PB_LEARN_NEXT:
+        HandleLearnResult(MonTryLearningNewMove(&gPlayerParty[sPB.slot], FALSE));
+        break;
+    case PB_DELETE_ASK:
+        if (!sPB.prompt)
+        {
+            MoveName(move, sizeof(move), sPB.move);
+            Ask(PB_DELETE_ASK, "DELETE A MOVE TO MAKE ROOM FOR %s?", move); // sText_TryToLearnMove3
+            break;
+        }
+        if (Confirm(&yes))
+        {
+            sPB.prompt = FALSE;
+            if (yes)
+            {
+                HideOverlay();
+                FreeAllWindowBuffers();
+                sPB.step = PB_SUMMARY_RETURN;
+                ShowSelectMovePokemonSummaryScreen(gPlayerParty, sPB.slot, gPlayerPartyCount - 1, CB2_PkbnPostBattle, sPB.move);
+                return;
+            }
+            sPB.step = PB_STOP_ASK;
+        }
+        break;
+    case PB_STOP_ASK:
+        if (!sPB.prompt)
+        {
+            MoveName(move, sizeof(move), sPB.move);
+            Ask(PB_STOP_ASK, "STOP LEARNING %s?", move); // sText_StopLearningMove
+            break;
+        }
+        if (Confirm(&yes))
+        {
+            sPB.prompt = FALSE;
+            if (yes || sPB.autopilot)
+            {
+                MonName(name, sizeof(name), sPB.slot);
+                MoveName(move, sizeof(move), sPB.move);
+                Say(PB_LEARN_NEXT, "%s DID NOT LEARN %s.", name, move); // sText_DidNotLearnMove
+            }
+            else
+                sPB.step = PB_DELETE_ASK;
+        }
+        break;
+    case PB_SUMMARY_RETURN:
+    {
+        u8 pos = GetMoveSlotToReplace();
+        if (pos == MAX_MON_MOVES)
+        {
+            sPB.step = PB_STOP_ASK;
+            break;
+        }
+        {
+            u16 old = GetMonData(&gPlayerParty[sPB.slot], MON_DATA_MOVE1 + pos);
+            char oldName[16];
+            if (IsHMMove2(old))
+            {
+                Say(PB_DELETE_ASK, "HM MOVES CAN'T BE FORGOTTEN NOW."); // sText_HMMovesCantBeForgotten
+                break;
+            }
+            RemoveMonPPBonus(&gPlayerParty[sPB.slot], pos);
+            SetMonMoveSlot(&gPlayerParty[sPB.slot], sPB.move, pos);
+            MonName(name, sizeof(name), sPB.slot);
+            MoveName(oldName, sizeof(oldName), old);
+            MoveName(move, sizeof(move), sPB.move);
+            // sText_123Poof, sText_PkmnForgotMove, sText_PkmnLearnedMove
+            Say(PB_LEARN_NEXT, "1, 2, AND... POOF! %s FORGOT %s. AND... %s LEARNED %s!", name, oldName, name, move);
+            PlayFanfare(MUS_LEVEL_UP);
+        }
+        break;
+    }
+    case PB_EVO_NEXT:
+        StepEvoNext();
+        break;
+    case PB_EXIT:
+        HideOverlay();
+        PkbnContract_Exit(sB.outcome);
+        return;
+    }
+}
+
+void PkbnPostBattle_Start(void)
+{
+    memset(&sPB, 0, sizeof(sPB));
+    sPB.slot = 0xFF;
+    sPB.autopilot = getenv("PKBN_SELFTEST") != NULL;
+    gLeveledUpInBattle = 0;
+    // The fight is over and its sprite buffers are freed: the summary / naming screens must take
+    // their out-of-battle paths (pokemon_summary_screen.c:3910 reads battle sprite buffers when inBattle).
+    gMain.inBattle = FALSE;
+    if (sB.outcome == B_OUTCOME_CAUGHT)
+        sB.paydayMoney = 0;
+    ShowOverlay();
+    SetMainCallback2(CB2_PkbnPostBattle);
+}
+
+#endif // PORTABLE
