+// Cmd_getexp (battle_script_commands.c:3255-3420), run when an opponent faints. The EXP is banked and
+// given level by level after the battle (src/pkbn/post_battle.c), where the level-up screens live.
+static void AwardExpForFaintedEnemy(void)
+{
+    const struct BattlePokemon *e = &sB.f[SIDE_ENEMY].bm;
+    u32 calculatedExp = gSpeciesInfo[e->species].expYield * e->level / 7;
+    u32 exp, shareExp = 0;
+    s32 i, viaSentIn = 0, viaExpShare = 0;
+
+    for (i = 0; i < sB.partyCount; i++)
+    {
+        if (!PartyAlive(i))
+            continue;
+        if (sB.sentIn & (1 << i))
+            viaSentIn++;
+        if (HoldEffectOf(i) == HOLD_EFFECT_EXP_SHARE)
+            viaExpShare++;
+    }
+    if (viaExpShare)
+    {
+        exp = viaSentIn ? calculatedExp / 2 / viaSentIn : 0;
+        if (exp == 0) exp = 1;
+        shareExp = calculatedExp / 2 / viaExpShare;
+        if (shareExp == 0) shareExp = 1;
+    }
+    else
+    {
+        exp = viaSentIn ? calculatedExp / viaSentIn : 0;
+        if (exp == 0) exp = 1;
+    }
+    for (i = 0; i < sB.partyCount; i++)
+    {
+        u8 hold = HoldEffectOf(i);
+        u32 gain;
+        if (hold != HOLD_EFFECT_EXP_SHARE && !(sB.sentIn & (1 << i)))
+            continue;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) == MAX_LEVEL || !PartyAlive(i))
+            continue;
+        gain = (sB.sentIn & (1 << i)) ? exp : 0;
+        if (hold == HOLD_EFFECT_EXP_SHARE)
+            gain += shareExp;
+        if (hold == HOLD_EFFECT_LUCKY_EGG)
+            gain = gain * 150 / 100;
+        if (sB.trainer)
+            gain = gain * 150 / 100;
+        if (IsTradedMon(&gPlayerParty[i]))
+            gain = gain * 150 / 100;
+        sB.pendingExp[i] += gain;
+        MonGainEVs(&gPlayerParty[i], e->species);
+        PKBN_LOG("slot %d banks %u EXP for %s (pending %u)", (int)i, (unsigned)gain, sB.f[SIDE_ENEMY].name,
+                 (unsigned)sB.pendingExp[i]);
+    }
+}
+
+static s8 NextEnemySlot(void)
+{
+    s32 i;
+    for (i = sB.enemySlot + 1; i < sB.enemyCount; i++)
+        if (GetMonData(&gEnemyParty[i], MON_DATA_SPECIES) != SPECIES_NONE && GetMonData(&gEnemyParty[i], MON_DATA_HP) > 0)
+            return i;
+    return -1;
+}
+
+// Ball throw (time stops, as for any Custom choice): flight, the Pokémon is drawn in, then
+// Emerald's 0-3 shakes. TUNE timings.
+#define THROW_FLIGHT 30
+#define THROW_ABSORB 12
+#define THROW_SHAKE  32
+static void UpdateThrow(void)
+{
+    u8 shakes = sB.throwShakes > 3 ? 3 : sB.throwShakes;
+    u16 end = THROW_FLIGHT + THROW_ABSORB + THROW_SHAKE * shakes + 24;
+    sB.timer++;
+    if (sB.timer > THROW_FLIGHT + THROW_ABSORB && ((sB.timer - THROW_FLIGHT - THROW_ABSORB) % THROW_SHAKE) == 1
+     && (sB.timer - THROW_FLIGHT - THROW_ABSORB) / THROW_SHAKE < shakes)
+        PlaySE(SE_BALL);
+    if (sB.timer == THROW_FLIGHT)
+        PlaySE(SE_BALL_OPEN);
+    if (sB.timer < end)
+        return;
+    if (sB.throwShakes == 4)
+    {
+        char text[40];
+        struct Pokemon *mon = &gEnemyParty[sB.enemySlot];
+        u32 hp = sB.f[SIDE_ENEMY].bm.hp, status = sB.f[SIDE_ENEMY].bm.status1;
+        // Cmd_handleballthrow: the ball is recorded; the caught Pokémon keeps its battle HP and status
+        SetMonData(mon, MON_DATA_POKEBALL, &sB.ballItem);
+        SetMonData(mon, MON_DATA_HP, &hp);
+        SetMonData(mon, MON_DATA_STATUS, &status);
+        sB.caught = TRUE;
+        snprintf(text, sizeof(text), "GOTCHA! %s WAS CAUGHT!", sB.f[SIDE_ENEMY].name); // sText_GotchaPkmnCaughtPlayer
+        EndBattle(B_OUTCOME_CAUGHT, text);
+        return;
+    }
+    // sText_PkmnBrokeFree / ItAppearedCaught / AarghAlmostHadIt / ShootSoClose (battle_message.c:468-471)
+    {
+        static const char *const sBrokeFree[] = {
+            "OH, NO! THE POKEMON BROKE FREE!", "AWW! IT APPEARED TO BE CAUGHT!",
+            "AARGH! ALMOST HAD IT!", "SHOOT! IT WAS SO CLOSE, TOO!" };
+        Flash(sBrokeFree[shakes], 90);
+    }
+    sB.ballItem = Catch_NextBall(sB.ballItem ? sB.ballItem - 1 : 0, 1); // keep the same ball if any are left
+    sB.state = ST_FIGHT;
+}
