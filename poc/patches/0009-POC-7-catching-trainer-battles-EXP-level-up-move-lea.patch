diff --git a/src/pkbn/grid_catch.c b/src/pkbn/grid_catch.c
new file mode 100644
index 0000000..e408431
--- /dev/null
+++ b/src/pkbn/grid_catch.c
@@ -0,0 +1,107 @@
+// Grid battle: throwing a Poké Ball from the Custom screen.
+//
+// The odds are Emerald's own: Cmd_handleballthrow (battle_script_commands.c:9925) with
+// sBallCatchBonuses (:841). Lower HP, sleep/freeze (x2) and poison/burn/paralysis (x1.5) all
+// help, exactly as in Emerald. Shakes: 4 checks of Random() < 1048560 / Sqrt(Sqrt(16711680 / odds)).
+#include "pkbn/grid_internal.h"
+#include "event_data.h"
+#include "item.h"
+#include "overworld.h"
+#include "pokedex.h"
+#include "random.h"
+#include "constants/items.h"
+#include "constants/maps.h"
+#include "constants/map_types.h"
+
+#ifdef PORTABLE
+
+// sBallCatchBonuses (battle_script_commands.c:841), indexed from ITEM_ULTRA_BALL
+static const u8 sBallCatchBonuses[] =
+{
+    [ITEM_ULTRA_BALL - ITEM_ULTRA_BALL]  = 20,
+    [ITEM_GREAT_BALL - ITEM_ULTRA_BALL]  = 15,
+    [ITEM_POKE_BALL - ITEM_ULTRA_BALL]   = 10,
+    [ITEM_SAFARI_BALL - ITEM_ULTRA_BALL] = 15
+};
+
+// Next ball in the bag after `from` (wrapping), or 0 if there are none. dir = +1 / -1.
+u16 Catch_NextBall(u16 from, s8 dir)
+{
+    s32 i, item = from ? from : (dir > 0 ? LAST_BALL : FIRST_BALL);
+    for (i = 0; i <= LAST_BALL - FIRST_BALL; i++)
+    {
+        item += dir;
+        if (item > LAST_BALL) item = FIRST_BALL;
+        if (item < FIRST_BALL) item = LAST_BALL;
+        if (item != ITEM_SAFARI_BALL && CheckBagHasItem(item, 1))
+            return item;
+    }
+    return (from && from != ITEM_SAFARI_BALL && CheckBagHasItem(from, 1)) ? from : 0;
+}
+
+// Returns the number of shakes (0-3), or 4 when the Pokémon is caught (BALL_3_SHAKES_SUCCESS).
+u8 Catch_Throw(u16 ball)
+{
+    const struct Fighter *t = &sB.f[SIDE_ENEMY];
+    u8 ballMultiplier = 10;
+    u8 catchRate = gSpeciesInfo[t->bm.species].catchRate;
+    u32 odds;
+    u8 shakes;
+
+    if (ball == ITEM_MASTER_BALL)
+        return 4;
+    if (ball > ITEM_SAFARI_BALL)
+    {
+        switch (ball)
+        {
+        case ITEM_NET_BALL:
+            ballMultiplier = (t->bm.types[0] == TYPE_WATER || t->bm.types[1] == TYPE_WATER
+                           || t->bm.types[0] == TYPE_BUG || t->bm.types[1] == TYPE_BUG) ? 30 : 10;
+            break;
+        case ITEM_DIVE_BALL:
+            ballMultiplier = (GetCurrentMapType() == MAP_TYPE_UNDERWATER) ? 35 : 10;
+            break;
+        case ITEM_NEST_BALL:
+            if (t->bm.level < 40)
+            {
+                ballMultiplier = 40 - t->bm.level;
+                if (ballMultiplier <= 9)
+                    ballMultiplier = 10;
+            }
+            break;
+        case ITEM_REPEAT_BALL:
+            ballMultiplier = GetSetPokedexFlag(SpeciesToNationalPokedexNum(t->bm.species), FLAG_GET_CAUGHT) ? 30 : 10;
+            break;
+        case ITEM_TIMER_BALL:
+            // battleTurnCounter -> our turn clock (one Custom gauge per turn)
+            ballMultiplier = sB.turn + 10 > 40 ? 40 : sB.turn + 10;
+            break;
+        default: // Luxury, Premier
+            ballMultiplier = 10;
+            break;
+        }
+    }
+    else
+    {
+        ballMultiplier = sBallCatchBonuses[ball - ITEM_ULTRA_BALL];
+    }
+
+    odds = (catchRate * ballMultiplier / 10) * (t->bm.maxHP * 3 - t->bm.hp * 2) / (3 * t->bm.maxHP);
+    if (t->bm.status1 & (STATUS1_SLEEP | STATUS1_FREEZE))
+        odds *= 2;
+    if (t->bm.status1 & (STATUS1_POISON | STATUS1_BURN | STATUS1_PARALYSIS | STATUS1_TOXIC_POISON))
+        odds = (odds * 15) / 10;
+
+    PKBN_LOG("ball %u: catch rate %u x%u/10, HP %u/%u, status 0x%x -> odds %u", ball, catchRate, ballMultiplier,
+             t->bm.hp, t->bm.maxHP, (unsigned)t->bm.status1, (unsigned)odds);
+    if (odds > 254)
+        return 4;
+    odds = Sqrt(Sqrt(odds ? 16711680 / odds : 16711680)); // SAFE_DIV as vanilla
+    odds = odds ? 1048560 / odds : 0;
+    // for (shakes = 0; shakes < BALL_3_SHAKES_SUCCESS && Random() < odds; shakes++);  (BALL_3_SHAKES_SUCCESS = 4)
+    for (shakes = 0; shakes < 4 && Random() < odds; shakes++)
+        ;
+    return shakes; // 4 = caught
+}
+
+#endif // PORTABLE
