diff --git a/src/pkbn/grid_battle.c b/src/pkbn/grid_battle.c
index 9464c36..b796364 100644
--- a/src/pkbn/grid_battle.c
+++ b/src/pkbn/grid_battle.c
@@ -3323,23 +3323,46 @@ static void Tick(struct Fighter *f)
 
 // Cmd_getexp (battle_script_commands.c:3255-3420), run when an opponent faints. The EXP is banked and
 // given level by level after the battle (src/pkbn/post_battle.c), where the level-up screens live.
+//
+// POC-29 (Khaled's N2a, N3a):
+//  - The bench shares from the start: with the Exp. Share on (PkbnExpShare_On), the Pokémon that fought split 2/3 of
+//    the EXP as in Gen 3 and the other Pokémon able to fight split the last 1/3. Their share comes out of the
+//    fighters', not on top of it (Gen 6 gave the bench extra). With nobody on the bench the fighters get it all.
+//  - Gen 5's scaled EXP: each Pokémon's share is multiplied by ((2L + 10) / (L + Lp + 10))^2.5, L the foe's level and
+//    Lp its own (Gen 5's formula; ours keeps Gen 3's yield / 7 under it, so at equal levels nothing changes). A Pokémon
+//    above the foe earns less, one below earns more.
+#define EXP_BENCH_PART 3   // the bench's part is 1/3 (TUNE)
+static u32 ScaledExp(u32 exp, u8 foeLevel, u8 ownLevel)
+{
+    double r = (2.0 * foeLevel + 10.0) / ((double)foeLevel + ownLevel + 10.0), s = r, v;
+    s32 k;
+    for (k = 0; k < 20; k++)
+        s = 0.5 * (s + r / s);   // the square root (Newton), so the game needs no libm
+    v = exp * r * r * s;
+    return v < 1.0 ? 1 : (u32)v;
+}
+
 static void AwardExpForFaintedEnemy(void)
 {
-    // POC-21: held items do nothing in grid battles, so the Exp. Share is no longer held. Khaled's note: a party-wide
-    // Exp. Share toggle "similar to newer Gens" - Gen 6's Exp. Share (a key item, ON/OFF): the Pokémon that fought split
-    // the EXP as in Gen 3, and with it ON every other Pokémon able to fight gets half of a fighter's share (TUNE).
     const struct BattlePokemon *e = &sB.f[SIDE_ENEMY].bm;
     u32 calculatedExp = gSpeciesInfo[e->species].expYield * e->level / 7;
-    u32 exp;
-    s32 i, viaSentIn = 0;
+    u32 fighterPool, benchPool, fighterExp, benchExp;
+    s32 i, fighters = 0, bench = 0;
     bool8 shareOn = PkbnExpShare_On();
 
     for (i = 0; i < sB.partyCount; i++)
-        if (PartyAlive(i) && (sB.sentIn & (1 << i)))
-            viaSentIn++;
-    exp = viaSentIn ? calculatedExp / viaSentIn : calculatedExp;
-    if (exp == 0)
-        exp = 1;
+    {
+        if (!PartyAlive(i) || GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) == MAX_LEVEL)
+            continue;
+        if (sB.sentIn & (1 << i))
+            fighters++;
+        else if (shareOn)
+            bench++;
+    }
+    benchPool = bench ? calculatedExp / EXP_BENCH_PART : 0;
+    fighterPool = calculatedExp - benchPool;
+    fighterExp = fighters ? fighterPool / fighters : fighterPool;
+    benchExp = bench ? benchPool / bench : 0;
     for (i = 0; i < sB.partyCount; i++)
     {
         bool8 fought = (sB.sentIn & (1 << i)) != 0;
@@ -3348,7 +3371,7 @@ static void AwardExpForFaintedEnemy(void)
             continue;
         if (GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) == MAX_LEVEL || !PartyAlive(i))
             continue;
-        gain = fought ? exp : (exp / 2 ? exp / 2 : 1);
+        gain = ScaledExp(fought ? fighterExp : benchExp, e->level, GetMonData(&gPlayerParty[i], MON_DATA_LEVEL));
         if (sB.party[i].navi.luckyEgg)
             gain = gain * (100 + sB.party[i].navi.luckyEgg) / 100;   // LuckyEgg program (the Lucky Egg item is now it)
         if (sB.trainer)
