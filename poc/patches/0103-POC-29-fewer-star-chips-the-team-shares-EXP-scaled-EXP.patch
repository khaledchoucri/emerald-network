diff --git a/src/pkbn/busting.c b/src/pkbn/busting.c
index 70e3607..e633fbf 100644
--- a/src/pkbn/busting.c
+++ b/src/pkbn/busting.c
@@ -220,7 +220,9 @@ static bool8 HasLane(u16 move, u8 letter)
 }
 
 // A random lane; the first lane (what learning gives) at half weight (design 08 §4). rare: never the first lane,
-// and `*` (when the move allows it) 1 in 4.
+// and `*` (when the move allows it) 1 in 4. POC-29 (Khaled's N1a): that 1 in 4 is the only way a drop comes as `*`;
+// ordinary drops and the rest of the rare ones pick among the lettered codes.
+#define LANE_WEIGHT(i) (info->lanes[i] == LETTER_WILD ? 0 : (i) == 0 ? 1 : 2)
 static u8 RandomLane(u16 move, bool8 rare)
 {
     const struct PkbnMoveInfo *info = &gPkbnMoveInfo[move];
@@ -229,18 +231,24 @@ static u8 RandomLane(u16 move, bool8 rare)
         return 0;
     if (rare)
     {
+        u8 pick[4], n = 0;
         if (HasLane(move, LETTER_WILD) && Random() % 4 == 0)
             return LETTER_WILD;
-        if (info->laneCount == 1)
+        for (i = 1; i < info->laneCount; i++)
+            if (info->lanes[i] != LETTER_WILD)
+                pick[n++] = info->lanes[i];
+        if (n == 0)
             return info->lanes[0];
-        return info->lanes[1 + Random() % (info->laneCount - 1)];
+        return pick[Random() % n];
     }
     for (i = 0; i < info->laneCount; i++)
-        w += i == 0 ? 1 : 2;
+        w += LANE_WEIGHT(i);
+    if (w == 0)
+        return info->lanes[0];   // a move whose only code is *
     r = Random() % w;
     for (i = 0; i < info->laneCount; i++)
     {
-        u32 wi = i == 0 ? 1 : 2;
+        u32 wi = LANE_WEIGHT(i);
         if (r < wi)
             return info->lanes[i];
         r -= wi;
