 #define PA_CONFUSE       0xFFFFFFFF // pseudo-status: confusion
diff --git a/src/pkbn/bot.c b/src/pkbn/bot.c
index 154c989..7a9b9c4 100644
--- a/src/pkbn/bot.c
+++ b/src/pkbn/bot.c
@@ -190,6 +190,63 @@ static void NoteCustom(bool8 idle)
     sIdle = idle ? sIdle + 1 : 0;
 }
 
+// POC-32: with PKBN_BOT_PA=1 the test player looks for a Program Advance in its hand first: a named recipe in order, or
+// a type trio (three different damaging moves of one type, rising power), whose codes chain (one code, or *), that the
+// Pokémon in can use. It picks the three in order; if one stops being selectable it drops the plan. (The bot only.)
+static s8 sPlan[3] = { -1, -1, -1 };
+static u8 sPlanAt;
+
+static bool8 ChainCodes(u8 a, u8 b, u8 c)
+{
+    u8 l[3] = { a, b, c }, code = 0xFF, k;
+    for (k = 0; k < 3; k++)
+        if (l[k] != LETTER_WILD)
+        {
+            if (code != 0xFF && code != l[k])
+                return FALSE;
+            code = l[k];
+        }
+    return TRUE;
+}
+
+static bool8 FindPlan(void)
+{
+    s32 i, j, k, p;
+    const struct BattlePokemon *bm = &sB.f[SIDE_PLAYER].bm;
+    for (i = 0; i < sB.handCount; i++)
+        for (j = 0; j < sB.handCount; j++)
+            for (k = 0; k < sB.handCount; k++)
+            {
+                const struct FolderChip *a, *b, *c;
+                u16 ma, mb, mc;
+                bool8 ok = FALSE;
+                if (i == j || j == k || i == k || sB.hand[i] == FOLDER_STRUGGLE || sB.hand[j] == FOLDER_STRUGGLE
+                 || sB.hand[k] == FOLDER_STRUGGLE)
+                    continue;
+                a = &sB.folder.chips[sB.hand[i]], b = &sB.folder.chips[sB.hand[j]], c = &sB.folder.chips[sB.hand[k]];
+                if (a->owner != CHIP_SHARED || b->owner != CHIP_SHARED || c->owner != CHIP_SHARED
+                 || !ChainCodes(a->letter, b->letter, c->letter))
+                    continue;
+                ma = a->move, mb = b->move, mc = c->move;
+                if (!Chip_CanUse(bm, ma) || !Chip_CanUse(bm, mb) || !Chip_CanUse(bm, mc))
+                    continue;
+                for (p = 0; p < PKBN_PA_COUNT && !ok; p++)
+                    ok = gPkbnProgramAdvances[p].recipe[0] == ma && gPkbnProgramAdvances[p].recipe[1] == mb
+                      && gPkbnProgramAdvances[p].recipe[2] == mc;
+                if (!ok && ma != mb && mb != mc && ma != mc && gBattleMoves[ma].power > 1
+                 && gBattleMoves[ma].type == gBattleMoves[mb].type && gBattleMoves[mb].type == gBattleMoves[mc].type
+                 && gBattleMoves[ma].type != TYPE_MYSTERY && gBattleMoves[ma].power <= gBattleMoves[mb].power
+                 && gBattleMoves[mb].power <= gBattleMoves[mc].power)
+                    ok = TRUE;
+                if (ok)
+                {
+                    sPlan[0] = i, sPlan[1] = j, sPlan[2] = k, sPlanAt = 0;
+                    return TRUE;
+                }
+            }
+    return FALSE;
+}
+
 void PkbnBot_Custom(u16 *pressed)
 {
     s32 i, best = -1, bestScore = 0;
@@ -215,6 +272,27 @@ void PkbnBot_Custom(u16 *pressed)
         *pressed = sB.cursor == sB.handCount ? A_BUTTON : PkbnGrid_CursorKeyToward(sB.handCount);
         return;
     }
+    {
+        static s8 sPA = -1;
+        if (sPA < 0)
+            sPA = getenv("PKBN_BOT_PA") != NULL;
+        if (sPA && PickedCount() == 0 && !sB.wildPicked)
+        {
+            sPlan[0] = -1;
+            FindPlan();
+        }
+        if (sPA && sPlan[0] >= 0)
+        {
+            while (sPlanAt < 3 && sB.picked[sPlan[sPlanAt]])
+                sPlanAt++;
+            if (sPlanAt < 3 && PkbnGrid_HandSelectable(sPlan[sPlanAt]))
+            {
+                *pressed = sB.cursor == sPlan[sPlanAt] ? A_BUTTON : PkbnGrid_CursorKeyToward(sPlan[sPlanAt]);
+                return;
+            }
+            sPlan[0] = -1;   // done, or a chip can't be picked: back to the usual choice
+        }
+    }
     if (PickedCount() < BOT_MAX_PICKS)
         for (i = 0; i < sB.handCount; i++)
         {
@@ -227,6 +305,7 @@ void PkbnBot_Custom(u16 *pressed)
         }
     if (best < 0)
     {
+        sPlan[0] = -1;
         NoteCustom(PickedCount() == 0 && !sB.wildPicked);
         *pressed = START_BUTTON;
         return;
diff --git a/src/pkbn/folder.c b/src/pkbn/folder.c
index 6e36bef..50a1c47 100644
--- a/src/pkbn/folder.c
+++ b/src/pkbn/folder.c
@@ -333,6 +333,86 @@ static void GreedyFill(struct Folder *folder, const struct BattlePokemon *party,
     }
 }
 
+static void AddChip(struct Folder *folder, u16 mv, u8 letter, u8 size);
+#define PKBN_FOLDER_LOG(...) do { printf("[pkbn] " __VA_ARGS__); printf("\n"); } while (0)
+
+// POC-32 (Khaled's pick F1): before the greedy fill, the automatic folder puts in what makes Program Advances.
+//  1. Each party Pokémon's ladder (gPkbnLadderOf): its three moves in their shared code (or *), when the pack has all
+//     three in it and the Pokémon can use them. Two of each for the lead, one of each for the others.
+//  2. The named Program Advances (gPkbnProgramAdvances) the pack and party can make: one of each recipe chip, in a
+//     code all three have (or *).
+// At most half the folder goes to this (TUNE); the greedy fill does the rest as before.
+static s32 CodeFor(const struct Folder *folder, u16 mv, u8 code, u8 need)
+{
+    if (LetterLeft(folder, mv, code) >= need)
+        return code;
+    if (LetterLeft(folder, mv, LETTER_WILD) >= need)
+        return LETTER_WILD;
+    return -1;
+}
+
+static u8 SeedProgramAdvances(struct Folder *folder, const struct BattlePokemon *party, u8 partyCount, u8 size)
+{
+    u8 budget = size / 2, ladders = 0, pas = 0;
+    s32 p, k, i, l;
+    for (p = 0; p < partyCount; p++)
+    {
+        const struct PkbnLadder *ld;
+        u8 copies = p == 0 ? 2 : 1, c;
+        if (party[p].species == SPECIES_NONE || party[p].species >= NUM_SPECIES)
+            continue;
+        ld = &gPkbnLadderOf[party[p].species];
+        if (ld->moves[0] == MOVE_NONE)
+            continue;
+        for (k = 0; k < 3; k++)
+            if (!PkbnFolder_MoveIsChip(ld->moves[k]) || !Chip_CanUse(&party[p], ld->moves[k])
+             || CodeFor(folder, ld->moves[k], ld->code, 1) < 0)
+                break;
+        if (k < 3 || folder->count + 3 > budget)
+            continue;
+        for (c = 0; c < copies && folder->count + 3 <= budget; c++)
+            for (k = 0; k < 3; k++)
+            {
+                s32 code = CodeFor(folder, ld->moves[k], ld->code, 1);
+                if (code >= 0)
+                    AddChip(folder, ld->moves[k], code, size);
+            }
+        ladders++;
+    }
+    for (i = 0; i < PKBN_PA_COUNT && folder->count + 3 <= budget; i++)
+    {
+        const u16 *r = gPkbnProgramAdvances[i].recipe;
+        s32 code = -1;
+        for (k = 0; k < 3; k++)
+        {
+            for (p = 0; p < partyCount; p++)
+                if (Chip_CanUse(&party[p], r[k]))
+                    break;
+            if (!PkbnFolder_MoveIsChip(r[k]) || p == partyCount)
+                break;
+        }
+        if (k < 3)
+            continue;
+        for (l = 0; l < LETTER_WILD && code < 0; l++)
+            if (CodeFor(folder, r[0], l, 1) >= 0 && CodeFor(folder, r[1], l, r[1] == r[0] ? 2 : 1) >= 0
+             && CodeFor(folder, r[2], l, 1 + (r[2] == r[0]) + (r[2] == r[1])) >= 0)
+                code = l;
+        if (code < 0)
+            continue;
+        for (k = 0; k < 3; k++)
+        {
+            s32 c2 = CodeFor(folder, r[k], code, 1);
+            if (c2 >= 0)
+                AddChip(folder, r[k], c2, size);
+        }
+        pas++;
+    }
+    if (ladders || pas)
+        PKBN_FOLDER_LOG("folder: seeded %u ladder%s and %u Program Advance%s (%u chips)", ladders, ladders == 1 ? "" : "s",
+                        pas, pas == 1 ? "" : "s", folder->count);
+    return ladders + pas;
+}
+
 // The folder (design 08 §11): the edited folder when there is one (FOLDER editor, later), otherwise auto-built
 // from the pack: greedy, one copy at a time, favouring chips several party members can use and members that
 // have little so far (tools/shared_folder_sim.py's "balanced" builder). BN6 copy caps by MB.
@@ -380,6 +460,7 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
         }
     }
 
+    SeedProgramAdvances(folder, party, partyCount, size);   // POC-32 (F1)
     GreedyFill(folder, party, partyCount, size, NULL, -1);
 
 shuffle:
@@ -750,6 +831,7 @@ u8 PkbnFolder_BuildStyle(u8 style, const struct BattlePokemon *party, u8 partyCo
         break;
     }
     default:
+        SeedProgramAdvances(&f, party, partyCount, size);   // POC-32 (F1): BALANCED is the automatic folder
         GreedyFill(&f, party, partyCount, size, NULL, -1);
         break;
     }
