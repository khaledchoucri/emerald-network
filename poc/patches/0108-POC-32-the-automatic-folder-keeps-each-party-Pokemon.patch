+// POC-32 (F1): each Hoenn line's ladder (data/learnset_ladders.json), for the automatic folder
+const struct PkbnLadder gPkbnLadderOf[NUM_SPECIES] =
+{
+    [SPECIES_ABRA] = { LANE('M'), {MOVE_CONFUSION, MOVE_PSYBEAM, MOVE_PSYCHIC} },
+    [SPECIES_ABSOL] = { LANE('N'), {MOVE_KNOCK_OFF, MOVE_BITE, MOVE_FAINT_ATTACK} },
