+// ---- POC-16b: around the Custom screen ---------------------------------------------------------------------------
+// Our timings and layout (TUNE). In BN the chosen chips ride above MegaMan's head during the fight; here above the
+// Pokémon, the next one in front. The Custom window slides in and out; a Program Advance forms on screen at OK.
+#define STACK_SHOWN 5
+#define SLIDE_IN 12
+#define SLIDE_OUT 10
+#define PA_ANIM 44
+
+static void DrawStackChip(u16 *fb, s32 x, s32 y, u8 id)
+{
+    if (id == FOLDER_QUEUE_WILD)
+    {
+        Draw_Box(fb, x, y, CHIP_ICON_W + 2, CHIP_ICON_H + 2, RGB(4, 14, 6), RGB(14, 31, 16), 16);
+        Text(fb, x + 5, y + 1, "SW", COL_WHITE);
+        return;
+    }
+    if (id >= QUEUE_PA_BASE)
+    {
+        const struct PkbnProgramAdvance *pa = &gPkbnProgramAdvances[sB.paQueue[id - QUEUE_PA_BASE].pa];
+        Pkbn_FrameRect(fb, x, y, CHIP_ICON_W + 2, CHIP_ICON_H + 2, ((sTick / 4) & 1) ? COL_PA : COL_WHITE);
+        DrawChipIcon(fb, x + 1, y + 1, pa->recipe[2], FALSE);
+        return;
+    }
+    Pkbn_FrameRect(fb, x, y, CHIP_ICON_W + 2, CHIP_ICON_H + 2, RGB(24, 28, 31));
+    DrawChipIcon(fb, x + 1, y + 1, sB.folder.chips[id].move, FALSE);
+}
+
+static void DrawChipStack(u16 *fb)
+{
+    s32 i, n = sB.queueCount < STACK_SHOWN ? sB.queueCount : STACK_SHOWN;
+    s32 base;
+    if (sB.state != ST_FIGHT || !sHeadValid || n == 0)
+        return;
+    base = sHeadY - CHIP_ICON_H - 6;
+    if (base < 28)
+        base = 28;
+    for (i = n - 1; i >= 0; i--)   // the back of the stack first; the next chip last, in front
+        DrawStackChip(fb, sHeadX - (CHIP_ICON_W + 2) / 2 + i * 2, base - i * 4, sB.queue[i]);
+}
+
+static u16 sPAAnimMoves[3];
+static u8 sPAAnimPA;
+
+static void DrawPAForming(u16 *fb)
+{
+    s32 k, i, cx = CW / 2, cy = 58;
+    if (sPAAnimT == 0)
+        return;
+    k = PA_ANIM - sPAAnimT;
+    if (sB.state == ST_FIGHT && !sB.hitStop)
+        sPAAnimT--;
+    if (k < 14)
+    {
+        // the three chips come together
+        for (i = 0; i < 3; i++)
+        {
+            s32 from = (i - 1) * 84, x = cx + from * (14 - k) / 14 - 40, y = cy - 8;
+            char nm[MOVE_NAME_LENGTH + 1];
+            u16 c = Vfx_TypeColor(gBattleMoves[sPAAnimMoves[i]].type);
+            Draw_Box(fb, x, y, 80, 18, Gfx_Blend(c, COL_BLACK, 7), Gfx_Blend(c, COL_WHITE, 8), 15);
+            DrawChipIcon(fb, x + 1, y + 1, sPAAnimMoves[i], FALSE);
+            Pkbn_GameStringToAscii(nm, gMoveNames[sPAAnimMoves[i]], sizeof(nm));
+            Text(fb, x + 26, y + 1, nm, COL_WHITE);
+        }
+        return;
+    }
+    if (k < 19)
+    {
+        // they flash into one
+        s32 w = 80 + (k - 14) * 16, h = 18 + (k - 14) * 3;
+        Draw_Box(fb, cx - w / 2, cy - h / 2, w, h, COL_WHITE, COL_PA, 16);
+        return;
+    }
+    {
+        // the Program Advance's card
+        const struct PkbnProgramAdvance *pa = &gPkbnProgramAdvances[sPAAnimPA];
+        char line[32];
+        s32 w = 164, h = 36;
+        Draw_Box(fb, cx - w / 2, cy - h / 2, w, h, RGB(16, 2, 10), ((sTick / 4) & 1) ? COL_PA : COL_WHITE, 15);
+        DrawChipIcon(fb, cx - w / 2 + 6, cy - 8, pa->recipe[2], FALSE);
+        TextCentered(fb, cx + 12, cy - 18, "PROGRAM ADVANCE", ((sTick / 4) & 1) ? COL_WHITE : COL_PA, FALSE);
+        snprintf(line, sizeof(line), "%s %u", pa->name, pa->power);
+        TextCentered(fb, cx + 12, cy - 6, line, COL_GAUGE_FULL, TRUE);
+    }
+}
+
+// The Custom window's picture (its columns, CUS_W + its rim), kept to slide it out after OK.
+#define CUS_SHOT_W (CUS_W + 3)
+static u16 sCustomShot[CUS_SHOT_W * PKBN_CANVAS_H];
+static u32 sCustomOpenT;
+
+static void DrawCustomSliding(u16 *fb)
+{
+    static u16 sBase[PKBN_CANVAS_W * PKBN_CANVAS_H];
+    s32 x, y, k;
+    if (!sWasCustom)
+        sCustomOpenT = sTick;
+    sWasCustom = TRUE;
+    memcpy(sBase, fb, sizeof(sBase));
+    Gfx_Darken(sBase, 0, 0, CW, CH, 5);
+    DrawCustomScreen(fb);
+    for (y = 0; y < CH; y++)
+        memcpy(&sCustomShot[y * CUS_SHOT_W], &fb[y * CW], CUS_SHOT_W * sizeof(u16));
+    k = (s32)(sTick - sCustomOpenT);
+    if (k < SLIDE_IN)
+    {
+        // ease out: quick at first, settling in
+        s32 rem = SLIDE_IN - k, off = CUS_SHOT_W * rem * rem / (SLIDE_IN * SLIDE_IN);
+        for (y = 0; y < CH; y++)
+            for (x = 0; x < CUS_SHOT_W; x++)
+                fb[y * CW + x] = x + off < CUS_SHOT_W ? sCustomShot[y * CUS_SHOT_W + x + off] : sBase[y * CW + x];
+    }
+}
+
+static void DrawCustomClosing(u16 *fb)
+{
+    s32 x, y, off;
+    if (sWasCustom && sB.state != ST_CUSTOM)
+    {
+        sWasCustom = FALSE;
+        sCloseT = sB.state == ST_FIGHT ? SLIDE_OUT : 0;
+    }
+    if (sCloseT == 0)
+        return;
+    off = CUS_SHOT_W * (SLIDE_OUT - sCloseT + 1) * (SLIDE_OUT - sCloseT + 1) / (SLIDE_OUT * SLIDE_OUT);
+    sCloseT--;
+    for (y = 0; y < CH; y++)
+        for (x = 0; x + off < CUS_SHOT_W; x++)
+            fb[y * CW + x] = sCustomShot[y * CUS_SHOT_W + x + off];
+}
+
