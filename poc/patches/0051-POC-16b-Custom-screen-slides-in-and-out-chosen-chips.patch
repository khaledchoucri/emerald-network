         Draw_Box(fb, (CW - bw) / 2 - 6, 52, bw + 12, 16, RGB(16, 2, 10), COL_PA, 13);
@@ -1754,6 +1919,7 @@ void Draw_Overlay(u16 *fb)
         Draw_Box(fb, -2, 36, CW + 4, 20, COL_BOX, COL_BOX_EDGE, 14);
         TextCentered(fb, CW / 2, 37, sB.banner, COL_WHITE, TRUE);
