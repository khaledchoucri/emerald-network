-        tmp.tutorialSeen = 0xFF;   // a game already under way: no lessons, and NaviCust stays open as it was
+        tmp.tutorialSeen = tmp.tutorialSeen2 = 0xFF;   // a game already under way: no lessons, and NaviCust stays open as it was
     if (tmp.version < 5)
     {
         u16 mv;
@@ -631,14 +632,16 @@ void PkbnFolder_SetRegular(u8 folder, u16 move, u8 letter)
 }
 
 // POC-18: lessons (src/pkbn/tutorial.c)
-bool8 PkbnTutorial_Seen(u8 bits)
+bool8 PkbnTutorial_Seen(u16 bits)
 {
-    return (sSave.tutorialSeen & bits) == bits;
+    u16 seen = sSave.tutorialSeen | (sSave.tutorialSeen2 << 8);
+    return (seen & bits) == bits;
 }
 
-void PkbnTutorial_SetSeen(u8 bits)
+void PkbnTutorial_SetSeen(u16 bits)
 {
-    sSave.tutorialSeen |= bits;
+    sSave.tutorialSeen |= bits & 0xFF;
+    sSave.tutorialSeen2 |= bits >> 8;
 }
 
