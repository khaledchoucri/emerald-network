+// ---- POC-19: the FOLDER lesson (Khaled's pick: learn by doing, like NaviCust's). One line, then pulsing buttons:
+// A to take a chip out, R to the PACK page, A to put one in, L back to FOLDER, B to save. The second visit pulses SELECT (ready-made
+// folders and the Regular Chip) and START (Folder 1/2/3). Our design.
+enum { FL_NONE, FL_LINE, FL_TAKE, FL_PACK, FL_ADD, FL_BACK, FL_DONE, FL_SECOND };
+static u8 sLesson;
+static u8 sLessonCount;
+
+static void KeyCap(u16 *fb, s32 x, s32 y, const char *label)
+{
+    s32 w = Pkbn_EmTextWidth(label, PKBN_FONT_SMALL) + 8, bob = (s32)((sF.t / 6) % 4 == 3 ? 1 : 0);
+    u16 c = Gfx_Blend(RGB(31, 26, 6), RGB(31, 31, 31), (u8)((sF.t / 2) % 16 < 8 ? (sF.t / 2) % 8 : 8 - (sF.t / 2) % 8));
+    Draw_Box(fb, x, y - bob, w, 12, RGB(6, 5, 1), c, 16);
+    Text(fb, x + 4, y - 3 - bob, label, c);
+}
+
+static void DrawLesson(u16 *fb)
+{
+    switch (sLesson)
+    {
+    case FL_LINE:
+        Draw_Box(fb, 8, CH - 40, CW - 16, 34, RGB(29, 30, 31), RGB(6, 9, 16), 16);
+        Pkbn_DrawEmText(fb, 15, CH - 38, "Your chips go in your FOLDER.", PKBN_FONT_SMALL, RGB(6, 7, 9), RGB(22, 23, 25));
+        Pkbn_DrawEmText(fb, 15, CH - 28, "Build it yourself!", PKBN_FONT_SMALL, RGB(6, 7, 9), RGB(22, 23, 25));
+        if ((sF.t / 16) & 1)
+            Pkbn_FillRect(fb, CW - 20, CH - 15, 5, 1, RGB(31, 8, 6)), Pkbn_FillRect(fb, CW - 19, CH - 14, 3, 1, RGB(31, 8, 6)),
+            Pkbn_FillRect(fb, CW - 18, CH - 13, 1, 1, RGB(31, 8, 6));
+        break;
+    case FL_TAKE:
+        KeyCap(fb, PANEL_X - 8, LIST_Y + (sF.cursor[PAGE_FOLDER] - sF.top[PAGE_FOLDER]) * ROW_H, "A");
+        break;
+    case FL_PACK:
+        KeyCap(fb, 182, 6, "R");
+        break;
+    case FL_ADD:
+        KeyCap(fb, PANEL_X - 8, LIST_Y + (sF.cursor[PAGE_PACK] - sF.top[PAGE_PACK]) * ROW_H, "A");
+        break;
+    case FL_BACK:
+        KeyCap(fb, 182, 6, "L");
+        break;
+    case FL_DONE:
+        KeyCap(fb, CW - 26, CH - 26, "B");
+        break;
+    case FL_SECOND:
+        KeyCap(fb, 64, CH - 26, "SELECT");
+        KeyCap(fb, 112, CH - 26, "START");
+        break;
+    }
+}
+
+static void LessonFrame(u16 *keys)
+{
+    switch (sLesson)
+    {
+    case FL_LINE:
+        if (*keys & A_BUTTON)
+        {
+            PlaySE(SE_SELECT);
+            sLesson = sF.fCount ? FL_TAKE : FL_PACK;
+            sLessonCount = sF.fCount;
+        }
+        *keys = 0;
+        break;
+    case FL_TAKE:
+        *keys &= ~(B_BUTTON | L_BUTTON | R_BUTTON | START_BUTTON | SELECT_BUTTON);
+        if (sF.fCount < sLessonCount)
+            sLesson = FL_PACK, sLessonCount = sF.fCount;
+        break;
+    case FL_PACK:
+        *keys &= ~(B_BUTTON | L_BUTTON | START_BUTTON | SELECT_BUTTON | A_BUTTON);
+        if (sF.page == PAGE_PACK)
+            sLesson = FL_ADD;
+        break;
+    case FL_ADD:
+        *keys &= ~(B_BUTTON | START_BUTTON | SELECT_BUTTON);
+        if (sF.fCount > sLessonCount)
+            sLesson = FL_BACK;
+        else if (sF.page != PAGE_PACK)
+            sLesson = FL_PACK;
+        break;
+    case FL_BACK:
+        *keys &= ~(B_BUTTON | START_BUTTON | SELECT_BUTTON);
+        if (sF.page == PAGE_FOLDER)
+            sLesson = FL_DONE;
+        break;
+    case FL_DONE:
+        if (*keys & B_BUTTON)
+        {
+            sLesson = FL_NONE;
+            PkbnTutorial_SetSeen(TUT_FOLDER);
+        }
+        break;
+    case FL_SECOND:
+        if (*keys & (SELECT_BUTTON | START_BUTTON | B_BUTTON))
+        {
+            sLesson = FL_NONE;
+            PkbnTutorial_SetSeen(TUT_FOLDER2);
+        }
+        break;
+    }
+}
+
 static void Draw(u16 *fb)
 {
     s32 i;
@@ -904,6 +1006,7 @@ static void Draw(u16 *fb)
     DrawStyleMenu(fb);
     DrawPanel(fb);
     DrawHints(fb);
+    DrawLesson(fb);   // POC-19
 }
 
 // ---- input -----------------------------------------------------------------------------------------------------
@@ -1287,6 +1390,8 @@ static void CB2_Folder(void)
                 sKeys++;
         }
     }
+    if (sLesson)
+        LessonFrame(&keys);   // POC-19
     HandleInput(keys);
 }
 
@@ -1305,6 +1410,11 @@ void PkbnChipShelf_Open(MainCallback exitCallback)
 void PkbnFolderEdit_Open(MainCallback exitCallback)
 {
     OpenCommon(exitCallback);
+    sLesson = FL_NONE;
+    if (Tut_Enabled() && !PkbnTutorial_Seen(TUT_FOLDER))
+        sLesson = FL_LINE;
+    else if (Tut_Enabled() && !PkbnTutorial_Seen(TUT_FOLDER2))
+        sLesson = FL_SECOND;
     gPkbnCanvasOverlay = Draw;
     SetMainCallback2(CB2_Folder);
 }
