+// ---- POC-19j: Beast Out (Khaled's pick: BN6's Beast Out, the legendary bosses' reward) ------------------------------
+// BN6: the Cybeast button on the Custom screen; SetBeastOutCounterTo3 (asm/asm00_2.s:11743) - it lasts 3 turns,
+// one off per Custom; while out, elementless non-dimming chips +30, chips home in on the target, tapping B
+// rapid-fires the buster; when the counter ends MegaMan is tired, and going out again while tired ends in Beast Over
+// (bn6f data/textscript/TextScriptDadCybeastTut.s).
+// Ours (TUNE): opens once a legendary boss is beaten or caught. SELECT on the Custom screen arms it, OK lets it out:
+// 3 Customs of chips x1.3 (every chip: we have no elementless chips), a chip that can't reach the target jumps you to
+// a panel where it does, buster at twice the rate. Out again while tired = BEAST OVER when it ends: 1/4 max HP lost
+// and a second's stun.
+bool8 PkbnGrid_BeastAvailable(void)
+{
+    return PkbnBeast_Unlocked() && !sB.firstBattle && sB.beastTurns == 0;
+}
+
+bool8 PkbnGrid_BeastArmed(void)
+{
+    return sB.beastArmed;
+}
+
+static void BeastOut(void)
+{
+    struct Fighter *p = &sB.f[SIDE_PLAYER];
+    sB.beastArmed = FALSE;
+    sB.beastTurns = 3;
+    sB.beastOver = sB.beastTired;
+    p->hurtFlash = 30;
+    Flash("BEAST OUT!", 60);
+    PlaySE(SE_M_DRAGON_RAGE);
+    PKBN_LOG("BEAST OUT: %s (%s)", p->name, sB.beastOver ? "tired - beast over next" : "3 turns");
+}
+
+// Each Custom the counter goes down; at 0 the Pokémon is tired (or goes Beast Over).
+static void BeastTurn(void)
+{
+    struct Fighter *p = &sB.f[SIDE_PLAYER];
+    if (sB.beastTurns == 0 || --sB.beastTurns)
+        return;
+    if (sB.beastOver)
+    {
+        u16 loss = p->bm.maxHP / 4;
+        p->bm.hp = p->bm.hp > loss ? p->bm.hp - loss : 1;
+        p->stun = 60;
+        p->hurtFlash = 20;
+        Flash("BEAST OVER!", 60);
+        PlaySE(SE_M_SELF_DESTRUCT);
+        PKBN_LOG("BEAST OVER: %s loses %u HP", p->name, loss);
+        sB.beastOver = FALSE;
+    }
+    else
+        PKBN_LOG("beast out ended: %s is tired", p->name);
+    sB.beastTired = TRUE;
+}
+
+// While out: a chip that can't reach the target from here jumps you to the nearest panel it reaches it from.
+static void BeastRush(void)
+{
+    struct Fighter *p = &sB.f[SIDE_PLAYER];
+    const struct Fighter *t = &sB.f[SIDE_ENEMY];
+    const struct FolderChip *ch;
+    u8 q = sB.queue[0], kind;
+    s32 r, c, best = 99, bx = -1, by = -1;
+    if (!sB.beastTurns || !sB.queueCount || q == FOLDER_QUEUE_WILD || q >= QUEUE_PA_BASE)
+        return;
+    ch = &sB.folder.chips[q];
+    if (ch->owner != CHIP_SHARED && ch->owner != sB.active)
+        return;
+    kind = Moves_KindOf(ch->move);
+    if (Moves_IsPositionFree(kind) || Moves_WouldHit(kind, ch->move, p->x, p->y, t->x, t->y))
+        return;
+    for (r = 0; r < GRID_ROWS; r++)
+        for (c = 0; c < PLAYER_COLS; c++)
+            if (Field_CanStand(SIDE_PLAYER, c, r) && Moves_WouldHit(kind, ch->move, c, r, t->x, t->y))
+            {
+                s32 d = abs(c - p->x) + abs(r - p->y);
+                if (d < best)
+                    best = d, bx = c, by = r;
+            }
+    if (bx < 0)
+        return;
+    p->x = bx;
+    p->y = by;
+    PlaySE(SE_M_DOUBLE_TEAM);
+    PKBN_LOG("beast rush to (%d,%d)", (int)bx, (int)by);
+}
