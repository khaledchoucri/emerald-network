+// ---- Abilities on the grid (POC-13) ------------------------------------------------------------------------
+// Gen 3 rules where the grid has the same situation; ADAPT where it needs a grid meaning (Levitate, Truant).
+
+bool8 Field_Floats(const struct Fighter *f)
+{
+    // FlotShoe program (BN6); ADAPT: a Levitate Pokémon floats too - no poison panels, no ice slides, no cracking
+    return (f->navi.flags & NCPF_FLOAT_SHOES) || f->bm.ability == ABILITY_LEVITATE;
+}
+
+static void SayAbility(const struct Fighter *f, const char *what)
+{
+    char line[48], ab[ABILITY_NAME_LENGTH + 1];
+    Pkbn_GameStringToAscii(ab, gAbilityNames[f->bm.ability], sizeof(ab));
+    snprintf(line, sizeof(line), "%s'S %s %s", f->name, ab, what);
+    SetMsg(line, 70);
+    PKBN_LOG("%s", line);
+}
+
+// Switch-in abilities (ABILITYEFFECT_ON_SWITCHIN, battle_util.c:2532-2565). Weather from an ability is permanent, as in
+// Gen 3 (B_WEATHER_*_PERMANENT); a weather move can still replace it.
+void Field_OnEntry(u8 side)
+{
+    struct Fighter *f = &sB.f[side];
+    if (f->bm.hp == 0)
+        return;
+    switch (f->bm.ability)
+    {
+    case ABILITY_DRIZZLE:
+        if (!(sB.weather & B_WEATHER_RAIN_PERMANENT))
+        {
+            sB.weather = B_WEATHER_RAIN_PERMANENT | B_WEATHER_RAIN_TEMPORARY;
+            sB.weatherTurns = 0;
+            SayAbility(f, "MADE IT RAIN!");                 // BattleScript_DrizzleActivates
+        }
+        break;
+    case ABILITY_SAND_STREAM:
+        if (!(sB.weather & B_WEATHER_SANDSTORM_PERMANENT))
+        {
+            sB.weather = B_WEATHER_SANDSTORM;
+            sB.weatherTurns = 0;
+            SayAbility(f, "WHIPPED UP A SANDSTORM!");       // BattleScript_SandstreamActivates
+        }
+        break;
+    case ABILITY_DROUGHT:
+        if (!(sB.weather & B_WEATHER_SUN_PERMANENT))
+        {
+            sB.weather = B_WEATHER_SUN;
+            sB.weatherTurns = 0;
+            SayAbility(f, "INTENSIFIED THE SUN'S RAYS!");   // BattleScript_DroughtActivates
+        }
+        break;
+    case ABILITY_INTIMIDATE:
+        if (side == SIDE_PLAYER && sB.foeCount > 1)
+        {
+            s32 k;
+            for (k = 0; k < sB.foeCount; k++)   // a pack: every foe out there
+            {
+                Foe_Select(k);
+                if (sB.f[SIDE_ENEMY].bm.hp)
+                    Field_ApplyStatStage(SIDE_ENEMY, STAT_ATK, -1, TRUE);
+            }
+        }
+        else if (sB.f[side ^ 1].bm.hp)
+            Field_ApplyStatStage(side ^ 1, STAT_ATK, -1, TRUE);   // BattleScript_IntimidateActivates
+        SayAbility(f, "CUTS THE FOE'S ATTACK!");
+        break;
+    }
+}
+
+// Contact abilities (ABILITYEFFECT_MOVE_END, battle_util.c:2767-2860): Rough Skin 1/16 of the attacker's max HP;
+// Static / Flame Body / Poison Point 1 in 3; Effect Spore 1 in 10 (sleep, poison or paralysis); Cute Charm 1 in 3.
+void Field_ContactAbility(u8 defSide, u8 atkSide)
+{
+    struct Fighter *d = &sB.f[defSide];
+    struct Fighter *a = &sB.f[atkSide];
+    if (a->bm.hp == 0)
+        return;
+    switch (d->bm.ability)
+    {
+    case ABILITY_ROUGH_SKIN:
+    {
+        s32 dmg = a->bm.maxHP / 16;
+        Moves_DamageFighter(atkSide, dmg ? dmg : 1, "IS HURT BY ROUGH SKIN!");
+        break;
+    }
+    case ABILITY_STATIC:
+        if (Random() % 3 == 0)
+            Field_TryStatus(atkSide, defSide, MOVE_NONE, STATUS1_PARALYSIS, FALSE);
+        break;
+    case ABILITY_FLAME_BODY:
+        if (Random() % 3 == 0)
+            Field_TryStatus(atkSide, defSide, MOVE_NONE, STATUS1_BURN, FALSE);
+        break;
+    case ABILITY_POISON_POINT:
+        if (Random() % 3 == 0)
+            Field_TryStatus(atkSide, defSide, MOVE_NONE, STATUS1_POISON, FALSE);
+        break;
+    case ABILITY_EFFECT_SPORE:
+        if (Random() % 10 == 0)
+        {
+            static const u32 sSpore[3] = { STATUS1_SLEEP, STATUS1_POISON, STATUS1_PARALYSIS };
+            Field_TryStatus(atkSide, defSide, MOVE_NONE, sSpore[Random() % 3], FALSE);
+        }
+        break;
+    case ABILITY_CUTE_CHARM:
+        if (Random() % 3 == 0 && !a->infatuated && a->bm.ability != ABILITY_OBLIVIOUS)
+        {
+            u8 g1 = GetGenderFromSpeciesAndPersonality(d->bm.species, d->bm.personality);
+            u8 g2 = GetGenderFromSpeciesAndPersonality(a->bm.species, a->bm.personality);
+            if (g1 != MON_GENDERLESS && g2 != MON_GENDERLESS && g1 != g2)
+            {
+                a->infatuated = TRUE;
+                SayAbility(d, "INFATUATED THE ATTACKER!");
+            }
+        }
+        break;
+    }
+}
+
+// Can't run (IsRunningFromBattleImpossible / battle_main.c:4036-4070): Run Away always escapes; a foe's Shadow Tag
+// traps; Arena Trap traps a non-Flying, non-Levitate Pokémon; Magnet Pull traps a Steel type.
+const char *Field_EscapeBlocker(void)
+{
+    const struct Fighter *p = &sB.f[SIDE_PLAYER];
+    s32 k;
+    if (p->bm.ability == ABILITY_RUN_AWAY)
+        return NULL;
+    for (k = 0; k < sB.foeCount; k++)
+    {
+        const struct Fighter *e = Foe_Get(k);
+        if (e->bm.hp == 0)
+            continue;
+        if (e->bm.ability == ABILITY_SHADOW_TAG)
+            return "SHADOW TAG";
+        if (e->bm.ability == ABILITY_ARENA_TRAP && p->bm.ability != ABILITY_LEVITATE && !HasType(p, TYPE_FLYING))
+            return "ARENA TRAP";
+        if (e->bm.ability == ABILITY_MAGNET_PULL && HasType(p, TYPE_STEEL))
+            return "MAGNET PULL";
+    }
+    return NULL;
+}
