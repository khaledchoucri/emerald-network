+        if (sB.panel[f->y][f->x] == PANEL_POISON && !f->invuln && !Field_Floats(f)
          && !HasType(f, TYPE_POISON) && !HasType(f, TYPE_STEEL))
         {
             if (sB.poisonTick[s] == 0)
@@ -599,9 +743,12 @@ static void EndTurnFighter(u8 s)
         }
         if (f->bm.hp == 0)
             return;
-        // Sleep counts down (Gen 3 decrements on each move attempt; here once per turn).
+        // Sleep counts down (Gen 3 decrements on each move attempt; here once per turn). Early Bird: twice as fast
+        // (battle_util.c:2030).
         if (f->bm.status1 & STATUS1_SLEEP)
         {
+            if (f->bm.ability == ABILITY_EARLY_BIRD && (f->bm.status1 & STATUS1_SLEEP) > 1)
+                f->bm.status1 -= 1;
             f->bm.status1 -= 1;
             if ((f->bm.status1 & STATUS1_SLEEP) == 0)
             {
@@ -627,6 +774,40 @@ static void EndTurnFighter(u8 s)
         if (f->yawn && --f->yawn == 0)
             Field_TryStatus(s, s, MOVE_YAWN, STATUS1_SLEEP, FALSE);
         f->fakeOutReady = FALSE;
+        // end-of-turn abilities (ABILITYEFFECT_ENDTURN, battle_util.c:2600-2656)
+        switch (f->bm.ability)
+        {
+        case ABILITY_RAIN_DISH:
+            if ((sB.weather & B_WEATHER_RAIN) && f->bm.hp < f->bm.maxHP)
+            {
+                Heal(f, Frac(f, 16));
+                SayAbility(f, "RESTORED ITS HP A LITTLE!");
+            }
+            break;
+        case ABILITY_SHED_SKIN:
+            if (f->bm.status1 && Random() % 3 == 0)
+            {
+                f->bm.status1 = 0;
+                f->nightmare = FALSE;
+                SayAbility(f, "CURED ITS PROBLEM!");
+            }
+            break;
+        case ABILITY_SPEED_BOOST:
+            if (f->bm.statStages[STAT_SPEED] < MAX_STAT_STAGE)
+            {
+                f->bm.statStages[STAT_SPEED]++;
+                SayAbility(f, "RAISED ITS SPEED!");
+            }
+            break;
+        case ABILITY_TRUANT:
+            f->truantLoaf ^= 1;   // ADAPT: it acts every other turn (gDisableStructs.truantCounter)
+            if (f->truantLoaf)
+            {
+                snprintf(line, sizeof(line), "%s IS LOAFING AROUND!", f->name);
+                SetMsg(line, 70);
+            }
+            break;
+        }
     }
 }
 
