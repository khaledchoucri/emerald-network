+// Campaign runs: throw now? A new species (PkbnCamp_WantsCatch) at half HP or less, or from the third turn on.
+bool8 PkbnBot_CampaignThrow(void)
+{
+    extern bool8 PkbnCamp_WantsCatch(u16 species);
+    const struct Fighter *t = &sB.f[SIDE_ENEMY];
+    if (sB.trainer || t->bm.hp == 0 || !PkbnCamp_WantsCatch(t->bm.species))
+        return FALSE;
+    return t->bm.hp * 2 <= t->bm.maxHP || sB.turn >= 3;
+}
