+++ b/src/pkbn/campaign.c
@@ -0,0 +1,580 @@
+// Campaign runs: a test player plays the story's battles in order, from a plan file, so a playthrough up to the
+// third gym can be simulated and its logs read. Nothing here changes the game; it only drives it.
+//
+//   PKBN_CAMPAIGN=plan.txt   with PKBN_OWTEST (start map and party) and PKBN_OW_AUTOBATTLE=1 (the battles are fought
+//                            by the self-test autopilot, PKBN_BOT=smart for the test bot)
+//   PKBN_CAMP_CATCH=n        throw balls at new species while the party has fewer than n Pokémon (0: never)
+//   PKBN_CAMP_GRIND=n        percent of each "wild" line's encounters to fight (100 = as written; 200 = twice)
+//
+// The plan, one command per line ('#' starts a comment):
+//   mark <text>              a segment name for the log
+//   map <group> <num> <x> <y>    warp there
+//   wild <n>                 n encounters from this map's own grass / cave table (stands on an encounter tile first)
+//   scripted <species> <lv>  a scripted wild battle (Birch's Poochyena)
+//   trainer <id> [x y]       fight that trainer (skipped if already beaten); x y: stand there first
+//   leader <id> <x> <y> <key>    a Gym Leader, then the gym's own "defeated" script (badge, TM): key = stone / knuckle /
+//                            dynamo
+//   heal                     a Pokémon Center
+//   buy <item> <n>           buy up to n at the item's price, keeping 500 in hand
+//   end                      print the summary and quit
+//
+// A lost trainer battle whites out as in the game. The test player then grinds 4 wild battles where it last found
+// wild Pokémon, heals and tries again, up to 3 times, before moving on (logged as GAVE UP).
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "global.h"
+#include "main.h"
+#include "battle.h"
+#include "battle_setup.h"
+#include "event_data.h"
+#include "field_player_avatar.h"
+#include "field_screen_effect.h"
+#include "fieldmap.h"
+#include "item.h"
+#include "metatile_behavior.h"
+#include "money.h"
+#include "overworld.h"
+#include "palette.h"
+#include "pokedex.h"
+#include "pokemon.h"
+#include "random.h"
+#include "script.h"
+#include "script_pokemon_util.h"
+#include "constants/battle.h"
+#include "constants/maps.h"
+#include "constants/moves.h"
+
+#ifdef PORTABLE
+
+#define MAX_LINES 512
+
+enum { C_NONE, C_MARK, C_MAP, C_WILD, C_SCRIPTED, C_TRAINER, C_LEADER, C_HEAL, C_BUY, C_END };
+
+struct CampLine
+{
+    u8 cmd;
+    s32 a, b, c, d;
+    char text[48];
+};
+
+static struct CampLine sLines[MAX_LINES];
+static s32 sLineCount, sPc = -1;
+static s8 sActive = -1;
+static u32 sFrame, sBusySince, sIdleRun;
+static bool8 sWaiting, sSawBusy;
+static s32 sLeft;            // battles left in this line (wild) / tries left (trainer)
+static u8 sPhase;            // per-command step
+static char sSeg[48] = "start";
+static s16 sMapGroup = -1, sMapNum = -1, sWildGroup = -1, sWildNum = -1;
+u32 gPkbnCampBusterHits, gPkbnCampBusterDmg;
+static u32 sHeals, sBattles, sWins, sLosses, sGaveUp, sCaught, sBattleStart;
+static u16 sCatchMax, sGrind = 100;
+static s32 sGrindLeft;
+static bool8 sGrindFought, sTriedMove;
+
+extern void CB2_PkbnGridBattle(void);
+
+bool8 PkbnCamp_Active(void)
+{
+    if (sActive < 0)
+        sActive = getenv("PKBN_CAMPAIGN") != NULL;
+    return sActive;
+}
+
+static void Load(void)
+{
+    FILE *f = fopen(getenv("PKBN_CAMPAIGN"), "r");
+    char buf[160];
+    if (f == NULL)
+    {
+        printf("[pkbn-camp] no plan file %s\n", getenv("PKBN_CAMPAIGN"));
+        exit(2);
+    }
+    while (fgets(buf, sizeof(buf), f) && sLineCount < MAX_LINES)
+    {
+        struct CampLine *l = &sLines[sLineCount];
+        char word[24] = "", *hash = strchr(buf, '#');
+        if (hash)
+            *hash = 0;
+        memset(l, 0, sizeof(*l));
+        l->c = l->d = -1;
+        if (sscanf(buf, "%23s", word) != 1)
+            continue;
+        if (!strcmp(word, "mark"))
+        {
+            char *t = strstr(buf, "mark") + 4;
+            while (*t == ' ') t++;
+            snprintf(l->text, sizeof(l->text), "%s", t);
+            l->text[strcspn(l->text, "\r\n")] = 0;
+            l->cmd = C_MARK;
+        }
+        else if (!strcmp(word, "map"))
+            l->cmd = C_MAP, sscanf(buf, "%*s %d %d %d %d", &l->a, &l->b, &l->c, &l->d);
+        else if (!strcmp(word, "wild"))
+            l->cmd = C_WILD, sscanf(buf, "%*s %d", &l->a);
+        else if (!strcmp(word, "scripted"))
+            l->cmd = C_SCRIPTED, sscanf(buf, "%*s %d %d", &l->a, &l->b);
+        else if (!strcmp(word, "trainer"))
+            l->cmd = C_TRAINER, sscanf(buf, "%*s %d %d %d", &l->a, &l->c, &l->d);
+        else if (!strcmp(word, "leader"))
+            l->cmd = C_LEADER, sscanf(buf, "%*s %d %d %d %47s", &l->a, &l->c, &l->d, l->text);
+        else if (!strcmp(word, "heal"))
+            l->cmd = C_HEAL;
+        else if (!strcmp(word, "buy"))
+            l->cmd = C_BUY, sscanf(buf, "%*s %d %d", &l->a, &l->b);
+        else if (!strcmp(word, "end"))
+            l->cmd = C_END;
+        else
+            continue;
+        sLineCount++;
+    }
+    fclose(f);
+    if (getenv("PKBN_TEST_SEED") != NULL)
+        gRngValue = (u32)strtoul(getenv("PKBN_TEST_SEED"), NULL, 10);   // the same luck again
+    sCatchMax = getenv("PKBN_CAMP_CATCH") ? atoi(getenv("PKBN_CAMP_CATCH")) : 0;
+    sGrind = getenv("PKBN_CAMP_GRIND") ? atoi(getenv("PKBN_CAMP_GRIND")) : 100;
+    printf("[pkbn-camp] plan: %d lines, catch to %u, grind %u%%\n", (int)sLineCount, sCatchMax, sGrind);
+}
+
+// The field is waiting for the player: no script, no fade, no menu, controls free.
+static bool8 FieldIdle(void)
+{
+    return gMain.callback2 == CB2_Overworld && !ScriptContext_IsEnabled() && !ArePlayerFieldControlsLocked()
+        && !gPaletteFade.active;
+}
+
+static void PartyLine(char *dst, u32 size)
+{
+    s32 i, n = 0;
+    dst[0] = 0;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        u16 sp = GetMonData(mon, MON_DATA_SPECIES);
+        if (sp == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG))
+            continue;
+        n += snprintf(dst + n, size - n, "%s%u:%u:%u/%u", n ? "," : "", sp, (unsigned)GetMonData(mon, MON_DATA_LEVEL),
+                      (unsigned)GetMonData(mon, MON_DATA_HP), (unsigned)GetMonData(mon, MON_DATA_MAX_HP));
+        if (n >= (s32)size)
+            break;
+    }
+}
+
+static void Wait(void)
+{
+    sWaiting = TRUE;
+    sSawBusy = FALSE;
+    sIdleRun = 0;
+    sBusySince = sFrame;
+}
+
+// Stand on an encounter tile of this map (a grass tile whose neighbours are grass too, when there is one).
+static bool8 OnEncounterTile(void)
+{
+    s16 x, y;
+    PlayerGetDestCoords(&x, &y);
+    return MetatileBehavior_IsLandWildEncounter(MapGridGetMetatileBehaviorAt(x, y));
+}
+
+static bool8 MoveToEncounterTile(void)
+{
+    s32 w = gMapHeader.mapLayout->width, h = gMapHeader.mapLayout->height, x, y, n = 0, pick, best = 0;
+    // two passes: count the tiles, then take one at random
+    for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+            if (MetatileBehavior_IsLandWildEncounter(MapGridGetMetatileBehaviorAt(x + MAP_OFFSET, y + MAP_OFFSET)))
+                n++;
+    if (n == 0)
+        return FALSE;
+    pick = Random() % n;
+    for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+            if (MetatileBehavior_IsLandWildEncounter(MapGridGetMetatileBehaviorAt(x + MAP_OFFSET, y + MAP_OFFSET))
+             && best++ == pick)
+            {
+                SetWarpDestination(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum, WARP_ID_NONE,
+                                   x, y);
+                DoWarp();
+                return TRUE;
+            }
+    return FALSE;
+}
+
+static void StartTrainer(u16 id)
+{
+    // trainerbattle TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT, id, LOCALID_NONE, <defeat text>; end
+    // (asm/macros/event.inc:730, the 64-bit build's ptrvalue is a .quad)
+    static const u8 sNoText[] = { 0xFF };
+    static u8 sScr[16];
+    const u8 *p = sNoText;
+    sScr[0] = 0x5C, sScr[1] = 3;
+    sScr[2] = id & 0xFF, sScr[3] = id >> 8;
+    sScr[4] = 0, sScr[5] = 0;
+    memcpy(&sScr[6], &p, sizeof(p));
+    sScr[6 + sizeof(p)] = 0x02;
+    ScriptContext_SetupScript(sScr);
+}
+
+extern const u8 RustboroCity_Gym_EventScript_RoxanneDefeated[];
+extern const u8 DewfordTown_Gym_EventScript_BrawlyDefeated[];
+extern const u8 MauvilleCity_Gym_EventScript_WattsonDefeated[];
+
+static const u8 *LeaderScript(const char *key)
+{
+    if (!strcmp(key, "stone"))   return RustboroCity_Gym_EventScript_RoxanneDefeated;
+    if (!strcmp(key, "knuckle")) return DewfordTown_Gym_EventScript_BrawlyDefeated;
+    if (!strcmp(key, "dynamo"))  return MauvilleCity_Gym_EventScript_WattsonDefeated;
+    return NULL;
+}
+
+static void LogBattle(const char *kind, s32 id)
+{
+    char party[160];
+    PartyLine(party, sizeof(party));
+    sBattles++;
+    if (gBattleOutcome == B_OUTCOME_WON || gBattleOutcome == B_OUTCOME_CAUGHT)
+        sWins++;
+    if (gBattleOutcome == B_OUTCOME_LOST || gBattleOutcome == B_OUTCOME_DREW)
+        sLosses++;
+    if (gBattleOutcome == B_OUTCOME_CAUGHT)
+        sCaught++;
+    printf("[pkbn-camp] battle %u seg=\"%s\" %s %d outcome=%u frames=%u money=%u buster=%u/%u party=%s\n", sBattles,
+           sSeg, kind, (int)id, gBattleOutcome, sFrame - sBattleStart, (unsigned)GetMoney(&gSaveBlock1Ptr->money),
+           gPkbnCampBusterHits, gPkbnCampBusterDmg, party);
+    gPkbnCampBusterHits = gPkbnCampBusterDmg = 0;
+    fflush(stdout);
+    {
+        // the test player heals (a Pokémon Center or Potions) when the lead has fainted or the party is below 1/3
+        u32 hp = 0, max = 0;
+        s32 i;
+        for (i = 0; i < PARTY_SIZE; i++)
+            if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE)
+                hp += GetMonData(&gPlayerParty[i], MON_DATA_HP), max += GetMonData(&gPlayerParty[i], MON_DATA_MAX_HP);
+        if (gBattleOutcome != B_OUTCOME_LOST && max
+         && (GetMonData(&gPlayerParty[0], MON_DATA_HP) == 0 || hp * 3 < max))
+        {
+            HealPlayerParty();
+            sHeals++;
+            printf("[pkbn-camp] healed (lead fainted or party under 1/3)\n");
+        }
+    }
+}
+
+static void Next(void)
+{
+    sPc++;
+    sPhase = 0;
+    sTriedMove = FALSE;
+}
+
+// Back to a map after a white-out, at its first warp (a door or the route's entrance)
+static void WarpBack(s16 group, s16 num)
+{
+    SetWarpDestinationToMapWarp(group, num, 0);
+    DoWarp();
+}
+
+// One step of the current command, run when the field is idle. Returns after starting something to wait for.
+static void Step(void)
+{
+    struct CampLine *l;
+    if (sPc < 0)
+        Next();
+    if (sPc >= sLineCount)
+    {
+        printf("[pkbn-camp] plan ran out\n");
+        exit(0);
+    }
+    l = &sLines[sPc];
+    switch (l->cmd)
+    {
+    case C_MARK:
+        snprintf(sSeg, sizeof(sSeg), "%s", l->text);
+        {
+            char party[160];
+            PartyLine(party, sizeof(party));
+            printf("[pkbn-camp] === %s (frame %u) party=%s\n", sSeg, sFrame, party);
+        }
+        Next();
+        return;
+    case C_MAP:
+        sMapGroup = l->a, sMapNum = l->b;
+        SetWarpDestination(l->a, l->b, WARP_ID_NONE, l->c, l->d);
+        DoWarp();
+        Next();
+        Wait();
+        return;
+    case C_HEAL:
+        HealPlayerParty();
+        Next();
+        return;
+    case C_BUY:
+    {
+        u32 price = GetItemPrice(l->a), money = GetMoney(&gSaveBlock1Ptr->money), n = 0;
+        while (n < (u32)l->b && price && money >= price + 500)
+            money -= price, n++;
+        if (n)
+        {
+            RemoveMoney(&gSaveBlock1Ptr->money, n * price);
+            AddBagItem(l->a, n);
+        }
+        printf("[pkbn-camp] bought %u of item %d (%u each), money %u\n", n, (int)l->a, price, money);
+        Next();
+        return;
+    }
+    case C_SCRIPTED:
+        if (sPhase == 0)
+        {
+            sBattleStart = sFrame;
+            gBattleOutcome = 0;
+            CreateScriptedWildMon(l->a, l->b, ITEM_NONE);
+            BattleSetup_StartWildBattle();
+            sPhase = 1;
+            Wait();
+            return;
+        }
+        LogBattle("scripted", l->a);
+        Next();
+        return;
+    case C_WILD:
+    {
+        extern bool8 PkbnWild_CampaignEncounter(void);
+        if (sPhase == 0)
+        {
+            sLeft = (l->a * sGrind + 50) / 100;
+            sPhase = 1;
+        }
+        else if (sPhase == 2)
+        {
+            LogBattle("wild", 0);
+            if (gBattleOutcome == B_OUTCOME_LOST || gBattleOutcome == B_OUTCOME_DREW)
+            {
+                // whited out: back to where we were (a Pokémon Center healed us)
+                sPhase = 3;
+                WarpBack(sWildGroup, sWildNum);
+                Wait();
+                return;
+            }
+            sPhase = 1;
+        }
+        else if (sPhase == 3)
+            sPhase = 1, sTriedMove = FALSE;
+        if (sLeft <= 0)
+        {
+            Next();
+            return;
+        }
+        if (!OnEncounterTile())
+        {
+            if (!sTriedMove && MoveToEncounterTile())
+            {
+                sTriedMove = TRUE;   // one move per arrival
+                Wait();
+                return;
+            }
+            printf("[pkbn-camp] no encounter tile on map %d:%d\n", gSaveBlock1Ptr->location.mapGroup,
+                   gSaveBlock1Ptr->location.mapNum);
+            Next();
+            return;
+        }
+        sWildGroup = gSaveBlock1Ptr->location.mapGroup, sWildNum = gSaveBlock1Ptr->location.mapNum;
+        sBattleStart = sFrame;
+        gBattleOutcome = 0;
+        if (!PkbnWild_CampaignEncounter())
+        {
+            printf("[pkbn-camp] no wild table here\n");
+            Next();
+            return;
+        }
+        sLeft--;
+        sPhase = 2;
+        Wait();
+        return;
+    }
+    case C_TRAINER:
+    case C_LEADER:
+        switch (sPhase)
+        {
+        case 0:
+            if (HasTrainerBeenFought(l->a))
+            {
+                printf("[pkbn-camp] trainer %d already beaten\n", (int)l->a);
+                Next();
+                return;
+            }
+            sLeft = 3;   // retries
+            sPhase = 1;
+            // fall through
+        case 1:
+            if (l->c >= 0)
+            {
+                SetWarpDestination(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum, WARP_ID_NONE,
+                                   l->c, l->d);
+                DoWarp();
+                sPhase = 2;
+                Wait();
+                return;
+            }
+            // fall through
+        case 2:
+            sBattleStart = sFrame;
+            gBattleOutcome = 0;
+            StartTrainer(l->a);
+            sPhase = 3;
+            Wait();
+            return;
+        case 3:
+            LogBattle(l->cmd == C_LEADER ? "leader" : "trainer", l->a);
+            if (gBattleOutcome == B_OUTCOME_WON)
+            {
+                if (l->cmd == C_LEADER && LeaderScript(l->text))
+                {
+                    ScriptContext_SetupScript(LeaderScript(l->text));
+                    printf("[pkbn-camp] %s badge script\n", l->text);
+                    Next();
+                    Wait();
+                    return;
+                }
+                Next();
+                return;
+            }
+            if (sLeft-- <= 0)
+            {
+                printf("[pkbn-camp] GAVE UP on trainer %d\n", (int)l->a);
+                sGaveUp++;
+                sPhase = 6;
+                WarpBack(sMapGroup, sMapNum);
+                Wait();
+                return;
+            }
+            // whited out: grind 4 battles where the wild Pokémon were, then come back
+            printf("[pkbn-camp] lost to trainer %d: grinding, %d tries left\n", (int)l->a, (int)sLeft);
+            sGrindLeft = 4;
+            sGrindFought = FALSE;
+            if (sWildGroup >= 0)
+            {
+                WarpBack(sWildGroup, sWildNum);
+                sPhase = 4;
+                Wait();
+                return;
+            }
+            sPhase = 5;
+            WarpBack(sMapGroup, sMapNum);
+            Wait();
+            return;
+        case 4:
+        {
+            extern bool8 PkbnWild_CampaignEncounter(void);
+            if (sGrindFought)
+                LogBattle("grind", 0), sGrindFought = FALSE;
+            if (sGrindLeft > 0 && !OnEncounterTile() && MoveToEncounterTile())
+            {
+                Wait();
+                return;
+            }
+            if (sGrindLeft > 0 && OnEncounterTile())
+            {
+                sBattleStart = sFrame;
+                gBattleOutcome = 0;
+                if (PkbnWild_CampaignEncounter())
+                {
+                    sGrindLeft--;
+                    sGrindFought = TRUE;
+                    Wait();
+                    return;
+                }
+            }
+            HealPlayerParty();
+            sPhase = 5;
+            WarpBack(sMapGroup, sMapNum);
+            Wait();
+            return;
+        }
+        case 5:
+            sPhase = 1;   // try again from the trainer's spot
+            return;
+        case 6:
+            Next();
+            return;
+        }
+        return;
+    case C_END:
+    {
+        char party[160];
+        PartyLine(party, sizeof(party));
+        printf("[pkbn-camp] END battles=%u wins=%u losses=%u gaveup=%u caught=%u heals=%u frames=%u money=%u party=%s\n",
+               sBattles, sWins, sLosses, sGaveUp, sCaught, sHeals, sFrame, (unsigned)GetMoney(&gSaveBlock1Ptr->money), party);
+        fflush(stdout);
+        exit(0);
+    }
+    }
+    Next();
+}
+
+// Called by the overworld self-test's key hook every frame while a campaign runs.
+u16 PkbnCamp_Keys(void)
+{
+    sFrame++;
+    if (sPc < 0 && sLineCount == 0)
+        Load();
+    if (sWaiting)
+    {
+        if (!FieldIdle())
+        {
+            sSawBusy = TRUE;
+            sIdleRun = 0;
+            if (sFrame - sBusySince > 60 * 60 * 15)
+            {
+                printf("[pkbn-camp] STALLED at line %d (callback %p)\n", (int)sPc, (void *)gMain.callback2);
+                fflush(stdout);
+                exit(3);
+            }
+            // text boxes, results, evolution: A (the battle's own autopilot overrides this in battle)
+            return (sFrame % 8) < 3 ? A_BUTTON : 0;
+        }
+        if (++sIdleRun < 20 || (!sSawBusy && sFrame - sBusySince < 600))
+            return 0;
+        sWaiting = FALSE;
+    }
+    if (!FieldIdle())
+    {
+        Wait();
+        return 0;
+    }
+    Step();
+    return 0;
+}
+
+// Catching (PKBN_CAMP_CATCH): a species the player hasn't caught, while the party has room.
+bool8 PkbnCamp_WantsCatch(u16 species)
+{
+    if (!PkbnCamp_Active() || sCatchMax == 0 || gPlayerPartyCount >= sCatchMax)
+        return FALSE;
+    return !GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_GET_CAUGHT);
+}
+
+// Move learning: forget the weakest move when the new one is stronger (a status move counts as 20 power, damaging
+// moves of the Pokémon's own type 1.5x). Returns the slot, or MAX_MON_MOVES to keep the old moves.
+u8 PkbnCamp_ForgetSlot(struct Pokemon *mon, u16 newMove)
+{
+    u16 sp = GetMonData(mon, MON_DATA_SPECIES);
+    s32 i, worst = -1, worstScore = 0x7FFFFFFF, newScore;
+#define SCORE(mv) (gBattleMoves[mv].power == 0 ? 20 : (s32)gBattleMoves[mv].power \
+        * ((gBattleMoves[mv].type == gSpeciesInfo[sp].types[0] || gBattleMoves[mv].type == gSpeciesInfo[sp].types[1]) \
+        ? 3 : 2) / 2 * (gBattleMoves[mv].accuracy ? gBattleMoves[mv].accuracy : 100) / 100)
+    newScore = SCORE(newMove);
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 mv = GetMonData(mon, MON_DATA_MOVE1 + i);
+        s32 s = SCORE(mv);
+        if (s < worstScore)
+            worstScore = s, worst = i;
+    }
+#undef SCORE
+    if (worst < 0 || newScore <= worstScore)
+        return MAX_MON_MOVES;
+    return (u8)worst;
+}
