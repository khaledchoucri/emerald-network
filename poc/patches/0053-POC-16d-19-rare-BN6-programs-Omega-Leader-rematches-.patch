+    // POC-16d: BN6's [B]+Left programs - Shield, Reflect ("Strong shield!", "Reflect attacks!") and AntiDmg ("Throw a
+    // star!"): hold B and press back. Ours: the shield lasts 30 frames, the star is Swift (Emerald's star move); 150
+    // frames to recharge (TUNE).
+    if (p->navi.leftB && (held & B_BUTTON) && (keys & DPAD_LEFT) && p->leftBCd == 0)
+    {
+        p->leftBCd = 150;
+        p->moveCd = 12;   // the press doesn't also step back
+        if (p->navi.leftB == 3)
+        {
+            TargetForPlayer();
+            Moves_Use(SIDE_PLAYER, MOVE_SWIFT, 0, &p->bm, p->name, sB.active);
+            SetMsg("ANTIDMG: STAR!", 40);
+        }
+        else
+        {
+            p->shieldT = 30;
+            SetMsg(p->navi.leftB == 2 ? "REFLECT!" : "SHIELD!", 30);
+            PlaySE(SE_M_REFLECT);   // Protect's sound (Move_PROTECT)
+        }
+        PKBN_LOG("%s: B+back program %u", p->name, p->navi.leftB);
