+            continue;
+        hp = GetMonData(mon, MON_DATA_HP);
+        max = GetMonData(mon, MON_DATA_MAX_HP);
+        if (hp == 0 || hp >= max)
+            continue;
+        Navi_StatsForMon(mon, &s);
+        if (!s.autoHeal)
+            continue;
+        hp = hp + max * s.autoHeal / 100 > max ? max : hp + max * s.autoHeal / 100;
+        SetMonData(mon, MON_DATA_HP, &hp);
+        printf("[pkbn] autoheal: party slot %d -> %u/%u\n", (int)i, hp, max);
+    }
+}
