+static void OmegaWin(u8 l, u32 frames, char *line1, char *line2, u32 size)
+{
+    u32 s10 = frames * 10 / 60;
+    u16 best = PkbnLeader_OmegaBest(l);
+    if (frames > 0xFFFF)
+        frames = 0xFFFF;
+    if (best == 0 || frames < best)
+        PkbnLeader_SetOmegaBest(l, frames);
+    if (!PkbnLeader_OmegaWon(l))
