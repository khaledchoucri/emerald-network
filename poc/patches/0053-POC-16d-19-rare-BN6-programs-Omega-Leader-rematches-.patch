+        else
+            snprintf(line1, size, "OMEGA %s DEFEATED AGAIN!", sNames[l]);
+        snprintf(line2, size, "GOT A * CHIP OF THE ACE'S MOVE!");
+    }
+    printf("[pkbn] omega win: %s %u frames: %s / %s\n", sNames[l], (unsigned)frames, line1, line2);
