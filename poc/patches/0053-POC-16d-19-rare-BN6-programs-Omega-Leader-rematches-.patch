+    }
+    else
+    {
+        // a repeat Ω win: a * copy of the ace's move, and the Ω record
+        u16 species, mv;
+        u8 lv;
+        Leader_Ace(l, &species, &lv, &mv);
+        PkbnPack_Add(mv, LETTER_WILD, 1);
+        if (best == 0 || frames < best)
