+// POC-16d: Ω - the Leader's Pokémon 5 levels higher (TUNE) and the tier-6 rival: Ω AI and NaviCust (src/pkbn/rival.c).
+static void ApplyOmega(void)
+{
+    s32 i, k;
+    char nm[16];
+    sB.omega = TRUE;
+    sB.rivalTier = 6;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gEnemyParty[i];
+        u16 sp = GetMonData(mon, MON_DATA_SPECIES);
+        u32 lv, exp, hp;
+        if (sp == SPECIES_NONE)
+            continue;
+        lv = GetMonData(mon, MON_DATA_LEVEL) + 5;
+        if (lv > MAX_LEVEL)
+            lv = MAX_LEVEL;
+        exp = gExperienceTables[gSpeciesInfo[sp].growthRate][lv];
+        SetMonData(mon, MON_DATA_EXP, &exp);
+        SetMonData(mon, MON_DATA_LEVEL, &lv);
+        CalculateMonStats(mon);
+        hp = GetMonData(mon, MON_DATA_MAX_HP);
+        SetMonData(mon, MON_DATA_HP, &hp);
+    }
+    for (k = 0; k < sB.foeCount; k++)
+    {
+        s8 x, y;
+        Foe_Select(k);
+        x = sB.f[SIDE_ENEMY].x, y = sB.f[SIDE_ENEMY].y;
+        LoadEnemy(&gEnemyParty[sB.foeSlot[k]]);
+        sB.f[SIDE_ENEMY].x = x, sB.f[SIDE_ENEMY].y = y;
+    }
+    Foe_Select(0);
+    Pkbn_GameStringToAscii(nm, gTrainers[gTrainerBattleOpponent_A].trainerName, sizeof(nm));
+    snprintf(sB.banner, sizeof(sB.banner), "OMEGA %s WANTS TO BATTLE!", nm);
+    PKBN_LOG("omega rematch: trainer %u, levels +5, tier 6", gTrainerBattleOpponent_A);
+}
+
+static void UpdateOmegaChoice(void)
+{
+    u16 keys = gMain.newKeys;
+    if (keys & (DPAD_UP | DPAD_DOWN))
+    {
+        sB.omegaCursor ^= 1;
+        PlaySE(SE_SELECT);
+    }
+    if (keys & A_BUTTON)
+    {
+        if (sB.omegaCursor)
+        {
+            ApplyOmega();
+            PlaySE(SE_M_DRAGON_RAGE);
+        }
+        else
+            PlaySE(SE_SELECT);
+        sB.state = ST_INTRO;
+    }
+}
