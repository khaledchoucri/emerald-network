+// BN6 multi-delete (bit 3), now that wild packs exist (POC-11): deletes within a 10-tick window chain, the largest
+// chain m scores (m-1)*2 (sub_800AE44 / sub_800AE0C, asm/asm00_1.s:16931-16972), with BN6's call-out text
+// (TextScript86F0374). Counted with the chip-chain ADAPT above: the better of the two scores.
+void Busting_NoteDelete(void)
+{
+    static const char *const sCall[] = { "DOUBLE DELETE!", "TRIPLE DELETE!", "QUADRUPLE DELETE!" };
+    if (sB.bust.fightFrames > sB.bust.deleteUntil)
+        sB.bust.deleteRun = 0;
+    sB.bust.deleteRun++;
+    sB.bust.deleteUntil = sB.bust.fightFrames + 10;
+    if (sB.bust.deleteRun > sB.bust.multiDelete)
+        sB.bust.multiDelete = sB.bust.deleteRun;
+    if (sB.bust.deleteRun >= 2)
+    {
+        u8 k = sB.bust.deleteRun - 2 < 2 ? sB.bust.deleteRun - 2 : 2;
+        strncpy(sB.flashText, sCall[k], sizeof(sB.flashText) - 1);
+        sB.flashTimer = 60;
+        PKBN_LOG("%s", sCall[k]);
+    }
+}
