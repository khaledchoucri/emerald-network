+// A pack (POC-11): each foe that goes down gives its EXP at once; the battle is won when the last one falls.
+static bool8 CheckPackFaints(void)
+{
+    s32 k, i;
+    s8 last = -1;
+    for (k = 0; k < sB.foeCount; k++)
+    {
+        char text[40];
+        u32 zero = 0;
+        if (sB.foeDown[k] || Foe_Get(k)->bm.hp)
+            continue;
+        Foe_Select(k);
+        sB.foeDown[k] = TRUE;
+        last = k;
+        SetMonData(&gEnemyParty[sB.foeSlot[k]], MON_DATA_HP, &zero);
+        AwardExpForFaintedEnemy();
+        Busting_NoteDelete();
+        for (i = 0; i < MAX_ATTACKS; i++)   // a deleted virus's attacks go with it (BN)
+            if (sB.attacks[i].active && sB.attacks[i].side == SIDE_ENEMY && sB.attacks[i].foe == k)
+                sB.attacks[i].active = FALSE;
+        snprintf(text, sizeof(text), "WILD %s FAINTED!", sB.f[SIDE_ENEMY].name);
+        PKBN_LOG("pack: %s down, %u left", sB.f[SIDE_ENEMY].name, Foe_LiveCount());
+        if (Foe_LiveCount() == 0)
+        {
+            EndBattle(B_OUTCOME_WON, text);
+            return TRUE;
+        }
+        SetMsg(text, 60);
+        PlaySE(SE_FAINT);
+    }
+    (void)last;
+    return FALSE;
+}
