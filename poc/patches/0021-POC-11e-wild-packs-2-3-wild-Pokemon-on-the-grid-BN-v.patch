+// Owtests: allow a pack from the current map's land table (Gsp:lv starts a scripted battle otherwise).
+bool8 PkbnWild_AllowPackHere(void)
+{
+    u16 headerId = GetCurrentMapWildMonHeaderId();
+    if (headerId == HEADER_NONE || gWildMonHeaders[headerId].landMonsInfo == NULL)
+        return FALSE;
+    PkbnWild_AllowPack(gWildMonHeaders[headerId].landMonsInfo, WILD_AREA_LAND);
+    return TRUE;
+}
+
+// Read by the grid battle at its start: was this battle a standard grass / water encounter?
+bool8 PkbnWild_PackAllowed(void)
+{
+    return sPkbnPackInfo != NULL;
+}
+
+void PkbnWild_ClearPack(void)
+{
+    sPkbnPackInfo = NULL;
+}
+
+// One more wild Pokémon into gEnemyParty[slot] (CreateWildMon without the party wipe; no Cute Charm roll).
+bool8 PkbnWild_GenerateExtra(u8 slot)
+{
+    u8 idx, level;
+    if (sPkbnPackInfo == NULL || slot >= PARTY_SIZE)
+        return FALSE;
+    idx = (sPkbnPackArea == WILD_AREA_LAND) ? ChooseWildMonIndex_Land() : ChooseWildMonIndex_WaterRock();
+    level = ChooseWildMonLevel(&sPkbnPackInfo->wildPokemon[idx]);
+    CreateMonWithNature(&gEnemyParty[slot], sPkbnPackInfo->wildPokemon[idx].species, level, USE_RANDOM_IVS, PickWildMonNature());
+    return TRUE;
+}
+#endif
