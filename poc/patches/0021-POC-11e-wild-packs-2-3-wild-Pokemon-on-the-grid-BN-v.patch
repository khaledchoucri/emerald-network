+// ---- Foes (POC-11 multi-enemy wild battles) ---------------------------------------------------------
+// The rules code talks to sB.f[SIDE_ENEMY]; with a pack, the foe being worked on is swapped in there.
+
+void Foe_Select(u8 i)
+{
+    if (i == sB.cur || i >= sB.foeCount)
+        return;
+    sB.foes[sB.cur] = sB.f[SIDE_ENEMY];
+    sB.foeAi[sB.cur][0] = sB.aiStepTimer;
+    sB.foeAi[sB.cur][1] = sB.aiAttackTimer;
+    sB.f[SIDE_ENEMY] = sB.foes[i];
+    sB.aiStepTimer = sB.foeAi[i][0];
+    sB.aiAttackTimer = sB.foeAi[i][1];
+    sB.cur = i;
+    sB.enemySlot = sB.foeSlot[i];
+}
+
+const struct Fighter *Foe_Get(u8 i)
+{
+    return i == sB.cur ? &sB.f[SIDE_ENEMY] : &sB.foes[i];
+}
+
+s8 Foe_At(s8 x, s8 y, bool8 hittable)
+{
+    s32 i;
+    for (i = 0; i < sB.foeCount; i++)
+    {
+        const struct Fighter *f = Foe_Get(i);
+        if (f->bm.hp && f->x == x && f->y == y && (!hittable || !f->invuln))
+            return i;
+    }
+    return -1;
+}
+
+u8 Foe_LiveCount(void)
+{
+    s32 i, n = 0;
+    for (i = 0; i < sB.foeCount; i++)
+        if (Foe_Get(i)->bm.hp)
+            n++;
+    return n;
+}
+
+// Nearest live foe in the player's row (what a buster or cannon meets first), else the closest one. TUNE.
+u8 Foe_PlayerTarget(void)
+{
+    const struct Fighter *p = &sB.f[SIDE_PLAYER];
+    s32 i, best = -1, bestScore = 0;
+    if (sB.foeCount <= 1)
+        return sB.cur;
+    for (i = 0; i < sB.foeCount; i++)
+    {
+        const struct Fighter *f = Foe_Get(i);
+        s32 score;
+        if (f->bm.hp == 0)
+            continue;
+        score = 10 * abs(f->y - p->y) + (f->x - p->x);
+        if (best < 0 || score < bestScore)
+            best = i, bestScore = score;
+    }
+    return best < 0 ? sB.cur : best;
+}
+
+static void TargetForPlayer(void)
+{
+    Foe_Select(Foe_PlayerTarget());
+}
