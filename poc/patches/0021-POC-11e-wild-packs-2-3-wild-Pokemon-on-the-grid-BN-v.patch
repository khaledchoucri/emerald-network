+// POC-11: how many extra wild Pokémon join (TUNE): none before the first badge 90% of the time; with b badges a pack
+// of 2 is 25 + 4b %, and 3b % of all battles are a pack of 3. Only standard grass / water encounters
+// (src/wild_encounter.c PkbnWild_AllowPack). Self-tests: PKBN_TEST_FOES="species:level,species:level".
+static void AddWildPack(void)
+{
+    const char *t = getenv("PKBN_TEST_FOES");
+    s32 n = 0, extra = 0, b, r;
+    if (t != NULL)
+    {
+        while (*t && n < MAX_FOES - 1)
+        {
+            u16 sp = (u16)strtol(t, (char **)&t, 10);
+            u8 lv = 5;
+            if (*t == ':')
+                lv = (u8)strtol(t + 1, (char **)&t, 10);
+            CreateMon(&gEnemyParty[1 + n], sp, lv, 32, FALSE, 0, OT_ID_PLAYER_ID, 0);
+            n++;
+            while (*t == ',')
+                t++;
+        }
+        return;
+    }
+    if (!PkbnWild_PackAllowed())
+        return;
+    for (b = 0, r = FLAG_BADGE01_GET; r <= FLAG_BADGE08_GET; r++)
+        b += FlagGet(r) ? 1 : 0;
+    r = Random() % 100;
+    if (r < 3 * b)
+        extra = 2;
+    else if (r < (b == 0 ? 10 : 25 + 4 * b))
+        extra = 1;
+    if (getenv("PKBN_TEST_PACK_EXTRA") != NULL)   // owtests: force the pack size, still drawn from the map's table
+        extra = atoi(getenv("PKBN_TEST_PACK_EXTRA"));
+    for (n = 0; n < extra; n++)
+        if (!PkbnWild_GenerateExtra(1 + n))
+            break;
+    if (extra)
+        PKBN_LOG("wild pack roll %d with %d badges: +%d", (int)r, (int)b, (int)extra);
+}
