-// Candy shop (design 10 §10.1): moves in the level-up learnset of a Pokémon you own, once it has reached
-// max(the level it learns the move at, the move's MB).
-static void ConsiderLearnset(u16 species, u8 level, bool8 *ok)
+// Candy shop (design 10 §10.1): moves in the level-up learnset of a Pokémon you own, once it has reached the
+// level it learns them at. Exception: an evolved form's level-1 moves (Raichu's Thunderbolt, Weezing's
+// Self-Destruct) need the move's MB in level, so evolving early doesn't unlock strong chips.
+static bool8 sIsEvolved[NUM_SPECIES];
+static u8 sNeed[MOVES_COUNT];        // lowest level still needed (0 = unlocked), 0xFF = no owned Pokémon learns it
+static u16 sBy[MOVES_COUNT];
+
+static void ConsiderLearnset(u16 species, u8 level)
 {
     const u16 *ls;
     s32 i;
@@ -129,39 +164,56 @@ static void ConsiderLearnset(u16 species, u8 level, bool8 *ok)
     {
         u16 mv = ls[i] & LEVEL_UP_MOVE_ID;
         u8 lv = ls[i] >> 9;
-        u8 need = lv > Chip_MB(mv) ? lv : Chip_MB(mv);
-        if (mv < MOVES_COUNT && level >= need && PkbnFolder_MoveIsChip(mv))
-            ok[mv] = TRUE;
+        u8 need = lv;
+        u8 missing;
+        if (mv >= MOVES_COUNT || !PkbnFolder_MoveIsChip(mv))
+            continue;
+        if (lv <= 1 && sIsEvolved[species] && Chip_MB(mv) > need)
+            need = Chip_MB(mv);
+        missing = level >= need ? 0 : need;
+        if (sNeed[mv] == 0xFF || missing < sNeed[mv])
+            sNeed[mv] = missing, sBy[mv] = species;
     }
 }
 
