+// The folder as grouped rows: one per chip (move + code) with its count, sorted by type, move, code.
+static void BuildGroups(void)
+{
+    u8 t, l;
+    u16 mv;
+    sF.groupCount = 0;
+    for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+        for (mv = 1; mv < MOVES_COUNT; mv++)
+            if (gBattleMoves[mv].type == t && InFolder(mv, -1))
+                for (l = 0; l < PACK_LETTERS; l++)
+                {
+                    u8 n = InFolder(mv, l);
+                    if (n)
+                    {
+                        sF.groups[sF.groupCount].move = mv;
+                        sF.groups[sF.groupCount].letter = l;
+                        sF.groups[sF.groupCount].count = n;
+                        sF.groupCount++;
+                    }
+                }
+}
