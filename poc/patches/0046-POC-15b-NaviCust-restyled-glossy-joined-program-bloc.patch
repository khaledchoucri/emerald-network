+// POC-15 look (our art, in the BN6 style): a program cell is a glossy block. Cells of the same piece join (no edge
+// between them); `open` says which sides have a neighbour of the same piece (1 left, 2 right, 4 up, 8 down).
+static void DrawBlock(u16 *fb, s32 x, s32 y, u16 col, u8 open, bool8 plus)
+{
+    s32 px, py, x0, y0, x1, y1;
+    u16 light = Gfx_Blend(col, RGB(31, 31, 31), 8), dark = Gfx_Blend(col, RGB(0, 0, 0), 9);
+    u16 deep = Gfx_Blend(col, RGB(0, 0, 0), 13);
+    CellRect(x, y, &px, &py);
+    x0 = px + ((open & 1) ? 0 : 1);
+    y0 = py + ((open & 4) ? 0 : 1);
+    x1 = px + CELL - ((open & 2) ? 0 : 1);
+    y1 = py + CELL - ((open & 8) ? 0 : 1);
+    Pkbn_FillRect(fb, x0, y0, x1 - x0, y1 - y0, col);
+    // the piece's outline and bevel only on its outer edges
+    if (!(open & 4)) { Pkbn_FillRect(fb, x0, y0, x1 - x0, 1, deep); Pkbn_FillRect(fb, x0, y0 + 1, x1 - x0, 2, light); }
+    if (!(open & 1)) { Pkbn_FillRect(fb, x0, y0, 1, y1 - y0, deep); Pkbn_FillRect(fb, x0 + 1, y0 + 1, 2, y1 - y0 - 1, light); }
+    if (!(open & 8)) { Pkbn_FillRect(fb, x0, y1 - 1, x1 - x0, 1, deep); Pkbn_FillRect(fb, x0 + 1, y1 - 3, x1 - x0 - 1, 2, dark); }
+    if (!(open & 2)) { Pkbn_FillRect(fb, x1 - 1, y0, 1, y1 - y0, deep); Pkbn_FillRect(fb, x1 - 3, y0 + 1, 2, y1 - y0 - 1, dark); }
+    // the inner plate of every cell, and a glint
+    Pkbn_FillRect(fb, px + 5, py + 5, CELL - 10, CELL - 10, Gfx_Blend(col, RGB(31, 31, 31), 3));
+    Pkbn_FrameRect(fb, px + 5, py + 5, CELL - 10, CELL - 10, Gfx_Blend(col, RGB(0, 0, 0), 5));
+    Pkbn_FillRect(fb, px + 6, py + 6, 3, 1, RGB(31, 31, 31));
+    Pkbn_FillRect(fb, px + 6, py + 7, 1, 2, RGB(31, 31, 31));
+    if (plus)
+    {
+        // plus parts carry a "+" (they need no command line)
+        Pkbn_FillRect(fb, px + CELL / 2 - 3, py + CELL / 2, 7, 1, dark);
+        Pkbn_FillRect(fb, px + CELL / 2, py + CELL / 2 - 3, 1, 7, dark);
+    }
+}
