+// POC-16: an Ω (the game's font has none). Two hand-drawn sizes; `scale` multiplies them.
+static const char *const sOmegaSmall[9] = {
+    "..#####..", ".#.....#.", "#.......#", "#.......#", "#.......#", ".#.....#.", "..#...#..", "..#...#..", "###...###" };
+static const char *const sOmegaBig[13] = {
+    "....#####....", "..##.....##..", ".##.......##.", "##.........##", "##.........##", "##.........##",
+    "##.........##", ".##.......##.", "..##.....##..", "...##...##...", "...##...##...", "####.....####",
+    "####.....####" };
+
+void Gfx_DrawOmega(u16 *fb, s32 x, s32 y, bool8 big, s32 scale, u16 color)
+{
+    const char *const *rows = big ? sOmegaBig : sOmegaSmall;
+    s32 n = big ? 13 : 9, r, c;
+    for (r = 0; r < n; r++)
+        for (c = 0; rows[r][c]; c++)
+            if (rows[r][c] == '#')
+                Pkbn_FillRect(fb, x + c * scale, y + r * scale, scale, scale, color);
+}
