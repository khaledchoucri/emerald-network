index 0000000..8193ced
--- /dev/null
+++ b/src/pkbn/results.c
@@ -0,0 +1,341 @@
+// POC-19: BN6's results window after a battle (Khaled: "Post battle reward screen needs to look nicer... Maybe we can use
+// the one from BN"). include/pkbn/results.h.
+//
+// Grounding (bn6f, read by a research pass and checked by rendering the data):
+//  - sub_802BD60 / sub_802C34E (asm/asm03_0.s:11516, 12353): a 24x18-tile window in BG 3, chosen from three tilesets and
+//    tilemaps (RESULT, WINNER!, LOSER), slid in from tile column -30 by 2 tiles a frame (sub_802BE36, :11618).
+//  - The delete time as BCD m:ss:hh at window columns 14, 16-17, 19-20 (sub_802C4E8, :12558), the Busting Level next to
+//    its label (sub_802C6EC, :12830; 11 shows as S).
+//  - The reward picture (7x6 tiles at window tile 14,10) is revealed one tile a frame in a shuffled order
+//    (ShuffleByteList_PrimaryRNG, sub_802BF6C / sub_802C044, :11809-11960), a tick every 4th tile, then a 30-frame
+//    pause and the reward's name (sub_802C0A4, :11976); A moves on (sub_802BF0C).
+//  - Zenny and HP rewards use BN6's own pictures; a chip uses its chip picture (ours: Vfx_DrawChipArt).
+// Sounds: BN6's results sounds (0x7E, 0x95, 0x96) aren't in this game's sound table; Emerald's are used (ours).
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "main.h"
+#include "sound.h"
+#include "random.h"
+#include "data.h"
+#include "constants/songs.h"
+#include "pkbn/grid_internal.h"
+#include "pkbn/busting.h"
+#include "pkbn/results.h"
+#include "pkbn/render.h"
+#include "pkbn/gfx.h"
+#include "pkbn/folder.h"
+void PkbnDraw_ChipIcon(u16 *fb, s32 x, s32 y, u16 move, bool8 dim);   // grid_draw.c
+#include <stdio.h>
+#include <string.h>
+
+#ifdef PORTABLE
+
+#if __has_include("pkbn/bn6_results_data.h")
+#include "pkbn/bn6_results_data.h"
+#define HAVE_BN6_RESULTS 1
+#else
+#define HAVE_BN6_RESULTS 0
+#endif
+
+#define WIN_W 24
+#define WIN_H 18
+#define PIC_X 14   // the reward picture, in window tiles
+#define PIC_Y 10
+#define PIC_W 7
+#define PIC_H 6
+
+enum { RS_SLIDE, RS_REVEAL, RS_PAUSE, RS_NAME, RS_DONE };
+
+static struct
+{
+    bool8 on;
+    u8 window, level, state, revealed, order[PIC_W * PIC_H];
+    bool8 capture;
+    u16 frames, t, x;
+    u16 map[WIN_W * WIN_H];
+    u16 pic[PIC_W * 8 * PIC_H * 8];   // the reward picture, drawn once
+    bool8 picOpaque[PIC_W * 8 * PIC_H * 8];
+    char name[32];
+} sR;
+
+bool8 Results_Available(void)
+{
+    return HAVE_BN6_RESULTS;
+}
+
+#if HAVE_BN6_RESULTS
+static const u8 *const sTiles[3] = { sBn6ResTiles0, sBn6ResTiles1, sBn6ResTiles2 };
+static const u16 *const sMaps[3] = { sBn6ResMap0, sBn6ResMap1, sBn6ResMap2 };
+static const u32 sTileBytes[3] = { sizeof(sBn6ResTiles0), sizeof(sBn6ResTiles1), sizeof(sBn6ResTiles2) };
+
+// One 8x8 tile of the window's VRAM: tiles from 1 (the window), from 0xA0 (digits); 0 = empty.
+static const u8 *TileData(u16 ti)
+{
+    if (ti >= 1 && (u32)(ti - 1) * 32 + 32 <= sTileBytes[sR.window])
+        return &sTiles[sR.window][(ti - 1) * 32];
+    if (ti >= 0xA0 && (u32)(ti - 0xA0) * 32 + 32 <= sizeof(sBn6ResDigits))
+        return &sBn6ResDigits[(ti - 0xA0) * 32];
+    return NULL;
+}
+
+static void PutDigit(s32 col, s32 row, u8 glyph)   // glyph 0-9, or 11 = "S"
+{
+    if (col < 0 || col >= WIN_W || row < 0 || row + 1 >= WIN_H)
+        return;
+    sR.map[row * WIN_W + col] = 0x9000 | (0xA0 + 2 * glyph);
+    sR.map[(row + 1) * WIN_W + col] = 0x9000 | (0xA0 + 2 * glyph + 1);
+}
+#endif
+
+static void DrawPicture(void)
+{
+    // the reward picture into sR.pic (56x48), drawn once on a scratch canvas
+    static u16 sScratch[PKBN_CANVAS_W * PKBN_CANVAS_H];
+    s32 x, y;
+    const u16 bg = PKBN_RGB(5, 5, 5);
+    for (x = 0; x < PKBN_CANVAS_W * PKBN_CANVAS_H; x++)
+        sScratch[x] = bg;
+    memset(sR.picOpaque, 0, sizeof(sR.picOpaque));
+    Pkbn_SetTarget(PKBN_CANVAS_W, PKBN_CANVAS_H);
+    switch (gPkbnReward.kind)
+    {
+    case RW_CHIP:
+    case RW_CHIPS:
+        if (gPkbnReward.move)
+        {
+            // the chip's icon (the one in the Custom screen's slots), twice the size, on its type's colour fading down
+            u16 tc = Vfx_TypeColor(gBattleMoves[gPkbnReward.move].type);
+            s32 i, j;
+            PkbnDraw_ChipIcon(sScratch, 200, 0, gPkbnReward.move, FALSE);
+            for (y = 0; y < PIC_H * 8; y++)
+                Pkbn_FillRect(sScratch, 100, 60 + y, PIC_W * 8, 1,
+                              Gfx_Blend(Gfx_Blend(tc, PKBN_RGB(0, 0, 0), 8), PKBN_RGB(0, 0, 0), (u8)(y * 10 / (PIC_H * 8))));
+            for (j = 0; j < 16 * 2; j++)
+                for (i = 0; i < 22 * 2; i++)
+                    sScratch[(60 + 8 + j) * PKBN_CANVAS_W + 100 + 6 + i] = sScratch[(j / 2) * PKBN_CANVAS_W + 200 + i / 2];
+        }
+        break;
+#if HAVE_BN6_RESULTS
+    case RW_MONEY:
+    case RW_HP:
+    {
+        // BN6's zenny / HP pictures: 7x6 tiles, 4bpp, row-major
+        const u8 *t = gPkbnReward.kind == RW_MONEY ? sBn6ResZenny : sBn6ResHP;
+        const u16 *p = gPkbnReward.kind == RW_MONEY ? sBn6ResZennyPal : sBn6ResHPPal;
+        s32 k;
+        for (k = 0; k < PIC_W * PIC_H; k++)
+            for (y = 0; y < 8; y++)
+                for (x = 0; x < 8; x++)
+                {
+                    u8 b = t[k * 32 + y * 4 + x / 2], c = (x & 1) ? b >> 4 : b & 15;
+                    sScratch[((k / PIC_W) * 8 + y) * PKBN_CANVAS_W + (k % PIC_W) * 8 + x] = c ? (p[c] | 0x8000) : bg;
+                }
+        break;
+    }
+#endif
+    case RW_CANDY:
+        Gfx_Ellipse(sScratch, 28, 24, 14, 12, Vfx_TypeColor(gPkbnReward.type), 16);
+        Gfx_Ellipse(sScratch, 24, 20, 4, 3, PKBN_RGB(31, 31, 31), 10);
+        break;
+    }
+    {
+        // chip art was drawn around (128, 90); the zenny / HP / candy pictures at (0, 0)
+        bool8 art = gPkbnReward.kind == RW_CHIP || gPkbnReward.kind == RW_CHIPS;
+        s32 sx = art ? 100 : 0, sy = art ? 60 : 0;
+        for (y = 0; y < PIC_H * 8; y++)
+            for (x = 0; x < PIC_W * 8; x++)
+                sR.pic[y * PIC_W * 8 + x] = sScratch[(sy + y) * PKBN_CANVAS_W + sx + x];
+    }
+}
+
+void Results_Begin(u8 window, u16 frames, u8 level, bool8 capture)
+{
+    s32 i, cs, sec, min;
+    memset(&sR, 0, sizeof(sR));
+    if (!HAVE_BN6_RESULTS)
+        return;
+    sR.on = TRUE;
+    sR.window = window > 2 ? 0 : window;
+    sR.level = level;
+    sR.capture = capture;
+    sR.frames = frames;
+    sR.state = RS_SLIDE;
+#if HAVE_BN6_RESULTS
+    memcpy(sR.map, sMaps[sR.window], sizeof(sR.map));
+    if (sR.window != RESULTS_LOSER)
+    {
+        // the delete time (capped at 9:59:99 like BN6's 0x95999), then the level
+        cs = frames * 100 / 60;
+        if (cs > 9 * 6000 + 5999)
+            cs = 9 * 6000 + 5999;
+        min = cs / 6000, sec = (cs / 100) % 60, cs %= 100;
+        PutDigit(14, 4, min);
+        PutDigit(16, 4, sec / 10), PutDigit(17, 4, sec % 10);
+        PutDigit(19, 4, cs / 10), PutDigit(20, 4, cs % 10);
+        if (level >= 11)
+            PutDigit(20, 6, 11);
+        else if (level >= 10)
+            PutDigit(19, 6, level / 10), PutDigit(20, 6, level % 10);
+        else
+            PutDigit(20, 6, level);
+    }
+#endif
+    for (i = 0; i < PIC_W * PIC_H; i++)
+        sR.order[i] = i;
+    for (i = PIC_W * PIC_H - 1; i > 0; i--)   // BN6: ShuffleByteList_PrimaryRNG
+    {
+        u8 j = Random() % (i + 1), tmp = sR.order[i];
+        sR.order[i] = sR.order[j], sR.order[j] = tmp;
+    }
+    DrawPicture();
+    switch (gPkbnReward.kind)
+    {
+    case RW_CHIP:
+    {
+        char nm[MOVE_NAME_LENGTH + 1];
+        Pkbn_GameStringToAscii(nm, gMoveNames[gPkbnReward.move], sizeof(nm));
+        snprintf(sR.name, sizeof(sR.name), "%s %c%s", nm, PkbnFolder_LetterChar(gPkbnReward.letter),
+                 gPkbnReward.copies > 1 ? " x2" : "");
+        if (gPkbnReward.copies > 2)
+            snprintf(sR.name, sizeof(sR.name), "%s %c x%u", nm, PkbnFolder_LetterChar(gPkbnReward.letter), gPkbnReward.copies);
+        break;
+    }
+    case RW_CHIPS:
+    {
+        char nm[MOVE_NAME_LENGTH + 1];
+        Pkbn_GameStringToAscii(nm, gMoveNames[gPkbnReward.move], sizeof(nm));
+        snprintf(sR.name, sizeof(sR.name), "%s...", nm);
+        break;
+    }
+    case RW_MONEY:
+        snprintf(sR.name, sizeof(sR.name), "$%u", (unsigned)gPkbnReward.amount);   // (BN6 zenny picture, Emerald money)
+        break;
+    case RW_HP:
+        snprintf(sR.name, sizeof(sR.name), "HP +%u", (unsigned)gPkbnReward.amount);
+        break;
+    case RW_CANDY:
+    {
+        char t[16];
+        Pkbn_GameStringToAscii(t, gTypeNames[gPkbnReward.type], sizeof(t));
+        snprintf(sR.name, sizeof(sR.name), "%s CANDY x%u", t, (unsigned)gPkbnReward.amount);
+        break;
+    }
+    }
+    sR.x = 0;
+}
+
+bool8 Results_Active(void)
+{
+    return sR.on;
+}
+
+// TRUE once the player has seen it all (A after the name). autopilot: no A needed.
+bool8 Results_Frame(u16 newKeys, bool8 autopilot)
+{
+    if (!sR.on)
+        return TRUE;
+    sR.t++;
+    switch (sR.state)
+    {
+    case RS_SLIDE:
+        // BN6: from column -30, 2 tiles a frame (asm/asm03_0.s:11618)
+        if (sR.t >= 16)
+        {
+            sR.state = gPkbnReward.kind == RW_NONE ? RS_NAME : RS_REVEAL;
+            sR.t = 0;
+            PlaySE(SE_PIN);
+        }
+        break;
+    case RS_REVEAL:
+        sR.revealed = sR.t > PIC_W * PIC_H ? PIC_W * PIC_H : sR.t;
+        if ((sR.t & 3) == 0 && sR.revealed < PIC_W * PIC_H)
+            PlaySE(SE_BALL_TRAY_BALL);   // a tick every 4th tile (BN6 plays 0x7E)
+        if (sR.revealed >= PIC_W * PIC_H)
+            sR.state = RS_PAUSE, sR.t = 0;
+        if (newKeys & A_BUTTON)
+            sR.revealed = PIC_W * PIC_H, sR.state = RS_PAUSE, sR.t = 29;   // A hurries it
+        break;
+    case RS_PAUSE:
+        if (sR.t >= 30)   // BN6: 30 frames, then the name
+        {
+            sR.state = RS_NAME, sR.t = 0;
+            PlaySE(gPkbnReward.kind == RW_CHIP || gPkbnReward.kind == RW_CHIPS ? SE_RG_POKE_JUMP_SUCCESS : SE_SHOP);
+        }
+        break;
+    case RS_NAME:
+        if ((newKeys & A_BUTTON) || (autopilot && sR.t > 20))
+        {
+            sR.state = RS_DONE;
+            PlaySE(SE_SELECT);
+        }
+        break;
+    case RS_DONE:
+        sR.on = FALSE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+void Results_Draw(u16 *fb)
+{
+#if HAVE_BN6_RESULTS
+    s32 ox, oy = (PKBN_CANVAS_H - WIN_H * 8) / 2, tx, ty, x, y, target = (PKBN_CANVAS_W - WIN_W * 8) / 2;
+    if (!sR.on)
+        return;
+    ox = sR.state == RS_SLIDE ? -WIN_W * 8 + (target + WIN_W * 8) * (sR.t + 1) / 16 : target;
+    if (ox > target)
+        ox = target;
+    for (ty = 0; ty < WIN_H; ty++)
+        for (tx = 0; tx < WIN_W; tx++)
+        {
+            u16 e = sR.map[ty * WIN_W + tx];
+            const u8 *t = TileData(e & 0x3FF);
+            u8 pal = (e >> 12) - 9;
+            if (t == NULL || pal > 2)
+                continue;
+            for (y = 0; y < 8; y++)
+                for (x = 0; x < 8; x++)
+                {
+                    s32 sx = (e & 0x400) ? 7 - x : x, sy = (e & 0x800) ? 7 - y : y;
+                    u8 b = t[sy * 4 + sx / 2], c = (sx & 1) ? b >> 4 : b & 15;
+                    s32 X = ox + tx * 8 + x, Y = oy + ty * 8 + y;
+                    if (c && X >= 0 && X < PKBN_CANVAS_W && Y >= 0 && Y < PKBN_CANVAS_H)
+                        fb[Y * PKBN_CANVAS_W + X] = sBn6ResPal[pal * 16 + c] | 0x8000;
+                }
+        }
+    if (sR.capture)
+    {
+        // our label over "Busting LV." (BN6 has no capture grade)
+        Pkbn_FillRect(fb, ox + 3 * 8, oy + 6 * 8, 11 * 8, 14, PKBN_RGB(11, 14, 21));   // (the band's blue)
+        Pkbn_DrawEmText(fb, ox + 3 * 8 + 2, oy + 6 * 8 - 1, "Capture GR.", PKBN_FONT_NORMAL, PKBN_RGB(31, 31, 31),
+                        PKBN_RGB(4, 6, 12));
+    }
+    if (sR.state >= RS_REVEAL)
+    {
+        s32 k;
+        for (k = 0; k < (sR.state == RS_REVEAL ? sR.revealed : PIC_W * PIC_H); k++)
+        {
+            u8 cell = sR.order[k];
+            s32 cx = (cell % PIC_W) * 8, cy = (cell / PIC_W) * 8;
+            for (y = 0; y < 8; y++)
+                for (x = 0; x < 8; x++)
+                    fb[(oy + PIC_Y * 8 + cy + y) * PKBN_CANVAS_W + ox + PIC_X * 8 + cx + x] = sR.pic[(cy + y) * PIC_W * 8 + cx + x];
+        }
+    }
+    if (sR.state >= RS_NAME && sR.name[0])
+    {
+        Pkbn_DrawEmText(fb, ox + 2 * 8 + 3, oy + 12 * 8 + 1, sR.name, PKBN_FONT_NORMAL, PKBN_RGB(31, 31, 31), PKBN_RGB(6, 6, 9));
+        if ((sR.t / 16) & 1)
+        {
+            s32 ax = ox + WIN_W * 8 - 14, ay = oy + WIN_H * 8 - 14;
+            Pkbn_FillRect(fb, ax, ay, 5, 1, PKBN_RGB(31, 8, 6));
+            Pkbn_FillRect(fb, ax + 1, ay + 1, 3, 1, PKBN_RGB(31, 8, 6));
+            Pkbn_FillRect(fb, ax + 2, ay + 2, 1, 1, PKBN_RGB(31, 8, 6));
+        }
+    }
+#else
+    (void)fb;
+#endif
+}
