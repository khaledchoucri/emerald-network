+#ifndef GUARD_PKBN_RESULTS_H
+#define GUARD_PKBN_RESULTS_H
+// POC-19: BN6's results window (src/pkbn/results.c). The reward comes from gPkbnReward (include/pkbn/busting.h).
+#include "global.h"
+
+enum { RESULTS_RESULT, RESULTS_WINNER, RESULTS_LOSER };   // BN6's three windows
+
+bool8 Results_Available(void);   // FALSE when the build has no BN6 data (include/pkbn/bn6_results_data.h)
+void Results_Begin(u8 window, u16 frames, u8 level, bool8 capture);
+bool8 Results_Frame(u16 newKeys, bool8 autopilot);   // TRUE when done
+bool8 Results_Active(void);
+void Results_Draw(u16 *fb);      // on the 264x176 canvas
+
+extern u16 gPkbnBattleSnapshot[];   // the last battle frame (src/pkbn/grid_battle.c), behind the post-battle screens
+#endif
