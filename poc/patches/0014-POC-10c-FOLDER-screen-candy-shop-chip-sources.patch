diff --git a/src/pkbn/folder.c b/src/pkbn/folder.c
index 5cc5a76..cebf054 100644
--- a/src/pkbn/folder.c
+++ b/src/pkbn/folder.c
@@ -84,6 +84,28 @@ static u32 ChipValue(u16 move, const struct BattlePokemon *bm)
     return v;
 }
 
+u8 PkbnFolder_PartyBattleMons(struct BattlePokemon *out)
+{
+    s32 i, m, n = 0;
+    memset(out, 0, sizeof(struct BattlePokemon) * PKBN_PARTY_MAX);
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        u16 sp = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES);
+        if (sp == SPECIES_NONE)
+            break;
+        n = i + 1;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            continue;
+        out[i].species = sp;
+        out[i].level = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+        out[i].types[0] = gSpeciesInfo[sp].types[0];
+        out[i].types[1] = gSpeciesInfo[sp].types[1];
+        for (m = 0; m < MAX_MON_MOVES; m++)
+            out[i].moves[m] = GetMonData(&gPlayerParty[i], MON_DATA_MOVE1 + m);
+    }
+    return n;
+}
+
 // The folder (design 08 §11): the edited folder when there is one (FOLDER editor, later), otherwise auto-built
 // from the pack: greedy, one copy at a time, favouring chips several party members can use and members that
 // have little so far (tools/shared_folder_sim.py's "balanced" builder). BN6 copy caps by MB.
@@ -104,6 +126,37 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
             mons++;
     size = Chip_FolderSize(mons);
 
+    {
+        // The FOLDER screen's folder: its chips in order, while the pack still has them, someone can use them, the
+        // copy caps hold and they fit (30 + 2 per extra Pokémon).
+        u16 em[PKBN_FOLDER_SLOTS];
+        u8 el[PKBN_FOLDER_SLOTS], ne = PkbnFolderEdit_Get(em, el), cnt[PACK_LETTERS];
+        if (ne > 0)
+        {
+            for (i = 0; i < ne && folder->count < size; i++)
+            {
+                s32 k, same = 0, sameCode = 0;
+                for (k = 0; k < folder->count; k++)
+                {
+                    same += folder->chips[k].move == em[i];
+                    sameCode += folder->chips[k].move == em[i] && folder->chips[k].letter == el[i];
+                }
+                for (p = 0; p < partyCount; p++)
+                    if (Chip_CanUse(&party[p], em[i]))
+                        break;
+                if (p == partyCount || same >= Chip_CopyCap(em[i]) || sameCode >= PkbnPack_Get(em[i], el[i]))
+                    continue;
+                folder->chips[folder->count].move = em[i];
+                folder->chips[folder->count].letter = el[i];
+                folder->chips[folder->count].owner = CHIP_SHARED;
+                folder->chips[folder->count].slot = 0;
+                folder->count++;
+            }
+            (void)cnt;
+            goto shuffle;
+        }
+    }
+
     for (mv = 1; mv < MOVES_COUNT; mv++)
     {
         if (!PkbnFolder_MoveIsChip(mv) || PkbnPack_Total(mv) == 0)
@@ -158,6 +211,7 @@ void PkbnFolder_Build(struct Folder *folder, const struct BattlePokemon *party,
                 usable[p]++;
     }
 
+shuffle:
     for (p = 0; p < folder->count; p++)
         folder->pile[p] = p;
     folder->pileCount = folder->count;
diff --git a/src/pkbn/folder_ui.c b/src/pkbn/folder_ui.c
new file mode 100644
index 0000000..14984ec
--- /dev/null
+++ b/src/pkbn/folder_ui.c
@@ -0,0 +1,598 @@
+// The FOLDER screen (POC-10c): START menu -> FOLDER. Drawn on our 264x176 canvas.
+// docs/design/08-folder-memory.md §11-12, docs/design/10-catching-and-chips.md §10.
+//
+// Three pages (L / R):
+//   FOLDER  the chips battles draw from. A: take a chip out. SELECT: auto-build again. B: save and leave.
+//   PACK    every chip you own. A: put one in the folder. START: use a PP UP on it (+1 copy).
+//           SELECT: use a PP MAX on it (copies of that move up to its cap).
+//   CANDY   chips you can buy with type candy: moves of that type a Pokémon you own has reached by level-up
+//           (and at least the move's MB in level). A: buy (cost MB/4). SELECT: change the code (+2 candy).
+#include "pkbn/grid_vfx.h"   // first: it pulls in <stdlib.h> before global.h's macros
+#include "global.h"
+#include "battle_main.h"
+#include "data.h"
+#include "item.h"
+#include "main.h"
+#include "pokemon.h"
+#include "pokemon_storage_system.h"
+#include "sound.h"
+#include "constants/items.h"
+#include "constants/songs.h"
+#include "pkbn/chip_pack.h"
+#include "pkbn/move_table.h"
+#include "pkbn/render.h"
+#include "pkbn/gfx.h"
+
+#ifdef PORTABLE
+#include <stdio.h>
+#include <string.h>
+
+#define CW PKBN_CANVAS_W
+#define CH PKBN_CANVAS_H
+#define RGB PKBN_RGB
+#define LIST_X 4
+#define LIST_Y 24
+#define LIST_ROWS 12
+#define ROW_H 11
+#define PANEL_X 164
+
+enum { PAGE_FOLDER, PAGE_PACK, PAGE_CANDY, PAGE_COUNT };
+
+struct PackRow { u16 move; u8 letter; };
+struct CandyRow { u16 move; u8 letter; };
+
+static struct
+{
+    MainCallback exit;
+    u8 page;
+    u8 cursor[PAGE_COUNT], top[PAGE_COUNT];
+    u16 fMove[FOLDER_MAX];
+    u8 fLetter[FOLDER_MAX];
+    u8 fCount, fMax;
+    bool8 edited;
+    struct BattlePokemon party[PKBN_PARTY_MAX];
+    u8 partyCount;
+    u16 partyIcon[PKBN_PARTY_MAX][32 * 32];
+    struct PackRow pack[400];
+    u16 packCount;
+    struct CandyRow candy[300];
+    u16 candyCount;
+    char note[64];
+    u16 noteTimer;
+    u32 t;
+} sF;
+
+static s32 Text(u16 *fb, s32 x, s32 y, const char *s, u16 col)
+{
+    return Pkbn_DrawEmText(fb, x, y, s, PKBN_FONT_SMALL, col, RGB(2, 2, 5));
+}
+
+static void Note(const char *s)
+{
+    snprintf(sF.note, sizeof(sF.note), "%s", s);
+    sF.noteTimer = 120;
+}
+
+static void MoveName(char *dst, u32 size, u16 move)
+{
+    Pkbn_GameStringToAscii(dst, gMoveNames[move], size);
+}
+
+// ---- data -----------------------------------------------------------------------------------------------------
+
+static u8 InFolder(u16 move, s32 letter)   // letter < 0: any code
+{
+    s32 i, n = 0;
+    for (i = 0; i < sF.fCount; i++)
+        if (sF.fMove[i] == move && (letter < 0 || sF.fLetter[i] == letter))
+            n++;
+    return n;
+}
+
+static bool8 PartyCanUse(u16 move)
+{
+    s32 p;
+    for (p = 0; p < sF.partyCount; p++)
+        if (Chip_CanUse(&sF.party[p], move))
+            return TRUE;
+    return FALSE;
+}
+
+static void BuildPack(void)
+{
+    u16 mv;
+    u8 l, t;
+    sF.packCount = 0;
+    // by type, then name order of the move ids (Gen 3 order), so related chips sit together
+    for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+        for (mv = 1; mv < MOVES_COUNT; mv++)
+            if (gBattleMoves[mv].type == t)
+                for (l = 0; l < PACK_LETTERS; l++)
+                    if (PkbnPack_Get(mv, l) && sF.packCount < ARRAY_COUNT(sF.pack))
+                    {
+                        sF.pack[sF.packCount].move = mv;
+                        sF.pack[sF.packCount].letter = l;
+                        sF.packCount++;
+                    }
+}
+
+// Candy shop (design 10 §10.1): moves in the level-up learnset of a Pokémon you own, once it has reached
+// max(the level it learns the move at, the move's MB).
+static void ConsiderLearnset(u16 species, u8 level, bool8 *ok)
+{
+    const u16 *ls;
+    s32 i;
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return;
+    ls = gLevelUpLearnsets[species];
+    for (i = 0; ls[i] != LEVEL_UP_END; i++)
+    {
+        u16 mv = ls[i] & LEVEL_UP_MOVE_ID;
+        u8 lv = ls[i] >> 9;
+        u8 need = lv > Chip_MB(mv) ? lv : Chip_MB(mv);
+        if (mv < MOVES_COUNT && level >= need && PkbnFolder_MoveIsChip(mv))
+            ok[mv] = TRUE;
+    }
+}
+
+static void BuildCandy(void)
+{
+    static bool8 ok[MOVES_COUNT];
+    s32 i, j;
+    u16 mv;
+    u8 t;
+    memset(ok, 0, sizeof(ok));
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (!GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            ConsiderLearnset(GetMonData(&gPlayerParty[i], MON_DATA_SPECIES), GetMonData(&gPlayerParty[i], MON_DATA_LEVEL), ok);
+    for (i = 0; i < TOTAL_BOXES_COUNT; i++)
+        for (j = 0; j < IN_BOX_COUNT; j++)
+            if (GetBoxMonDataAt(i, j, MON_DATA_SPECIES) && !GetBoxMonDataAt(i, j, MON_DATA_IS_EGG))
+            {
+                struct BoxPokemon *bm = GetBoxedMonPtr(i, j);
+                ConsiderLearnset(GetBoxMonData(bm, MON_DATA_SPECIES), GetLevelFromBoxMonExp(bm), ok);
+            }
+    sF.candyCount = 0;
+    for (j = 0; j < 2; j++)   // types you have candy for first
+    for (t = 0; t < NUMBER_OF_MON_TYPES; t++)
+        if ((PkbnCandy_Get(t) > 0) == (j == 0))
+        for (mv = 1; mv < MOVES_COUNT; mv++)
+            if (ok[mv] && gBattleMoves[mv].type == t && sF.candyCount < ARRAY_COUNT(sF.candy))
+            {
+                sF.candy[sF.candyCount].move = mv;
+                sF.candy[sF.candyCount].letter = gPkbnMoveInfo[mv].lanes[0];
+                sF.candyCount++;
+            }
+}
+
+static u16 CandyCost(u16 move, u8 letter)
+{
+    return (Chip_MB(move) + 3) / 4 + (letter != gPkbnMoveInfo[move].lanes[0] ? 2 : 0);
+}
+
+static void LoadFolder(void)
+{
+    struct Folder f;
+    s32 i;
+    sF.fCount = PkbnFolderEdit_Get(sF.fMove, sF.fLetter);
+    if (sF.fCount == 0)
+    {
+        // never edited: start from what the auto-builder would draw from
+        PkbnFolderEdit_Set(NULL, NULL, 0);
+        PkbnFolder_Build(&f, sF.party, sF.partyCount);
+        for (i = 0; i < f.count; i++)
+        {
+            sF.fMove[i] = f.chips[i].move;
+            sF.fLetter[i] = f.chips[i].letter;
+        }
+        sF.fCount = f.count;
+    }
+}
+
+// ---- drawing ---------------------------------------------------------------------------------------------------
+
+static u8 RowCount(void)
+{
+    return sF.page == PAGE_FOLDER ? sF.fCount : sF.page == PAGE_PACK ? sF.packCount : sF.candyCount;
+}
+
+static void RowChip(u8 row, u16 *move, u8 *letter)
+{
+    if (sF.page == PAGE_FOLDER)
+        *move = sF.fMove[row], *letter = sF.fLetter[row];
+    else if (sF.page == PAGE_PACK)
+        *move = sF.pack[row].move, *letter = sF.pack[row].letter;
+    else
+        *move = sF.candy[row].move, *letter = sF.candy[row].letter;
+}
+
+static void DrawTabs(u16 *fb)
+{
+    static const char *const names[PAGE_COUNT] = { "FOLDER", "PACK", "CANDY" };
+    s32 i, x = 4;
+    char line[32];
+    for (i = 0; i < PAGE_COUNT; i++)
+    {
+        s32 w = Pkbn_EmTextWidth(names[i], PKBN_FONT_NORMAL) + 10;
+        bool8 on = i == sF.page;
+        Pkbn_FillRect(fb, x, 2, w, 17, on ? RGB(6, 10, 22) : RGB(2, 3, 8));
+        Pkbn_FrameRect(fb, x, 2, w, 17, on ? RGB(31, 26, 6) : RGB(8, 10, 16));
+        Pkbn_DrawEmText(fb, x + 5, 0, names[i], PKBN_FONT_NORMAL, on ? RGB(31, 26, 6) : RGB(14, 16, 22), RGB(2, 2, 5));
+        x += w + 3;
+    }
+    snprintf(line, sizeof(line), "%u/%u CHIPS%s", sF.fCount, sF.fMax, sF.edited ? "" : " (AUTO)");
+    Text(fb, CW - 4 - Pkbn_EmTextWidth(line, PKBN_FONT_SMALL), 4, line, sF.fCount > sF.fMax ? RGB(31, 10, 8) : RGB(31, 31, 31));
+}
+
+static void DrawList(u16 *fb)
+{
+    s32 i, n = RowCount();
+    u8 *cur = &sF.cursor[sF.page], *top = &sF.top[sF.page];
+    if (*cur >= n && n > 0)
+        *cur = n - 1;
+    if (*cur < *top)
+        *top = *cur;
+    if (*cur >= *top + LIST_ROWS)
+        *top = *cur - LIST_ROWS + 1;
+    Pkbn_FillRect(fb, LIST_X - 2, LIST_Y - 2, PANEL_X - LIST_X - 2, LIST_ROWS * ROW_H + 4, RGB(2, 3, 8));
+    for (i = 0; i < LIST_ROWS && *top + i < n; i++)
+    {
+        u8 row = *top + i;
+        u16 mv;
+        u8 letter;
+        char nm[MOVE_NAME_LENGTH + 1], right[16];
+        s32 y = LIST_Y + i * ROW_H;
+        bool8 dim = FALSE;
+        u16 col = RGB(31, 31, 31);
+        RowChip(row, &mv, &letter);
+        MoveName(nm, sizeof(nm), mv);
+        if (sF.page == PAGE_FOLDER)
+        {
+            dim = !PartyCanUse(mv);
+            snprintf(right, sizeof(right), "MB%u", Chip_MB(mv));
+        }
+        else if (sF.page == PAGE_PACK)
+        {
+            u8 have = PkbnPack_Get(mv, letter), used = InFolder(mv, letter);
+            dim = !PartyCanUse(mv);
+            snprintf(right, sizeof(right), "%u/%u", used, have);
+            if (used >= have)
+                col = RGB(16, 18, 22);
+        }
+        else
+        {
+            u16 cost = CandyCost(mv, letter);
+            snprintf(right, sizeof(right), "%u", cost);
+            if (PkbnCandy_Get(gBattleMoves[mv].type) < cost)
+                col = RGB(16, 18, 22);
+        }
+        if (row == *cur)
+            Pkbn_FillRect(fb, LIST_X - 1, y - 1, PANEL_X - LIST_X - 4, ROW_H, RGB(8, 14, 28));
+        // small type-coloured chip mark + code letter
+        Pkbn_FillRect(fb, LIST_X, y + 1, 4, 8, Vfx_TypeColor(gBattleMoves[mv].type));
+        Text(fb, LIST_X + 7, y - 2, nm, dim ? RGB(14, 14, 16) : col);
+        {
+            char c[2] = { PkbnFolder_LetterChar(letter), 0 };
+            Text(fb, LIST_X + 92, y - 2, c, RGB(31, 26, 6));
+        }
+        Text(fb, PANEL_X - 8 - Pkbn_EmTextWidth(right, PKBN_FONT_SMALL), y - 2, right, dim ? RGB(14, 14, 16) : col);
+    }
+    if (n == 0)
+        Text(fb, LIST_X + 4, LIST_Y, sF.page == PAGE_CANDY ? "NOTHING TO BUY YET" : "NO CHIPS", RGB(16, 18, 22));
+    if (*top > 0)
+        Text(fb, PANEL_X - 14, LIST_Y - 12, "^", RGB(31, 26, 6));
+    if (*top + LIST_ROWS < n)
+        Text(fb, PANEL_X - 14, LIST_Y + LIST_ROWS * ROW_H - 4, "~", RGB(31, 26, 6));
+}
+
+static void DrawPanel(u16 *fb)
+{
+    s32 x = PANEL_X, y = 24, n = RowCount(), p;
+    u16 mv;
+    u8 letter;
+    char line[48], nm[MOVE_NAME_LENGTH + 1];
+    struct PkbnImage icon;
+    Pkbn_FillRect(fb, x - 2, 22, CW - x, 128, RGB(3, 5, 12));
+    Pkbn_FrameRect(fb, x - 2, 22, CW - x, 128, RGB(8, 12, 22));
+    if (n == 0)
+        return;
+    RowChip(sF.cursor[sF.page], &mv, &letter);
+    // the chip: BN-style icon, code, name
+    Pkbn_FillRect(fb, x + 2, y + 2, 26, 22, RGB(1, 2, 5));
+    PkbnDraw_ChipIcon(fb, x + 4, y + 4, mv, FALSE);
+    line[0] = PkbnFolder_LetterChar(letter), line[1] = '\0';
+    Pkbn_DrawEmText(fb, x + 34, y + 2, line, PKBN_FONT_NORMAL, RGB(31, 26, 6), RGB(2, 2, 5));
+    icon = Gfx_TypeIcon(gBattleMoves[mv].type);
+    Gfx_Draw(fb, &icon, x + 50, y + 6, 0, 0, 0);
+    MoveName(nm, sizeof(nm), mv);
+    Text(fb, x + 2, y + 25, nm, RGB(31, 31, 31));
+    if (gBattleMoves[mv].power > 1)
+        snprintf(line, sizeof(line), "%s  POW %u", gPkbnKindNames[gPkbnMoveInfo[mv].kind], gBattleMoves[mv].power);
+    else
+        snprintf(line, sizeof(line), "%s", gPkbnKindNames[gPkbnMoveInfo[mv].kind]);
+    Text(fb, x + 2, y + 36, line, RGB(22, 26, 31));
+    snprintf(line, sizeof(line), "MB %u  UP TO %u IN", Chip_MB(mv), Chip_CopyCap(mv));
+    Text(fb, x + 2, y + 47, line, RGB(22, 26, 31));
+    snprintf(line, sizeof(line), "OWN %u  IN FOLDER %u", PkbnPack_Total(mv), InFolder(mv, -1));
+    Text(fb, x + 2, y + 58, line, RGB(22, 26, 31));
+    if (sF.page == PAGE_CANDY)
+    {
+        char tn[16];
+        Pkbn_GameStringToAscii(tn, gTypeNames[gBattleMoves[mv].type], sizeof(tn));
+        snprintf(line, sizeof(line), "%s CANDY %u", tn, PkbnCandy_Get(gBattleMoves[mv].type));
+        Text(fb, x + 2, y + 69, line, RGB(31, 26, 6));
+    }
+    // who can use it (party icons, info only - chips themselves never show a Pokémon)
+    Text(fb, x + 2, y + 80, "USABLE BY", RGB(14, 16, 22));
+    for (p = 0; p < sF.partyCount; p++)
+    {
+        bool8 can = Chip_CanUse(&sF.party[p], mv);
+        if (sF.party[p].species)
+            Pkbn_BlitIcon(fb, sF.partyIcon[p], x - 6 + p * 16, y + 84, FALSE, can ? 0 : RGB(4, 4, 6));
+    }
+}
+
+static void DrawHints(u16 *fb)
+{
+    static const char *const hints[PAGE_COUNT] = {
+        "A:TAKE OUT  SELECT:AUTO  L/R:PAGE  B:DONE",
+        "A:ADD  START:PP UP  SELECT:PP MAX  B:DONE",
+        "A:BUY  SELECT:CODE (+2)  L/R:PAGE  B:DONE",
+    };
+    Pkbn_FillRect(fb, 0, CH - 24, CW, 24, RGB(1, 2, 5));
+    if (sF.noteTimer)
+        Text(fb, 4, CH - 24, sF.note, RGB(31, 26, 6));
+    Text(fb, 4, CH - 13, hints[sF.page], RGB(16, 18, 24));
+}
+
+static void Draw(u16 *fb)
+{
+    s32 i;
+    for (i = 0; i < CW * CH; i++)
+        fb[i] = RGB(1, 2, 6);
+    for (i = 0; i < CH; i += 16)
+        Gfx_FillBlend(fb, 0, (i + (s32)(sF.t / 4)) % CH, CW, 1, RGB(4, 12, 18), 4);
+    DrawTabs(fb);
+    DrawList(fb);
+    DrawPanel(fb);
+    DrawHints(fb);
+}
+
+// ---- input -----------------------------------------------------------------------------------------------------
+
+static void Save(void)
+{
+    if (sF.edited)
+        PkbnFolderEdit_Set(sF.fMove, sF.fLetter, sF.fCount);
+}
+
+static void Leave(void)
+{
+    Save();
+    gPkbnCanvasOverlay = NULL;
+    SetMainCallback2(sF.exit);
+}
+
+static void TakeOut(void)
+{
+    u8 i = sF.cursor[PAGE_FOLDER];
+    if (sF.fCount == 0)
+        return;
+    for (; i + 1 < sF.fCount; i++)
+        sF.fMove[i] = sF.fMove[i + 1], sF.fLetter[i] = sF.fLetter[i + 1];
+    sF.fCount--;
+    sF.edited = TRUE;
+    PlaySE(SE_SELECT);
+}
+
+static void AddToFolder(u16 mv, u8 letter)
+{
+    if (sF.fCount >= sF.fMax)
+        Note("THE FOLDER IS FULL");
+    else if (InFolder(mv, letter) >= PkbnPack_Get(mv, letter))
+        Note("ALL YOUR COPIES ARE IN ALREADY");
+    else if (InFolder(mv, -1) >= Chip_CopyCap(mv))
+        Note("NO MORE COPIES OF THIS MOVE (MB LIMIT)");
+    else if (!PartyCanUse(mv))
+        Note("NOBODY IN THE PARTY CAN USE IT");
+    else
+    {
+        sF.fMove[sF.fCount] = mv;
+        sF.fLetter[sF.fCount] = letter;
+        sF.fCount++;
+        sF.edited = TRUE;
+        PlaySE(SE_SELECT);
+        Note("ADDED TO THE FOLDER");
+        return;
+    }
+    PlaySE(SE_FAILURE);
+}
+
+static void UsePP(bool8 max)
+{
+    u16 item = max ? ITEM_PP_MAX : ITEM_PP_UP, mv;
+    u8 letter, add;
+    if (sF.packCount == 0)
+        return;
+    RowChip(sF.cursor[PAGE_PACK], &mv, &letter);
+    if (!CheckBagHasItem(item, 1))
+    {
+        Note(max ? "NO PP MAX IN THE BAG" : "NO PP UP IN THE BAG");
+        PlaySE(SE_FAILURE);
+        return;
+    }
+    // PP Up: +1 copy of this chip. PP Max: copies of this move up to its folder cap (at least +1). design 08 §12
+    add = 1;
+    if (max && PkbnPack_Total(mv) < Chip_CopyCap(mv))
+        add = Chip_CopyCap(mv) - PkbnPack_Total(mv);
+    RemoveBagItem(item, 1);
+    PkbnPack_Add(mv, letter, add);
+    PlaySE(SE_USE_ITEM);
+    {
+        char nm[MOVE_NAME_LENGTH + 1], line[64];
+        MoveName(nm, sizeof(nm), mv);
+        snprintf(line, sizeof(line), "%s %c: +%u COP%s", nm, PkbnFolder_LetterChar(letter), add, add == 1 ? "Y" : "IES");
+        Note(line);
+    }
+}
+
+static void Buy(void)
+{
+    struct CandyRow *r;
+    u16 cost;
+    u8 type;
+    if (sF.candyCount == 0)
+        return;
+    r = &sF.candy[sF.cursor[PAGE_CANDY]];
+    cost = CandyCost(r->move, r->letter);
+    type = gBattleMoves[r->move].type;
+    if (PkbnCandy_Get(type) < cost)
+    {
+        Note("NOT ENOUGH CANDY");
+        PlaySE(SE_FAILURE);
+        return;
+    }
+    PkbnCandy_Add(type, -(s32)cost);
+    PkbnPack_Add(r->move, r->letter, 1);
+    BuildPack();
+    PlaySE(SE_SHOP);
+    {
+        char nm[MOVE_NAME_LENGTH + 1], line[64];
+        MoveName(nm, sizeof(nm), r->move);
+        snprintf(line, sizeof(line), "GOT %s %c FOR %u CANDY", nm, PkbnFolder_LetterChar(r->letter), cost);
+        Note(line);
+    }
+}
+
+static void CycleCode(void)
+{
+    struct CandyRow *r;
+    const struct PkbnMoveInfo *info;
+    s32 i;
+    if (sF.candyCount == 0)
+        return;
+    r = &sF.candy[sF.cursor[PAGE_CANDY]];
+    info = &gPkbnMoveInfo[r->move];
+    for (i = 0; i < info->laneCount && info->lanes[i] != r->letter; i++)
+        ;
+    r->letter = info->lanes[(i + 1) % (info->laneCount ? info->laneCount : 1)];
+    PlaySE(SE_SELECT);
+}
+
+static void HandleInput(u16 keys)
+{
+    u8 n = RowCount(), *cur = &sF.cursor[sF.page];
+    if (keys & DPAD_UP)
+        *cur = n ? (*cur + n - 1) % n : 0;
+    if (keys & DPAD_DOWN)
+        *cur = n ? (*cur + 1) % n : 0;
+    if (keys & DPAD_LEFT)
+        *cur = *cur >= LIST_ROWS ? *cur - LIST_ROWS : 0;
+    if (keys & DPAD_RIGHT)
+        *cur = n ? (*cur + LIST_ROWS < n ? *cur + LIST_ROWS : n - 1) : 0;
+    if (keys & (L_BUTTON | R_BUTTON))
+    {
+        sF.page = (sF.page + ((keys & R_BUTTON) ? 1 : PAGE_COUNT - 1)) % PAGE_COUNT;
+        PlaySE(SE_SELECT);
+        return;
+    }
+    if (keys & B_BUTTON)
+    {
+        PlaySE(SE_SELECT);
+        Leave();
+        return;
+    }
+    switch (sF.page)
+    {
+    case PAGE_FOLDER:
+        if (keys & A_BUTTON)
+            TakeOut();
+        if (keys & SELECT_BUTTON)
+        {
+            sF.edited = FALSE;
+            PkbnFolderEdit_Set(NULL, NULL, 0);
+            LoadFolder();
+            PlaySE(SE_SELECT);
+            Note("AUTO-BUILT FROM YOUR PACK");
+        }
+        break;
+    case PAGE_PACK:
+        if ((keys & A_BUTTON) && sF.packCount)
+            AddToFolder(sF.pack[*cur].move, sF.pack[*cur].letter);
+        if (keys & START_BUTTON)
+            UsePP(FALSE);
+        if (keys & SELECT_BUTTON)
+            UsePP(TRUE);
+        break;
+    case PAGE_CANDY:
+        if (keys & A_BUTTON)
+            Buy();
+        if (keys & SELECT_BUTTON)
+            CycleCode();
+        break;
+    }
+}
+
+// Self-tests drive the screen with PKBN_TEST_FOLDER_KEYS = "U,D,L,R,A,B,S(tart),E(select),<,>" one per 4 frames.
+static const char *sKeys;
+static u32 sKeyClock;
+
+static void CB2_Folder(void)
+{
+    u16 keys = gMain.newKeys;
+    sF.t++;
+    if (sF.noteTimer)
+        sF.noteTimer--;
+    if (sKeys != NULL)
+    {
+        keys = 0;
+        if (++sKeyClock % 4 == 0)
+        {
+            switch (*sKeys)
+            {
+            case 'U': keys = DPAD_UP; break;
+            case 'D': keys = DPAD_DOWN; break;
+            case 'L': keys = DPAD_LEFT; break;
+            case 'R': keys = DPAD_RIGHT; break;
+            case 'A': keys = A_BUTTON; break;
+            case 'B': keys = B_BUTTON; break;
+            case 'S': keys = START_BUTTON; break;
+            case 'E': keys = SELECT_BUTTON; break;
+            case '<': keys = L_BUTTON; break;
+            case '>': keys = R_BUTTON; break;
+            case '.': break;
+            }
+            if (*sKeys)
+                sKeys++;
+            if (*sKeys == ',')
+                sKeys++;
+        }
+    }
+    HandleInput(keys);
+}
+
+void PkbnFolderEdit_Open(MainCallback exitCallback)
+{
+    s32 i;
+    memset(&sF, 0, sizeof(sF));
+    sF.exit = exitCallback;
+    PkbnPack_SyncLearned();
+    sF.partyCount = PkbnFolder_PartyBattleMons(sF.party);
+    {
+        u8 mons = 0;
+        for (i = 0; i < sF.partyCount; i++)
+            if (sF.party[i].species)
+                mons++, Pkbn_DecodeMonIcon(sF.partyIcon[i], sF.party[i].species, GetMonData(&gPlayerParty[i], MON_DATA_PERSONALITY), 0);
+        sF.fMax = Chip_FolderSize(mons);
+    }
+    sF.edited = PkbnFolderEdit_Get(sF.fMove, sF.fLetter) > 0;
+    LoadFolder();
+    BuildPack();
+    BuildCandy();
+    sKeys = getenv("PKBN_TEST_FOLDER_KEYS");
+    sKeyClock = 0;
+    gPkbnCanvasOverlay = Draw;
+    SetMainCallback2(CB2_Folder);
+}
+
+#endif // PORTABLE
