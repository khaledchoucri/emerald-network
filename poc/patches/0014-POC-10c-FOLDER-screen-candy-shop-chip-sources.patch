+// The FOLDER screen's folder (0 chips = auto-build)
+u8 PkbnFolderEdit_Get(u16 *moves, u8 *letters)
+{
+    u8 n = sSave.folderCount > PKBN_FOLDER_SLOTS ? PKBN_FOLDER_SLOTS : sSave.folderCount;
