+// BN-style chip icon (POC-10c): the move's own effect, drawn once on a dark tile and shrunk 3:1 into 22x16.
+// Shared chips show this; only partner switch chips show a Pokémon (Khaled, 2026-10-05).
+#define CHIP_ICON_W 22
+#define CHIP_ICON_H 16
+static u16 sIconScratch[264 * 176];
+static struct { u16 move; u16 px[CHIP_ICON_W * CHIP_ICON_H]; } sIconCache[24];
+static u8 sIconNext;
+
+static const u16 *ChipIconPixels(u16 move)
+{
+    enum { AW = 122, AH = 56 };   // the big chip-art box: render there, then fit the drawn part into the icon
+    static u16 sMerged[AW * AH];
+    static const u8 sTimes[] = { 6, 12, 18, 26 };
+    s32 i, x, y, x0 = AW, y0 = AH, x1 = -1, y1 = -1;
+    u32 k, scale;
+    for (i = 0; i < (s32)ARRAY_COUNT(sIconCache); i++)
+        if (sIconCache[i].move == move && move != MOVE_NONE)
+            return sIconCache[i].px;
+    i = sIconNext;
+    sIconNext = (sIconNext + 1) % ARRAY_COUNT(sIconCache);
+    // several animation frames merged (brightest pixel wins) so short effects still show
+    memset(sMerged, 0, sizeof(sMerged));
+    for (k = 0; k < ARRAY_COUNT(sTimes); k++)
+    {
+        memset(sIconScratch, 0, sizeof(sIconScratch));
+        Gfx_ClipRect(0, 0, AW, AH);
+        Vfx_DrawChipArt(sIconScratch, AW / 2, 32, move, gPkbnMoveInfo[move].kind, gBattleMoves[move].type, sTimes[k]);
+        Gfx_ClipNone();
+        for (y = 0; y < AH; y++)
+            for (x = 0; x < AW; x++)
+            {
+                u16 c = sIconScratch[y * gPkbnFbW + x], *m = &sMerged[y * AW + x];
+                if ((c & 31) + ((c >> 5) & 31) + ((c >> 10) & 31) > (*m & 31) + ((*m >> 5) & 31) + ((*m >> 10) & 31))
+                    *m = c;
+            }
+    }
+    for (y = 0; y < AH; y++)
+        for (x = 0; x < AW; x++)
+            if (sMerged[y * AW + x])
+            {
+                if (x < x0) x0 = x;
+                if (x > x1) x1 = x;
+                if (y < y0) y0 = y;
+                if (y > y1) y1 = y;
+            }
+    if (x1 < 0)
+        x0 = 0, y0 = 0, x1 = AW - 1, y1 = AH - 1;
+    // fit the drawn box (8.8 fixed scale, at least 2:1 so icons stay crisp, at most the whole box)
+    scale = ((x1 - x0 + 1) << 8) / CHIP_ICON_W;
+    if ((((u32)(y1 - y0 + 1)) << 8) / CHIP_ICON_H > scale)
+        scale = (((u32)(y1 - y0 + 1)) << 8) / CHIP_ICON_H;
+    if (scale < (2 << 8))
+        scale = 2 << 8;
+    {
+        s32 cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
+        for (y = 0; y < CHIP_ICON_H; y++)
+            for (x = 0; x < CHIP_ICON_W; x++)
+            {
+                s32 sx0 = cx + (((x - CHIP_ICON_W / 2) * (s32)scale) >> 8), sy0 = cy + (((y - CHIP_ICON_H / 2) * (s32)scale) >> 8);
+                s32 n = (scale >> 8), dx, dy;
+                u32 r = 0, g = 0, b = 0, cnt = 0;
+                for (dy = 0; dy < n; dy++)
+                    for (dx = 0; dx < n; dx++)
+                    {
+                        s32 sx = sx0 + dx, sy = sy0 + dy;
+                        u16 c = (sx >= 0 && sx < AW && sy >= 0 && sy < AH) ? sMerged[sy * AW + sx] : 0;
+                        if (c)
+                            r += c & 31, g += (c >> 5) & 31, b += (c >> 10) & 31, cnt++;
+                    }
+                // a pixel is "art" when at least a third of its block is drawn
+                if (cnt * 3 >= (u32)(n * n))
+                    sIconCache[i].px[y * CHIP_ICON_W + x] = PKBN_RGB(r / cnt, g / cnt, b / cnt);
+                else
+                    sIconCache[i].px[y * CHIP_ICON_W + x] = 0;
+            }
+    }
+    sIconCache[i].move = move;
+    return sIconCache[i].px;
+}
+
+static void DrawChipIcon(u16 *fb, s32 x, s32 y, u16 move, bool8 dim)
+{
+    const u16 *px = ChipIconPixels(move);
+    s32 i, j;
+    for (j = 0; j < CHIP_ICON_H; j++)
+        for (i = 0; i < CHIP_ICON_W; i++)
+        {
+            u16 c = px[j * CHIP_ICON_W + i];
+            if (c == 0)
+                c = Gfx_Blend(Vfx_TypeColor(gBattleMoves[move].type), PKBN_RGB(1, 2, 5), 5 + (j * 6) / CHIP_ICON_H);
+            Pkbn_FillRect(fb, x + i, y + j, 1, 1, dim ? Gfx_Blend(c, COL_BLACK, 9) : c);
+        }
+}
+
+void PkbnDraw_ChipIcon(u16 *fb, s32 x, s32 y, u16 move, bool8 dim)
+{
+    DrawChipIcon(fb, x, y, move, dim);
+}
