+// Pokédex milestones (design 10 §3): every 10 species caught a PP UP, every 50 a PP MAX. Shiny catches give a
+// `*` copy of every move it knew (design 10 §9).
+static void CatchBonuses(struct Pokemon *mon, bool8 first)
+{
+    sPB.bonusMsg[0] = '\0';
+    if (first)
+    {
+        u16 caught = GetNationalPokedexCount(FLAG_GET_CAUGHT);
+        if (caught && caught % 50 == 0 && AddBagItem(ITEM_PP_MAX, 1))
+            snprintf(sPB.bonusMsg, sizeof(sPB.bonusMsg), "%u SPECIES CAUGHT! GOT A PP MAX. ", caught);
+        else if (caught && caught % 10 == 0 && AddBagItem(ITEM_PP_UP, 1))
+            snprintf(sPB.bonusMsg, sizeof(sPB.bonusMsg), "%u SPECIES CAUGHT! GOT A PP UP. ", caught);
+    }
+    if (IsMonShiny(mon))
+    {
+        s32 m, n = 0;
+        for (m = 0; m < MAX_MON_MOVES; m++)
+        {
+            u16 mv = GetMonData(mon, MON_DATA_MOVE1 + m);
+            if (PkbnFolder_MoveIsChip(mv))
+                PkbnPack_Add(mv, LETTER_WILD, 1), n++;
+        }
+        snprintf(sPB.bonusMsg + strlen(sPB.bonusMsg), sizeof(sPB.bonusMsg) - strlen(sPB.bonusMsg),
+                 "IT'S SHINY! GOT %d * CHIPS OF ITS MOVES!", (int)n);
+    }
+    if (sPB.bonusMsg[0])
+        PKBN_LOG("catch bonus: %s", sPB.bonusMsg);
+}
