+
+// TMs and HMs are chips (everyone who can learn the move can use it): each one bought or found gives 2 copies
+// (TUNE) with the move's first code. Hooked into the shop and the scripts' additem, not the PC item storage.
+void PkbnPack_GrantTM(u16 item, u16 count)
+{
+    u16 move;
+    if (item < ITEM_TM01 || item > ITEM_HM08)
+        return;
+    move = ItemIdToBattleMoveId(item);
+    if (!PkbnFolder_MoveIsChip(move))
+        return;
+    PkbnPack_Add(move, gPkbnMoveInfo[move].lanes[0], 2 * count);
+}
+
+// Move Relearner (a Heart Scale): +1 copy of the move, with a code you don't own yet for it when there is one.
+void PkbnPack_GrantRelearned(u16 move)
+{
+    const struct PkbnMoveInfo *info;
+    s32 i;
+    if (!PkbnFolder_MoveIsChip(move))
+        return;
+    info = &gPkbnMoveInfo[move];
+    for (i = 0; i < info->laneCount; i++)
+        if (PkbnPack_Get(move, info->lanes[i]) == 0)
+        {
+            PkbnPack_Add(move, info->lanes[i], 1);
+            return;
+        }
+    PkbnPack_Add(move, info->lanes[0], 1);
+}
+
+// Releasing a Pokémon: 1 candy of each of its types, +1 at level 30 or more (design 10 §10.1).
+void PkbnCandy_GrantRelease(struct BoxPokemon *mon)
+{
+    u16 species = GetBoxMonData(mon, MON_DATA_SPECIES);
+    u8 n;
+    if (species == SPECIES_NONE || species >= NUM_SPECIES || GetBoxMonData(mon, MON_DATA_IS_EGG))
+        return;
+    n = 1 + (GetLevelFromBoxMonExp(mon) >= 30 ? 1 : 0);
+    PkbnCandy_Add(gSpeciesInfo[species].types[0], n);
+    if (gSpeciesInfo[species].types[1] != gSpeciesInfo[species].types[0])
+        PkbnCandy_Add(gSpeciesInfo[species].types[1], n);
+}
+
+// A hatched Pokémon brings its egg moves as chips: +1 copy of each egg move it knows (design 10 §8).
+extern const u16 gEggMoves[];
+void PkbnPack_GrantEggMoves(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    s32 i, m;
+    for (i = 0; gEggMoves[i] != 0xFFFF; i++)
+        if (gEggMoves[i] == species + 20000)   // EGG_MOVES_SPECIES_OFFSET (src/data/pokemon/egg_moves.h)
+            break;
+    if (gEggMoves[i] == 0xFFFF)
+        return;
+    for (i++; gEggMoves[i] != 0xFFFF && gEggMoves[i] < 20000; i++)
+        for (m = 0; m < MAX_MON_MOVES; m++)
+            if (GetMonData(mon, MON_DATA_MOVE1 + m) == gEggMoves[i] && PkbnFolder_MoveIsChip(gEggMoves[i]))
+                PkbnPack_Add(gEggMoves[i], gPkbnMoveInfo[gEggMoves[i]].lanes[0], 1);
+}
