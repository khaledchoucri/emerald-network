+// ---- POC-16a: hits that feel heavy ----------------------------------------------------------------------------------
+// Screen shake is BN6's: camera_initShakeEffect(level, frames) (asm/asm03_0.s:20744) moves the battle camera up to
+// +-1/2/4/8 px for levels 0-3 (byte_8030284); its effect routines mostly use level 1-2 for 10-30 frames and level 3
+// for 30-45 (the calls in asm/asm31.s). Which hits shake how much is ours (TUNE).
+// Hit-stop is our addition (BN6 doesn't freeze on hits): the fight stops for a few frames on a big hit (TUNE).
+// PKBN_NO_HITSTOP=1 turns it off (A/B, and the old timing for comparisons).
+void Vis_Shake(u8 level, u8 frames)
+{
+    Vis_Post(VEV_SHAKE, SIDE_PLAYER, MOVE_NONE, level, (s8)min(frames, 127), 0, 0);
+}
+
+static void HitStop(u8 frames)
+{
+    static s8 sOff = -1;
+    if (sOff < 0)
+        sOff = getenv("PKBN_NO_HITSTOP") != NULL;
+    if (!sOff && !gPkbnGallery && frames > sB.hitStop)
+        sB.hitStop = frames;
+}
+
+static void HitFeel(const struct Attack *a, const struct Fighter *def, s32 dmg, u16 eff, bool8 crit, bool8 counter)
+{
+    u8 cls = a->pa ? CHIP_GIGA : Chip_Class(a->move);
+    if (dmg <= 0 || (a->kind == GK_TORNADO && a->hitsLeft > 1))
+        return;   // a Tornado's ticks: only its last one
+    if (def->bm.hp == 0)
+        HitStop(8), Vis_Shake(2, 20);   // a KO
+    else if (cls == CHIP_GIGA)
+        HitStop(6), Vis_Shake(3, 30);   // a Program Advance or GigaChip
+    else if (counter)
+        HitStop(6), Vis_Shake(1, 15);
+    else if (crit)
+        HitStop(4), Vis_Shake(1, 15);
+    else if (cls == CHIP_MEGA)
+        HitStop(eff > TYPE_MUL_NORMAL ? 3 : 0), Vis_Shake(2, 30);
+    else if (eff > TYPE_MUL_NORMAL)
+        HitStop(3), Vis_Shake(1, 10);
+}
+
