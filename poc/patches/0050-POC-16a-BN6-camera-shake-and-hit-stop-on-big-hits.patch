@@ -917,6 +957,7 @@ static void ApplyHit(struct Attack *a, bool8 last)
     if (a->side == SIDE_PLAYER && (def->lockout || def->charging) && sB.frame >= sB.counterReady)
     {
         sB.counterReady = sB.frame + CHIP_LOCKOUT + 1;
+        counter = TRUE;
         Busting_NoteCounter();
         SetMsg("COUNTER HIT!", 50);
         PKBN_LOG("counter hit on %s", def->name);
@@ -993,6 +1034,7 @@ static void ApplyHit(struct Attack *a, bool8 last)
     else if (eff < TYPE_MUL_NORMAL)
         SetMsg("NOT VERY EFFECTIVE", 50);
     PlaySE(eff > TYPE_MUL_NORMAL ? SE_SUPER_EFFECTIVE : eff < TYPE_MUL_NORMAL ? SE_NOT_EFFECTIVE : SE_EFFECTIVE);
+    HitFeel(a, def, dmg, eff, crit, counter);
     PKBN_LOG("%s's %s (move %u) hit %s: %d dmg (x%u/10%s) -> %u/%u HP", a->userName, gPkbnKindNames[a->kind],
              a->move, def->name, (int)dmg, eff, crit ? ", crit" : "", def->bm.hp, def->bm.maxHP);
 
