+// ---- POC-16a: BN6 camera shake -------------------------------------------------------------------------------------
+// camera_doShakeEffect_80301e8 (asm/asm03_0.s:20653): each frame the camera moves by (rand & mask) - half on both
+// axes, mask 1/3/7/15 for levels 0-3 (byte_8030284), for as many frames as camera_initShakeEffect set. Here the
+// battle field moves (the HUD stays put, as BN6's does). Our own random numbers: the drawing never touches the game's.
+
+static void ShakeFrame(u16 *fb)
+{
+    static u16 sTmp[PKBN_CANVAS_W * PKBN_CANVAS_H];
+    static const u8 sMask[4] = { 1, 3, 7, 15 };
+    s32 dx, dy, x, y;
+    if (sShakeT == 0)
+        return;
+    sShakeT--;
+    sShakeRng = sShakeRng * 1103515245 + 12345;
+    dx = (s32)((sShakeRng >> 16) & sMask[sShakeLevel & 3]) - (sMask[sShakeLevel & 3] + 1) / 2;
+    sShakeRng = sShakeRng * 1103515245 + 12345;
+    dy = (s32)((sShakeRng >> 16) & sMask[sShakeLevel & 3]) - (sMask[sShakeLevel & 3] + 1) / 2;
+    if (dx == 0 && dy == 0)
+        return;
+    memcpy(sTmp, fb, sizeof(sTmp));
+    for (y = 0; y < PKBN_CANVAS_H; y++)
+    {
+        s32 sy = y - dy;
+        if (sy < 0) sy = 0;
+        if (sy >= PKBN_CANVAS_H) sy = PKBN_CANVAS_H - 1;
+        for (x = 0; x < PKBN_CANVAS_W; x++)
+        {
+            s32 sx = x - dx;
+            if (sx < 0) sx = 0;
+            if (sx >= PKBN_CANVAS_W) sx = PKBN_CANVAS_W - 1;
+            fb[y * PKBN_CANVAS_W + x] = sTmp[sy * PKBN_CANVAS_W + sx];
+        }
+    }
+}
+
