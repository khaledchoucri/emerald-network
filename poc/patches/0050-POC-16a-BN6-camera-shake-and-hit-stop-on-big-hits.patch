@@ -1638,6 +1677,13 @@ void Draw_Overlay(u16 *fb)
             case VEV_ANIM:
                 OnAnimEvent(e);
                 break;
+            case VEV_SHAKE:
+                // a stronger shake takes over; an equal one runs for the longer time
+                if (e->kind > sShakeLevel || sShakeT == 0)
+                    sShakeLevel = e->kind, sShakeT = (u8)e->arg;
+                else if (e->kind == sShakeLevel && (u8)e->arg > sShakeT)
+                    sShakeT = (u8)e->arg;
+                break;
             }
         }
         (void)s;
@@ -1671,6 +1717,7 @@ void Draw_Overlay(u16 *fb)
     Vfx_DrawWeather(fb, t);
     Vfx_DrawLayer(fb, VFX_LAYER_HUD);
     Vfx_EndFrame(fb);
+    ShakeFrame(fb);
 
     if (sB.state != ST_CUSTOM)
     {
